def info_plays(league):
    sections = list(_info_plays(league))
    if sections and sections[0][0] == "This screen":
        sections[0] = (sections[0][0], list(sections[0][1]) + [
            ("boxes", "each part of the two sections sits in a titled box of its own, as "
                      "on the Game Stats tab; J / K and the wheel scroll them")])
    return sections + [info_clips(league)] \
        if sport_of(league) in ("football", "hockey", "basketball", "baseball") \
        else sections


