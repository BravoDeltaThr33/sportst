    def playoff_seeds(self):
        """{team id: playoff seed} from the standings, for leagues whose
        postseason scoreboard doesn't carry seeds."""
        data = self.load_standings().data
        if not data:
            return {}
        root = dig(data, "content", "standings", default=data) or data
        groups = []
        walk_standings(root, [], groups)
        seeds = {}
        for _, entries in groups:
            for entry in entries:
                seed = stat_display(stat_lookup(entry), ["playoffSeed"])
                team = entry_team(entry)
                if seed not in ("", "-", "0") and team["id"]:
                    seeds[team["id"]] = seed
        return seeds

    def postseason_days(self, year):
        """The date windows ESPN keeps for college baseball's championship."""
        meta = LEAGUES[self.league]
        days = []
        for season_type in (5, 6):
            url = (f"https://sports.core.api.espn.com/v2/sports/{meta['sport']}/leagues/"
                   f"{meta['path']}/seasons/{year}/types/{season_type}")
            window = self.fetcher.get(("ptype", self.league, year, season_type), url,
                                      ttl=86400)
            start = parse_iso(dig(window.data, "startDate", default="") or "")
            end = parse_iso(dig(window.data, "endDate", default="") or "")
            if not start or not end:
                continue
            day = start.date()
            while day <= end.date() and len(days) < 24:
                days.append(day)
                day += timedelta(days=1)
        return days

    def load_playoffs(self):
        """(rounds, loading, error). Each league keeps its bracket somewhere
        different, so each one is fetched its own way."""
        year = self.season_year or Date.today().year
        league = self.league
        if league in ("nba", "cbb"):
            for season in (year, year - 1):
                events, loading, error = [], False, None
                for month, urls in basketball_postseason_urls(self.api, league, season):
                    result = self.fetcher.get(("bbpost", league, season, month), urls[0],
                                              ttl=900, fallbacks=urls[1:])
                    loading = loading or result.loading
                    error = error or result.error
                    if result.data:
                        events.extend(parse_scoreboard(result.data))
                rounds = bracket_nba(events) if league == "nba" else bracket_cbb(events)
                if count_real_teams(rounds) >= 2:
                    return rounds, loading, error
                if loading:
                    return [], True, None
            return [], False, None
        if league == "ahl":
            source, spare = self.api.hockeytech.bracket(league)
            result = self.fetcher.get(("ahlbracket",), source, ttl=900, fallbacks=spare)
            rounds = bracket_ahl(result.data) if result.data else []
            if count_real_teams(rounds) < 2:
                rounds = []
            return rounds, result.loading, result.error
        if is_olympic(league):
            result = self.load_scoreboard()
            events = parse_scoreboard(result.data) if result.data else []
            rounds = bracket_from_events(events, league, OLYMPIC_ROUNDS,
                                         keep=lambda headline: bool(olympic_round(headline)),
                                         namer=olympic_round, notes=False)
            return rounds, result.loading, result.error
        if league == "nhl":
            for season in (year, year - 1):
                result = self.fetcher.get(("nhlbracket", season),
                                          f"{NHL_API}/playoff-bracket/{season}",
                                          ttl=900)
                rounds = bracket_nhl(result.data) if result.data else []
                if count_real_teams(rounds) >= 2:
                    return rounds, result.loading, result.error
                if result.loading:
                    return [], True, None
            return [], False, None
        if league == "mlb":
            result = self.fetcher.get(
                ("mlbpost", year),
                f"{STATS_API}/schedule/postseason?season={year}&sportId=1", ttl=900)
            teams = self.load_teams()
            by_name = {}
            for team in (parse_teams(teams.data) if teams.data else []):
                by_name[team["name"].lower()] = team
            rounds = bracket_mlb(result.data, by_name) if result.data else []
            if count_real_teams(rounds) < 2:
                rounds = []
            return rounds, result.loading, result.error

        events, loading, error = [], False, None
        if league in ("nfl", "cfb"):
            weeks = [1, 2, 3, 5] if league == "nfl" else [1]
            for week in weeks:
                url, spare = self.api.scoreboard(
                    league, week=week, seasontype=3, year=year,
                    groups=self.cfb_group if league == "cfb" else None)
                result = self.fetcher.get(("post", league, year, week), url, ttl=900,
                                          fallbacks=spare)
                loading = loading or result.loading
                error = error or result.error
                if result.data:
                    events.extend(parse_scoreboard(result.data))
            keep = None
            if league == "cfb":
                keep = lambda headline: "playoff" in headline.lower() or \
                    "national championship" in headline.lower()
            rounds = bracket_from_events(events, league,
                                         NFL_ROUNDS if league == "nfl" else CFB_ROUNDS,
                                         seeds=self.playoff_seeds(), keep=keep)
            if count_real_teams(rounds) < 2:
                rounds = []
            return rounds, loading, error

        for day in self.postseason_days(year):
            url, spare = self.api.scoreboard(league, day=day)
            result = self.fetcher.get(("post", league, day.isoformat()), url, ttl=900,
                                      fallbacks=spare)
            loading = loading or result.loading
            error = error or result.error
            if result.data:
                events.extend(parse_scoreboard(result.data))
        rounds = bracket_from_events(events, league, CBASE_ROUNDS, namer=cbase_round)
        if count_real_teams(rounds) < 2:
            rounds = []
        return rounds, loading, error

