    projection = _num(dig(summary, "predictor", "homeTeam", "gameProjection", default=None))
    if projection is not None:
        out.append(Line().add("Predictor", "muted").add(
            f" {home['abbr']} {projection:.0f}%  ·  {away['abbr']} {100 - projection:.0f}%",
            "normal").add("   ESPN's matchup predictor", "dim"))
    weather = dig(summary, "gameInfo", "weather", default=None) or {}
    if weather and not event.get("indoor"):
        bits = []
        if weather.get("temperature") is not None:
            bits.append(f"{weather.get('temperature')}°F")
        if weather.get("displayValue"):
            bits.append(clean(weather["displayValue"]))
        if weather.get("windSpeed"):
            bits.append(f"wind {weather['windSpeed']} mph")
        if bits:
            out.append(Line().add("Weather  ", "muted").add(", ".join(bits), "normal"))
    for side in (away, home):
        if side.get("probable"):
            row = Line().add(f"{side['abbr']:<9}", "muted").add(side["probable"], "bold")
            if side.get("probable_record"):
                row.add(f"  {side['probable_record']}", "dim")
            out.append(row)
    for side in (away, home):
        form = recent_margin(summary, side) if summary else None
        games = _last_games(summary, side.get("id")) if summary else []
        results = []
        for game in games[-5:]:
            result = clean(game.get("gameResult") or "")
            if result:
                results.append(result[:1])
        if results:
            row = Line().add(f"{side['abbr']:<9}", "muted").add("last 5  ", "dim")
            for letter in results:
                row.add(letter + " ", "good" if letter == "W" else "bad" if letter == "L"
                        else "dim")
            if form is not None:
                row.add(f"  margin {form:+.1f}", "dim")
            out.append(row)
    if event.get("venue"):
        where = event["venue"] + (f" — {event['venue_city']}" if event.get("venue_city")
                                  else "")
        out.append(Line().add("Venue    ", "muted").add(where[: max(10, width - 10)], "dim"))
    if event.get("broadcast"):
        out.append(Line().add("TV       ", "muted").add(event["broadcast"], "normal"))
    return out


START_WORDS = {"football": "KICKOFF", "basketball": "TIP-OFF", "hockey": "PUCK DROP",
               "baseball": "FIRST PITCH"}


def countdown_text(event, now=None, league=None):
    """'2:13' hours and minutes to the start (or '0:00'), and the unit:
    'HRS  MIN TO KICKOFF'."""
    start = parse_iso(event.get("date"))
    if not start or event.get("time_tba"):
        return None, ""
    seconds = (start - datetime.now(timezone.utc)).total_seconds()
    if seconds <= 0:
        return "0:00", "STARTING"
    hours, minutes = int(seconds // 3600), int(seconds % 3600 // 60)
    if hours >= 100:
        return None, ""
    word = START_WORDS.get(sport_of(league), "GO") if league else "GO"
    if hours:
        return f"{hours}:{minutes:02d}", f"HRS  MIN TO {word}"
    secs = int(seconds % 60)
    return f"{minutes}:{secs:02d}", f"MIN  SEC TO {word}"


