    def stats_order(self):
        """'group' (by league and division), 'stat' (best first) or 'name'."""
        return self.stats_orderby.get(self.league) or stats_default_order(self.league)

    def stats_conf_column(self):
        """Is the conference / division column drawn? Not when grouped."""
        return self.stats_order() != "group"

    def cycle_stats_view(self, step):
        table = self.stats_table_ready()
        if not table:
            return
        groups = stat_groups(table)
        width = self.stdscr.getmaxyx()[1] - 4
        conf = self.stats_conf_column()
        current = self.stats_view.get(self.league) or "All"
        if current == "All" or current not in groups:
            target = groups[0] if groups else "All"
        else:
            shown = stats_view_groups(table, current, width, conf=conf)
            after = groups.index(shown[-1]) + 1
            target = groups[after] if after < len(groups) else "All"
        if target == groups[0] and current == "All" and \
                stats_view_groups(table, target, width, conf=conf) == groups:
            target = "All"
        self.stats_view[self.league] = target
        self.scroll["Stats"] = 0
        shown = stats_view_groups(table, target, width, conf=conf)
        self.status_message = "Stat groups: " + (" + ".join(shown) if target != "All"
