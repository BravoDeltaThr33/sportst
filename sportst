def team_schedules(league):
    """Is there a team schedule to show? Not for college baseball (ESPN has
    none) or the Olympic tournaments."""
    return league != "cbase" and not is_olympic(league)


def tabs_for(league):
    """The screens a league gets. An Olympic hockey tournament looks like the
    NHL plus the medal table; a sport scored by times, marks and judges gets
    its event list, each event's results, the medallists and the table."""
    if is_wiki_sport(league):
        return WIKI_TABS
    if is_olympic(league):
        return TOURNAMENT_TABS
    return BASE_TABS

