              "nfl": "the NFL's YouTube channel, while the play is among its latest "
                     "uploads",
              "ahl": "the AHL's YouTube channel, while the goal is among its latest "
                     "uploads",
              "nhl": "ESPN's goal clips, or the NHL's own clip on nhl.com"}.get(
        league, "ESPN's one-play clips")
    return ("Clips (j / k, enter)", [
        _p(f"j / k highlight a scoring play and enter plays its clip; the clips come "
           f"from {source}. All free, no account or key."),
        ("♪", "a clip with sound: enter plays it right here through mpv, ffplay or VLC "
              "(whichever is installed; Settings, Clips chooses), or opens it in the "
              "browser if none is"),
        ("↗", "a clip on a web page (nhl.com, YouTube): enter opens it in your browser"),
        ("no mark", "no clip was found for that play: enter searches YouTube for it in "
                    "your browser instead"),
        ("▶", "the play whose clip is playing now; enter on it again, or X, stops it"),
        ("n / N", "jump to the next / previous play that has a clip"),
        ("Y", "the whole game's highlights (ESPN's or MLB's highlight package, the "
              "league's YouTube video, or a YouTube search)"),
        ("J / K", "scroll the screen while j / k move between plays"),
        _p("The commentary is whichever broadcast the clip was cut from - usually the "
           "national or one team's TV call - not a particular local radio call, which "
           "no free service publishes."),
    ])


def info_plays(league):
    return [section for section in _info_plays(league)] + [info_clips(league)] \
        if sport_of(league) in ("football", "hockey", "basketball", "baseball") \
        else _info_plays(league)


