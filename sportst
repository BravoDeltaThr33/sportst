    r"\b(rules? out|ruled out|out for|out (vs\.?|against|indefinitely|multiple weeks)|"
    r"will miss|to miss|misses|sidelined|suspended|season-ending|won't play|"
    r"will not play|leaves game|left the game|helped off|carted off|"
    r"placed on (injured reserve|ir))\b", re.I)
KIM_NEWS_GOOD = re.compile(
    r"\b(activates?|activated|reinstated|returns? from|set to return|will return|"
    r"cleared to|back from injury|off (the )?injured reserve|will start|to start|"
    r"expected to play|upgraded)\b", re.I)
KIM_NEWS_HURT = re.compile(
    r"\b(injur(y|ies|ed)|questionable|doubtful|day-to-day|surgery|concussion|torn|"
    r"fractured?|sprain(ed)?|strain(ed)?|limited in practice|did not practice)\b", re.I)


def kim_frame(size, frame="open"):
    """The portrait's pixel rows (palette letters, '.' clear) for one size
    (there is one, 'S') and mouth ('open', 'mid' or 'closed')."""
    art = KIM_ART[size]
    rows = list(art["open"])
    changes = art.get(frame) if frame != "open" else None
    for index, row in (changes or {}).items():
        rows[index] = row
    return rows


def kim_mouth_row(size):
    """The text row (two pixels each) the mouth is on, for the bubble's tail."""
    rows = sorted(KIM_ART[size]["closed"])
    return (sum(rows) // len(rows)) // 2 if rows else len(KIM_ART[size]["open"]) // 4


def kim_art_lines(size, frame="open"):
    """The portrait as Lines: a half block per two pixels, exact colours, the
    clear background left as the screen's own."""
    pixels = kim_frame(size, frame)
    lines = []
    for y in range(0, len(pixels) - 1, 2):
        line = Line()
        for top, bottom in zip(pixels[y], pixels[y + 1]):
            if top == "." and bottom == ".":
                cell = (" ", "normal")
            elif top == bottom:
                cell = ("█", "@" + KIM_COLORS[top])
            elif top == ".":
                cell = ("▄", "@" + KIM_COLORS[bottom])
            elif bottom == ".":
                cell = ("▀", "@" + KIM_COLORS[top])
            elif top < bottom:
                # one pair per two colours, whichever is on top
                cell = ("▀", "@" + KIM_COLORS[top] + ":" + KIM_COLORS[bottom])
            else:
                cell = ("▄", "@" + KIM_COLORS[bottom] + ":" + KIM_COLORS[top])
            if line and line[-1][1] == cell[1]:
                line[-1] = (line[-1][0] + cell[0], cell[1])
            else:
                line.append(cell)
        lines.append(line)
    return lines


KIM_BUBBLE_MAX = 42     # the pop-up's bubble at its widest


def kim_size(rows, cols):
    """The pop-up's portrait - the small one, which with a bubble of at most
    KIM_BUBBLE_MAX columns keeps Ask Kim to about half the screen - or None
    when even that does not fit."""
    for size, min_bubble in (("S", 34),):
        art = KIM_ART[size]["open"]
        if rows >= len(art) // 2 + 3 and cols >= len(art[0]) + 3 + min_bubble + 4:
            return size
    return None


def kim_bet_row(event, league, game, markets, table, summary, mode, top, min_edge):
    """sportst's model on one game, the way the Betting tab runs it."""
    books = dict(game["books"]) if game else {}
    sellers = {n: l for n, l in books.items() if n not in ("Consensus", "Open")}
    espn = espn_line_as_book(event.get("line") or event.get("line_raw"))
    market = books.get("Consensus") or average_lines(list(sellers.values())) or espn
    if not market:
        return None
    if mode == "best":
        candidates = list(sellers.values()) or [espn]
    elif mode == "avg":
        candidates = [average_lines([sellers[n] for n in top if n in sellers]) or
                      average_lines(list(sellers.values())) or espn]
    else:
        candidates = [sellers.get(mode) or market]
    kalshi = match_kalshi(event, markets) if markets else None
    public = game["public"] if game else {}
    model = project_game(event, league, table, market, summary, kalshi, books.get("Open"),
                         public)
    bets = bet_options(event, league, model, [c for c in candidates if c],
                       "best" if mode == "best" else "one", min_edge)
    return {"event": event, "model": model, "bets": bets, "summary": summary}


def kim_news_index(data, now=None):
    """{team id: [(hours old, headline, tone, athletes)]} from a league news
    wire, newest first; tone -1 bad news (ruled out, hurt), +1 good (back,
    activated), 0 neither."""
    now = now or time.time()
    out = {}
    for article in (data or {}).get("articles") or []:
        headline = clean(article.get("headline") or "")
        if not headline:
            continue
        when = parse_iso(article.get("published") or article.get("lastModified"))
        hours = (now - when.timestamp()) / 3600 if when else 999
        if hours > KIM_NEWS_HOURS:
            continue
        text = headline + " " + clean(article.get("description") or "")
        if KIM_NEWS_OUT.search(text):
            tone = -1
        elif KIM_NEWS_GOOD.search(text):
            tone = 1
        elif KIM_NEWS_HURT.search(text):
            tone = -1
        else:
            tone = 0
        teams = [c for c in article.get("categories") or [] if c.get("type") == "team"]
        if len(teams) > 2:
            continue            # a league-wide roundup, not news about a team
        athletes = [str(c.get("description") or "") for c in article.get("categories") or []
                    if c.get("type") == "athlete"]
        for category in teams:
            ident = str(category.get("teamId") or dig(category, "team", "id", default=""))
            if ident:
                out.setdefault(ident, []).append((max(0.0, hours), headline, tone, athletes))
    for items in out.values():
        items.sort(key=lambda item: item[0])
    return out


def _kim_news_for(team, index):
    return (index or {}).get(str(team.get("id") or ""), [])


def kim_read_news(cand, league, index):
    """Weigh the news wire for one candidate bet: fresh bad news about the
    side Kim likes costs it, about the other side helps, unless the injury
    report the model already read named the same player."""
    row, bet = cand["row"], cand["bet"]
    event = row["event"]
    known = " ".join(text for text, _ in (row["model"] or {}).get("adjust") or [])
    known = norm_name(known)
    if bet["kind"] == "total":
        sides = [("away", 0.0), ("home", 0.0)]
    else:
        other = "home" if bet["side"] == "away" else "away"
        sides = [(bet["side"], 1.0), (other, -1.0)]
    shown = []
    for side, sign in sides:
        team = event[side]
        for hours, headline, tone, athletes in _kim_news_for(team, index)[:6]:
            counted = any(name and norm_name(name) in known for name in athletes)
            if tone and sign and not counted:
                # bad news for Kim's side hurts twice as much as it helps on
                # the other side: a scratch the market has not priced is the
                # likelier story
                cand["score"] += sign * tone * (2.0 if tone < 0 and sign > 0 else 1.0)
                cand["news_moves"] = cand.get("news_moves", 0) + 1
                (bet["agree"] if sign * tone > 0 else bet["disagree"]).append("news")
            shown.append((abs(tone) if not counted else 0.5, -hours, hours, headline,
                          team["abbr"]))
    shown.sort(reverse=True)
    picked, seen = [], set()
    for weight, _, hours, headline, abbr in shown:
        if headline in seen or (not weight and picked):
            continue            # one copy, and a neutral item only if nothing else
        seen.add(headline)
        picked.append((hours, headline, abbr))
        if len(picked) == 2:
            break
    cand["news"] = picked


def kim_intel(cand, league):
    """Short notes on why: injuries, rest, form, weather, ESPN's predictor."""
    row, bet = cand["row"], cand["bet"]
    model = row["model"] or {}
    event = row["event"]
    notes = []
    for text, value in model.get("adjust") or []:
        if bet["kind"] == "total":
            helps = (value < 0) == (bet["side"] == "under") if value else False
        else:
            helps = (value > 0) == (bet["side"] == "home") if value else False
        notes.append((0 if helps else 1, text))
    notes.sort(key=lambda n: n[0])
    out = [text for _, text in notes[:3]]
    p_espn = model.get("p_espn")
    if p_espn is not None and bet["kind"] != "total":
        side = bet["side"]
        p = p_espn if side == "home" else 1 - p_espn
        out.append(f"ESPN predictor {event[side]['abbr']} {p * 100:.0f}%")
    return out


def kim_choose(rows, league, news=None):
    """(the three picks, how many games had a bet worth weighing). One bet a
    game: the best by edge, stars and agreement, read against the news."""
    candidates = []
    for row in rows:
        if not row or not row.get("bets"):
            continue
        best = None
        for bet in row["bets"]:
            price = bet.get("price") or 0
            # a 15%+ edge almost always means news or a bad line the model
            # cannot see, so Kim leaves it alone
            if bet["ev"] <= 0 or bet["ev"] > 0.15 or price >= 200:
                continue
            agree, disagree = len(set(bet["agree"])), len(set(bet["disagree"]))
            if not bet["stars"] and not (bet["ev"] >= 0.01 and agree > disagree):
                continue
            score = bet["ev"] * 100 * (1 + 0.15 * agree - 0.15 * disagree) + 2.0 * bet["stars"]
            if best is None or score > best["score"]:
                best = {"row": row, "bet": dict(bet, agree=list(bet["agree"]),
                                               disagree=list(bet["disagree"])),
                        "score": score, "tier": 0 if bet["stars"] else 1}
        if best:
            candidates.append(best)
    candidates.sort(key=lambda c: (c["tier"], -c["score"]))
    shortlist = candidates[:KIM_SHORTLIST]
    for cand in shortlist:
        kim_read_news(cand, league, news)
        cand["intel"] = kim_intel(cand, league)
    kept = []
    for cand in shortlist:
        bet = cand["bet"]
        agree, disagree = len(set(bet["agree"])), len(set(bet["disagree"]))
        # a lean needs more for it than against it, news included; a starred
        # bet the news has turned against needs at least as many for it
        if cand["tier"] and agree <= disagree:
            continue
        if "news" in bet["disagree"] and agree < disagree:
            continue
        kept.append(cand)
    kept.sort(key=lambda c: (c["tier"], -c["score"]))
    return kept[:3], len(candidates)


def kim_book_name(book):
    book = str(book or "")
    if book.startswith("Avg "):
        return "avg " + book[4:]
    return BOOK_SHORT.get(book, book)


KIM_SAYS = {3: "Kim has never been more sure.",
            2: "Kim likes this one very much.",
            1: "Kim would put a little on it.",
            0: "A small lean. Kim is patient."}


def kim_speech(result, league, width):
    """What Kim says, as [Line] of bubble styles: head, bet, text, dim, star.
    Only the picks - Kim does not explain himself. `result` is {"picks",
    "games", "weighed", "label", "missing"}."""
    width = max(20, width)
    lines = []

    def para(text, style, indent=0):
        for chunk in textwrap.wrap(text, max(10, width - indent)) or [""]:
            lines.append(Line().add(" " * indent + chunk, style))

    name = LEAGUE_SHORT.get(family(league), league.upper())
    lines.append(Line().add(f"KIM'S PICKS · {name} · {result['label']}".upper(), "head"))
    picks = result["picks"]
    if not result["games"]:
        lines.append(blank())
        plain = {"cfb": "college football", "cbb": "college basketball",
                 "cbase": "college baseball"}.get(family(league), name)
        para(f"No {plain} lines are out for this stretch. Kim will speak when the "
             "books open.", "text")
        return lines
    if not picks:
        lines.append(blank())
        para("Kim sees nothing worth his money this week.", "text")
    for number, cand in enumerate(picks, 1):
        bet, row = cand["bet"], cand["row"]
        event = row["event"]
        lines.append(blank())
        head = Line().add(f"{number}  ", "head")
        head.add(f"{bet_label(bet, event)} {money_text(bet['price'])}", "bet")
        book = kim_book_name(bet.get("book"))
        if book:
            head.add(f" · {book}", "dim")
        stars = STAR * bet["stars"] if bet["stars"] else "lean"
        head.add(f"  {stars}", "star")
        lines.append(head)
        para(f"{event['away']['abbr']} @ {event['home']['abbr']} · {bet_time(event)}",
             "text", 3)
        para(f"\"{KIM_SAYS.get(min(3, bet['stars'] or 0), KIM_SAYS[0])}\"", "dim", 3)
    if picks and len(picks) < 3:
        lines.append(blank())
        para("Kim gives only " + ("two picks" if len(picks) == 2 else "one pick") +
             " this week. He does not waste words.", "text")
    lines.append(blank())
    para("For fun. Problem gambling help: 1-800-GAMBLER.", "dim")
    return lines


# the speech bubble: the colour scheme's own dark background inside a solid
# yellow outline
KIM_YELLOW = "FFD700"
KIM_BUBBLE = {"paper": "normal", "border": "@" + KIM_YELLOW,
              "head": "title", "bet": "bold", "text": "normal", "dim": "dim",
              "star": "star", "good": "good", "bad": "bad", "tail": "@" + KIM_YELLOW}


def kim_bubble(text_lines, width, height=None, scroll=0, reveal=None, tail_row=None):
    """The speech bubble as [Line]: a solid yellow outline (half blocks along
    the top and bottom, full blocks down the sides) around the text on the
    screen's own background - the first `reveal` characters while he is
    still talking. `tail_row` is where the tail meets the left edge."""
    inner = width - 4
    body = list(text_lines)
    if height is None:
        height = len(body) + 2
    view = height - 2
    scroll = clamp(scroll, 0, max(0, len(body) - view))
    shown = body[scroll:scroll + view]
    if reveal is not None:
        left = reveal
        for index, line in enumerate(body[:scroll]):
            left -= len(line.text)
        cut = []
        for line in shown:
            if left <= 0:
                cut.append(Line())
                continue
            kept = Line()
            for text, style in line:
                if left <= 0:
                    break
                kept.append((text[:left], style))
                left -= len(text)
            cut.append(kept)
        shown = cut
    paper, border = KIM_BUBBLE["paper"], KIM_BUBBLE["border"]

    def edge(fill, tag=""):
        line = fill * width
        if tag:
            line = line[: max(1, width - 3 - len(tag))]
            return Line().add(line, border).add(tag, "star").add(fill * 3, border)
        return Line().add(line, border)

    up = f" ▲ {scroll} above · k " if scroll > 0 and reveal is None else ""
    out = [edge("▄", up)]
    for index in range(view):
        line = shown[index] if index < len(shown) else Line()
        row = Line().add("█", border).add(" ", paper)
        used = 0
        for text, style in line:
            text = text[: max(0, inner - used)]
            if text:
                row.add(text, KIM_BUBBLE.get(style, paper))
                used += len(text)
        row.add(" " * (inner - used + 1), paper).add("█", border)
        out.append(row)
    more = len(body) - scroll - view
    down = f" ▼ {more} more · j/k " if more > 0 and reveal is None else ""
    out.append(edge("▀", down))
    return out


def kim_gather_sync(league, config, timeout, days=KIM_DAYS):
    """Everything Ask Kim reads, fetched now (for sportst --kim)."""
    from concurrent.futures import ThreadPoolExecutor
    api = Api(config.get("api_host", "site.api.espn.com"))
    meta = LEAGUES[league]
    groups = config.get("cfb_group") if league == "cfb" else meta.get("groups")
    sources = config.get("betting_sources", True)
    slates = []
    label = ""
    if meta["week_based"]:
        data = fetch_first(api.scoreboard(league, groups=groups), timeout)
        week = dig(data, "week", "number")
        label = f"Week {week}" if week else "this week"
        board = None
        if sources and league in AN_LEAGUES:
            try:
                board = an_board(league, timeout, week=week, season=dig(data, "season", "year"),
                                 seasontype=dig(data, "season", "type"))
            except Exception:  # noqa: BLE001 - ESPN's own line still works
                board = None
        slates.append((data, board))
    else:
        today = Date.today()
        label = f"{today:%b %-d} – {today + timedelta(days=days - 1):%b %-d}"

        def one_day(day):
            try:
                data = fetch_first(api.scoreboard(league, day=day, groups=groups), timeout)
            except Exception:  # noqa: BLE001 - a missing day is just a gap
                return None
            board = None
            if sources and league in AN_LEAGUES:
                try:
                    board = an_board(league, timeout, day=day)
                except Exception:  # noqa: BLE001
                    board = None
            return data, board

        with ThreadPoolExecutor(max_workers=4) as pool:
            for item in pool.map(one_day, [today + timedelta(days=n) for n in range(days)]):
                if item:
                    slates.append(item)
    book = LineBook()
    games, seen = [], set()
    for data, board in slates:
        events = parse_scoreboard(data)
        attach_lines(events, league, book)
        for event in events:
            if event["state"] != "pre" or event["id"] in seen:
                continue
            seen.add(event["id"])
            game = match_an_game(event, board) if board else None
            if game or event.get("line") or event.get("line_raw"):
                games.append((event, game))
    book.save()
    if not games:
        return {"games": [], "label": label, "missing": 0}
    markets = None
    if sources and league in KALSHI_SERIES:
        try:
            markets = kalshi_board(league, timeout)
        except Exception:  # noqa: BLE001 - optional
            markets = None
    table = team_stats_table(league, timeout, extras=bool(config.get("extra_stat_sources", True)))
    news = None
    if LEAGUES[league].get("source", "espn") == "espn":
        try:
            news = fetch_first(api_news(api.espn, league), timeout)
        except Exception:  # noqa: BLE001 - the picks work without it
            news = None
    games.sort(key=lambda g: g[0].get("date") or "")
    games = games[:KIM_GAMES]

    def summary_of(event):
        try:
            data = fetch_first(api.summary(league, event["id"]), timeout)
            prepare_summary(data, league)
            return data
        except Exception:  # noqa: BLE001 - the projection works without it
            return None

    with ThreadPoolExecutor(max_workers=6) as pool:
        summaries = list(pool.map(summary_of, [event for event, _ in games]))
    return {"games": [(e, g, s) for (e, g), s in zip(games, summaries)],
            "markets": markets, "table": table, "news": news, "label": label,
            "missing": sum(1 for s in summaries if s is None)}


def api_news(espn, league):
    """The league's news wire on ESPN (each item tagged with its teams)."""
    meta = LEAGUES[league]
    urls = espn._site(f"{meta['sport']}/{meta['path']}/news?limit=50", league)
    return urls[0], urls[1:]


def kim_result(league, gathered, mode, top, min_edge):
    """Run the model over the gathered week and choose the picks."""
    rows = []
    for event, game, summary in gathered["games"]:
        row = kim_bet_row(event, league, game, gathered.get("markets"), gathered.get("table"),
                          summary, mode, top, min_edge)
        if row:
            rows.append(row)
    news = kim_news_index(gathered.get("news"))
    picks, weighed = kim_choose(rows, league, news)
    return {"picks": picks, "games": len(rows), "weighed": weighed,
            "label": gathered.get("label") or "this week",
            "missing": gathered.get("missing", 0)}


def cli_kim(league, config, args, width, timeout, color):
    """sportst --kim: the portrait and the speech bubble, side by side on a
    colour terminal, the words alone in a pipe."""
    mode = args.book or str(config.get("betting_book", "avg") or "avg")
    names = {name.lower(): name for _, name, _ in BOOKS}
    mode = names.get(mode.lower(), mode)
    top = [n for n in (config.get("betting_top_books") or TOP_BOOKS_DEFAULT)
           if n in names.values()] or TOP_BOOKS_DEFAULT
    try:
        min_edge = max(0.5, float(config.get("betting_min_edge", 3.0)))
    except (TypeError, ValueError):
        min_edge = 3.0
    if league not in BET_LEAGUES:
        return [Line().add(f"Ask Kim covers the leagues with betting lines: "
                           f"{', '.join(LEAGUE_SHORT[k] for k in LEAGUE_ORDER if k in BET_LEAGUES)}.",
                           "warn")]
    gathered = kim_gather_sync(league, config, timeout)
    result = kim_result(league, gathered, mode, top, min_edge)
    if not color:
        speech = kim_speech(result, league, max(40, min(width, 100)))
        return [Line().add(line.text, "normal") for line in speech]
    size = "S"
    art = kim_art_lines(size, "open")
    art_width = len(KIM_ART[size]["open"][0])
    bubble_width = clamp(width - art_width - 4, 30, 84)
    speech = kim_speech(result, league, bubble_width - 4)
    tail = kim_mouth_row(size) + 1
    bubble = kim_bubble(speech, bubble_width, max(len(speech) + 2, len(art)),
                        tail_row=tail)
    out = []
    for index in range(max(len(art), len(bubble))):
        line = Line()
        if index < len(art):
            line.extend(art[index])
        else:
            line.add(" " * art_width, "normal")
        if index == tail:
            line.add(" ◀▬", KIM_BUBBLE["tail"])
        else:
            line.add("   ", "normal")
        if index < len(bubble):
            line.extend(bubble[index])
        out.append(line)
    return out


def bet_read_line(row, league, width):
    """One line for the Scouting tab: sportst's margin and its best bet."""
    model = (row or {}).get("model")
    if not model:
        return None
    event = row["event"]
    away, home = event["away"], event["home"]
    leader = home if model["margin"] >= 0 else away
    line = Line().add(f"{'Betting':<9}", "muted")
    line.add(f"sportst {leader['abbr']} by {abs(model['margin']):.1f}",
             THEME.style(league, leader, bold=True))
    line.add(f" ({max(model['p_home'], 1 - model['p_home']) * 100:.0f}%)", "normal")
    pick = row.get("pick")
    if pick:
        line.add(" · value: ", "muted")
        line.add(f"{bet_label(pick, event)} {money_text(pick['price'])}", "bold")
        line.add(f" {pick['ev'] * 100:+.1f}% ", "good").add(STAR * pick["stars"], "upset")
    else:
        line.add(" · no bet clears the value bar (tab 9 has the lines)", "dim")
    return line


def render_bet_books(row, league, width):
    """Left half of the detail: every book's line, Kalshi and the public."""
    event = row["event"]
    away, home = event["away"], event["home"]
    lines = []
    name_w = 11
    head = Line().add(f"{'book':<{name_w}}", "header").add(f"{'spread':<17}", "header")
    head.add(f"{'total':<17}", "header").add("moneyline", "header")
    lines.append(head)
    books = row.get("books") or {}
    order = [name for _, name, _ in BOOKS if name in books] + \
        [name for name in ("Consensus", "Open") if name in books]
    if not books and row.get("espn_line"):
        books = {"ESPN": row["espn_line"]}
        order = ["ESPN"]
    best_ml = {}
    for side in ("away_ml", "home_ml"):
        prices = [books[n].get(side) for n in order if n not in ("Consensus", "Open")
                  and books[n].get(side) is not None]
        best_ml[side] = max(prices) if prices else None
    for name in order:
        line = books[name]
        style = "dim" if name in ("Consensus", "Open") else "normal"
        if name in (row.get("top_books") or []):
            style = "bold"
        out = Line().add(f"{name[:name_w - 1]:<{name_w}}", style)
        out.add(f"{spread_text(line, event, league):<17}", "normal")
        if line.get("total") is not None:
            total = f"{line['total']:g} {money_text(line.get('over_price'))}/" \
                    f"{money_text(line.get('under_price'))}" if line.get("over_price") else \
                f"{line['total']:g}"
        else:
            total = "-"
        out.add(f"{total:<17}", "normal")
        for side, sep in (("away_ml", "/"), ("home_ml", "")):
            value = line.get(side)
            best = value is not None and value == best_ml[side] and name not in ("Consensus", "Open")
            out.add(money_text(value), "good" if best else "normal")
            if sep:
                out.add(sep, "muted")
        lines.append(out)
    if not order:
        lines.append(Line().add("No sportsbook has posted a line for this game yet.", "dim"))
    if row.get("kalshi"):
        prob, volume = row["kalshi"]
        out = Line().add(f"{'Kalshi':<{name_w}}", "accent")
        out.add(f"{away['abbr']} {(1 - prob) * 100:.0f}% · {home['abbr']} {prob * 100:.0f}%",
                "normal")
        out.add(f"  prediction market, ${volume:,.0f} traded" if volume else
                "  prediction market", "dim")
        lines.append(out)
    public = row.get("public") or {}
    if public:
        lines.append(blank())
        lines.append(Line().add("Public  ", "accent").add("% of bets · % of money", "dim"))
        for market, sides, label in (("spread", ("away", "home"), "Spread"),
                                     ("ml", ("away", "home"), "Moneyline"),
                                     ("total", ("over", "under"), "Total")):
            parts = [(side, public.get(f"{market}:{side}")) for side in sides]
            if not any(info for _, info in parts):
                continue
            out = Line().add(f"  {label:<10}", "muted")
            for index, (side, info) in enumerate(parts):
                if index:
                    out.add("  ", "normal")
                name = event[side]["abbr"] if side in ("away", "home") else side.title()
                if info:
                    sharp = info[1] - info[0] >= 10
                    out.add(f"{name} {info[0]:.0f}·{info[1]:.0f}", "accent" if sharp else "normal")
            lines.append(out)
    return lines


def render_bet_model(row, league, width, min_edge):
    """Right half of the detail: the projection, its parts, and every bet."""
    event, model = row["event"], row["model"]
    away, home = event["away"], event["home"]
    lines = []
    if not model:
        lines.append(Line().add("Not enough data for a projection yet.", "dim"))
        return lines
    cfg = MODEL.get(league, MODEL["nfl"])
    unit = {"hockey": "goals", "baseball": "runs"}.get(sport_of(league), "pts")
    margin = model["margin"]
    leader = home if margin >= 0 else away
    head = Line().add("sportst  ", "accent")
    head.add(f"{leader['abbr']} by {abs(margin):.1f}", THEME.style(league, leader, bold=True))
    head.add(f" · {home['abbr']} {model['p_home'] * 100:.0f}% / {away['abbr']} "
             f"{(1 - model['p_home']) * 100:.0f}%", "normal")
    if model.get("proj"):
        a, h = model["proj"]
        digits = 1 if unit != "pts" else 0
        head.add(f" · proj {away['abbr']} {a:.{digits}f}-{h:.{digits}f} {home['abbr']}", "dim")
    lines.append(head)
    names = {"market": "Market", "kalshi": "Kalshi", "espn": "ESPN predictor",
             "stats": "Season stats"}
    for name, value, note in model["components"]:
        who = home if value >= 0 else away
        out = Line().add(f"  {names[name]:<15}", "muted")
        out.add(f"{who['abbr']} {abs(value):4.1f}", THEME.style(league, who))
        out.add(f"  {model['weights'][name] * 100:3.0f}%  ", "dim")
        out.add(note[: max(0, width - 34)], "dim")
        lines.append(out)
    for text, value in model.get("adjust") or []:
        if not value:
            continue
        lines.append(Line().add("    ± ", "muted").add(text[: width - 16], "normal")
                     .add(f"  {value:+.1f}", "warn"))
    if model.get("total") is not None:
        out = Line().add(f"  {'Total':<15}", "muted").add(f"{model['total']:.1f}", "normal")
        if model.get("stats_total") is not None:
            out.add(f"   season numbers say {model['stats_total']:.1f}", "dim")
        lines.append(out)
    signals = model.get("signals") or []
    if signals:
        lines.append(Line().add("Signals", "accent"))
        for market, side, text in signals[:5]:
            style = "warn" if side.startswith("!") else "normal"
            lines.append(Line().add("  • ", "muted").add(text[: width - 6], style))
    bets = row.get("bets") or []
    if bets:
        lines.append(Line().add("Bets  ", "accent").add(
            f"p = sportst's chance · edge = expected return per $1 · ★ at "
            f"{min_edge:g}% / {min_edge * 2:g}% / {min_edge * 3.5:g}%"[: width - 7], "dim"))
        seen = set()
        for bet in bets:
            key = (bet["kind"], bet["side"])
            if key in seen:
                continue
            seen.add(key)
            team = event.get(bet["side"]) if bet["side"] in ("away", "home") else None
            out = Line().add("  ", "normal")
            out.add(f"{bet_label(bet, event):<12}", THEME.style(league, team) if team else "normal")
            out.add(f"{money_text(bet['price']):>5} {BOOK_SHORT.get(bet['book'], bet['book'][:4]):<5}",
                    "dim")
            out.add(f" p {bet['p'] * 100:4.1f}%", "normal")
            out.add(f"  {bet['ev'] * 100:+5.1f}%", "good" if bet["ev"] > 0 else "bad")
            if bet["stars"]:
                out.add(f" {STAR * bet['stars']:<3}", "upset").add(f" {bet['stake']:.1f}u", "dim")
            lines.append(out)
        pick = row.get("pick")
        if pick and (pick["agree"] or pick["disagree"]):
            out = Line().add("  why  ", "muted")
            if pick["agree"]:
                out.add("for: " + ", ".join(dict.fromkeys(pick["agree"])), "good")
            if pick["disagree"]:
                out.add("  against: " + ", ".join(dict.fromkeys(pick["disagree"])), "bad")
            lines.append(out)
    return lines



