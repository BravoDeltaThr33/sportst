# -- the Olympics, through Wikipedia ------------------------------------------

WIKI_BASE = "https://en.wikipedia.org/wiki/"
WIKI_AGENT = ("Mozilla/5.0 (X11; Linux x86_64) sportst/" + VERSION +
              " (terminal scoreboard; personal use)")
WIKI_DIR = os.path.join(CACHE_DIR, "wiki")
OLYMPIC_LINK = re.compile(
    r"^(.+?) at the (\d{4}) (Summer|Winter) (?:Olympics|Olympic Games)(?: – (.+))?$")


class WikiTables(HTMLParser):
    """Headings, tables and infoboxes out of a rendered Wikipedia article.

    Cells come back as plain text plus two things the page only says with
    markup: the country a flag or link names, and the article a cell links
    to first (which is how an event row finds its own page)."""

    SKIP_CLASSES = ("sortkey", "mw-ref", "reference", "noprint", "mw-editsection",
                    "navbox", "sidebar", "metadata", "hatnote", "shortdescription",
                    "mw-cite-backlink", "reflist", "mw-empty-elt")
    VOID = {"br", "img", "hr", "meta", "link", "wbr", "input", "col", "source"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.sections = [{"title": "", "level": 1, "tables": [], "lead": ""}]
        self.stack = []
        self.skip = 0
        self.heading = None
        self.cell = None
        self.row = None
        self.in_caption = False
        self.para = None
        self.infobox = []
        self.links = []

    def _skippable(self, tag, attrs):
        if tag in ("style", "script", "sup"):
            return True
        style = (attrs.get("style") or "").replace(" ", "")
        if "display:none" in style:
            return True
        cls = attrs.get("class") or ""
        return any(name in cls for name in self.SKIP_CLASSES)

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if self.skip:
            if tag not in self.VOID:
                self.skip += 1
            return
        if tag == "a":
            title = attrs.get("title") or ""
            if title:
                self.links.append(title)
        if tag not in self.VOID and self._skippable(tag, attrs):
            self.skip = 1
            return
        if tag in ("h2", "h3", "h4") and not self.stack:
            self.heading = {"level": int(tag[1]), "text": ""}
        elif tag == "p" and not self.stack and self.para is None:
            self.para = ""
        elif tag == "table":
            cls = attrs.get("class") or ""
            self.stack.append({"class": cls, "rows": [], "caption": "",
                               "keep": "wikitable" in cls or "infobox" in cls})
        elif not self.stack:
            return
        elif tag == "caption":
            self.in_caption = True
        elif tag == "tr":
            self.row = []
        elif tag in ("td", "th") and self.row is not None:
            def span(name, top):
                digits = re.sub(r"\D", "", attrs.get(name) or "1") or "1"
                return clamp(int(digits), 1, top)
            self.cell = {"text": "", "th": tag == "th", "rowspan": span("rowspan", 60),
                         "colspan": span("colspan", 30), "noc": "", "link": "", "medal": ""}
        elif tag in ("br", "li", "div", "p") and self.cell is not None:
            if self.cell["text"].strip() and not self.cell["text"].endswith(" / "):
                self.cell["text"] += " / "
        elif tag == "a" and self.cell is not None:
            title = attrs.get("title") or ""
            match = OLYMPIC_LINK.match(title)
            if match and not match.group(4) and not self.cell["noc"]:
                self.cell["noc"] = match.group(1)
            if title and not self.cell["link"]:
                self.cell["link"] = title
        elif tag == "img" and self.cell is not None:
            alt = (attrs.get("alt") or "").lower()
            for medal in ("gold", "silver", "bronze"):
                if medal in alt and "medal" in alt:
                    self.cell["medal"] = medal

    def handle_endtag(self, tag):
        if self.skip:
            self.skip -= 1
            return
        if self.heading is not None and tag in ("h2", "h3", "h4"):
            self.sections.append({"title": re.sub(r"\s+", " ", self.heading["text"]).strip(),
                                  "level": self.heading["level"], "tables": [],
                                  "lead": ""})
            self.heading = None
        elif tag == "p" and self.para is not None and not self.stack:
            text = re.sub(r"\s+", " ", self.para).strip()
            if text and not self.sections[-1]["lead"]:
                self.sections[-1]["lead"] = text
            self.para = None
        elif not self.stack:
            return
        elif tag == "caption":
            self.in_caption = False
        elif tag in ("td", "th") and self.cell is not None and self.row is not None:
            self.cell["text"] = re.sub(r"\s+", " ", self.cell["text"]).strip(" /")
            self.row.append(self.cell)
            self.cell = None
        elif tag == "tr" and self.row is not None:
            if self.row:
                self.stack[-1]["rows"].append(self.row)
            self.row = None
        elif tag == "table":
            table = self.stack.pop()
            if table["keep"] and table["rows"]:
                entry = {"caption": re.sub(r"\s+", " ", table["caption"]).strip(),
                         "rows": expand_spans(table["rows"])}
                if "infobox" in table["class"]:
                    self.infobox.append(entry)
                elif not self.stack:
                    self.sections[-1]["tables"].append(entry)
            self.row = None
            self.cell = None

    def handle_data(self, data):
        if self.skip:
            return
        if self.heading is not None:
            self.heading["text"] += data
        elif self.stack:
            if self.in_caption:
                self.stack[-1]["caption"] += data
            elif self.cell is not None:
                self.cell["text"] += data
        elif self.para is not None:
            self.para += data


def expand_spans(rows):
    """Rows of cells with rowspan and colspan -> a rectangular grid of
    {text, th, noc, link, medal} dicts."""
    grid, pending = [], {}
    for row in rows:
        out, col, cells = [], 0, list(row)
        while cells or any(c >= col for c in pending):
            if col in pending:
                cell, left = pending[col]
                out.append(cell)
                if left <= 1:
                    del pending[col]
                else:
                    pending[col] = (cell, left - 1)
                col += 1
                continue
            if not cells:
                out.append({"text": "", "th": False, "noc": "", "link": "", "medal": ""})
                col += 1
                continue
            cell = cells.pop(0)
            for copy in range(cell["colspan"]):
                out.append(cell if copy == 0 else dict(cell, spill=True))
                if cell["rowspan"] > 1:
                    pending[col] = (cell if copy == 0 else dict(cell, spill=True),
                                    cell["rowspan"] - 1)
                col += 1
        grid.append([{k: c.get(k, False) for k in ("text", "th", "noc", "link", "medal",
                                                   "spill")}
                     for c in out])
    return grid


