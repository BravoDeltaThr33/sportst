        raw = [(ROSTER_HEADINGS.get(group.get("position"),
                                    clean(group.get("position") or "").upper()),
                group.get("items") or []) for group in athletes]
    else:
        raw = [("PLAYERS", athletes)]
    sport = sport_of(league)
    groups = []
    for heading, items in raw:
        players = [roster_player(item) for item in items
                   if isinstance(item, dict) and item.get("id")]
        if sport == "football":
            players.sort(key=lambda p: (FOOTBALL_ORDER.index(p["pos"])
                                        if p["pos"] in FOOTBALL_ORDER else 99,
                                        _int(p["jersey"], 999)))
        elif sport == "basketball":
            players.sort(key=lambda p: _int(p["jersey"], 999))
        if players:
            groups.append((heading, players))
    return groups


def ahl_roster(team_id, timeout=15):
    """An AHL team's roster from HockeyTech, as roster_groups gives ESPN's."""
    season = ht_season("regular", timeout) or {}
    data = ht_get({"feed": "statviewfeed", "view": "roster", "team_id": team_id,
                   "season_id": season.get("season_id", ""), "site_id": 3, "league_id": 4,
                   "rosterstatus": "undefined"}, timeout)
    groups = []
    for block in (data or {}).get("roster") or []:
        for section in block.get("sections") or []:
            players = []
            for entry in section.get("data") or []:
                row = (entry or {}).get("row") or {}
                ident = clean(str(row.get("player_id") or dig(entry, "prop", "name",
                                                                 "playerLink", default="")))
                if not ident:
                    continue
                height = clean(row.get("height_hyphenated") or "")
                if re.fullmatch(r"\d-\d{1,2}", height):
                    feet, inches = height.split("-")
                    height = f"{feet}' {inches}\""
                weight = clean(str(row.get("w") or row.get("weight") or ""))
                pos = clean(row.get("position") or "")
                players.append({
                    "id": ident, "name": clean(row.get("name") or ""),
                    "jersey": clean(str(row.get("tp_jersey_number") or "")), "pos": pos,
                    "position": {"C": "Center", "LW": "Left Wing", "RW": "Right Wing",
                                 "D": "Defense", "G": "Goalie", "F": "Forward"}.get(pos, pos),
                    "photo": "", "age": years_since(clean(row.get("birthdate") or "")),
                    "height": height, "weight": f"{weight} lbs" if weight.isdigit() else weight,
                    "birthplace": clean(row.get("birthplace") or ""), "college": "",
                    "experience": "", "status": "", "injury": ""})
            if players:
                groups.append((clean(section.get("title") or "").upper(), players))
    return groups


def espn_player_card(league, player_id, timeout=15):
    """A player's card from ESPN's athlete pages: who he is, the latest note
    on him, his numbers (this season, his last games, his career), his last
    games one by one, his awards and the teams he has played for."""
    meta = LEAGUES[league]
    base = ESPN_ATHLETE.format(meta["sport"], meta["path"],
                               urllib.parse.quote(str(player_id)))
    athlete = http_json(base, timeout).get("athlete") or {}
    try:
        overview = http_json(base + "/overview", timeout)
    except Exception:  # noqa: BLE001 - the card shows what it has
        overview = {}
    try:
        bio = http_json(base + "/bio", timeout)
    except Exception:  # noqa: BLE001
        bio = {}
    try:
        history = http_json(base + "/stats", timeout)
    except Exception:  # noqa: BLE001
        history = {}
    position = athlete.get("position") or {}
    card = {
        "id": str(player_id),
        "name": clean(athlete.get("displayName") or ""),
        "jersey": clean(athlete.get("jersey") or ""),
        "position": clean(position.get("displayName") or ""),
        "team": clean(dig(athlete, "team", "displayName", default="") or ""),
        "height": clean(athlete.get("displayHeight") or ""),
        "weight": clean(athlete.get("displayWeight") or ""),
        "age": athlete.get("age") if isinstance(athlete.get("age"), int) else None,
        "born": birth_day(athlete.get("displayDOB")),
        "birthplace": clean(athlete.get("displayBirthPlace") or ""),
        "college": clean(dig(athlete, "college", "name", default="") or ""),
        "draft": clean(athlete.get("displayDraft") or ""),
        "experience": clean(athlete.get("displayExperience") or ""),
        "hand": "",
        "status": clean(dig(athlete, "status", "name", default="") or ""),
        "photo": clean(dig(athlete, "headshot", "href", default="") or ""),
        "url": next((clean(link.get("href") or "") for link in athlete.get("links") or []
                     if "playercard" in (link.get("rel") or [])), ""),
        "note": "", "story": "", "stats": None, "games": None, "seasons": None,
        "awards": [], "teams": []}
    sport = meta["sport"]
    hand = clean(dig(athlete, "hand", "displayValue", default="") or "")
    if sport == "baseball" and clean(athlete.get("displayBatsThrows") or ""):
        card["hand"] = "bats / throws " + clean(athlete["displayBatsThrows"])
    elif sport == "hockey" and hand:
        card["hand"] = ("catches " if clean(position.get("abbreviation") or "") == "G"
                        else "shoots ") + hand.lower()
    roto = overview.get("rotowire") or {}
    card["note"] = clean(roto.get("headline") or "")
    card["story"] = clean(roto.get("story") or "")
    if not card["note"]:
        news = [n for n in overview.get("news") or [] if clean(n.get("headline") or "")]
        if news:
            card["note"] = clean(news[0].get("headline") or "")
    stats = overview.get("statistics") or {}
    rows = [(STAT_SPLITS.get(clean(split.get("displayName") or ""),
                             clean(split.get("displayName") or "")),
             [clean(str(value)) for value in split.get("stats") or []])
            for split in stats.get("splits") or []
            if clean(split.get("displayName") or "") != "Projected"]
    if stats.get("labels") and rows:
        labels = [clean(label) for label in stats["labels"]]
        groups, at = [], 0
        for category in stats.get("categories") or []:
            count = category.get("count") if isinstance(category, dict) else 0
            if isinstance(count, int) and count > 0:
                groups.append((clean(category.get("displayName") or ""), at, count))
                at += count
        card["stats"] = {"title": clean(stats.get("displayName") or ""), "labels": labels,
                         "rows": rows, "groups": groups if at == len(labels) and
                         len(groups) > 1 else []}
    if not (card["stats"] and all(re.fullmatch(r"\d{4}", name)
                                  for name, _ in card["stats"]["rows"])):
        # college's numbers come a season a row already
        wanted = [clean(category.get("name") or "").lower()
                  for category in stats.get("categories") or [] if isinstance(category, dict)]
        card["seasons"] = season_table(history, wanted)
    log = overview.get("gameLog") or {}
    labels, groups, by_event, order = [], [], {}, []
    for block in log.get("statistics") or []:
        if not isinstance(block, dict) or not block.get("labels"):
            continue
        names = [clean(label) for label in block["labels"]]
        groups.append((clean(block.get("displayName") or ""), len(labels), len(names)))
        for entry in block.get("events") or []:
            ident = str(entry.get("eventId"))
            if ident not in by_event:
                by_event[ident] = [""] * len(labels)
                order.append(ident)
            values = [clean(str(value)) for value in entry.get("stats") or []]
            by_event[ident] = by_event[ident][:len(labels)] + \
                (values + [""] * len(names))[:len(names)]
        labels += names
        for ident in order:
            by_event[ident] += [""] * (len(labels) - len(by_event[ident]))
    games = []
    for ident in order:
        info = (log.get("events") or {}).get(ident) or {}
        when = parse_iso(info.get("gameDate"))
        games.append({"date": strf(_local(info.get("gameDate")), "%-m/%-d") if when else "",
                      "opp": f"{clean(info.get('atVs') or '')} "
                             f"{clean(dig(info, 'opponent', 'abbreviation', default='') or '')}"
                      .strip(),
                      "result": " ".join(part for part in (clean(info.get("gameResult") or ""),
                                                           clean(info.get("score") or ""))
                                         if part),
                      "stats": by_event[ident]})
    if games and labels:
        card["games"] = {"labels": labels, "rows": games,
                         "groups": groups if len(groups) > 1 else []}
    for award in bio.get("awards") or []:
        seasons = ", ".join(clean(str(s)) for s in award.get("seasons") or [])
        card["awards"].append((clean(award.get("name") or ""),
                               clean(award.get("displayCount") or ""), seasons))
    for team in bio.get("teamHistory") or []:
        card["teams"].append((clean(team.get("displayName") or ""),
                              clean(str(team.get("seasons") or "")).replace("CURRENT",
                                                                            "now")))
    return card


def season_table(history, wanted=()):
    """A player's numbers season by season from ESPN's athlete stats: the
    categories `wanted` (the ones his summary shows: passing, rushing ...), or
    else the first; newest season first, each with his team, then his career.
    {"title", "labels", "groups", "rows": [(label, values)]}, or None."""
    categories = [category for category in (history or {}).get("categories") or []
                  if isinstance(category, dict) and category.get("labels")
                  and category.get("statistics")]
    if not categories:
        return None
    chosen = [category for category in categories
              if clean(category.get("name") or "").lower() in wanted] or categories[:1]
    teams = {slug: clean((team or {}).get("abbreviation") or "")
             for slug, team in ((history or {}).get("teams") or {}).items()
             if isinstance(team, dict)}
    labels, groups, rows, order, career = [], [], {}, [], []
    for number, category in enumerate(chosen):
        names = [clean(label) for label in category["labels"]]
        skip = 1 if number and names[:1] == ["GP"] and labels[:1] == ["GP"] else 0
        names = names[skip:]
        groups.append((clean(category.get("displayName") or "").strip(), len(labels),
                       len(names)))
        for entry in category["statistics"]:
            season = entry.get("season") or {}
            key = (str(season.get("year") or ""), clean(entry.get("teamSlug") or ""))
            if key not in rows:
                rows[key] = [""] * len(labels)
                order.append((key, clean(season.get("displayName") or "")))
            values = [clean(str(value)) for value in entry.get("stats") or []][skip:]
            rows[key] = rows[key][:len(labels)] + (values + [""] * len(names))[:len(names)]
        totals = [clean(str(value)) for value in category.get("totals") or []][skip:]
        career += (totals + [""] * len(names))[:len(names)]
        labels += names
        for key, _ in order:
            rows[key] += [""] * (len(labels) - len(rows[key]))
    order.sort(key=lambda item: _int(item[0][0], 0), reverse=True)
    table = [(f"{shown} {teams.get(key[1], '')}".strip(), rows[key]) for key, shown in order]
    if any(career):
        table.append(("Career", career))
    title = clean(chosen[0].get("displayName") or "").strip() if len(chosen) == 1 else ""
    return {"title": title, "labels": labels, "rows": table,
            "groups": groups if len(groups) > 1 else []}


