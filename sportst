           "name sits in its header row's first cell; the Totals row is the team. "
           "Dimmed players came off the bench."),
    ])]
    seen = {}
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        for section in block.get("statistics") or []:
            title = stat_section_title(section)
            for prefix in (dig(block, "team", "displayName", default=""),
                           dig(block, "team", "location", default="")):
                if prefix and title.lower().startswith(prefix.lower() + " "):
                    title = title[len(prefix) + 1:]
            labels = section.get("labels") or []
            descriptions = section.get("descriptions") or []
            for index, label in enumerate(labels):
                text = descriptions[index] if index < len(descriptions) else ""
                text = clean(text).rstrip("./")
                key = (title, label)
                if key not in seen:
                    seen[key] = text or BOX_GLOSSARY.get(label, "")
    grouped = {}
    for (title, label), text in seen.items():
        grouped.setdefault(title or "Players", []).append((label, text.lower() if text
                                                           and text.isupper() else text))
    for title, entries in grouped.items():
        sections.append((title, entries))
    if len(sections) == 1:
        sections.append(("", [_p("The box score has not been published yet.")]))
    return sections


