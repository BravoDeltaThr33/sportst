                  (True, True, False, True): "├", (True, True, True, True): "┼",
                  (False, True, True, True): "┬", (True, False, True, True): "┴",
                  (True, True, False, False): "│", (False, False, False, True): "─"}


def bracket_rows(rounds, connect=True):
    """({(column, index): top row}, {(column, index): [the series that fed it]}).

    A wired bracket is laid out as a tree from the final back: each series
    level with the ones that fed it, and those always next to each other, so
    no two wires cross. A series nothing fed (the first round, a team off a
    bye) takes the next free slot; a game for third sits under the final.
    """
    rows, feeders = {}, {}
    if not connect:
        for column, (_, entries) in enumerate(rounds):
            for index in range(len(entries)):
                rows[(column, index)] = index * 3
        return rows, feeders
    columns = len(rounds)
    parent = {}
    for column in range(1, columns):
        previous = rounds[column - 1][1]
        for index, entry in enumerate(rounds[column][1]):
            teams = set(series_teams(entry))
            fed = []
            for j, earlier in enumerate(previous):
                winner = series_winner(earlier)
                if (column - 1, j) not in parent and winner and winner in teams:
                    fed.append((column - 1, j))
                    parent[(column - 1, j)] = (column, index)
            feeders[(column, index)] = fed
    consolation = set()
    for column in range(1, columns):
        beaten = set()
        for entry in rounds[column - 1][1]:
            winner = series_winner(entry)
            if winner:
                beaten.update(t for t in series_teams(entry) if t != winner)
        for index, entry in enumerate(rounds[column][1]):
            teams = series_teams(entry)
            if not feeders[(column, index)] and (column, index) not in parent and (
                    (teams and all(t in beaten for t in teams))
                    or "bronze" in (entry.get("round") or "").lower()
                    or "third" in (entry.get("round") or "").lower()):
                consolation.add((column, index))
    groups = []
    for _, entries in rounds:
        for entry in entries:
            if entry.get("conference") and entry["conference"] not in groups:
                groups.append(entry["conference"])

    def group_rank(node):
        conference = rounds[node[0]][1][node[1]].get("conference") or ""
        return groups.index(conference) if conference in groups else -1

    roots = [(column, index) for column in range(columns)
             for index in range(len(rounds[column][1]))
             if (column, index) not in parent and (column, index) not in consolation]
    roots.sort(key=lambda node: (group_rank(node), -node[0], node[1]))
    slot = [0]

    def place(node):
        fed = feeders.get(node) or []
        for child in fed:
            place(child)
        if fed:
            rows[node] = sum(rows[child] for child in fed) / len(fed)
        else:
            rows[node] = slot[0] * 3
            slot[0] += 1

    for root in roots:
        place(root)
    for node in sorted(consolation):
        above = [row for (column, _), row in rows.items() if column == node[0]]
        if above:
            rows[node] = max(above) + 4
        else:
            rows[node] = slot[0] * 3
            slot[0] += 1
    return rows, feeders


def bracket_layout(rounds, width, league, favorites=None, connect=True):
    """Draw the rounds as columns, each series wired to the one it feeds.

    A series sits level with the two it came from, so a team's run reads
    left to right across the page.
    """
    if not rounds:
        return []
    favorites = favorites or {}
    columns = len(rounds)
    gap = 4
    box = clamp((width - 2) // columns - gap, 15, 26)
    step = box + gap

    rows, feeders = bracket_rows(rounds, connect)
    height = int(max(rows.values(), default=0)) + 5
    canvas = [[(" ", "normal") for _ in range(width)] for _ in range(height)]

    joints = set("─│┌┐└┘├┤┬┴┼")

    def put(row, col, text, style):
        if not 0 <= row < height:
            return
        for offset, char in enumerate(text):
            if not 0 <= col + offset < width:
                continue
            old = canvas[row][col + offset][0]
            if {old, char} == {"─", "│"}:
                char = "┼"
            canvas[row][col + offset] = (char, style)

    for column, (name, entries) in enumerate(rounds):
        x = column * step
        put(0, x, name[:box].center(box), "header")
        for index, entry in enumerate(entries):
            row = int(rows[(column, index)]) + 2
            decided = bool(series_winner(entry))
            for which, offset in (("top", 0), ("bottom", 1)):
                spot = entry[which]
                team = spot.get("team") or {}
                if not team:
                    continue
                seed = spot.get("seed")
                label = f"({seed}) " if seed not in (None, "") else ""
                known = real_team(team)
                abbr = (team.get("abbr") if known else "") or team.get("short") \
                    or team.get("name") or "?"
                score = spot.get("score")
                text = f"{label}{abbr}"[: box - 4]
                style = THEME.style(league, team, bold=spot.get("winner"),
                                    dim=decided and not spot.get("winner"),
                                    fallback="normal") if known else "muted"
                star = fav_rank(favorites, league, team) >= 0
                put(row + offset, x, ("★" if star else " ") + text,
                    "star" if star else style)
                put(row + offset, x + 1 + len(text), "", style)
                put(row + offset, x + box - 4,
                    f"{'' if score is None else score:>3}",
                    "bold" if spot.get("winner") else style)
                if spot.get("winner"):
                    put(row + offset, x + box - 1, "✓", "good")
            if entry.get("status") and row + 2 < height:
                put(row + 2, x, entry["status"][: box], "muted")

        if column + 1 >= columns or not connect:
            continue
        # wire each series in the next round back to the ones that fed it
        mid = x + box + gap // 2
        for child in range(len(rounds[column + 1][1])):
            # each wire leaves from the winner's line of the series that fed it
            fed = sorted(int(rows[node]) + 2
                         + (1 if rounds[node[0]][1][node[1]]["bottom"].get("winner") else 0)
                         for node in feeders.get((column + 1, child), []))
            if not fed:
                continue
            end = int(rows[(column + 1, child)]) + 2
            low, high = min(fed + [end]), max(fed + [end])
            for row in range(low, high + 1):
                put(row, mid, BRACKET_JOINTS.get((row > low, row < high, row in fed,
                                                  row == end), "│"), "border")
            for feeder in fed:
                for col in range(x + box, mid):
                    put(feeder, col, "─", "border")
            for col in range(mid + 1, x + step):
                put(end, col, "─", "border")

    lines = []
    for row in canvas:
        line = Line()
        for char, style in row:
            line.add(char, style)
        lines.append(merge_spans(line))
    while lines and not lines[-1].text.strip():
        lines.pop()
    return lines


def champion_line(rounds, league):
    """♛ and the champion, once the last round is decided."""
    if not rounds:
        return None
    name, entries = rounds[-1]
    if is_olympic(league):
        entries = [e for e in entries if e.get("round") == "Gold"]
        name = "Olympic gold"
    else:
        name = f"{name} winner"
    wins, teams = {}, {}
    for entry in entries:
        for which in ("top", "bottom"):
            spot = entry[which]
            key = team_key(spot.get("team"))
            if key and spot.get("winner"):
                wins[key] = wins.get(key, 0) + 1
                teams[key] = spot["team"]
    # one series, or a final played as single games (best of three)
    need = 1 if len(entries) == 1 else 2
    champion = next((key for key, count in wins.items() if count >= need), None)
    if not champion:
        return None
    team = teams[champion]
    line = Line().add("♛ ", "medalgold")
    line.add(team.get("name") or team.get("abbr") or "?",
             THEME.style(league, team, bold=True, fallback="accent"))
    line.add(f"  {name}", "dim")
    return line


def render_ranking_picture(data, league, width, favorites, field=12):
    """College football has no seeds until December, so the poll stands in for
    the playoff field."""
    polls = dig(data, "rankings", default=[]) or []
    if not polls:
        return []
    poll = polls[0]
    lines = [Line().add(clean(poll.get("name") or "Poll"), "title"),
             Line().add(clean(dig(poll, "occurrence", "displayValue", default="")),
                        "muted"), blank()]
    block = []
    for row in poll.get("ranks") or []:
        team = {"id": str(dig(row, "team", "id", default="")),
                "abbr": clean(dig(row, "team", "abbreviation", default="")),
                "name": clean(dig(row, "team", "name", default="")),
                "short": clean(dig(row, "team", "shortDisplayName", default="")),
                "location": clean(dig(row, "team", "location", default="")),
                "color": clean(dig(row, "team", "color", default=""))}
        rank = row.get("current")
        inside = isinstance(rank, int) and rank <= field
        line = Line().add(f" {rank:>2} ", "accent" if inside else "muted")
        star = fav_rank(favorites, league, team) >= 0
        line.add("★" if star else " ", "star" if star else "normal")
        line.add(f"{standings_name(league, team)[:22]:<23}",
                 THEME.style(league, team, bold=inside, dim=not inside))
        line.add(f"{clean(row.get('recordSummary') or ''):<8}", "normal")
        points = row.get("points")
        line.add(f"{points:,}" if points else "", "dim")
        block.append(line)
        if rank == field:
            block.append(Line().add("    " + "┄" * 34, "border"))
    lines.extend(flow_columns([block[: len(block) // 2 + 1], block[len(block) // 2 + 1:]],
                              width))
    return lines


# how many make the postseason from each group, and where the cut lines go
# (the NBA's 7 to 10 play in for the last two spots)
PICTURE_CUTS = {"nfl": [(7, "")], "nhl": [(8, "")], "mlb": [(6, "")],
                "cfb": [(12, "")], "cbase": [(8, "")], "nba": [(6, "play-in"), (10, "")]}


def render_playoff_picture(data, league, width, favorites):
    """Before the postseason starts: who would be in, by seed, conference by
    conference (division by division in the AHL, whose playoffs run that way)."""
    if not isinstance(data, dict):
        return [Line().add("No standings to build a playoff picture from.", "dim")]
    root = data
    if "content" in data:
        root = dig(data, "content", "standings", default=data) or data
    groups = []
    walk_standings(root, [], groups)
    if not groups:
        return [Line().add("No standings to build a playoff picture from.", "dim")]
    hockey = LEAGUES[league]["sport"] == "hockey"
    seeded = {}
    for title, entries in groups:
        parts = title.split(" — ")
        # the conference, not the division: the seeds run conference-wide
        conference = parts[-1] if league == "ahl" or len(parts) < 3 else parts[-2]
        for entry in entries:
            table = stat_lookup(entry)
            try:
                seed = int(stat_display(table, ["playoffSeed"]))
            except (TypeError, ValueError):
                continue
            wins, losses = stat_display(table, ["wins"]), stat_display(table, ["losses"])
            record = f"{wins}-{losses}" if wins != "-" else ""
            if hockey and record:
                extra = [stat_display(table, ["otLosses", "OTL"])]
                if league == "ahl":
                    extra.append(stat_display(table, ["shootoutLosses", "SOL"]))
                record += "".join(f"-{x}" for x in extra if x not in ("", "-"))
            elif record:
                ties = stat_display(table, ["ties"])
                if ties not in ("", "-", "0"):
                    record += f"-{ties}"
            points = stat_display(table, ["points"]) if hockey else ""
            seeded.setdefault(conference, []).append(
                (seed, entry_team(entry), record, points, stat_display(table, ["streak"])))
    if not seeded:
        return []
    blocks = []
    for conference, rows in seeded.items():
        cuts = PICTURE_CUTS.get(league, [(8, "")])
        if league == "ahl":
            cuts = [(next((n for key, n in AHL_PLAYOFF_SPOTS.items() if key in conference),
                          5), "")]
        last = cuts[-1][0]
        rows.sort(key=lambda row: row[0])
        block = [Line().add("── ", "border").add(f"{conference} ", "title")]
        for seed, team, record, points, streak in rows[: last + 4]:
            line = Line()
            inside = seed <= last
            line.add(f" {seed:>2} ", "accent" if inside else "muted")
            star = fav_rank(favorites, league, team) >= 0
            line.add("★" if star else " ", "star" if star else "normal")
            name = standings_name(league, team)
            line.add(f"{name[:22]:<23}", THEME.style(league, team, bold=inside,
                                                     dim=not inside))
            line.add(f"{record:<10}", "normal" if inside else "dim")
            if hockey:
                line.add(f"{points + ' pts' if points not in ('', '-') else '':<8}",
                         "normal" if inside else "dim")
            line.add(streak if streak != "-" else "", "dim")
            block.append(line)
            for spot, label in cuts:
                if seed == spot:
                    rule_text = f" {label} " if label else ""
                    dashes = (45 if hockey else 37) - len(rule_text)
                    block.append(Line().add("    " + "┄" * (dashes // 2) + rule_text
                                            + "┄" * (dashes - dashes // 2), "border"))
        blocks.append(block)
    return flow_columns(blocks, width)


