def bracket_ahl(data):
    brackets = (data or {}).get("brackets") or {}
    teams = brackets.get("teams") or {}
    rounds = []
    needed = {1: 2, 2: 3, 3: 3, 4: 4, 5: 4}
    for node in brackets.get("rounds") or []:
        number = _int(node.get("round"))
        name = AHL_ROUNDS[number - 1] if 1 <= number <= len(AHL_ROUNDS) else \
            clean(node.get("round_name") or f"Round {number}")
        entries = []
        for match in node.get("matchups") or []:
            spots = []
            for which in ("team1", "team2"):
                info = teams.get(str(match.get(which))) or {}
                wins = _int(match.get(f"{which}_wins"))
                team = {"id": str(info.get("id") or ""), "abbr": clean(info.get("team_code")
                                                                      or ""),
                        "name": clean(info.get("name") or ""),
                        "short": clean(info.get("city") or ""), "location": "",
                        "color": ""}
                spots.append((team, wins))
            goal = needed.get(number, 4)
            winner = clean(str(match.get("winner") or ""))
            sides = []
            for team, wins in spots:
                won = (winner and winner == team["id"]) or wins >= goal
                sides.append(side(team, None, wins, won))
            series_name = clean(match.get("series_name") or "")
            conference = series_name.split(" ")[0] if series_name else ""
            status = f"best of {2 * goal - 1}"
            entries.append(series(name, conference, sides[0], sides[1], status,
                                  series_name))
        if entries:
            rounds.append((name, entries))
    return rounds


