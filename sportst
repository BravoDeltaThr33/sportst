def espn_team_dates(league, team_id, timeout=15):
    """{day: {'id', 'opp', 'home', 'when'}} for one team's season."""
    meta = LEAGUES[league]
    base = (f"apis/site/v2/sports/{meta['sport']}/{meta['path']}/teams/"
            f"{urllib.parse.quote(str(team_id))}/schedule")
    out = {}
    for query in ("", "?seasontype=2", "?seasontype=3"):
        try:
            data = fetch_first((f"https://{SITE_HOSTS[0]}/{base}{query}",
                                [f"https://{SITE_HOSTS[1]}/{base}{query}"]), timeout)
        except Exception:  # noqa: BLE001 - another season type may answer
            continue
        for event in data.get("events") or []:
            game = _glance_game(event, team_id)
            if not game:
                continue
            day = game_day(game["date"], game.get("time_tba"))
            if day and day not in out:
                out[day] = {"id": game["id"], "opp": game["opp"], "home": game["home"],
                            "when": glance_when(game) if game["state"] == "pre" else
                            f"{game['result']} {game['us']}-{game['them']}".strip()}
    return {"dates": out}


def month_grid(first):
    """Weeks of the month as lists of Date or None, Sunday first."""
    start = first - timedelta(days=(first.weekday() + 1) % 7)
    weeks = []
    day = start
    while True:
        week = []
        for _ in range(7):
            week.append(day if day.month == first.month else None)
            day += timedelta(days=1)
        weeks.append(week)
        if day.month != first.month and day > first:
            break
    return weeks


def add_months(day, delta):
    month = day.month - 1 + delta
    year = day.year + month // 12
    month = month % 12 + 1
    last = (Date(year + (month == 12), month % 12 + 1, 1) - timedelta(days=1)).day
    return Date(year, month, min(day.day, last))


