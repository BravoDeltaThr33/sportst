            elif cursor_line >= offset + view - 1:
                offset = cursor_line - view + 2
            offset = clamp(offset, 0, max(0, len(rows) - view))
            self.scroll["Settings"] = offset
            self.draw_box(top, 0, height, left_width)
            self.draw_lines([caption], top, 2, 1, inner, 0)
            self.draw_lines(rows, top + 1, 2, view, inner, offset)
            self.draw_scrollbar(top + 1, left_width - 2, view, len(rows), offset)
            self.draw_lines(detail, top + 1 + view, 2, len(detail), inner, 0)
            right_width = width - left_width
            about = render_settings_about(self, right_width - 4)
            right_view = height - 2
            key = "SettingsAbout"
            self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(about) - right_view))
            self.draw_box(top, left_width, height, right_width)
            self.draw_lines([Line().add(" About sportst ", "accent").add(
                "· data sources · controls · J / K scroll ", "muted")],
                top, left_width + 2, 1, right_width - 4, 0)
            self.draw_lines(about, top + 1, left_width + 2, right_view, right_width - 4,
                            self.scroll[key])
            self.draw_scrollbar(top + 1, width - 2, right_view, len(about), self.scroll[key])
            return
        # the list and the About text scroll together; the highlighted
        # setting's explanation stays pinned underneath when there is room
        lines = rows + [blank()] + render_settings_about(self, inner)
        if height - 2 - len(detail) < 6:
            detail = []
        view = height - 2 - len(detail)
        offset = self.scroll["Settings"]
        if self._settings_follow:
            if cursor_line < offset + 1:
                offset = max(0, cursor_line - 1)
            elif cursor_line >= offset + view - 1:
                offset = cursor_line - view + 2
            self._settings_follow = False
        offset = clamp(offset, 0, max(0, len(lines) - view))
        self.scroll["Settings"] = offset
        self.draw_box(top, 0, height, width)
        self.draw_lines([caption], top, 2, 1, inner, 0)
        self.draw_lines(lines, top + 1, 2, view, inner, offset)
        self.draw_scrollbar(top + 1, width - 2, view, len(lines), offset)
        if detail:
            self.draw_lines(detail, top + 1 + view, 2, len(detail), inner, 0)

    def handle_settings_key(self, key):
        """Return True when the Settings screen has taken the key."""
        count = len(SETTING_ROWS)
        wide = self.stdscr.getmaxyx()[1] - 1 >= self.SPLIT_MIN_WIDTH
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6}
        if key in moves:
            self.settings_cursor = clamp(self.settings_cursor + moves[key], 0, count - 1)
            self._settings_follow = True
        elif key in (ord("h"), curses.KEY_LEFT, ord("l"), curses.KEY_RIGHT):
            spec = self.settings_spec()
            if spec["kind"] in ("bool", "choice", "int", "float", "color"):
                delta = -1 if key in (ord("h"), curses.KEY_LEFT) else 1
                self.set_setting(spec, step_setting(spec, self.setting_value(spec), delta))
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.edit_setting()
        elif key == ord("R"):
            spec = self.settings_spec()
            if spec["kind"] != "action":
                default = setting_default(spec)
                self.set_setting(spec, list(default) if isinstance(default, list) else default)
        elif key in (ord("J"), ord("K"), curses.KEY_NPAGE, curses.KEY_PPAGE):
            step = {ord("J"): 1, ord("K"): -1}.get(key, 0)
            if not step:
                page = max(1, self.stdscr.getmaxyx()[0] - 8)
                step = page if key == curses.KEY_NPAGE else -page
            target = "SettingsAbout" if wide else "Settings"
            self.scroll[target] = max(0, self.scroll[target] + step)
        elif key in (ord("G"),):
            target = "SettingsAbout" if wide else "Settings"
            self.scroll[target] = 10 ** 6
        else:
            return False
        return True

