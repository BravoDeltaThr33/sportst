             ["#FFB81C", "#E82A2A", "#8C2020"], "#3A0C0C"),
    "abc": (["#FFFFFF", "#FFF0A0", "#FFD100", "#5C8DF6", "#2B5FD9"],
            ["#FFD100", "#FFFFFF", "#2B5FD9"], "#0E2152"),
