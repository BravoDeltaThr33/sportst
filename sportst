def _luma(rgb):
    """Relative luminance (WCAG) of an RGB triple."""
    def channel(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (channel(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _contrast(a, b):
    la, lb = _luma(a), _luma(b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)


def badge_colours(primary_hex, alt_hex):
    """(fill, letters, rim, bar) for a team's badge: its colour, the most
    legible of white, its second colour and near-black for the letters, and
    a rim and bottom bar in its second colour (light grey where that colour
    would vanish into a dark screen)."""
    fill = hex_to_rgb("#" + (primary_hex or "5A5A5A").lstrip("#")) or (90, 90, 90)
    alt = hex_to_rgb("#" + alt_hex.lstrip("#")) if alt_hex else None
    if alt is not None and color_distance(alt, fill) < 2500:
        alt = None
    options = [BADGE_INK] + ([alt] if alt else []) + [BADGE_DARK]
    best = max(_contrast(o, fill) for o in options)
    letters = next(o for o in options if _contrast(o, fill) >= best * 0.85)
    rim = alt if alt is not None and max(alt) > 80 else BADGE_GREY
    bar = alt if alt is not None else letters
    return fill, letters, rim, bar


def badge_pixels(text, colours, bold=True, pad=2):
    """The badge as rows of RGB triples (None is clear), 12 pixels tall."""
    fill, letters, rim, bar = colours
    glyphs = []
    for ch in text.upper():
        rows = (BADGE_BOLD.get(ch) if bold else None) or BADGE_FONT.get(ch)
        if rows is None:
            rows = BADGE_FONT["-"] if ch not in " " else "00000 " * 6 + "00000"
        rows = rows.split()
        if bold and ch not in BADGE_BOLD:
            # a bold stroke: every lit pixel also lights the one to its right
            rows = ["".join("1" if (i < len(r) and r[i] == "1") or (i and r[i - 1] == "1")
                            else "0" for i in range(len(r) + 1)) for r in rows]
        glyphs.append(rows)
    inner = sum(len(g[0]) for g in glyphs) + max(0, len(glyphs) - 1)
    width, height = inner + 2 * pad + 4, 12
    grid = [[None] * width for _ in range(height)]
    for y in range(height):
        for x in range(width):
            edge_x, edge_y = x in (0, width - 1), y in (0, height - 1)
            if edge_x and edge_y:
                continue                            # rounded outer corners
            if edge_x or edge_y or (x in (1, width - 2) and y in (1, height - 2)):
                grid[y][x] = rim
            else:
                grid[y][x] = fill
    for x in range(2, width - 2):
        grid[height - 2][x] = bar                   # the score bug's bottom bar
    x = 2 + pad
    for rows in glyphs:
        for gy, row in enumerate(rows):
            for gx, bit in enumerate(row):
                if bit == "1":
                    grid[2 + gy][x + gx] = letters
        x += len(rows[0]) + 1
    return grid


def pixel_lines(grid):
    """RGB pixel rows (None clear) as Lines, two pixels a cell with half
    blocks, in exact colours."""
    lines = []
    for y in range(0, len(grid) - 1, 2):
        line = Line()
        for top, bottom in zip(grid[y], grid[y + 1]):
            if top is None and bottom is None:
                cell = (" ", "normal")
            elif top == bottom:
                cell = ("█", "@" + _hex(top))
            elif top is None:
                cell = ("▄", "@" + _hex(bottom))
            elif bottom is None:
                cell = ("▀", "@" + _hex(top))
            elif top < bottom:
                cell = ("▀", "@" + _hex(top) + ":" + _hex(bottom))
            else:
                cell = ("▄", "@" + _hex(bottom) + ":" + _hex(top))
            if line and line[-1][1] == cell[1]:
                line[-1] = (line[-1][0] + cell[0], cell[1])
            else:
                line.append(cell)
        lines.append(line)
    return lines


def render_badge(team, league, max_cols, max_rows):
    """A team's badge in at most max_cols x max_rows cells (six rows), or []
    when it does not fit."""
    if max_rows < 6:
        return []
    text = re.sub(r"[^A-Z0-9&.'-]", "", (team.get("abbr") or "").upper())[:5]
    if not text:
        return []
    colours = badge_colours(team_hex(league, team), team.get("alt_color") or "")
    for bold, pad in ((True, 2), (False, 2), (False, 1)):
        grid = badge_pixels(text, colours, bold, pad)
        if len(grid[0]) <= max_cols:
            return pixel_lines(grid)
    return []


