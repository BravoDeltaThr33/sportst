EDGE = 0.35          # how far apart two percentiles must be to call it an edge


def _percentile(rank, total):
    if not rank or total < 2:
        return None
    return 1.0 - (rank - 1) / (total - 1)


def matchup_edges(table, ranks, away_row, home_row, away, home):
    """[(side, size, text)] - the places one team's numbers say it should win
    the matchup, strongest first."""
    stats = {s["key"]: s for s in table.get("stats") or []}
    totals = {key: len(r) for key, r in ranks.items()}
    edges = []
    for side_name, attack, defend, a_team, d_team in (
            ("away", away_row, home_row, away, home), ("home", home_row, away_row, home, away)):
        for stat in table.get("stats") or []:
            partner = stats.get(stat.get("vs") or "")
            if not partner:
                continue
            a_rank = ranks.get(stat["key"], {}).get(attack["id"])
            d_rank = ranks.get(partner["key"], {}).get(defend["id"])
            a_pct = _percentile(a_rank, totals.get(stat["key"], 0))
            d_pct = _percentile(d_rank, totals.get(partner["key"], 0))
            if a_pct is None or d_pct is None:
                continue
            gap = a_pct - d_pct
            if gap >= EDGE:
                edges.append((side_name, gap,
                              f"{a_team['abbr']} {stat['label'].lower()} "
                              f"(#{a_rank}) vs {d_team['abbr']} "
                              f"{partner['label'].lower()} (#{d_rank})"))
            elif gap <= -EDGE:
                other = "home" if side_name == "away" else "away"
                edges.append((other, -gap,
                              f"{d_team['abbr']} {partner['label'].lower()} "
                              f"(#{d_rank}) vs {a_team['abbr']} "
                              f"{stat['label'].lower()} (#{a_rank})"))
    # head-to-head on the stats with no opposite number
    paired = {s.get("vs") for s in table.get("stats") or []} | \
        {s["key"] for s in table.get("stats") or [] if s.get("vs")}
    for stat in table.get("stats") or []:
        if stat["key"] in paired:
            continue
        a_rank = ranks.get(stat["key"], {}).get(away_row["id"])
        h_rank = ranks.get(stat["key"], {}).get(home_row["id"])
        total = totals.get(stat["key"], 0)
        a_pct, h_pct = _percentile(a_rank, total), _percentile(h_rank, total)
        if a_pct is None or h_pct is None or abs(a_pct - h_pct) < EDGE + 0.1:
            continue
        side_name = "away" if a_pct > h_pct else "home"
        better, worse = (away, home) if side_name == "away" else (home, away)
        edges.append((side_name, abs(a_pct - h_pct) - 0.1,
                      f"{better['abbr']} {stat['label'].lower()} (#"
                      f"{a_rank if side_name == 'away' else h_rank}) vs {worse['abbr']} (#"
                      f"{h_rank if side_name == 'away' else a_rank})"))
    edges.sort(key=lambda e: -e[1])
    return edges


def comparison_blocks(table, ranks, away_row, home_row, away, home, league, width):
    """One block per stat group: away value and rank, the stat, home rank and
    value, the better side lit in its colour and big gaps flagged."""
    totals = {key: len(r) for key, r in ranks.items()}
    blocks = []
    counts = {"away": 0, "home": 0, "big_away": 0, "big_home": 0}
    longest = max([len(s["label"]) for s in table.get("stats") or []] + [12])
    label_width = clamp(min(longest, width - 30), 16, 34)
    for group in stat_groups(table):
        block = [Line().add("── ", "border").add(f"{group} ", "title")
                 .add("─" * (label_width + 22 - len(group)), "border")]
        for stat in [s for s in table["stats"] if s["group"] == group]:
            av, hv = away_row["values"].get(stat["key"]), home_row["values"].get(stat["key"])
            ar = ranks.get(stat["key"], {}).get(away_row["id"])
            hr = ranks.get(stat["key"], {}).get(home_row["id"])
            total = totals.get(stat["key"], 0)
            ap, hp = _percentile(ar, total), _percentile(hr, total)
            better = None
            if ap is not None and hp is not None and ar != hr:
                better = "away" if ar < hr else "home"
            big = better and abs(ap - hp) >= EDGE + 0.1
            if better:
                counts[better] += 1
                if big:
                    counts["big_" + better] += 1
            a_style = THEME.style(league, away, bold=True, fallback="bold") \
                if better == "away" else "dim"
            h_style = THEME.style(league, home, bold=True, fallback="bold") \
                if better == "home" else "dim"
            row = Line()
            row.add("◀" if big and better == "away" else " ", "upset")
            decimal = any(v is not None and abs(v - round(v)) > 1e-9 for v in (av, hv))
            row.add(f"{stat_text(stat, av, decimal):>7}", a_style)
            row.add(f"{('#' + str(ar)) if ar else '':>5} ", "muted")
            label = stat["label"]
            if len(label) > label_width:
                label = stat["short"] + " " + label[: label_width - len(stat["short"]) - 2]
            row.add(f"{label[:label_width]:^{label_width}}", "normal")
            row.add(f" {('#' + str(hr)) if hr else '':<5}", "muted")
            row.add(f"{stat_text(stat, hv, decimal):<7}", h_style)
            row.add("▶" if big and better == "home" else " ", "upset")
            block.append(row)
        blocks.append(block)
    return blocks, counts


def injury_order(status):
    low = (status or "").lower()
    for rank, word in enumerate(("out", "injured reserve", "ir", "doubtful",
                                 "questionable", "day-to-day", "probable", "suspension")):
        if word in low:
            return rank
    return 9


def roster_injuries(roster):
    """[(status, name, position)] from an ESPN team roster."""
    out = []
    groups = (roster or {}).get("athletes") or []
    for group in groups:
        items = group.get("items") if isinstance(group, dict) and "items" in group else [group]
        for athlete in items or []:
            for injury in athlete.get("injuries") or []:
                status = clean(injury.get("status") or dig(injury, "type", "description",
                                                           default="") or "")
                out.append((status, clean(athlete.get("shortName")
                                          or athlete.get("displayName") or ""),
                            clean(dig(athlete, "position", "abbreviation", default=""))))
                break
    out.sort(key=lambda row: (injury_order(row[0]), row[1]))
    return out


def summary_injuries(summary, team_id):
    out = []
    for block in (summary or {}).get("injuries") or []:
        if str(dig(block, "team", "id", default="")) != str(team_id):
            continue
        for injury in block.get("injuries") or []:
            out.append((clean(injury.get("status") or ""),
                        clean(dig(injury, "athlete", "shortName", default="")
                              or dig(injury, "athlete", "displayName", default="")),
                        clean(dig(injury, "athlete", "position", "abbreviation",
                                  default=""))))
    out.sort(key=lambda row: (injury_order(row[0]), row[1]))
    return out


def _age(stamp):
    when = parse_iso(stamp)
    if not when:
        return ""
    seconds = (datetime.now(timezone.utc) - when).total_seconds()
    if seconds < 3600:
        return f"{max(1, int(seconds // 60))}m"
    if seconds < 86400:
        return f"{int(seconds // 3600)}h"
    return f"{int(seconds // 86400)}d"


def flow_text(items, width, indent="    "):
    """Short items joined with ' · ' and wrapped at width, as (text) lines."""
    lines, current = [], ""
    for item in items:
        piece = item if not current else " · " + item
        if current and len(indent) + len(current) + len(piece) > width:
            lines.append(current)
            current = item
        else:
            current += piece
    if current:
        lines.append(current)
    return lines


def ahl_preview(game_id, timeout=15):
    """HockeyTech's game-preview tab: both teams' form, splits, special teams,
    leading scorers and the season series."""
    data = ht_get({"feed": "gc", "tab": "preview", "game_id": str(game_id)}, timeout)
    return dig(data, "GC", "Preview", default={}) or {}


def _ht_rec(row, prefix=""):
    w, l = row.get(prefix + "w", 0) or 0, row.get(prefix + "l", 0) or 0
    otl = (row.get(prefix + "otl", 0) or 0) + (row.get(prefix + "sl", 0) or 0)
    return f"{w}-{l}-{otl}"


def ahl_preview_lines(preview, side):
    """(label, text) rows for one side of an AHL scouting report."""
    team = (preview or {}).get("visitor_team" if side == "away" else "home_team") or {}
    if not team:
        return None
    out = []
    form = []
    if team.get("last10"):
        form.append(f"L10 {team['last10']}")
    if team.get("streak"):
        form.append(f"streak {team['streak']}")
    form.append(f"home {_ht_rec(team, 'home_')}")
    form.append(f"road {_ht_rec(team, 'away_')}")
    out.append(("Form", " · ".join(form)))
    pp, pk = team.get("pp") or {}, team.get("pk") or {}
    where = "pp_away" if side == "away" else "pp_home"
    kill = "pk_away" if side == "away" else "pk_home"
    special = []
    if pp:
        special.append(f"PP {pp.get('percentage', 0):.1f}% "
                       f"({pp.get('power_play_goals', 0)}/{pp.get('power_plays', 0)})")
    if pk:
        special.append(f"PK {pk.get('percentage', 0):.1f}%")
    if (team.get(where) or {}).get("power_plays"):
        special.append(f"{'road' if side == 'away' else 'home'} PP "
                       f"{team[where].get('percentage', 0):.1f}% · PK "
                       f"{(team.get(kill) or {}).get('percentage', 0):.1f}%")
    if special:
        out.append(("Special", " · ".join(special)))
    scorers = []
    for row in (team.get("leadingScorers") or [])[:4]:
        scorers.append(f"{row.get('first_name', '')[:1]}. {row.get('last_name', '')} "
                       f"{row.get('goals', 0)}-{row.get('assists', 0)}-{row.get('points', 0)}")
    if scorers:
        out.append(("Scorers", ", ".join(scorers)))
    hot = (dig(team, "longest_player_streaks", "points", default=[]) or [])
    hot = sorted(hot, key=lambda r: -(r.get("length") or 0))[:2]
    if hot and (hot[0].get("length") or 0) >= 2:
        out.append(("Hot", ", ".join(f"{r.get('last_name', '')} {r.get('length')}-game "
                                     f"point streak" for r in hot
                                     if (r.get("length") or 0) >= 2)))
    rookie = team.get("rookie") or {}
    if rookie.get("last_name"):
        out.append(("Rookie", f"{rookie.get('first_name', '')[:1]}. {rookie['last_name']} "
                              f"{rookie.get('goals', 0)}G {rookie.get('assists', 0)}A"))
    records = team.get("season_records") or {}
    when = []
    for key, label in (("leading_after_2nd", "lead after 2"),
                       ("trailing_after_2nd", "trail after 2"),
                       ("one_goal_game", "1-goal games")):
        if records.get(key):
            when.append(f"{label} {records[key]}")
    if when:
        out.append(("Records", " · ".join(when)))
    if team.get("last_game"):
        out.append(("Last", team["last_game"]))
    return out


def ahl_head_to_head(preview, event, league):
    """The season series and recent meetings out of an AHL preview."""
    lines = [Line().add("── Season series ", "border")]
    away, home = event["away"], event["home"]
    for key, label in (("HeadToHeadRecord", "This season"),
                       ("last_HeadToHeadRecord", "Last season"),
                       ("last5YearsRecord", "Last 5 yrs")):
        row = preview.get(key) or {}
        visit, host = row.get("visiting_team") or {}, row.get("home_team") or {}
        if not any(visit.get(k) for k in ("w", "l", "otl", "sl")):
            continue
        line = Line().add(f"  {label:<12}", "muted")
        line.add(away["abbr"], THEME.style(league, away, bold=True))
        line.add(f" {_ht_rec(visit)}  ", "normal")
        line.add(home["abbr"], THEME.style(league, home, bold=True))
        line.add(f" {_ht_rec(host)}", "normal")
        lines.append(line)
    for game in (preview.get("previous_meetings") or [])[:5]:
        when = str(game.get("date_played") or "")[5:]
        lines.append(Line().add(f"  {when:<6}", "muted").add(
            f"{game.get('visitingCode', '')} {game.get('visiting_goal_count', '')} @ "
            f"{game.get('homeCode', '')} {game.get('home_goal_count', '')}", "normal"))
    if len(lines) == 1:
        lines.append(Line().add("  First meeting of the season.", "dim"))
    return lines


def scouting_team_lines(team, side, summary, injuries, news, league, width, favorites,
                        preview=None, news_count=4):
    """One team's half of the scouting report, packed tight."""
    lines = []
    star = fav_rank(favorites, league, team) >= 0
    head = Line().add("── ", "border")
    if star:
        head.add(STAR + " ", "star")
    head.add(team.get("name") or team.get("abbr") or "?",
             THEME.style(league, team, bold=True, fallback="title"))
    if team.get("record"):
        head.add(f"  {team['record']}", "bold")
    head.add(f"  {side} ", "muted")
    head.add("─" * max(0, width - len(head.text)), "border")
    lines.append(head)

    # form: the last five results
    form = []
    for block in (summary or {}).get("lastFiveGames") or []:
        if str(dig(block, "team", "id", default="")) != str(team.get("id")):
            continue
        for game in block.get("events") or []:
            result = clean(game.get("gameResult") or "")
            opponent = clean(dig(game, "opponent", "abbreviation", default=""))
            form.append((result, f"{result} {clean(game.get('score') or '')} "
                                 f"{clean(game.get('atVs') or '')}{opponent}"))
    if form:
        row = Line().add("  Form     ", "muted")
        for index, (result, text) in enumerate(form):
            if index:
                row.add(" · ", "muted")
            row.add(text, "good" if result == "W" else ("bad" if result == "L" else "dim"))
        lines.append(row)

    if preview:
        for label, text in preview:
            lines.append(Line().add(f"  {label:<9}", "muted").add(text[: width - 11], "normal"))

    # season leaders
    for block in (summary or {}).get("leaders") or []:
        if str(dig(block, "team", "id", default="")) != str(team.get("id")):
            continue
        for category in block.get("leaders") or []:
            top = (category.get("leaders") or [None])[0]
            if not top:
                continue
            who = clean(dig(top, "athlete", "shortName", default="")
                        or dig(top, "athlete", "displayName", default=""))
            label = clean(category.get("shortDisplayName") or category.get("displayName")
                          or category.get("name") or "")
            if label.upper() in SKIP_LEADER_CATEGORIES:
                continue
            value = clean(top.get("displayValue") or "")
            row = Line().add(f"  {label[:8]:<9}", "muted").add(f"{who} ", "normal")
            row.add(value[: max(0, width - 10 - len(who))], "dim")
            lines.append(row)

    # injuries
    if injuries is not None:
        if not injuries:
            if league in COLLEGE_LEAGUES:
                lines.append(Line().add("  No injuries listed (most schools do not "
                                        "publish an injury report).", "dim"))
            else:
                lines.append(Line().add("  Injury report clear.", "good"))
        else:
            groups = {}
            for status, name, position in injuries:
                groups.setdefault(status or "Listed", []).append(
                    f"{name} {position}".strip())
            lines.append(Line().add(f"  Injuries ({len(injuries)})", "accent"))
            short = {"injured reserve": "IR", "injured reserve - designated to return":
                     "IR-return", "physically unable to perform": "PUP",
                     "day-to-day": "Day-to-day", "questionable": "Quest.",
                     "suspension": "Susp.", "non-football injury": "NFI"}
            labels = {st: short.get(st.lower(), st)[:11] for st in groups}
            pad = max(len(v) for v in labels.values()) if labels else 4
            for status in sorted(groups, key=injury_order):
                style = "bad" if injury_order(status) <= 2 else (
                    "warn" if injury_order(status) <= 5 else "dim")
                prefix = f"    {labels[status] + ':':<{pad + 1}} "
                chunks = flow_text(groups[status], width - len(prefix), prefix)
                for index, chunk in enumerate(chunks):
                    row = Line().add(prefix if index == 0 else " " * len(prefix), style)
                    row.add(chunk, "normal")
                    lines.append(row)
    # news: this team's, not the league roundups every team is tagged in;
    # ▼ marks bad news (ruled out, hurt), ▲ good (back, activated), ▶ a
    # video. Each headline line keeps its article, so n / N can pick it and
    # enter open it in the article card.
    articles = team_articles(news, team.get("id"))
    if articles and news_count:
        lines.append(Line().add("  News", "accent"))
        for article in articles[:news_count]:
            age = _age(article.get("published") or article.get("lastModified"))
            tone = news_tone(article)
            row = Line().add(f"    {age:>3} ", "muted")
            row.add("▼ " if tone < 0 else "▲ " if tone > 0 else "  ",
                    "bad" if tone < 0 else "good")
            room = max(10, width - 11)
            if news_kind(article) == "video":
                row.add("▶ ", "accent")
                room -= 2
            row.add(clean(article["headline"])[:room], "normal")
            row.news_ref = dict(article, team_abbr=team.get("abbr") or "")
            lines.append(row)
    return lines


def team_articles(news, team_id):
    """The articles of a team's news feed that are about the team: the
    league-wide roundups ESPN tags with every team are left out, and so are
    repeats."""
    out, seen = [], set()
    for article in (news or {}).get("articles") or []:
        headline = clean(article.get("headline") or "")
        if not headline or headline.lower() in seen:
            continue
        teams = [str(c.get("teamId") or dig(c, "team", "id", default=""))
                 for c in article.get("categories") or [] if c.get("type") == "team"]
        if teams and (len(teams) > 2 or (team_id and str(team_id) not in teams)):
            continue
        seen.add(headline.lower())
        out.append(article)
    return out


def news_tone(article):
    """-1 for bad news (ruled out, hurt), +1 good (back, activated), 0 neither."""
    text = clean(article.get("headline") or "") + " " + clean(article.get("description") or "")
    if KIM_NEWS_OUT.search(text):
        return -1
    if KIM_NEWS_GOOD.search(text):
        return 1
    return -1 if KIM_NEWS_HURT.search(text) else 0


# --------------------------------------------------------------------------
# the article card: a headline's whole story, read in the app
# --------------------------------------------------------------------------
#
# Every item in an ESPN news feed links to ESPN's content API, which hands
# back the story itself as HTML (or, for a video, the clip and its files).
# sportst turns that HTML into wrapped, styled lines with the standard
# library's HTML parser - paragraphs, headings, lists, quotes; pictures,
# embedded players and scripts left out - so no text browser is needed.

NEWS_KINDS = {"Media": "video", "HeadlineNews": "news", "Story": "story", "Recap": "recap",
              "Preview": "preview", "Eticket": "interactive page", "Blog": "blog post",
              "Podcast": "podcast"}
CONTENT_HOST = "content.core.api.espn.com"


def news_kind(article):
    """What a feed item is: video, story, recap, preview, news ..."""
    kind = str(article.get("type") or "")
    api = str(dig(article, "links", "api", "self", "href", default="") or "")
    if kind == "Media" or "/video/clips/" in api:
        return "video"
    return NEWS_KINDS.get(kind, "story")


def article_api_url(article):
    """The content API address for a feed item, always over https."""
    api = str(dig(article, "links", "api", "self", "href", default="") or "")
    if CONTENT_HOST in api:
        return "https://" + api.split("://", 1)[-1]
    ident = urllib.parse.quote(str(article.get("id") or ""))
    if not ident:
        return ""
    if news_kind(article) == "video":
        return f"https://{CONTENT_HOST}/v1/video/clips/{ident}"
    return f"https://{CONTENT_HOST}/v1/sports/news/{ident}"


def article_web_url(article, data=None):
    """The item's page on espn.com, for the browser."""
    for source in (data or {}, article):
        for path in (("links", "web", "href"), ("headlines", 0, "links", "web", "href"),
                     ("videos", 0, "links", "web", "href")):
            href = dig(source, *path, default="")
            if href:
                return "https://" + str(href).split("://", 1)[-1]
    return ""


def _duration(seconds):
    try:
        seconds = int(seconds)
    except (TypeError, ValueError):
        return ""
    return f"{seconds // 60}:{seconds % 60:02d}" if seconds > 0 else ""


def article_video(data):
    """(title, mp4 address, seconds) of the video an article is, or carries;
    None when there is none."""
    item = dig(data, "videos", 0, default=None) or \
        dig(data, "headlines", 0, "video", 0, default=None)
    if not isinstance(item, dict):
        return None
    source = dig(item, "links", "source", default={}) or {}
    url = dig(source, "HD", "href", default="") or source.get("href") or \
        dig(source, "full", "href", default="")
    if not url:
        return None
    title = clean(item.get("headline") or item.get("title") or "")
    return title, str(url), item.get("duration")


class StoryParser(HTMLParser):
    """ESPN story markup into blocks: (kind, [(text, style)]) with kind p,
    h (heading), li (a list item; its number or bullet first), quote or
    rule. Pictures, embedded players, scripts and styles are left out."""

    BLOCK = {"p", "div", "section", "article", "h1", "h2", "h3", "h4", "h5", "h6", "hl2",
             "li", "tr", "dt", "dd", "figcaption", "pre", "header", "footer", "table"}
    HEADING = {"h1", "h2", "h3", "h4", "h5", "h6", "hl2"}
    SKIP = {"script", "style", "noscript", "iframe", "svg", "button", "form", "select",
            "template", "object", "video", "audio", "picture", "head"}
    BOLD = {"b", "strong"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.blocks, self.spans, self.kind = [], [], "p"
        self.skip = self.bold = self.quote = self.in_item = 0
        self.lists = []

    def flush(self):
        if "".join(text for text, _ in self.spans).strip():
            self.blocks.append((self.kind, self.spans))
        self.spans = []

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if tag in self.SKIP:
            self.skip += 1
            return
        if self.skip:
            return
        if tag in ("ul", "ol"):
            self.flush()
            self.lists.append([tag == "ol", 0])
        elif tag == "blockquote":
            self.flush()
            self.quote += 1
            self.kind = "quote"
        elif tag == "hr":
            self.flush()
            self.blocks.append(("rule", []))
        elif tag == "br":
            self.spans.append(("\n", "normal"))
        elif tag in ("td", "th"):
            if "".join(text for text, _ in self.spans).strip():
                self.spans.append(("  ·  ", "muted"))
        elif tag == "li":
            self.flush()
            self.in_item += 1
            self.kind = "li"
            mark = "•"
            if self.lists:
                self.lists[-1][1] += 1
                if self.lists[-1][0]:
                    mark = f"{self.lists[-1][1]}."
            self.spans.append((mark, "accent"))
        elif tag in self.BLOCK and not (self.in_item and tag == "p"):
            self.flush()
            self.kind = "h" if tag in self.HEADING else ("quote" if self.quote else "p")
        if tag in self.BOLD:
            self.bold += 1

    def handle_startendtag(self, tag, attrs):
        if tag.lower() in ("br", "hr"):
            self.handle_starttag(tag, attrs)

    def handle_endtag(self, tag):
        tag = tag.lower()
        if tag in self.SKIP:
            self.skip = max(0, self.skip - 1)
            return
        if self.skip:
            return
        if tag in ("ul", "ol"):
            self.flush()
            if self.lists:
                self.lists.pop()
            self.kind = "quote" if self.quote else "p"
        elif tag == "blockquote":
            self.flush()
            self.quote = max(0, self.quote - 1)
            self.kind = "quote" if self.quote else "p"
        elif tag == "li":
            self.flush()
            self.in_item = max(0, self.in_item - 1)
            self.kind = "quote" if self.quote else "p"
        elif tag in self.BLOCK and not (self.in_item and tag == "p"):
            self.flush()
            self.kind = "quote" if self.quote else "p"
        if tag in self.BOLD:
            self.bold = max(0, self.bold - 1)

    def handle_data(self, data):
        if self.skip or not data:
            return
        if self.kind == "h":
            style = "title"
        else:
            style = "bold" if self.bold else "normal"
        self.spans.append((data, style))

    def close(self):
        super().close()
        self.flush()


def story_blocks(markup):
    """A story's HTML as blocks (see StoryParser). Recaps and previews come
    as plain text, a blank line between paragraphs; a link ESPN left
    unclosed (href="… with no quote) is mended so it cannot swallow the
    rest."""
    text = clean(markup).replace("\r", "")
    if not re.search(r"<\s*(p|div|br|li|h\d|hl2|table|blockquote)\b", text, re.I):
        text = "".join(f"<p>{part}</p>" for part in re.split(r"\n\s*\n", text))
    text = re.sub(r'(<a\s+href="[^"<>\s]*)\s(?=[^"<>]*</a>)', r'\1">', text, flags=re.I)
    parser = StoryParser()
    try:
        parser.feed(text)
        parser.close()
    except Exception:  # noqa: BLE001 - odd markup: keep what was read
        parser.flush()
    return parser.blocks[:2000]


def wrap_styled(spans, width, indent="", hang=None):
    """Word-wrap styled text into Lines, each word keeping its style. Text
    that runs on from one span into the next with no space between (a
    linked name, then 's) is one word and never split; "\\n" breaks the
    line; `hang` indents the lines after the first."""
    hang = indent if hang is None else hang
    width = max(8, width)
    words, current, spaced = [], None, False
    for text, style in spans:
        if text == "\n":
            if current:
                words.append(current)
            words.append(None)
            current, spaced = None, False
            continue
        for token in re.findall(r"\S+|\s+", text):
            if token.isspace():
                if current:
                    words.append(current)
                current, spaced = None, True
            elif current is None:
                current = (spaced, [(token, style)])
                spaced = False
            else:
                current[1].append((token, style))
    if current:
        words.append(current)

    def fresh_line():
        return (Line().add(hang, "normal") if hang else Line()), len(hang)

    lines = []
    line, used = (Line().add(indent, "normal") if indent else Line()), len(indent)
    empty = True
    for word in words:
        if word is None:
            lines.append(line)
            line, used = fresh_line()
            empty = True
            continue
        gap, parts = word
        length = sum(len(text) for text, _ in parts)
        if not empty and used + length + (1 if gap else 0) > width:
            lines.append(line)
            line, used = fresh_line()
            empty = True
        if gap and not empty:
            line.add(" ", parts[0][1])
            used += 1
        for text, style in parts:
            while used + len(text) > width and width - used > 0 and \
                    len(text) > width - len(hang):
                cut = width - used          # a word wider than the page is cut
                line.add(text[:cut], style)
                lines.append(line)
                line, used = fresh_line()
                text = text[cut:]
            line.add(text, style)
            used += len(text)
        empty = False
    if not empty or not lines:
        lines.append(line)
    return lines


def story_lines(blocks, width):
    """Blocks from story_blocks laid out as the card shows them: a blank
    line between paragraphs, list items bulleted with a hanging indent,
    quotes behind a bar."""
    lines, previous = [], None
    for kind, spans in blocks:
        if lines and not (kind == "li" and previous == "li"):
            lines.append(blank())
        if kind == "rule":
            lines.append(Line().add("─" * min(width, 40), "border"))
        elif kind == "h":
            lines.extend(wrap_styled(spans, width))
        elif kind == "li":
            mark, rest = (spans[0][0], spans[1:]) if spans else ("•", [])
            lead = f"  {mark} "
            body = wrap_styled(rest, width, indent=" " * len(lead))
            if body:
                body[0][0] = (lead, "accent")
            lines.extend(body)
        elif kind == "quote":
            for row in wrap_styled(spans, width - 2):
                lines.append(Line([("│ ", "muted")] + [(t, "dim" if s == "normal" else s)
                                                      for t, s in row]))
        else:
            lines.extend(wrap_styled(spans, width))
        previous = kind
    return lines


def article_lines(ref, data, width, loading=False, error=None, video_window=False):
    """What the article card shows: the headline, its byline and date, then
    the story - or for a video its description and length - wrapped to
    `width`; while it loads, or if it cannot, the summary from the feed."""
    kind = news_kind(ref)
    item = (dig(data, "headlines", 0, default=None) or dig(data, "videos", 0, default=None)
            or {}) if isinstance(data, dict) else {}
    lines = wrap_styled([(clean(item.get("headline") or ref.get("headline") or "?"),
                          "title")], width)
    meta = []
    byline = clean(item.get("byline") or ref.get("byline") or "")
    if byline:
        meta.append(byline)
    when = parse_iso(item.get("published") or item.get("originalPublishDate")
                     or ref.get("published") or ref.get("lastModified"))
    if when:
        meta.append(when.astimezone().strftime("%a %b %-d, %Y · %-I:%M %p"))
    premium = bool(item.get("premium") or ref.get("premium"))
    meta.append("ESPN+ " + kind if premium else kind.capitalize())
    video = article_video(data) if isinstance(data, dict) else None
    if video and kind == "video" and _duration(video[2]):
        meta.append(_duration(video[2]))
    lines.extend(wrap_styled([(" · ".join(meta), "muted")], width))
    lines.append(blank())
    summary = clean(item.get("description") or ref.get("description") or "")
    if summary.lower() == clean(item.get("headline") or ref.get("headline") or "").lower():
        summary = ""                     # a clip's description is often its title again
    if not item:
        if summary:
            lines.extend(wrap_styled([(summary, "normal")], width))
            lines.append(blank())
        if loading:
            lines.append(Line().add("Loading the story…", "dim"))
        else:
            lines.extend(wrap_styled([(f"Could not load the story{': ' + error if error else ''}"
                                       " - o opens it on espn.com.", "warn")], width))
        return lines
    sound = "in a window" if video_window else "sound only - Settings: Show the video"
    if kind == "video" or "videos" in data:
        if summary:
            lines.extend(wrap_styled([(summary, "normal")], width))
            lines.append(blank())
        if video:
            lines.extend(wrap_styled([("▶ ", "accent"), ("enter plays it with your clip "
                                                       f"player ({sound}); o opens it on "
                                                       "espn.com.", "dim")], width))
        else:
            lines.append(Line().add("This video has no file to play here - o opens it on "
                                    "espn.com.", "dim"))
        return lines
    if video:
        lines.extend(wrap_styled([("▶ ", "accent"), (f"This story has a video: "
                                                   f"{video[0] or 'the clip'}"
