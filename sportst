def box_stat(summary, team_id, name):
    """One team statistic from the box score ('shotsTotal', 'possessionPct'
    ...) as its display text, or ''."""
    for entry in dig(summary, "boxscore", "teams", default=[]) or []:
        if str(dig(entry, "team", "id", default="")) != str(team_id):
            continue
        for stat in entry.get("statistics") or []:
            if stat.get("name") == name:
                return str(stat.get("displayValue") or "")
    return ""


def tracked(*values):
    """True when a statistic was kept: some value is there and not zero (a
    feed that does not count hits sends 0 for both teams)."""
    return any(str(v).strip() not in ("", "0", "0.0", "-", "0/0") for v in values)


def side_of(event, team_id):
    for side in ("away", "home"):
        if str(event[side].get("id")) == str(team_id or ""):
            return side
    return None


def _stat_line(label, event, league, away_text, home_text, label_width=14):
    """'LABEL   AWY 24 · HOM 31', each side in its team's colour."""
    line = Line().add(f"{label:<{label_width}}", "muted")
    for index, (side, text) in enumerate((("away", away_text), ("home", home_text))):
        if index:
            line.add("  ·  ", "muted")
        team = event[side]
        line.add(f"{team.get('abbr', '')} ", THEME.style(league, team, bold=True))
        line.add(str(text), "bold")
    return line


def game_top_scorer(summary, team_id, stat="points"):
    """'D. Mitchell 28' - a team's leader in one category from the summary's
    leaders card, or ''."""
    for block in dig(summary, "leaders", default=[]) or []:
        if str(dig(block, "team", "id", default="")) != str(team_id):
            continue
        for category in block.get("leaders") or []:
            if (category.get("name") or "") != stat:
                continue
            top = (category.get("leaders") or [None])[0]
            if not top:
                return ""
            who = clean(dig(top, "athlete", "shortName", default="")
                        or dig(top, "athlete", "displayName", default=""))
            value = clean(str(top.get("displayValue") or "")).split(",")[0]
            return f"{who} {value}".strip()
    return ""


