    def championship_lines(self, width):
        """The odds panel for this league, or [] where there is none."""
        league = self.league
        if is_olympic(league):
            return []
        teams_result = self.load_teams()
        teams = parse_teams(teams_result.data) if teams_result.data else []
        sources, loading, stamps = [], teams_result.loading and not teams, []
        kalshi = book = estimate = None
        if league in KALSHI_CHAMPIONS and self.config.get("betting_sources", True):
            result = self.fetcher.get(("champk", league),
                                      Loader("api.elections.kalshi.com", kalshi_champions,
                                             league), ttl=600)
            kalshi = result.data
            loading = loading or (result.loading and not result.data)
            if kalshi and kalshi.get("teams"):
                sources.append("Kalshi market")
                stamps.append(result.stamp)
        if league in FUTURES_PATTERN:
            result = self.fetcher.get(("champb", league),
                                      Loader("sports.core.api.espn.com",
                                             espn_champion_futures, league), ttl=1800)
            book = result.data
            loading = loading or (result.loading and not result.data)
            if book and book.get("teams"):
                sources.append(book.get("provider") or "sportsbook")
                stamps.append(result.stamp)
        if league == "ahl":
            standings = self.load_standings()
            if standings.data:
                estimate = ahl_estimate(standings.data)
                sources.append("sportst estimate from the standings")
            loading = loading or standings.loading
        if league == "cbase":
            poll = self.fetcher.get(("ncaapoll",), Loader("ncaa-api.henrygd.me",
                                                         ncaa_baseball_poll), ttl=6 * 3600)
            if poll.data:
                estimate = cbase_estimate(poll.data, teams)
                sources.append("sportst estimate from the D1Baseball Top 25")
            loading = loading or poll.loading
        board = championship_board(league, teams, kalshi, book, estimate) if teams else []
        if stamps:
            newest = max(stamps)
            sources.append("as of " + datetime.fromtimestamp(newest).strftime("%-I:%M %p"))
        note = ""
        if league in ("ahl", "cbase"):
            note = (f"No market or sportsbook posts {CHAMPIONSHIP_NAME[league]} odds, so "
                    "these are sportst's own rough estimate.")
        return render_championship(board, league, width, self.favorites, sources, note,
                                   loading)

    def draw_playoffs(self, top, height, width, title):
        key = self.tab_name
        odds_width = 0
        if not is_olympic(self.league) and width >= 150:
            odds_width = clamp(width * 40 // 100, 62, 84)
        left_width = width - odds_width
        lines, caption = self.playoff_lines(left_width - 4)
        if not odds_width:
            odds = self.championship_lines(width - 4)
            if odds:
                lines = lines + [blank(), rule(min(width - 4, 72))] + odds
            self.draw_box(top, 0, height, width, caption, "accent")
            self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(lines) - (height - 2)))
            self.draw_lines(lines, top + 1, 2, height - 2, width - 4, self.scroll[key])
            self.draw_scrollbar(top + 1, width - 2, height - 2, len(lines), self.scroll[key])
            return
        odds = self.championship_lines(odds_width - 4)
        view = height - 2
        longest = max(len(lines), len(odds))
        self.scroll[key] = clamp(self.scroll[key], 0, max(0, longest - view))
        offset = self.scroll[key]
        self.draw_box(top, 0, height, left_width, caption, "accent")
        self.draw_lines(lines, top + 1, 2, view, left_width - 4,
                        min(offset, max(0, len(lines) - view)))
        self.draw_scrollbar(top + 1, left_width - 2, view, len(lines),
                            min(offset, max(0, len(lines) - view)))
        self.draw_box(top, left_width, height, odds_width, "Championship odds", "accent")
        self.draw_lines(odds, top + 1, left_width + 2, view, odds_width - 4,
                        min(offset, max(0, len(odds) - view)))
        self.draw_scrollbar(top + 1, width - 2, view, len(odds),
                            min(offset, max(0, len(odds) - view)))

    # -- the pop-out calendar (C) ------------------------------------------

    def open_calendar(self):
        if is_olympic(self.league):
            self.status_message = "An Olympic sport shows its whole schedule at once; " \
                                  "h / l step through the Games."
            return
        self.calendar = {"cursor": self.day}

    def calendar_days(self, first):
        """(set of iso days with games in and around that month, loading)."""
        league = self.league
        if league == "ahl":
            result = self.fetcher.get(("ahlseason",), Loader("lscluster.hockeytech.com",
                                                             ahl_season_games), ttl=6 * 3600)
            games = (result.data or {}).get("games") or []
            return {g["day"] for g in games}, result.loading and not result.data
        groups = self.cfb_group if league == "cfb" else LEAGUES[league].get("groups")
        month = first.isoformat()[:7]
        result = self.fetcher.get(("calendar", league, month, groups),
                                  Loader(SITE_HOSTS[0], espn_game_days, league, month, groups),
                                  ttl=3 * 3600)
        return set((result.data or {}).get("days") or []), result.loading and not result.data

    def calendar_favorites(self):
        """({iso day: [(team, {'id', 'opp', 'home', 'when'})]}, loading) for
        the favourites of the league on screen."""
        league = self.league
        out, loading = {}, False
        teams = [t for t in self.favorites.get(family(league)) or [] if t.get("id")]
        if not teams:
            return out, False
        if league == "ahl":
            result = self.fetcher.get(("ahlseason",), Loader("lscluster.hockeytech.com",
                                                             ahl_season_games), ttl=6 * 3600)
            for game in (result.data or {}).get("games") or []:
                for team in teams:
                    if team["id"] in (game["home"], game["away"]):
                        home = team["id"] == game["home"]
                        out.setdefault(game["day"], []).append((team, {
                            "id": game["id"], "home": home,
                            "opp": game["away_code"] if home else game["home_code"],
                            "when": game["time"]}))
            return out, result.loading and not result.data
        for team in teams:
            result = self.fetcher.get(("teamdates", league, team["id"]),
                                      Loader(SITE_HOSTS[0], espn_team_dates, league,
                                             team["id"]), ttl=3 * 3600)
            loading = loading or (result.loading and not result.data)
            for day, info in ((result.data or {}).get("dates") or {}).items():
                out.setdefault(day, []).append((team, info))
        return out, loading

    def draw_calendar(self, height, width):
        cursor = self.calendar["cursor"]
        first = cursor.replace(day=1)
        days, loading = self.calendar_days(first)
        favs, fav_loading = self.calendar_favorites()
        weeks = month_grid(first)
        today = Date.today().isoformat()
        viewing = self.day.isoformat()
        box_width = min(width - 2, 62)
        detail = []
        label = cursor.strftime("%A, %B %-d, %Y")
        detail.append(Line().add(label, "bold"))
        iso = cursor.isoformat()
        for team, info in favs.get(iso, []):
            where = "vs" if info.get("home") else "at"
            line = Line().add(STAR + " ", "star")
            line.add(team.get("name") or team.get("abbr") or "?",
                     THEME.style(self.league, team, bold=True))
            line.add(f" {where} {info.get('opp') or '?'}", "normal")
            if info.get("when"):
                line.add(f" · {info['when']}", "dim")
            detail.append(line)
        if iso in days:
            if not favs.get(iso):
                detail.append(Line().add(f"{LEAGUE_SHORT.get(family(self.league))} games "
                                         "this day", "accent"))
        elif not favs.get(iso):
            detail.append(Line().add("Loading the schedule…" if loading else "No games.",
                                     "dim"))
        box_height = min(height - 2, 2 + 2 + 1 + len(weeks) + 1 + 1 + len(detail) + 3)
        top = max(0, (height - box_height) // 2)
        left = max(0, (width - box_width) // 2)
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        title = f"{LEAGUE_SHORT.get(family(self.league), self.league)} calendar"
        self.draw_box(top, left, box_height, box_width, title, "title")
        lines = []
        month = Line().add(" ◂ ", "accent").add(f" {first.strftime('%B %Y')} ", "tabsel")
        month.add(" ▸ ", "accent")
        if loading or fav_loading:
            month.add("  loading…", "dim")
        lines.append(month)
        lines.append(blank())
        head = Line()
        for name in ("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"):
            head.add(f" {name:<5}", "header")
        lines.append(head)
        for week in weeks:
            row = Line()
            for day in week:
                if day is None:
                    row.add("      ", "normal")
                    continue
                key = day.isoformat()
                fav = key in favs
                game = key in days or fav
                mark = STAR if fav else ("•" if game else " ")
                text = f" {day.day:>2} {mark} "
                if day == cursor:
                    style = "tabsel"
                elif game:
                    style = "calgametoday" if key == today else (
                        "calfav" if fav else "calgame")
                else:
                    style = "caltoday" if key == today else "muted"
                if key == viewing and day != cursor:
                    text = f"[{day.day:>2} {mark}]"
                row.add(text, style)
            lines.append(row)
        lines.append(blank())
        legend = Line().add(" 18 • ", "calgame").add(" games  ", "muted")
        legend.add(" 18 ★ ", "calfav").add(" your team  ", "muted")
        legend.add("[ ]", "accent").add(" on screen", "muted")
        lines.append(legend)
        lines.extend(detail)
        pad = max(0, (box_width - 4 - 42) // 2)
        lines = [Line([("  " * 0 + " " * pad, "normal")] + list(line)) if index < 3 + len(weeks)
                 else line for index, line in enumerate(lines)]
        self.draw_lines(lines, top + 1, left + 2, box_height - 4, box_width - 4, 0)
        for offset, keys in enumerate(("←→ day · ↑↓ week · [ ] month · t today",
                                       "n N next / previous game day · f your team · "
                                       "enter go")):
            self.put(top + box_height - 3 + offset, left + 2, keys[: box_width - 4],
                     self.palette("muted"))

    def calendar_step_to(self, wanted):
        """The next (1) or previous (-1) game day, or your team's next (2)."""
        cursor = self.calendar["cursor"]
        favs, _ = self.calendar_favorites()
        if wanted == 2:
            later = sorted(d for d in favs if d > cursor.isoformat())
            if later:
                self.calendar["cursor"] = Date.fromisoformat(later[0])
            else:
                self.status_message = "No more games for your teams this season."
            return
        step = 1 if wanted > 0 else -1
        day = cursor
        for _ in range(400):
            day += timedelta(days=step)
            days, loading = self.calendar_days(day.replace(day=1))
            if loading:
                # that month is still loading: wait there for it
                self.calendar["cursor"] = day.replace(day=1) if step > 0 else day
                return
            if day.isoformat() in days or day.isoformat() in favs:
                self.calendar["cursor"] = day
                return
        self.status_message = "No more game days found."

    def pick_calendar_day(self, day):
        self.calendar = None
        favs, _ = self.calendar_favorites()
        self.day = day
        self.week_mode = False
        self.week_pinned = False
        self.selected_id = None
        self.selected_index = 0
        self.detail_scroll = 0
        self.at_bat = None
        mine = favs.get(day.isoformat())
        if mine:
            self.selected_id = mine[0][1]["id"]
        if self.tab_name in ("Overview", "Favorites", "Settings", "Stats", "Standings",
                             "Playoffs"):
            self.tab = self.tabs.index("Scoreboard")
        self.status_message = day.strftime("%A, %B %-d") + \
            (" - your team's game is highlighted." if mine else ".")

    def handle_calendar_key(self, key):
        moves = {ord("h"): -1, curses.KEY_LEFT: -1, ord("l"): 1, curses.KEY_RIGHT: 1,
                 ord("k"): -7, curses.KEY_UP: -7, ord("j"): 7, curses.KEY_DOWN: 7}
        cursor = self.calendar["cursor"]
        if key in moves:
            self.calendar["cursor"] = cursor + timedelta(days=moves[key])
        elif key in (ord("["), curses.KEY_PPAGE, ord("<"), ord(",")):
            self.calendar["cursor"] = add_months(cursor, -1)
        elif key in (ord("]"), curses.KEY_NPAGE, ord(">"), ord(".")):
            self.calendar["cursor"] = add_months(cursor, 1)
        elif key == ord("n"):
            self.calendar_step_to(1)
        elif key == ord("N"):
            self.calendar_step_to(-1)
        elif key == ord("f"):
            self.calendar_step_to(2)
        elif key == ord("t"):
            self.calendar["cursor"] = Date.today()
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.pick_calendar_day(self.calendar["cursor"])
        elif key == curses.KEY_RESIZE:
            self.apply_background()
        elif key in (27, ord("q"), ord("C")):
            self.calendar = None
        return True

