def baseball_box_notes(summary, team_id, width):
    """The notes under one team's baseball box score (7.0.0) - ESPN's batting,
    baserunning, fielding and pitching details: doubles, homers, RBI, hitting
    with runners in scoring position, steals, errors, double plays, hit
    batters, first-pitch strikes, ground balls to fly balls, the starter's
    game score - a label and its text, wrapped under itself."""
    team = next((t for t in dig(summary, "boxscore", "teams", default=[]) or []
                 if str(dig(t, "team", "id", default="")) == str(team_id)), None)
    groups = (team or {}).get("details") or []
    lines = []
    label_w = 20
    for group in groups:
        rows = []
        for stat in group.get("stats") or []:
            text = clean(re.sub(r"\s+", " ", str(stat.get("displayValue") or ""))).strip(" .")
            abbr = clean(stat.get("abbreviation") or stat.get("shortDisplayName") or "")
            if not text or text in ("0", "-"):
                continue
            label = BOX_NOTE_LABELS.get(abbr) or clean(stat.get("displayName") or abbr)
            label = cut_text(label, label_w - 1)
            note = BOX_NOTE_HELP.get(abbr)
            rows.append((label, text, note))
        if not rows:
            continue
        name = clean(group.get("displayName") or "") or "Notes"
        lines.append(Line().add(f"  {name}", "header"))
        for label, text, _ in rows:
            room = max(20, width - label_w - 4)
            chunks = [l.text for l in wrap_spans(text, room)] or [text]
            for index, chunk in enumerate(chunks):
                lines.append(Line().add(f"    {label if index == 0 else '':<{label_w}}",
                                        "muted").add(chunk, "normal"))
        helps = [note for _, _, note in rows if note]
        for note in helps:
            lines.extend(wrap_spans(note, width, "dim", indent="    "))
    return lines


def baseball_scoring_notes(summary, event, league, width):
    """The line score and every scoring play, for under a baseball box score
    (7.0.0): the inning, the side, the play (its pitch count trimmed) and the
    score after it."""
    lines = []
    table = baseball_inning_table(summary, event, league, width - 4) if event else []
    if len(table) > 1:
        lines.append(Line().add("  Line score", "header"))
        for line in table[1:]:
            lines.append(Line([("    ", "normal")] + list(line)))
    plays = [t for t in baseball_trail(summary) if t["runs"]]
    if plays and event:
        if lines:
            lines.append(blank())
        lines.append(Line().add("  Scoring plays", "header"))
        score = {"away": 0, "home": 0}
        for t in plays:
            score[t["side"]] += t["runs"]
            team = event[t["side"]]
            text = re.sub(r"\s*\(\d-\d[^)]*\)", "", t["text"]).strip()
            tail = f"  {score['away']}-{score['home']}"
            line = Line().add(f"    {'T' if t['top'] else 'B'}{t['inning']:<3}", "muted")
            line.add(f"{team['abbr']:<5}", THEME.style(league, team, bold=True,
                                                       fallback=t["side"]))
            room = max(10, width - len(line.text) - len(tail))
            line.add(cut_text(text, room).ljust(room), "normal")
            line.add(tail, "bold")
            lines.append(line)
    return lines


def baseball_game_notes(summary, width):
    """The game's own line under a baseball box score (7.0.0): who won and
    lost, the umpires at each base, how long it took, the crowd and the
    ballpark - those ESPN sends."""
    lines = []
    label_w = 20
    info = summary.get("gameInfo") or {}
    rows = []
    status = dig(summary, "header", "competitions", 0, "status", default={}) or {}
    decisions = []
    for item in status.get("featuredAthletes") or []:
        kind = {"winningPitcher": "W", "losingPitcher": "L", "savingPitcher": "S"}.get(
            item.get("name"))
        who = clean(dig(item, "athlete", "shortName", default="") or
                    dig(item, "athlete", "displayName", default="") or "")
        if kind and who:
            decisions.append(f"{kind} {who}")
    if decisions:
        rows.append(("Decisions", " · ".join(decisions)))
    bases = {"Home Plate": "HP", "First Base": "1B", "Second Base": "2B", "Third Base": "3B",
             "Left Field": "LF", "Right Field": "RF"}
    umpires = []
    for official in sorted(info.get("officials") or [], key=lambda o: _int(o.get("order"), 9)):
        name = clean(official.get("displayName") or "")
        where = clean(dig(official, "position", "displayName", default="") or "")
        where = next((short for long, short in bases.items() if where.startswith(long)), "")
        if name:
            umpires.append(f"{where} {name}".strip())
    if umpires:
        rows.append(("Umpires", ", ".join(umpires)))
    if info.get("gameDuration"):
        rows.append(("Time", clean(str(info["gameDuration"]))))
    if _int(info.get("attendance")):
        rows.append(("Attendance", f"{_int(info['attendance']):,}"))
    venue = dig(info, "venue", "fullName", default="") or ""
    city = dig(info, "venue", "address", "city", default="") or ""
    if venue:
        rows.append(("Ballpark", clean(venue) + (f", {clean(city)}" if city else "")))
    if not rows:
        return lines
    lines.append(Line().add("  Game", "header"))
    for label, text in rows:
        chunks = [l.text for l in wrap_spans(text, max(20, width - label_w - 4))] or [text]
        for index, chunk in enumerate(chunks):
            lines.append(Line().add(f"    {label if index == 0 else '':<{label_w}}", "muted")
                         .add(chunk, "normal"))
    return lines


def box_row_stats(labels, entry):
    """{label: value} for a box score row, a pitcher's decision ('W, 2-0')
    as Dec."""
    stats = dict(zip([clean(l) for l in labels],
                     [clean(s) for s in entry.get("stats") or []]))
    for note in entry.get("notes") or []:
        if isinstance(note, dict) and note.get("type") == "pitchingDecision" and \
                note.get("text"):
            stats["Dec"] = clean(note["text"])
    return stats


def boxscore_team_lines(team_block, league, width=None):
    """Every stat table for one team, each squeezed to fit `width`."""
    lines = []
    team = block_team(team_block)
    everything = {}
    if sport_of(league) in ("football", "baseball"):
        for section in team_block.get("statistics") or []:
            labels = [clean(l) for l in section.get("labels") or section.get("names") or []]
            for entry in section.get("athletes") or []:
                ident = str(dig(entry, "athlete", "id", default="") or "")
                if ident:
                    everything.setdefault(ident, []).append(
                        (clean(section.get("name") or section.get("type") or ""),
                         box_row_stats(labels, entry)))
    for section in team_block.get("statistics") or []:
        labels = section.get("labels") or section.get("names") or []
        athletes = section.get("athletes") or []
        rows = []
        row_styles = []
        refs = []
        for entry in athletes:
            name = clean(dig(entry, "athlete", "displayName", default="?"))
            position = clean(dig(entry, "athlete", "position", "abbreviation", default=""))
            if position.upper() in ("UN", "UNK", "--", "NA"):
                position = ""          # ESPN's 'unknown' (7.0.0)
            if position:
                name = f"{name} {position}"
            stats = [clean(s) for s in (entry.get("stats") or [])]
            rows.append([name] + stats)
            row_styles.append("normal" if entry.get("starter") else "dim")
            athlete = entry.get("athlete") or {}
            headshot = athlete.get("headshot")
            refs.append({
                "id": str(athlete.get("id") or ""),
                "name": clean(athlete.get("displayName") or ""),
                "short": clean(athlete.get("shortName") or ""),
                "jersey": clean(str(athlete.get("jersey") or "")),
                "pos": position,
                "group": clean(section.get("name") or section.get("type") or ""),
                "headshot": clean((headshot.get("href") if isinstance(headshot, dict)
                                   else headshot) or ""),
                "team": team,
                "stats": box_row_stats(labels, entry),
                "lines": everything.get(str(athlete.get("id") or ""), [])})
        if not rows:
            continue
        totals = [clean(t) for t in (section.get("totals") or [])]
        if totals and sport_of(league) == "baseball" and \
                not any(re.search(r"\d", t) for t in totals):
            totals = summed_box_totals(labels, [r[1:] for r in rows])   # 7.0.0
        if totals:
            rows.append(["Totals"] + totals)
            row_styles.append("accent")
        title = stat_section_title(section)
        # the section's name sits in its own header row's empty first cell
        # (the pane already says which team), saving a line per table
        for prefix in (team.get("name"), team.get("location"), team.get("short")):
            if prefix and title.lower().startswith(prefix.lower() + " "):
                title = title[len(prefix) + 1:]
                break
        aligns = ["<"] + [">"] * len(labels)
        table = fitted_table([title] + [clean(l) for l in labels], rows,
                             None if width is None else width - 2, aligns, row_styles)
        if table and len(table[0]):
            text, _ = table[0][0]
            table[0][0] = (text, THEME.style(league, team, bold=True, fallback="accent"))
        for index, row in enumerate(table):
            line = Line([("  ", "normal")] + list(row))
            # the table's first line is its header; each row after is a player
            if 1 <= index <= len(refs) and league in CARD_LEAGUES and refs[index - 1]["id"]:
                line.player_ref = dict(refs[index - 1], sport=sport_of(league))
            lines.append(line)
        if sport_of(league) == "basketball":
            split = bball_split_lines(section, labels, width or 200)
            if split:
                lines.append(blank())
                lines.extend(split)
        lines.append(blank())
    while lines and not lines[-1]:
        lines.pop()
    return lines


def bball_split_lines(section, labels, width):
    """Under a basketball box score: what the starters and the bench each put
    up, the team's shooting (with effective and true shooting), and anyone
    with a double-double."""
    labels = [clean(l) for l in labels]
    sums = {True: {}, False: {}}
    count = {True: 0, False: 0}
    doubles = []
    for entry in section.get("athletes") or []:
        values = [clean(s) for s in entry.get("stats") or []]
        if not values:
            continue
        stats = dict(zip(labels, values))
        side = bool(entry.get("starter"))
        count[side] += 1
        bucket = sums[side]
        for key in ("PTS", "REB", "AST", "STL", "BLK", "TO"):
            bucket[key] = bucket.get(key, 0) + _int(stats.get(key))
        for key in ("FG", "3PT", "FT"):
            made, tried = made_attempted(stats.get(key))
            if made is not None:
                had = bucket.get(key, (0, 0))
                bucket[key] = (had[0] + made, had[1] + tried)
        tens = [(key.lower(), _int(stats.get(key))) for key in ("PTS", "REB", "AST", "STL", "BLK")
                if _int(stats.get(key)) >= 10]
        if len(tens) >= 2:
            who = clean(dig(entry, "athlete", "shortName", default="")
                        or dig(entry, "athlete", "displayName", default="?"))
            doubles.append((len(tens), who, tens))
    if not count[True] + count[False]:
        return []
    total = sum(sums[s].get("PTS", 0) for s in (True, False)) or 1
    lines = []
    for side, label in ((True, "Starters"), (False, "Bench")):
        got = sums[side]
        if not count[side]:
            continue
        line = Line().add(f"  {label:<10}", "muted").add(str(got.get("PTS", 0)), "bold")
        line.add(f" pts ({got.get('PTS', 0) * 100 / total:.0f}%)", "muted")
        for key in ("FG", "3PT", "FT"):
            made, tried = got.get(key, (0, 0))
            line.add(" · ", "muted").add(f"{made}-{tried}", "normal").add(f" {key}", "muted")
        for key in ("REB", "AST"):
            line.add(" · ", "muted").add(str(got.get(key, 0)), "normal").add(f" {key.lower()}", "muted")
        lines.append(fit_line(line, width))
    made = {key: sum(sums[s].get(key, (0, 0))[0] for s in (True, False)) for key in ("FG", "3PT", "FT")}
    tried = {key: sum(sums[s].get(key, (0, 0))[1] for s in (True, False)) for key in ("FG", "3PT", "FT")}
    if tried["FG"]:
        points = sum(sums[s].get("PTS", 0) for s in (True, False))
        parts = [("FG", made["FG"] / tried["FG"]),
                 ("3PT", made["3PT"] / tried["3PT"] if tried["3PT"] else None),
                 ("FT", made["FT"] / tried["FT"] if tried["FT"] else None),
                 ("eFG", (made["FG"] + 0.5 * made["3PT"]) / tried["FG"]),
                 ("TS", points / (2 * (tried["FG"] + 0.44 * tried["FT"])))]
        line = Line().add(f"  {'Shooting':<10}", "muted")
        for index, (name, value) in enumerate(p for p in parts if p[1] is not None):
            if index:
                line.add(" · ", "muted")
            line.add(f"{name} ", "muted").add(f"{value * 100:.1f}%", "bold")
        lines.append(fit_line(line, width))
    for kind, who, tens in sorted(doubles, key=lambda d: -d[0]):
        name = {2: "Double-double", 3: "Triple-double"}.get(kind, "Quadruple-double")
        line = Line().add("  ").add(name, "warn" if kind >= 3 else "accent").add(f"  {who} ", "normal")
        line.add(" ".join(f"{value} {key}" for key, value in tens), "bold")
        lines.append(fit_line(line, width))
    return lines


def pane_title(league, team, score, side, favorites, extra=""):
    """A pane caption in the team's own colour: ★ Oregon Ducks 17 · home"""
    line = Line().add(" ", "border")
    if team is None:
        return line.add(f"{side} ", "accent")
    if fav_rank(favorites or {}, league, team) >= 0:
        line.add(STAR + " ", "star")
    line.add(team.get("name") or team.get("abbr") or "?",
             THEME.style(league, team, bold=True, fallback="accent"))
    if score is not None:
        line.add(f" {score}", "bold")
    line.add(f" · {side}", "muted")
    if extra:
        line.add(f" · {extra}", "dim")
    return line.add(" ", "border")


def render_team_stats(summary, league, width, favorites=None):
    """Single column, used by --team-stats: bars, leaders, then the rest."""
    teams = dig(summary, "boxscore", "teams", default=[]) or []
    if len(teams) < 2:
        return [Line().add("No team statistics published for this game yet.", "dim")]
    lines = summary_header_lines(summary, league, width)
    graph, rest = team_stat_sections(summary, league, width)
    lines.extend(graph)
    lines.append(blank())
    leaders = render_game_leaders(summary, league, width)
    if leaders:
        lines.extend(leaders)
        lines.append(blank())
    lines.extend(rest)
    return lines


