def half_court(shots, league, team, cols):
    """One team's shots on a half court seen from above (the rim at the top):
    braille court lines, ● a make and ○ a miss in the team's colour."""
    court = court_for(league)
    depth = 28.0
    feet_per_px = 50.0 / (cols * 2)
    rows = int((depth + court["baseline"]) / (feet_per_px * 4)) + 1
    lit = court_pixels(court, cols, rows)
    cells = [[0] * cols for _ in range(rows)]
    for px, py in lit:
        cells[py // 4][px // 2] |= BRAILLE_BITS[py % 4][px % 2]
    marks = {}
    for shot in shots:
        row = int((shot["y"] + court["baseline"]) / (feet_per_px * 4))
        if row >= rows:
            continue
        col = clamp(int(shot["x"] / 50.0 * cols), 0, cols - 1)
        made, missed = marks.get((row, col), (0, 0))
        marks[(row, col)] = (made + shot["made"], missed + (not shot["made"]))
    made_style = THEME.style(league, team, bold=True, fallback="good")
    miss_style = THEME.style(league, team, dim=True, fallback="muted")
    lines = []
    for row in range(rows):
        line = Line()
        for col in range(cols):
            made, missed = marks.get((row, col), (0, 0))
            if made:
                line.add("●", made_style)
            elif missed:
                line.add("○", miss_style)
            elif cells[row][col]:
                line.add(chr(0x2800 + cells[row][col]), "zonefaint")
            else:
                line.add(" ", "normal")
        lines.append(merge_spans(line))
    return lines


def basketball_story(summary, event, league):
    """What a broadcast puts beside the court: the run, the lead changes, the
    biggest leads, team fouls this period, points in the paint and on the
    break, each side's top scorer."""
    away, home = event["away"], event["home"]
    plays = dig(summary, "plays", default=[]) or []
    lines = []
    scoring = [p for p in plays if p.get("scoringPlay") and (p.get("scoreValue") or 0) > 0
               and dig(p, "team", "id")]
    if scoring and event["state"] == "in":
        last = str(dig(scoring[-1], "team", "id"))
        run = 0
        for play in reversed(scoring):
            if str(dig(play, "team", "id")) != last:
                break
            run += play.get("scoreValue") or 0
        side = side_of(event, last)
        if side and run >= 5:
            team = event[side]
            lines.append(Line().add(f"{'RUN':<14}", "muted")
                         .add(f"{team.get('abbr', '')} {run}-0", THEME.style(league, team,
                                                                              bold=True))
                         .add(" unanswered", "dim"))
    changes, ties, last_leader, state = 0, 0, 0, 0
    for play in scoring:
        a, h = play.get("awayScore"), play.get("homeScore")
        if not isinstance(a, int) or not isinstance(h, int):
            continue
        now = (a > h) - (a < h)
        if now == 0 and state != 0:
            ties += 1
        if now:
            if last_leader and now != last_leader:
                changes += 1
            last_leader = now
        state = now
    if scoring:
        line = Line().add(f"{'LEAD':<14}", "muted").add(f"{changes}", "bold")
        line.add(f" change{'s' if changes != 1 else ''} · tied ", "dim").add(f"{ties}", "bold")
        line.add(f" time{'s' if ties != 1 else ''}", "dim")
        lines.append(line)
    biggest = (box_stat(summary, away.get("id"), "largestLead"),
               box_stat(summary, home.get("id"), "largestLead"))
    if any(biggest):
        lines.append(_stat_line("BIGGEST LEAD", event, league, biggest[0] or "0",
                                biggest[1] or "0"))
    period = max([dig(p, "period", "number", default=0) or 0 for p in plays] or [0])
    if period and event["state"] == "in":
        fouls = {"away": 0, "home": 0}
        for play in plays:
            if (dig(play, "period", "number", default=0) or 0) != period:
                continue
            kind = clean(dig(play, "type", "text", default="")).lower()
            if "foul" not in kind or "technical" in kind or "offensive" in kind \
                    or "double" in kind:
                continue
            side = side_of(event, dig(play, "team", "id"))
            if side:
                fouls[side] += 1
        label = "FOULS THIS HALF" if league == "cbb" else "FOULS THIS Q"
        lines.append(_stat_line(label, event, league, fouls["away"], fouls["home"],
                                label_width=16))
    for label, stat in (("IN THE PAINT", "pointsInPaint"), ("FAST BREAK", "fastBreakPoints"),
                        ("TURNOVERS", "totalTurnovers")):
        pair = (box_stat(summary, away.get("id"), stat), box_stat(summary, home.get("id"),
                                                                    stat))
        if any(pair):
            lines.append(_stat_line(label, event, league, pair[0] or "0", pair[1] or "0"))
    tops = [(event[side], game_top_scorer(summary, event[side].get("id")))
            for side in ("away", "home")]
    if any(text for _, text in tops):
        lines.append(blank())
        lines.append(Line().add("TOP SCORERS", "title"))
        for team, text in tops:
            if text:
                lines.append(Line().add(f"{team.get('abbr', ''):<5}", THEME.style(
                    league, team, bold=True)).add(text, "normal"))
    return lines


def basketball_panel(summary, event, league, width, height):
    """Both teams' shot charts side by side and the story of the game."""
    shots = basketball_shots(summary)
    story = basketball_story(summary, event, league)
    story_w = 40
    room = width - story_w - 4
    out = []
    if shots and room >= 44 and height >= 9:
        cols = clamp((room - 4) // 2, 20, 34)
        courts = []
        for side in ("away", "home"):
            team = event[side]
            mine = [s for s in shots if s["team"] == str(team.get("id"))]
            made = sum(1 for s in mine if s["made"])
            head = Line().add(f"{team.get('abbr', '')} ", THEME.style(league, team, bold=True))
            head.add(f"{made}/{len(mine)} from the field"[: max(0, cols - 5)], "dim")
            courts.append([head] + half_court(mine, league, team, cols)[: height - 2])
        rows = max(len(c) for c in courts)
        for index in range(rows):
            line = Line()
            for number, court in enumerate(courts):
                part = court[index] if index < len(court) else Line()
                if number:
                    line.add("   ", "normal")
                line.extend(part)
                line.add(" " * max(0, cols - len(part.text)), "normal")
            out.append(line)
        legend = Line().add("● made  ○ missed", "muted")
        out.append(legend)
        left_w = 2 * cols + 3
    else:
        left_w = 0
    if not out:
        return story[:height]
    merged = []
    for index in range(max(len(out), len(story))):
        line = Line()
        part = out[index] if index < len(out) else Line()
        line.extend(part)
        line.add(" " * max(2, left_w + 4 - len(part.text)), "normal")
        if index < len(story):
            line.extend(story[index])
        merged.append(line)
    return merged[:height]


# -- hockey -------------------------------------------------------------------

def hockey_shots(summary, event):
    """Shots on goal and goals with a location, each turned so the away team
    attacks the left net and the home team the right: dicts of side, x
    (0-200 ft) and y (0-85 ft), goal."""
    out = []
    for play in dig(summary, "plays", default=[]) or []:
        kind = clean(dig(play, "type", "text", default="")).lower()
        if kind not in ("shot", "goal"):
            continue
        x, y = dig(play, "coordinate", "x"), dig(play, "coordinate", "y")
        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)) \
                or abs(x) > 100 or abs(y) > 43:
            continue
        side = side_of(event, dig(play, "team", "id"))
        if not side:
            continue
        if (side == "away" and x > 0) or (side == "home" and x < 0):
            x, y = -x, -y
        out.append({"side": side, "x": float(x) + 100.0, "y": float(y) + 42.5,
                    "goal": kind == "goal"})
    return out


def rink_lines(shots, event, league, cols):
    """A rink from above in braille - the boards, the red centre and goal
    lines, the blue lines, the circles - with every shot on goal (•) and goal
    (●) in the shooting team's colour. The away team shoots at the left net."""
    import math
    width_px = cols * 2
    feet_per_px = 200.0 / width_px
    rows = int(math.ceil(85.0 / feet_per_px / 4))
    layers = {"board": set(), "red": set(), "blue": set()}

    def dot(layer, x_ft, y_ft):
        px, py = int(round(x_ft / feet_per_px)), int(round(y_ft / feet_per_px))
        if 0 <= px < width_px and 0 <= py < rows * 4:
            layers[layer].add((px, py))

    def segment(layer, x0, y0, x1, y1):
        steps = int(max(abs(x1 - x0), abs(y1 - y0)) / feet_per_px * 2) + 1
        for i in range(steps + 1):
            t = i / steps
            dot(layer, x0 + (x1 - x0) * t, y0 + (y1 - y0) * t)

    def arc(layer, cx, cy, radius, start, end):
        steps = int(radius * abs(end - start) / feet_per_px * 2) + 4
        for i in range(steps + 1):
            angle = start + (end - start) * i / steps
            dot(layer, cx + radius * math.cos(angle), cy + radius * math.sin(angle))

    corner = 28.0
    bottom = 85.0 - feet_per_px
    right = 200.0 - feet_per_px
    segment("board", corner, 0, 200 - corner, 0)
    segment("board", corner, bottom, 200 - corner, bottom)
    segment("board", 0, corner, 0, 85 - corner)
    segment("board", right, corner, right, 85 - corner)
    arc("board", corner, corner, corner, math.pi, 1.5 * math.pi)
    arc("board", 200 - corner, corner, corner, 1.5 * math.pi, 2 * math.pi)
    arc("board", corner, 85 - corner, corner, 0.5 * math.pi, math.pi)
    arc("board", 200 - corner, 85 - corner, corner, 0, 0.5 * math.pi)
    segment("red", 100, 1, 100, 84)                       # the centre line
    for x in (11.0, 189.0):                               # the goal lines
        reach = 4.0
        segment("red", x, reach, x, 85 - reach)
        arc("red", x + (-2.5 if x < 100 else 2.5), 42.5, 3.0, 0, 2 * math.pi)  # the nets
    for x in (75.0, 125.0):                               # the blue lines
        segment("blue", x, 1, x, 84)
    arc("blue", 100, 42.5, 15, 0, 2 * math.pi)            # the centre circle
    for x in (31.0, 169.0):
        for y in (20.5, 64.5):
            arc("red", x, y, 15, 0, 2 * math.pi)          # the faceoff circles
    cells = {}
    for layer in ("board", "blue", "red"):
        for px, py in layers[layer]:
            key = (py // 4, px // 2)
            bits, _ = cells.get(key, (0, layer))
            cells[key] = (bits | BRAILLE_BITS[py % 4][px % 2], layer)
    marks = {}
    for shot in shots:
        key = (min(rows - 1, int(shot["y"] / feet_per_px / 4)),
               min(cols - 1, int(shot["x"] / feet_per_px / 2)))
        goal, side = marks.get(key, (False, shot["side"]))
        marks[key] = (goal or shot["goal"], shot["side"] if shot["goal"] or not goal else side)
    styles = {"board": "dim", "red": "@" + RINK_RED, "blue": "@" + RINK_BLUE}
    lines = []
    for row in range(rows):
        line = Line()
        for col in range(cols):
            if (row, col) in marks:
                goal, side = marks[(row, col)]
                team = event[side]
                line.add("●" if goal else "•", THEME.style(league, team, bold=goal,
                                                          dim=not goal, fallback="accent"))
            elif (row, col) in cells:
                bits, layer = cells[(row, col)]
                line.add(chr(0x2800 + bits), styles[layer])
            else:
                line.add(" ", "normal")
        lines.append(merge_spans(line))
    return lines


def hockey_strength(summary, event):
    """Who is on the power play now, from the latest play's strength: the
    side and its abbreviation, or None at even strength."""
    for play in reversed(dig(summary, "plays", default=[]) or []):
        strength = clean(dig(play, "strength", "text", default="")).lower()
        side = side_of(event, dig(play, "team", "id"))
        if not strength or not side:
            continue
        if strength.startswith("power"):
            return side
        if strength.startswith("short"):
            return "home" if side == "away" else "away"
        return None
    return None


def hockey_goalies(summary, event, league):
    """'J. Woll  21 saves on 26  .808' for each team's goalies."""
    lines = []
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = side_of(event, dig(block, "team", "id"))
        if not side:
            continue
        for group in block.get("statistics") or []:
            if group.get("name") != "goalies":
                continue
            keys = group.get("labels") or group.get("keys") or []
            for athlete in group.get("athletes") or []:
                stats = dict(zip(keys, athlete.get("stats") or []))
                if not stats.get("SA") or stats.get("SA") == "0":
                    continue
                who = clean(dig(athlete, "athlete", "shortName", default="") or "?")
                team = event[side]
                line = Line().add(f"{team.get('abbr', ''):<5}", THEME.style(league, team,
                                                                            bold=True))
                line.add(f"{who:<14}", "normal")
                line.add(f"{stats.get('SV', '?')} saves on {stats.get('SA', '?')}", "dim")
                if stats.get("SV%"):
                    line.add(f"  {stats['SV%']}", "bold")
                lines.append(line)
    return lines


def hockey_story(summary, event, league):
    away, home = event["away"], event["home"]
    lines = []
    shots = (box_stat(summary, away.get("id"), "shotsTotal"),
             box_stat(summary, home.get("id"), "shotsTotal"))
    if any(shots):
        lines.append(_stat_line("SHOTS", event, league, shots[0] or "0", shots[1] or "0"))
    if event["state"] == "in":
        side = hockey_strength(summary, event)
        line = Line().add(f"{'STRENGTH':<14}", "muted")
        if side:
            team = event[side]
            line.add(f"{team.get('abbr', '')} POWER PLAY", THEME.style(league, team,
                                                                       bold=True))
        else:
            line.add("even", "dim")
        lines.append(line)
    pp = []
    for team in (away, home):
        goals = box_stat(summary, team.get("id"), "powerPlayGoals")
        chances = box_stat(summary, team.get("id"), "powerPlayOpportunities")
        pp.append(f"{goals}/{chances}" if chances else "")
    if tracked(*pp):
        lines.append(_stat_line("POWER PLAYS", event, league, pp[0] or "-", pp[1] or "-"))
    faceoffs = (box_stat(summary, away.get("id"), "faceoffPercent"),
                box_stat(summary, home.get("id"), "faceoffPercent"))
    if tracked(*faceoffs):
        lines.append(_stat_line("FACEOFFS", event, league, f"{faceoffs[0] or '-'}%",
                                f"{faceoffs[1] or '-'}%"))
    hits = (box_stat(summary, away.get("id"), "hits"), box_stat(summary, home.get("id"),
                                                                   "hits"))
    if tracked(*hits):
        lines.append(_stat_line("HITS", event, league, hits[0] or "0", hits[1] or "0"))
    goalies = hockey_goalies(summary, event, league)
    if goalies:
        lines.append(blank())
        lines.append(Line().add("GOALIES", "title"))
        lines.extend(goalies)
    return lines


def hockey_goals(summary, event, league, limit=12):
    """GOALS: period, time, team, scorer, PP or SH - every one, or the last
    `limit` when there are more (the heading then says so)."""
    lines = []
    goals = []
    for play in dig(summary, "plays", default=[]) or []:
        if not play.get("scoringPlay"):
            continue
        side = side_of(event, dig(play, "team", "id"))
        if not side:
            continue
        text = clean(play.get("text") or "")
        who = next((clean(dig(p, "athlete", "shortName", default=""))
                    for p in play.get("participants") or []
                    if p.get("type") == "scorer"), "")
        if not who:
            found = re.search(r"Goal Scored by (.+?)(?: assisted| \(|$)", text) or \
                re.match(r"(.+?)(?: Goal| \(|,|$)", text)
            who = found.group(1).strip() if found else text
        strength = clean(dig(play, "strength", "text", default="")).lower() + " " + text.lower()
        tag = "PP" if "power play" in strength else "SH" if "short" in strength \
            else "EN" if "empty net" in strength else ""
        number = dig(play, "period", "number", default=0) or 0
        period = clean(dig(play, "period", "displayValue", default="") or "") or \
            {1: "1st", 2: "2nd", 3: "3rd", 4: "OT"}.get(number, f"{number - 3}OT"
                                                         if number > 4 else "")
        goals.append((period, clean(dig(play, "clock", "displayValue", default="")), side,
                      who, tag))
    if goals:
        lines.append(Line().add("GOALS" if len(goals) <= limit else
                                f"GOALS · the last {limit} of {len(goals)}", "title"))
        for period, clock, side, who, tag in goals[-limit:]:
            team = event[side]
            line = Line().add(f"{period:<4}{clock:>6}  ", "dim")
            line.add(f"{team.get('abbr', ''):<5}", THEME.style(league, team, bold=True))
            line.add(who[:22], "normal")
            if tag:
                line.add(f"  {tag}", "accent")
            lines.append(line)
    return lines


def hockey_panel(summary, event, league, width, height):
    numbers = hockey_story(summary, event, league)
    # as many goals as the height leaves room for, the latest kept
    goals = hockey_goals(summary, event, league, limit=max(4, height - len(numbers) - 2))
    story = numbers + ([blank()] + goals if goals else [])
    story_w = 44
    room = width - story_w - 4
    shots = hockey_shots(summary, event)
    if not shots or room < 40 or height < 8:
        # no shot locations (the AHL's feed, the Olympics): the goals on a
        # period timeline, then the numbers and the goals side by side
        timeline = hockey_timeline(summary, event, league, min(width, 110))
        if timeline and height >= len(timeline) + 6:
            timeline = timeline + [blank()]
        else:
            timeline = []
        height -= len(timeline)
        if width < 96 or not goals:
            return timeline + story[:height]
        left_w = max([len(l.text) for l in numbers] + [40]) + 6
        merged = []
        for index in range(max(len(numbers), len(goals))):
            line = Line()
            part = numbers[index] if index < len(numbers) else Line()
            line.extend(part)
            line.add(" " * max(0, left_w - len(part.text)), "normal")
            if index < len(goals):
                line.extend(goals[index])
            merged.append(line)
        return timeline + merged[:height]
    import math
    # as wide as fits, as tall as the room allows (85 x 200 ft)
    cols = clamp(room, 40, 84)
    while cols > 40 and math.ceil(85.0 / (200.0 / (cols * 2)) / 4) > height - 2:
        cols -= 2
    rink = rink_lines(shots, event, league, cols)
    head = Line()
    for side in ("away", "home"):
        team = event[side]
        mine = [s for s in shots if s["side"] == side]
        if head:
            head.add("   ", "normal")
        head.add(f"{team.get('abbr', '')} ", THEME.style(league, team, bold=True))
        head.add(("◀ " if side == "away" else "▶ ") + f"{len(mine)} shots", "dim")
    legend = Line().add("• shot on goal  ● goal", "muted")
    left = [head] + rink + [legend]
    merged = []
    for index in range(max(len(left), len(story))):
        line = Line()
        part = left[index] if index < len(left) else Line()
        line.extend(part)
        line.add(" " * max(2, cols + 4 - len(part.text)), "normal")
        if index < len(story):
            line.extend(story[index])
        merged.append(line)
    return merged[:height]


# -- soccer -------------------------------------------------------------------

def soccer_events(summary, event):
    """[(minute, side, kind, text)] - goals, own goals, cards - from the key
    events; kind is 'goal', 'yellow' or 'red'."""
    out = []
    for item in dig(summary, "keyEvents", default=[]) or []:
        kind = clean(dig(item, "type", "text", default="")).lower()
        side = side_of(event, dig(item, "team", "id"))
        minute_text = clean(dig(item, "clock", "displayValue", default="") or "")
        match = re.match(r"(\d+)'(?:\+(\d+)')?", minute_text)
        if not match or not side:
            continue
        minute = int(match.group(1)) + (int(match.group(2)) * 0.1 if match.group(2) else 0)
        if ("goal" in kind or kind.startswith("penalty - scored")) and \
                "disallowed" not in kind and "missed" not in kind and \
                not item.get("shootout"):
            mark = "goal"
        elif "red card" in kind or "second yellow" in kind:
            mark = "red"
        elif "yellow" in kind:
            mark = "yellow"
        else:
            continue
        who = ""
        for athlete in item.get("participants") or []:
            who = clean(dig(athlete, "athlete", "displayName", default="") or "")
            if who:
                break
        if not who:
            text = clean(item.get("text") or "")
            found = re.search(r"\. ([^.(]+?) \(", text) or re.match(r"([^(]+?) \(", text)
            who = found.group(1).strip() if found else ""
        if "own goal" in kind:
            who = (who + " (og)").strip()
        if "penalty" in kind and mark == "goal" and "(pen)" not in who:
            who = (who + " (pen)").strip()
        out.append((minute, minute_text, side, mark, who))
    return out


def soccer_timeline(items, event, league, width):
    """The match on one line, kick-off to the final whistle: goals (●) and
    cards (▮) above it for the away team and below it for the home team."""
    end = max([90] + [int(m) + 1 for m, *_ in items])
    end = 120 if end > 95 else 90
    cols = max(30, width - 6)

    def col(minute):
        return 3 + int(min(minute, end) / end * (cols - 1))

    rows = {"away": [" "] * (cols + 6), "home": [" "] * (cols + 6)}
    styles = {"away": [None] * (cols + 6), "home": [None] * (cols + 6)}
    for minute, _, side, mark, _ in items:
        x = col(minute)
        if mark == "goal":
            rows[side][x] = "●"
            styles[side][x] = THEME.style(league, event[side], bold=True, fallback="accent")
        elif rows[side][x] != "●":
            rows[side][x] = "▮"
            styles[side][x] = "@" + (CARD_RED if mark == "red" else CARD_YELLOW)

    def mark_line(side):
        line = Line().add(f"{event[side].get('abbr', '')[:3]:<3}",
                          THEME.style(league, event[side], bold=True))
        for x in range(3, cols + 4):
            line.add(rows[side][x], styles[side][x] or "normal")
        return merge_spans(line)

    axis = Line().add("   ", "normal")
    ticks = list(range(0, end + 1, 15))
    text = ["─"] * cols
    for minute in ticks:
        text[min(cols - 1, col(minute) - 3)] = "┼" if 0 < minute < end else "│"
    axis.add("".join(text), "border")
    labels = [" "] * (cols + 6)
    for minute in ticks:
        tag = "HT" if minute == 45 else ("FT" if minute == end else f"{minute}'")
        start = col(minute) - len(tag) // 2
        for i, ch in enumerate(tag):
            if 0 <= start + i < len(labels):
                labels[start + i] = ch
    return [mark_line("away"), axis, mark_line("home"),
            Line().add("".join(labels), "muted")]


def soccer_panel(summary, event, league, width, height):
    items = soccer_events(summary, event)
    away, home = event["away"], event["home"]
    lines = soccer_timeline(items, event, league, min(width - 2, 110))
    lines.append(blank())
    possession = (box_stat(summary, away.get("id"), "possessionPct"),
                  box_stat(summary, home.get("id"), "possessionPct"))
    try:
        share = float(possession[0]) / max(1.0, float(possession[0]) + float(possession[1]))
    except (TypeError, ValueError):
        share = None
    if share is not None:
        bar_w = clamp(width - 40, 20, 60)
        cut = int(round(share * bar_w))
        line = Line().add(f"{'POSSESSION':<14}", "muted")
        line.add(f"{away.get('abbr', '')} {float(possession[0]):.0f}% ",
                 THEME.style(league, away, bold=True))
        line.add("█" * cut, "@" + team_hex(league, away))
        line.add("█" * (bar_w - cut), "@" + team_hex(league, home))
        line.add(f" {float(possession[1]):.0f}% {home.get('abbr', '')}",
                 THEME.style(league, home, bold=True))
        lines.append(line)
    pairs = []
    for label, stat, extra in (("SHOTS", "totalShots", "shotsOnTarget"),
                               ("CORNERS", "wonCorners", None), ("FOULS", "foulsCommitted",
                                                                 None),
                               ("SAVES", "saves", None), ("OFFSIDES", "offsides", None)):
        values = []
        for team in (away, home):
            value = box_stat(summary, team.get("id"), stat)
            if extra and value:
                on = box_stat(summary, team.get("id"), extra)
                value = f"{value} ({on} on target)" if on else value
            values.append(value)
        if any(values):
            pairs.append(_stat_line(label, event, league, values[0] or "0", values[1] or "0"))
    goals = [i for i in items if i[3] == "goal"]
    cards = [i for i in items if i[3] != "goal"]
    scorers = []
    if goals:
        scorers.append(Line().add("GOALS", "title"))
        for _, minute_text, side, _, who in goals[-10:]:
            team = event[side]
            scorers.append(Line().add(f"{minute_text:>7}  ", "dim")
                           .add(f"{team.get('abbr', ''):<5}", THEME.style(league, team,
                                                                          bold=True))
                           .add(who[:32] or "goal", "normal"))
    if cards:
        line = Line().add("CARDS ", "title")
        for _, minute_text, side, mark, who in cards[-8:]:
            line.add("▮", "@" + (CARD_RED if mark == "red" else CARD_YELLOW))
            line.add(f"{event[side].get('abbr', '')} {minute_text} ", "dim")
        pairs.append(line)
    if width >= 110 and scorers:
        # the numbers on the left, the scorers beside them
        gap = max(len(p.text) for p in pairs) + 4 if pairs else 0
        for index in range(max(len(pairs), len(scorers))):
            line = Line()
            part = pairs[index] if index < len(pairs) else Line()
            line.extend(part)
            line.add(" " * max(0, gap - len(part.text)), "normal")
            if index < len(scorers):
                line.extend(scorers[index])
            lines.append(line)
    else:
        lines.extend(pairs)
        if scorers:
            lines.append(blank())
            lines.extend(scorers)
    return lines[:height]


