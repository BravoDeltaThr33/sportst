EDGE = 0.35          # how far apart two percentiles must be to call it an edge


def _percentile(rank, total):
    if not rank or total < 2:
        return None
    return 1.0 - (rank - 1) / (total - 1)


def matchup_edges(table, ranks, away_row, home_row, away, home):
    """[(side, size, text)] - the places one team's numbers say it should win
    the matchup, strongest first."""
    stats = {s["key"]: s for s in table.get("stats") or []}
    totals = {key: len(r) for key, r in ranks.items()}
    edges = []
    for side_name, attack, defend, a_team, d_team in (
            ("away", away_row, home_row, away, home), ("home", home_row, away_row, home, away)):
        for stat in table.get("stats") or []:
            partner = stats.get(stat.get("vs") or "")
            if not partner:
                continue
            a_rank = ranks.get(stat["key"], {}).get(attack["id"])
            d_rank = ranks.get(partner["key"], {}).get(defend["id"])
            a_pct = _percentile(a_rank, totals.get(stat["key"], 0))
            d_pct = _percentile(d_rank, totals.get(partner["key"], 0))
            if a_pct is None or d_pct is None:
                continue
            gap = a_pct - d_pct
            if gap >= EDGE:
                edges.append((side_name, gap,
                              f"{a_team['abbr']} {stat['label'].lower()} "
                              f"(#{a_rank}) vs {d_team['abbr']} "
                              f"{partner['label'].lower()} (#{d_rank})"))
            elif gap <= -EDGE:
                other = "home" if side_name == "away" else "away"
                edges.append((other, -gap,
                              f"{d_team['abbr']} {partner['label'].lower()} "
                              f"(#{d_rank}) vs {a_team['abbr']} "
                              f"{stat['label'].lower()} (#{a_rank})"))
    # head-to-head on the stats with no opposite number
    paired = {s.get("vs") for s in table.get("stats") or []} | \
        {s["key"] for s in table.get("stats") or [] if s.get("vs")}
    for stat in table.get("stats") or []:
        if stat["key"] in paired:
            continue
        a_rank = ranks.get(stat["key"], {}).get(away_row["id"])
        h_rank = ranks.get(stat["key"], {}).get(home_row["id"])
        total = totals.get(stat["key"], 0)
        a_pct, h_pct = _percentile(a_rank, total), _percentile(h_rank, total)
        if a_pct is None or h_pct is None or abs(a_pct - h_pct) < EDGE + 0.1:
            continue
        side_name = "away" if a_pct > h_pct else "home"
        better, worse = (away, home) if side_name == "away" else (home, away)
        edges.append((side_name, abs(a_pct - h_pct) - 0.1,
                      f"{better['abbr']} {stat['label'].lower()} (#"
                      f"{a_rank if side_name == 'away' else h_rank}) vs {worse['abbr']} (#"
                      f"{h_rank if side_name == 'away' else a_rank})"))
    edges.sort(key=lambda e: -e[1])
    return edges


def comparison_blocks(table, ranks, away_row, home_row, away, home, league, width):
    """One block per stat group: away value and rank, the stat, home rank and
    value, the better side lit in its colour and big gaps flagged."""
    totals = {key: len(r) for key, r in ranks.items()}
    blocks = []
    counts = {"away": 0, "home": 0, "big_away": 0, "big_home": 0}
    longest = max([len(s["label"]) for s in table.get("stats") or []] + [12])
    label_width = clamp(min(longest, width - 30), 16, 34)
    for group in stat_groups(table):
        block = [Line().add("── ", "border").add(f"{group} ", "title")
                 .add("─" * (label_width + 22 - len(group)), "border")]
        for stat in [s for s in table["stats"] if s["group"] == group]:
            av, hv = away_row["values"].get(stat["key"]), home_row["values"].get(stat["key"])
            ar = ranks.get(stat["key"], {}).get(away_row["id"])
            hr = ranks.get(stat["key"], {}).get(home_row["id"])
            total = totals.get(stat["key"], 0)
            ap, hp = _percentile(ar, total), _percentile(hr, total)
            better = None
            if ap is not None and hp is not None and ar != hr:
                better = "away" if ar < hr else "home"
            big = better and abs(ap - hp) >= EDGE + 0.1
            if better:
                counts[better] += 1
                if big:
                    counts["big_" + better] += 1
            a_style = THEME.style(league, away, bold=True, fallback="bold") \
                if better == "away" else "dim"
            h_style = THEME.style(league, home, bold=True, fallback="bold") \
                if better == "home" else "dim"
            row = Line()
            row.add("◀" if big and better == "away" else " ", "upset")
            decimal = any(v is not None and abs(v - round(v)) > 1e-9 for v in (av, hv))
            row.add(f"{stat_text(stat, av, decimal):>7}", a_style)
            row.add(f"{('#' + str(ar)) if ar else '':>5} ", "muted")
            label = stat["label"]
            if len(label) > label_width:
                label = stat["short"] + " " + label[: label_width - len(stat["short"]) - 2]
            row.add(f"{label[:label_width]:^{label_width}}", "normal")
            row.add(f" {('#' + str(hr)) if hr else '':<5}", "muted")
            row.add(f"{stat_text(stat, hv, decimal):<7}", h_style)
            row.add("▶" if big and better == "home" else " ", "upset")
            block.append(row)
        blocks.append(block)
    return blocks, counts


def injury_order(status):
    low = (status or "").lower()
    for rank, word in enumerate(("out", "injured reserve", "ir", "doubtful",
                                 "questionable", "day-to-day", "probable", "suspension")):
        if word in low:
            return rank
    return 9


def roster_injuries(roster):
    """[(status, name, position)] from an ESPN team roster."""
    out = []
    groups = (roster or {}).get("athletes") or []
    for group in groups:
        items = group.get("items") if isinstance(group, dict) and "items" in group else [group]
        for athlete in items or []:
            for injury in athlete.get("injuries") or []:
                status = clean(injury.get("status") or dig(injury, "type", "description",
                                                           default="") or "")
                out.append((status, clean(athlete.get("shortName")
                                          or athlete.get("displayName") or ""),
                            clean(dig(athlete, "position", "abbreviation", default=""))))
                break
    out.sort(key=lambda row: (injury_order(row[0]), row[1]))
    return out


