def football_panel(summary, event, league, width, height):
    """SCORING SUMMARY: every score in order - quarter, clock, team, kind, the
    play, and the score after it."""
    plays = dig(summary, "scoringPlays", default=[]) or []
    if not plays:
        return []
    lines = [Line().add("SCORING SUMMARY", "title")]
    text_w = max(20, width - 34)
    for play in plays[-(height - 1):]:
        side = side_of(event, dig(play, "team", "id"))
        team = event[side] if side else {}
        number = dig(play, "period", "number", default=0) or 0
        quarter = f"Q{number}" if number <= 4 else ("OT" if number == 5 else f"{number - 4}OT")
        kind = clean(dig(play, "type", "abbreviation", default="")
                     or dig(play, "type", "text", default=""))[:4]
        line = Line().add(f"{quarter:<4}{clean(dig(play, 'clock', 'displayValue', default='')):>6}  ",
                          "dim")
        line.add(f"{team.get('abbr', ''):<5}", THEME.style(league, team, bold=True)
                 if team else "normal")
        line.add(f"{kind:<5}", "accent")
        text = clean(play.get("text") or "")
        line.add(f"{text[:text_w]:<{text_w}}", "normal")
        a, h = play.get("awayScore"), play.get("homeScore")
        if isinstance(a, int) and isinstance(h, int):
            line.add(f"  {a}-{h}", "bold")
        lines.append(line)
    return lines


def baseball_panel(summary, event, league, width, height):
    """The decisions (winning, losing and saving pitchers) and every scoring
    play, inning by inning."""
    lines = []
    status = dig(summary, "header", "competitions", 0, "status", default={}) or {}
    decisions = Line()
    for item in status.get("featuredAthletes") or []:
        tag = {"winningPitcher": "W", "losingPitcher": "L", "savingPitcher": "S"}.get(
            item.get("name"))
        if not tag:
            continue
        who = clean(dig(item, "athlete", "shortName", default="")
                    or dig(item, "athlete", "displayName", default=""))
        record = clean(str(dig(item, "athlete", "record", default="") or ""))
        if tag == "S":
            saves = clean(str(dig(item, "athlete", "saves", default="") or ""))
            record = f"{saves} sv" if saves else record
        if decisions:
            decisions.add("   ", "normal")
        decisions.add(f"{tag} ", "good" if tag == "W" else "bad" if tag == "L" else "accent")
        decisions.add(who, "bold")
        if record:
            decisions.add(f" ({record})", "dim")
    if decisions:
        lines.append(Line().add("DECISIONS  ", "title").extend_spans(decisions))
        lines.append(blank())
    scoring = [p for p in dig(summary, "plays", default=[]) or [] if p.get("scoringPlay")]
    if scoring:
        lines.append(Line().add("SCORING PLAYS", "title"))
        text_w = max(20, width - 22)
        for play in scoring[-(max(1, height - len(lines))):]:
            number = dig(play, "period", "number", default=0) or 0
            half = "B" if str(dig(play, "period", "type", default="")).lower().startswith(
                "bot") else "T"
            side = side_of(event, dig(play, "team", "id")) or (
                "home" if half == "B" else "away")
            team = event[side]
            line = Line().add(f"{half}{number:<3}", "dim")
            line.add(f"{team.get('abbr', ''):<5}", THEME.style(league, team, bold=True))
            text = clean(play.get("text") or "")
            line.add(f"{text[:text_w]:<{text_w}}", "normal")
            a, h = play.get("awayScore"), play.get("homeScore")
            if isinstance(a, int) and isinstance(h, int):
                line.add(f"  {a}-{h}", "bold")
            lines.append(line)
    return lines[:height]


def hockey_timeline(summary, event, league, width):
    """The game on one line, period by period, every goal (●) above it for
    the away team and below it for the home team."""
    marks = []
    last_period = 3
    for play in dig(summary, "plays", default=[]) or []:
        if not play.get("scoringPlay"):
            continue
        side = side_of(event, dig(play, "team", "id"))
        number = dig(play, "period", "number", default=0) or 0
        clock = clean(dig(play, "clock", "displayValue", default="") or "")
        match = re.match(r"(\d+):(\d+)", clock)
        if not side or not number or not match or number > 4:
            continue
        minute = (number - 1) * 20 + int(match.group(1)) + int(match.group(2)) / 60
        marks.append((minute, side))
        last_period = max(last_period, number)
    if not marks:
        return []
    end = 60 if last_period <= 3 else 65
    cols = max(30, width - 6)

    def col(minute):
        return int(min(minute, end) / end * (cols - 1))

    rows = {"away": [" "] * cols, "home": [" "] * cols}
    for minute, side in marks:
        rows[side][col(minute)] = "●"
    out = []
    for side in ("away", "home"):
        team = event[side]
        line = Line().add(f"{team.get('abbr', '')[:3]:<4}", THEME.style(league, team,
                                                                        bold=True))
        line.add("".join(rows[side]), THEME.style(league, team, bold=True, fallback="accent"))
        out.append(merge_spans(line))
        if side == "away":
            axis = ["─"] * cols
            for period in range(0, end + 1, 20):
                axis[min(cols - 1, col(period))] = "┼" if 0 < period < end else "│"
            if end == 65:
                axis[min(cols - 1, col(60))] = "┼"
                axis[cols - 1] = "│"
            out.append(Line().add("    ", "normal").add("".join(axis), "border"))
    labels = [" "] * (cols + 4)
    names = [("1ST", 10), ("2ND", 30), ("3RD", 50)] + ([("OT", 62.5)] if end == 65 else [])
    for tag, minute in names:
        start = 4 + col(minute) - len(tag) // 2
        for index, ch in enumerate(tag):
            if 0 <= start + index < len(labels):
                labels[start + index] = ch
    out.append(Line().add("".join(labels), "muted"))
    return out


def sport_panel(summary, event, league, width, height):
    """The sport's own picture for a game under way or over: [] when there is
    nothing to draw yet."""
    if not summary or event["state"] == "pre" or height < 6:
        return []
    sport = sport_of(league)
    try:
        if sport == "basketball":
            return basketball_panel(summary, event, league, width, height)
        if sport == "hockey":
            return hockey_panel(summary, event, league, width, height)
        if sport == "soccer":
            return soccer_panel(summary, event, league, width, height)
        if sport == "football" and event["state"] == "post":
            return football_panel(summary, event, league, width, height)
        if sport == "baseball" and event["state"] == "post":
            return baseball_panel(summary, event, league, width, height)
    except (KeyError, TypeError, ValueError, ZeroDivisionError):
        return []
    return []


# -- the Olympic events Wikipedia covers: the podium --------------------------

MEDAL_HEX = {"gold": "FFD24A", "silver": "C9CED6", "bronze": "D9925B"}


def event_medallists(event, page):
    """{'gold': [(who, code)], ...} from the event page's medal box, else the
    sport page's medal table."""
    podium = wiki_podium(page) if page else []
    if podium:
        medals = {}
        for medal, who, code in podium:
            medals.setdefault(medal, []).append((who, code))
        return medals
    return event.get("medals") or {}


def compose_event_center(event, page, league, width, height, favorites=None,
                         context="", loading=False):
    """The Event Center for an Olympic sport Wikipedia covers: the event's
    name, the podium in medal colours with each medallist and nation, the
    final's table and the event's facts."""
    canvas = Canvas(width, height)
    mode = "big" if width >= 110 and height >= 30 else "small"
    head = Line().add(" ★ EVENT CENTER ", "tabsel").add(f"  {context}", "accent")
    canvas.line(0, 0, head)
    facts = wiki_infobox_facts(page) if page else []
    when = next((value for label, value in facts if label.lower() in ("dates", "date")), "")
    parts = re.split(r"\s*/\s*", re.sub(r"\s*\([^)]*\)", "", when))
    when = " – ".join(p.strip() for p in parts if p.strip())
    if len(when) > width - len(head.text) - 3:
        when = ""
    if when:
        canvas.put(0, max(len(head.text) + 2, width - len(when) - 1), when[: width - 2], "dim")
    name = event["name"].upper()
    canvas.fill(2, 1, width - 2, 1, " ", "@111111:FFD24A")
    canvas.put(2, max(1, (width - len(name)) // 2), name[: width - 2], "@111111:FFD24A~b")
    medals = event_medallists(event, page)
    y = 4
    if medals:
        block_w = clamp(width // 4, 16, 30)
        heights = {"gold": 6 if mode == "big" else 4, "silver": 4 if mode == "big" else 3,
                   "bronze": 3 if mode == "big" else 2}
        names_h = 4
        base = y + names_h + heights["gold"]
        centre = width // 2
        slots = {"silver": centre - block_w - block_w // 2, "gold": centre - block_w // 2,
                 "bronze": centre + block_w // 2}
        for medal, number in (("gold", "1"), ("silver", "2"), ("bronze", "3")):
            x = slots[medal]
            h = heights[medal]
            color = MEDAL_HEX[medal]
            canvas.fill(base - h, x, block_w, h, " ", f"@111111:{color}")
            digits = big_text(number, "small")
            for index, row in enumerate(digits[:h]):
                canvas.put(base - h + index, x + (block_w - len(row)) // 2, row,
                           f"@111111:{color}~b")
            people = medals.get(medal) or []
            top = base - h - 1
            def fit(text):
                return text if len(text) <= block_w else text[: block_w - 1] + "…"
            for who, code in reversed(people[:2]):
                nation = NOCS.get(code, (code,))[0] if code else ""
                star = STAR + " " if code and fav_rank(favorites or {}, league,
                                                       {"abbr": code}) >= 0 else ""
                label = fit(f"{star}{code}  {nation}".strip()) if code else ""
                if label:
                    canvas.put(top, x + max(0, (block_w - len(label)) // 2), label,
                               THEME.style(league, {"abbr": code}, bold=True,
                                           fallback="accent"))
                    top -= 1
                # a team's medal names the nation; a person's, the person too
                team = "/" in (who or "") or "," in (who or "")
                text = fit(who or "") if who and not team else ""
                if text and text != nation:
                    canvas.put(top, x + max(0, (block_w - len(text)) // 2), text, "bold")
                    top -= 1
            if not people:
                canvas.put(base - h - 1, x + (block_w - 3) // 2, "-", "dim")
        y = base + 2
    else:
        word = "LOADING THE EVENT…" if loading else "NOT DECIDED YET"
        for index, row in enumerate([(" ".join(word), "bold")]):
            canvas.put(y + 2 + index, max(0, (width - len(row[0])) // 2), row[0], row[1])
        y += 5
    # under the podium: the final's table, the event's facts beside it
    rest = height - y
    if rest >= 4:
        facts_w = 38 if width >= 110 and facts else 0
        table_w = width - 4 - (facts_w + 3 if facts_w else 0)
        final = final_table(page) if page else None
        if final:
            title, table = final
            lines = [Line().add(title[: table_w], "title")]
            lines.extend(render_wiki_table(table, table_w, league, favorites,
                                           limit=max(3, rest - 2)))
            canvas.lines(y, 2, lines, table_w, rest)
        elif page and page.get("missing"):
            canvas.put(y, 2, "Wikipedia has no page for this event yet.", "dim")
        elif loading:
            canvas.put(y, 2, "Loading the event page…", "dim")
        if facts_w:
            fact_lines = [Line().add("THE EVENT", "title")]
            for label, value in facts:
                for index, chunk in enumerate(textwrap.wrap(value, facts_w - 13) or [""]):
                    fact_lines.append(Line().add(f"{label if not index else '':<13}",
                                                 "muted").add(chunk, "normal"))
            canvas.lines(y, width - facts_w - 1, fact_lines, facts_w, rest)
        elif facts and not final:
            fact_lines = [Line().add(f"{label:<13}", "muted").add(value[: width - 18],
                                                                  "normal")
                          for label, value in facts]
            canvas.lines(y, 2, fact_lines, width - 4, rest)
    return canvas.rows()


def compose_center(event, summary, league, width, height, now=None, flash=None,
                   favorites=None, context="", art=None):
    """The whole Game Center as [Line], `height` rows of `width` columns.
    `art(side, cols, rows)`, when given, is each team's badge or logo, set
    beside its score when the screen is big enough."""
    now = now or time.time()
    canvas = Canvas(width, height)
    away, home = event["away"], event["home"]
    mode = "big" if width >= 120 and height >= 34 else "small"
    # header: what this is, the game state, where to watch
    head = Line().add(" ★ GAME CENTER ", "tabsel").add(f"  {context}", "accent")
    canvas.line(0, 0, head)
    right = event.get("long_detail") or status_text(event)
    if event.get("broadcast"):
        right += f"  ·  {event['broadcast']}"
    canvas.put(0, max(len(head.text) + 2, width - len(right) - 1), right[: width - 2],
               "live" if event["state"] == "in" else "dim")
    # the score band
    third = width // 3
    band_top = 2
    digits_h = 5 if mode == "big" else 3
    for side, x0, align in (("away", 0, "left"), ("home", width - third, "right")):
        team = event[side]
        color = team_hex(league, team)
        ink = _ink_on(color)
        name = (team.get("name") or team.get("abbr") or "").upper()
        rank = f"#{team['rank']} " if league in RANKED_LEAGUES and team.get("rank") else ""
        star = f"{STAR} " if favorites and fav_rank(favorites, league, team) >= 0 else ""
        label = f" {star}{rank}{name} "
        canvas.fill(band_top, x0 + 1, third - 2, 1, " ", f"@{ink}:{color}")
        canvas.put(band_top, x0 + 1 + max(0, (third - 2 - len(label)) // 2),
                   label[: third - 2], f"@{ink}:{color}~b")
        record = team.get("record") or ""
        if side == "home" and event.get("neutral"):
            record += "  neutral site"
        score = team.get("score")
        style = THEME.style(league, team, bold=True)
        if event["state"] == "pre":
            # no score yet: the records, scoreboard-style
            shown = re.sub(r"[^0-9-]", "", record.split(",")[0].split("  ")[0])
            digits = big_text(shown, mode) if shown and len(shown) <= 8 else []
            style = THEME.style(league, team)
            record = "RECORD" if digits else record
        else:
            digits = big_text("" if score is None else str(score), mode)
        if event["state"] == "post" and not team.get("winner") and score is not None:
            style = "dim"
        if flash and flash[0] == side and int(now * 4) % 2 == 0:
            style = "live"
        logo = []
        if digits and art and mode == "big":
            room = third - len(digits[0]) - 6      # two-column gaps either side
            if room >= 12:
                logo = [line for line in (art(side, room, digits_h + 2) or [])]
        mid_x = x0 + third // 2
        if digits:
            dw = len(digits[0])
            dx = x0 + (third - dw) // 2
            if logo:
                # the badge or logo on the outer side, the score inside it
                lw = max(len(line.text) for line in logo)
                gap = max(2, (third - 2 - lw - dw) // 3)
                if side == "away":
                    lx, dx = x0 + 1 + gap, x0 + 1 + gap + lw + gap
                else:
                    dx = x0 + third - 1 - gap - lw - gap - dw
                    lx = dx + dw + gap
                ly = band_top + 1 + max(0, (digits_h + 2 - len(logo)) // 2)
                canvas.lines(ly, lx, logo, lw)
                mid_x = dx + dw // 2
            for index, row in enumerate(digits):
                canvas.put(band_top + 2 + index, dx, row, style)
        under = band_top + 2 + digits_h + 1
        record_x = mid_x - len(record) // 2 if logo else x0 + (third - len(record)) // 2
        canvas.put(under, max(x0 + 1, record_x), record[: third - 2], "dim")
    # the middle: clock and period, the final, or the countdown
    mid = third
    middle = []
    if event["state"] == "in":
        clock = (event.get("clock") or "").strip()
        sport = sport_of(league)
        detail = event.get("detail") or ""
        if sport == "baseball":
            # the inning in big digits, the half under it
            match = re.search(r"(\d+)", detail)
            if match:
                middle = [(row, "live") for row in big_text(match.group(1), mode)]
            middle.append(("", "normal"))
            middle.append((detail.upper(), "bold"))
        elif sport == "soccer":
            minute = re.match(r"(\d{1,3})'?(?:\+(\d{1,2}))?", clock or detail or "")
            if minute:
                shown = minute.group(1) + (f"+{minute.group(2)}" if minute.group(2) else "")
                middle = [(row, "live") for row in big_text(shown + "'", mode)]
            middle.append(("", "normal"))
            middle.append(((detail or "").upper(), "bold"))
        else:
            period = short_clock(event).replace(clock, "").strip() if clock else detail
            if clock and re.fullmatch(r"\d{1,2}(:\d{2})?(\.\d)?", clock):
                shown = clock if ":" in clock else clock
                middle = [(row, "live") for row in big_text(shown, mode)]
            middle.append(("", "normal"))
            middle.append((period.upper(), "bold"))
    elif event["state"] == "post":
        word = (event.get("detail") or "Final").upper()
        middle = [("", "normal"), (" ".join(word), "bold"), ("", "normal"),
                  (event_when(event), "dim")]
    else:
        value, unit = countdown_text(event, now, league)
        if value:
            middle = [(row, "accent") for row in big_text(value, mode)]
            middle.append((unit, "dim"))
        middle.append((event_when(event, with_zone=True), "bold"))
    for index, (text, style) in enumerate(middle):
        canvas.put(band_top + 1 + index, mid + max(0, (third - len(text)) // 2),
                   text[: third], style)
    y = band_top + 2 + digits_h + 3     # banner, gap, digits, gap, record, gap
    # a score flashes across the screen
    if flash and now < flash[2]:
        team = event[flash[0]]
        color = team_hex(league, team)
        ink = _ink_on(color)
        text = f"{STAR}  {'  '.join(flash[1])}  ·  {team.get('abbr', '')}  {STAR}"
        bg, fg = (color, ink) if int(now * 3) % 2 == 0 else (ESPN_GOLD.lstrip("#"), "111111")
        canvas.fill(y, 0, width, 1, " ", f"@{fg}:{bg}")
        canvas.put(y, max(0, (width - len(text)) // 2), text[:width], f"@{fg}:{bg}~b")
        y += 2
    # the situation
    sport = sport_of(league)
    if event["state"] == "in" and sport == "football" and height - y > 16:
        # between plays ESPN sometimes drops who has the ball; the drive knows
        driving = str(dig(summary, "drives", "current", "team", "id", default="") or "")
        hint = "away" if driving and driving == str(away.get("id")) else \
            "home" if driving and driving == str(home.get("id")) else ""
        field = render_field(event, league, min(width - 2, 132), hint)
        canvas.lines(y, max(1, (width - min(width - 2, 132)) // 2), field)
        y += len(field) + 1
    elif event["state"] == "in" and sport == "baseball" and height - y > 14:
        diamond = center_diamond(event, league, min(width - 4, 84))
        canvas.lines(y, max(2, (width - 84) // 2), diamond, width - 2)
        y += len(diamond) + 1
    elif summary and height - y > 14 and (
            (sport in ("basketball", "hockey", "soccer") and event["state"] != "pre")
            or (sport in ("football", "baseball") and event["state"] == "post")):
        # the court with each side's shots, the rink with every shot on goal,
        # the match timeline - and the numbers a broadcast puts beside them
        panel = sport_panel(summary, event, league, width - 4, clamp(height - y - 9, 6, 18))
        if panel:
            canvas.lines(y, 2, panel, width - 4)
            y += len(panel) + 1
    elif event["state"] == "in" and not dig(summary, "plays", default=None):
        last = clean(dig(event.get("situation") or {}, "lastPlay", "text", default=""))
        if last:
            for line in wrap_spans("Last: " + last, width - 4, "dim")[:2]:
                canvas.line(y, 2, line)
                y += 1
            y += 1
    # win probability
    if summary and height - y > 10:
        win = render_winbar(summary, event, league, min(width - 4, 140))
        if win:
            canvas.lines(y, 2, win)
            y += len(win) + 1
    # below: line score and team stats | plays (or the matchup before it starts)
    rest = height - y
    if rest < 3:
        return canvas.rows()
    left_w = width // 2 - 2
    right_w = width - left_w - 6
    left = []
    linescore = render_linescore(event, league)
    if sport == "soccer" and not (away.get("linescores") or home.get("linescores")):
        linescore = []          # ESPN keeps no half-by-half score for these
    if linescore:
        left.extend(linescore)
        left.append(blank())
    if summary and event["state"] != "pre":
        graph, _ = team_stat_sections(summary, league, left_w)
        left.extend(graph[: max(0, rest - len(left))])
    elif event["state"] == "pre":
        left.extend(center_pregame(event, summary, league, left_w))
    right = []
    if summary and event["state"] != "pre":
        right = recent_plays(summary, event, league, right_w, count=max(4, rest // 2))
        if event["state"] == "post" and not right:
            right = render_game_leaders(summary, league, right_w)
    elif summary:
        leaders = render_leaders(league, [away, home], right_w) if \
            (away.get("leaders") or home.get("leaders")) else []
        if leaders:
            right = [Line().add("SEASON LEADERS", "title")] + leaders
    canvas.lines(y, 2, left, left_w, rest)
    canvas.lines(y, left_w + 5, right, right_w, rest)
    return canvas.rows()


def today_sections(slate, favorites):
    """[(heading, [(league, event)])] for the Overview's Today list: live now,
    coming up, final - your teams first in each, then the leagues in order."""
    live, coming, done = [], [], []
    for league in SLATE_LEAGUES:
        for event in slate.get(league) or []:
            {"in": live, "pre": coming}.get(event["state"], done).append((league, event))

    def mine(item):
        return 0 if slate_is_fav(item[1], item[0], favorites) else 1

    def margin(item):
        event = item[1]
        return abs((event["away"]["score"] or 0) - (event["home"]["score"] or 0))
    live.sort(key=lambda it: (mine(it), SLATE_LEAGUES.index(it[0]), margin(it)))
    coming.sort(key=lambda it: (mine(it), it[1].get("date") or "",
                                SLATE_LEAGUES.index(it[0])))
    done.sort(key=lambda it: (mine(it), SLATE_LEAGUES.index(it[0]),
                              it[1].get("date") or ""))
    return [("LIVE NOW", live), ("COMING UP", coming), ("FINAL", done)]


def today_line(league, event, favorites, width, chosen=False):
    """One game on the Today list, `width` columns: star, league, time or
    clock, the two teams (and scores), the network."""
    line = Line()
    fav = slate_is_fav(event, league, favorites)
    line.add("▌" if chosen else " ", "selbar" if chosen else "normal")
    line.add(STAR if fav else " ", "seldim" if chosen else "star")
    line.add(f" {LEAGUE_SHORT.get(league, league.upper()):<6}", "seldim" if chosen else "muted")
    state = event["state"]
    clock = short_clock(event)
    if state == "pre":
        line.add(f"{clock:>6}  ", "sel" if chosen else "accent")
    college = league in RANKED_LEAGUES
    for index, side in enumerate(("away", "home")):
        team = event[side]
        name = team.get("abbr") or "?"
        if college and team.get("rank"):
            name = f"{team['rank']} {name}"
        if index:
            line.add(" @ " if state == "pre" else "  ", "seldim" if chosen else "muted")
        loser = state == "post" and not team.get("winner")
        line.add(name, THEME.style(league, team, selected=chosen, bold=not loser, dim=loser))
        if team["score"] is not None and state != "pre":
            line.add(f" {team['score']}", "sel" if chosen else "dim" if loser else "bold")
    if state != "pre":
        line.add(f"  {clock}", "sel" if chosen else "live" if state == "in" else "dim")
    tv = (event.get("broadcast") or "").split(",")[0].strip()
    used = sum(len(t) for t, _ in line)
    if tv and used + len(tv) + 3 <= width:
        line.add(" " * max(2, width - used - len(tv)), "sel" if chosen else "normal")
        line.add(tv, "seldim" if chosen else "dim")
    used = sum(len(t) for t, _ in line)
    if used > width:
        trimmed, room = Line(), width
        for text, style in line:
            if room <= 0:
                break
            trimmed.append((text[:room], style))
            room -= len(text)
        line = trimmed
    elif chosen and used < width:
        line.append((" " * (width - used), "sel"))
    return line


def overview_entries(favorites):
    """[(league, team)] for every favourite outside the Olympics, in the
    usual league order."""
    out = []
    for fam in LEAGUE_ORDER:
        if fam in ("owg", "osg"):
            continue
        for team in favorites.get(fam) or []:
            if team.get("id"):
                out.append((fam, team))
    return out


def overview_line_map(entries, which):
    """(team index, side) for each line render_overview_rows draws, None for
    the league headings and the blank lines between them."""
    out, previous = [], None
    for index, (league, _) in enumerate(entries):
        if league != previous:
            if out:
                out.append(None)
            out.append(None)
            previous = league
        if which == "both":
            out.extend([(index, "last"), (index, "next")])
        else:
            out.append((index, which))
    return out


def render_overview_rows(app, entries, glances, width, which, logo_gap=0, spots=None):
    """Favourites grouped under league headings: each team's latest result
    ('last'), its next game ('next'), or both, the next game on a second
    line underneath ('both', for a narrow screen). `logo_gap` leaves that
    many columns after the cursor bar for a logo, and `spots` (a dict) learns
    which line holds which (league, team)."""
    lines, cursor_line = [], 0
    name_width = clamp(max([len(t.get("name") or t.get("abbr") or "")
                            for _, t in entries] + [8]) + 1, 10, 26)
    previous = None

    rest = max(20, width - 3 - logo_gap - name_width)   # what is left beside the name

    def describe(glance, result, league, kind, chosen):
        base = "sel" if chosen else "normal"
        out = Line()
        if glance is None:
            text = "loading…" if result is None or result.loading else \
                f"unavailable: {result.error}" if result.error else "-"
            return out.add(text, "seldim" if chosen else "dim")
        if kind == "last":
            game = glance.get("last")
            if not game:
                return out.add("no results yet", "seldim" if chosen else "dim")
            mark = game["result"] or "-"
            style = "good" if mark.startswith("W") else "bad" if mark.startswith("L") \
                else "accent"
            out.add(f"{mark:<5}", "sel" if chosen else style)
            score = f"{game['us']}-{game['them']}" if game.get("us") is not None else ""
            out.add(f"{score:<8}", base if chosen else "bold")
            when = glance_when(game, with_time=False)
            opp_w = clamp(rest - 13 - len(when) - 1, 6, 23)
            out.add(f"{glance_opponent(game, league)[:opp_w - 1]:<{opp_w}}", base)
            return out.add(when, "seldim" if chosen else "dim")
        live = glance.get("live")
        game = live or glance.get("next")
        if not game:
            return out.add("nothing scheduled", "seldim" if chosen else "dim")
        if live:
            out.add("LIVE ", "sel" if chosen else "live")
            score = f"{live['us']}-{live['them']}" if live.get("us") is not None else ""
            out.add(f"{score:<8}", base if chosen else "bold")
            opp_w = clamp(rest - 13 - 12, 6, 23)
            out.add(f"{glance_opponent(live, league)[:opp_w - 1]:<{opp_w}}", base)
            return out.add(live.get("detail") or "", "seldim" if chosen else "accent")
        when = glance_when(game)
        opp_w = clamp(rest - max(17, len(when) + 1) - (6 if game.get("tv") else 0), 6, 25)
        out.add(f"{glance_opponent(game, league)[:opp_w - 1]:<{opp_w}}", base)
        out.add(f"{when:<17}", base if chosen else "accent")
        if game.get("tv"):
            out.add(game["tv"][:10], "seldim" if chosen else "dim")
        return out

    def finish(line, chosen):
        used = sum(len(t) for t, _ in line)
        if used > width:
            trimmed, room = Line(), width
            for text, style in line:
                if room <= 0:
                    break
                trimmed.append((text[:room], style))
                room -= len(text)
            line = trimmed
        elif chosen and used < width:
            line.append((" " * (width - used), "sel"))
        return line

    for index, (league, team) in enumerate(entries):
        if league != previous:
            if lines:
                lines.append(blank())
            lines.append(Line().add(f" {LEAGUE_SHORT.get(league, league)}", "header"))
            previous = league
        row_chosen = index == app.overview_cursor
        side = getattr(app, "overview_side", "next")
        if row_chosen:
            cursor_line = len(lines)
        result = glances.get((league, team["id"]))
        glance = result.data if result else None
        shown = dict(team)
        if glance and glance.get("color") and not shown.get("color"):
            shown["color"] = glance["color"]
        first = "last" if which == "both" else which
        # the highlight sits on the game enter will open: the result or the
        # next game; the team's other game keeps a faint marker
        chosen = row_chosen and side == first
        line = Line().add("▌" if row_chosen else " ",
                          "selbar" if chosen else "muted" if row_chosen else "normal")
        if logo_gap:
            line.add(" " * logo_gap, "sel" if chosen else "normal")
            if spots is not None:
                spots[len(lines)] = (league, shown)
        name = (team.get("name") or team.get("abbr") or "?")[:name_width - 1]
        line.add(STAR + " ", "seldim" if chosen else "star")
        line.add(f"{name:<{name_width}}", THEME.style(league, shown, selected=chosen,
                                                       bold=True, fallback="sel" if chosen
                                                       else "normal"))
        line.extend_spans(describe(glance, result, league, first, chosen))
        lines.append(finish(line, chosen))
        if which == "both":
            chosen = row_chosen and side == "next"
            second = Line().add("▌" if row_chosen else " ",
                                "selbar" if chosen else "muted" if row_chosen else "normal")
            second.add(" " * (2 + logo_gap) + f"{'next':>{name_width - 1}} ",
                       "seldim" if chosen else "muted")
            second.extend_spans(describe(glance, result, league, "next", chosen))
            lines.append(finish(second, chosen))
    return lines, cursor_line


