def info_sections(app):
    """What the Info pop-up shows for the screen in front of you."""
    tab = app.tab_name
    league = app.league
    center = getattr(app, "center", None)
    if getattr(app, "article", None):
        return info_article()
    if center:
        if center.get("wiki"):
            return [("Event Center", [row for row in INFO_GAME_CENTER
                                      if row[0] == "Event Center"]
                     + [("keys", "j / k the next / previous event; enter opens "
                                 "every round's results; esc, Q or Z closes")])]
        return [("Game Center", INFO_GAME_CENTER)]
    if tab == "Settings":
        return info_settings()
    if tab == "Overview":
        return info_overview()
    if tab == "Favorites":
        return info_favorites()
    if is_wiki_sport(league) or tab in ("Medals", "Events", "Results", "Medalists"):
        return info_olympic(tab)
    if tab == "Scoreboard":
        return info_scoreboard(league)
    if tab == "Scouting":
        return info_scouting(league)
    if tab in ("Boxscore", "Game Stats", "Plays"):
        event = app.current_event()
        summary = app.load_summary(event["id"]).data if event and league != "x" else None
        if tab == "Boxscore":
            return info_boxscore(summary, league)
        if tab == "Game Stats":
            return info_game_stats(league)
        return info_plays(league)
    if tab == "Standings":
        if app.standings_team and app.standings_team[0] == league:
            return info_schedule(league, "esc goes back to the standings")
        return info_standings(league)
    if tab == "Stats":
        if app.stats_team and app.stats_team[0] == league:
            if app.players_view == "game":
                return info_last_game(league) + info_players(league)
            if app.players_view == "schedule":
                return info_schedule(league)
            return info_players(league)
        return info_stats(league, app.load_team_table().data)
    if tab in ("Playoffs", "Medal Round"):
        if is_olympic(league):
            return info_playoffs(league)
        return info_playoffs(league) + [info_championship(league)]
    if tab == "Betting":
        return info_betting(league)
    if tab == "Favorites":
        return info_favorites()
    return [("This screen", [_p("Nothing to explain here yet.")])]


def info_lines(sections, width):
    """The pop-up's text: headings, then each term with its explanation
    wrapped beside it."""
    term_width = min(20, max([len(term) for _, entries in sections
                              for term, _ in entries if term] + [6]) + 2)
    lines = []
    for heading_text, entries in sections:
        if heading_text:
            if lines:
                lines.append(blank())
            lines.append(Line().add(heading_text, "title"))
        for term, text in entries:
            if term is None:
                lines.extend(wrap_spans(text, width - 2, "normal", indent="  "))
                continue
            text = text or "-"
            if len(term) > term_width - 1:
                lines.append(Line().add(f"  {term}", "accent"))
                lines.extend(wrap_spans(text, width - term_width - 2, "dim",
                                        indent=" " * (term_width + 2)))
                continue
            chunks = wrap_spans(text, width - term_width - 2, "dim")
            first = Line().add(f"  {term:<{term_width}}", "accent")
            if chunks:
                first.extend_spans(chunks[0])
            lines.append(first)
            for chunk in chunks[1:]:
                lines.append(Line().add(" " * (term_width + 2), "normal").extend_spans(chunk))
    return lines


