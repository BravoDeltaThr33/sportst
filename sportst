# a category's short name on a card (rush 9-25), by football_group's names
FOOTBALL_TAGS = {"passing": "pass", "rushing": "rush", "receiving": "rec",
                 "defensive": "def", "tackles": "def", "interceptions": "INT",
                 "fumbles": "fum", "kickreturns": "KR", "puntreturns": "PR",
                 "returning": "ret", "kicking": "kick", "fieldgoals": "FG", "pats": "XP",
                 "punting": "punt"}
# a category's number for a card's Last 10 bars: (label, what it is, summed or
# averaged over the games)
FOOTBALL_SPARK = {"passing": ("YDS", "passing yards", "sum"),
                  "rushing": ("YDS", "rushing yards", "sum"),
                  "receiving": ("YDS", "receiving yards", "sum"),
                  "defensive": ("TOT", "tackles", "sum"),
                  "tackles": ("TOT", "tackles", "sum"),
                  "interceptions": ("INT", "interceptions", "sum"),
                  "fieldgoals": ("PTS", "points", "sum"), "kicking": ("PTS", "points", "sum"),
                  "pats": ("PTS", "points", "sum"),
                  "punting": ("AVG", "yards a punt", "avg"),
                  "returning": ("YDS", "return yards", "sum")}


def football_group(name):
    """'kickReturns' -> 'kickreturns': a category's name as the tables above
    know it."""
    return re.sub(r"[^a-z]", "", str(name or "").lower())


def football_count(text):
    """A football number from its text ('1,750', '1.5', '-3'); 0 for none."""
    value = _number(str(text or "").replace(",", ""))
    return value if value is not None else 0.0


def football_made(text):
    """(made, tried) from '2/2' or '7-8'; (0, 0) for none."""
    found = re.match(r"^\s*(\d+)\s*[/-]\s*(\d+)", str(text or ""))
    return (int(found.group(1)), int(found.group(2))) if found else (0, 0)


def football_compact(group, stats):
    """A football player's numbers in one category, short, from a box score
    row or a game log (their labels differ): '15/20 211 yds 1 TD 1 INT',
    '9-25 1 TD' (carries-yards), '5-107' (catches-yards), '7 tkl 1 sk',
    'FG 2/2 XP 2/2', '4 punts 44.3 avg'. '' for nothing."""
    kind = football_group(group)
    s = {clean(str(key)).strip().upper(): clean(str(value)).strip()
         for key, value in (stats or {}).items()}

    def some(key):
        return s.get(key) not in (None, "", "0", "0.0", "0-0", "0/0", "--", "-")

    def td():
        return f" {s['TD']} TD" if some("TD") else ""
    if kind == "passing":
        tries = s.get("C/ATT") or (f"{s['CMP']}/{s['ATT']}" if s.get("CMP") and s.get("ATT")
                                   else "")
        text = " ".join(part for part in (tries, f"{s['YDS']} yds" if s.get("YDS") else "")
                        if part)
        return (text + td() + (f" {s['INT']} INT" if some("INT") else "")).strip()
    def tries(count):
        # '9-25' (nine for 25 yards); '10 for -25' when he lost ground
        yards = s.get("YDS") or "0"
        return f"{count} for {yards}" if yards.startswith("-") else f"{count}-{yards}"
    if kind == "rushing":
        return tries(s.get("CAR") or "0") + td() if some("CAR") or some("YDS") else ""
    if kind == "receiving":
        return tries(s.get("REC") or "0") + td() if some("REC") or some("YDS") else ""
    if kind in ("defensive", "tackles"):
        parts = [f"{s['TOT']} tkl" if some("TOT") else ""]
        for key, word in (("SACKS", "sk"), ("SACK", "sk"), ("TFL", "TFL"), ("PD", "PD"),
                          ("INT", "INT"), ("FF", "FF"), ("TD", "TD")):
            if some(key):
                parts.append(f"{s[key]} {word}")
        return " ".join(part for part in parts if part)
    if kind == "interceptions":
        return (f"{s.get('INT') or '0'} INT" + (f" {s['YDS']} yds" if some("YDS") else "")
                + td()) if some("INT") else ""
    if kind == "fumbles":
        # 'fum 1, 1 lost' for the ball carrier, 'fum 1 rec' or '1 forced' for
        # the defense
        return ", ".join(f"{s[key]}{word}" for key, word in
                         (("FUM", ""), ("LOST", " lost"), ("REC", " rec"), ("FF", " forced"),
                          ("FR", " rec")) if some(key))
    if kind in ("kickreturns", "puntreturns", "returning"):
        return tries(s.get("NO") or "0") + td() if some("NO") else ""
    if kind in ("kicking", "fieldgoals", "pats"):
        parts = [f"FG {s['FG']}" if some("FG") and re.search(r"[/-]", s["FG"]) else "",
                 f"XP {s['XP']}" if some("XP") else ""]
        return " ".join(part for part in parts if part)
    if kind == "punting":
        count = s.get("NO") or s.get("PUNTS") or ""
        return f"{count} punts {s['AVG']} avg" if count not in ("", "0") and s.get("AVG") \
            else ""
    return ""


def football_points(lines):
    """A football player's fantasy points (half-point PPR, with the usual
    defensive and kicking points) from his box score rows [(category,
    {label: value})] - the Boxscore's and Game Stats' measure of who had the
    best game."""
    total, defense_td, pick_td = 0.0, 0.0, 0.0
    for group, stats in lines or []:
        kind = football_group(group)
        s = {clean(str(key)).strip().upper(): value for key, value in (stats or {}).items()}

        def n(key):
            return football_count(s.get(key))
        if kind == "passing":
            total += n("YDS") / 25 + 4 * n("TD") - 2 * n("INT")
        elif kind == "rushing":
            total += n("YDS") / 10 + 6 * n("TD")
        elif kind == "receiving":
            total += 0.5 * n("REC") + n("YDS") / 10 + 6 * n("TD")
        elif kind == "fumbles":
            total -= 2 * n("LOST")
        elif kind == "defensive":
            solo = n("SOLO")
            total += solo + 0.5 * max(0.0, n("TOT") - solo) + 2 * n("SACKS") + n("TFL") + \
                n("PD")
            defense_td += n("TD")
        elif kind == "interceptions":
            total += 3 * n("INT")
            pick_td += n("TD")
        elif kind in ("kickreturns", "puntreturns"):
            total += n("YDS") / 25 + 6 * n("TD")
        elif kind == "kicking":
            total += 3 * football_made(s.get("FG"))[0] + football_made(s.get("XP"))[0]
    # a pick six is in both the defense's TDs and the interceptions'
    total += 6 * max(defense_td, pick_td)
    return round(total, 1)


def football_performers(refs):
    """[(fantasy points, index of his row)] best first, a player once however
    many tables he is in - at the row that earned him the most (a receiver's
    catches rather than his two carries)."""
    best = {}
    for index, ref in enumerate(refs or []):
        ident = ref.get("id") or ref.get("name")
        if not ident:
            continue
        own = football_points([(ref.get("group"), ref.get("stats") or {})])
        if ident not in best:
            lines = ref.get("lines") or [(ref.get("group"), ref.get("stats") or {})]
            best[ident] = [football_points(lines), index, own]
        elif own > best[ident][2]:
            best[ident][1:] = [index, own]
    ranked = [(value, index) for value, index, _ in best.values() if value > 0]
    ranked.sort(key=lambda item: (-item[0], item[1]))
    return ranked


def football_tonight_pairs(ref):
    """His line in this game: the row picked, label by label as its table has
    them, then his other tables short (rush 9-25 1 TD, def 2 tkl ...)."""
    pairs = [(label, value) for label, value in (ref.get("stats") or {}).items()
             if value not in (None, "")]
    mine = football_group(ref.get("group"))
    for group, stats in ref.get("lines") or []:
        kind = football_group(group)
        if kind == mine:
            continue
        text = football_compact(group, stats)
        if text:
            pairs.append((FOOTBALL_TAGS.get(kind, kind), text))
    return pairs


def football_stats(groups, labels, values):
    """{label: value} for a game-log row: a label in more than one category
    (YDS, TD) keeps the first category's value - his own (passing yards for
    a quarterback) - and within one the later (a kicker's FG 7-8 over 7)."""
    out = {}
    for _, start, count, _ in reversed(groups or [("", 0, len(labels), "")]):
        for label, value in zip(labels[start:start + count], values[start:start + count]):
            out[label] = value
    return out


def football_season_pairs(profile):
    """His season for a card: GP, his first category label by label (the
    longest gain left out), the others short."""
    groups, labels = profile.get("groups") or [], profile.get("labels") or []
    season = profile.get("season") or []
    if not season or not groups:
        return []
    games = profile.get("games") or []
    pairs = [("GP", str(len(games)))] if games else []
    for number, (_, start, count, kind) in enumerate(groups):
        part = {}
        for label, value in zip(labels[start:start + count], season[start:start + count]):
            part[label] = value
        if number == 0:
            pairs += [(label, value) for label, value in part.items()
                      if label not in ("LNG", "LONG") and value not in (None, "")]
        else:
            text = football_compact(kind, part)
            if text:
                pairs.append((FOOTBALL_TAGS.get(kind, kind), text))
    return pairs


def football_games_table(profile, width, rows):
    """His last games as a table under each category's name, newest first,
    as many categories as fit across `width`; at most `rows` lines."""
    games = (profile or {}).get("games") or []
    labels = (profile or {}).get("labels") or []
    groups = [(name, start, count) for name, start, count, _ in profile.get("groups") or []]
    heads = 2 if len(groups) > 1 else 1
    if not games or not labels or rows < heads + 1:
        return []
    table_rows = []
    for game in games[:rows - heads]:
        label = Line().add(game.get("date") or "", "muted")
        if game.get("opp"):
            label.add(" " + game["opp"], "normal")
        result = game.get("result") or ""
        if result:
            label.add(" " + result, "good" if result.startswith("W") else
                      "bad" if result.startswith("L") else "normal")
        table_rows.append((label, game.get("values") or []))
    label_w = min(24, max(len(label.text) for label, _ in table_rows) + 2)
    lines, _ = number_table(groups if len(groups) > 1 else [], labels, table_rows, width,
                            label_w, cut=True, first_bold=False)
    return [fit_line(line, width) for line in lines[:rows]]


