    "nbc": (["#FFD24D", "#FDB913", "#F7941D", "#E0457B", "#7B3FA0"],
            ["#FDB913", "#F7941D", "#00A3C4"], "#22163A"),
}


def logo_rows(text, gap=2):
    """The block letters for `text` as five strings."""
    rows = ["", "", "", "", ""]
    for index, char in enumerate(text):
        glyph = LOGO_FONT.get(char.upper(), LOGO_FONT[" "])
        for r in range(5):
            rows[r] += (" " * gap if index else "") + glyph[r]
    return rows


def render_logo_lines(width, room=99):
    """The SPORTS TERMINAL title: block letters in bands of colour, leaning
    forward, over a solid drop shadow, with racing stripes and a tagline
    underneath. `room` is how many rows it may take."""
    bands, stripes, shadow = LOGO_COLORS.get(CURRENT_SCHEME["name"], LOGO_COLORS["espn"])
    if room < 10:
        stripes = stripes[:max(0, room - 7)]
    elif room < 20:
        stripes = stripes[:1]
    blocks, scale = None, 1
    for px, gap in ((2, 2), (1, 2), (1, 1)):
        one_line = logo_rows("SPORTS TERMINAL", gap)
        if len(one_line[0]) * px + 6 <= width and room >= 7:
            blocks, scale = [one_line], px
            break
    if blocks is None:
        if len(logo_rows("TERMINAL")[0]) + 6 <= width and room >= 16:
            blocks = [logo_rows("SPORTS"), logo_rows("TERMINAL")]
        else:
            return [Line().add("SPORTS TERMINAL", "title"),
                    Line().add(f"scores · stats · lines · v{VERSION}", "dim"), blank()]
    lines = []
    dark = "@" + shadow.lstrip("#")
    for rows in blocks:
        lean = [1, 1, 1, 0, 0]
        grid = ["".join(ch * scale for ch in " " * lean[r] + row) + "  "
                for r, row in enumerate(rows)]
        span = max(len(g) for g in grid) + 1
        grid = [g.ljust(span) for g in grid] + [" " * span]
        left = max(0, (width - span) // 2)

        def filled(r, c):
            return 0 <= r < len(grid) and 0 <= c < len(grid[r]) and grid[r][c] == "█"

        for r in range(len(grid)):
            line = Line().add(" " * left, "normal")
            for c in range(span):
                if filled(r, c):
                    line.append(("█", "@" + bands[min(r, len(bands) - 1)].lstrip("#")))
                elif scale == 2 and filled(r - 1, c - 1):
                    line.append(("█", dark))          # half a pixel right, a row down
                elif scale == 1 and filled(r, c - 1):
                    line.append(("▌", dark))          # a slim edge on the right
                elif scale == 1 and filled(r - 1, c):
                    line.append(("▀", dark))          # and underneath
                else:
                    line.append((" ", "normal"))
            lines.append(_merge_spans(line))
    # racing stripes and the tagline
    stripe_width = min(width - 4, max(len(l.text.strip()) for l in lines) + 8)
    pad = max(0, (width - stripe_width) // 2)
    for colour in stripes:
        lines.append(Line().add(" " * pad, "normal").add("▀" * stripe_width,
                                                          "@" + colour.lstrip("#")))
    tag = f"S C O R E S   ·   S T A T S   ·   L I N E S   ·   v{VERSION}"
    if len(tag) > width - 2:
        tag = f"scores · stats · lines · v{VERSION}"
    lines.append(Line().add(" " * max(0, (width - len(tag)) // 2), "normal").add(tag, "accent"))
    return lines


def _merge_spans(line):
    """Join neighbouring cells of one style into one span."""
    out = Line()
    for text, style in line:
        if out and out[-1][1] == style:
            out[-1] = (out[-1][0] + text, style)
        else:
            out.append((text, style))
    return out


# the title as a real picture (Kitty, Ghostty): the same block letters,
# drawn at the terminal's own pixel size, span by span

def _spans_union(spans):
    """Overlapping or touching [x0, x1) spans merged, left to right."""
    out = []
    for x0, x1 in sorted(s for s in spans if s[1] > s[0]):
        if out and x0 <= out[-1][1]:
            out[-1] = (out[-1][0], max(out[-1][1], x1))
        else:
            out.append((x0, x1))
    return out


def _spans_minus(spans, holes):
    """The parts of `spans` outside `holes` (both merged)."""
    out = []
    for x0, x1 in spans:
        start = x0
        for h0, h1 in holes:
            if h1 <= start or h0 >= x1:
                continue
            if h0 > start:
                out.append((start, h0))
            start = max(start, h1)
            if start >= x1:
                break
        if start < x1:
            out.append((start, x1))
    return out


def _lerp_rgb(a, b, t):
    return tuple(round(a[i] + (b[i] - a[i]) * clamp(t, 0.0, 1.0)) for i in range(3))


def title_picture(scheme, width, height, text="SPORTS TERMINAL"):
    """The SPORTS TERMINAL title as a PNG of `width` x `height` pixels: the
    text title's block letters, leaning forward, in a chrome blend of the
    colour scheme's bands with a bright glint and a light rim, over a deep
    block shadow, with speed lines behind and racing stripes underneath."""
    bands, stripes, shadow = LOGO_COLORS.get(scheme, LOGO_COLORS["espn"])
    band = [hex_to_rgb(c) or (255, 255, 255) for c in bands]
    stripe_rgb = [hex_to_rgb(c) or (255, 255, 255) for c in stripes]
    shade = hex_to_rgb(shadow) or (40, 10, 10)
    rim = _lerp_rgb(band[0], (255, 255, 255), 0.65)
    glyphs = logo_rows(text, 1)
    cols = len(glyphs[0])
    width, height = max(40, int(width)), max(12, int(height))
    letters_h = int(height * (0.70 if stripes else 0.92))
    # the letters' pixel: twice as tall as wide, like the text title's cells
    sy = max(2, letters_h // 6)
    sx = max(1, min(sy // 2 + 1, int(width * 0.86) // (cols + 3)))
    rim_w = max(1, sy // 7)
    depth = max(2, sy // 3)
    lean = 0.28                                   # pixels right per pixel up
    tall = 5 * sy
    lean_max = int(tall * lean)
    letters_w = cols * sx + lean_max
    left = max(rim_w + 1, (width - letters_w - depth) // 2)
    top = max(rim_w + 1, (letters_h - tall - depth) // 2)
    bottom = top + tall
    runs = []
    for row in glyphs:
        spans, c = [], 0
        while c < len(row):
            if row[c] == "█":
                start = c
                while c < len(row) and row[c] == "█":
                    c += 1
                spans.append((start, c))
            else:
                c += 1
        runs.append(spans)

    def fill(y):
        if not top <= y < bottom:
            return []
        shift = int((bottom - y) * lean)
        return [(left + a * sx + shift, left + b * sx + shift) for a, b in runs[(y - top) // sy]]

    fills = [fill(y) for y in range(height)]

    def solid(y):
        """The letters with their rim, on row y."""
        out = []
        for dy in range(-rim_w, rim_w + 1):
            if 0 <= y + dy < height:
                out += [(a - rim_w, b + rim_w) for a, b in fills[y + dy]]
        return _spans_union(out)

    solids = [solid(y) for y in range(height)]
    clear = b"\x00\x00\x00\x00"
    image = []
    for y in range(height):
        row = bytearray(clear * width)

        def paint(x0, x1, rgb):
            x0, x1 = max(0, int(x0)), min(width, int(x1))
            if x1 > x0:
                row[x0 * 4:x1 * 4] = (bytes(rgb) + b"\xff") * (x1 - x0)

        # speed lines behind the first letter
        for index, (frac, length) in enumerate(((0.18, 0.13), (0.42, 0.20), (0.66, 0.16),
                                               (0.86, 0.09))):
            line_y = top + int(tall * frac)
            thick = max(1, sy // 3)
            if line_y <= y < line_y + thick:
                end = left + int((bottom - y) * lean) - rim_w * 3
                paint(end - int(width * length), end, band[min(index + 1, len(band) - 1)])
        # the block shadow: the rimmed letters pushed down and right
        behind = []
        for k in range(1, depth + 1):
            if y - k >= 0:
                behind += [(a + k, b + k) for a, b in solids[y - k]]
        for x0, x1 in _spans_minus(_spans_union(behind), solids[y]):
            paint(x0, x1, shade)
        for x0, x1 in _spans_minus(solids[y], fills[y]):
            paint(x0, x1, rim)
        if fills[y]:
            t = (y - top) / max(1, tall - 1)
            if t < 0.46:
                colour = _lerp_rgb(band[0], band[1], t / 0.46)
            elif t < 0.53:
                colour = _lerp_rgb(band[1], (255, 255, 255), 0.55)    # the glint
            else:
                colour = _lerp_rgb(band[2], band[-1], (t - 0.53) / 0.47)
            for x0, x1 in fills[y]:
                paint(x0, x1, colour)
        # racing stripes, slanted like the letters
        if stripes:
            stripe_h = max(2, (height - letters_h) // (len(stripes) * 2))
            first = letters_h + max(1, stripe_h // 2)
            for index, rgb in enumerate(stripe_rgb):
                y0 = first + index * stripe_h * 2
                if y0 <= y < y0 + stripe_h:
                    slant = int((height - y) * lean)
                    paint(left - lean_max // 2 + slant, left + letters_w + depth + slant, rgb)
        image.append(bytes(row))
    return png_encode(width, height, b"".join(image))


def _glance_game(event, team_id):
    """One schedule entry, from the team's side: who, when, where, score."""
    comp = (event.get("competitions") or [{}])[0]
    status = dig(comp, "status", "type", default={}) or dig(event, "status", "type",
                                                             default={}) or {}
    us, them = None, None
    for side in comp.get("competitors") or []:
        if str(dig(side, "team", "id", default="")) == str(team_id):
            us = side
        else:
            them = side
    if not us or not them:
        return None

    def score(side):
        value = side.get("score")
        if isinstance(value, dict):
            value = value.get("displayValue", value.get("value"))
        return _int(value) if value not in (None, "") else None

    state = status.get("state") or ("post" if status.get("completed") else "pre")
    mine, theirs = score(us), score(them)
    result = ""
    void = status.get("name") in ("STATUS_POSTPONED", "STATUS_CANCELED",
                                  "STATUS_SUSPENDED") or \
        (state == "post" and status.get("completed") is False)
    if state == "post" and not void:
        if us.get("winner") is True:
            result = "W"
        elif them.get("winner") is True:
            result = "L"
        elif mine is not None and theirs is not None:
            result = "W" if mine > theirs else "L" if mine < theirs else "T"
    rank = dig(them, "curatedRank", "current", default=None)
    tv = ""
    for cast in comp.get("broadcasts") or []:
        tv = clean(dig(cast, "media", "shortName", default="") or "")
        if tv:
            break
    return {"id": str(event.get("id") or comp.get("id") or ""),
            "date": event.get("date") or comp.get("date") or "",
            "state": state, "detail": clean(status.get("shortDetail") or
                                            status.get("detail") or ""),
            "home": us.get("homeAway") == "home",
            "neutral": bool(comp.get("neutralSite")),
            "opp": clean(dig(them, "team", "abbreviation", default="")
                         or dig(them, "team", "shortDisplayName", default="?")),
            "opp_name": clean(dig(them, "team", "shortDisplayName", default="")
                              or dig(them, "team", "displayName", default="")),
            "opp_rank": rank if isinstance(rank, int) and 0 < rank <= 25 else None,
            "opp_id": str(dig(them, "team", "id", default="") or ""),
            "opp_logo": str(dig(them, "team", "logos", 0, "href", default="") or
                            dig(them, "team", "logo", default="") or ""),
            "us": mine, "them": theirs, "result": result, "tv": tv,
            "time_tba": comp.get("timeValid") is False,
            "color": str(dig(us, "team", "color", default="") or ""),
            "tbd": bool(void)}


def espn_team_glance(league, team_id, timeout=15):
    """{'last', 'next', 'live'} for one team, any of which may be None."""
    meta = LEAGUES[league]
    base = (f"apis/site/v2/sports/{meta['sport']}/{meta['path']}/teams/"
            f"{urllib.parse.quote(str(team_id))}/schedule")
    year = Date.today().year
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M")
    glance = {"last": None, "next": None, "live": None, "color": ""}
    failures = 0
    for query in ["", "?seasontype=2", "?seasontype=3", "?seasontype=1",
                  f"?season={year}", f"?season={year - 1}"]:
        if glance["last"] and glance["next"]:
            break
        if query.startswith("?season=") and glance["last"]:
            break
        try:
            data = fetch_first((f"https://{SITE_HOSTS[0]}/{base}{query}",
                                [f"https://{SITE_HOSTS[1]}/{base}{query}"]), timeout)
        except Exception:  # noqa: BLE001 - the next season type may answer
            failures += 1
            if failures >= 3 and not (glance["last"] or glance["next"]):
                raise
            continue
        games = [g for g in (_glance_game(e, team_id) for e in data.get("events") or [])
                 if g and g["id"]]
        for game in games:
            glance["color"] = glance["color"] or game["color"]
            if game["state"] == "in":
                glance["live"] = game
            elif game["state"] == "post":
                if game.get("tbd"):
                    continue        # postponed or cancelled: not the last result
                if not glance["last"] or game["date"] > glance["last"]["date"]:
                    glance["last"] = game
            elif game["date"][:16] >= now[:13]:
                if not glance["next"] or game["date"] < glance["next"]["date"]:
                    glance["next"] = game
    return glance


def _ahl_game(g, team_id):
    """One HockeyTech schedule entry, from the team's side."""
    home = str(g.get("home_team")) == str(team_id)
    mine = _int(g.get("home_goal_count" if home else "visiting_goal_count"))
    theirs = _int(g.get("visiting_goal_count" if home else "home_goal_count"))
    final, started = str(g.get("final")) == "1", str(g.get("started")) == "1"
    tail = " SO" if g.get("shootout") == "1" else \
        " OT" if _int(g.get("overtime")) else ""
    game = {"id": str(g.get("game_id") or g.get("id")),
            "date": g.get("GameDateISO8601") or g.get("date_time_played") or "",
            "state": "post" if final else "in" if started else "pre",
            "detail": clean(g.get("game_status") or ""),
            "home": home, "neutral": False,
            "opp": clean(g.get("visiting_team_code" if home else "home_team_code")),
            "opp_name": clean(g.get("visiting_team_city" if home else "home_team_city")),
            "opp_id": str(g.get("visiting_team" if home else "home_team") or ""),
            "opp_rank": None, "us": mine, "them": theirs, "tv": "", "color": "",
            "result": (("W" if mine > theirs else "L" if mine < theirs else "T") + tail)
            if final else "", "tbd": False,
            "venue": clean(g.get("venue_name") or ""), "week": "", "kind": 2,
            "kind_name": "", "record": ""}
    try:
        stamp = datetime.fromisoformat(game["date"]).astimezone(timezone.utc)
        game["date"] = stamp.strftime("%Y-%m-%dT%H:%MZ")
    except ValueError:
        pass
    return game


def ahl_team_schedule(team_id, timeout=15):
    """The AHL team's whole season, oldest first, with its record after each
    game (wins, regulation losses, overtime losses, shootout losses)."""
    data = ht_get({"feed": "modulekit", "view": "schedule", "team_id": str(team_id)},
                  timeout)
    games = [_ahl_game(g, team_id) for g in dig(data, "SiteKit", "Schedule", default=[]) or []]
    games = [g for g in games if g["id"]]
    games.sort(key=lambda g: g["date"])
    tally = [0, 0, 0, 0]
    for game in games:
        if game["state"] != "post":
            continue
        result = game["result"]
        slot = 0 if result.startswith("W") else 3 if result.endswith("SO") else \
            2 if result.endswith("OT") else 1
        tally[slot] += 1
        game["record"] = "-".join(str(n) for n in tally)
    return {"games": games, "season": "", "standing": "", "record": ""}


def _season_game(event, team_id):
    game = _glance_game(event, team_id)
    if not game:
        return None
    comp = (event.get("competitions") or [{}])[0]
    record = ""
    full = ""
    for side in comp.get("competitors") or []:
        if str(dig(side, "team", "id", default="")) != str(team_id):
            full = clean(dig(side, "team", "displayName", default="") or "")
            continue
        for entry in side.get("record") or side.get("records") or []:
            if entry.get("type") in ("total", "ytd"):
                record = str(entry.get("displayValue") or "").split(",")[0]
                break
    notes = comp.get("notes") or []
    game.update({
        "week": clean(dig(event, "week", "text", default="") or ""),
        "kind": _int(dig(event, "seasonType", "type", default=2)) or 2,
        "kind_name": clean(dig(event, "seasonType", "name", default="") or ""),
        "record": record if game["state"] == "post" and not game.get("tbd") else "",
        "opp_full": full,
        "venue": clean(dig(comp, "venue", "fullName", default="") or ""),
        "note": clean(notes[0].get("headline", "")) if notes and
        isinstance(notes[0], dict) else ""})
    return game


def espn_team_schedule(league, team_id, timeout=15):
    """Every game of the team's season, oldest first:
    {'games', 'season', 'standing', 'record'}. ESPN's default answer is the
    part of the season under way, so a preseason or postseason gets the
    regular season added."""
    meta = LEAGUES[league]
    base = (f"apis/site/v2/sports/{meta['sport']}/{meta['path']}/teams/"
            f"{urllib.parse.quote(str(team_id))}/schedule")

    def get(query):
        return fetch_first((f"https://{SITE_HOSTS[0]}/{base}{query}",
                            [f"https://{SITE_HOSTS[1]}/{base}{query}"]), timeout)

    data = get("")
    events = list(data.get("events") or [])
    kinds = {_int(dig(e, "seasonType", "type", default=0)) for e in events}
    if kinds != {2}:
        try:
            extra = get("?seasontype=2")
        except Exception:  # noqa: BLE001 - what the default gave still shows
            if not events:
                raise
        else:
            events += extra.get("events") or []
            if not data.get("events"):
                data = extra
    seen, games = set(), []
    for event in events:
        game = _season_game(event, team_id)
        if game and game["id"] and game["id"] not in seen:
            seen.add(game["id"])
            games.append(game)
    games.sort(key=lambda g: g["date"])
    return {"games": games,
            "season": clean(dig(data, "season", "displayName", default="") or ""),
            "standing": clean(dig(data, "team", "standingSummary", default="") or ""),
            "record": clean(dig(data, "team", "recordSummary", default="") or "")}


def schedule_focus(games):
    """The game a schedule opens on: the one under way, the next one, or the
    last one played."""
    for index, game in enumerate(games):
        if game["state"] == "in":
            return index
    for index, game in enumerate(games):
        if game["state"] == "pre" and not game.get("tbd"):
            return index
    return max(0, len(games) - 1)


def _result_kind(game, league):
    """'W', 'L', 'T' or 'O' (an overtime or shootout loss, in hockey)."""
    result = game.get("result") or ""
    letter = result[:1]
    if letter == "L" and sport_of(league) == "hockey":
        detail = (game.get("detail") or "").upper() + " " + result.upper()
        if "OT" in detail or "SO" in detail:
            return "O"
    return letter


def schedule_summary(games, league, width=200):
    """The season so far on one line: home and away records, the streak, the
    last five, the average score - shorter words when `width` is tight."""
    full = _schedule_summary(games, league, False)
    if sum(len(t) for t, _ in full) <= width:
        return full
    return _schedule_summary(games, league, True)


def _schedule_summary(games, league, short):
    done = [g for g in games if g["state"] == "post" and g.get("result")]
    line = Line()
    if not done:
        upcoming = sum(1 for g in games if g["state"] == "pre")
        return line.add(f" {upcoming} game{'s' if upcoming != 1 else ''} on the schedule, "
                        "none played yet.", "dim")
    hockey = sport_of(league) == "hockey"

    def record(group):
        kinds = [_result_kind(g, league) for g in group]
        text = f"{kinds.count('W')}-{kinds.count('L')}"
        if hockey:
            text += f"-{kinds.count('O')}"
        elif kinds.count("T"):
            text += f"-{kinds.count('T')}"
        return text

    home = [g for g in done if g["home"] and not g.get("neutral")]
    away = [g for g in done if not g["home"] and not g.get("neutral")]
    neutral = [g for g in done if g.get("neutral")]
    line.add(" Home ", "muted").add(record(home), "bold")
    line.add(" · Away " if short else "  ·  Away ", "muted").add(record(away), "bold")
    if neutral and not short:
        line.add("  ·  Neutral ", "muted").add(record(neutral), "bold")
    kinds = [_result_kind(g, league) for g in done]
    last = kinds[-1]
    run = 0
    for kind in reversed(kinds):
        if kind != last:
            break
        run += 1
    names = {"W": "W", "L": "L", "T": "T", "O": "OTL "}
    gap = " · " if short else "  ·  "
    line.add(gap + ("" if short else "Streak "), "muted").add(
        f"{names.get(last, last).strip()}{run}", "good" if last == "W" else "bad")
    line.add(gap + ("" if short else "Last 5 "), "muted")
    for kind in kinds[-5:]:
        line.add(kind if kind != "O" else "o", "good" if kind == "W" else
                 "accent" if kind in ("T", "O") else "bad")
    scored = [g["us"] for g in done if g.get("us") is not None]
    allowed = [g["them"] for g in done if g.get("them") is not None]
    if scored and allowed:
        word = {"baseball": "Runs", "hockey": "Goals"}.get(sport_of(league), "Points")
        line.add(gap + ("avg " if short else f"{word} a game "), "muted")
        line.add(f"{sum(scored) / len(scored):.1f}", "good")
        line.add("-" if short else " for, ", "muted")
        line.add(f"{sum(allowed) / len(allowed):.1f}", "bad")
        if not short:
            line.add(" against", "muted")
    return line


def playoff_series(games):
    """{game id: 'up 2-1' | 'tied 1-1' | 'won 4-2' | 'lost 1-4'} for the
    postseason games: back-to-back games with one opponent are a series,
    over once the next series starts or nothing more is scheduled."""
    post = [g for g in games if g.get("kind") == 3 and not g.get("tbd")]
    out, run = {}, []
    more = any(g["state"] != "post" for g in post)
    for index, game in enumerate(post):
        if run and run[-1]["opp"] != game["opp"]:
            run = []
        run.append(game)
        if game["state"] != "post" or not game.get("result"):
            continue
        wins = sum(1 for g in run if g.get("result", "").startswith("W"))
        losses = sum(1 for g in run if g.get("result", "").startswith("L"))
        following = post[index + 1] if index + 1 < len(post) else None
        over = (following is not None and following["opp"] != game["opp"]) or \
            (following is None and not more)
        if over:
            word = "won" if wins > losses else "lost"
        else:
            word = "up" if wins > losses else "down" if wins < losses else "tied"
        out[game["id"]] = f"{word} {wins}-{losses}"
    return out


def _week_label(game):
    week = game.get("week") or ""
    for long, short in (("Week ", "Wk "), ("Wild Card", "WC"), ("Divisional Round", "Div"),
                        ("Conference Championship", "Conf"), ("Super Bowl", "SB"),
                        ("Pro Bowl", "Pro Bowl"), ("Hall of Fame", "HOF")):
        week = week.replace(long, short)
    if not week and game.get("kind") == 3:
        week = "Post"
    return week


def render_team_schedule(data, league, width, cursor, row_lines=None, summary=True,
                         logo_gap=0):
    """The team's season, one game a line: (week,) date, opponent, result or
    start time, the record after it, TV. Months head the rows outside
    football; a change of season part (preseason, postseason) heads them in
    football. `row_lines` collects the line each game sits on; without
    `summary` the season line on top is left out (the panels have it);
    `logo_gap` leaves that many columns before each opponent for its logo
    (schedule_logo_x says where)."""
    games = (data or {}).get("games") or []
    if not games:
        return [Line().add(" No games on the schedule yet.", "dim")]
    football = sport_of(league) == "football"
    college = league in COLLEGE_LEAGUES
    lines = [schedule_summary(games, league, width), blank()] if summary else [blank()]
    week_w = 8 if football else 0
    date_w, result_w, record_w = 12, (20 if width >= 90 else 17), 9
    opp_w = clamp(width - 1 - week_w - date_w - result_w - record_w - 8 - logo_gap, 14, 30)
    head = Line().add(" ", "normal")
    if football:
        head.add(f"{'WEEK':<{week_w}}", "header")
    head.add(f"{'DATE':<{date_w}}{' ' * logo_gap}{'OPPONENT':<{opp_w}}{'RESULT':<{result_w}}"
             f"{'RECORD':<{record_w}}TV", "header")
    lines.append(head.pad(width, "header"))
    kinds = {g.get("kind") for g in games}
    today = datetime.now().astimezone().date()
    series = {} if football else playoff_series(games)
    previous = None
    last_week = None
    for index, game in enumerate(games):
        moment = _local(game["date"])
        if moment and game.get("time_tba"):
            # a game with no kick-off time yet sits at midnight Eastern: the
            # evening before, west of there
            try:
                moment = datetime.strptime(str(game["date"])[:10], "%Y-%m-%d").replace(
                    hour=12).astimezone()
            except ValueError:
                pass
        if football:
            group = game.get("kind_name") if len(kinds) > 1 else None
        else:
            group = moment.strftime("%B %Y") if moment else ""
        if group and group != previous:
            if index:
                lines.append(blank())
            lines.append(Line().add(f" {group}", "accent"))
        previous = group
        # a week with no game is the bye
        match = re.match(r"Week (\d+)$", game.get("week") or "") if football else None
        number = int(match.group(1)) if match and game.get("kind") == 2 else None
        if number and last_week and number - last_week > 1:
            for bye in range(last_week + 1, number):
                lines.append(Line().add(" ", "normal").add(f"{'Wk ' + str(bye):<{week_w}}", "dim")
                             .add("BYE", "muted"))
        if number:
            last_week = number
        chosen = index == cursor
        base = "sel" if chosen else "normal"
        dim = "seldim" if chosen else "dim"
        line = Line().add("▌" if chosen else " ", "selbar" if chosen else "normal")
        if football:
            line.add(f"{_week_label(game)[:week_w - 1]:<{week_w}}", dim)
        if moment:
            day = "Today" if moment.date() == today else moment.strftime("%a %b %-d")
        else:
            day = "?"
        line.add(f"{day:<{date_w}}", base if game["state"] != "post" else dim)
        if logo_gap:
            line.add(" " * logo_gap, base)
        where = "vs" if game.get("home") or game.get("neutral") else "at"
        rank = f"#{game['opp_rank']} " if game.get("opp_rank") else ""
        name = game.get("opp_name") or game.get("opp") or "?"
        if not college and game.get("opp_full") and \
                len(f"{where} {game['opp_full']}") <= opp_w - 1:
            name = game["opp_full"]           # at Houston Texans, when it fits
        elif not college and len(f"{where} {name}") > opp_w - 1:
            name = game.get("opp") or name
        opponent = f"{where} {rank}{name}"
        if len(opponent) > opp_w - 1:
            opponent = opponent[:opp_w - 2] + "…"
        line.add(f"{opponent:<{opp_w}}", base)
        state = game["state"]
        if state == "post" and game.get("result"):
            kind = _result_kind(game, league)
            mark = {"W": "W", "L": "L", "T": "T", "O": "L"}.get(kind, kind)
            extra = ""
            low = (game.get("detail") or "").upper()
            for tag in ("SO", "OT"):
                if tag in low or game["result"].endswith(tag):
                    extra = f" {tag}"
                    break
            if "/" in low and not extra:
                tail = low.split("/", 1)[1].strip()
                extra = f" {tail[:4]}" if tail else ""
            score = f"{game['us']}-{game['them']}" if game.get("us") is not None else ""
            style = "good" if kind == "W" else "accent" if kind in ("T", "O") else "bad"
            line.add(mark, "sel" if chosen else style)
            line.add(f" {score}{extra}".ljust(result_w - 1), base)
        elif state == "post":
            line.add(f"{(game.get('detail') or 'Final')[:result_w - 1]:<{result_w}}", dim)
        elif state == "in":
            score = f"{game['us']}-{game['them']}" if game.get("us") is not None else ""
            clock = short_clock({"state": "in", "detail": game.get("detail")})
            text = f"LIVE {score} {clock.replace('End of ', 'End ')}"
            line.add(f"{text[:result_w - 1]:<{result_w}}", "sel" if chosen else "live")
        else:
            if game.get("tbd"):
                text = "Postponed"
            elif game.get("time_tba") or not moment:
                text = "TBA"
            else:
                text = moment.strftime("%-I:%M %p")
            line.add(f"{text:<{result_w}}", "sel" if chosen else "accent")
        record = series.get(game["id"]) if game.get("kind") == 3 else game.get("record")
        if football and game.get("kind") == 3:
            record = ""
        line.add(f"{(record or '')[:record_w - 1]:<{record_w}}", dim)
        if state != "post" and game.get("tv"):
            room = width - sum(len(t) for t, _ in line)
            if room > 2:
                line.add(game["tv"][:room], dim)
        if row_lines is not None:
            row_lines.append(len(lines))
        used = sum(len(t) for t, _ in line)
        if used > width:
            trimmed, room = Line(), width
            for text, style in line:
                if room <= 0:
                    break
                trimmed.append((text[:room], style))
                room -= len(text)
            line = trimmed
        lines.append(line.pad(width, base) if chosen else line)
    return lines



# --------------------------------------------------------------------------
# the team page: the season beside its schedule
# --------------------------------------------------------------------------
#
# Everything here is worked out from data the app already has: the team's
# schedule, the league's standings, and the championship odds. The panels
# are plain Lines of one width, laid out by App.draw_team_schedule.

TEAM_PAGE_WIDE = 120     # inner columns from which the panels sit beside the games
CLOSE_GAMES = {"football": (8, "One-score games"), "basketball": (5, "Within 5 points"),
               "hockey": (1, "One-goal games"), "baseball": (1, "One-run games"),
               "soccer": (1, "One-goal games")}
GRADES = (("A+", 0.06), ("A", 0.16), ("A-", 0.26), ("B+", 0.36), ("B", 0.46), ("B-", 0.56),
          ("C+", 0.66), ("C", 0.76), ("C-", 0.84), ("D", 0.93), ("F", 1.01))


def score_noun(league, plural=True):
    noun = {"baseball": "run", "hockey": "goal", "soccer": "goal"}.get(sport_of(league), "point")
    return noun + ("s" if plural else "")


def record_of(kinds, league):
    """'W-L', 'W-L-T', or 'W-L-OTL' in hockey, from result letters."""
    text = f"{kinds.count('W')}-{kinds.count('L')}"
    if sport_of(league) == "hockey":
        return text + f"-{kinds.count('O')}"
    return text + (f"-{kinds.count('T')}" if kinds.count("T") else "")


def went_long(game, league):
    """Did the game need overtime, a shootout or extra innings?"""
    text = f"{game.get('detail') or ''} {game.get('result') or ''}".upper()
    if re.search(r"\b\d?OT\b|\bSO\b", text):
        return True
    if sport_of(league) == "baseball":
        match = re.search(r"/(\d+)", text)
        return bool(match and int(match.group(1)) > 9)
    return False


def game_tag(game, league):
    """'Wk 3' in football, 'Oct 20' elsewhere: when a game was."""
    if sport_of(league) == "football":
        week = _week_label(game)
        if week:
            return week
    moment = _local(game.get("date"))
    return moment.strftime("%b %-d") if moment else ""


def tag_span(first, last, league):
    """'Wk 3-7', 'Jul 9-19' or 'Aug 30-Sep 4': from one game to another."""
    one, two = game_tag(first, league), game_tag(last, league)
    if one.startswith("Wk ") and two.startswith("Wk "):
        return f"Wk {one[3:]}-{two[3:]}"
    if one[:3] == two[:3] and " " in two:
        return f"{one}-{two.split(' ', 1)[1]}"
    return f"{one}-{two}"


def season_numbers(games, league):
    """What a team's schedule says about its season: records by split,
    streaks, the best and worst games, what is left to play."""
    sport = sport_of(league)
    done = [g for g in games if g["state"] == "post" and g.get("result") and not g.get("tbd")]
    kinds = [_result_kind(g, league) for g in done]
    pairs = list(zip(done, kinds))
    scored = [g for g in done if g.get("us") is not None and g.get("them") is not None]

    def margin(game):
        return game["us"] - game["them"]

    runs = []                       # [W/L/T, first index, last index]
    for index, kind in enumerate(kinds):
        group = "W" if kind == "W" else "L" if kind in ("L", "O") else "T"
        if runs and runs[-1][0] == group:
            runs[-1][2] = index
        else:
            runs.append([group, index, index])
    longest = {}
    for group, first, last in runs:
        if group in ("W", "L") and last - first + 1 > longest.get(group, (0,))[0]:
            longest[group] = (last - first + 1, done[first], done[last])
    limit, close_name = CLOSE_GAMES.get(sport, (1, "Close games"))
    close = [k for g, k in pairs if g.get("us") is not None and g.get("them") is not None
             and abs(g["us"] - g["them"]) <= limit]
    long_games = [k for g, k in pairs if went_long(g, league)]
    last_n = 5 if sport == "football" else 10
    wins = [g for g in scored if margin(g) > 0]
    losses = [g for g in scored if margin(g) < 0]
    remaining = [g for g in games if g["state"] == "pre" and not g.get("tbd")]
    live = next((g for g in games if g["state"] == "in"), None)
    ranked = [k for g, k in pairs if g.get("opp_rank")]
    neutral = [k for g, k in pairs if g.get("neutral")]
    return {
        "league": league, "games": games, "done": done, "kinds": kinds,
        "record": record_of(kinds, league),
        "home": record_of([k for g, k in pairs if g["home"] and not g.get("neutral")], league),
        "away": record_of([k for g, k in pairs if not g["home"] and not g.get("neutral")],
                          league),
        "neutral": record_of(neutral, league) if neutral else "",
        "last_n": last_n, "last": record_of(kinds[-last_n:], league),
        "streak": (runs[-1][0], runs[-1][2] - runs[-1][1] + 1) if runs else None,
        "longest": longest,
        "close": record_of(close, league) if close else "", "close_name": close_name,
        "long": record_of(long_games, league) if long_games else "",
        "ranked": record_of(ranked, league) if ranked else "",
        "pf": sum(g["us"] for g in scored) / len(scored) if scored else None,
        "pa": sum(g["them"] for g in scored) / len(scored) if scored else None,
        "biggest_win": max(wins, key=margin) if wins else None,
        "worst_loss": min(losses, key=margin) if losses else None,
        "most_scored": max(scored, key=lambda g: g["us"]) if scored else None,
        "fewest_allowed": min(scored, key=lambda g: g["them"]) if scored else None,
        "shutouts": (sum(1 for g in scored if g["them"] == 0 and g["us"] > 0),
                     sum(1 for g in scored if g["us"] == 0 and g["them"] > 0)),
        "remaining": remaining, "live": live,
        "next": live or (remaining[0] if remaining else None),
    }


def _standing_pct(table):
    """A team's winning percentage out of its standings row (hockey
    counts an overtime loss as half a win, the way its points do)."""
    pct = _st_number(table, "winPercent", "leagueWinPercent")
    if pct is not None and 0 <= pct <= 1:
        return pct
    wins = _st_number(table, "wins")
    losses = _st_number(table, "losses")
    extra = _st_number(table, "ties", "otLosses") or 0
    if wins is None or losses is None:
        for name in ("overall", "total"):
            match = re.match(r"(\d+)-(\d+)(?:-(\d+))?", stat_display(table, [name]))
            if match:
                wins, losses = int(match.group(1)), int(match.group(2))
                extra = int(match.group(3) or 0)
                break
    if wins is None or losses is None or wins + losses + extra == 0:
        return None
    return (wins + 0.5 * extra) / (wins + losses + extra)


def standings_index(data):
    """{team id: {'team', 'table', 'title', 'entries', 'pct'}} from a
    standings payload: every team's row and the group it is in."""
    out = {}
    if not isinstance(data, dict):
        return out
    groups = []
    walk_standings(dig(data, "content", "standings", default=data) or data, [], groups)
    for title, entries in groups:
        for entry in entries:
            team = entry_team(entry)
            if team["id"] and team["id"] not in out:
                table = stat_lookup(entry)
                out[team["id"]] = {"team": team, "table": table, "title": title,
                                   "entries": entries, "pct": _standing_pct(table)}
    return out


def group_order(league, entries):
    """A standings group's teams in standing order (ESPN sends the NBA and
    college basketball in no useful order)."""
    if league not in ("nba", "cbb", "mlb"):
        return list(entries)

    def key(entry):
        table = stat_lookup(entry)
        overall = _standing_pct(table) or 0.0
        behind = _num(stat_display(table, ["gamesBehind"])) or 0.0
        if league == "cbb":
            match = re.match(r"(\d+)-(\d+)", stat_display(table, ["vs. Conf.", "vsconf"]))
            conf = int(match.group(1)) / max(1, int(match.group(1)) + int(match.group(2))) \
                if match else 0.0
            return (-conf, -overall, behind)
        return (-overall, behind)
    return sorted(entries, key=key)


def opponent_numbers(numbers, index):
    """The schedule against the standings: the record against winning teams,
    how strong the opponents were and will be, the hardest stretch left."""
    league = numbers["league"]

    def pct(game):
        row = index.get(str(game.get("opp_id") or ""))
        return row["pct"] if row else None

    pairs = list(zip(numbers["done"], numbers["kinds"]))
    winners = [k for g, k in pairs if (pct(g) or 0) >= 0.5]     # .500 or better
    played = [p for p in (pct(g) for g in numbers["done"]) if p is not None]
    ahead = [p for p in (pct(g) for g in numbers["remaining"]) if p is not None]
    stretch = None
    rest = numbers["remaining"]
    for start in range(max(0, len(rest) - 2)):
        window = rest[start:start + 3]
        values = [pct(g) for g in window]
        if len(window) == 3 and None not in values:
            mean = sum(values) / 3
            if stretch is None or mean > stretch[0] + 1e-9:
                stretch = (mean, window)
    return {"winners": record_of(winners, league) if winners else "",
            "played": sum(played) / len(played) if played else None,
            "ahead": sum(ahead) / len(ahead) if ahead else None,
            "ahead_winners": sum(1 for p in ahead if p > 0.5),
            "stretch": stretch}


def _pct3(value):
    """.523, the way standings print a percentage."""
    if value is None:
        return "-"
    text = f"{value:.3f}"
    return text[1:] if text.startswith("0") else text


def panel_title(text, width, right="", style="header"):
    """A panel's heading: its name, a rule, and a note at the right end."""
    line = Line().add(f" {text} ", style)
    note = f" {right} " if right else ""
    room = width - len(line.text) - len(note)
    if room < 2 and note:
        note, room = "", width - len(line.text)
    line.add("─" * max(0, room), "border")
    if note:
        line.add(note, "muted")
    return line


def fit_line(line, width, style="normal"):
    """A Line cut or padded to exactly `width` columns."""
    out, room = Line(), width
    for text, span_style in line:
        if room <= 0:
            break
        out.append((text[:room], span_style))
        room -= len(text[:room])
    if room > 0:
        out.append((" " * room, style))
    return out


def two_up(rows, width):
    """(label, value-Line) pairs as one or two columns, whichever fits."""
    if not rows:
        return []
    label_w = max(len(label) for label, _ in rows) + 2
    value_w = max(len(value.text) for _, value in rows)
    cell = label_w + value_w
    out = []
    if rows and 2 * cell + 4 <= width - 1 and len(rows) > 2:
        half = (len(rows) + 1) // 2
        for at in range(half):
            left = rows[at]
            right = rows[half + at] if half + at < len(rows) else None
            line = Line().add(" ", "normal")
            for index, pair in enumerate((left, right)):
                if not pair:
                    continue
                label, value = pair
                line.add(f"{label:<{label_w}}", "muted").extend_spans(value)
                if index == 0:
                    line.add(" " * max(1, cell - label_w - len(value.text) + 4), "normal")
            out.append(line)
        return out
    for label, value in rows:
        out.append(Line().add(" ", "normal").add(f"{label:<{label_w}}", "muted")
                   .extend_spans(value))
    return out


def _rec(text, style="bold"):
    return Line().add(text or "-", style)


def splits_panel(numbers, row, league, width):
    """Home and away, division and conference, the last few, the close
    ones: the season's records by split."""
    table = (row or {}).get("table") or {}
    rows = [("Home", _rec(numbers["home"])), ("Away", _rec(numbers["away"]))]
    if numbers["neutral"]:
        rows.append(("Neutral", _rec(numbers["neutral"])))
    division = stat_display(table, ["vs. Div.", "divisionRecord"]) if table else "-"
    conference = stat_display(table, ["vs. Conf.", "vsconf"]) if table else "-"
    if league in ("cfb", "cbb"):
        if conference != "-":
            rows.append(("Conference", _rec(conference)))
    else:
        if division != "-" and re.match(r"\d", division):
            rows.append(("Division", _rec(division)))
        if conference != "-" and re.match(r"\d", conference):
            rows.append(("Conference", _rec(conference)))
    if numbers.get("winners"):
        rows.append(("vs .500 or better", _rec(numbers["winners"])))
    if numbers["ranked"]:
        rows.append(("vs ranked", _rec(numbers["ranked"])))
    rows.append((f"Last {numbers['last_n']}", _rec(numbers["last"])))
    if numbers["close"]:
        rows.append((numbers["close_name"], _rec(numbers["close"])))
    if numbers["long"]:
        extra = "Extra innings" if sport_of(league) == "baseball" else "Overtime"
        rows.append((extra, _rec(numbers["long"])))
    if not numbers["done"]:
        return [panel_title("SPLITS", width), Line().add(" No games played yet.", "dim")]
    return [panel_title("SPLITS", width)] + two_up(rows, width)


def _game_bit(game, league):
    where = "vs" if game.get("home") or game.get("neutral") else "at"
    return f"{where} {game.get('opp') or game.get('opp_name') or '?'} · {game_tag(game, league)}"


def numbers_panel(numbers, league, width):
    """The season's best and worst: the biggest win, the worst loss, the
    most scored, the fewest allowed, the longest runs."""
    if not numbers["done"]:
        return []
    noun = score_noun(league)
    rows = []
    game = numbers["biggest_win"]
    if game:
        rows.append(("Biggest win", Line().add(f"W {game['us']}-{game['them']}", "good")
                     .add(f"  {_game_bit(game, league)}", "dim")))
    game = numbers["worst_loss"]
    if game:
        rows.append(("Worst loss", Line().add(f"L {game['us']}-{game['them']}", "bad")
                     .add(f"  {_game_bit(game, league)}", "dim")))
    game = numbers["most_scored"]
    if game:
        rows.append((f"Most {noun}", Line().add(str(game["us"]), "bold")
                     .add(f"  {_game_bit(game, league)}", "dim")))
    game = numbers["fewest_allowed"]
    if game:
        rows.append(("Fewest allowed", Line().add(str(game["them"]), "bold")
                     .add(f"  {_game_bit(game, league)}", "dim")))
    longest = numbers["longest"]
    if longest:
        value = Line()
        for letter, style in (("W", "good"), ("L", "bad")):
            if letter in longest:
                run, first, last = longest[letter]
                span = tag_span(first, last, league) if run > 1 else game_tag(first, league)
                if value:
                    value.add(" · ", "dim")
                value.add(f"{letter}{run}", style).add(f" {span}", "dim")
        rows.append(("Longest runs", value))
    if sport_of(league) in ("hockey", "baseball", "soccer"):
        made, taken = numbers["shutouts"]
        rows.append(("Shutouts", Line().add(f"{made}", "bold").add(" for · ", "dim")
                     .add(f"{taken}", "bold").add(" against", "dim")))
    out = [panel_title("BY THE NUMBERS", width)]
    label_w = max(len(label) for label, _ in rows) + 2
    for label, value in rows:
        out.append(fit_line(Line().add(" ", "normal").add(f"{label:<{label_w}}", "muted")
                            .extend_spans(value), width))
    return out


def chart_panel(numbers, league, width, rows=4, colour_win="good", colour_loss="bad"):
    """The season so far: one bar a game, as high as it was won by or as
    deep as it was lost by, around a zero line; games to come are dots."""
    games = [g for g in numbers["games"] if not g.get("tbd")]
    played = [g for g in games if g["state"] == "post" and g.get("us") is not None
              and g.get("them") is not None and g.get("result")]
    upcoming = [g for g in games if g["state"] != "post"]
    gutter = 5
    room = max(8, width - gutter - 2)
    series = played + upcoming
    shown = ""
    if len(series) > room:
        if len(played) >= room:
            series = played[-room:]
            shown = f"the last {room} games"
        else:
            series = played + upcoming[:room - len(played)]
            shown = f"games 1-{room} of {len(played) + len(upcoming)}"
    count = len(series)
    if not played:
        return [panel_title("THE SEASON SO FAR", width),
                Line().add(" The first game has not been played yet.", "dim")]
    step = 3 if count * 3 <= room else 2 if count * 2 <= room else 1
    top = max(abs(g["us"] - g["them"]) for g in played) or 1
    levels = rows * 2
    grid = [[(" ", "normal")] * (count * step) for _ in range(rows * 2 + 1)]
    axis = rows
    done_ids = {id(g) for g in played}
    for col, game in enumerate(series):
        x = col * step
        if id(game) in done_ids:
            margin = game["us"] - game["them"]
            height = 0 if margin == 0 else max(1, math.ceil(abs(margin) / top * levels))
            style = colour_win if margin > 0 else colour_loss if margin < 0 else "accent"
            if margin == 0:
                grid[axis][x] = ("◆", "accent")
            for level in range(1, rows + 1):
                full, half = height >= 2 * level, height == 2 * level - 1
                if not (full or half):
                    break
                if margin > 0:
                    grid[axis - level][x] = ("█" if full else "▄", style)
                else:
                    grid[axis + level][x] = ("█" if full else "▀", style)
        else:
            grid[axis][x] = ("·", "live" if game["state"] == "in" else "dim")
    for x in range(count * step):
        if grid[axis][x][0] == " ":
            grid[axis][x] = ("─", "muted")
    noun = score_noun(league)
    right = shown or f"margin in {noun}"
    out = [panel_title("THE SEASON SO FAR", width, right)]
    labels = {0: f"+{top}", axis: "0", rows * 2: f"-{top}"}
    for y, row in enumerate(grid):
        line = Line().add(f"{labels.get(y, ''):>{gutter - 1}} ", "muted")
        for ch, style in row:
            line.add(ch, style) if ch != " " else line.add(" ", "normal")
        out.append(fit_line(line, width))
    # what each bar is: weeks in football, months elsewhere
    ticks = [" "] * (count * step)
    football = sport_of(league) == "football"
    previous = None
    for col, game in enumerate(series):
        x = col * step
        if football:
            match = re.search(r"(\d+)", _week_label(game))
            text = match.group(1) if match else ""
            if text and step >= len(text) + (0 if col == count - 1 else 1) or \
                    (step == 1 and text and int(text) % 5 == 0):
                for i, ch in enumerate(text):
                    if x + i < len(ticks):
                        ticks[x + i] = ch
        else:
            moment = _local(game.get("date"))
            month = moment.strftime("%b") if moment else ""
            if month and month != previous and x + 3 <= len(ticks) and \
                    all(c == " " for c in ticks[max(0, x - 1):x + 3]):
                for i, ch in enumerate(month):
                    ticks[x + i] = ch
            previous = month or previous
    out.append(fit_line(Line().add(" " * gutter, "normal").add("".join(ticks), "muted"), width))
    return out


def standings_place(row, league):
    """'2nd in AFC East' for a standings row, or ''."""
    if not row:
        return ""
    ordered = group_order(league, row["entries"])
    ids = [entry_team(e)["id"] for e in ordered]
    place = ids.index(row["team"]["id"]) + 1 if row["team"]["id"] in ids else 0
    group = short_group(row["title"].split(" — ")[-1])
    return f"{ordinal(place)} in {group}" if place else group


def next_up_panel(numbers, index, league, width, line_text=""):
    """The next game (or the one being played): who, when, where, how the
    opponent is doing, how the teams did against each other already."""
    game = numbers["next"]
    if not game:
        last = numbers["done"][-1] if numbers["done"] else None
        out = [panel_title("SEASON OVER", width)]
        if last:
            out.append(Line().add(" Final record ", "muted").add(numbers["record"], "bold"))
            out.append(Line().add(" Last game ", "muted").add(
                f"{last['result'][:1]} {last['us']}-{last['them']}",
                "good" if last["result"].startswith("W") else "bad")
                .add(f"  {_game_bit(last, league)}", "dim"))
        return out
    live = game["state"] == "in"
    moment = _local(game.get("date"))
    when = ""
    if moment:
        today = datetime.now().astimezone().date()
        days = (moment.date() - today).days
        day = "Today" if days == 0 else "Tomorrow" if days == 1 else moment.strftime("%a %b %-d")
        when = day if game.get("time_tba") else f"{day} · {moment.strftime('%-I:%M %p')}"
        if game.get("tv"):
            when += f" · {game['tv']}"
    out = [panel_title("LIVE NOW" if live else "NEXT UP", width, "" if live else when,
                       "live" if live else "header")]
    where = "vs" if game.get("home") or game.get("neutral") else "at"
    opp_row = index.get(str(game.get("opp_id") or ""))
    opp_team = (opp_row or {}).get("team") or {"abbr": game.get("opp"), "id": game.get("opp_id"),
                                                "name": game.get("opp_full") or ""}
    name = game.get("opp_full") or game.get("opp_name") or game.get("opp") or "?"
    rank = f"#{game['opp_rank']} " if game.get("opp_rank") else ""
    line = Line().add(f" {where} ", "muted").add(f"{rank}{name}",
                                                 THEME.style(league, opp_team, bold=True))
    if opp_row:
        record = stat_display(opp_row["table"], ["overall", "total"])
        if not re.match(r"\d", record):
            wins, losses = stat_display(opp_row["table"], ["wins"]), \
                stat_display(opp_row["table"], ["losses"])
            record = f"{wins}-{losses}" if wins != "-" else ""
        place = standings_place(opp_row, league)
        bits = [b for b in (record, place) if b]
        if bits:
            line.add("  " + " · ".join(bits), "dim")
    out.append(fit_line(line, width))
    if live:
        score = f"{game.get('us')}-{game.get('them')}" if game.get("us") is not None else ""
        clock = short_clock({"state": "in", "detail": game.get("detail")})
        out.append(Line().add(f" LIVE  {score}  {clock}", "live"))
    elif moment:
        days = (moment.date() - datetime.now().astimezone().date()).days
        text = "today" if days == 0 else "tomorrow" if days == 1 else \
            f"in {days} days" if days > 1 else ""
        if text:
            out.append(Line().add(f" {text}", "accent").add(
                f"   {game['venue']}" if game.get("venue") else "", "dim"))
    if line_text:
        out.append(fit_line(Line().add(" Line  ", "muted").add(line_text, "bold"), width))
    met = [g for g in numbers["done"] if str(g.get("opp_id") or g.get("opp")) ==
           str(game.get("opp_id") or game.get("opp"))]
    if met:
        bits = Line().add(" Met already  ", "muted")
        for g in met[-3:]:
            letter = g["result"][:1]
            bits.add(f"{letter} {g['us']}-{g['them']}", "good" if letter == "W" else
                     "bad" if letter == "L" else "accent").add(f" ({game_tag(g, league)})  ",
                                                               "dim")
        out.append(fit_line(bits, width))
    return out


DIVISION_COLUMNS = {
    "nfl": ["W", "L", "T", "PCT", "DIFF", "STRK"], "cfb": ["CONF", "OVR", "STRK"],
    "nba": ["W", "L", "PCT", "GB", "STRK"], "cbb": ["CONF", "OVR", "STRK"],
    "nhl": ["GP", "W", "L", "OTL", "PTS", "STRK"], "ahl": ["GP", "W", "L", "OTL", "PTS"],
    "mlb": ["W", "L", "PCT", "GB", "STRK"], "cbase": ["W", "L", "PCT"],
}


def division_panel(row, league, width, favorites=None, limit=10):
    """The team's division (its conference, in college) as a small table,
    the team marked."""
    if not row:
        return []
    ordered = group_order(league, row["entries"])
    wanted = DIVISION_COLUMNS.get(league, ["W", "L", "PCT"])
    columns = [(label, names) for label, names in standings_columns(league) if label in wanted]
    tables = [stat_lookup(e) for e in ordered]
    if any(label == "T" for label, _ in columns) and all(
            stat_display(t, ["ties"]) in ("0", "-", "") for t in tables):
        columns = [(label, names) for label, names in columns if label != "T"]
    cells = [[stat_display(t, names) for _, names in columns] for t in tables]
    widths = [max([len(label)] + [len(c[i]) for c in cells]) for i, (label, _) in
              enumerate(columns)]
    while columns and sum(w + 1 for w in widths) + 14 > width:
        columns, widths = columns[:-1], widths[:-1]
        cells = [c[:-1] for c in cells]
    name_w = width - 4 - sum(w + 1 for w in widths)
    title = short_group(row["title"].split(" — ")[-1]).upper()
    out = [panel_title(title, width, "the standings")]
    head = Line().add(f"{'':<{name_w + 3}}", "normal")
    for (label, _), w in zip(columns, widths):
        head.add(f" {label:>{w}}", "header")
    out.append(fit_line(head, width))
    ids = [entry_team(e)["id"] for e in ordered]
    mine = ids.index(row["team"]["id"]) if row["team"]["id"] in ids else 0
    first = 0
    if len(ordered) > limit:
        first = clamp(mine - limit // 2, 0, len(ordered) - limit)
    for position in range(first, min(len(ordered), first + limit)):
        team = entry_team(ordered[position])
        us = team["id"] == row["team"]["id"]
        name = standings_name(league, team) if league in COLLEGE_LEAGUES else \
            (team.get("short") or team.get("name") or "?")
        starred = favorites is not None and fav_rank(favorites, league, team) >= 0
        line = Line().add("▶" if us else " ", "accent" if us else "normal")
        line.add(f"{position + 1:>2} ", "muted")
        label = (f"{STAR} " if starred else "") + name
        line.add(f"{label[:name_w - 1]:<{name_w - 1}}",
                 THEME.style(league, team, bold=us or starred))
        for value, w in zip(cells[position], widths):
            line.add(f" {value:>{w}}", "bold" if us else "normal")
        out.append(fit_line(line, width))
    return out


def road_panel(numbers, extra, league, width):
    """What is left: how many, where, against whom, the hardest stretch."""
    rest = numbers["remaining"]
    if not rest:
        return []                  # the next-game panel says the season is over
    out = [panel_title("THE ROAD AHEAD", width)]
    home = sum(1 for g in rest if g.get("home") and not g.get("neutral"))
    away = sum(1 for g in rest if not g.get("home") and not g.get("neutral"))
    out.append(Line().add(f" {len(rest)}", "bold").add(
        f" game{'s' if len(rest) != 1 else ''} left · ", "dim").add(f"{home}", "bold")
        .add(" home, ", "dim").add(f"{away}", "bold").add(" away", "dim"))
    if extra.get("played") is not None or extra.get("ahead") is not None:
        out.append(Line().add(" Opponents' win %  ", "muted").add("so far ", "dim")
                   .add(_pct3(extra.get("played")), "bold").add(" · to come ", "dim")
                   .add(_pct3(extra.get("ahead")), "bold"))
        out.append(Line().add(" Still to face teams over .500  ", "muted")
                   .add(str(extra.get("ahead_winners", 0)), "bold"))
    stretch = extra.get("stretch")
    if stretch:
        mean, window = stretch
        span = tag_span(window[0], window[-1], league)
        teams = " ".join(g.get("opp") or "?" for g in window)
        out.append(fit_line(Line().add(" Toughest stretch  ", "muted").add(span, "bold")
                            .add(f"  {teams}", "normal").add(f"  {_pct3(mean)}", "dim"),
                            width))
    return out


def report_panel(index, team_id, league, width):
    """Grades for scoring, preventing and the margin, by where the team
    ranks in the league - a quick read on what is working."""
    rows = {}
    for ident, row in index.items():
        extras = record_extras(row["table"])
        if extras.get("pf") is not None and extras.get("pa") is not None:
            rows[ident] = extras
    me = rows.get(str(team_id))
    if not me or len(rows) < 4:
        return []
    noun = score_noun(league)
    out = [panel_title("REPORT CARD", width, f"rank of {len(rows)}")]
    for label, key, better_high, unit in (("Offense", "pf", True, f"{noun} a game"),
                                          ("Defense", "pa", False, "allowed a game"),
                                          ("Margin", "diff", True, "a game")):
        value = me.get(key)
        if value is None:
            continue
        values = sorted((r[key] for r in rows.values() if r.get(key) is not None),
                        reverse=better_high)
        rank = values.index(value) + 1
        share = (rank - 1) / max(1, len(values) - 1)
        grade = next(g for g, cut in GRADES if share < cut)
        shown = f"{value:+.1f}" if key == "diff" else f"{value:.1f}"
        style = "good" if grade[0] in "AB" else "bad" if grade[0] in "DF" else "accent"
        out.append(fit_line(Line().add(f" {label:<9}", "muted").add(f"{shown:>6}", "bold")
                            .add(f" {unit:<17}", "dim").add(f"#{rank:<4}", "normal")
                            .add(f"{grade:>3}", style), width))
    return out


def odds_panel(board, team_id, league, width, sources=()):
    """The team's chance to win it all, from the market and the books."""
    if not board:
        return []
    ids = [r["team"]["id"] for r in board]
    if str(team_id) not in ids:
        return []
    place = ids.index(str(team_id))
    row = board[place]
    name = CHAMPIONSHIP_NAME.get(league, "title")
    out = [panel_title("TITLE ODDS", width, name)]
    chance = row["chance"] * 100
    text = f"{chance:.1f}%" if chance >= 0.95 else f"{chance:.2f}%" if chance >= 0.1 else "<0.1%"
    line = Line().add(f" {text}", "good" if place < 3 else "bold").add(
        f"  {ordinal(place + 1)} of {len(board)}", "dim")
    out.append(fit_line(line, width))
    top = board[0]["chance"] or 1.0
    bar_w = max(4, width - 16)
    filled = max(1, round(row["chance"] / top * bar_w))
    out.append(Line().add(" " + "█" * filled, "good" if place < 3 else "accent")
               .add("░" * (bar_w - filled), "border"))
    if sources:
        out.append(fit_line(Line().add(" " + " · ".join(sources), "muted"), width))
    return out


def team_card(team, numbers, row, league, width, art, season="", standing="",
              smaller=None):
    """The top of the team page: the name on a band in the team's colour,
    its badge or logo, the record in scoreboard digits, how it stands.
    `smaller` gives a narrower badge, tried when the wide one leaves the
    record no room for its digits."""
    color = team_hex(league, team)
    ink = _ink_on(color)
    name = (team.get("name") or team.get("abbr") or "?").upper()
    standing = standing or standings_place(row, league)
    right = " · ".join(b for b in (season, standing) if b)
    height = 7
    canvas = Canvas(width, height)
    canvas.fill(0, 0, width, 1, " ", f"@{ink}:{color}")
    canvas.put(0, 1, f" {name} "[: width - 2], f"@{ink}:{color}~b")
    if right and len(name) + len(right) + 6 <= width:
        canvas.put(0, width - len(right) - 2, right, f"@{ink}:{color}")
    record = numbers["record"] if numbers["done"] else "0-0"
    # the text beside the digits is about 27 columns: a badge too wide for
    # the big digits gives way to a narrower one, if that lets them in
    art_w = max((len(l.text) for l in art), default=0) if art else 0
    if smaller and art_w and width - (art_w + 3) - 31 < big_width(record, "big"):
        narrow = smaller() or []
        narrow_w = max((len(l.text) for l in narrow), default=0)
        if narrow and narrow_w < art_w:
            art, art_w = narrow, narrow_w
    x = 1
    if art:
        canvas.lines(1, x, art, width - 2)
        x += art_w + 2
    style = THEME.style(league, team, bold=True)
    lines = []
    if standing and not (right and len(name) + len(right) + 6 <= width):
        lines.append(Line().add(standing, "bold"))          # when the band has no room
    streak = numbers["streak"]
    if streak:
        letter, run = streak
        bit = Line().add("Streak ", "muted").add(f"{letter}{run}",
                                                 "good" if letter == "W" else
                                                 "bad" if letter == "L" else "accent")
        bit.add("  Last ", "muted")
        for kind in numbers["kinds"][-numbers["last_n"]:]:
            bit.add(kind if kind != "O" else "o", "good" if kind == "W" else
                    "accent" if kind in ("T", "O") else "bad")
        lines.append(bit)
    lines.append(Line().add("Home ", "muted").add(numbers["home"], "bold")
                 .add("  Away ", "muted").add(numbers["away"], "bold"))
    if numbers["pf"] is not None:
        lines.append(Line().add("Avg ", "muted").add(f"{numbers['pf']:.1f}", "good")
                     .add(" for · ", "muted").add(f"{numbers['pa']:.1f}", "bad")
                     .add(" against", "muted"))
    text_w = max(len(line.text) for line in lines) if lines else 0
    mode = "big" if width - x - text_w - 4 >= big_width(record, "big") else \
        "small" if width - x - text_w - 4 >= big_width(record, "small") else ""
    if mode:
        digits = big_text(record, mode)
        y = 1 if mode == "big" else 2
        for i, line in enumerate(digits):
            canvas.put(y + i, x, line, style)
        if mode == "big":
            canvas.put(y + len(digits), x, "RECORD", "muted")
        x += len(digits[0]) + 3
    else:
        lines.insert(0, Line().add(record, style))
    canvas.lines(1 if len(lines) >= 5 else 2, x, lines[:6], width - x - 1)
    return canvas.rows()


def layout_panels(panels, width, height, columns=1, gap=2):
    """Stack panels into one or two columns, each panel into whichever
    column is shorter, leaving out any that do not fit."""
    columns = max(1, columns)
    col_w = (width - gap * (columns - 1)) // columns
    stacks = [[] for _ in range(columns)]
    for panel in panels:
        if not panel:
            continue
        target = min(range(columns), key=lambda i: (len(stacks[i]), i))
        need = len(panel) + (1 if stacks[target] else 0)
        if len(stacks[target]) + need > height:
            continue
        if stacks[target]:
            stacks[target].append(Line())
        stacks[target].extend(fit_line(line, col_w) for line in panel)
    out = []
    for y in range(max((len(s) for s in stacks), default=0)):
        line = Line()
        for index, stack in enumerate(stacks):
            part = stack[y] if y < len(stack) else Line()
            line.extend(fit_line(part, col_w))
            if index < columns - 1:
                line.add(" " * gap, "normal")
        out.append(line)
    return out


def schedule_logo_x(league):
    """The column of a schedule line where render_team_schedule leaves room
    for the opponent's logo."""
    return 1 + (8 if sport_of(league) == "football" else 0) + 12


def scale_rgba(image, width, height):
    """An RGBA image (w, h, bytes) resized to width x height, each output
    pixel the alpha-weighted average of the patch it covers."""
    src_w, src_h, data = image
    width, height = max(1, width), max(1, height)
    out = bytearray(width * height * 4)
    for y in range(height):
        y0 = y * src_h // height
        y1 = max(y0 + 1, (y + 1) * src_h // height)
        for x in range(width):
            x0 = x * src_w // width
            x1 = max(x0 + 1, (x + 1) * src_w // width)
            r = g = b = a = count = 0
            for yy in range(y0, y1):
                base = yy * src_w * 4
                for xx in range(x0, x1):
                    i = base + xx * 4
                    alpha = data[i + 3]
                    r += data[i] * alpha
                    g += data[i + 1] * alpha
                    b += data[i + 2] * alpha
                    a += alpha
                    count += 1
            if a:
                o = (y * width + x) * 4
                out[o:o + 4] = bytes((r // a, g // a, b // a, a // count))
    return width, height, out


def logo_strip(images, box_w, box_h):
    """One PNG of a column of logos, `box_w` x `box_h` pixels each, one a
    row: each image (already shrunk to fit) centred in its box; None
    leaves a box clear."""
    blank = b"\x00" * (box_w * 4)
    rows = []
    for image in images:
        if not image:
            rows.extend([blank] * box_h)
            continue
        w, h, data = image
        left, top = (box_w - w) // 2, (box_h - h) // 2
        for y in range(box_h):
            if top <= y < top + h:
                src = bytes(data[(y - top) * w * 4:(y - top + 1) * w * 4])
                rows.append(b"\x00" * (left * 4) + src + b"\x00" * ((box_w - left - w) * 4))
            else:
                rows.append(blank)
    return png_encode(box_w, box_h * len(images), b"".join(rows))


def ahl_team_glance(team_id, timeout=15):
    data = ht_get({"feed": "modulekit", "view": "schedule", "team_id": str(team_id)},
                  timeout)
    glance = {"last": None, "next": None, "live": None, "color": ""}
    for g in dig(data, "SiteKit", "Schedule", default=[]) or []:
        game = _ahl_game(g, team_id)
        final = game["state"] == "post"
        if game["state"] == "in":
            glance["live"] = game
        elif final:
            if not glance["last"] or game["date"] > glance["last"]["date"]:
                glance["last"] = game
        elif not glance["next"] or game["date"] < glance["next"]["date"]:
            if game["date"] >= datetime.now(timezone.utc).strftime("%Y-%m-%dT%H"):
                glance["next"] = game
    return glance


def _local(stamp):
    try:
        return datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).astimezone()
    except (TypeError, ValueError):
        return None


def glance_when(game, with_time=True):
    moment = _local(game.get("date"))
    if not moment:
        return ""
    if game.get("time_tba"):
        # ESPN parks a game with no kick-off time yet at midnight Eastern,
        # which is the evening before in the central and western zones
        try:
            moment = datetime.strptime(str(game["date"])[:10], "%Y-%m-%d").replace(
                hour=12).astimezone()
        except ValueError:
            pass
    today = datetime.now().astimezone().date()
    days = (moment.date() - today).days
    if days == 0:
        day = "Today"
    elif days == 1:
        day = "Tomorrow"
    elif days == -1:
        day = "Yesterday"
    elif 1 < days < 7:
        day = moment.strftime("%a")
    else:
        day = moment.strftime("%a %b %-d")
    if not with_time:
        return day
    if game.get("time_tba"):
        return f"{day} TBA"
    clock = moment.strftime("%-I:%M %p").replace(":00 ", " ")
    return f"{day} {clock}"


def glance_opponent(game, league):
    where = "vs" if game.get("home") else "at"
    if game.get("neutral"):
        where = "vs"
    rank = f"#{game['opp_rank']} " if game.get("opp_rank") else ""
    name = game.get("opp") or "?"
    if league in COLLEGE_LEAGUES and game.get("opp_name"):
        name = game["opp_name"]
    return f"{where} {rank}{name}"


# --------------------------------------------------------------------------
# Today across every sport: the BottomLine ticker, the Overview's Today list
# and favourite-team score alerts all read one background slate - every
# league's scoreboard for today, fetched behind whatever is on screen
# --------------------------------------------------------------------------

SLATE_LEAGUES = ("nfl", "cfb", "nba", "cbb", "nhl", "ahl", "mlb", "cbase")
TICKER_SECONDS = 5          # each page of the BottomLine stays up this long
# what a score change is called, by sport and by how many points it was
SCORE_WORDS = {
    "football": {1: "EXTRA POINT", 2: "2 POINTS", 3: "FIELD GOAL", 6: "TOUCHDOWN",
                 7: "TOUCHDOWN", 8: "TOUCHDOWN"},
    "hockey": {1: "GOAL", 2: "2 GOALS", 3: "3 GOALS"},
    "baseball": {1: "RUN SCORES"},
}


def slate_is_fav(event, league, favorites):
    return any(fav_rank(favorites, league, event[side]) >= 0 for side in ("away", "home"))


def slate_keep(event, league, favorites):
    """Every pro game; in college, games with a ranked team or a favourite."""
    if league not in COLLEGE_LEAGUES:
        return True
    return bool(event["away"].get("rank") or event["home"].get("rank")
                or slate_is_fav(event, league, favorites))


def slate_order(events, league, favorites):
    """Favourites first; then live games, closest first; then upcoming by
    start time; then finals."""
    def key(event):
        state = {"in": 0, "pre": 1, "post": 2}.get(event["state"], 3)
        margin = 0
        if state == 0:
            margin = abs((event["away"]["score"] or 0) - (event["home"]["score"] or 0))
        return (0 if slate_is_fav(event, league, favorites) else 1, state, margin,
                event.get("date") or "", event.get("short_name") or "")
    return sorted(events, key=key)


def short_clock(event):
    """'7:10p', '2:13 4th', 'F', 'F/OT' - a status that fits a ticker chip."""
    if event["state"] == "pre":
        if event.get("time_tba"):
            return "TBA"
        when = _local(event.get("date"))
        if not when:
            return event.get("detail") or ""
        hour = when.strftime("%I:%M").lstrip("0")
        return f"{hour}{'a' if when.hour < 12 else 'p'}"
    detail = event.get("detail") or ""
    if event["state"] == "post":
        low = detail.lower()
        if "final" in low or not detail:
            tail = detail.split("/", 1)[1] if "/" in detail else ""
            return "F" + (f"/{tail}" if tail else "")
        return detail
    # '2:13 - 4th' reads better as '2:13 4th', and '05:23' as '5:23'
    return re.sub(r"^0(\d:\d\d)", r"\1", detail.replace(" - ", " "))


def ticker_chip(event, league, favorites, with_league=False):
    """One game as ticker spans: ★ NFL KC 24 BUF 21 2:13 4th."""
    line = Line()
    if slate_is_fav(event, league, favorites):
        line.add(STAR + " ", "star")
    if with_league:
        line.add(LEAGUE_SHORT.get(league, league.upper()) + " ", "muted")
    college = league in RANKED_LEAGUES
    for index, side in enumerate(("away", "home")):
        team = event[side]
        if index:
            line.add(" ", "normal")
        if college and team.get("rank"):
            line.add(f"{team['rank']} ", "muted")
        loser = event["state"] == "post" and not team.get("winner")
        line.add(team["abbr"], THEME.style(league, team, bold=not loser, dim=loser))
        if team["score"] is not None:
            line.add(f" {team['score']}", "bold" if event["state"] != "post" or
                     team.get("winner") else "dim")
    status = short_clock(event)
    if status:
        line.add(" " + status, "live" if event["state"] == "in" else "dim")
    return line


def ticker_pages(slate, favorites, width):
    """[(bug, [(chip, league, event)])] - pages of games that each fit in
    `width` columns after the league bug: your teams first, then each
    league in turn."""
    pages = []

    def paginate(bug, items):
        room = max(10, width - len(bug) - 4)
        page, used = [], 0
        for chip, league, event in items:
            size = len(chip.text) + 3
            if page and used + size > room:
                pages.append((bug, page))
                page, used = [], 0
            page.append((chip, league, event))
            used += size
        if page:
            pages.append((bug, page))

    mine, rest = [], {}
    for league in SLATE_LEAGUES:
        for event in slate.get(league) or []:
            if slate_is_fav(event, league, favorites):
                mine.append((ticker_chip(event, league, favorites, True), league, event))
            else:
                rest.setdefault(league, []).append(
                    (ticker_chip(event, league, favorites), league, event))
    if mine:
        paginate(f"{STAR} YOUR TEAMS", mine)
    for league in SLATE_LEAGUES:
        if rest.get(league):
            paginate(LEAGUE_SHORT.get(league, league.upper()), rest[league])
    return pages


def score_alert(event, league, before, fav_sides):
    """The bottom-line alert for one of your teams' games, comparing it with
    what the last look saw (state, away score, home score), or ''."""
    state0, away0, home0 = before
    away, home = event["away"], event["home"]
    if away["score"] is None or home["score"] is None:
        score = ""
    else:
        score = f"{away['abbr']} {away['score']}, {home['abbr']} {home['score']}"
    mine = event[fav_sides[0]]
    other = home if fav_sides[0] == "away" else away
    if state0 == "pre" and event["state"] == "in":
        tv = f" on {event['broadcast']}" if event.get("broadcast") else ""
        return f"{STAR} {away['abbr']} @ {home['abbr']} is under way{tv}"
    if event["state"] == "post" and state0 != "post":
        us, them = mine["score"] or 0, other["score"] or 0
        verdict = "win" if us > them else "loss" if us < them else "tie"
        tail = f" ({event['detail']})" if event.get("detail") and \
            event["detail"].lower() not in ("final", "f") else ""
        return f"{STAR} FINAL: {score} - {mine['abbr']} {verdict}{tail}"
    if event["state"] != "in":
        return ""
    sport = sport_of(league)
    if sport == "basketball":
        return ""
    for side, old in (("away", away0), ("home", home0)):
        new = event[side]["score"]
        if old is None or new is None or new <= old:
            continue
        delta = new - old
        word = SCORE_WORDS.get(sport, {}).get(delta)
        if not word:
            word = {"baseball": f"{delta} RUNS SCORE", "hockey": f"{delta} GOALS"}.get(
                sport, f"SCORE +{delta}")
        bang = "!" if side in fav_sides else ""
        return f"{STAR} {event[side]['abbr']} {word}{bang} {score} · {short_clock(event)}"
    return ""


def close_late(event, league):
    """A basketball game in its last two minutes within five points."""
    if sport_of(league) != "basketball" or event["state"] != "in":
        return False
    last = 2 if league == "cbb" else 4
    if (event.get("period") or 0) < last:
        return False
    clock = event.get("clock") or ""
    try:
        minutes, _, seconds = clock.partition(":")
        left = int(minutes) * 60 + float(seconds or 0)
    except ValueError:
        return False
    away, home = event["away"]["score"], event["home"]["score"]
    return left <= 120 and away is not None and home is not None and abs(away - home) <= 5


