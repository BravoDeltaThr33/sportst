def baseball_post_pairs(profile):
    """His postseason for a card: games, then a hitter's average, homers,
    RBIs, runs, hits and slash line, or a pitcher's innings, ERA,
    strikeouts, walks and hits."""
    post = profile.get("post") or {}
    if not post:
        return []
    games = len([g for g in profile.get("games") or [] if g.get("post")])
    pairs = [("GP", str(games))] if games else []
    names = ("IP", "ERA", "K", "BB", "H", "HR") if profile.get("pitcher") else \
        ("AVG", "HR", "RBI", "R", "H", "SB", "OBP", "SLG", "OPS")
    pairs += [(name, post.get(name)) for name in names]
    return [(label, value) for label, value in pairs if value not in (None, "", "-")]


def baseball_team_stats(summary):
    """{'away' / 'home': {'batting': {label: value}, 'pitching': …,
    'fielding': …}} from the box score's team numbers."""
    sides = {str(dig(c, "team", "id", default="")): c.get("homeAway")
             for c in dig(summary, "header", "competitions", 0, "competitors", default=[])
             or []}
    out = {}
    for block in dig(summary, "boxscore", "teams", default=[]) or []:
        side = sides.get(str(dig(block, "team", "id", default="")))
        if side not in ("away", "home"):
            continue
        groups = {}
        for group in block.get("statistics") or []:
            values = {}
            for stat in group.get("stats") or []:
                label = clean(stat.get("abbreviation") or stat.get("name") or "")
                if label and label not in values:
                    values[label] = clean(str(stat.get("displayValue") or ""))
            groups[clean(group.get("name") or "")] = values
        out[side] = groups
    return out


def baseball_inning_table(summary, event, league, width):
    """Runs in each inning (an x where the home side didn't need its last
    turn), then runs, hits, errors and runners left on base."""
    comps = {c.get("homeAway"): c for c in
             dig(summary, "header", "competitions", 0, "competitors", default=[]) or []}
    if "away" not in comps or "home" not in comps:
        return []
    runs = {}
    for side in ("away", "home"):
        runs[side] = [clean(str(s.get("displayValue") if s.get("displayValue") is not None
                                else s.get("value", ""))) for s in
                      comps[side].get("linescores") or [] if isinstance(s, dict)]
    played = max(len(runs["away"]), len(runs["home"]))
    if not played:
        return []
    # 7.0.0: softball's seven innings, a minor-league doubleheader's seven
    regulation = _int(dig(summary, "format", "regulation", "periods", default=0)) or \
        LEAGUES.get(league, {}).get("regulation") or 9
    innings = max(regulation, played)
    stats = baseball_team_stats(summary)
    heads = [""] + [str(n) for n in range(1, innings + 1)] + ["R", "H", "E", "LOB"]
    rows = []
    for side in ("away", "home"):
        cells = list(runs[side])
        if event.get("state") == "post" and side == "home" and \
                len(cells) == len(runs["away"]) - 1:
            cells.append("x")
        cells += [""] * (innings - len(cells))
        totals = [clean(str(comps[side].get(key) if comps[side].get(key) is not None
                            else "")) for key in ("score", "hits", "errors")]
        lob = ((stats.get(side) or {}).get("batting") or {}).get("LOB", "")
        rows.append([event[side]["abbr"]] + cells + totals + [lob])
    if not any(row[-1] for row in rows):
        heads, rows = heads[:-1], [row[:-1] for row in rows]
    aligns = ["<"] + [">"] * (len(heads) - 1)
    table = build_table(heads, rows, aligns=aligns, header_style="header",
                        row_styles=["normal", "normal"], sep="  ")
    if max(len(line.text) for line in table) > width:
        table = build_table(heads, rows, aligns=aligns, header_style="header",
                            row_styles=["normal", "normal"], sep=" ")
    return [heading("By inning")] + [fit_line(line, width) for line in table]


def baseball_batting_compare(summary, event, league, width):
    """Who won the game at the plate: hits, extra-base hits, homers, walks,
    strikeouts, steals, runners left on base, double plays hit into, pitches
    seen and the slash line."""
    stats = baseball_team_stats(summary)
    a = (stats.get("away") or {}).get("batting") or {}
    h = (stats.get("home") or {}).get("batting") or {}
    if not a or not h:
        return []
    rows = []
    for label, key, higher in (("Hits", "H", True), ("Extra-base hits", "XBH", True),
                               ("Home runs", "HR", True), ("Walks", "BB", True),
                               ("Strikeouts", "SO", False), ("Stolen bases", "SB", True),
                               ("Left on base", "LOB", False),
                               ("Into double plays", "GIDP", False),
                               ("Pitches seen", "P", True)):
        if a.get(key) not in (None, "") and h.get(key) not in (None, ""):
            if key == "P" and not _number(a[key]) and not _number(h[key]):
                continue                 # college's box does not count them (7.0.0)
            rows.append((label, a[key], h[key], _better(_number(a[key]), _number(h[key]),
                                                        higher)))
    if all(side.get("AVG") and side.get("OPS") for side in (a, h)):
        slash = [f"{side['AVG']}/{side.get('OBP', '')}/{side.get('SLG', '')}" for side in (a, h)]
        rows.append(("AVG/OBP/SLG", slash[0], slash[1],
                     _better(_number(a["OPS"]), _number(h["OPS"]))))
    return football_compare("At the plate", "", rows, event, league, width)


def baseball_mound_lines(summary, event, league, width):
    """Each side's starter and bullpen: innings, hits, runs, walks,
    strikeouts and pitches-strikes, the decisions beside them."""
    sides = {str(dig(c, "team", "id", default="")): c.get("homeAway")
             for c in dig(summary, "header", "competitions", 0, "competitors", default=[])
             or []}
    staffs = {}
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = sides.get(str(dig(block, "team", "id", default="")))
        for section in block.get("statistics") or []:
            if side in ("away", "home") and is_pitching(section.get("name") or
                                                        section.get("type")):
                labels = section.get("labels") or section.get("names") or []
                staffs[side] = [(clean(dig(entry, "athlete", "shortName", default="") or
                                       dig(entry, "athlete", "displayName", default="")),
                                 box_row_stats(labels, entry))
                                for entry in section.get("athletes") or []]
    if not staffs.get("away") or not staffs.get("home"):
        return []

    def summed(entries):
        outs = sum(baseball_outs(stats.get("IP")) or 0 for _, stats in entries)
        cells = [f"{outs // 3}.{outs % 3}"]
        cells += [str(sum(_int(stats.get(label)) for _, stats in entries))
                  for label in ("H", "R", "ER", "BB", "K")]
        pitches = [str(stats.get("PC-ST") or "").split("-") for _, stats in entries]
        if pitches and all(len(pair) == 2 and all(x.isdigit() for x in pair)
                           for pair in pitches):
            cells.append(f"{sum(int(x) for x, _ in pitches)}-"
                         f"{sum(int(y) for _, y in pitches)}")
        else:
            cells.append("")
        return cells

    rows, styles = [], []
    for side in ("away", "home"):
        (name, stats), pen = staffs[side][0], staffs[side][1:]
        decision = (stats.get("Dec") or "").split(",")[0].strip()
        rows.append([event[side]["abbr"], name[:18]] + summed([(name, stats)]) + [decision])
        styles.append("normal")
        if pen:
            saves = [s.get("Dec", "").split(",")[0].strip() for _, s in pen if s.get("Dec")]
            rows.append(["", f"bullpen ({len(pen)})"] + summed(pen) + [" ".join(saves)])
            styles.append("dim")
    heads = ["", "", "IP", "H", "R", "ER", "BB", "K", "P-S", ""]
    aligns = ["<", "<"] + [">"] * 7 + ["<"]
    table = build_table(heads, rows, aligns=aligns, header_style="header",
                        row_styles=styles, sep="  ")
    if max(len(line.text) for line in table) > width:
        table = build_table(heads, rows, aligns=aligns, header_style="header",
                            row_styles=styles, sep=" ")
    return [heading("On the mound")] + [fit_line(line, width) for line in table]


def baseball_top_lines(summary, event, league, width, count=5):
    """The game's best by fantasy points, for the Game Stats tab: each with
    his line at the plate and on the mound."""
    players = []
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = "home" if str(dig(block, "team", "id", default="")) == \
            str(event["home"].get("id")) else "away"
        found = {}
        for section in block.get("statistics") or []:
            group = clean(section.get("name") or section.get("type") or "")
            labels = section.get("labels") or section.get("names") or []
            for entry in section.get("athletes") or []:
                ident = str(dig(entry, "athlete", "id", default="") or "")
                name = clean(dig(entry, "athlete", "shortName", default="")
                             or dig(entry, "athlete", "displayName", default=""))
                if not ident or not name:
                    continue
                found.setdefault(ident, {"name": name, "team": event[side], "lines": []})
                found[ident]["lines"].append((group, box_row_stats(labels, entry)))
        players.extend(found.values())
    ranked = sorted(((baseball_points(p["lines"]), p) for p in players),
                    key=lambda item: -item[0])
    ranked = [(value, p) for value, p in ranked if value > 0][:count]
    if not ranked:
        return []
    lines = [cut_line(heading("Top performers").add("  by fantasy points", "muted"), width)]
    name_w = min(22, max(len(p["name"]) for _, p in ranked))
    for place, (value, player) in enumerate(ranked, 1):
        team = player["team"]
        line = Line().add(f"{place:>2} ", "muted").add(f"{team['abbr']:<5}", THEME.style(
            league, team, bold=True, fallback="accent"))
        line.add(f"{player['name'][:name_w]:<{name_w + 1}}", "normal").add(f"{value:5.1f}  ",
                                                                          "bold")
        parts = [baseball_compact(group, stats) for group, stats in
                 sorted(player["lines"], key=lambda item: -baseball_points([item]))]
        lines.append(fit_line(line.add(" · ".join(p for p in parts if p), "dim"), width))
    return lines


def espn_football_profile(player_id, league, timeout=15):
    """An NFL or college football player's card from ESPN: who he is, his
    season and his games this season (newest first), category by category
    (passing, rushing ...) as his game log has them."""
