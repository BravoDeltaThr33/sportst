    def team_page_hints(self, back):
        """The keys of a team's page: its games, or on a narrow screen the
        season panels (v switches)."""
        if not self._team_page_wide and self.sched_view == "season":
            return [("j/k", "scroll"), ("v", "games")] + back
        hints = [("j/k", "game"), ("enter", "open"), ("z", "game center"),
                 ("t", "next game")]
        if not self._team_page_wide:
            hints.append(("v", "season"))
        return hints + back

