def info_sections(app):
    """What the Info pop-up shows for the screen in front of you."""
    tab = app.tab_name
    league = app.league
    if tab == "Settings":
        return info_settings()
    if tab == "Overview":
        return info_overview()
    if tab == "Favorites":
        return info_favorites()
    if is_wiki_sport(league) or tab in ("Medals", "Events", "Results", "Medalists"):
        return info_olympic(tab)
    if tab == "Scoreboard":
        return info_scoreboard(league)
    if tab == "Scouting":
        return info_scouting(league)
    if tab in ("Boxscore", "Game Stats", "Plays"):
        event = app.current_event()
        summary = app.load_summary(event["id"]).data if event and league != "x" else None
        if tab == "Boxscore":
            return info_boxscore(summary, league)
        if tab == "Game Stats":
            return info_game_stats(league)
        return info_plays(league)
    if tab == "Standings":
        return info_standings(league)
    if tab == "Stats":
        if app.stats_team and app.stats_team[0] == league:
            if app.players_view == "game":
                return info_last_game(league) + info_players(league)
            return info_players(league)
        return info_stats(league, app.load_team_table().data)
    if tab in ("Playoffs", "Medal Round"):
