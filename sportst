OLYMPIC_ROUNDS = ["Playoffs", "Quarterfinals", "Semifinals", "Bronze", "Gold"]


def olympic_round(headline):
    low = (headline or "").lower()
    if "gold" in low or "final" == low.split(" - ")[-1].strip():
        return "Gold"
    if "bronze" in low:
        return "Bronze"
    if "semi" in low:
        return "Semifinals"
    if "quarter" in low:
        return "Quarterfinals"
    if "playoff" in low or "qualification" in low or "round of 16" in low:
        return "Playoffs"
    return ""


def olympic_stage(event):
    """'Group B', 'Semifinal', 'Gold' - the part of the note that matters."""
    for note in event.get("notes") or []:
        tail = note.split(" - ")[-1].strip() if " - " in note else note
        if tail:
            return tail.replace("Medal Game", "").replace("Preliminary Round", "Prelim").strip()
    return ""


# --------------------------------------------------------------------------
# league-wide team statistics - the Stats tab, and the numbers behind Scouting
#
# ESPN's own stats pages read from one endpoint that returns every team's
# season numbers - its own and what opponents did against it - with league
# ranks. That covers the NFL, college football, the NBA, men's college
# basketball and the NHL. The rest come from the leagues' free official
# feeds: MLB's Stats API, the NHL's stats API (shots, faceoffs), HockeyTech
# for the AHL, and the open-source NCAA API (ncaa-api.henrygd.me, which reads
# NCAA.com) for college baseball. None of them needs a key.
#
# Every source is reduced to one shape: a list of stat definitions and, per
# team, a value for each. Ranks are worked out here, against the whole
# league, so a filtered view still says where a team stands overall.
# --------------------------------------------------------------------------

ESPN_STATS = "https://site.web.api.espn.com/apis/common/v3/sports"
