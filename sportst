def parse_args(argv):
    parser = make_parser()
    args = parser.parse_args(argv)

    if args.date:
        try:
            args.date = datetime.strptime(args.date.replace("/", "-"), "%Y-%m-%d").date()
        except ValueError:
            parser.error("--date wants YYYY-MM-DD")
    return args


def check_olympic_args(args):
    """-E and --games name an Olympic sport and Games: find them (either one
    alone says which Olympics is meant), or return what the choices are."""
    fams = [args.league] if args.league in ("owg", "osg") else ["owg", "osg"]
    if args.games:
        years = {fam: [g["year"] for g in OLYMPIC_GAMES.get(fam, [])] for fam in fams}
        having = [fam for fam in fams if args.games in years[fam]]
        if not having:
            return (f"{APP}: no {' or '.join(LEAGUE_SHORT[f] for f in fams)} in "
                    f"{args.games}. On file: " + "; ".join(
                        f"{LEAGUE_SHORT[f]} {', '.join(str(y) for y in years[f])}"
                        for f in fams))
        if not args.league and not args.event:
            args.league = having[0]
    if not args.event:
        return None
    if args.league and args.league not in ("owg", "osg"):
        return f"{APP}: -E picks an Olympic sport; use it with -L owg or -L osg."
    choices = []
    for fam in fams:
        games = (olympic_games(fam, args.games) if args.games else None) or \
            current_games(fam)
        if args.event in games["sports"]:
            args.league = args.league or fam
            return None
        choices.append(f"  -L {fam} ({games['year']}): " + ", ".join(games["sports"]))
    return "\n".join([f"{APP}: no Olympic sport called {args.event!r}. The choices:"]
                     + choices + ["(--list-events -L owg or -L osg lists them by name.)"])


def _borrow_tables():
    """7.0.0: the leagues added in 7.0.0 take their model league's entry in
    each table keyed by league where they keep none of their own - after
    their own numbers (a season's games, a game's length, timeouts, the
    betting model's spread) are set."""
    SEASON_GAMES.update({"wnba": 44, "milb": 140})
    PICTURE_CUTS.update({"wnba": [(8, "")]})      # the top eight overall, no play-in
    TV_LENGTH.update({"wnba": timedelta(hours=2), "wcbb": timedelta(hours=2),
                      "milb": timedelta(hours=2, minutes=45), "csoft": timedelta(hours=2)})
    BASKETBALL_TIMEOUTS.update({"wnba": 4, "wcbb": 4})
    MODEL.update({"wnba": dict(MODEL["nba"], sigma=11.0, tsigma=15.5, hfa=2.0, b2b=1.0,
                               cap=4.5),
                  "wcbb": dict(MODEL["cbb"], sigma=11.0, tsigma=14.5),
                  # the minors score a little more and less predictably than the
                  # majors; softball's games are shorter and its margins wider
                  "milb": dict(MODEL["mlb"], sigma=4.6, tsigma=4.8, n0=25),
                  "csoft": dict(MODEL["cbase"], sigma=5.0, tsigma=5.5)})
    WIRE_BIG.update({"wnba": (25, 30, 35, 40), "wcbb": (25, 30, 35, 40)})
    for table in (STANDINGS_COLUMNS, COLLEGE_TABLE_COLUMNS, DIVISION_COLUMNS, WIRE_RUN,
                  WIRE_COMEBACK, WIRE_BIG, PICTURE_CUTS):
        for new, model in MODEL_LEAGUE.items():
            if new not in table and model in table:
                table[new] = table[model]


_borrow_tables()


def enable_windows_vt():
    """Windows (7.0.0): have the console read escape codes, for the colours
    of the one-shot prints (the full screen switches them on itself)."""
    try:
        import ctypes
        k32 = ctypes.WinDLL("kernel32")
        for which in (-11, -12):            # standard output, standard error
            handle = k32.GetStdHandle(which)
            mode = ctypes.c_ulong()
            if k32.GetConsoleMode(handle, ctypes.byref(mode)):
                k32.SetConsoleMode(handle, mode.value | 0x0004)
    except Exception:  # noqa: BLE001 - plain text, then
        pass


def main(argv=None):
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    if os.name == "nt":
        enable_windows_vt()
    args = parse_args(argv if argv is not None else sys.argv[1:])
    problem = check_olympic_args(args)
    if problem:
        sys.stderr.write(problem + "\n")
        return 2

    if args.write_config:
        path = write_default_config(args.config)
        print(f"wrote {path}")
        return 0

    config = load_config(args.config)
    config["favorites"] = normalize_favorites(config.get("favorites"))
    config["crt_levels"] = crt_levels_saved(crt_levels(config.get("crt_levels")))
    THEME.configure(config)
    METER["blocks"] = str(config.get("logo_art", "sextants") or "off").lower() \
        not in PLAIN_LOGO_STYLES
    METER["style"] = meter_style(config.get("meter_style"))
    oneshot = any([args.scores, args.box, args.standings, args.json, args.stats, args.bets,
                   args.team_stats, args.plays, args.favorites, args.odds,
                   args.playoffs, args.logo_test, args.medals, args.list_events,
                   args.kim, args.today])
    if oneshot:
        try:
            return run_oneshot(config, args)
        except BrokenPipeError:
            # `sportst --scores | head` closed the pipe early; that is fine
            try:
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, sys.stdout.fileno())
            except OSError:
                pass
            return 0

    if not sys.stdout.isatty():
        sys.stderr.write(
            f"{APP}: not a terminal. Use --scores, --box ID, or --standings for plain output.\n")
        return 1

    os.environ.setdefault("ESCDELAY", "25")
    try:
        choose_pictures(config)     # real images or text art: ask the terminal first
    except KeyboardInterrupt:
        return 0

    def bootstrap(stdscr):
        app = App(stdscr, config, args)
        try:
            app.run()
        finally:
            app.crt.stop()          # no glass left over the terminal, however it ends

    try:
        curses.wrapper(bootstrap)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
