    # -- scoring-play clips (Plays tab) -------------------------------------

    def mlb_game_pk(self, event):
        """MLB's id for this game, from MLB's schedule for the day (a
        minor-league game's id is MLB's own, 7.0.0)."""
        if self.league == "milb":
            return _int(event["id"]) or None
        game_pk = self.game_pks.get(event["id"])
        if game_pk is not None:
            return game_pk
        when = parse_iso(event["date"])
        day = when.astimezone().date() if when else Date.today()
        for offset in (0, -1, 1):
            probe = day + timedelta(days=offset)
            result = self.fetcher.get(("mlbsched", probe.isoformat()),
                                      statcast_schedule_url(probe), ttl=3600)
            if not result.data:
                continue
            found = find_game_pk(result.data, event)
            if found:
                self.game_pks[event["id"]] = found
                return found
        return None

    def clip_sources(self, event, summary):
        """(one-play clips, game highlight, nhl.com goal links, loading) for a
        game, from whichever free source covers its league."""
        league = self.league
        loading = False
        plays, game, nhl_links = [], None, {}
        if league in ("mlb", "milb"):
            game_pk = self.mlb_game_pk(event)
            if game_pk:
                result = self.fetcher.get(("mlbclips", game_pk),
                                          Loader("statsapi.mlb.com", mlb_clips, game_pk),
                                          ttl=120 if event["state"] == "in" else 1800)
                loading = result.loading and not result.data
                if result.data:
                    plays, game = result.data["plays"], result.data["game"]
        elif league in YOUTUBE_CHANNELS:
            if self.config.get("youtube_clips", True):
                channel = YOUTUBE_CHANNELS[league]
                result = self.fetcher.get(("ytfeed", channel),
                                          Loader("www.youtube.com", youtube_feed, channel),
                                          ttl=300)
                loading = result.loading and not result.data
                entries = result.data or []
                plays = entries
                game = youtube_game_clip(entries, event)
        else:
            plays, game = espn_clips(summary)
            if league == "nhl" and event["state"] != "pre":
                when = parse_iso(event["date"])
                if when:
                    day = (when.astimezone(timezone.utc) - timedelta(hours=5)).date()
                    result = self.fetcher.get(
                        ("nhlclips", event["id"]),
                        Loader("api-web.nhle.com", nhl_goal_clips, day.isoformat(), event),
                        ttl=120 if event["state"] == "in" else 1800)
                    nhl_links = result.data or {}
        return plays, game, nhl_links, loading

    def match_play_clips(self, event, summary, refs):
        """{play index: clip} and the game's highlight clip. Every play gets
        something to open: its own clip, the NHL's goal page, or a YouTube
        search for it."""
        plays, game, nhl_links, loading = self.clip_sources(event, summary)
        texts = [re.sub(r"^(Even Strength|Power Play|Shorthanded|Short Handed|Empty Net)"
                        r"(, [^G]*)? Goal Scored by ", "",
                        clean(at_bat_text(ref) if "pitches" in ref else (ref.get("text") or "")))
                 for ref in refs]
        matched = assign_clips(texts, plays, team_words(event)) if plays else {}
        out = {}
        youtube = self.config.get("youtube_clips", True)
        for index, ref in enumerate(refs):
            clip = matched.get(index)
            if clip is None and nhl_links:
                number = dig(ref, "period", "number", default=0)
                clock = clean(dig(ref, "clock", "displayValue", default="")).lstrip("0")
                clip = nhl_links.get((_int(number), clock or "0:00"))
            if clip is None and youtube:
                clip = {"title": "a YouTube search for this play",
                        "url": play_search_url(event, self.league, texts[index]),
                        "kind": "search", "source": "YouTube", "seconds": 0}
            if clip is not None:
                out[index] = clip
        if game is None and youtube:
            game = {"title": "a YouTube search for this game's highlights",
                    "url": game_search_url(event, self.league), "kind": "search",
                    "source": "YouTube", "seconds": 0}
        return out, game, loading

    def game_highlights(self, event, summary):
        """The whole game's highlights to pick from (dicts: title, url, kind -
        "video" a file, "youtube" a YouTube page, "search" a YouTube search -
        source, seconds and page)."""
        league = self.league
        found = []
        if league in ("mlb", "milb"):
            game_pk = self.mlb_game_pk(event)
            if game_pk:
                result = self.fetcher.get(("mlbclips", game_pk),
                                          Loader("statsapi.mlb.com", mlb_clips, game_pk),
                                          ttl=120 if event["state"] == "in" else 1800)
                found += (result.data or {}).get("full") or []
        else:
            found += espn_game_highlights(summary)
        youtube = self.config.get("youtube_clips", True)
        if league in YOUTUBE_CHANNELS and youtube:
            channel = YOUTUBE_CHANNELS[league]
            result = self.fetcher.get(("ytfeed", channel),
                                      Loader("www.youtube.com", youtube_feed, channel), ttl=300)
            entry = youtube_game_clip(result.data or [], event)
            if entry:
                found.append(dict(entry, kind="youtube", page=entry["url"]))
        if not found and youtube and event["state"] != "pre":
            url = game_search_url(event, league)
            found.append({"title": "Search YouTube for this game's highlights", "url": url,
                          "kind": "search", "source": "YouTube", "seconds": 0, "page": url})
        seen, out = set(), []
        for item in found:
            if item["url"] not in seen:
                seen.add(item["url"])
                out.append(item)
        return out

    def highlight_section(self, event, summary, panes, inner):
        """The game's highlights in their own little section at the foot of the
        scoring summary (y picks them, enter plays the picked one in a card).
        Returns where the picked one is, as (pane, line), or None."""
        items = self.game_highlights(event, summary)
        self._hl_event, self._highlights = event["id"], items
        if not panes or (event["state"] == "pre" and not items):
            return None
        where = None
        for pane_index, (_, body) in enumerate(panes):
            last = None
            for line_index, line in enumerate(body):
                if getattr(line, "play_ref", None) is not None:
                    last = line_index
            if last is not None:
                where = (pane_index, last + 1)
                break
        if where is None:
            where = (0, 0)
        chosen = self.hl_sel.get(event["id"])
        if chosen is not None and not 0 <= chosen < len(items):
            chosen = None
            self.hl_sel.pop(event["id"], None)
        head = heading("Game highlights")
        if items and items[0]["kind"] != "search":
            head.add("  y picks · enter plays it here", "muted")
        block = [blank(), head]
        if not items or items[0]["kind"] == "search":
            start = parse_iso(event.get("date"))
            old = event["state"] == "post" and start is not None and \
                (datetime.now(timezone.utc) - start).total_seconds() > 30 * 3600
            note = ("The league's channel has moved on since this game: the search finds "
                    "its highlights." if old else
                    "Not posted yet: they come up soon after the final.")
            for chunk in wrap_spans(note, max(10, inner - 2), "dim"):
                block.append(Line().add("  ", "dim").extend_spans(chunk))
        focus = None
        for index, item in enumerate(items):
            mark = "↗ " if item["kind"] == "search" else "▶ "
            tail = (f"  {clock_text(item['seconds'])}" if item.get("seconds") else "") + \
                f"  {item['source']}"
            room = max(8, inner - len(mark) - len(tail))
            title = item["title"] if len(item["title"]) <= room else item["title"][:room - 1] + "…"
            row = Line().add(mark, "accent").add(title, "normal").add(tail, "muted")
            row.click = (lambda i=index: self.click_highlight(i),
                         lambda i=index: self.click_highlight(i, True))
            if index == chosen:
                row[:] = [(text, _on_cursor(style)) for text, style in row]
                used = sum(len(text) for text, _ in row)
                if used < inner:
                    row.append((" " * (inner - used), "sel"))
                focus = (where[0], where[1] + len(block))
            block.append(row)
        body = panes[where[0]][1]
        body[where[1]:where[1]] = block
        return focus

    def say_highlight(self, item):
        engine = highlight_engine(item, self.graphics.enabled,
                                  self.config.get("highlight_player", "auto"))
        where = {"mpv": "plays it here", "frames": "plays it here",
                 "window": "plays it in a window"}.get(engine, "opens it in your browser")
        self.status_message = f"{'↗' if engine == 'browser' else '▶'} {item['title']} · " \
                              f"enter {where}"

    def click_highlight(self, index, open_it=False):
        """A row of the game's highlights: the first click picks it, a click
        on the picked one plays it."""
        event = self.current_event()
        if not event or self._hl_event != event["id"] or \
                not 0 <= index < len(self._highlights):
            return False
        again = self.clicked_again("highlight", event["id"], index)
        self.hl_sel[event["id"]] = index
        self.play_sel.pop(event["id"], None)
        self.dirty = True
        if open_it or again:
            self.open_highlight(index)
            return True
        self.say_highlight(self._highlights[index])
        return False

    def open_highlight(self, index):
        """Play the game's highlights (the picked one) in the card - or in a
        window, or the browser, where nothing here can draw them."""
        event = self.current_event()
        items = self._highlights if event and self._hl_event == event["id"] else []
        if not items:
            self.status_message = "No highlights of this game yet."
            return
        index = clamp(index, 0, len(items) - 1)
        item = items[index]
        pictures = bool(self.graphics.enabled)
        engine = highlight_engine(item, pictures, self.config.get("highlight_player", "auto"))
        if engine == "browser":
            if item["kind"] != "search" and item["kind"] == "youtube" and not youtube_tool():
                hint = " (yt-dlp plays YouTube here)"
            elif item["kind"] == "search":
                hint = ""
            else:
                hint = " (install mpv or ffmpeg to play it here)"
            if open_in_browser(item.get("page") or item["url"]):
                what = "Searching YouTube" if item["kind"] == "search" else "Opening"
                self.status_message = f"↗ {what} in your browser{hint}."
            else:
                self.status_message = f"⚠ No browser found to open {item.get('page') or item['url']}"
            return
        self.stop_clip(quiet=True)
        self.video = {"items": items, "index": index, "engine": engine,
                      "pictures": pictures and engine in ("mpv", "frames"),
                      "state": "starting", "rect": None, "line": None, "box": None,
                      "at": 0.0, "player": None, "proc": None, "error": "",
                      "event": event["id"], "line_at": 0.0}
        self.dirty = True

    def video_live(self):
        """Whether a player has the card: then nothing else is drawn, so that
        what it draws and what curses draws never cross."""
        return self.video is not None and self.video["state"] != "starting"

    def draw_video_card(self, height, width):
        """The highlights card: its title, the place the video plays in (16:9,
        as big as the screen allows), the time line and the keys."""
        video = self.video
        items, index = video["items"], clamp(video["index"], 0, len(video["items"]) - 1)
        item = items[index]
        cw, ch = cell_pixels()
        ratio = max(0.3, min(0.8, cw / ch)) if ch else 0.5
        cols = max(16, min(width - 8, 120))
        rows = max(4, int(round(cols * ratio * 9 / 16)))
        room = height - 1 - 2 - 4
        if rows > room:
            rows = max(3, room)
            cols = max(16, min(width - 8, int(round(rows * 16 / 9 / ratio))))
        box_w, box_h = cols + 4, rows + 6
        top = max(0, (height - 1 - box_h) // 2)
        left = max(0, (width - box_w) // 2)
        for row in range(box_h):
            self.put(top + row, left, " " * box_w, self.palette("normal"))
        self.draw_box(top, left, box_h, box_w, "Game highlights", "title")
        inner = box_w - 4
        title = item["title"] if len(item["title"]) <= inner else item["title"][:inner - 1] + "…"
        self.put(top + 1, left + 2, title, self.palette("bold"))
        about = [item["source"]] + ([clock_text(item["seconds"])] if item.get("seconds") else [])
        if len(items) > 1:
            about.append(f"{index + 1} of {len(items)}")
        about.append({"mpv": "mpv", "frames": "ffmpeg", "window": "a player's own window"}
                     .get(video["engine"], ""))
        self.put(top + 2, left + 2, " · ".join(a for a in about if a)[:inner],
                 self.palette("muted"))
        black = self.palette("@000000:000000")
        for row in range(rows):
            self.put(top + 3 + row, left + 2, " " * cols, black)
        if video["engine"] == "window":
            note = "It plays in its own window."
            self.put(top + 3 + rows // 2, left + 2 + max(0, (cols - len(note)) // 2), note,
                     self.palette("dim"))
        margin_top, margin_left = self.stdscr.margin[:2]
        video["rect"] = (top + 3 + margin_top, left + 2 + margin_left, rows, cols)
        video["line"] = (top + 3 + rows + margin_top, left + 2 + margin_left, inner)
        video["box"] = (top, left, box_h, box_w)
        self.put(top + 3 + rows, left + 2, "starting…", self.palette("muted"))
        keys = "space pause · ← → 10 s · r from the start" + \
            (" · n / N the other one" if len(items) > 1 else "") + " · esc close"
        if video["engine"] == "window":
            keys = "r again" + (" · n / N the other one" if len(items) > 1 else "") + \
                " · esc stops it"
        self.put(top + 4 + rows, left + 2, keys[:inner], self.palette("muted"))

    def raw_style(self, style):
        """An escape for a style as the screen shows it (in the phosphor's
        colours in CRT mode), for text written past curses."""
        name = style[1:] if style[:1] in ("^", "%") else style
        styles = base_styles()
        entry = styles.get(name) or styles["normal"]
        fg = hex_to_rgb(entry[0]) if entry[0] else (230, 227, 220)
        back = self.palette.crt_bg or self.palette.bg_rgb or (0, 0, 0)
        bg = hex_to_rgb(entry[1]) if entry[1] else None
        if self.crt_phosphor:
            fg = crt_tint(fg or (230, 227, 220), self.crt_phosphor, "text")
            bg = crt_tint(bg, self.crt_phosphor, "back") if bg else None
        fg, bg = fg or (230, 227, 220), bg or back
        return "\x1b[0;38;2;%d;%d;%d;48;2;%d;%d;%dm" % (tuple(fg) + tuple(bg))

    def raw_spans(self, y, x, spans, width):
        """Spans at y, x (screen cells), `width` wide, written straight to the
        terminal, the cursor left where it was."""
        out, used = [f"\x1b7\x1b[{y + 1};{x + 1}H"], 0
        for text, style in spans:
            text = text[:max(0, width - used)]
            if not text:
                continue
            out.append(self.raw_style(style) + text)
            used += len(text)
        if used < width:
            out.append(self.raw_style("normal") + " " * (width - used))
        out.append("\x1b[0m\x1b8")
        write_terminal("".join(out).encode("utf-8"))

    def video_line(self):
        """The card's time line: where the highlights are, a meter of it, and
        what they are doing."""
        video = self.video
        if not video or not video.get("line"):
            return
        y, x, width = video["line"]
        item = video["items"][video["index"]]
        player = video.get("player")
        at = player.position if player is not None else video.get("at", 0.0)
        total = item.get("seconds") or 0
        state = video["state"]
        clock = clock_text(at) + (f" / {clock_text(total)}" if total else "")
        word = {"paused": "‖ paused · space plays on", "starting": "starting…",
                "ended": "finished · enter plays it again",
                "window": "playing in its own window"}.get(state, "")
        if state == "error":
            word = "⚠ " + (video.get("error") or "it would not play")[:max(10, width - 30)]
        elif state == "playing" and player is not None and player.silent:
            word = "no sound: ffmpeg could not reach the sound server"
        meter = max(0, min(40, width - len(clock) - len(word) - 6))
        lit = int(round(meter * min(1.0, at / total))) if total and meter else 0
        spans = [(clock + "  ", "accent")] + meter_block(lit, "accent") + \
            [(" " * (meter - lit) + "  ", "normal"), (word, "warn" if state == "error" else "muted")]
        self.raw_spans(y, x, spans, width)

    def start_video_player(self):
        """The card is on screen: start its player."""
        video = self.video
        item = video["items"][video["index"]]
        engine = video["engine"]
        try:
            self.crt.hand_over(self.term)
        except Exception as exc:  # noqa: BLE001 - an effect must never cost the app
            self.crt_failed(exc)
        if engine == "window":
            name, path = find_player("mpv" if item["kind"] == "youtube" else "auto")
            try:
                video["proc"] = start_player(path, name, item["url"], video=True)
                video["state"] = "window"
            except (OSError, TypeError, KeyError) as exc:
                video.update(state="error", error=str(exc) or "no player")
            self.video_line()
            return
        player = HighlightPlayer(engine, item, video["rect"], cell_pixels(),
                                 offset=video.get("at", 0.0), pictures=video["pictures"],
                                 true_colour=not self.args.no_true_color,
                                 tint=phosphor_filter(self.crt_phosphor) if self.crt.on else "")
        video["player"] = player
        if player.start():
            video["state"] = "playing"
        else:
            video.update(state="error", error=player.error)
        video["line_at"] = 0.0
        self.video_line()

    def video_tick(self):
        """Every turn of the loop while the card is open: start the player once
        the card is on screen, draw the newest frame, keep the time line up
        to date, and notice the end."""
        video = self.video
        if video is None:
            return
        state = video["state"]
        if state == "starting":
            if video.get("rect") is not None:
                self.start_video_player()
            return
        if state == "window":
            proc = video.get("proc")
            if proc is not None and proc.poll() is not None:
                video["state"], video["proc"] = "ended", None
                self.video_line()
            return
        player = video.get("player")
        if player is None or state != "playing":
            return
        if player.engine == "frames":
            frame = player.draw()
            if frame:
                write_terminal(frame)
            ended = player.ended and player.shown == player.count
        else:
            ended = player.poll()
        if ended:
            code = player.proc.returncode if player.proc is not None else None
            failed = (player.engine == "frames" and not player.count) or \
                (player.engine == "mpv" and code in (1, 2))
            video["at"] = player.position
            if failed:
                video.update(state="error", error=player.error or
                             f"{'mpv' if player.engine == 'mpv' else 'ffmpeg'} could not play it")
            else:
                video["state"] = "ended"
            player.stop()
            video["player"] = None
            self.video_line()
            return
        now = time.monotonic()
        if now - video.get("line_at", 0.0) >= 0.5:
            video["line_at"] = now
            self.video_line()

    def video_restart(self, at=0.0, redraw=False, index=None):
        """Play from `at` seconds - in the card as it stands, or (`redraw`: a
        new size, the other highlight) once the card has been drawn again."""
        video = self.video
        player = video.get("player")
        if player is not None:
            player.stop()
            video["player"] = None
        proc = video.get("proc")
        if proc is not None and proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass
        video["proc"] = None
        if index is not None:
            video["index"] = index % len(video["items"])
        video["at"] = max(0.0, float(at or 0.0))
        if redraw:
            self.clear_video_frame(video)
            video.update(state="starting", rect=None, line=None)
            self.term.clearok(True)
            self.crt.lost()
            self.dirty = True
            return
        self.start_video_player()

    def video_pause(self):
        """Space: pause, or play on; at the end, play it again."""
        video = self.video
        state = video["state"]
        player = video.get("player")
        if state in ("ended", "error"):
            self.video_restart(0.0)
            return
        if state == "playing" and player is not None:
            if player.engine == "mpv":
                if not player.ask("set_property", "pause", True):
                    return
            else:
                video["at"] = player.position
                player.stop()                  # its last frame stays in the card
                video["player"] = None
            video["state"] = "paused"
        elif state == "paused":
            if player is not None and player.engine == "mpv":
                player.ask("set_property", "pause", False)
                video["state"] = "playing"
            else:
                self.start_video_player()
                return
        self.video_line()

    def video_seek(self, delta):
        """← →: back or on ten seconds."""
        video = self.video
        item = video["items"][video["index"]]
        total = item.get("seconds") or 0
        player = video.get("player")
        at = player.position if player is not None else video.get("at", 0.0)
        target = max(0.0, at + delta)
        if total:
            target = min(target, max(0.0, total - 1))
        state = video["state"]
        if player is not None and player.engine == "mpv":
            player.ask("seek", target, "absolute")
            player.position = target
        elif state == "playing":
            self.video_restart(target)
            return
        else:
            video["at"] = target
            if state in ("ended", "error"):
                video["state"] = "paused"      # space plays on from here
        self.video_line()

    def clear_video_frame(self, video):
        """Take the last frame out of the card."""
        if video["engine"] == "mpv":
            write_terminal(b"\x1b_Ga=d,q=2\x1b\\")      # mpv leaves its last frame
        elif video.get("pictures"):
            write_terminal(f"\x1b_Ga=d,d=I,i={HIGHLIGHT_IMAGE},q=2\x1b\\".encode())
        write_terminal(b"\x1b[0m\x1b[?25l")             # mpv shows the cursor as it goes

    def close_highlight(self):
        video, self.video = self.video, None
        if not video:
            return
        player = video.get("player")
        if player is not None:
            player.stop()
        proc = video.get("proc")
        if proc is not None and proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass
        self.clear_video_frame(video)
        self.term.clearok(True)
        self.crt.lost()
        self.dirty = True

    def video_failed(self, exc):
        self.close_highlight()
        self.status_message = f"⚠ The highlights stopped: {type(exc).__name__}: {exc}"

    def handle_video_key(self, key):
        """The highlights card takes every key."""
        video = self.video
        items, state = video["items"], video["state"]
        player = video.get("player")
        at = player.position if player is not None else video.get("at", 0.0)
        if key in (curses.KEY_RESIZE, 12):
            if key == curses.KEY_RESIZE:
                self.apply_background()
            self.video_restart(at, redraw=True)
            return True
        if key == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bits = curses.getmouse()
            except curses.error:
                return True
            if not bits & (curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED):
                return True
            box = video.get("box")
            my -= self.stdscr.margin[0]
            mx -= self.stdscr.margin[1]
            if box and box[0] <= my < box[0] + box[2] and box[1] <= mx < box[1] + box[3]:
                self.video_pause()
            else:
                self.close_highlight()
            return True
        if key in (27, ord("q"), ord("Q"), ord("x"), ord("X"), curses.KEY_BACKSPACE, 127, 8):
            self.close_highlight()
            return True
        if video["engine"] == "window":
            if key in (ord("r"), ord("R"), 10, 13, curses.KEY_ENTER):
                self.video_restart(0.0)
            elif key in (ord("n"), ord("N"), ord("j"), ord("k"), curses.KEY_DOWN,
                         curses.KEY_UP) and len(items) > 1:
                step = 1 if key in (ord("n"), ord("j"), curses.KEY_DOWN) else -1
                self.video_restart(0.0, redraw=True, index=video["index"] + step)
            return True
        if key in (ord(" "), ord("p"), ord("P")):
            self.video_pause()
        elif key in (10, 13, curses.KEY_ENTER):
            if state in ("ended", "error"):
                self.video_restart(0.0)
            else:
                self.video_pause()
        elif key in (ord("r"), ord("R")):
            self.video_restart(0.0)
        elif key in (curses.KEY_LEFT, ord("h"), curses.KEY_RIGHT, ord("l")):
            self.video_seek(-HIGHLIGHT_SEEK if key in (curses.KEY_LEFT, ord("h"))
                            else HIGHLIGHT_SEEK)
        elif key in (ord("n"), ord("N"), ord("j"), ord("k"), curses.KEY_DOWN,
                     curses.KEY_UP) and len(items) > 1:
            step = 1 if key in (ord("n"), ord("j"), curses.KEY_DOWN) else -1
            self.video_restart(0.0, redraw=True, index=video["index"] + step)
        return True

    def decorate_plays(self, event, summary, panes, inner):
        """Mark each scoring play's clip (♪ plays here, ↗ opens the browser)
        and highlight the chosen one; keep it on screen. `panes` is a list of
        (title, lines); returns them changed in place."""
        refs, seen = [], set()
        for _, body in panes:
            for line in body:
                ref = getattr(line, "play_ref", None)
                if ref is not None and getattr(line, "play_first", False) \
                        and id(ref) not in seen:
                    seen.add(id(ref))
                    refs.append(ref)
        self._play_event = event["id"]
        self._play_refs = refs
        clips, game, loading = self.match_play_clips(event, summary, refs)
        picked_highlight = self.highlight_section(event, summary, panes, inner)
        if picked_highlight and self._play_follow:
            self._play_focus = picked_highlight
        if not refs:
            self._play_clips, self._game_clip = {}, game
            return panes
        self._play_clips, self._game_clip, self._clips_loading = clips, game, loading
        chosen = self.play_sel.get(event["id"])
        if chosen is not None:
            chosen = clamp(chosen, 0, len(refs) - 1)
            self.play_sel[event["id"]] = chosen
        index_of = {id(ref): i for i, ref in enumerate(refs)}
        playing = self.player and self.player.get("event") == event["id"] and \
            self.player.get("play")
        focus = None
        for pane_index, (_, body) in enumerate(panes):
            for line_index, line in enumerate(body):
                ref = getattr(line, "play_ref", None)
                if ref is None:
                    continue
                index = index_of.get(id(ref))
                selected = index == chosen
                if getattr(line, "play_first", False) and line and line[0][0] == "  ":
                    clip = clips.get(index)
                    mark = ""
                    if playing is not None and playing == index:
                        mark = "▶"
                    elif clip and clip["kind"] == "audio":
                        mark = "♪"
                    elif clip and clip["kind"] == "page":
                        mark = "↗"
                    line[0] = (f"{mark} " if mark else "  ",
                               "live" if mark == "▶" else "accent")
                if selected:
                    if focus is None:
                        focus = (pane_index, line_index)
                    restyled = [(text, _on_cursor(style)) for text, style in line]
                    line[:] = restyled
                    used = sum(len(t) for t, _ in line)
                    if used < inner:
                        line.append((" " * (inner - used), "sel"))
        if focus and self._play_follow:
            self._play_focus = focus
        return panes

    def follow_play(self, panes, height, width):
        """Scroll the Plays panes so the chosen play is in view, once, right
        after j / k picked it (J / K and PgDn still scroll freely)."""
        focus = getattr(self, "_play_focus", None)
        if not (focus and self._play_follow):
            return
        self._play_follow = False
        self._play_focus = None
        self.scroll_into_view(panes, height, width, "Plays", *focus)

    def player_status(self):
        if not self.player:
            return ""
        return f"♪ {self.player['title']} · {self.player['source']} · X stops"

    def stop_clip(self, quiet=False):
        if self.player:
            try:
                self.player["proc"].terminate()
            except (OSError, AttributeError):
                pass
            self.player = None
            if not quiet:
                self.status_message = "Stopped."

    def poll_player(self):
        """Forget a clip once its player has finished."""
        if self.player and self.player["proc"].poll() is not None:
            self.player = None
            self.dirty = True

    def play_clip(self, clip, play_index=None):
        if not clip:
            self.status_message = "No clip for this play."
            return
        choice = str(self.config.get("clip_player", "auto") or "auto")
        if clip["kind"] == "audio" and choice != "browser":
            name, path = find_player(choice)
            if path:
                self.stop_clip(quiet=True)
                try:
                    proc = start_player(path, name, clip["url"],
                                        video=bool(self.config.get("clip_video", False)),
                                        limit=PLAY_CLIP_SECONDS if play_index is not None
                                        else None)
                except OSError as exc:
                    self.status_message = f"⚠ Could not start {name}: {exc}"
                    return
                self.player = {"proc": proc, "title": clip["title"], "source": clip["source"],
                               "event": getattr(self, "_play_event", None),
                               "play": play_index, "url": clip["url"]}
                self.status_message = ""
                return
            hint = " (install mpv to hear it here)" if choice == "auto" else \
                f" ({choice} is not installed)"
        else:
            hint = ""
        if open_in_browser(clip["url"]):
            what = {"search": "Searching YouTube", "page": "Opening"}.get(clip["kind"],
                                                                         "Opening")
            title = "" if clip["kind"] == "search" else f": {clip['title']}"
            self.status_message = f"↗ {what} in your browser{title}{hint}."
        else:
            self.status_message = f"⚠ No browser found to open {clip['url']}"

    def handle_plays_key(self, key):
        """Return True when the Plays tab has used the key: j / k pick a
        scoring play, enter plays its clip, y the game's highlights, x stops."""
        event = self.current_event()
        refs = self._play_refs if event and self._play_event == event["id"] else []
        items = self._highlights if event and self._hl_event == event["id"] else []
        picked = self.hl_sel.get(event["id"]) if event and items else None
        if picked is not None and not 0 <= picked < len(items):
            picked = None
            self.hl_sel.pop(event["id"], None)
        if key in (ord("j"), curses.KEY_DOWN, ord("k"), curses.KEY_UP) and items:
            down = key in (ord("j"), curses.KEY_DOWN)
            current = self.play_sel.get(event["id"])
            if picked is not None:
                if down:
                    picked = min(len(items) - 1, picked + 1)
                elif picked > 0:
                    picked -= 1
                elif refs:
                    # up out of the highlights: the scoring summary's last play
                    self.hl_sel.pop(event["id"], None)
                    self.play_sel[event["id"]] = len(refs) - 1
                    self._play_follow = True
                    return True
                self.hl_sel[event["id"]] = picked
                self._play_follow = True
                self.say_highlight(items[picked])
                return True
            if not refs or (down and current == len(refs) - 1):
                # past the scoring summary's last play: its highlights
                self.play_sel.pop(event["id"], None)
                picked = 0 if down or not refs else len(items) - 1
                self.hl_sel[event["id"]] = picked
                self._play_follow = True
                self.say_highlight(items[picked])
                return True
        if key in (10, 13, curses.KEY_ENTER) and picked is not None:
            self.open_highlight(picked)
            return True
        if key == 27 and picked is not None:
            self.hl_sel.pop(event["id"], None)
            return True
        if key in (ord("j"), curses.KEY_DOWN, ord("k"), curses.KEY_UP) and refs:
            current = self.play_sel.get(event["id"])
            step = 1 if key in (ord("j"), curses.KEY_DOWN) else -1
            if current is None:
                current = 0 if step > 0 else len(refs) - 1
            else:
                current = clamp(current + step, 0, len(refs) - 1)
            self.play_sel[event["id"]] = current
            self._play_follow = True
            clip = self._play_clips.get(current)
            if clip and clip["kind"] != "search":
                self.status_message = f"{'♪' if clip['kind'] == 'audio' else '↗'} " \
                                      f"{clip['title']} · enter " + \
                                      ("plays it" if clip["kind"] == "audio" else "opens it")
            return True
        if key in (ord("n"), ord("N")) and refs:
            have = sorted(i for i, c in self._play_clips.items() if c["kind"] != "search")
            if not have:
                self.status_message = ("Still looking for this game's clips…"
                                       if self._clips_loading else
                                       "No clips found for this game's plays.")
                return True
            current = self.play_sel.get(event["id"])
            if key == ord("n"):
                later = [i for i in have if current is None or i > current]
                target = later[0] if later else have[0]
            else:
                earlier = [i for i in have if current is not None and i < current]
                target = earlier[-1] if earlier else have[-1]
            self.play_sel[event["id"]] = target
            self.hl_sel.pop(event["id"], None)
            self._play_follow = True
            clip = self._play_clips[target]
            self.status_message = f"{'♪' if clip['kind'] == 'audio' else '↗'} " \
                                  f"{clip['title']} · enter " + \
                                  ("plays it" if clip["kind"] == "audio" else "opens it")
            return True
        if key in (10, 13, curses.KEY_ENTER) and refs:
            chosen = self.play_sel.get(event["id"])
            if chosen is None:
                self.status_message = "j / k pick a scoring play first."
                return True
            if self.player and self.player.get("play") == chosen and \
                    self.player.get("event") == event["id"]:
                self.stop_clip()
                return True
            self.play_clip(self._play_clips.get(chosen), chosen)
            return True
        if key == 27 and refs and self.play_sel.get(event["id"]) is not None:
            self.play_sel.pop(event["id"], None)
            return True
        if key == ord("y") and event:
            if self._hl_event != event["id"]:
                self.status_message = "Still loading this game."
                return True
            if not items:
                self.status_message = "No highlights of this game yet."
                return True
            picked = 0 if picked is None else (picked + 1) % len(items)
            self.hl_sel[event["id"]] = picked
            self.play_sel.pop(event["id"], None)
            self._play_follow = True
            self.say_highlight(items[picked])
            return True
        if key == ord("x") and self.player:
            self.stop_clip()
            return True
        if key in (ord("J"), ord("K")):
            self.scroll_panes("Plays", 3 if key == ord("J") else -3)
            return True
        if key == ord("s") and sport_of(self.league) == "basketball":
            # 6.22.0: the scoring plays in place of the left side, or hidden
            self.show_scoring = not self.show_scoring
            self.scroll["Plays"] = 0
            self.status_message = ("The scoring plays · s hides them." if self.show_scoring
                                   else "Scoring plays hidden · s shows them.")
            return True
        return False

    def box_play_panes(self, panes, inner):
        """The Plays sections' blocks in titled boxes (plays_sections), the
        chosen play's place (to scroll to) carried over."""
        out = []
        focus = getattr(self, "_play_focus", None)
        for index, (title, body) in enumerate(panes):
            boxed, where = plays_sections(body, inner, self.corners())
            out.append((title, boxed))
            if focus and focus[0] == index:
                rows = [where[i] for i in sorted(where) if i >= focus[1]]
                self._play_focus = (index, rows[0] if rows else max(0, len(boxed) - 1))
        return out

    def draw_play_panes(self, top, height, width, panes, event, summary):
        inner = self.pane_width(width)
        self.decorate_plays(event, summary, panes, inner - 4)
        panes = self.box_play_panes(panes, inner)
        card = 0
        football = sport_of(self.league) == "football"
        if football and self.play_sel.get(event["id"]) is not None and self._play_refs:
            # as tall as the drive: a row a play, the yard line, the border
            refs = self._play_refs
            play = refs[clamp(self.play_sel[event["id"]], 0, len(refs) - 1)]
            snaps = len(football_drive_snaps(football_drive_of(summary, play))) or 1
            card = min(max(6, snaps + 3), max(6, height * 2 // 3), height - 8)
            card = card if card >= 5 else 0
        elif self.league in ("nhl", "ahl"):
            card = self.goal_card_height(panes, height, width, event, summary)
            if not card and self.play_sel.get(event["id"]) is None:
                # no room for the box at the bottom: the shot map and the game's
                # flow go at the end of the lists instead (J / K reach them)
                extra = []
                for block in (hockey_shot_map(summary, event, self.league, inner - 4),
                              hockey_flow_lines(summary, event, self.league, inner - 4)):
                    if block:
                        extra += [blank()] + block
                if extra and panes:
                    title, body = panes[-1]
                    panes[-1] = (title, list(body) + plays_sections(extra, inner,
                                                                    self.corners())[0])
        self.follow_play(panes, height - card, width)
        self.draw_two_panes(top, height - card, width, "Plays", panes)
        if card and football:
            self.draw_drive_card(top + height - card, card, width, event, summary)
        elif card:
            self.draw_goal_card(top + height - card, card, width, event, summary)

    def draw_drive_card(self, top, height, width, event, summary):
        """The picked scoring play's drive along the bottom of football's Plays
        tab: each play on the field (where it began and ended, in the
        offense's colours), its down and distance and what happened."""
        refs = self._play_refs
        chosen = self.play_sel.get(event["id"])
        if chosen is None or not refs:
            return
        play = refs[clamp(chosen, 0, len(refs) - 1)]
        drive = football_drive_of(summary, play)
        side = football_side(drive or play, event)
        title = football_drive_title(drive, play, event, self.league)
        self.draw_box(top, 0, height, width, title, "accent")
        inner_w, inner_h = width - 4, height - 2
        if not drive:
            lines = [Line().add("ESPN has not published this score's drive.", "dim")]
        else:
            lines = football_drive_plays(drive, event, self.league, inner_w, inner_h,
                                         str(play.get("id")))
        self.draw_lines(lines, top + 1, 2, inner_h, inner_w, 0)
        hint = " j / k another score · enter its clip · esc "
        if side and len(title) + len(hint) + 10 < width:
            self.put(top + height - 1, width - len(hint) - 2, hint, self.palette("muted"))

    # -- headlines on the Scouting tab, and the article card ------------------

    def decorate_news(self, event, panes, inner):
        """Number the Scouting tab's headlines for n / N and enter, and
        highlight the picked one (`panes` is changed in place). Returns where
        each headline is, as (pane, line) pairs."""
        found = []
        for pane_index, (_, body) in enumerate(panes):
            for line_index, line in enumerate(body):
                ref = getattr(line, "news_ref", None)
                if ref is not None:
                    found.append((ref, pane_index, line_index))
        self._news_event = event["id"]
        self._news_refs = [ref for ref, _, _ in found]
        spots = [(pane_index, line_index) for _, pane_index, line_index in found]
        if found:
            # the first News heading says how to open them
            _, pane_index, line_index = found[0]
            heading = panes[pane_index][1][line_index - 1] if line_index else None
            hint = "  n / N pick a headline · enter reads it"
            if heading is not None and heading.text.strip() == "News" and \
                    len(heading.text) + len(hint) <= inner:
                heading.add(hint, "muted")
        chosen = self.news_sel.get(event["id"])
        if chosen is None or not found:
            self._news_follow = False
            return spots
        chosen = clamp(chosen, 0, len(found) - 1)
        self.news_sel[event["id"]] = chosen
        _, pane_index, line_index = found[chosen]
        line = panes[pane_index][1][line_index]
        line[:] = [(text, _on_cursor(style)) for text, style in line]
        used = sum(len(text) for text, _ in line)
        if used < inner:
            line.append((" " * (inner - used), "sel"))
        self._news_focus = (pane_index, line_index)
        return spots

    def draw_scouting(self, top, height, width, event):
        """The Scouting tab: the two panes, the picked headline kept in view
        once n / N picked it, and every headline clickable."""
        panes = self.scouting_panes(event, width)
        spots = self.decorate_news(event, panes, self.pane_width(width))
        if self._news_follow and self._news_focus:
            self._news_follow = False
            self.scroll_into_view(panes, height, width, "Scouting", *self._news_focus)
        self.draw_two_panes(top, height, width, "Scouting", panes)
        for index, (pane_index, line_index) in enumerate(spots):
            spot = self.pane_spot(panes, top, height, width, "Scouting", pane_index,
                                  line_index)
            if spot:
                y, start, end = spot
                self.hot(y, start, end, lambda i=index: self.click_headline(i),
                         lambda i=index: self.click_headline(i, True))

    # -- hockey: the Boxscore's player card and the Plays tab's goal card -----

    def hockey_extras(self, event, summary):
        """What the NHL publishes for this game beyond ESPN (the three stars,
        the coaches, the scratches, the officials), or the AHL's own from its
        summary; {} until it has loaded, or for a game not yet started."""
        if self.league == "ahl":
            extra = (summary or {}).get("sportst") or {}
            stars = []
            for star in extra.get("stars") or []:
                side = side_of(event, (star.get("team") or {}).get("id")) if event else None
                stars.append(dict(star, team=event[side]) if side else star)
            return {"stars": stars, "coaches": extra.get("coaches") or {}}
        if self.league != "nhl" or not event or event.get("state") == "pre":
            return {}
        when = parse_iso(event.get("date"))
        if not when:
            return {}
        day = (when.astimezone(timezone.utc) - timedelta(hours=5)).date()
        result = self.fetcher.get(("nhlextra", event["id"]),
                                  Loader("api-web.nhle.com", nhl_game_extras,
                                         day.isoformat(), event),
                                  ttl=120 if event["state"] == "in" else 3600)
        return result.data or {}

    def hockey_live(self, event):
        """A hockey game's live {pp, pp_left, en} for the Game Center's
        scorebug (7.0.0): the NHL's own situation from its /score page (an
        empty net kept only late, as the wire keeps it), the AHL's power play
        worked out from its penalties at the clock; {} otherwise."""
        if sport_of(self.league) != "hockey" or not event or event.get("state") != "in":
            return {}
        try:
            if self.league == "nhl":
                data = self.nhl_day(Date.today(), live=True)
                game = nhl_match_game(data, event) if data else None
                if not game:
                    return {}
                facts = {"number": _int(event.get("period")),
                         "score": (_int(event["away"].get("score")),
                                   _int(event["home"].get("score")))}
                facts.update(wire_situation(game.get("situation")))
                return late_pull(facts)
            if self.league == "ahl":
                result = self.fetcher.get(("ahlwire", event["id"]),
                                          Loader("lscluster.hockeytech.com", ahl_wire_game,
                                                 event["id"]),
                                          ttl=30, background=True)
                if result.data:
                    side, left = ahl_power_play(result.data, _int(event.get("period")),
                                                event.get("clock"))
                    return {"pp": side, "pp_left": left, "en": None}
        except Exception:  # noqa: BLE001 - a nicety, never a crash
            return {}
        return {}

    def center_face(self, league, ref, cols, rows):
        """A player's photo for the Game Center, where the terminal shows
        pictures; [] elsewhere, and while it downloads."""
        url = ref.get("headshot") or ""
        if not (url and ref.get("id") and self.graphics.enabled):
            return []
        ident = {"id": f"{league}-{ref['id']}", "logo": url}
        png = self.logos.get("photo", ident, raw=True)
        size = png_size(png) if png else None
        if not size:
            return []
        c, r = fit_cells(size, cols, rows, self.cell)
        image_id = self.graphics.place(("photo", league, str(ref["id"])), png, c, r) \
            if c and r else None
        return image_cells(image_id, c, r) if image_id else []

    def center_bulbs(self, text, mode, tone, cols, rows):
        """The score band's number as an old scoreboard's light bulbs: a
        picture of real bulbs drawn at the terminal's own pixel size where it
        shows pictures; on a big screen elsewhere bulbs in text (· for an
        unlit one without colour); [] on a small one (the dot font)."""
        if self.graphics.enabled:
            width, height = int(round(cols * self.cell[0])), int(round(rows * self.cell[1]))
            try:
                png = bulb_picture(text, mode, tone, width, height)
            except Exception:  # noqa: BLE001 - the bulbs in text will do
                png = b""
            image_id = self.graphics.place(("bulbs", text, mode, tone, width, height), png,
                                           cols, rows) if png else None
            if image_id:
                return image_cells(image_id, cols, rows)
        if mode != "big":
            return []
        return bulb_lines(text, tone, BULB if self.palette.enabled else "·")

    def center_positions(self, league, event):
        """{athlete id: (abbreviation, name, number)} for a football game's two teams
        from their ESPN rosters - the roster card's, kept half an hour and
        fetched quietly - so LEADERS can say what each man plays; {} until
        they come."""
        if sport_of(league) != "football" or league not in LEAGUES or \
                not team_rosters(league):
            return {}
        meta = LEAGUES[league]
        memo = getattr(self, "_positions_memo", None)
        if memo is None:
            memo = self._positions_memo = {}
        out = {}
        for side in ("away", "home"):
            team_id = str(event[side].get("id") or "")
            if not team_id:
                continue
            urls = self.api.espn._site(f"{meta['sport']}/{meta['path']}/teams/"
                                       f"{urllib.parse.quote(team_id)}/roster?limit=300",
                                       league)
            data = self.fetcher.get(("roster", league, team_id), urls[0], ttl=1800,
                                    fallbacks=urls[1:], background=True).data
            if not data:
                continue
            seen = memo.get((league, team_id))
            if not seen or seen[0] is not data:
                table = {player["id"]: (player["pos"], player["position"],
                                        player.get("jersey") or "")
                         for _, players in roster_groups(data, league)
                         for player in players if player["id"] and player["pos"]}
                seen = memo[(league, team_id)] = (data, table)
            out.update(seen[1])
        return out

    def center_ball(self, league, cols, rows):
        """Football's ball in the Game Center as a picture of a real football,
        at most cols x rows, drawn at the terminal's own pixel size where it
        shows pictures (a college ball with its stripes); [] elsewhere."""
        if not self.graphics.enabled or cols < 3 or rows < 1:
            return []
        c, r = fit_cells((145, 100), cols, rows, self.cell)   # the ball, its shadow
        if not (c and r):
            return []
        width, height = int(round(c * self.cell[0])), int(round(r * self.cell[1]))
        college = league in COLLEGE_LEAGUES
        try:
            png = football_picture(width, height, college)
        except Exception:  # noqa: BLE001 - the half blocks will do
            return []
        image_id = self.graphics.place(("football", college, width, height), png, c, r) \
            if png else None
        return image_cells(image_id, c, r) if image_id else []

    def player_photo(self, league, ref, profile, cols, rows):
        """A player's photo for a box of at most cols x rows: the real photo
        where the terminal shows pictures, drawn in blocks when Team logos is
        drawn, else his number on a badge in his team's colours."""
        url = (profile or {}).get("photo") or ref.get("headshot") or ""
        ident = {"id": f"{league}-{ref.get('id')}", "logo": url}
        if url and ref.get("id") and self.graphics.enabled:
            png = self.logos.get("photo", ident, raw=True)
            size = png_size(png) if png else None
            if size:
                c, r = fit_cells(size, cols, rows, self.cell)
                image_id = self.graphics.place(("photo", league, str(ref["id"])), png, c, r) \
                    if c and r else None
                if image_id:
                    return image_cells(image_id, c, r)
        if self.logo_style == "off" or self.team_logos == "off":
            return []
        self.palette.logo_begin(("photo", league, str(ref.get("id")), self.team_logos))
        if url and ref.get("id") and self.team_logos == "drawn":
            image = self.logos.get("photo", ident)
            if image is not None:
                return render_logo(image, cols, rows, self.logo_style)
        number = (profile or {}).get("jersey") or ref.get("jersey") or ""
        if number:
            badge = dict(ref.get("team") or {})
            badge["abbr"] = number
            return render_badge(badge, league, cols, rows)
        return []

    def draw_boxscore(self, top, height, width, event, summary, panes):
        """A hockey box score: the two teams' tables, the picked player's row
        highlighted, and his card along the bottom (photo, who he is, his
        game, his season, his last games). With nobody picked, the game's
        three stars fill that room when the tables leave it empty."""
        found = []
        for pane_index, (_, body) in enumerate(panes):
            for line_index, line in enumerate(body):
                ref = getattr(line, "player_ref", None)
                if ref is not None:
                    found.append((ref, pane_index, line_index))
        self._box_event = event["id"]
        self._box_refs = [ref for ref, _, _ in found]
        chosen = self.box_sel.get(event["id"])
        if chosen is not None and not found:
            chosen = None
        elif chosen is not None:
            chosen = clamp(chosen, 0, len(found) - 1)
            self.box_sel[event["id"]] = chosen
        if width < self.SPLIT_MIN_WIDTH:
            longest = sum(len(body) for _, body in panes) + 2 * len(panes) - 1
        else:
            longest = max(len(body) for _, body in panes)
        free = height - 2 - longest
        card = 0
        if chosen is not None:
            card = max(12, free)
            if self.box_expand:
                card = max(card, height * 2 // 3)
            card = min(card, height - 8)
            if card < 7:
                card = 0
        elif free >= 8 and self.box_stars(event, summary):
            card = min(free, 16)
        elif sport_of(self.league) in ("football", "baseball") and height >= 36 and \
                self.box_stars(event, summary):
            card = 12
        elif free >= 3:
            card = 3            # a line saying how to pick a player
        inner = self.pane_width(width)
        if chosen is not None:
            _, pane_index, line_index = found[chosen]
            line = panes[pane_index][1][line_index]
            line[:] = [(text, _on_cursor(style)) for text, style in line]
            used = sum(len(text) for text, _ in line)
            if used < inner:
                line.append((" " * (inner - used), "sel"))
            if self._box_follow:
                self._box_follow = False
                self.scroll_into_view(panes, height - card, width, "Boxscore", pane_index,
                                      line_index)
        self.draw_two_panes(top, height - card, width, "Boxscore", panes)
        for index, (_, pane_index, line_index) in enumerate(found):
            spot = self.pane_spot(panes, top, height - card, width, "Boxscore", pane_index,
                                  line_index)
            if spot:
                y, start, end = spot
                self.hot(y, start, end, lambda i=index: self.click_player(i),
                         lambda i=index: self.click_player(i, True))
        if not card:
            return
        if chosen is not None:
            self.draw_player_card(top + height - card, card, width, found[chosen][0],
                                  summary)
        else:
            self.draw_stars_card(top + height - card, card, width, event, summary)

    def draw_player_card(self, top, height, width, ref, summary=None):
        league = self.league
        profile, loading, error = {}, False, None
        if ref.get("id"):
            key, loader = player_profile_source(league, ref)
            result = self.fetcher.get(key, loader, ttl=6 * 3600)
            profile, loading, error = result.data or {}, result.loading, result.error
        team = ref.get("team") or {}
        title = (f"#{ref['jersey']} " if ref.get("jersey") else "") + (ref.get("name") or "?")
        if team.get("abbr"):
            title += f" · {team['abbr']}"
        self.draw_box(top, 0, height, width, title, "accent")
        inner_w, inner_h = width - 4, height - 2
        rows = min(inner_h, 10)
        art = self.player_photo(league, ref, profile, min(26, max(18, inner_w // 6)), rows)
        art_w = max((sum(len(t) for t, _ in line) for line in art), default=0)
        if art:
            self.draw_lines(art, top + 1, 2, inner_h, art_w, 0)
        text_x = 2 + (art_w + 3 if art else 0)
        text_w = width - 2 - text_x
        night = []
        if summary is not None and sport_of(league) == "basketball" and inner_h >= 20:
            # his shots and his night, play by play, under the rest: the
            # list of his past games gives up rows for it
            night = player_night_lines(summary, league, ref, inner_w,
                                       max(11, inner_h // 2) - 1)
        text_rows = max(len(art), inner_h - len(night) - 1) if night else inner_h
        lines = player_card_text(ref, profile, league, text_w, text_rows, loading=loading,
                                 error=error if not profile else None)
        self.draw_lines(lines, top + 1, text_x, inner_h, text_w, 0)
        if night:
            below = 1 + max(len(lines), len(art)) + 1
            self.draw_lines(night, top + below, 2, max(0, inner_h + 1 - below), inner_w, 0)
        elif summary is not None and sport_of(league) == "basketball" \
                and inner_h - len(lines) - 1 >= 4:
            # a short card: his night, without the court, under his numbers
            room = inner_h - len(lines) - 1
            night = player_night_lines(summary, league, ref, text_w, room, court=False)
            if night:
                self.draw_lines(night, top + 1 + len(lines) + 1, text_x, room, text_w, 0)
        hint = f" enter {'smaller' if self.box_expand else 'bigger'} · w " \
               f"{their(self.league)} page · esc "
        if len(title) + len(hint) + 10 < width:
            self.put(top + height - 1, width - len(hint) - 2, hint, self.palette("muted"))

    def box_stars(self, event, summary):
        """The players the Boxscore shows when nobody is picked: hockey's
        three stars; basketball's top three by game score; football's by
        fantasy points."""
        if sport_of(self.league) == "hockey":
            return self.hockey_extras(event, summary).get("stars") or []
        if sport_of(self.league) in ("football", "baseball"):
            stars = []
            ranked = (football_performers if sport_of(self.league) == "football"
                      else baseball_performers)(self._box_refs)
            for place, (value, index) in enumerate(ranked[:3], 1):
                ref = self._box_refs[index]
                stars.append({"star": place, "ref": index, "name": ref.get("name"),
                              "jersey": ref.get("jersey"), "team": ref.get("team") or {},
                              "pos": ref.get("pos"), "photo": ref.get("headshot"),
                              "player_id": ref.get("id"),
                              "label": f"{('1st', '2nd', '3rd')[place - 1]} · "
                                       f"{round(value, 1):g} fantasy pts"})
            return stars
        stars = []
        for place, (value, index) in enumerate(bball_performers(self._box_refs)[:3], 1):
            ref = self._box_refs[index]
            stars.append({"star": place, "ref": index, "name": ref.get("name"),
                          "jersey": ref.get("jersey"), "team": ref.get("team") or {},
                          "pos": ref.get("pos"), "photo": ref.get("headshot"),
                          "player_id": ref.get("id"),
                          "label": f"{('1st', '2nd', '3rd')[place - 1]} · game score "
                                   f"{value:.1f}"})
        return stars

    def star_ref(self, star):
        """Which of the box score's players a star is (by team and number)."""
        if isinstance(star.get("ref"), int):
            return star["ref"]
        team = (star.get("team") or {}).get("abbr") or ""
        for index, ref in enumerate(self._box_refs):
            if star.get("jersey") and ref.get("jersey") == star.get("jersey") and \
                    (ref.get("team") or {}).get("abbr") == team:
                return index
        return None

    def draw_stars_card(self, top, height, width, event, summary):
        """The game's three stars along the bottom of the Boxscore: each one's
        photo (where the terminal shows pictures), his line in this game,
        his season and his last ten, and a click opens his own card."""
        stars = self.box_stars(event, summary)[:3]
        hoops = sport_of(self.league) == "basketball"
        title = "Top performers · by game score" if hoops else (
            "Top performers · by fantasy points" if sport_of(self.league) == "football"
            else "Three stars")
        self.draw_box(top, 0, height, width, title if stars else "Players", "accent")
        inner_w, inner_h = width - 4, height - 2
        hint = f"j / k pick a player for {their(self.league)} photo, profile, season and " \
               "last games"
        if not stars:
            self.draw_lines([Line().add(hint[:inner_w], "muted")], top + 1, 2, inner_h,
                            inner_w, 0)
            return
        gap = 3
        block_w = (inner_w - gap * (len(stars) - 1)) // len(stars)
        for index, star in enumerate(stars):
            x = 2 + index * (block_w + gap)
            at = self.star_ref(star)
            ref = self._box_refs[at] if at is not None else None
            profile = {}
            if ref and ref.get("id") and inner_h >= 8:
                profile = self.fetcher.get(*player_profile_source(self.league, ref),
                                           ttl=6 * 3600).data or {}
            art = []
            photo = star.get("photo") or (profile or {}).get("photo") or \
                (ref or {}).get("headshot") or ""
            if self.graphics.enabled and photo and inner_h >= 4:
                ident = {"id": f"{self.league}-star-{star.get('player_id') or star['name']}",
                         "logo": photo}
                png = self.logos.get("photo", ident, raw=True)
                size = png_size(png) if png else None
                if size:
                    c, r = fit_cells(size, min(16, block_w // 3), min(inner_h - 1, 7),
                                     self.cell)
                    image_id = self.graphics.place(("star", self.league, ident["id"]), png,
                                                   c, r) if c and r else None
                    if image_id:
                        art = image_cells(image_id, c, r)
            art_w = max((sum(len(t) for t, _ in line) for line in art), default=0)
            if art:
                self.draw_lines(art, top + 1, x, inner_h, art_w, 0)
            text_x = x + (art_w + 2 if art else 0)
            text_w = max(8, block_w - (art_w + 2 if art else 0))
            team = star.get("team") or {}
            rank = star.get("star") or index + 1
            first = Line().add(star["label"], "star") if star.get("label") else \
                Line().add(STAR * rank, "star").add(
                    f"  {('first', 'second', 'third')[min(rank, 3) - 1]} star", "muted")
            text = [first, Line().add(star.get("name") or "?", THEME.style(
                self.league, team, bold=True, fallback="accent"))]
            tags = [f"#{star['jersey']}" if star.get("jersey") else "",
                    (profile or {}).get("position") or star.get("pos") or "",
                    team.get("abbr") or ""]
            text.append(Line().add(" · ".join(t for t in tags if t), "muted"))
            if star.get("line"):
                text.append(Line().add(star["line"], "bold"))
            if ref:
                text.append(blank())
                text.extend(stat_rows("Tonight", tonight_pairs(ref), text_w))
                season = season_pairs(profile)
                if any(value not in (None, "") for _, value in season):
                    text.extend(stat_rows(season_caption(profile), season, text_w))
                games = (profile or {}).get("games") or []
                if games:
                    last = list(reversed(games[:10]))
                    key = (profile.get("spark") or ("PTS",))[0] if \
                        profile.get("sport") == "football" else \
                        ("SV%" if profile.get("goalie") else "PTS")
                    bars = spark([_number(str(g["stats"].get(key) or "").replace(",", ""))
                                  for g in last])
                    if bars.strip():
                        text.append(Line().add(f"{'Last ' + str(len(last)):<9}", "accent").add(
                            bars, THEME.style(self.league, team, bold=True, fallback="accent")))
                text.append(Line().add(f"click for {their(self.league)} card", "dim"))
                for row in range(inner_h):
                    self.hot(top + 1 + row, x, x + block_w,
                             lambda i=at: self.click_player(i),
                             lambda i=at: self.click_player(i, True))
            self.draw_lines([fit_line(line, text_w) for line in text], top + 1, text_x,
                            inner_h, text_w, 0)
        if len(hint) + 16 < width:
            self.put(top + height - 1, width - len(hint) - 4, f" {hint} ",
                     self.palette("muted"))

    def click_player(self, index, open_it=False):
        """A player's row on the Boxscore: the first click picks him, a click
        on the picked one (or a double click) makes his card bigger."""
        event = self.current_event()
        if not event or not 0 <= index < len(self._box_refs):
            return False
        again = self.clicked_again("player", event["id"], index)
        self.box_sel[event["id"]] = index
        if again or open_it:
            self.box_expand = not self.box_expand
            return True
        return False

    def handle_boxscore_key(self, key):
        """On a Boxscore with players' cards (hockey, basketball, football):
        j / k pick a player, enter makes his card bigger (and smaller again),
        w opens his page in the browser, esc lets go of him."""
        event = self.current_event()
        if self.league not in CARD_LEAGUES or not event:
            return False
        refs = self._box_refs if self._box_event == event["id"] else []
        if not refs:
            return False
        current = self.box_sel.get(event["id"])
        if key in (ord("j"), curses.KEY_DOWN, ord("k"), curses.KEY_UP):
            step = 1 if key in (ord("j"), curses.KEY_DOWN) else -1
            if current is None:
                current = 0 if step > 0 else len(refs) - 1
            else:
                current = clamp(current + step, 0, len(refs) - 1)
            self.box_sel[event["id"]] = current
            self._box_follow = True
            return True
        if key in (10, 13, curses.KEY_ENTER):
            if current is None:
                self.box_sel[event["id"]] = 0
                self._box_follow = True
            else:
                self.box_expand = not self.box_expand
            return True
        if key == 27 and current is not None:
            self.box_sel.pop(event["id"], None)
            self.box_expand = False
            return True
        if key == ord("w") and current is not None:
            ref = refs[clamp(current, 0, len(refs) - 1)]
            profile = self.fetcher.get(*player_profile_source(self.league, ref),
                                       ttl=6 * 3600).data if ref.get("id") else None
            web = {"nhl": "nhl", "nba": "nba", "cbb": "mens-college-basketball",
                   "nfl": "nfl", "cfb": "college-football",
                   "mlb": "mlb"}.get(self.league, "nhl")
            url = (profile or {}).get("url") or (
                AHL_PLAYER_PAGE.format(ref["id"]) if self.league == "ahl" else
                f"https://www.espn.com/{web}/player/_/id/{ref['id']}") if ref.get("id") else ""
            if not url:
                self.status_message = "No page for this player."
            elif open_in_browser(url):
                self.status_message = f"↗ Opening {ref.get('name') or 'his'} page in your browser."
            else:
                self.status_message = f"⚠ No browser found to open {url}"
            return True
        return False

    def goal_card_height(self, panes, height, width, event, summary):
        """Rows for the bottom of the Plays tab: the picked goal's card, or with
        none picked, the game's shot map and its flow in whatever room the
        lists leave."""
        if width < self.SPLIT_MIN_WIDTH:
            longest = sum(len(body) for _, body in panes) + 2 * len(panes) - 1
        else:
            longest = max(len(body) for _, body in panes)
        free = height - 2 - longest
        picked = self.play_sel.get(event["id"]) is not None and bool(self._play_refs)
        if picked:
            card = min(max(12, free), height - 8)
            return card if card >= 8 else 0
        if width < self.SPLIT_MIN_WIDTH:
            return 0        # one column: the map and the flow follow the lists
        if free >= 10 and len([s for s in hockey_shots(summary, event) if not s["goal"]]) >= 3:
            return min(free, 24)
        return 0

    def draw_section(self, top, left, height, width, title, note=""):
        """A titled box inside a section, in the style of the Plays tab's other
        boxes (plays_sections): the title upper case, a note after it."""
        self.draw_box(top, left, height, width, title.upper(), "title", "subborder")
        if note and width > len(title) + 12:
            room = width - len(title) - 8
            self.put(top, left + 4 + len(title), f" {note[:room]} ", self.palette("muted"))

    def draw_goal_card(self, top, height, width, event, summary):
        """The picked goal's card along the bottom of hockey's Plays tab, its
        parts in boxes of their own (7.1.0): WHERE IT CAME FROM - the rink
        with the game's shots, this goal ringed, and its key; THE GOAL - when,
        the score, the scorer, the assists, the shot and the goalie, beside
        the scorer's photo; and with the room under it GAME FLOW with this
        goal ringed. The keys sit in the card's bottom border."""
        league = self.league
        refs = self._play_refs
        chosen = self.play_sel.get(event["id"])
        if chosen is None or not refs:
            self.draw_shots_and_flow(top, height, width, event, summary)
            return
        play = refs[clamp(chosen, 0, len(refs) - 1)]
        number = dig(play, "period", "number", default=0)
        side = side_of(event, dig(play, "team", "id"))
        title = f"Goal · {period_tag(league, number)} " \
                f"{clean(dig(play, 'clock', 'displayValue', default='') or '')}"
        if side:
            title += f" · {event[side]['abbr']}"
        self.draw_box(top, 0, height, width, title, "accent")
        clip = self._play_clips.get(chosen)
        keys = goal_card_keys(clip)
        keys_below = len(keys) + 8 <= width
        if keys_below:
            self.put(top + height - 1, width - len(keys) - 4, f" {keys} ",
                     self.palette("muted"))
        x, y, room_w, room_h = 2, top + 1, width - 4, height - 2
        # WHERE IT CAME FROM: as wide as the rink, which is as tall as the room
        # under the box's borders and the key lets it (about a fifth as tall as
        # it is wide), and no wider than two fifths of the card
        focus = goal_focus(play, summary, event)
        shots = hockey_shots(summary, event)
        map_w = 0
        if (shots or focus) and room_w >= 64 and room_h >= 8:
            most, key_rows = room_w * 2 // 5 - 4, 1
            for _ in range(2):          # the key takes a second row on a narrow rink
                rink_cols = min(most, int((room_h - 2 - key_rows) / 0.2125))
                key = rink_key(event, league, rink_cols, bool(focus))
                if len(key) == key_rows:
                    break
                key_rows = len(key)
            if rink_cols >= 24:
                rink = rink_lines(shots + ([focus] if focus else []), event, league,
                                  rink_cols)[: room_h - 2 - len(key)]
                map_w = rink_cols + 4
                self.draw_section(y, x, room_h, map_w, "Where it came from")
                body = rink + key
                pad = max(0, (room_h - 2 - len(body)) // 2)
                self.draw_lines(body, y + 1 + pad, x + 2, room_h - 2 - pad, rink_cols, 0)
        if map_w:
            x, room_w = x + map_w + 1, room_w - map_w - 1
        # THE GOAL: the words, the scorer's photo on the right of them
        png, art_w, art_rows = None, 0, 0
        photo, ident = "", ""
        for part in play.get("participants") or []:
            if isinstance(part, dict) and part.get("type") == "scorer":
                photo = clean(dig(part, "athlete", "headshot", "href", default="") or "")
                ident = str(dig(part, "athlete", "id", default="") or "")
                break
        if photo and self.graphics.enabled and room_w - 4 > 56 and room_h >= 6:
            png = self.logos.get("photo", {"id": f"{league}-{ident}", "logo": photo}, raw=True)
            size = png_size(png) if png else None
            if size:
                art_w, art_rows = fit_cells(size, 16, min(room_h - 2, 7), self.cell)
        beside = art_w + 2 if art_w and art_rows else 0
        if not beside:
            art_w = art_rows = 0

        def words(width):
            return goal_card_text(play, summary, event, league, width, room_h - 2, clip,
                                  hints=not keys_below)
        mark = hockey_clock_seconds(play, league)
        goal_w, text_w = room_w, room_w - 4 - beside
        lines = words(text_w)
        goal_h = max(len(lines), art_rows) + 2
        # GAME FLOW, this goal ringed on it: under THE GOAL where a chart of
        # four rows fits there; else on a wide card beside it, THE GOAL as
        # wide as its words; else not at all, THE GOAL the whole height
        what, flow, box = None, [], None
        if room_h - goal_h >= 9 and room_w >= 44:
            what, flow = hockey_flow(summary, event, league, room_w - 4,
                                     rows=min(room_h - goal_h - 5, 12), mark=mark)
            box = (y + goal_h, x, room_h - goal_h, room_w)
        if not flow and room_w >= 100 and room_h >= 9:
            text_w = max(len(line.text) for line in words(56))
            goal_w = text_w + 4 + beside
            flow_w = room_w - goal_w - 1
            if flow_w >= 44:
                what, flow = hockey_flow(summary, event, league, flow_w - 4,
                                         rows=min(room_h - 5, 14), mark=mark)
                lines = words(text_w)
                box = (y, x + goal_w + 1, room_h, flow_w)
            if not flow:
                goal_w, text_w = room_w, room_w - 4 - beside
                lines = words(text_w)
        if not flow or box[0] == y:
            goal_h = room_h
        self.draw_section(y, x, goal_h, goal_w, "The goal")
        if beside:
            image_id = self.graphics.place(("photo", league, ident), png, art_w, art_rows)
            if image_id:
                self.draw_lines(image_cells(image_id, art_w, art_rows), y + 1,
                                x + goal_w - 2 - art_w, goal_h - 2, art_w, 0)
        self.draw_lines(lines, y + 1, x + 2, goal_h - 2, text_w, 0)
        if flow:
            top_f, left_f, flow_h, flow_w = box
            self.draw_section(top_f, left_f, flow_h, flow_w, "Game flow", what)
            pad = max(0, (flow_h - 2 - len(flow)) // 2)
            self.draw_lines(flow, top_f + 1 + pad, left_f + 2, flow_h - 2 - pad, flow_w - 4, 0)

    def draw_shots_and_flow(self, top, height, width, event, summary):
        """With no goal picked, the bottom of the Plays tab: the game's shot map
        and, beside it, its flow - each in a box of its own."""
        league = self.league
        inner_h = height - 2
        hint = "j / k pick a goal for where it came from, how and who set it up"
        split = width >= self.SPLIT_MIN_WIDTH
        rink_cols = max(30, min(int((inner_h - 2) * 400 / 85), (width // 2 if split else width) - 4))
        if split:
            map_w = rink_cols + 4
            flow_w = width - map_w
        else:
            map_w, flow_w = width, 0
        flow = []
        what = None
        if flow_w >= 40:
            what, flow = hockey_flow(summary, event, league, flow_w - 4,
                                     rows=clamp(inner_h - 5, 4, 14))
        if not flow:
            map_w, flow_w = width, 0
            rink_cols = max(30, min(int((inner_h - 2) * 400 / 85), width - 4))
        self.draw_box(top, 0, height, map_w, "Shot map · every shot and goal", "accent")
        lines = hockey_shot_map(summary, event, league, rink_cols)[1:]
        if not flow:
            lines.append(Line().add(hint[: map_w - 4], "muted"))
        x = 2 + max(0, (map_w - 4 - rink_cols) // 2)
        self.draw_lines(lines, top + 1, x, inner_h, map_w - 2 - x, 0)
        if flow:
            self.draw_box(top, map_w, height, flow_w, f"Game flow · {what}", "accent")
            # the chart sits in the middle of its box, the hint at the bottom
            pad = max(0, (inner_h - len(flow) - 2) // 2)
            self.draw_lines(flow, top + 1 + pad, map_w + 2, inner_h - pad, flow_w - 4, 0)
            self.put(top + height - 2, map_w + 2, hint[: flow_w - 4], self.palette("muted"))

    def pane_position(self, panes, width, pane_index, line_index):
        """Which row of the scrolled content a pane's line is: its own row
        side by side, or counted down the stack on a narrow screen (a blank
        and the title before each pane), as draw_two_panes lays them out."""
        if width >= self.SPLIT_MIN_WIDTH or len(panes) < 2:
            return line_index
        position = 0
        for index, (title, body) in enumerate(panes):
            if index:
                position += 1
            if title:
                position += 1
            if index == pane_index:
                return position + line_index
            position += len(body)
        return position

    def split_focus(self, key, lengths, view, names=None):
        """Which of a screen's side-by-side panes (or, since 7.0.0, its boxes
        that scroll on their own) the keys scroll (6.22.0): the one picked
        (tab, the wheel, a cursor moving into it), else the first that has
        anything to scroll. `view`: the rows each shows (one number for all);
        `names` say where tab goes. Notes the screen as drawn in panes."""
        self._split_drawn = key
        views = list(view) if isinstance(view, (list, tuple)) else [view] * len(lengths)
        over = [length > rows for length, rows in zip(lengths, views)]
        self._split_scrolls = any(over)
        self._split_over = over
        self._split_names = list(names) if names else (
            ["left side", "right side"] if len(lengths) == 2 else
            [f"pane {n + 1}" for n in range(len(lengths))])
        if key in self.pane_focus:
            return clamp(self.pane_focus[key], 0, len(lengths) - 1)
        return over.index(True) if any(over) else 0

    def focused_pane(self, key):
        over = getattr(self, "_split_over", [False, False])
        if key in self.pane_focus:
            return self.pane_focus[key]
        return over.index(True) if any(over) else 0

    def wheel_pane(self, key, index, step):
        """The wheel over one of two side-by-side panes: that pane scrolls, and
        is the one the keys scroll from then on (6.22.0)."""
        self.pane_focus[key] = index
        dict.__setitem__(self.scroll, (key, index), max(0, self.scroll[(key, index)] + step))
        self.dirty = True

    def scroll_panes(self, key, step, to=None):
        """Scroll a screen `step` rows (or `to` a row): the focused pane alone
        when its two stand side by side (6.22.0), else the whole screen."""
        if self._split_drawn == key:
            target = (key, self.focused_pane(key))
            value = to if to is not None else self.scroll[target] + step
            dict.__setitem__(self.scroll, target, max(0, value))
        else:
            self.scroll[key] = max(0, to if to is not None else self.scroll[key] + step)

    def pane_hints(self, hints):
        """The bottom line's keys with tab telling where it goes on a screen of
        two panes with something to scroll (6.22.0)."""
        key = self.tab_name
        if self._split_drawn != key or not getattr(self, "_split_scrolls", False) or \
                self.center or self.show_help or self.show_info:
            return hints
        focus = self.focused_pane(key)
        nxt, prv = self.pane_neighbours(key)
        names = getattr(self, "_split_names", ["left side", "right side"])
        label = names[nxt] if nxt is not None and nxt < len(names) else "next tab"
        out = [(k, label if k == "tab" else text) for k, text in hints]
        if not any(k == "tab" for k, _ in out):
            out.insert(1 if out else 0, ("tab", label))
        if prv is not None and prv < len(names):
            out.insert(2 if len(out) > 1 else len(out), ("⇧tab", names[prv]))
        return out

    def pane_neighbours(self, key):
        """(the next, the previous) pane with something to scroll from the
        focused one, None where there is none (7.0.0)."""
        if self._split_drawn != key:
            return None, None
        over = getattr(self, "_split_over", [])
        focus = self.focused_pane(key)
        nxt = next((i for i in range(focus + 1, len(over)) if over[i]), None)
        prv = next((i for i in range(focus - 1, -1, -1) if over[i]), None)
        return nxt, prv

    def pane_spot(self, panes, top, height, width, key, pane_index, line_index):
        """(screen row, first column, end column) of a pane's line as drawn,
        or None when it is scrolled out of view."""
        if width >= self.SPLIT_MIN_WIDTH and len(panes) >= 2:
            row = line_index - self.scroll[(key, pane_index)]
        else:
            row = self.pane_position(panes, width, pane_index, line_index) - self.scroll[key]
        if not 0 <= row < height - 2:
            return None
        if width < self.SPLIT_MIN_WIDTH:
            return top + 1 + row, 2, width - 2
        left_width = width // 2
        x, w = (0, left_width) if pane_index == 0 else (left_width, width - left_width)
        return top + 1 + row, x + 2, x + w - 2

    def scroll_into_view(self, panes, height, width, key, pane_index, line_index):
        """Scroll two panes so a line of one is in view, with a line of
        room around it."""
        split = width >= self.SPLIT_MIN_WIDTH and len(panes) >= 2
        line_index = self.pane_position(panes, width, pane_index, line_index)
        view = height - 2
        target = (key, pane_index) if split else key
        offset = self.scroll[target]
        if line_index < offset + 1:
            offset = max(0, line_index - 2)
        elif line_index >= offset + view - 1:
            offset = line_index - view + 3
        if split:
            # the cursor's pane is the one the keys scroll now (6.22.0)
            dict.__setitem__(self.scroll, target, max(0, offset))
            self.pane_focus[key] = pane_index
        else:
            self.scroll[key] = max(0, offset)

    def news_hint(self, ref):
        kind = news_kind(ref)
        mark = "▶" if kind == "video" else "›"
        return f"{mark} {clean(ref.get('headline') or '')} · enter opens it"

    def handle_scouting_key(self, key):
        """n / N pick the next / previous headline on the Scouting tab, enter
        opens the picked one in the article card (or, with none picked,
        picks the first), esc lets go of it."""
        event = self.current_event()
        refs = self._news_refs if event and self._news_event == event["id"] else []
        if not refs:
            return False
        current = self.news_sel.get(event["id"])
        if key in (ord("n"), ord("N")):
            step = 1 if key == ord("n") else -1
            if current is None:
                current = 0 if step > 0 else len(refs) - 1
            else:
                current = (current + step) % len(refs)
            self.news_sel[event["id"]] = current
            self._news_follow = True
            self.status_message = self.news_hint(refs[min(current, len(refs) - 1)])
            return True
        if key in (10, 13, curses.KEY_ENTER):
            if current is None:
                self.news_sel[event["id"]] = 0
                self._news_follow = True
                self.status_message = self.news_hint(refs[0])
                return True
            current = min(current, len(refs) - 1)
            self.open_article(refs[current], current)
            return True
        if key == 27 and current is not None:
            self.news_sel.pop(event["id"], None)
            return True
        return False

    def click_headline(self, index, open_it=False):
        """A headline on the Scouting tab: the first click picks it, a click
        on the picked one (or a double click) opens it."""
        event = self.current_event()
        if not event or not 0 <= index < len(self._news_refs):
            return False
        again = self.clicked_again("news", event["id"], index)
        self.news_sel[event["id"]] = index
        if again or open_it:
            self.open_article(self._news_refs[index], index)
            return True
        self.status_message = self.news_hint(self._news_refs[index])
        return False

    def open_article(self, ref, index=None):
        self.article = {"ref": ref, "league": self.league, "event": self._news_event,
                        "index": index, "scroll": 0}
        self.dirty = True

    def article_data(self):
        """The open card's story (or video) from ESPN's content API."""
        url = article_api_url(self.article["ref"])
        if not url:
            return Result(None, "no link to the story", False, 0.0)
        result = self.fetcher.get(("article", url), url, ttl=3600)
        if result.data is None and result.error and not result.loading:
            # a story that failed is asked for again a minute later, not an hour
            result = self.fetcher.get(("article", url), url, ttl=60)
        return result

    def article_step(self, step):
        """The next / previous headline, opened in the card in place."""
        art = self.article
        refs = self._news_refs if self._news_event == art.get("event") else []
        if not refs or art.get("index") is None:
            self.status_message = "Only this one - close the card to pick another."
            return
        index = (art["index"] + step) % len(refs)
        if art.get("event"):
            self.news_sel[art["event"]] = index
        self._news_follow = True
        self.open_article(refs[index], index)
        self.article["event"] = art.get("event")

    def draw_article(self, height, width):
        """The article card: the whole story, scrolled with j / k."""
        art = self.article
        box_width = clamp(width - 4, 40, 100)
        inner = box_width - 6
        result = self.article_data()
        stamp = (id(result.data), inner, result.loading, result.error,
                 bool(self.config.get("clip_video", False)))
        if art.get("_stamp") != stamp:
            art["_stamp"] = stamp
            art["_lines"] = article_lines(art["ref"], result.data, inner,
                                          loading=result.loading, error=result.error,
                                          video_window=stamp[-1])
            art["_video"] = article_video(result.data) if result.data else None
            art["_web"] = article_web_url(art["ref"], result.data)
        lines = art["_lines"]
        # as tall as the story, up to the whole screen; a short one is a card
        box_height = clamp(len(lines) + 4, min(14, height - 2), max(8, height - 4))
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        view = box_height - 4
        art["_view"] = view
        art["scroll"] = clamp(art["scroll"], 0, max(0, len(lines) - view))
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        team = art["ref"].get("team_abbr") or ""
        title = f"{team} news" if team else "News"
        refs = self._news_refs if self._news_event == art.get("event") else []
        if refs and art.get("index") is not None:
            title += f" · {art['index'] + 1} of {len(refs)}"
        self.draw_box(top, left, box_height, box_width, title, "title")
        self.draw_lines(lines, top + 1, left + 3, view, inner, art["scroll"])
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(lines), art["scroll"])
        parts = ["j / k scroll", "space a page"]
        if art.get("_web"):
            parts.append("o espn.com")
        if art.get("_video"):
            parts.append("enter plays the video")
        if len(refs) > 1:
            parts.append("n / N next headline")
        parts.append("esc closes")
        hint = " · ".join(parts)
        if len(hint) > inner:
            hint = " · ".join(p for p in parts if p != "space a page")
        self.put(top + box_height - 2, left + 3, hint[:inner], self.palette("muted"))

    def handle_article_key(self, key):
        """Keys while the article card is open: j / k and the page keys
        scroll; o opens the page in the browser; enter plays the video;
        n / N go to the next / previous headline; esc or q closes."""
        art = self.article
        view = max(1, art.get("_view", 10) - 1)
        steps = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: view, ord(" "): view, ord("J"): view,
                 curses.KEY_PPAGE: -view, ord("K"): -view,
                 curses.KEY_HOME: -10 ** 6, ord("g"): -10 ** 6,
                 curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key == curses.KEY_RESIZE:
            self.apply_background()
        elif key in steps:
            art["scroll"] = max(0, art.get("scroll", 0) + steps[key])
        elif key in (ord("o"), ord("O")):
            web = art.get("_web") or article_web_url(art["ref"])
            if not web:
                self.status_message = "No page on espn.com for this one."
            elif open_in_browser(web):
                self.status_message = f"↗ Opening in your browser: {web}"
            else:
                self.status_message = f"⚠ No browser found to open {web}"
        elif key in (10, 13, curses.KEY_ENTER):
            video = art.get("_video")
            if video:
                title, url, _ = video
                self.play_clip({"title": title or clean(art["ref"].get("headline") or ""),
                                "url": url, "kind": "audio", "source": "ESPN"})
            else:
                self.article = None
        elif key in (ord("n"), ord("N")):
            self.article_step(1 if key == ord("n") else -1)
        elif key == ord("x") and self.player:
            self.stop_clip()
        elif key in (27, ord("q"), curses.KEY_BACKSPACE, 127, 8):
            self.article = None
        return True

    # -- the Playoffs tab: bracket (or picture) and championship odds --------

    def playoff_lines(self, inner_width):
        """(lines, caption) for the bracket, or the playoff picture before
        there is one."""
        meta = LEAGUES[self.league]
        rounds, loading, error = self.load_playoffs()
        caption = (f"{meta['label']} · medal round" if is_olympic(self.league)
