            text = clean(stat.get("rankDisplayValue") or "").replace("Tied-", "T-")
            label = clean(stat.get("shortDisplayName") or stat.get("abbreviation") or "")
            profile["ranks"].append((label, text))
    labels = [clean(str(label)).strip() for label in log.get("labels") or []]
