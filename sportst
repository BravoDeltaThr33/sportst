def open_view(line):
    """The opening numbers shaped like a line, so the same helpers read them."""
    opening = (line or {}).get("open") or {}
    if not opening:
        return None
    view = {
        "spread": opening.get("spread"),
        "total": opening.get("total"),
        "away_ml": opening.get("away_ml"),
        "home_ml": opening.get("home_ml"),
        "favorite": line.get("favorite_open") or _favorite_from_numbers(
            opening.get("spread"), opening.get("away_ml"), opening.get("home_ml")),
    }
    return view


def _stamp(seconds):
    try:
        moment = datetime.fromtimestamp(int(seconds))
    except (TypeError, ValueError, OSError):
        return ""
    return strf(moment, "%a %-I:%M %p")


def _label_cell(line, event, league, width, dim=False):
    """A line label as spans: favourite's abbreviation in its colour."""
    label, team = line_label(line, event, league)
    if not label:
        return [("-".ljust(width), "muted")]
    if team is not None and " " in label:
        abbr, _, rest = label.partition(" ")
        return [(abbr + " ", THEME.style(league, team, bold=not dim, dim=dim)),
                (rest.ljust(max(0, width - len(abbr) - 1)), "dim" if dim else "normal")]
    return [(label.ljust(width), "dim" if dim else "normal")]


def ats_result(event, line, league):
    """How a finished (or running) game stands against the line."""
    live = event.get("state") == "in"
    verb = "covering" if live else "covered"
    favorite = favorite_side(line)
    spread = line.get("spread")
    if not favorite or spread is None or league in MONEYLINE_LEAGUES:
        return None
    fav = event[favorite]
    dog = event["away" if favorite == "home" else "home"]
    if fav["score"] is None or dog["score"] is None:
        return None
    margin = fav["score"] - dog["score"]
    need = abs(spread)
    if margin > need:
        verdict = f"{fav['abbr']} {verb} -{need:g}"
    elif margin == need:
        verdict = f"{'on the number' if live else 'push'} at -{need:g}"
    else:
        verdict = f"{dog['abbr']} {verb} +{need:g}"
    return verdict


def total_result(event, line):
    total = line.get("total")
    away, home = event["away"]["score"], event["home"]["score"]
    if total is None or away is None or home is None:
        return None
    points = away + home
    if points > total:
        verdict = "over"
    elif points < total:
        verdict = "under"
    else:
        verdict = "push"
    return points, verdict


def closing_line_for(event, board=None):
    """A finished game's closing line: Action Network's consensus when its
    board has the game, else the line ESPN left on the scoreboard."""
    game = match_an_game(event, board) if board else None
    books = (game or {}).get("books") or {}
    pick = books.get("Consensus") or average_lines(
        [line for name, line in books.items() if name != "Open"])
    if not pick:
        return event.get("line")
    spread, favorite = pick.get("spread"), None
    if spread:
        favorite = "home" if spread < 0 else "away"
    elif pick.get("home_ml") is not None and pick.get("away_ml") is not None:
        favorite = "home" if pick["home_ml"] < pick["away_ml"] else "away"
    return {"spread": spread, "total": pick.get("total"), "favorite": favorite,
            "provider": "consensus"}


def line_report_lines(events, league, width, board=None, week=False):
    """The day's finished games against their closing lines, for a Betting
    tab with nothing left to bet: the line, who covered, over or under, and
    the day's tally (favourites against the spread, overs, upsets)."""
    done = []
    for event in events:
        if event.get("state") != "post" or event["away"].get("score") is None \
                or event["home"].get("score") is None:
            continue
        line = closing_line_for(event, board)
        if line and (line.get("favorite") or line.get("total") is not None):
            done.append((event, line))
    if not done:
        return []
    money = league in MONEYLINE_LEAGUES
    lines = [heading(f"How the {'week' if week else 'day'}'s lines did").add(
        "  closing lines: the books' consensus, else ESPN's", "muted")]
    covers = {"fav": 0, "dog": 0, "push": 0}
    totals = {"over": 0, "under": 0, "push": 0}
    upsets = []
    for event, line in done:
        away, home = event["away"], event["home"]
        favorite = favorite_side(line)
        row = Line().add("  ")
        row.add(f"{away['abbr']:<5}", THEME.style(league, away, bold=True, fallback="accent"))
        row.add(f"{away['score']:>3}  ", "bold" if away["score"] > home["score"] else "normal")
        row.add(f"{home['abbr']:<5}", THEME.style(league, home, bold=True, fallback="accent"))
        row.add(f"{home['score']:>3}   ", "bold" if home["score"] > away["score"] else "normal")
        spread = line.get("spread")
        if favorite and spread is not None and not money:
            row.add(f"{event[favorite]['abbr']} -{abs(spread):g}".ljust(12), "normal")
        elif favorite:
            row.add(f"{event[favorite]['abbr']} fav".ljust(12), "normal")
        else:
            row.add(" " * 12)
        row.add(f"{line['total']:g}".ljust(8) if line.get("total") is not None else " " * 8,
                "normal")
        ats = ats_result(event, line, league)
        if ats:
            if ats.startswith("push"):
                covers["push"] += 1
            elif favorite and ats.startswith(event[favorite]["abbr"] + " "):
                covers["fav"] += 1
            else:
                covers["dog"] += 1
            row.add(f"{ats:<22}", "good" if not ats.startswith("push") else "muted")
        elif not money:
            row.add(" " * 22)
        total = total_result(event, line)
        if total:
            points, verdict = total
            totals[verdict] += 1
            row.add(f"{points} {verdict}".ljust(12), "accent" if verdict == "over" else "dim")
        if favorite:
            dog = "away" if favorite == "home" else "home"
            if event[dog]["score"] > event[favorite]["score"]:
                upsets.append(event[dog]["abbr"])
                row.add("▲ upset", "upset")
        lines.append(fit_line(row, width))
    tally = []
    if sum(covers.values()):
        tally.append(f"favourites {covers['fav']}-{covers['dog']} against the spread"
                     + (f" ({covers['push']} push{'es' if covers['push'] != 1 else ''})"
                        if covers["push"] else ""))
    if sum(totals.values()):
        tally.append(f"{totals['over']} over, {totals['under']} under"
                     + (f", {totals['push']} push" if totals["push"] else ""))
    tally.append(f"{len(upsets)} underdog{'s' if len(upsets) != 1 else ''} won outright"
                 + (f" ({', '.join(upsets[:6])})" if upsets else ""))
    lines.append(blank())
    lines.extend(wrap_spans(" · ".join(tally), width, "bold"))
    return lines


def render_upset_banner(event, width):
