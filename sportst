    def handle_popup_key(self, key):
        popup = self.popup
        if key in (27, ord("q")):
            if popup.filter:
                popup.filter = ""
                popup.snap()
            else:
                self.popup = None
        elif key in (ord("j"), curses.KEY_DOWN, 9):
            popup.move(1)
        elif key in (ord("k"), curses.KEY_UP, curses.KEY_BTAB, 353):
            popup.move(-1)
        elif key == curses.KEY_NPAGE:
            popup.move(10)
        elif key == curses.KEY_PPAGE:
            popup.move(-10)
        elif key in (curses.KEY_HOME, ord("g")):
            popup.cursor = 0
            popup.snap()
        elif key in (curses.KEY_END, ord("G")):
            popup.cursor = len(popup.visible()) - 1
            popup.snap(-1)
        elif key == ord("/"):
            text = self.prompt("filter: ", popup.filter)
            if text is not None:
                popup.filter = text.strip()
                popup.cursor = 0
                popup.snap()
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            popup.filter = popup.filter[:-1]
            popup.snap()
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            item = popup.chosen()
            self.popup = None
            if item:
                popup.on_pick(item["action"])
        elif key in (ord("p"), ord("e"), ord("c"), ord("s"), ord("b")):
            self.popup = None
        else:
            for item in popup.visible():
                if item.get("hotkey") and key == ord(item["hotkey"]):
                    self.popup = None
                    popup.on_pick(item["action"])
                    break
        return True

    def draw_popup(self, height, width):
        popup = self.popup
        items = popup.visible()
        label_col = min(40, max([len(i["label"]) for i in items if i.get("action")] + [10]) + 4)
        longest = max([label_col + len(i.get("detail", "")) + 2 for i in items] +
                      [len(popup.title) + 6, len(popup.hint) + 4])
        box_width = clamp(longest + 4, 36, width - 4)
        box_height = clamp(len(items) + 5, 7, height - 2)
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        self.draw_box(top, left, box_height, box_width, popup.title, "title")
        view = box_height - 4
        if popup.cursor < popup.offset:
            popup.offset = popup.cursor
        if popup.cursor >= popup.offset + view:
            popup.offset = popup.cursor - view + 1
        popup.offset = clamp(popup.offset, 0, max(0, len(items) - view))
        inner = box_width - 4
        for row in range(view):
            index = popup.offset + row
            if index >= len(items):
                break
            item = items[index]
            y = top + 1 + row
            if item.get("action") is None:
                self.put(y, left + 2, f" {item['label']} "[:inner], self.palette("accent"))
                continue
            chosen = index == popup.cursor
            current = item["action"] == self.league or item["action"] == family(self.league)
            base = "sel" if chosen else "normal"
            text = f"{'▌' if chosen else ' '} {item['label']}"
            detail = item.get("detail", "")
            line = f"{text:<{min(label_col, inner)}}"
            self.put(y, left + 2, " " * inner, self.palette(base))
            self.put(y, left + 2, line[:inner], self.palette("selbar" if chosen else
                                                             ("bold" if current else base)))
            if detail and len(line) < inner:
                self.put(y, left + 2 + len(line), detail[: inner - len(line)],
                         self.palette("seldim" if chosen else "dim"))
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(items), popup.offset)
        footer = popup.hint
        if popup.filter:
            footer = f"filter: {popup.filter}   backspace edits · esc clears"
        self.put(top + box_height - 2, left + 3, footer[: inner], self.palette("muted"))

