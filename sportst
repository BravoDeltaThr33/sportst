    def postseason_days(self, year):
        """The date windows ESPN keeps for college baseball's championship."""
        meta = LEAGUES[self.league]
        days = []
        for season_type in (5, 6):
            url = (f"https://sports.core.api.espn.com/v2/sports/{meta['sport']}/leagues/"
                   f"{meta['path']}/seasons/{year}/types/{season_type}")
            window = self.fetcher.get(("ptype", self.league, year, season_type), url,
                                      ttl=86400)
            start = parse_iso(dig(window.data, "startDate", default="") or "")
            end = parse_iso(dig(window.data, "endDate", default="") or "")
            if not start or not end:
                continue
            day = start.date()
            while day <= end.date() and len(days) < 24:
                days.append(day)
                day += timedelta(days=1)
        return days

    def bracket_is_old(self, season):
        """True when this league's standings already belong to a later season
        with games played, so a bracket from `season` is last year's."""
        primary, fallbacks = self.api.standings(self.league)
        result = self.fetcher.get(("st", self.league), primary, ttl=900, fallbacks=fallbacks)
        year, played = standings_season(result.data)
        return bool(year and played and year > season)

    def load_playoffs(self):
        """(rounds, loading, error). Each league keeps its bracket somewhere
        different, so each one is fetched its own way."""
        year = self.season_year or Date.today().year
        league = self.league
        self._bracket_season = ""
        if league in ("nba", "cbb"):
            for season in (year, year - 1):
                if self.bracket_is_old(season):
                    return [], False, None          # a new season: the picture
                events, loading, error = [], False, None
                for month, urls in basketball_postseason_urls(self.api, league, season):
                    result = self.fetcher.get(("bbpost", league, season, month), urls[0],
                                              ttl=900, fallbacks=urls[1:])
                    loading = loading or result.loading
                    error = error or result.error
                    if result.data:
                        events.extend(parse_scoreboard(result.data))
                rounds = bracket_nba(events) if league == "nba" else bracket_cbb(events)
                if count_real_teams(rounds) >= 2:
                    self._bracket_season = season_label(league, season)
                    return rounds, loading, error
                if loading:
                    return [], True, None
            return [], False, None
        if league == "ahl":
            source, spare = self.api.hockeytech.bracket(league)
            result = self.fetcher.get(("ahlbracket",), source, ttl=900, fallbacks=spare)
            rounds = bracket_ahl(result.data) if result.data else []
            playoff = (result.data or {}).get("season") or {}
            regular = (result.data or {}).get("regular") or {}
            if (regular.get("start_date") or "") > (playoff.get("end_date") or "9"):
                rounds = []                 # last spring's bracket: the new season is on
            if count_real_teams(rounds) < 2:
                rounds = []
            match = re.search(r"(\d{4})", playoff.get("season_name") or "")
            if rounds and match:
                self._bracket_season = season_label("ahl", int(match.group(1)))
            return rounds, result.loading, result.error
        if is_olympic(league):
            result = self.load_scoreboard()
            events = parse_scoreboard(result.data) if result.data else []
            rounds = olympic_bracket(events, league)
            return rounds, result.loading, result.error
        if league == "nhl":
            for season in (year, year - 1):
                if self.bracket_is_old(season):
                    return [], False, None
                result = self.fetcher.get(("nhlbracket", season),
                                          f"{NHL_API}/playoff-bracket/{season}",
                                          ttl=900)
                rounds = bracket_nhl(result.data) if result.data else []
                if count_real_teams(rounds) >= 2:
                    self._bracket_season = season_label(league, season)
                    return rounds, result.loading, result.error
                if result.loading:
                    return [], True, None
            return [], False, None
        if league == "mlb":
            result = self.fetcher.get(
                ("mlbpost", year),
                f"{STATS_API}/schedule/postseason?season={year}&sportId=1", ttl=900)
            teams = self.load_teams()
            by_name = {}
            for team in (parse_teams(teams.data) if teams.data else []):
                by_name[team["name"].lower()] = team
            rounds = bracket_mlb(result.data, by_name) if result.data else []
            if count_real_teams(rounds) < 2:
                rounds = []
            if rounds:
                self._bracket_season = str(year)
            return rounds, result.loading, result.error

        events, loading, error = [], False, None
        if league in ("nfl", "cfb"):
            weeks = [1, 2, 3, 5] if league == "nfl" else [1]
            for week in weeks:
                url, spare = self.api.scoreboard(
                    league, week=week, seasontype=3, year=year,
                    groups=self.cfb_group if league == "cfb" else None)
                result = self.fetcher.get(("post", league, year, week), url, ttl=900,
                                          fallbacks=spare)
                loading = loading or result.loading
                error = error or result.error
                if result.data:
                    events.extend(parse_scoreboard(result.data))
            keep = None
            if league == "cfb":
                keep = lambda headline: "playoff" in headline.lower() or \
                    "national championship" in headline.lower()
            rounds = bracket_from_events(events, league,
                                         NFL_ROUNDS if league == "nfl" else CFB_ROUNDS,
                                         seeds=self.playoff_seeds(), keep=keep)
            if count_real_teams(rounds) < 2:
                rounds = []
            return rounds, loading, error

        for day in self.postseason_days(year):
            url, spare = self.api.scoreboard(league, day=day)
            result = self.fetcher.get(("post", league, day.isoformat()), url, ttl=900,
                                      fallbacks=spare)
            loading = loading or result.loading
            error = error or result.error
            if result.data:
                events.extend(parse_scoreboard(result.data))
        rounds = bracket_from_events(events, league, CBASE_ROUNDS, namer=cbase_round)
        if count_real_teams(rounds) < 2:
            rounds = []
        return rounds, loading, error

    def core_line(self, event):
        """The pre-game line for a game already underway, from the core API."""
        url, fallbacks = self.api.odds(self.league, event["id"])
        result = self.fetcher.get(("odds", self.league, event["id"]), url,
                                  ttl=1800, fallbacks=fallbacks)
        if not result.data:
            return None
        return parse_core_odds(result.data, event["away"], event["home"])

    def prepare_events(self, data):
        events = parse_scoreboard(data) if data else []
        if is_olympic(self.league):
            # a whole tournament in one list: the day goes in front of the status
            for event in events:
                when = parse_iso(event["date"])
                day = when.astimezone().strftime("%b %-d") if when else ""
                if event["state"] == "pre":
                    event["label"] = f"{day} {local_time(event['date'])}".strip()
                else:
                    event["label"] = f"{day} {event['detail']}".strip()
            return events
        if BETTING.enabled and self.league in BETTING_LEAGUES:
            attach_lines(events, self.league, self.book, self.core_line,
                         self.selected_id)
            self.announce_upsets(events)
        return events

    def announce_upsets(self, events):
        live = [e for e in events if e.get("upset") and e["upset"]["level"] == "live"]
        fresh = []
        for event in live:
            key = (self.league, event["id"], event["upset"]["tag"])
            if key not in self.alerted:
                self.alerted.add(key)
                fresh.append(event)
        if not fresh:
            return
        if self.league not in self.alerts_primed:
            # first look at this slate: one summary rather than one per game
            self.alerts_primed.add(self.league)
            if len(fresh) == 1:
                self.flash_upset(fresh[0])
            else:
                self.status_message = f"▲ {len(fresh)} games on upset watch — press U"
                self.status_style = "upset"
        else:
            self.flash_upset(fresh[-1])
        if BETTING.bell:
            try:
                curses.beep()
            except curses.error:
                pass

    def flash_upset(self, event):
        upset = event["upset"]
        self.status_message = (f"▲ {upset['tag']}: {event['short_name']}  "
                               f"{upset['note']}  ({status_text(event)})")
        self.status_style = "upset"

    def at_bat_count(self):
        """How many at-bats the selected game has on record right now."""
        event = self.current_event()
        if not event:
            return 0
        data = self.load_summary(event["id"]).data
        return len(parse_baseball_plays(data)) if data else 0

    def jump_to_upset(self):
        alerts = [i for i, e in enumerate(self.events)
                  if e.get("upset") and e["upset"]["level"] == "live"]
        if not alerts:
            self.status_message = "No games on upset watch right now."
            return
        later = [i for i in alerts if i > self.selected_index]
        target = later[0] if later else alerts[0]
        self.selected_index = target
        self.selected_id = self.events[target]["id"]
        self.detail_scroll = 0
        self.tab = 1

    def save_book(self, force=False):
        now = time.time()
        if force or (self.book.dirty and now - self.last_book_save > 10):
            self.book.save()
            self.last_book_save = now

    def visible_events(self, events):
        out = events
        group = self.group_filter.get(family(self.league), "")
        members = self.team_groups() if not is_wiki_sport(self.league) else {}
        if group:
            if members:
                out = [e for e in out
                       if group in members.get(e["away"]["id"], ())
                       or group in members.get(e["home"]["id"], ())]
        if self.ranked_only and self.league in RANKED_LEAGUES:
            out = [e for e in out if e["away"]["rank"] or e["home"]["rank"]]
        elif self.ranked_only and self.league == "cbase":
            top = self.top25_ids()
            if top:
                out = [e for e in out if e["away"]["id"] in top or e["home"]["id"] in top]
        if self.filter_text:
            needle = self.filter_text.lower()
            out = [e for e in out
                   if needle in e["short_name"].lower()
                   or needle in e["name"].lower()
                   or needle in e["away"]["name"].lower()
                   or needle in e["home"]["name"].lower()]
        return sort_by_favorites(self.favorites, self.league, out)

    def current_event(self):
        if not self.events:
            return None
        return self.events[clamp(self.selected_index, 0, len(self.events) - 1)]

    def sync_selection(self):
        if not self.events:
            self.selected_index = 0
            return
        if self.selected_id:
            for index, event in enumerate(self.events):
                if event["id"] == self.selected_id:
                    self.selected_index = index
                    return
        self.selected_index = clamp(self.selected_index, 0, len(self.events) - 1)
        self.selected_id = self.events[self.selected_index]["id"]

    # -- period label ----------------------------------------------------

    def period_caption(self):
        meta = LEAGUES[self.league]
        if is_olympic(self.league):
            return meta["games"]
        if self.week_mode and meta["week_based"]:
            names = meta["seasontype_names"]
            label = names.get(self.seasontype, "Week")
            if self.seasontype == 3 and self.league == "cfb":
                return "Bowls"
            if not self.week:
                return "This week"
            suffix = "" if self.week_pinned else " (current)"
            if label in ("Pre", "Post"):
                return f"{label} Wk {self.week}{suffix}"
            return f"Week {self.week}{suffix}"
        return self.day.strftime("%A, %B %-d, %Y")

    # -- drawing ---------------------------------------------------------

    def apply_background(self):
        """Fill unwritten cells too, so erase() and the margins stay black."""
        if not (self.palette and self.palette.enabled and self.palette.bg_rgb):
            return
        try:
            self.stdscr.bkgd(" ", self.palette("normal"))
        except curses.error:
            pass

    def corners(self):
        if self.config.get("rounded_borders", True):
            return "╭", "╮", "╰", "╯"
        return "┌", "┐", "└", "┘"

    def draw_box(self, top, left, height, width, title=None, title_style="accent"):
        if height < 2 or width < 2:
            return
        tl, tr, bl, br = self.corners()
        win = self.stdscr
        border = self.palette("border")
        self.put(top, left, tl + "─" * (width - 2) + tr, border)
        self.put(top + height - 1, left, bl + "─" * (width - 2) + br, border)
        for row in range(1, height - 1):
            self.put(top + row, left, "│", border)
            self.put(top + row, left + width - 1, "│", border)
        if title:
            text = f" {title} "[: max(0, width - 4)]
            self.put(top, left + 2, text, self.palette(title_style))

    def put(self, y, x, text, attr=0):
        height, width = self.stdscr.getmaxyx()
        if y < 0 or y >= height or x >= width:
            return
        if x < 0:
            text = text[-x:]
            x = 0
        text = text[: max(0, width - x)]
        if not text:
            return
        try:
            self.stdscr.addstr(y, x, text, attr)
        except curses.error:
            pass

    def draw_lines(self, lines, top, left, height, width, scroll):
        for row in range(height):
            index = scroll + row
            if index >= len(lines):
                break
            x = left
            remaining = width
            for text, style in lines[index]:
                if remaining <= 0:
                    break
                chunk = text[:remaining]
                self.put(top + row, x, cell_text(chunk, style), self.palette(style))
                x += len(chunk)
                remaining -= len(chunk)

    def draw_scrollbar(self, top, left, height, total, scroll):
        if total <= height or height < 3:
            return
        span = max(1, int(height * height / total))
        position = int(scroll * (height - span) / max(1, total - height))
        for row in range(height):
            mark = "█" if position <= row < position + span else "░"
            self.put(top + row, left, mark, self.palette("border"))

    def draw_tabbar(self, width):
        self.draw_box(0, 0, 3, width)
        x = 2
        tabs = self.tabs
        # on a narrow screen the tab names give way before the league does
        full = sum(len(n) + 3 for n in tabs)
        short = full > width - 40
        tiny = sum(len(TAB_SHORT.get(n, n)) + 3 for n in tabs) > width - 6
        for index, name in enumerate(tabs):
            style = "tabsel" if index == self.tab else "tab"
            text = TAB_SHORT.get(name, name) if short else name
            if tiny and index != self.tab:
                text = TAB_TINY.get(name, text[:3])
            label = f" {text} "
            self.put(1, x, label, self.palette(style))
            self.hot(1, x, x + len(label), lambda i=index: self.click_tab(i))
            x += len(label)
            if index < len(tabs) - 1:
                self.put(1, x, "│", self.palette("border"))
                x += 1

        meta = LEAGUES[self.league]
        if is_olympic(self.league):
            right = f" {meta['games']} · {meta['label']} "
        else:
            right = f" {meta['name']} · {self.period_caption()} "
        if self.filter_text:
            right += f"· /{self.filter_text} "
        if self.ranked_only and self.league in COLLEGE_LEAGUES:
            right += "· top 25 "
        if self.group_filter.get(family(self.league)):
            right += f"· {short_group(self.group_filter[family(self.league)])} "
        right += " "
        start = width - len(right) - 2
        if start <= x + 2 and is_olympic(self.league):
            right = f" {meta['label']} "
            start = width - len(right) - 2
        if start > x + 2:
            self.put(1, start, right, self.palette("dim"))

    def draw_footer(self, width, height):
        """One line, always: name and version, refresh state, then whatever
        message there is, trimmed to fit rather than wrapped."""
        try:
            hints = [(key_label(k), label) for k, label in self.screen_hints()]
        except Exception:  # noqa: BLE001 - hints are a nicety, never a crash
            hints = []
        spans, message, style = footer_spans(
            self.auto_refresh, self.interval, self.fetcher.busy(),
            self.fetcher.requests_made, self.status_message or self.player_status(),
            self.fetcher.last_error, width - 2, hints)
        x = 1
        for text, token in spans:
            self.put(height - 1, x, text, self.palette(token))
            x += len(text)
        if message:
            self.put(height - 1, width - len(message) - 1, message, self.palette(style))

    def draw_help(self, height, width):
        """The keys, in as many columns as fit, a section never split; j / k
        scroll when even that is too tall for the screen."""
        sections, current = [], []
        for entry in HELP_TEXT:
            if not entry[0] and not entry[1]:
                if current:
                    sections.append(current)
                current = []
            else:
                current.append(entry)
        if current:
            sections.append(current)
        widest = min(92, max(17 + len(v) for _, v in HELP_TEXT if v) + 3)
        count = clamp((width - 6) // widest, 1, 3)
        total = sum(len(s) for s in sections) + len(sections) - 1
        target = total / count
        columns, column = [], []
        for section in sections:
            if column and len(column) + len(section) > target and len(columns) < count - 1:
                columns.append(column)
                column = []
            if column:
                column.append(("", ""))
            column.extend(section)
        columns.append(column)
        col_width = clamp(widest, 40, (width - 6) // len(columns))
        # a description too long for the column wraps under itself
        room = max(10, col_width - 19)
        wrapped = []
        for block in columns:
            rows = []
            for key, description in block:
                if key and description and len(description) > room:
                    parts = textwrap.wrap(description, room) or [""]
                    rows.append((key, parts[0]))
                    rows.extend((" ", part) for part in parts[1:])
                else:
                    rows.append((key, description))
            wrapped.append(rows)
        columns = wrapped
        tallest = max(len(c) for c in columns)
        box_width = col_width * len(columns) + 4
        box_height = clamp(tallest + 5, 8, height - 2)
        view = box_height - 5
        self.help_scroll = clamp(self.help_scroll, 0, max(0, tallest - view))
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        self.draw_box(top, left, box_height, box_width, f"{APP} {VERSION} · keys", "title")
        for number, block in enumerate(columns):
            x = left + 3 + number * col_width
            for row, (key, description) in enumerate(block[self.help_scroll:
                                                           self.help_scroll + view]):
                y = top + 2 + row
                if key and not description:
                    self.put(y, x, key, self.palette("title"))
                elif key:
                    self.put(y, x, f"{key:<16}", self.palette("accent"))
                    self.put(y, x + 17, description[:room], self.palette("dim"))
        self.draw_scrollbar(top + 2, left + box_width - 2, view, tallest, self.help_scroll)
        hint = "j / k scroll · any other key closes" if tallest > view else \
            "press any key to close"
        self._help_fits = tallest <= view          # then every key closes it
        self.put(top + box_height - 2, left + 3, hint, self.palette("muted"))

    def draw_info(self, height, width):
        """The Info pop-up: what everything on the current screen means."""
        box_width = clamp(width - 4, 40, 112)
        box_height = max(8, height - 4)
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        try:
            sections = info_sections(self)
        except Exception as exc:  # noqa: BLE001 - never let Info take the app down
            sections = [("Info", [(None, f"Could not build this screen's notes: {exc}")])]
        lines = info_lines(sections, box_width - 6)
        view = box_height - 4
        self.info_scroll = clamp(self.info_scroll, 0, max(0, len(lines) - view))
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        title = f"Info · {self.tab_name}"
        if self.article:
            title = "Info · the article card"
        elif self.center:
            title = "Info · " + ("Event Center" if self.center.get("wiki") else "Game Center")
        elif self.tab_name == "Stats" and self.stats_team and self.stats_team[0] == self.league:
            title += " · players"
        title += f" · {LEAGUE_SHORT.get(family(self.league), self.league.upper())}"
        self.draw_box(top, left, box_height, box_width, title, "title")
        self.draw_lines(lines, top + 1, left + 3, view, box_width - 6, self.info_scroll)
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(lines), self.info_scroll)
        hint = "j / k scroll · PgDn / PgUp page · any other key closes"
        if len(lines) <= view:
            hint = "any key closes"
        self._info_fits = len(lines) <= view
        self.put(top + box_height - 2, left + 3, hint, self.palette("muted"))

    def draw(self):
        try:
            self._draw_frame()
        finally:
            self.graphics.flush()      # the pictures this frame named, after curses

    def put_spans(self, y, x, line):
        """One Line at y, x as it is: no clipping beyond the screen's."""
        for text, style in line:
            self.put(y, x, cell_text(text, style), self.palette(style))
            x += len(text)

    def team_art(self, league, team, cols, rows):
        """A team's logo for a box of at most cols x rows cells: the real logo
        where the terminal shows pictures, else its badge or its logo drawn in
        blocks (Settings: Team logos, Logo art); [] for none. The caller has
        started the exact-colour block that a badge or drawn logo uses."""
        if not team or self.team_logos == "off" or self.logo_style == "off":
            return []
        if self.graphics.enabled:
            png = self.logos.get(league, team, raw=True)
            size = png_size(png) if png else None
            if size:
                c, r = fit_cells(size, cols, rows, self.cell)
                key = ("logo", league, str(team.get("id") or team.get("abbr") or ""))
                image_id = self.graphics.place(key, png, c, r) if c and r else None
                if image_id:
                    return image_cells(image_id, c, r)
        if self.team_logos == "drawn":
            image = self.logos.get(league, team)
            if image is not None:
                return render_logo(image, min(cols, LOGO_MAX_COLS), min(rows, LOGO_MAX_ROWS),
                                   self.logo_style)
        # the badge: always to hand, so the layout never waits for a download
        return render_badge(team, league, cols, rows)

    def small_logo(self, league, team, box_w, box_h):
        """A team's logo shrunk to fit box_w x box_h pixels (kept), or None
        while it loads or when there is none."""
        ident = str(team.get("id") or team.get("abbr") or "")
        key = (league, ident, box_w, box_h)
        if key in self._small_logos:
            return self._small_logos[key]
        image = self.logos.get(league, team)
        if image is None:
            return None
        width, height, _ = image
        scale = min(box_w / width, box_h / height) * 0.94
        small = scale_rgba(image, int(width * scale), int(height * scale))
        if len(self._small_logos) > 400:
            self._small_logos.clear()
        self._small_logos[key] = small
        return small

    def logo_column(self, league, teams, top, x, cols=2, selected=-1):
        """Real logos down a list, one a row, where the terminal shows
        pictures: `teams` has a team (or None) for each screen row from
        `top`, and the logos go at column x, `cols` cells wide - all of them
        one picture, so a whole list costs one of the terminal's slots."""
        if not self.graphics.enabled or not any(teams):
            return
        box_w, box_h = max(4, int(cols * self.cell[0])), max(4, int(self.cell[1]))
        # a row may name its own league: (league, team), as the Overview's do
        pairs = [(item if isinstance(item, tuple) else (league, item)) if item else
                 (None, None) for item in teams]
        images = [self.small_logo(where, team, box_w, box_h) if team else None
                  for where, team in pairs]
        if not any(images):
            return
        sig = tuple(f"{where}:{team.get('id') or team.get('abbr')}" if image else ""
                    for (where, team), image in zip(pairs, images))
        key = ("strip", league, sig, box_w, box_h)
        png = self._strip_pngs.get(key)
        if png is None:
            png = logo_strip(images, box_w, box_h)
            if len(self._strip_pngs) > 12:
                self._strip_pngs.clear()
            self._strip_pngs[key] = png
        image_id = self.graphics.place(key, png, cols, len(teams))
        if not image_id:
            return
        for row, image in enumerate(images):
            if image:
                tail = ":s" if row == selected else ""
                self.put_spans(top + row, x, Line(
                    [(PLACEHOLDER, f"!img:{image_id}:{row}:{col}{tail}")
                     for col in range(cols)]))

    def kim_picture(self, frame, cols, rows):
        """Kim's original portrait as a real picture with one mouth: its
        number for placeholder cells, or None."""
        key = (frame, cols, rows)
        png = self._kim_pngs.get(key)
        if png is None:
            png = pixel_png(kim_original(frame), KIM_NES, cols * self.cell[0],
                            rows * self.cell[1])
            self._kim_pngs[key] = png
        return self.graphics.place(("kim", frame), png, cols, rows)

    def _draw_frame(self):
        height, width = self.stdscr.getmaxyx()
        if self.center and height >= 10 and width >= 50:
            # the Game Center takes the whole screen above the BottomLine
            self.stdscr.erase()
            self.hotspots, self.wheel_zones = [], []
            ticker = self.ticker_shown(height, width)
            self._slate_all = ticker
            self.draw_center(height - 1 - (1 if ticker else 0), width - 1)
            if ticker:
                self.draw_ticker(height - 2, width - 1)
            self.draw_footer(width - 1, height)
            if self.show_help or self.show_info:
                self.hotspots, self.wheel_zones = [], []    # clicks go to the pop-up
                (self.draw_help if self.show_help else self.draw_info)(height, width)
            self.stdscr.noutrefresh()
            curses.doupdate()
            return
        if self.kim and self.kim.get("backdrop") == (height, width):
            # Ask Kim animates: redraw the pop-up and the bottom line over the
            # screen already there instead of the whole tab ten times a second
            self.draw_kim(height, width)
            self.put(height - 1, 0, " " * (width - 1), self.palette("normal"))
            self.draw_footer(width - 1, height)
            self.stdscr.noutrefresh()
            curses.doupdate()
            return
        self.stdscr.erase()
        self.hotspots, self.wheel_zones = [], []
        if height < 10 or width < 50:
            self.put(0, 0, "Terminal too small — 50x10 minimum.", self.palette("warn"))
            self.stdscr.noutrefresh()
            curses.doupdate()
            return

        layout_width = width - 1
        body_top = 3
        ticker = self.ticker_shown(height, width)
        self._slate_all = ticker or self.tab_name == "Overview"
        body_height = height - 4 - (1 if ticker else 0)

        # The body draws first: fetching the scoreboard is what tells us which
        # week we are looking at, and the tab bar wants to print that.
        self.tab = clamp(self.tab, 0, len(self.tabs) - 1)
        if self.tab_name == "Overview":
            self.draw_overview(body_top, body_height, layout_width)
        elif self.on_board and is_wiki_sport(self.league):
            self.draw_events_tab(body_top, body_height, layout_width)
        elif self.on_board:
            self.draw_scoreboard_tab(body_top, body_height, layout_width)
        else:
            self.draw_panel_tab(body_top, body_height, layout_width, self.tab_name)
        if self.pending_center:
            self.resolve_pending_center()
            if self.center:
                self.dirty = True
                return

        self.draw_tabbar(layout_width)
        if ticker:
            self.draw_ticker(height - 2, layout_width)
        else:
            try:
                self.today_slate()      # score alerts read it even when hidden
            except Exception:  # noqa: BLE001 - alerts are a nicety, never a crash
                pass
        self.draw_footer(layout_width, height)
        if self.show_help or self.show_info or self.calendar or self.popup or self.kim or \
                self.article:
            self.hotspots, self.wheel_zones = [], []    # clicks go to the pop-up
        if self.show_help:
            self.draw_help(height, width)
        elif self.show_info:
            self.draw_info(height, width)
        elif self.article:
            self.draw_article(height, width)
        elif self.calendar:
            self.draw_calendar(height, width)
        elif self.popup:
            self.draw_popup(height, width)
        elif self.kim:
            self.draw_kim(height, width)
            if self.kim:
                self.kim["backdrop"] = (height, width)
        self.stdscr.noutrefresh()
        curses.doupdate()

    def draw_scoreboard_tab(self, top, height, width):
        share = 0.56 if (BETTING.enabled and BETTING.columns) else 0.52
        left_width = clamp(int(width * share), 46, max(46, width - 34))
        if width < 90:
            left_width = width
        right_width = width - left_width

        result = self.load_scoreboard()
        all_events = self.prepare_events(result.data)
        self.events = self.visible_events(all_events)
        self.sync_selection()

        caption = self.period_caption()
        if self.week_mode and LEAGUES[self.league]["week_based"] and self.season_year:
            caption = f"{caption} · {self.season_year}"
        self.draw_box(top, 0, height, left_width, caption, "sel")
        alerts = sum(1 for e in self.events
                     if e.get("upset") and e["upset"]["level"] == "live")
        if alerts:
            badge = f" ▲ {alerts} on upset watch "
            start = left_width - len(badge) - 2
            if start > len(caption) + 6:
                self.put(top, start, badge, self.palette("upsetbar"))

        inner_width = left_width - 4
        gap = 3 if self.graphics.enabled and self.team_logos != "off" and \
            inner_width >= 60 else 0
        columns = {}
        column_header, rows = render_game_list(self.events, inner_width,
                                               self.selected_index, self.favorites,
                                               self.league, logo_gap=gap, spots=columns)
        sticky = True
        if not result.data and result.loading:
            column_header, rows, sticky = None, [Line().add("Loading…", "dim")], False
        elif not result.data and result.error:
            column_header = None
            sticky = False
            source = {"hockeytech": "HockeyTech (the AHL's stats feed)"}.get(
                LEAGUES[self.league].get("source"), "ESPN")
            rows = wrap_spans(f"Could not reach {source}: {result.error}", inner_width, "err")

        body_top = top + 1
        view_height = height - 2
        if sticky and column_header is not None:
            self.draw_lines([column_header], top + 1, 2, 1, inner_width, 0)
            body_top = top + 2
            view_height = height - 3

        offset = self.scroll["Scoreboard"]
        if self.selected_index >= offset + view_height:
            offset = self.selected_index - view_height + 1
        if self.selected_index < offset:
            offset = self.selected_index
        offset = clamp(offset, 0, max(0, len(rows) - view_height))
        self.scroll["Scoreboard"] = offset

        self.draw_lines(rows, body_top, 2, view_height, inner_width, offset)
        self.draw_scrollbar(body_top, left_width - 2, view_height, len(rows), offset)
        if self.events:
            for row in range(view_height):
                index = offset + row
                if index < len(self.events):
                    self.hot(body_top + row, 1, left_width - 2,
                             lambda i=index: self.click_game(i),
                             lambda i=index: self.click_game(i, True))
            if gap and sticky:
                shown = self.events[offset:offset + view_height]
                for side in ("away", "home"):
                    self.logo_column(self.league, [e[side] for e in shown], body_top,
                                     2 + columns[side],
                                     selected=self.selected_index - offset)
        if right_width >= 30:
            self.wheel(top, top + height, left_width, width, ord("J"), ord("K"))

        if right_width < 30:
            return
        event = self.current_event()
        self.draw_box(top, left_width, height, right_width,
                      event["short_name"] if event else "Game", "accent")
        detail_width = right_width - 4
        if event:
            winner = game_winner(event) if self.logo_style != "off" and \
                self.team_logos != "off" else None
            art = None
            if winner:
                self.palette.logo_begin((self.league, winner.get("id"), self.team_logos))

                def art(cols, rows, team=winner):
                    return self.team_art(self.league, team, cols, rows)
            detail = render_game_preview(event, self.league, detail_width,
                                         self.favorites, height=height - 2,
                                         logo_style=self.logo_style, art=art)
        else:
            detail = [Line().add("No game selected.", "dim")]
        self.detail_scroll = clamp(self.detail_scroll, 0,
                                   max(0, len(detail) - (height - 2)))
        self.draw_lines(detail, top + 1, left_width + 2, height - 2, detail_width,
                        self.detail_scroll)
        self.draw_scrollbar(top + 1, left_width + right_width - 2, height - 2,
                            len(detail), self.detail_scroll)

    def draw_lines_box(self, top, height, width, caption, lines, key=None):
        """The usual single panel: a box, the lines, a scrollbar."""
        key = key or self.tab_name
        inner_width = width - 4
        self.draw_box(top, 0, height, width, caption, "accent")
        self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(lines) - (height - 2)))
        self.draw_lines(lines, top + 1, 2, height - 2, inner_width, self.scroll[key])
        self.draw_scrollbar(top + 1, width - 2, height - 2, len(lines), self.scroll[key])

    def draw_panel_tab(self, top, height, width, title):
