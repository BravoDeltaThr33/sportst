def team_label(side, width, show_rank=True):
    name = side["short"] or side["name"] or side["abbr"]
    if show_rank and side["rank"]:
        name = f"#{side['rank']} {name}"
    if len(name) > width:
        name = side["abbr"] if len(side["abbr"]) <= width else name[:width]
    return name[:width]


def game_list_layout(width, want_odds):
    """Which optional columns fit, and how wide the team names can be.

    Records go first, then the total, then the line; the line outlasts long
    team names, which fall back to abbreviations. The status column is always
    reserved, because a clock you cannot read is worse than no line at all.
    """
    options = ([(True, True, True, 12), (False, True, True, 9), (False, True, False, 8),
                (False, False, False, 6)] if want_odds
               else [(True, False, False, 12), (False, False, False, 6)])
    for records, line, total, minimum in options:
        status = 16 if (line or total) else 12
        fixed = 4 + 2 * (1 + 5) + (18 if records else 0) + (11 if line else 0) \
            + (6 if total else 0) + status
        name_width = (width - fixed) // 2
        if name_width >= minimum:
            return records, line, total, clamp(name_width, 6, 22)
    return False, False, False, clamp((width - 28) // 2, 4, 22)


def render_game_list(events, width, selected_index, favorites, league):
    """Return (column header, one row per game). A long CFB slate needs one row."""
    want_odds = (BETTING.enabled and BETTING.columns
                 and any(e.get("line") for e in events))
    records, show_line, show_total, name_width = game_list_layout(width, want_odds)
    fixed_status = show_line or show_total
    rows = []

    header = Line()
    header.add("    ", "header")
    header.add(f"{'away':<{name_width}} ", "header")
    if records:
        header.add(f"{'rec':>8} ", "header")
    header.add(f"{'':>3}  ", "header")
    header.add(f"{'home':<{name_width}} ", "header")
    if records:
        header.add(f"{'rec':>8} ", "header")
    header.add(f"{'':>3}  ", "header")
    header.add(f"{'status':<15} " if fixed_status else "status", "header")
    if show_line:
        header.add(f"{'line':<10} ", "header")
    if show_total:
        header.add(f"{'o/u':>5}", "header")
    header.pad(width, "header")

    if not events:
        return header, [blank(), Line().add("  No games here.", "dim")]

    for index, event in enumerate(events):
        chosen = index == selected_index
        away, home = event["away"], event["home"]
        final = event["state"] == "post"
        upset = event.get("upset")
        alert = bool(upset and upset["level"] == "live")
        away_fav = fav_rank(favorites, league, away) >= 0
        home_fav = fav_rank(favorites, league, home) >= 0

        if chosen:
            base, plain = "sel", "seldim"
        elif alert:
            base, plain = "upsetrow", "upsetmuted"
        else:
            base, plain = "normal", "muted"

        def team_style(side):
            style = THEME.style(league, side, selected=chosen,
                                bold=fav_rank(favorites, league, side) >= 0
                                or (final and side["winner"]),
                                dim=final and not side["winner"])
            if alert and not chosen:
                style = style_on_upset(style)
            return style

        away_style, home_style = team_style(away), team_style(home)

        line = Line()
        if chosen:
            line.add("▌", "upsetsel" if alert else "selbar")
        else:
            line.add("▌" if alert else " ", "upsetmark" if alert else base)
        line.add(STAR if (away_fav or home_fav) else " ",
                 ("star" if not alert or chosen else "upsetstar")
                 if (away_fav or home_fav) else base)
        if alert:
            line.add("▲", "upsetsel" if chosen else "upsetmark")
        elif upset:
            line.add("▲", "seldim" if chosen else "upsetsoft")
        else:
            line.add(" ", base)
        line.add(" ", base)

        line.add(f"{team_label(away, name_width, league in RANKED_LEAGUES):<{name_width}} ",
                 away_style)
        if records:
            line.add(f"{away['record'] or '':>8} ", plain)
        line.add(f"{'' if away['score'] is None else away['score']:>3}  ", away_style)
        line.add(f"{team_label(home, name_width, league in RANKED_LEAGUES):<{name_width}} ",
                 home_style)
        if records:
            line.add(f"{home['record'] or '':>8} ", plain)
        line.add(f"{'' if home['score'] is None else home['score']:>3}  ", home_style)

        status = status_text(event)
        if alert:
            status_style_name = "upsetsel" if chosen else "upsetmark"
        elif chosen:
            status_style_name = base
        else:
            status_style_name = status_style(event)
        if fixed_status:
            line.add(f"{status[:15]:<15} ", status_style_name)
        else:
            line.add(status, status_style_name)

        if show_line or show_total:
            ln = event.get("line")
            settled = event["state"] != "pre"
            number_style = plain if settled else base
            if show_line:
                label, fav_team = line_label(ln, event, league)
                if label and fav_team is not None and " " in label:
                    abbr, _, rest = label.partition(" ")
                    tstyle = THEME.style(league, fav_team, selected=chosen, dim=settled)
                    if alert and not chosen:
                        tstyle = style_on_upset(tstyle)
                    line.add(abbr + " ", tstyle)
                    line.add(rest, number_style)
                    used = len(label)
                elif label:
                    line.add(label, number_style)
                    used = len(label)
                else:
                    used = 0
                mark = MOVE_MARK.get(movement(ln, league)) if (ln and not settled) else None
                if mark and used < 9:
                    line.add(" " + mark, "seldim" if chosen else "accent")
                    used += 2
                line.add(" " * max(1, 11 - used), base)
            if show_total:
                total = (ln or {}).get("total")
                line.add(f"{number_text(total) if total is not None else '':>5}", number_style)
        rows.append(line.pad(width, base))

    return header, rows


def style_on_upset(token):
    """A team colour token moved onto the orange-tinted row background."""
    if not token or not token.startswith("#"):
        return "upsetrow"
    hex_part, _, mods = token.partition("~")
    return f"{hex_part}~{mods.replace('s', '')}u"


