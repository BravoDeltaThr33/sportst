        return len(parse_baseball_plays(data)) if data else 0

    def jump_to_upset(self):
        alerts = [i for i, e in enumerate(self.events)
                  if e.get("upset") and e["upset"]["level"] == "live"]
        if not alerts:
            self.status_message = "No games on upset watch right now."
            return
        later = [i for i in alerts if i > self.selected_index]
        target = later[0] if later else alerts[0]
        self.selected_index = target
        self.selected_id = self.events[target]["id"]
        self.detail_scroll = 0
        self.tab = 1

