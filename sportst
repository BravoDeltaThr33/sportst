def parse_args(argv):
    parser = make_parser()
    args = parser.parse_args(argv)

    if args.date:
        try:
            args.date = datetime.strptime(args.date.replace("/", "-"), "%Y-%m-%d").date()
        except ValueError:
            parser.error("--date wants YYYY-MM-DD")
    return args


def check_olympic_args(args):
    """-E and --games name an Olympic sport and Games: find them (either one
    alone says which Olympics is meant), or return what the choices are."""
    fams = [args.league] if args.league in ("owg", "osg") else ["owg", "osg"]
    if args.games:
        years = {fam: [g["year"] for g in OLYMPIC_GAMES.get(fam, [])] for fam in fams}
        having = [fam for fam in fams if args.games in years[fam]]
        if not having:
            return (f"{APP}: no {' or '.join(LEAGUE_SHORT[f] for f in fams)} in "
                    f"{args.games}. On file: " + "; ".join(
                        f"{LEAGUE_SHORT[f]} {', '.join(str(y) for y in years[f])}"
                        for f in fams))
        if not args.league and not args.event:
            args.league = having[0]
    if not args.event:
        return None
    if args.league and args.league not in ("owg", "osg"):
        return f"{APP}: -E picks an Olympic sport; use it with -L owg or -L osg."
    choices = []
    for fam in fams:
        games = (olympic_games(fam, args.games) if args.games else None) or \
            current_games(fam)
        if args.event in games["sports"]:
            args.league = args.league or fam
            return None
        choices.append(f"  -L {fam} ({games['year']}): " + ", ".join(games["sports"]))
    return "\n".join([f"{APP}: no Olympic sport called {args.event!r}. The choices:"]
                     + choices + ["(--list-events -L owg or -L osg lists them by name.)"])


def main(argv=None):
    locale.setlocale(locale.LC_ALL, "")
    args = parse_args(argv if argv is not None else sys.argv[1:])
    problem = check_olympic_args(args)
    if problem:
        sys.stderr.write(problem + "\n")
        return 2

    if args.write_config:
        path = write_default_config(args.config)
        print(f"wrote {path}")
        return 0

    config = load_config(args.config)
    config["favorites"] = normalize_favorites(config.get("favorites"))
    THEME.configure(config)
    oneshot = any([args.scores, args.box, args.standings, args.json, args.stats, args.bets,
                   args.team_stats, args.plays, args.favorites, args.odds,
                   args.playoffs, args.logo_test, args.medals, args.list_events,
                   args.kim, args.today])
    if oneshot:
        try:
            return run_oneshot(config, args)
        except BrokenPipeError:
            # `sportst --scores | head` closed the pipe early; that is fine
            try:
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, sys.stdout.fileno())
            except OSError:
                pass
            return 0

    if not sys.stdout.isatty():
        sys.stderr.write(
            f"{APP}: not a terminal. Use --scores, --box ID, or --standings for plain output.\n")
        return 1

    os.environ.setdefault("ESCDELAY", "25")
    try:
        choose_pictures(config)     # real images or text art: ask the terminal first
    except KeyboardInterrupt:
        return 0

    def bootstrap(stdscr):
        App(stdscr, config, args).run()

    try:
        curses.wrapper(bootstrap)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
