    def top25_ranks(self):
        """{team id: its rank} in the current poll, or None outside college
        sports ({} while the poll loads)."""
        if self.league not in COLLEGE_LEAGUES:
            return None
        if self.league == "csoft":
            # 7.0.0: no poll to read for softball, only the ranks ESPN prints on
            # the day's games
            return {e[side]["id"]: e[side]["rank"] for e in self.events
                    for side in ("away", "home") if e[side].get("rank")}
        if self.league == "cbase":
            poll = self.fetcher.get(("ncaapoll",), Loader("ncaa-api.henrygd.me",
                                                         ncaa_baseball_poll), ttl=6 * 3600)
            primary, spare = self.api.teams("cbase")
            catalog = self.fetcher.get(("teams", "cbase"), primary, ttl=86400,
                                       fallbacks=spare)
            ranks = (poll.data or {}).get("ranks") or {}
            out = {}
            for node in dig(catalog.data, "sports", 0, "leagues", 0, "teams",
                            default=[]) or []:
                team = team_record(node.get("team") or {})
                for key in ("location", "name", "short"):
                    rank = ranks.get(norm_name(team.get(key) or ""))
                    if rank:
                        out[team["id"]] = _int(rank, 99)
                        break
            return out
        url, spare = self.api.rankings(self.league)
        poll = self.fetcher.get(("rankings", self.league), url, ttl=1800, fallbacks=spare)
        out = {}
        for row in dig(poll.data, "rankings", 0, "ranks", default=[]) or []:
            if isinstance(row.get("current"), int) and row["current"] <= 25:
                out[str(dig(row, "team", "id", default=""))] = row["current"]
        return out

    def top25_ids(self):
        """Team ids in the current poll, or None outside college sports."""
        ranks = self.top25_ranks()
        return None if ranks is None else set(ranks)

