def wiki_title_url(title):
    return WIKI_BASE + urllib.parse.quote(title.replace(" ", "_"), safe="()',–-") + \
        "?action=render"


def wiki_page(title, timeout=15, max_age=None):
    """A Wikipedia article as {sections, infobox, links}. Pages about a Games
    that ended long ago hardly change, so they are kept on disk."""
    path = os.path.join(WIKI_DIR, re.sub(r"[^A-Za-z0-9_.-]+", "_", title)[:150] + ".v1.json")
    if max_age:
        try:
            if time.time() - os.path.getmtime(path) < max_age:
                with open(path, "r", encoding="utf-8") as handle:
                    return json.load(handle)
        except (OSError, ValueError):
            pass
    text = None
    for attempt in range(3):
        # one request at a time and a breath between them: Wikipedia answers
        # bursts from one address with 429 Too Many Requests
        with _WIKI_LOCK:
            wait = _WIKI_LAST[0] + 1.0 - time.time()
            if wait > 0:
                time.sleep(wait)
            try:
                text = http_text(wiki_title_url(title), timeout, WIKI_AGENT)
            except urllib.error.HTTPError as exc:
                if exc.code == 404:
                    return {"title": title, "missing": True, "sections": [],
                            "infobox": [], "links": []}
                if exc.code != 429 or attempt == 2:
                    raise
            finally:
                _WIKI_LAST[0] = time.time()
        if text is not None:
            break
        time.sleep(2 + 3 * attempt)
    parser = WikiTables()
    parser.feed(text)
    parser.close()
    page = {"title": title, "sections": parser.sections, "infobox": parser.infobox,
            "links": list(dict.fromkeys(parser.links))}
    try:
        os.makedirs(WIKI_DIR, exist_ok=True)
        with open(path + ".tmp", "w", encoding="utf-8") as handle:
            json.dump(page, handle)
        os.replace(path + ".tmp", path)
    except OSError:
        pass
    return page


def games_live(league):
    meta = LEAGUES.get(league, {})
    games = olympic_games(meta.get("family"), meta.get("year"))
    if not games:
        return False
    today = Date.today()
    return Date.fromisoformat(games["start"]) - timedelta(days=3) <= today <= \
        Date.fromisoformat(games["end"]) + timedelta(days=2)


def wiki_max_age(league):
    """Keep a finished Games for a week; during one, ten minutes."""
    return 600 if games_live(league) else 7 * 86400


