                caption += f" · {short_group(self.group_filter[family(self.league)])}"
            if self.filter_text:
                caption += f" · find '{self.filter_text}'"
            if spots:
                caption += " · enter: a team's page"
                # keep the highlighted team on screen, as the keys move it
                at = next((s["row"] for s in spots if s["team"]["id"] ==
                           self.standings_sel.get(self.league)), 0)
                view = height - 2
                offset = self.scroll["Standings"]
                if not self._mouse_pick:
                    if at - 2 < offset:
                        offset = max(0, at - 2)      # its table's headings too
                    elif at >= offset + view:
                        offset = at - view + 1
                self.scroll["Standings"] = offset
            self.draw_lines_box(top, height, width, caption, lines)
            offset = self.scroll["Standings"]
            view = height - 2
            logos = {}                # x -> a team (or None) for each row on screen
            for spot in spots:
                shown_at = spot["row"] - offset
                if 0 <= shown_at < view:
                    team_id = spot["team"]["id"]
                    self.hot(top + 1 + shown_at, 2 + spot["x"], 2 + spot["x"] + spot["width"],
                             lambda t=team_id: self.click_standing(t),
                             lambda t=team_id: self.click_standing(t, True))
                    if gap:
