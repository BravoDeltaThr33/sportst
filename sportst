def find_player(choice="auto"):
    """(name, path) of the media player to use, or (None, None)."""
    order = ["mpv", "ffplay", "vlc"] if choice in ("auto", "", None) else [choice]
    for name in order:
        spec = CLIP_PLAYERS.get(name)
        if not spec:
            continue
        program = spec[0]
        if name == "vlc" and not shutil.which("cvlc"):
            program = "vlc"
        path = shutil.which(program)
        if path:
            return name, path
    return None, None


def open_in_browser(url):
    """Hand a link to the desktop's browser, quietly, so nothing the browser
    prints lands on the curses screen."""
    import subprocess
    for program in ("xdg-open", "open", "wslview"):
        path = shutil.which(program)
        if path:
            try:
                subprocess.Popen([path, url], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                return True
            except OSError:
                continue
    try:
        import webbrowser
        return webbrowser.open(url)
    except Exception:  # noqa: BLE001
        return False


def start_player(path, name, url, video=False):
    import subprocess
    _, audio_args, video_args = CLIP_PLAYERS[name]
    args = [path] + (video_args if video else audio_args) + [url]
    if name == "vlc" and video and os.path.basename(path) == "cvlc":
        args[0] = shutil.which("vlc") or path
    return subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)


def gutter(line, ref, first):
    """Give a scoring play's line a two-column gutter for its clip mark and
    remember which play it belongs to."""
    line.insert(0, ("  ", "normal"))
    line.play_ref = ref
    line.play_first = first
    return line


