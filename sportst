def _age(stamp):
    when = parse_iso(stamp)
    if not when:
        return ""
    seconds = (datetime.now(timezone.utc) - when).total_seconds()
    if seconds < 3600:
        return f"{max(1, int(seconds // 60))}m"
    if seconds < 86400:
        return f"{int(seconds // 3600)}h"
    return f"{int(seconds // 86400)}d"


def flow_text(items, width, indent="    "):
    """Short items joined with ' · ' and wrapped at width, as (text) lines."""
    lines, current = [], ""
    for item in items:
        piece = item if not current else " · " + item
        if current and len(indent) + len(current) + len(piece) > width:
            lines.append(current)
            current = item
        else:
            current += piece
    if current:
        lines.append(current)
    return lines


