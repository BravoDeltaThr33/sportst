def sextant_char(pattern):
    """The Unicode sextant for a 6-bit pattern. Bit 0 is top-left, bit 1
    top-right, then the middle pair, then the bottom pair. The block skips
    the four patterns older characters already cover."""
    if pattern == 0:
        return " "
    if pattern == 63:
        return "█"
    if pattern == 21:
        return "▌"
    if pattern == 42:
        return "▐"
    return chr(0x1FB00 + pattern - 1 - (pattern > 21) - (pattern > 42))


def _near(pixel, choices):
    """Index of the choice closest to pixel; None stands for the background."""
    rgb = pixel or (0, 0, 0)
    best, best_d = 0, None
    for index, choice in enumerate(choices):
        d = color_distance(rgb, choice or (0, 0, 0))
        if best_d is None or d < best_d:
            best, best_d = index, d
    return best


def block_cell(pixels, charset):
    """(character, style) for one cell, drawn in two colours.

    A cell holds six pixels (sextants) or eight (octants) but only two
    colours, so this tries every pair of the colours present and keeps the
    pair that covers the pixels best, then encodes which pixels take the
    foreground."""
    present = []
    for pixel in pixels:
        if pixel not in present:
            present.append(pixel)
    if len(present) == 1:
        only = present[0]
        return (" ", "normal") if only is None else ("█", "@" + _hex(only))
    if len(present) > 5:  # keep the search small on a busy cell
        present = present[:5]
    best = None
    for i in range(len(present)):
        for j in range(i + 1, len(present)):
            pair = (present[i], present[j])
            cost = 0
            for pixel in pixels:
                choice = pair[_near(pixel, pair)]
                cost += color_distance(pixel or (0, 0, 0), choice or (0, 0, 0))
            if best is None or cost < best[0]:
                best = (cost, pair)
    a, b = best[1]
    # background side: transparency if there is any, else a fixed order so
    # the same two colours always make the same colour pair
    if a is None:
        fg, bg = b, None
    elif b is None:
        fg, bg = a, None
    else:
        fg, bg = max(a, b), min(a, b)
    pattern = 0
    for bit, pixel in enumerate(pixels):
        if _near(pixel, (bg, fg)) == 1:
            pattern |= 1 << bit
    style = "@" + _hex(fg) + (":" + _hex(bg) if bg is not None else "")
    if callable(charset):
        return charset(pattern), style
    return charset[pattern], style


def sextant_cell(pixels):
    return block_cell(pixels, sextant_char)


def octant_cell(pixels):
    return block_cell(pixels, OCTANT_CHARS)


# 2 x 2 pixels per cell, bit 0 top-left then left to right, top to bottom.
# Every one of the 16 patterns is a classic Block Elements character
# (Unicode 1.0, 1991) -- the same vintage as the half-blocks, so every
# monospace font draws all of them evenly, unlike the year-old octants.
QUADRANT_CHARS = " ▘▝▀▖▌▞▛▗▚▐▜▄▙▟█"


def quadrant_cell(pixels):
    return block_cell(pixels, QUADRANT_CHARS)


def render_logo(image, max_cols, max_rows, style="sextants", indent=0):
    """Lines for a logo no larger than max_cols x max_rows cells.

    sextants    2 x 3 pixels per cell (Unicode 13, 2020); the default, and
                what "blocks" means too
    octants     2 x 4 pixels per cell, the sharpest on paper, but octants are
                Unicode 16 (2024) and many fonts draw the rarer 230-odd of
                them unevenly or not at all
    quadrants   2 x 2 pixels per cell, built entirely from classic Block
                Elements (Unicode 1.0, 1991) -- lower resolution than
                sextants but every monospace font renders it consistently
    halfblocks  ▀ ▄: 1 x 2 pixels per cell, works in any UTF-8 terminal
    ascii       .:-=+*#%@ in the logo's colours
    """
    if not image or max_cols < 4 or max_rows < 2:
        return []
    box = opaque_box(image)
    if box is None:
        return []
    width, height = box[2] - box[0], box[3] - box[1]
    # one cell is one pixel wide and two tall, so rows x (2*rows) is square
    rows = max_rows
    cols = max(1, int(round(rows * 2 * width / height)))
    if cols > max_cols:
        cols = max_cols
        rows = max(1, int(round(cols * height / width / 2)))
    pad = " " * max(0, indent)
    if style in ("blocks", "octants", "octant", "sextants", "sextant", "quadrants", "quadrant"):
        if style.startswith("oct"):
            tall, cell = 4, octant_cell
        elif style.startswith("quad"):
            tall, cell = 2, quadrant_cell
        else:
            tall, cell = 3, sextant_cell
        grid = trim_grid(quantize(logo_cells(image, cols, rows, box, 2, tall), limit=6),
                         2, tall)
        lines = []
        for y in range(0, len(grid) - tall + 1, tall):
            line = Line().add(pad, "normal")
            for x in range(0, len(grid[0]) - 1, 2):
                pixels = [grid[y + dy][x + dx] for dy in range(tall) for dx in (0, 1)]
                char, token = cell(pixels)
                line.add(char, token)
            lines.append(merge_spans(line))
        return lines

    grid = trim_grid(quantize(logo_cells(image, cols, rows, box), limit=6))
    if not grid:
        return []
    lines = []
    for y in range(0, len(grid) - 1, 2):
        top, bottom = grid[y], grid[y + 1]
        line = Line().add(pad, "normal")
        for upper, lower in zip(top, bottom):
            if style == "ascii":
                pick = upper or lower
                if pick is None:
                    line.add(" ", "normal")
                    continue
                shade = max(pick) / 255
                char = ASCII_RAMP[clamp(int(shade * (len(ASCII_RAMP) - 1)), 1,
                                        len(ASCII_RAMP) - 1)]
                line.add(char, "@" + _hex(pick))
            elif upper is None and lower is None:
                line.add(" ", "normal")
            elif upper is None:
                line.add("▄", "@" + _hex(lower))
            elif lower is None:
                line.add("▀", "@" + _hex(upper))
            elif upper == lower:
                line.add("█", "@" + _hex(upper))
            else:
                line.add("▀", "@" + _hex(upper) + ":" + _hex(lower))
        lines.append(merge_spans(line))
    return lines


def merge_spans(line):
    merged = Line()
    for text, style in line:
        if merged and merged[-1][1] == style:
            merged[-1] = (merged[-1][0] + text, style)
        else:
            merged.append((text, style))
    return merged


def logo_score(image):
    """How well a logo variant reads on black: colourful and visible wins.
    ESPN's '-dark' variants are sometimes the better choice (Iowa, Auburn)
    and sometimes a plain white knockout (Clemson), so both get scored."""
    width, height, data = image
    opaque = visible = colourful = 0
    for i in range(0, len(data), 16):  # every fourth pixel is plenty
        if data[i + 3] < 110:
            continue
        opaque += 1
        top = max(data[i], data[i + 1], data[i + 2])
        low = min(data[i], data[i + 1], data[i + 2])
        if top >= 70:
            visible += 1
            if top - low >= 60:
                colourful += 1
    if not opaque:
        return -1.0
    return colourful / opaque + 0.5 * visible / opaque


def logo_urls(league, team):
    """Candidate variants: ESPN's dark-background logo and the normal one,
    both resized on ESPN's side, then the full-size original."""
    href = team.get("logo") or ""
    if "assets.leaguestat.com" in href:
        # the AHL keeps some logos per season (335_90.png) and some not
        ident = team.get("id") or ""
        seasons = [s.get("season_id") for s in _HT_SEASONS["list"]][:5] or \
            ["94", "93", "92", "90", "86"]
        base = HT_LOGO.rsplit("/", 1)[0]
        return [href] + [f"{base}/{ident}_{sid}.png" for sid in seasons] + \
            [f"{base}/50x50/{ident}.png"]
    if href and "espncdn.com" not in href:
        return [href]
    if not href:
        folder = {"nfl": "nfl", "nhl": "nhl", "cfb": "ncaa", "nba": "nba",
                  "cbb": "ncaa"}.get(league)
        if not folder:
            return []
        ident = team.get("id") if league in COLLEGE_LEAGUES else \
            (team.get("abbr") or "").lower()
        if not ident:
            return []
        href = f"https://a.espncdn.com/i/teamlogos/{folder}/500/{ident}.png"
    path = urllib.parse.urlsplit(href).path
    dark = path.replace("/500/", "/500-dark/", 1)
    size = LOGO_SOURCE_PX
    urls = []
    for candidate in ([dark] if dark != path else []) + [path]:
        urls.append(f"https://a.espncdn.com/combiner/i?img={candidate}&w={size}&h={size}")
    urls.append(href)
    return urls


def shrink_image(image, target=LOGO_SOURCE_PX):
    """Box-filter a big logo down to about `target` pixels a side, once, so
    drawing it every frame stays cheap. ESPN resizes its own; the AHL's
    arrive at 500 x 500."""
    width, height, data = image
    factor = max(width, height) // target
    if factor < 2:
        return image
    new_w, new_h = width // factor, height // factor
    out = bytearray(new_w * new_h * 4)
    area = factor * factor
    for y in range(new_h):
        for x in range(new_w):
            r = g = b = a = 0
            for dy in range(factor):
                base = ((y * factor + dy) * width + x * factor) * 4
                for dx in range(factor):
                    i = base + dx * 4
                    alpha = data[i + 3]
                    r += data[i] * alpha
                    g += data[i + 1] * alpha
                    b += data[i + 2] * alpha
                    a += alpha
            o = (y * new_w + x) * 4
            if a:
                out[o:o + 4] = bytes((r // a, g // a, b // a, a // area))
    return new_w, new_h, out


def http_bytes(url, timeout=15):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT,
                                                   "Accept": "image/png,*/*"})
    return net_read(request, timeout)[0]


class LogoStore:
    """Fetches and decodes logos on a background thread, keeps the PNGs on
    disk so each team downloads once, and never blocks the screen."""

    def __init__(self, on_ready=None, timeout=15, directory=LOGO_DIR):
        self.directory = directory
        self.timeout = timeout
        self.on_ready = on_ready
        self.images = {}
        self.failed = set()
        self.pending = set()
        self.lock = threading.Lock()
        self.queue = queue.Queue()
        threading.Thread(target=self._worker, daemon=True).start()

    def _path(self, key):
        return os.path.join(self.directory, re.sub(r"[^A-Za-z0-9_-]", "_",
                                                   "-".join(key)) + ".png")

    def get(self, league, team):
        ident = str(team.get("id") or team.get("abbr") or "")
        if not ident:
            return None
        key = (league, ident)
        with self.lock:
            if key in self.images:
                return self.images[key]
            if key in self.failed or key in self.pending:
                return None
            self.pending.add(key)
        self.queue.put((key, logo_urls(league, team)))
        return None

    def _worker(self):
        while True:
            key, urls = self.queue.get()
            image = None
            path = self._path(key)
            try:
                with open(path, "rb") as handle:
                    image = png_decode(handle.read())
            except OSError:
                image = None
            if image is None:
                best = None
                for url in urls:
                    try:
                        blob = http_bytes(url, self.timeout)
                    except Exception:  # noqa: BLE001 - a missing logo is cosmetic
                        continue
                    decoded = png_decode(blob)
                    if decoded is None:
                        continue
                    score = logo_score(decoded)
                    # the full-size original is only a fallback for when
                    # both resized variants fail
                    if best is None or score > best[0]:
                        best = (score, blob, decoded)
                    resized = [u for u in urls if "combiner" in u]
                    if url not in resized or url == resized[-1]:
                        break
                if best is not None:
                    _, blob, image = best
                    try:
                        os.makedirs(self.directory, exist_ok=True)
                        with open(path + ".tmp", "wb") as handle:
                            handle.write(blob)
                        os.replace(path + ".tmp", path)
                    except OSError:
                        pass
            if image is not None:
                image = shrink_image(image)
            with self.lock:
                self.pending.discard(key)
                if image is None:
                    self.failed.add(key)
                else:
                    self.images[key] = image
            if self.on_ready:
                self.on_ready()


def _is_strong(line, league):
    side = favorite_side(line)
    if not side:
        return False
    ml = line.get(f"{side}_ml")
    if ml is not None and ml <= BETTING.min_moneyline:
        return True
    if league not in MONEYLINE_LEAGUES and line.get("spread") is not None:
        return abs(line["spread"]) >= BETTING.min_spread
    return False


def upset_state(event, league):
    """None, or a dict describing why this game deserves a look."""
    if not (BETTING.enabled and BETTING.alerts):
        return None
    line = event.get("line")
    if not line or event.get("state") not in ("in", "post"):
        return None
    side = favorite_side(line)
    if not side or not _is_strong(line, league):
        return None
    favorite = event[side]
    underdog = event["away" if side == "home" else "home"]
    if favorite.get("score") is None or underdog.get("score") is None:
        return None

    margin = favorite["score"] - underdog["score"]
    number = favorite_number(line, league) or 0
    if league in MONEYLINE_LEAGUES:
        size = money_text(number)
        dog_ml = line.get(("away" if side == "home" else "home") + "_ml")
        dog_size = money_text(dog_ml) if dog_ml is not None else "an"
    else:
        size = dog_size = f"{abs(number):g}-point"

    if event["state"] == "post":
        if margin < 0:
            return {"level": "final", "tag": "UPSET",
                    "note": f"{underdog['abbr']} won as a {dog_size} underdog",
                    "favorite": favorite, "underdog": underdog, "margin": margin}
        return None

    # a "late" period and a "safe" lead differ by sport
    low_scoring = league in MONEYLINE_LEAGUES
    period = event.get("period") or 0
    regulation = LEAGUES.get(league, {}).get("regulation", 4)
    late = period >= regulation
    big_lead = (3 if is_baseball(league) else 2) if low_scoring else (
        12 if sport_of(league) == "basketball" else 8)

    if margin < 0:
        lead = -margin
        if period >= 2 or lead >= big_lead:
            return {"level": "live", "tag": "UPSET",
                    "note": f"{underdog['abbr']} leads by {lead} as a {dog_size} underdog",
                    "favorite": favorite, "underdog": underdog, "margin": margin}
        return None
    if margin == 0 and late:
        return {"level": "live", "tag": "TIED",
                "note": f"tied late; {favorite['abbr']} was a {size} favorite",
                "favorite": favorite, "underdog": underdog, "margin": margin}
    if (not low_scoring and late and 0 < margin <= 3 and line.get("spread") is not None
            and abs(line["spread"]) >= BETTING.close_spread):
        return {"level": "live", "tag": "CLOSE",
                "note": f"{favorite['abbr']} up only {margin} as a {size} favorite",
                "favorite": favorite, "underdog": underdog, "margin": margin}
    return None


