def olympic_games(fam, year):
    for games in OLYMPIC_GAMES.get(fam, []):
        if games["year"] == year:
            return games
    return None


def current_games(fam, today=None):
    """The Games to open on: one under way, or starting within six weeks, or
    else the most recent one."""
    today = today or Date.today()
    games_list = OLYMPIC_GAMES.get(fam, [])
    for games in games_list:
        start = Date.fromisoformat(games["start"])
        end = Date.fromisoformat(games["end"])
        if start - timedelta(days=42) <= today <= end + timedelta(days=7):
            return games
    past = [g for g in games_list if Date.fromisoformat(g["start"]) <= today]
    return past[-1] if past else games_list[0]


def olympic_default(fam, slug=None, year=None):
    """The league key to open a family on."""
    games = olympic_games(fam, year) if year else None
    games = games or current_games(fam)
    if slug and slug in games["sports"]:
        return olympic_key(fam, games["year"], slug)
    preferred = "hockey-m" if fam == "owg" else "athletics"
    return olympic_key(fam, games["year"], preferred if preferred in games["sports"]
                       else games["sports"][0])


def resolve_league(name):
    """A league name from the command line or the config: a family ('owg')
    opens on its current Games."""
    if name in ("owg", "osg"):
        return olympic_default(name)
    return name if name in LEAGUES and not LEAGUES[name].get("virtual") else None


