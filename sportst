    def statcast_feed(self, event):
        """MLB's own pitch data for this game, or None. The game id comes from
        MLB's schedule for the day, matched on the two team names."""
        if not (self.statcast and self.league == "mlb" and event):
            return None
        game_pk = self.game_pks.get(event["id"])
        if game_pk is None:
            when = parse_iso(event["date"])
            day = when.astimezone().date() if when else Date.today()
            for offset in (0, -1, 1):
                probe = day + timedelta(days=offset)
                result = self.fetcher.get(("mlbsched", probe.isoformat()),
                                          statcast_schedule_url(probe), ttl=3600)
                if not result.data:
                    continue
                found = find_game_pk(result.data, event)
                if found:
                    game_pk = self.game_pks[event["id"]] = found
                    break
            if game_pk is None:
                return None
        ttl = 15 if event["state"] == "in" else 900
        result = self.fetcher.get(("mlbpbp", game_pk), statcast_game_url(game_pk),
                                  ttl=ttl)
        return result.data

