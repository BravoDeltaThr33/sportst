        title.add(away["abbr"], THEME.style(self.league, away, bold=True))
        title.add(" @ ", "muted")
        title.add(home["abbr"], THEME.style(self.league, home, bold=True))
        title.add(f" · {status_text(event)} ", "dim")
        chart_title = Line().add("Shot chart", "title")
        chart_title.add({"both": "  both teams", "away": f"  {away['abbr']}",
                         "home": f"  {home['abbr']}"}[self.shot_view], "muted")
        chart_title.add(" · V switches", "muted")
        return [(title, left), (Line(), [chart_title] + list(right))]

    def playoff_seeds(self):
        """{team id: playoff seed} from the standings, for leagues whose
        postseason scoreboard doesn't carry seeds."""
        data = self.load_standings().data
        if not data:
            return {}
        root = dig(data, "content", "standings", default=data) or data
        groups = []
        walk_standings(root, [], groups)
        seeds = {}
        for _, entries in groups:
            for entry in entries:
                seed = stat_display(stat_lookup(entry), ["playoffSeed"])
                team = entry_team(entry)
                if seed not in ("", "-", "0") and team["id"]:
                    seeds[team["id"]] = seed
        return seeds

    def postseason_days(self, year):
        """The date windows ESPN keeps for college baseball's championship."""
        meta = LEAGUES[self.league]
        days = []
        for season_type in (5, 6):
            url = (f"https://sports.core.api.espn.com/v2/sports/{meta['sport']}/leagues/"
                   f"{meta['path']}/seasons/{year}/types/{season_type}")
            window = self.fetcher.get(("ptype", self.league, year, season_type), url,
                                      ttl=86400)
            start = parse_iso(dig(window.data, "startDate", default="") or "")
            end = parse_iso(dig(window.data, "endDate", default="") or "")
            if not start or not end:
                continue
            day = start.date()
            while day <= end.date() and len(days) < 24:
                days.append(day)
                day += timedelta(days=1)
        return days

    def bracket_is_old(self, season):
        """True when this league's standings already belong to a later season
        with games played, so a bracket from `season` is last year's."""
        primary, fallbacks = self.api.standings(self.league)
        result = self.fetcher.get(("st", self.league), primary, ttl=900, fallbacks=fallbacks)
        year, played = standings_season(result.data)
        return bool(year and played and year > season)

    def load_playoffs(self):
        """(rounds, loading, error). Each league keeps its bracket somewhere
        different, so each one is fetched its own way."""
        year = self.season_year or Date.today().year
        league = self.league
        self._bracket_season = ""
        if league in ("nba", "cbb", "wnba", "wcbb"):
            for season in (year, year - 1):
                if self.bracket_is_old(season):
                    return [], False, None          # a new season: the picture
                events, loading, error = [], False, None
                for month, urls in basketball_postseason_urls(self.api, league, season):
                    result = self.fetcher.get(("bbpost", league, season, month), urls[0],
                                              ttl=900, fallbacks=urls[1:])
                    loading = loading or result.loading
                    error = error or result.error
                    if result.data:
                        events.extend(parse_scoreboard(result.data))
                rounds = bracket_nba(events) if league in ("nba", "wnba") \
                    else bracket_cbb(events)
                if count_real_teams(rounds) >= 2:
                    self._bracket_season = season_label(league, season)
                    return rounds, loading, error
                if loading:
                    return [], True, None
            return [], False, None
        if league == "ahl":
            source, spare = self.api.hockeytech.bracket(league)
            result = self.fetcher.get(("ahlbracket",), source, ttl=900, fallbacks=spare)
            rounds = bracket_ahl(result.data) if result.data else []
            playoff = (result.data or {}).get("season") or {}
            regular = (result.data or {}).get("regular") or {}
            if (regular.get("start_date") or "") > (playoff.get("end_date") or "9"):
                rounds = []                 # last spring's bracket: the new season is on
            if count_real_teams(rounds) < 2:
                rounds = []
            match = re.search(r"(\d{4})", playoff.get("season_name") or "")
            if rounds and match:
                self._bracket_season = season_label("ahl", int(match.group(1)))
            return rounds, result.loading, result.error
        if is_olympic(league):
            result = self.load_scoreboard()
            events = parse_scoreboard(result.data) if result.data else []
            rounds = olympic_bracket(events, league)
            return rounds, result.loading, result.error
        if league == "nhl":
            for season in (year, year - 1):
                if self.bracket_is_old(season):
                    return [], False, None
                result = self.fetcher.get(("nhlbracket", season),
                                          f"{NHL_API}/playoff-bracket/{season}",
                                          ttl=900)
                rounds = bracket_nhl(result.data) if result.data else []
                if count_real_teams(rounds) >= 2:
                    self._bracket_season = season_label(league, season)
                    return rounds, result.loading, result.error
                if result.loading:
                    return [], True, None
            return [], False, None
        if league == "milb":
            # 7.0.0: each level's postseason, one bracket a level (playoff_lines)
            result = self.fetcher.get(("milbpost", milb_season()),
                                      Loader(MILB_HOST, milb_postseason, milb_season()),
                                      ttl=900)
            self._milb_levels = result.data or {}
            rounds = [entry for level in self._milb_levels.values() for entry in level]
            if count_real_teams(rounds) < 2:
                rounds = []
            if rounds:
                self._bracket_season = str(milb_season())
            return rounds, result.loading, result.error
        if league == "mlb":
            result = self.fetcher.get(
                ("mlbpost", year),
                f"{STATS_API}/schedule/postseason?season={year}&sportId=1", ttl=900)
            teams = self.load_teams()
            by_name = {}
            for team in (parse_teams(teams.data) if teams.data else []):
                by_name[team["name"].lower()] = team
            rounds = bracket_mlb(result.data, by_name) if result.data else []
            if count_real_teams(rounds) < 2:
                rounds = []
            if rounds:
                self._bracket_season = str(year)
            return rounds, result.loading, result.error

        events, loading, error = [], False, None
        if league in ("nfl", "cfb"):
            weeks = [1, 2, 3, 5] if league == "nfl" else [1]
            for week in weeks:
                url, spare = self.api.scoreboard(
                    league, week=week, seasontype=3, year=year,
                    groups=self.cfb_group if league == "cfb" else None)
                result = self.fetcher.get(("post", league, year, week), url, ttl=900,
                                          fallbacks=spare)
                loading = loading or result.loading
                error = error or result.error
                if result.data:
                    events.extend(parse_scoreboard(result.data))
            keep = None
            if league == "cfb":
                keep = lambda headline: "playoff" in headline.lower() or \
                    "national championship" in headline.lower()
            rounds = bracket_from_events(events, league,
                                         NFL_ROUNDS if league == "nfl" else CFB_ROUNDS,
                                         seeds=self.playoff_seeds(), keep=keep)
            if count_real_teams(rounds) < 2:
                rounds = []
            return rounds, loading, error

        for day in self.postseason_days(year):
            url, spare = self.api.scoreboard(league, day=day)
            result = self.fetcher.get(("post", league, day.isoformat()), url, ttl=900,
                                      fallbacks=spare)
            loading = loading or result.loading
            error = error or result.error
            if result.data:
                events.extend(parse_scoreboard(result.data))
        rounds = bracket_from_events(events, league, CBASE_ROUNDS, namer=cbase_round)
        if count_real_teams(rounds) < 2:
            rounds = []
        return rounds, loading, error

    def core_line(self, event):
        """The pre-game line for a game already underway, from the core API."""
        url, fallbacks = self.api.odds(self.league, event["id"])
        result = self.fetcher.get(("odds", self.league, event["id"]), url,
                                  ttl=1800, fallbacks=fallbacks)
        if not result.data:
            return None
        return parse_core_odds(result.data, event["away"], event["home"])

    def prepare_events(self, data):
        events = parse_scoreboard(data) if data else []
        if is_olympic(self.league):
            # a whole tournament in one list: the day goes in front of the status
            for event in events:
                when = parse_iso(event["date"])
                day = strf(when.astimezone(), "%b %-d") if when else ""
                if event["state"] == "pre":
                    event["label"] = f"{day} {local_time(event['date'])}".strip()
                else:
                    event["label"] = f"{day} {event['detail']}".strip()
            return events
        if BETTING.enabled and self.league in BETTING_LEAGUES:
            attach_lines(events, self.league, self.book, self.core_line,
                         self.selected_id)
            self.announce_upsets(events)
        return events

    def announce_upsets(self, events):
        live = [e for e in events if e.get("upset") and e["upset"]["level"] == "live"]
        fresh = []
        for event in live:
            key = (self.league, event["id"], event["upset"]["tag"])
            if key not in self.alerted:
                self.alerted.add(key)
                fresh.append(event)
        if not fresh:
            return
        if self.league not in self.alerts_primed:
            # first look at this slate: one summary rather than one per game
            self.alerts_primed.add(self.league)
            if len(fresh) == 1:
                self.flash_upset(fresh[0])
            else:
                self.status_message = f"▲ {len(fresh)} games on upset watch — press U"
                self.status_style = "upset"
                self.status_alert = self.status_message
        else:
            self.flash_upset(fresh[-1])
        if BETTING.bell:
            try:
                curses.beep()
            except curses.error:
                pass

    def flash_upset(self, event):
        upset = event["upset"]
        self.status_message = (f"▲ {upset['tag']}: {event['short_name']}  "
                               f"{upset['note']}  ({status_text(event)})")
        self.status_style = "upset"
        self.status_alert = self.status_message

    def at_bat_count(self):
        """How many at-bats the selected game has on record right now."""
        event = self.current_event()
        if not event:
            return 0
        data = self.load_summary(event["id"]).data
        return len(parse_baseball_plays(data)) if data else 0

    def jump_to_upset(self):
        alerts = [i for i, e in enumerate(self.events)
                  if e.get("upset") and e["upset"]["level"] == "live"]
        if not alerts:
            self.status_message = "No games on upset watch right now."
            return
        later = [i for i in alerts if i > self.selected_index]
        target = later[0] if later else alerts[0]
        self.selected_index = target
        self.selected_id = self.events[target]["id"]
        self.detail_scroll = 0
        self.tab = 1

    def save_book(self, force=False):
        now = time.time()
        if force or (self.book.dirty and now - self.last_book_save > 10):
            self.book.save()
            self.last_book_save = now

    def visible_events(self, events, live=True):
        out = events
        group = self.group_filter.get(family(self.league), "")
        members = self.team_groups() if not is_wiki_sport(self.league) else {}
        if group == TOP25_GROUP and self.league in RANKED_LEAGUES:
            out = [e for e in out if e["away"]["rank"] or e["home"]["rank"]]
        elif group == TOP25_GROUP and self.league == "cbase":
            top = self.top25_ids()
            if top:
                out = [e for e in out if e["away"]["id"] in top or e["home"]["id"] in top]
        elif group:
            if members:
                out = [e for e in out
                       if group in members.get(e["away"]["id"], ())
                       or group in members.get(e["home"]["id"], ())]
        if self.filter_text:
            needle = self.filter_text.lower()
            out = [e for e in out
                   if needle in e["short_name"].lower()
                   or needle in e["name"].lower()
                   or needle in e["away"]["name"].lower()
                   or needle in e["home"]["name"].lower()]
        out = sort_by_favorites(self.favorites, self.league, out)
        if live and self.live_only:
            out = [e for e in out if e.get("state") == "in"]
        return out

    def toggle_live_only(self):
        """o on the Scoreboard: the games being played only, or every game
        again."""
        self.live_only = not self.live_only
        self.scroll["Scoreboard"] = 0
        if not self.live_only:
            self.status_message = "Every game again."
            return
        result = self.load_scoreboard()
        shown = self.visible_events(self.prepare_events(result.data), live=False) \
            if result.data else []
        live = [e for e in shown if e.get("state") == "in"]
        if live and str(self.selected_id) not in {str(e["id"]) for e in live}:
            self.selected_id = live[0]["id"]
            self.selected_index = 0
        self.status_message = (f"Live games only: {len(live)} on now. o shows every game "
                               "again." if live else "Live games only: none on right now. "
                               "o shows every game again.")

    def current_event(self):
        if not self.events:
            return None
        return self.events[clamp(self.selected_index, 0, len(self.events) - 1)]

    def sync_selection(self):
        if not self.events:
            self.selected_index = 0
            return
        if self.selected_id:
            for index, event in enumerate(self.events):
                if event["id"] == self.selected_id:
                    self.selected_index = index
                    return
        self.selected_index = clamp(self.selected_index, 0, len(self.events) - 1)
        self.selected_id = self.events[self.selected_index]["id"]

    # -- period label ----------------------------------------------------

    def period_caption(self):
        meta = LEAGUES[self.league]
        if is_olympic(self.league):
            return meta["games"]
        if self.week_mode and meta["week_based"]:
            names = meta["seasontype_names"]
            label = names.get(self.seasontype, "Week")
            if self.seasontype == 3 and self.league == "cfb":
                return "Bowls"
            if not self.week:
                return "This week"
            suffix = "" if self.week_pinned else " (current)"
            if label in ("Pre", "Post"):
                return f"{label} Wk {self.week}{suffix}"
            return f"Week {self.week}{suffix}"
        return strf(self.day, "%A, %B %-d, %Y")

    # -- drawing ---------------------------------------------------------

    def apply_background(self):
        """Fill unwritten cells too, so erase() and the margins stay black."""
        if not (self.palette and self.palette.enabled and self.palette.bg_rgb):
            return
        try:
            self.stdscr.bkgd(" ", self.palette("normal"))
        except curses.error:
            pass

    def corners(self):
        if self.config.get("rounded_borders", True):
            return "╭", "╮", "╰", "╯"
        return "┌", "┐", "└", "┘"

    def draw_box(self, top, left, height, width, title=None, title_style="accent",
                 border_style="border"):
        if height < 2 or width < 2:
            return
        tl, tr, bl, br = self.corners()
        win = self.stdscr
        border = self.palette(border_style)
        self.put(top, left, tl + "─" * (width - 2) + tr, border)
        self.put(top + height - 1, left, bl + "─" * (width - 2) + br, border)
        for row in range(1, height - 1):
            self.put(top + row, left, "│", border)
            self.put(top + row, left + width - 1, "│", border)
        if title:
            text = f" {title} "[: max(0, width - 4)]
            self.put(top, left + 2, text, self.palette(title_style))

    def put(self, y, x, text, attr=0):
        height, width = self.stdscr.getmaxyx()
        if y < 0 or y >= height or x >= width:
            return
        if x < 0:
            text = text[-x:]
            x = 0
        text = text[: max(0, width - x)]
        if not text:
            return
        try:
            self.stdscr.addstr(y, x, text, attr)
        except curses.error:
            pass
        if self.crt.on:
            top, left = self.stdscr.margin[:2]
            self.crt.record(y + top, x + left, text, attr)

    def present(self, full=True):
        """Put the frame drawn into stdscr on the screen: in CRT mode with its
        effects drawn over it first and the glass laid on after."""
        crt = self.crt
        if crt.on:
            try:
                crt.decorate(self, full)
            except Exception as exc:  # noqa: BLE001 - an effect must never cost the app
                self.crt_failed(exc)
        self.stdscr.noutrefresh()
        curses.doupdate()
        if crt.on:
            try:
                crt.after(self, full)
            except Exception as exc:  # noqa: BLE001
                self.crt_failed(exc)

    def erase(self, height, width):
        self.set_margin()
        self.stdscr.erase()
        if self.crt.on:
            self.crt.blank(*self.term.getmaxyx())

    def set_margin(self):
        """The outer ring of cells for CRT mode's bezel, when it is showing:
        a row above and below, two columns left and one right (the app
        leaves its last column empty anyway)."""
        height, width = self.term.getmaxyx()
        want = (1, 2, 1, 1) if (self.crt.on and self.crt.glass and crt_amount("bezel")
                                and height >= 16 and width >= 64) else (0, 0, 0, 0)
        if want != self.stdscr.margin:
            self.stdscr.margin = want
            self.crt.lost()

    def crt_failed(self, exc):
        """CRT mode broke: off for the rest of this run, saying why."""
        self.crt.stop()
        self.crt_phosphor = None
        self.graphics.tint = None
        self.graphics.clear()
        self.rebuild_palette()
        self.status_message = f"⚠ CRT effect stopped: {type(exc).__name__}: {exc}"
        self.dirty = True

    def set_crt(self, boot=True):
        """Turn CRT mode on or off (or change its phosphor) as the settings say."""
        on = bool(self.config.get("crt")) and not self.args.no_color
        phosphor = crt_phosphor(self.config.get("crt_phosphor", "green"))
        self.crt.stop()
        self.graphics.clear()            # the pictures go again, in the new colours
        self.graphics.tint = (lambda png, p=phosphor: crt_png(png, p)) if on else None
        self.crt_phosphor = phosphor if on else None
        self.rebuild_palette()
        if on and self.palette.enabled:
            self.crt.start(self, phosphor, boot=boot)
        self.dirty = True

    def start_post(self):
        """The POST screen: a power-on self test before the first screen, in
        CRT mode. False when it is off (POST screen at 0, or no CRT mode)."""
        if not (self.crt.on and crt_amount("post")):
            self.post = None
            return False
        installed_font_families()             # fontconfig is asked meanwhile
        self.post = {"start": time.monotonic(), "step": CRT_POST * crt_amount("post"),
                     "checks": []}
        self.dirty = True
        return True

    def draw_post(self, height, width):
        """The POST screen while it runs (True; False once it is over): a
        check a line at a time, then the league booting."""
        post = self.post
        if not self.crt.on or height < 18 or width < 56:
            self.post = None
            return False
        now = time.monotonic()
        if self.crt.boot is not None:
            post["start"] = now               # the test starts once the picture is open
        step = post["step"]
        elapsed = max(0.0, now - post["start"])
        due = int(elapsed / step)              # the checks showing
        total = CRT_POST_LINES
        if due > total + 3:
            self.post = None
            self.dirty = True
            return False
        checks = post["checks"]
        while len(checks) < min(due, total):
            checks.append(post_check(self, len(checks)))
        self.erase(height, width)
        self.hotspots, self.wheel_zones = [], []
        self.wire["row"] = None
        left, right = 3, min(width - 3, 84)
        self.put(1, left, "SPORTS TERMINAL BIOS", self.palette("title"))
        self.put(1, left + 21, f"v{VERSION}", self.palette("bold"))
        self.put(2, left, "Power-on self test · free public data, no keys",
                 self.palette("muted"))
        verdicts = {"OK": "good", "NONE": "muted", "WARN": "warn"}
        for index, (what, found, verdict, figure) in enumerate(checks):
            y = 4 + index
            newest = index == due - 1 and due <= total
            share = min(1.0, (elapsed - due * step) / (step * 0.8)) if newest else 1.0
            if figure is not None:
                found = found.replace("{n}", f"{int(figure * share):,}")
            label = f"{what} " + "." * max(1, 10 - len(what))
            room = right - left - len(label) - 1 - 8
            found = found if len(found) <= room else found[:max(0, room - 1)] + "…"
            self.put(y, left, label, self.palette("accent"))
            self.put(y, left + len(label) + 1, found, self.palette("normal"))
            if figure is not None and share < 1.0:
                continue                       # still counting: no verdict yet
            dots_at = left + len(label) + 2 + len(found)
            end = right - len(verdict) - 1
            if end > dots_at:
                self.put(y, dots_at, "." * (end - dots_at), self.palette("muted"))
            self.put(y, right - len(verdict), verdict, self.palette(verdicts[verdict]))
        if due > total:
            name = LEAGUES[self.league]["name"]
            self.put(5 + total, left, f"Booting {name}" + "." * min(3, due - total),
                     self.palette("bold"))
        self.put(height - 2, left, "any key skips the self test", self.palette("muted"))
        return True

    def apply_crt_levels(self):
        """Use the CRT effects' levels in the config, redoing only what the
        ones that changed touch. Returns their keys."""
        fresh = crt_levels(self.config.get("crt_levels"))
        keys = [key for key in fresh if fresh[key] != CRT_LEVELS.get(key, CRT_STANDARD)]
        CRT_LEVELS.clear()
        CRT_LEVELS.update(fresh)
        if not keys or not self.crt.on:
            return keys
        if any(key in keys for key in ("blacks", "trails", "burn", "flash")):
            if "blacks" in keys:
                self.graphics.clear()        # the pictures go again, on the new black
            self.rebuild_palette()           # the colours, and the CRT's own shades
        self.crt.retune(keys)
        self.dirty = True
        return keys

    def draw_lines(self, lines, top, left, height, width, scroll):
        for row in range(height):
            index = scroll + row
            if index >= len(lines):
                break
            click = getattr(lines[index], "click", None)
            if click:
                self.hot(top + row, max(0, left - 1), left + width, *click)
            x = left
            remaining = width
            for text, style in lines[index]:
                if remaining <= 0:
                    break
                chunk = text[:remaining]
                self.put_span(top + row, x, chunk, style, whole=len(chunk) == len(text))
                x += len(chunk)
                remaining -= len(chunk)

    def draw_scrollbar(self, top, left, height, total, scroll):
        if total <= height or height < 3:
            return
        span = max(1, int(height * height / total))
        position = int(scroll * (height - span) / max(1, total - height))
        for row in range(height):
            mark = "█" if position <= row < position + span else "░"
            self.put(top + row, left, mark, self.palette("border"))

    def draw_tabbar(self, width):
        self.draw_box(0, 0, 3, width)
        x = 2
        tabs = self.tabs
        # on a narrow screen the tab names give way before the league does
        full = sum(len(n) + 3 for n in tabs)
        short = full > width - 40
        tiny = sum(len(TAB_SHORT.get(n, n)) + 3 for n in tabs) > width - 6
        for index, name in enumerate(tabs):
            style = "tabsel" if index == self.tab else "tab"
            text = TAB_SHORT.get(name, name) if short else name
            if tiny and index != self.tab:
                text = TAB_TINY.get(name, text[:3])
            label = f" {text} "
            self.put_span(1, x, label, "(" + style if style == "tabsel" else style)
            self.hot(1, x, x + len(label), lambda i=index: self.click_tab(i))
            x += len(label)
            if index < len(tabs) - 1:
                self.put(1, x, " " if SHAPES["round"] else "│", self.palette("border"))
                x += 1

        meta = LEAGUES[self.league]
        if is_olympic(self.league):
            right = f" {meta['games']} · {meta['label']} "
        else:
            right = f" {meta['name']} · {self.period_caption()} "
        if self.filter_text:
            right += f"· /{self.filter_text} "
        if self.group_filter.get(family(self.league)):
            right += f"· {short_group(self.group_filter[family(self.league)])} "
        right += " "
        start = width - len(right) - 2
        if start <= x + 2 and is_olympic(self.league):
            right = f" {meta['label']} "
            start = width - len(right) - 2
        if start > x + 2:
            self.put(1, start, right, self.palette("dim"))

    def draw_footer(self, width, height):
        """One line, always: name and version, refresh state, then whatever
        message there is, trimmed to fit rather than wrapped."""
        try:
            hints = [(key_label(k), label) for k, label in self.screen_hints()]
        except Exception:  # noqa: BLE001 - hints are a nicety, never a crash
            hints = []
        hints = self.pane_hints(hints)
        spans, message, style = footer_spans(
            self.auto_refresh, self.interval, self.fetcher.busy(),
            self.fetcher.requests_made, self.status_message or self.player_status(),
            self.fetcher.last_error, width - 2, hints, round_keys=SHAPES["round"],
            page=int(time.monotonic() // HINT_PAGE_SECONDS))
        x = 1
        for text, token in spans:
            self.put_span(height - 1, x, text, token)
            x += len(text)
        if message:
            at = width - len(message) - 1
            self.put(height - 1, at, message, self.palette(style))
            if self.crt.on and self.status_message and \
                    self.status_message == self.status_alert:
                top, left = self.stdscr.margin[:2]
                self.crt.mark_blink(height - 1 + top, at + left, len(message))

    def draw_help(self, height, width):
        """The keys, in as many columns as fit, a section never split; j / k
        scroll when even that is too tall for the screen."""
        sections, current = [], []
        for entry in HELP_TEXT:
            if not entry[0] and not entry[1]:
                if current:
                    sections.append(current)
                current = []
            else:
                current.append(entry)
        if current:
            sections.append(current)
        widest = min(92, max(17 + len(v) for _, v in HELP_TEXT if v) + 3)
        count = clamp((width - 6) // widest, 1, 3)
        total = sum(len(s) for s in sections) + len(sections) - 1
        target = total / count
        columns, column = [], []
        for section in sections:
            if column and len(column) + len(section) > target and len(columns) < count - 1:
                columns.append(column)
                column = []
            if column:
                column.append(("", ""))
            column.extend(section)
        columns.append(column)
        col_width = clamp(widest, 40, (width - 6) // len(columns))
        # a description too long for the column wraps under itself
        room = max(10, col_width - 19)
        wrapped = []
        for block in columns:
            rows = []
            for key, description in block:
                if key and description and len(description) > room:
                    parts = textwrap.wrap(description, room) or [""]
                    rows.append((key, parts[0]))
                    rows.extend((" ", part) for part in parts[1:])
                else:
                    rows.append((key, description))
            wrapped.append(rows)
        columns = wrapped
        tallest = max(len(c) for c in columns)
        box_width = col_width * len(columns) + 4
        box_height = clamp(tallest + 5, 8, height - 2)
        view = box_height - 5
        self.help_scroll = clamp(self.help_scroll, 0, max(0, tallest - view))
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        self.draw_box(top, left, box_height, box_width, f"{APP} {VERSION} · keys", "title")
        for number, block in enumerate(columns):
            x = left + 3 + number * col_width
            for row, (key, description) in enumerate(block[self.help_scroll:
                                                           self.help_scroll + view]):
                y = top + 2 + row
                if key and not description:
                    self.put(y, x, key, self.palette("title"))
                elif key:
                    self.put(y, x, f"{key:<16}", self.palette("accent"))
                    self.put(y, x + 17, description[:room], self.palette("dim"))
        self.draw_scrollbar(top + 2, left + box_width - 2, view, tallest, self.help_scroll)
        hint = "j / k scroll · any other key closes" if tallest > view else \
            "press any key to close"
        self._help_fits = tallest <= view          # then every key closes it
        self.put(top + box_height - 2, left + 3, hint, self.palette("muted"))

    def draw_info(self, height, width):
        """The Info pop-up: what everything on the current screen means."""
        box_width = clamp(width - 4, 40, 112)
        box_height = max(8, height - 4)
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        try:
            sections = info_sections(self)
        except Exception as exc:  # noqa: BLE001 - never let Info take the app down
            sections = [("Info", [(None, f"Could not build this screen's notes: {exc}")])]
        lines = info_lines(sections, box_width - 6)
        view = box_height - 4
        self.info_scroll = clamp(self.info_scroll, 0, max(0, len(lines) - view))
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        title = f"Info · {self.tab_name}"
        if self.article:
            title = "Info · the article card"
        elif self.center:
            title = "Info · " + ("Event Center" if self.center.get("wiki") else "Game Center")
        elif self.tab_name == "Stats" and self.stats_team and self.stats_team[0] == self.league:
            title += " · players"
        title += f" · {LEAGUE_SHORT.get(family(self.league), self.league.upper())}"
        self.draw_box(top, left, box_height, box_width, title, "title")
        self.draw_lines(lines, top + 1, left + 3, view, box_width - 6, self.info_scroll)
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(lines), self.info_scroll)
        hint = "j / k scroll · PgDn / PgUp page · any other key closes"
        if len(lines) <= view:
            hint = "any key closes"
        self._info_fits = len(lines) <= view
        self.put(top + box_height - 2, left + 3, hint, self.palette("muted"))

    def draw(self):
        try:
            self._draw_frame()
        finally:
            if self.show_help or self.show_info or getattr(self, "kim", None) or \
                    getattr(self, "popup", None) or getattr(self, "calendar", None):
                self.graphics.drop_under()    # a pop-up is over them
            self.graphics.flush()      # the pictures this frame named, after curses

    def put_spans(self, y, x, line):
        """One Line at y, x as it is: no clipping beyond the screen's."""
        for text, style in line:
            self.put_span(y, x, text, style)
            x += len(text)

    def put_span(self, y, x, text, style, whole=True):
        """One span: a chip ("(" style) with its rounded ends where the
        terminal draws them, a picture under the text ("!u:" style) noted
        where it starts, anything else as it is."""
        if style and style[0] == "(":
            base = style[1:]
            cap = self.palette.cap(base) if SHAPES["round"] and whole and \
                len(text) >= 3 else None
            if cap is None:
                self.put(y, x, cell_text(text, base), self.palette(base))
                return
            first, last = text[0] == " ", text[-1] == " "
            if first:
                self.put(y, x, PILL_LEFT, cap)
            body = text[1 if first else 0:len(text) - (1 if last else 0)]
            self.put(y, x + (1 if first else 0), body, self.palette(base))
            if last:
                self.put(y, x + len(text) - 1, PILL_RIGHT, cap)
            return
        if style and style.startswith("!u:"):
            self.note_underlay(y, x, style)
            style = style.partition("|")[2]
        self.put(y, x, cell_text(text, style), self.palette(style))

    def put_pill(self, y, x, text, style):
        """A chip in `style`, its first and last spaces its rounded ends where
        the terminal draws them."""
        self.put_span(y, x, text, "(" + style)

    def note_underlay(self, y, x, style):
        """A picture to lay under the text from here (an "!u:" span starts
        it): passed to the terminal after the frame (Kitty, Ghostty)."""
        if not self.graphics.enabled:
            return
        number, _, band = style[3:].partition("|")[0].partition(":")
        spec = UNDERLAYS.get(number)
        if not spec or not band.isdigit():
            return
        key, maker, cols, rows = spec
        cw, ch = (max(4, int(round(self.cell[0]))), max(8, int(round(self.cell[1]))))
        top, left = (getattr(self.stdscr, "margin", None) or (0, 0))[:2]
        self.graphics.underlay((key, cw, ch), lambda: maker(cw, ch), y + top, x + left,
                               cols, int(band), cw, ch)

    def team_art(self, league, team, cols, rows):
        """A team's logo for a box of at most cols x rows cells: the real logo
        where the terminal shows pictures, else its badge or its logo drawn in
        blocks (Settings: Team logos, Logo art); [] for none. The caller has
        started the exact-colour block that a badge or drawn logo uses."""
        if not team or self.team_logos == "off" or self.logo_style == "off":
            return []
        if self.graphics.enabled:
            png = self.logos.get(league, team, raw=True)
            size = png_size(png) if png else None
            if size:
                c, r = fit_cells(size, cols, rows, self.cell)
                key = ("logo", league, str(team.get("id") or team.get("abbr") or ""))
                image_id = self.graphics.place(key, png, c, r) if c and r else None
                if image_id:
                    return image_cells(image_id, c, r)
        if self.team_logos == "drawn":
            image = self.logos.get(league, team)
            if image is not None:
                return render_logo(image, min(cols, LOGO_MAX_COLS), min(rows, LOGO_MAX_ROWS),
                                   self.logo_style)
        # the badge: always to hand, so the layout never waits for a download
        return render_badge(team, league, cols, rows)

    def small_logo(self, league, team, box_w, box_h):
        """A team's logo shrunk to fit box_w x box_h pixels (kept), or None
        while it loads or when there is none."""
        ident = str(team.get("id") or team.get("abbr") or "")
        key = (league, ident, box_w, box_h)
        if key in self._small_logos:
            return self._small_logos[key]
        image = self.logos.get(league, team)
        if image is None:
            return None
        width, height, _ = image
        scale = min(box_w / width, box_h / height) * 0.94
        small = scale_rgba(image, int(width * scale), int(height * scale))
        if len(self._small_logos) > 400:
            self._small_logos.clear()
        self._small_logos[key] = small
        return small

    def logo_column(self, league, teams, top, x, cols=2, selected=-1):
        """Real logos down a list, one a row, where the terminal shows
        pictures: `teams` has a team (or None) for each screen row from
        `top`, and the logos go at column x, `cols` cells wide - all of them
        one picture, so a whole list costs one of the terminal's slots."""
        if not self.graphics.enabled or not any(teams):
            return
        box_w, box_h = max(4, int(cols * self.cell[0])), max(4, int(self.cell[1]))
        # a row may name its own league: (league, team), as the Overview's do
        pairs = [(item if isinstance(item, tuple) else (league, item)) if item else
                 (None, None) for item in teams]
        images = [self.small_logo(where, team, box_w, box_h) if team else None
                  for where, team in pairs]
        if not any(images):
            return
        sig = tuple(f"{where}:{team.get('id') or team.get('abbr')}" if image else ""
                    for (where, team), image in zip(pairs, images))
        key = ("strip", league, sig, box_w, box_h)
        png = self._strip_pngs.get(key)
        if png is None:
            png = logo_strip(images, box_w, box_h)
            if len(self._strip_pngs) > 12:
                self._strip_pngs.clear()
            self._strip_pngs[key] = png
        image_id = self.graphics.place(key, png, cols, len(teams))
        if not image_id:
            return
        for row, image in enumerate(images):
            if image:
                tail = ":s" if row == selected else ""
                self.put_spans(top + row, x, Line(
                    [(PLACEHOLDER, f"!img:{image_id}:{row}:{col}{tail}")
                     for col in range(cols)]))

    def kim_picture(self, frame, cols, rows):
        """Kim's original portrait as a real picture with one mouth: its
        number for placeholder cells, or None."""
        key = (frame, cols, rows)
        png = self._kim_pngs.get(key)
        if png is None:
            png = pixel_png(kim_original(frame), KIM_NES, cols * self.cell[0],
                            rows * self.cell[1])
            self._kim_pngs[key] = png
        return self.graphics.place(("kim", frame), png, cols, rows)

    def _draw_frame(self):
        height, width = self.stdscr.getmaxyx()
        if self.post is not None and self.draw_post(height, width):
            self.present()
            return
        if self.center and height >= 10 and width >= 50:
            # the Game Center takes the whole screen above the BottomLine
            self.erase(height, width)
            self.hotspots, self.wheel_zones = [], []
            self.wire["row"] = None
            ticker = self.ticker_shown(height, width)
            wire = self.wire_shown(height, width)
            self._slate_all = ticker
            self.draw_center(height - 1 - (1 if ticker else 0) - (1 if wire else 0), width - 1)
            if ticker:
                self.draw_ticker(height - 2, width - 1)
            if wire:
                self.draw_wire_safely(height - 2 - (1 if ticker else 0), width - 1)
            self.draw_footer(width - 1, height)
            if self.next_banner():
                self.draw_banner(self.banner_row(height, ticker, wire), width - 1)
            if self.show_help or self.show_info:
                self.hotspots, self.wheel_zones = [], []    # clicks go to the pop-up
                (self.draw_help if self.show_help else self.draw_info)(height, width)
            self.present()
            return
        if self.kim and self.kim.get("backdrop") == (height, width):
            # Ask Kim animates: redraw the pop-up and the bottom line over the
            # screen already there instead of the whole tab ten times a second
            self.draw_kim(height, width)
            self.put(height - 1, 0, " " * (width - 1), self.palette("normal"))
            self.draw_footer(width - 1, height)
            self.present(full=False)
            return
        self.erase(height, width)
        self.hotspots, self.wheel_zones = [], []
        self._split_drawn = None
        self.wire["row"] = None
        if height < 10 or width < 50:
            self.put(0, 0, "Terminal too small — 50x10 minimum.", self.palette("warn"))
            self.present()
            return

        layout_width = width - 1
        body_top = 3
        ticker = self.ticker_shown(height, width)
        wire = self.wire_shown(height, width)
        self._slate_all = ticker or self.tab_name == "Overview"
        body_height = height - 4 - (1 if ticker else 0) - (1 if wire else 0)

        # The body draws first: fetching the scoreboard is what tells us which
        # week we are looking at, and the tab bar wants to print that.
        self.tab = clamp(self.tab, 0, len(self.tabs) - 1)
        if self.tab_name == "Overview":
            self.draw_overview(body_top, body_height, layout_width)
        elif self.on_board and is_wiki_sport(self.league):
            self.draw_events_tab(body_top, body_height, layout_width)
        elif self.on_board:
            self.draw_scoreboard_tab(body_top, body_height, layout_width)
        else:
            self.draw_panel_tab(body_top, body_height, layout_width, self.tab_name)
        if self.pending_center:
            self.resolve_pending_center()
            if self.center:
                self.dirty = True
                return

        self.draw_tabbar(layout_width)
        if wire:
            self.draw_wire_safely(height - 2 - (1 if ticker else 0), layout_width)
        if ticker:
            self.draw_ticker(height - 2, layout_width)
        else:
            try:
                self.today_slate()      # score alerts read it even when hidden
            except Exception:  # noqa: BLE001 - alerts are a nicety, never a crash
                pass
        self.draw_footer(layout_width, height)
        if self.next_banner():
            self.draw_banner(self.banner_row(height, ticker, wire), layout_width)
        if self.settings_card and self.tab_name != "Settings":
            self.close_settings_card()
        if self.roster and not (self.standings_team or self.stats_team):
            self.roster = None              # its team page is gone
        if self.show_help or self.show_info or self.calendar or self.popup or self.kim or \
                self.article or self.crt_card or self.video or self.settings_card or \
                self.roster:
            self.hotspots, self.wheel_zones = [], []    # clicks go to the pop-up
        if self.video:
            self.draw_video_card(height, width)
        elif self.show_help:
            self.draw_help(height, width)
        elif self.show_info:
            self.draw_info(height, width)
        elif self.article:
            self.draw_article(height, width)
        elif self.calendar:
            self.draw_calendar(height, width)
        elif self.crt_card:
            self.draw_crt_card(height, width)
        elif self.popup:
            if self.settings_card:      # a setting's choices over its card
                self.draw_settings_card(height, width)
                self.hotspots, self.wheel_zones = [], []
            self.draw_popup(height, width)
        elif self.settings_card:
            self.draw_settings_card(height, width)
        elif self.roster:
            self.draw_roster(height, width)
        elif self.kim:
            self.draw_kim(height, width)
            if self.kim:
                self.kim["backdrop"] = (height, width)
        self.present()

    def draw_scoreboard_tab(self, top, height, width):
        share = 0.56 if BETTING.enabled else 0.52
        left_width = clamp(int(width * share), 46, max(46, width - 34))
        if width < 90:
            left_width = width
        right_width = width - left_width

        result = self.load_scoreboard()
        all_events = self.prepare_events(result.data)
        shown = self.visible_events(all_events, live=False)
        live_count = sum(1 for e in shown if e.get("state") == "in")
        self.events = [e for e in shown if e.get("state") == "in"] if self.live_only \
            else shown
        self.sync_selection()

        caption = self.period_caption()
        if self.week_mode and LEAGUES[self.league]["week_based"] and self.season_year:
            caption = f"{caption} · {self.season_year}"
        inner_width = left_width - 4
        gap = 3 if self.graphics.enabled and self.team_logos != "off" and \
            inner_width >= 60 else 0
        columns = {}
        column_header, rows = render_game_list(self.events, inner_width,
                                               self.selected_index, self.favorites,
                                               self.league, logo_gap=gap, spots=columns)
        sticky = True
        if self.live_only and not self.events and result.data:
            rows = live_only_lines(shown, inner_width)
        if not result.data and result.loading:
            column_header, rows, sticky = None, [Line().add("Loading…", "dim")], False
        elif not result.data and result.error:
            column_header = None
            sticky = False
            source = {"hockeytech": "HockeyTech (the AHL's stats feed)"}.get(
                LEAGUES[self.league].get("source"), "ESPN")
            rows = wrap_spans(f"Could not reach {source}: {result.error}", inner_width, "err")

        # hockey: the games on top, the night's TV guide in its own pane under
        # them (the list gives up rows, and scrolls, before the guide goes)
        list_height, guide_height, points = height, 0, []
        if self.league in WIRE_LEAGUES and self.events and sticky:
            need = len(rows) + 3
            list_height = max(min(need, 8), min(need, height - 9))
            if height - list_height >= 9:
                guide_height = height - list_height
                points = points_tonight_lines(self.events, self.league, inner_width)
                spare = guide_height - 4 - 2 * len(self.events)
                if points and spare >= len(points) + 1:
                    list_height += len(points) + 1
                    guide_height -= len(points) + 1
                else:
                    points = []
            else:
                list_height = height

        self.draw_box(top, 0, list_height, left_width, caption, "sel")
        alerts = sum(1 for e in self.events
                     if e.get("upset") and e["upset"]["level"] == "live")
        # along the box's top: the live chip (a click is o) and the upset count
        badges = []
        if alerts:
            badges.append((f" ▲ {alerts} on upset watch ", "upsetbar", None))
        if self.live_only or live_count:
            badges.append((f" ● LIVE ONLY · {live_count} " if self.live_only
                           else f" ● {live_count} live ", "livechip" if self.live_only
                           else "livechipoff", self.toggle_live_only))
        end = left_width - 2
        for badge, style, action in badges:
            start = end - len(badge)
            if start <= len(caption) + 6:
                break
            self.put_pill(top, start, badge, style)
            if action:
                self.hot(top, start, start + len(badge), action)
            end = start - 1

        body_top = top + 1
        view_height = list_height - 2
        if sticky and column_header is not None:
            self.draw_lines([column_header], top + 1, 2, 1, inner_width, 0)
            body_top = top + 2
            view_height = list_height - 3
        if points:
            view_height -= len(points) + 1

        offset = self.scroll["Scoreboard"]
        if self.selected_index >= offset + view_height:
            offset = self.selected_index - view_height + 1
        if self.selected_index < offset:
            offset = self.selected_index
        offset = clamp(offset, 0, max(0, len(rows) - view_height))
        self.scroll["Scoreboard"] = offset

        self.draw_lines(rows, body_top, 2, view_height, inner_width, offset)
        self.draw_scrollbar(body_top, left_width - 2, view_height, len(rows), offset)
        if points:
            self.draw_lines(points, body_top + view_height + 1, 2, len(points), inner_width, 0)
        if guide_height:
            try:
                self.draw_tv_schedule(top + list_height, guide_height, left_width)
            except Exception:  # noqa: BLE001 - the guide is a nicety, never a crash
                self.draw_box(top + list_height, 0, guide_height, left_width,
                              "Television Schedule", "accent")
        if self.events:
            for row in range(view_height):
                index = offset + row
                if index < len(self.events):
                    self.hot(body_top + row, 1, left_width - 2,
                             lambda i=index: self.click_game(i),
                             lambda i=index: self.click_game(i, True))
            if gap and sticky:
                shown = self.events[offset:offset + view_height]
                for side in ("away", "home"):
                    self.logo_column(self.league, [e[side] for e in shown], body_top,
                                     2 + columns[side],
                                     selected=self.selected_index - offset)
        if right_width >= 30:
            self.wheel(top, top + height, left_width, width, ord("J"), ord("K"))

        if right_width < 30:
            return
        event = self.current_event()
        self.draw_box(top, left_width, height, right_width,
                      event["short_name"] if event else "Game", "accent")
        detail_width = right_width - 4
        if event:
            winner = game_winner(event) if self.logo_style != "off" and \
                self.team_logos != "off" else None
            art = None
            if winner:
                self.palette.logo_begin((self.league, winner.get("id"), self.team_logos))

                def art(cols, rows, team=winner):
                    return self.team_art(self.league, team, cols, rows)
            ours = self.league in WIRE_LEAGUES and event["state"] in ("in", "post") \
                and DETAIL_LEADERS.get(sport_of(self.league))
            detail = render_game_preview(event, self.league, detail_width,
                                         self.favorites, height=height - 2,
                                         logo_style=self.logo_style, art=art,
                                         leaders=not ours)
            if self.league in WIRE_LEAGUES:
                extra = game_detail_extras(event, self.league, detail_width)
                if extra:
                    detail = list(detail) + [blank()] + extra
        else:
            detail = [Line().add("No game selected.", "dim")]
        self.detail_scroll = clamp(self.detail_scroll, 0,
                                   max(0, len(detail) - (height - 2)))
        self.draw_lines(detail, top + 1, left_width + 2, height - 2, detail_width,
                        self.detail_scroll)
        self.draw_scrollbar(top + 1, left_width + right_width - 2, height - 2,
                            len(detail), self.detail_scroll)

    def nhl_day(self, day, live=False):
        """The NHL's own /score page for a day, which the TV guide (Canada's
        channels) and the live wire share; fetched quietly, in the background."""
        result = self.fetcher.get(("nhlscore", day.isoformat()),
                                  Loader("api-web.nhle.com", nhl_day_scores, day.isoformat()),
                                  ttl=20 if live else 900, background=True)
        return result.data

    def draw_tv_schedule(self, top, height, width):
        """The Scoreboard's hockey TV guide: the day's games down the side,
        the evening across the top in half hours, a cell for each game with
        its channels. It follows the picked game; a click on a row picks it."""
        inner = width - 4
        live = any(e.get("state") == "in" for e in self.events)
        nhl = self.nhl_day(self.day, live) if self.league == "nhl" else None
        channels = {e["id"]: event_channels(e, self.league, nhl) for e in self.events}
        picked = self.current_event()
        view = height - 4
        day, only = self.day, None
        if self.week_mode and LEAGUES[self.league]["week_based"]:
            # a week of games: the guide shows the picked game's day
            when = _local((picked or self.events[0]).get("date"))
            if when:
                day = only = when.date()
        guide = tv_schedule_lines(self.events, self.league, inner, view, channels=channels,
                                  selected=picked["id"] if picked else None, day=only)
        self.draw_box(top, 0, height, width,
                      f"Television Schedule · {day:%a %b} {day.day}", "accent")
        if not guide["head"]:
            self.draw_lines([Line().add("No start times to put on the guide yet.", "dim")],
                            top + 1, 2, 1, inner, 0)
            return
        self.draw_lines(guide["head"], top + 1, 2, 2, inner, 0)
        body = guide["body"]
        offset = self.scroll["TV guide"]
        if guide["focus"]:
            first, last = guide["focus"]
            if last >= offset + view:
                offset = last - view + 1
            if first < offset:
                offset = first
        offset = clamp(offset, 0, max(0, len(body) - view))
        self.scroll["TV guide"] = offset
        self.draw_lines(body, top + 3, 2, view, inner, offset)
        self.draw_scrollbar(top + 3, width - 2, view, len(body), offset)
        for row in range(view):
            index = guide["rows"].get(offset + row)
            if index is not None:
                self.hot(top + 3 + row, 1, width - 2,
                         lambda i=index: self.click_game(i),
                         lambda i=index: self.click_game(i, True))

    def draw_lines_box(self, top, height, width, caption, lines, key=None):
        """The usual single panel: a box, the lines, a scrollbar."""
        key = key or self.tab_name
        inner_width = width - 4
        self.draw_box(top, 0, height, width, caption, "accent")
        self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(lines) - (height - 2)))
        self.draw_lines(lines, top + 1, 2, height - 2, inner_width, self.scroll[key])
        self.draw_scrollbar(top + 1, width - 2, height - 2, len(lines), self.scroll[key])

    def standings_games(self):
        """The scoreboard's games - every one, not only the live ones - and
        what to call them (the week, or the day), for the college standings'
        conference box (6.22.0)."""
        try:
            result = self.load_scoreboard()
            kept = getattr(self, "_standings_games_kept", None)
            if kept and kept[0] is result.data:
                events = kept[1]
            else:
                events = self.prepare_events(result.data) if result.data else []
                self._standings_games_kept = (result.data, events)
        except Exception:  # noqa: BLE001 - the table without them
            events = []
        meta = LEAGUES[self.league]
        if self.week_mode and meta["week_based"]:
            title = self.period_caption().replace(" (current)", "")
        else:
            title = strf(self.day, "%a %b %-d")
        return events, title

    def draw_panel_tab(self, top, height, width, title):
        # keep the game list in sync so the header and selection stay correct
        if is_wiki_sport(self.league):
            events, _ = self.wiki_events()
            self.events = self.visible_wiki_events(events)
            self.sync_selection()
        else:
            result = self.load_scoreboard()
            if result.data:
                self.events = self.visible_events(self.prepare_events(result.data))
                self.sync_selection()

        inner_width = width - 4
        meta = LEAGUES[self.league]
        if title == "Betting":
            self.draw_betting(top, height, width)
            return
        if title == "Settings":
            self.draw_settings(top, height, width)
            return
        if title == "Scouting":
            event = self.current_event()
            if not event:
                self._news_refs = []
                self.draw_lines_box(top, height, width, "Scouting", [
                    Line().add("Pick a game on the Scoreboard tab first.", "dim")])
                return
            self.draw_scouting(top, height, width, event)
            return
        if title == "Stats" and self.stats_team and self.stats_team[0] == self.league:
            self.draw_team_players(top, height, width, self.stats_team[1])
            return
        if title == "Stats":
            table = self.load_team_table()
            fam = family(self.league)
            view = self.stats_view.get(self.league, "")
            lines = []
            if table.data:
                groups = stat_groups(table.data)
                conf = self.stats_conf_column()
                if not view:
                    view = "All" if stats_layout_fits(table.data, "All", inner_width,
                                                      conf=conf) \
                        else (groups[0] if groups else "All")
                    self.stats_view[self.league] = view
                shown = stats_view_groups(table.data, view, inner_width, conf=conf)
                group = self.group_filter.get(fam, "")
                top25 = self.top25_ids() if group == TOP25_GROUP else None
                order = []
                row_lines = []
                selected = self.stats_sel.get(self.league, 0)
                lines = render_stats_table(table.data, self.league, inner_width,
                                           self.favorites, view,
                                           self.stats_sort.get(self.league),
                                           "" if top25 is not None else group, top25,
                                           ranks=self.table_ranks(table.data),
                                           selected=selected, order=order,
                                           text=self.filter_text,
                                           order_by=self.stats_order(),
                                           row_lines=row_lines)
                self._stats_order = order
                self._stats_order_league = self.league
                self._stats_row_lines = row_lines
                if order and selected >= len(order):
                    self.stats_sel[self.league] = len(order) - 1
                lines.append(blank())
                hint = "j / k pick a team, enter its players  ·  [ ] one conference / " \
                       "division at a time" + (" (the Top 25 too)" if self.league in
                                               COLLEGE_LEAGUES else "") + \
                       ", c the list  ·  / find a team  ·  s sort, " \
                       "best-first, A-Z or by division  ·  g stat groups"
                lines.append(Line().add(hint + "  ·  green best fifth, red worst fifth "
                                        "of the league", "muted"))
                if table.data.get("sources"):
                    lines.append(Line().add("Sources: " + ", ".join(table.data["sources"]),
                                            "muted"))
            elif table.loading:
                lines = [Line().add("Loading every team's season numbers…", "dim")]
                if self.league in ("cbase", "csoft"):
                    lines.append(Line().add(
                        f"College {'baseball' if self.league == 'cbase' else 'softball'} "
                        "comes from the NCAA, a page at a time - about a minute the first "
                        "time.", "muted"))
            else:
                lines = wrap_spans(f"Team statistics unavailable: {table.error}",
                                   inner_width, "err")
            caption = f"{meta['label'] if is_olympic(self.league) else meta['name']} " \
                      "team stats · " + (" + ".join(shown) if table.data and view != "All"
                                         else "all groups")
            if self.group_filter.get(fam):
                caption += f" · {short_group(self.group_filter[fam])}"
            order_by = self.stats_order()
            if order_by == "name":
                caption += " · A-Z"
            elif order_by == "group":
                caption += " · by " + ("conference" if self.league in COLLEGE_LEAGUES
                                       else "league and division")
            if self.filter_text:
                caption += f" · find '{self.filter_text}'"
            if table.data:
                lines.insert(0, self.group_selector_line(inner_width))
            if table.data and not self._stats_order:
                lines[3:3] = [Line().add("  No team matches. / changes the search (empty "
                                         "clears it), c the conference.", "dim")]
            key = self.tab_name
            self.draw_box(top, 0, height, width, caption, "accent")
            # keep the two header rows in place while the teams scroll
            fixed = 3 if table.data else 0
            body = lines[fixed:]
            view_rows = height - 2 - fixed
            if table.data and self._stats_order and not self._mouse_pick:
                # keep the selected team on screen; with division headings in
                # the table a team's line is not its place in the list
                chosen = clamp(self.stats_sel.get(self.league, 0), 0,
                               len(self._stats_order) - 1)
                spots = [n - 2 for n in getattr(self, "_stats_row_lines", [])]
                line_at = spots[chosen] if chosen < len(spots) else chosen
                # scrolling up shows the headings above the team as well
                above = spots[chosen - 1] + 1 if 0 < chosen < len(spots) + 1 else 0
                if min(above, line_at) < self.scroll[key]:
                    self.scroll[key] = min(above, line_at)
                elif line_at >= self.scroll[key] + view_rows:
                    self.scroll[key] = line_at - view_rows + 1
            self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(body) - view_rows))
            if fixed:
                self.draw_lines(lines[:fixed], top + 1, 2, fixed, inner_width, 0)
            self.draw_lines(body, top + 1 + fixed, 2, view_rows, inner_width,
                            self.scroll[key])
            self.draw_scrollbar(top + 1 + fixed, width - 2, view_rows, len(body),
                                self.scroll[key])
            for number, at in enumerate(getattr(self, "_stats_row_lines", [])):
                shown_at = at - 2 - self.scroll[key]
                if 0 <= shown_at < view_rows:
                    league_now = self.league
                    self.hot(top + 1 + fixed + shown_at, 1, width - 2,
                             lambda n=number, lg=league_now: self.click_stats_row(lg, n),
                             lambda n=number, lg=league_now: self.click_stats_row(lg, n,
                                                                                  True))
            return
        if title == "Medals":
            table = self.load_medal_table()
            lines = render_medal_table(table.data, self.league, inner_width, self.favorites,
                                       table.loading, table.error)
            self.draw_lines_box(top, height, width, f"{meta['games']} · medal table", lines)
            return
        if title in ("Results", "Medalists"):
            if title == "Results":
                event = self.current_event()
                if not event:
                    lines = [Line().add("Pick an event on the Events tab first.", "dim")]
                    caption = "Results"
                else:
                    page = self.load_event_page(event)
                    caption = f"{event['name']} · results"
                    if page.data:
                        lines = render_event_results(event, page.data, self.league,
                                                     inner_width, self.favorites)
                    elif page.loading:
                        lines = [Line().add("Loading the event page…", "dim")]
                    else:
                        lines = wrap_spans(f"Could not load the event page: {page.error}",
                                           inner_width, "err")
            else:
                _, page = self.wiki_events()
                caption = f"{meta['label']} · medallists"
                if page.data:
                    lines = render_sport_medallists(page.data, self.league, inner_width,
                                                    self.favorites)
                elif page.loading:
                    lines = [Line().add("Loading the sport's page…", "dim")]
                else:
                    lines = wrap_spans(f"Could not load the sport's page: {page.error}",
                                       inner_width, "err")
            self.draw_lines_box(top, height, width, caption, lines)
            return
        if title == "Favorites":
            teams_result = self.load_teams()
            teams = parse_teams(teams_result.data) if teams_result.data else []
            if is_olympic(self.league):
                self.fav_rows = favorites_rows(teams, self.favorites, self.league,
                                               self.fav_filter)
            else:
                try:
                    groups = self.team_groups()
                except Exception:  # noqa: BLE001 - every team in Other teams
                    groups = {}
                self.fav_rows = favorites_tree(teams, self.favorites, self.league,
                                               self.fav_filter, groups,
                                               self.fav_open.setdefault(self.league, set()))
            follow = getattr(self, "_fav_follow", None)
            if follow:
                # a starred team moves up the list: the cursor goes with it
                at = next((i for i, row in enumerate(self.fav_rows)
                           if row and str(row.get("id")) == follow), None)
                if at is not None:
                    self.fav_cursor = at
                self._fav_follow = None
            self.fav_cursor = clamp(self.fav_cursor, 0, max(0, len(self.fav_rows) - 1))
            state = {
                "league": self.league,
                "favorites": self.favorites,
                "rows": self.fav_rows,
                "cursor": self.fav_cursor,
                "filter": self.fav_filter,
                "loading": teams_result.loading,
                "error": None if teams_result.data else teams_result.error,
            }
            lines = render_favorites(state, inner_width)
            caption = "Favorites"
            self.draw_box(top, 0, height, width, caption, "accent")
            key = self.tab_name
            view = height - 2
            head = 9 + len(LEAGUE_ORDER) - 3
            cursor_line = next((i for i, line in enumerate(lines)
                                if line and line[0][1] == "selbar"), 0)
            offset = self.scroll[key]
            if cursor_line >= offset + view:
                offset = cursor_line - view + 1
            if cursor_line < offset:
                offset = max(0, cursor_line - head)
            offset = clamp(offset, 0, max(0, len(lines) - view))
            self.scroll[key] = offset
            self.draw_lines(lines, top + 1, 2, view, inner_width, offset)
            self.draw_scrollbar(top + 1, width - 2, view, len(lines), offset)
            if self.fav_rows and not state["error"]:
                first_row = len(lines) - len(self.fav_rows)
                for index in range(len(self.fav_rows)):
                    shown_at = first_row + index - offset
                    if 0 <= shown_at < view:
                        self.hot(top + 1 + shown_at, 1, width - 2,
                                 lambda i=index: self.click_favorite(i),
                                 lambda i=index: self.click_favorite(i, True))
            return

        if title in ("Playoffs", "Medal Round"):
            self.draw_playoffs(top, height, width, title)
            return

        if title == "Standings" and self.standings_team and \
                self.standings_team[0] == self.league:
            team = self.standings_team[1]
            caption = Line().add(" ", "border")
            caption.add(team.get("name") or team.get("abbr") or "?",
                        THEME.style(self.league, team, bold=True, fallback="accent"))
            caption.add("  team page", "accent").add(" · esc back to the standings ", "muted")
            self.draw_team_schedule(top, height, width, team, caption,
                                    back="esc goes back to the standings.")
            return
        if title == "Standings":
            standings = self.load_standings()
            spots = []
            gap = 3 if self.graphics.enabled and self.team_logos != "off" else 0
            self._standings_order, self._standings_picks = [], []
            view_now = None
            if standings.data and self.league in COLLEGE_LEAGUES and not self.filter_text \
                    and not self.group_filter.get(family(self.league)):
                url, spare = self.api.rankings(self.league)
                poll = self.fetcher.get(("rankings", self.league), url, ttl=1800,
                                        fallbacks=spare).data
                games, games_title = self.standings_games()
                try:
                    view_now = college_standings_view(
                        standings.data, self.league, inner_width, self.favorites,
                        self.standings_sel.get(self.league), poll, corners=self.corners(),
                        logo_gap=gap, rows=height - 2, games=games,
                        games_title=games_title)
                except Exception:  # noqa: BLE001 - the tables as before
                    view_now = None
            if view_now:
                lines, spots, self._standings_picks, self._standings_order = view_now
                ids = [str(team.get("id")) for team, _ in self._standings_order]
                if str(self.standings_sel.get(self.league)) not in ids and ids:
                    self.standings_sel[self.league] = self._standings_order[0][0]["id"]
                    lines, spots, self._standings_picks, self._standings_order = \
                        college_standings_view(standings.data, self.league, inner_width,
                                               self.favorites, self.standings_sel[self.league],
                                               poll, corners=self.corners(), logo_gap=gap,
                                               rows=height - 2, games=games,
                                               games_title=games_title)
            elif standings.data:
                chosen = self.standings_sel.get(self.league)
                group = self.group_filter.get(family(self.league), "")
                top25 = self.top25_ranks() if group == TOP25_GROUP else None
                if top25 is not None:
                    group = ""
                lines = render_standings(standings.data, self.league, inner_width,
                                         self.favorites, group,
                                         self.filter_text, selected=chosen, spots=spots,
                                         logo_gap=gap, top25=top25)
                if getattr(self, "_standings_league", None) != self.league:
                    self._standings_league = self.league     # a new league: show its pick
                    self._standings_follow = True
                if spots and chosen not in [s["team"]["id"] for s in spots]:
                    # nothing picked yet, or filtered away: the first team
                    self._standings_follow = True
                    self.standings_sel[self.league] = spots[0]["team"]["id"]
                    lines = render_standings(standings.data, self.league, inner_width,
                                             self.favorites, group, self.filter_text,
                                             selected=spots[0]["team"]["id"], spots=[],
                                             logo_gap=gap, top25=top25)
                if self.league in ("nhl", "ahl") and not self.filter_text and \
                        not self.group_filter.get(family(self.league)):
                    lines = hockey_standings_extras(lines, standings.data, self.league,
                                                    inner_width, self.favorites,
                                                    corners=self.corners())
                elif self.league in STANDINGS_EXTRA_LEAGUES and not self.filter_text and \
                        not self.group_filter.get(family(self.league)):
