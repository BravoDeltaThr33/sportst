# --------------------------------------------------------------------------
# Minor League Baseball, through the MLB Stats API (7.0.0)
# --------------------------------------------------------------------------
# ESPN does not carry the minors. MLB's own Stats API does - every affiliated
# game from Triple-A down to Single-A, free and open - and an adapter here
# reshapes it into ESPN's payloads (scoreboard, summary, teams, standings,
# schedules, rosters), so every MLB screen works for it unchanged. Its teams
# wear their parent club's colours, as the AHL's do their NHL parent's.

MILB_LEVELS = {11: ("Triple-A", "AAA"), 12: ("Double-A", "AA"), 13: ("High-A", "A+"),
               14: ("Single-A", "A")}
MILB_SPORTS = "11,12,13,14"
MILB_HOST = "statsapi.mlb.com"
MILB_LOGO = ("https://img.mlbstatic.com/mlb-photos/image/upload/w_500,f_png,q_auto/v1/"
             "team/{}/logo/spot/current")
MILB_STREAM = "MiLB.TV"
MILB_FEED = "https://statsapi.mlb.com/api/v1.1/game/{}/feed/live"
# the Stats API's abbreviations where ESPN's (MLB_COLORS') differ
MLB_ABBR_ALIASES = {"AZ": "ARI", "CWS": "CHW", "ATH": "ATH", "OAK": "ATH"}
MILB_CACHE = {}


def milb_get(path, timeout=15):
    return http_json(f"{STATS_API}{path}", timeout)


def milb_season(day=None):
    """The minor-league season a day belongs to: its year once spring comes,
    the last one's before that."""
    day = day or Date.today()
    return day.year if (day.month, day.day) >= (3, 20) else day.year - 1


def milb_parents(timeout=15):
    """{MLB team id: '#RRGGBB'} - each big-league club's colour, which its
    farm teams wear here. Kept for the run."""
    if "parents" in MILB_CACHE:
        return MILB_CACHE["parents"]
    milb_catalog(timeout)
    out = {}
    try:
        data = milb_get(f"/teams?sportId=1&season={milb_season()}", timeout)
        for team in data.get("teams") or []:
            abbr = clean(team.get("abbreviation") or "").upper()
            colour = MLB_COLORS.get(MLB_ABBR_ALIASES.get(abbr, abbr))
            if colour:
                out[team.get("id")] = colour
    except Exception:  # noqa: BLE001 - grey teams until it answers
        return {}
    MILB_CACHE["parents"] = out
    return out


def milb_catalog(timeout=15):
    """{team id: the Stats API's team} for every minor-league team this
    season, kept for the run: one name and abbreviation for each, whichever
    endpoint the game came from (the schedule and the game feed disagree)."""
    if "catalog" in MILB_CACHE:
        return MILB_CACHE["catalog"]
    out = {}
    try:
        for sport in MILB_LEVELS:
            data = milb_get(f"/teams?sportId={sport}&season={milb_season()}", timeout)
            for team in data.get("teams") or []:
                out[team.get("id")] = team
    except Exception:  # noqa: BLE001 - each endpoint's own names until then
        return {}
    MILB_CACHE["catalog"] = out
    return out


def milb_team(node, parents=None):
    """A Stats API team as ESPN's team block: its logo, and its parent's
    colour."""
    node = node or {}
    ident = node.get("id")
    known = MILB_CACHE.get("catalog", {}).get(ident)
    if known:
        node = dict(node, **{k: v for k, v in known.items() if v not in (None, "")})
    parents = parents if parents is not None else milb_parents()
    colour = (parents.get(node.get("parentOrgId")) or "").lstrip("#")
    name = clean(node.get("name") or "")
    club = clean(node.get("teamName") or node.get("clubName") or name)
    place = clean(node.get("locationName") or node.get("shortName")
                  or node.get("franchiseName") or "")
    sport = _int(dig(node, "sport", "id", default=0))
    return {"id": str(ident or ""), "abbreviation": clean(node.get("abbreviation") or "")
            or club[:3].upper(), "displayName": name, "shortDisplayName": club,
            "name": club, "location": place, "color": colour, "alternateColor": "",
            "logo": MILB_LOGO.format(ident) if ident else "",
            "logos": [{"href": MILB_LOGO.format(ident)}] if ident else [],
            "level": MILB_LEVELS.get(sport, ("", ""))[0],
            "parent": clean(node.get("parentOrgName") or "")}


def milb_status(game, linescore=None):
    """ESPN's status block from a Stats API game and its line score."""
    status = game.get("status") or {}
    state = clean(status.get("abstractGameState") or "")
    detailed = clean(status.get("detailedState") or "")
    line = linescore or game.get("linescore") or {}
    inning = _int(line.get("currentInning"))
    scheduled = _int(line.get("scheduledInnings")) or 9
    if state == "Final" or detailed in ("Final", "Game Over", "Completed Early"):
        tail = f"/{inning}" if inning and inning != scheduled else ""
        detail = f"Final{tail}"
        if detailed in ("Postponed", "Cancelled"):
            detail = detailed
        return {"period": inning, "displayClock": "0:00",
                "type": {"state": "post", "completed": detailed not in
                         ("Postponed", "Cancelled"), "shortDetail": detail,
                         "detail": detail, "description": detailed}}
    if state == "Live" and detailed not in ("Delayed Start", "Warmup", "Pre-Game"):
        half = clean(line.get("inningState") or "")
        word = {"Top": "Top", "Bottom": "Bot", "Middle": "Mid", "End": "End"}.get(half, half)
        detail = f"{word} {ordinal(inning)}".strip() if inning else (detailed or "In Progress")
        if detailed.startswith(("Delayed", "Suspended")):
            detail = detailed
        return {"period": inning, "displayClock": "",
                "type": {"state": "in", "completed": False, "shortDetail": detail,
                         "detail": detail, "description": detailed}}
    text = detailed if detailed in ("Postponed", "Cancelled", "Suspended") else "Scheduled"
    return {"period": 0, "displayClock": "",
            "type": {"state": "post" if text in ("Postponed", "Cancelled") else "pre",
                     "completed": False, "shortDetail": text, "detail": text,
                     "description": detailed}}


def milb_situation(line):
    """ESPN's live baseball situation from a Stats API line score: the count,
    the outs and who is on."""
    offense = line.get("offense") or {}
    defense = line.get("defense") or {}
    out = {"balls": _int(line.get("balls")), "strikes": _int(line.get("strikes")),
           "outs": _int(line.get("outs"))}
    for base, key in (("first", "onFirst"), ("second", "onSecond"), ("third", "onThird")):
        runner = offense.get(base)
        if isinstance(runner, dict):
            out[key] = {"athlete": {"id": str(runner.get("id") or ""),
                                    "shortName": short_name(clean(runner.get("fullName")
                                                                  or "")),
                                    "displayName": clean(runner.get("fullName") or "")}}
    for key, node in (("batter", offense.get("batter")), ("pitcher", defense.get("pitcher"))):
        if isinstance(node, dict):
            out[key] = {"athlete": {"id": str(node.get("id") or ""),
                                    "shortName": short_name(clean(node.get("fullName") or "")),
                                    "displayName": clean(node.get("fullName") or "")}}
    return out


def milb_event(game, parents=None):
    """One Stats API schedule game as an ESPN scoreboard event."""
    parents = parents if parents is not None else milb_parents()
    line = game.get("linescore") or {}
    status = milb_status(game, line)
    competitors = []
    innings = line.get("innings") or []
    for side in ("home", "away"):
        node = dig(game, "teams", side, default={}) or {}
        team = milb_team(node.get("team") or {}, parents)
        record = node.get("leagueRecord") or {}
        lines = [{"value": _int(dig(inning, side, "runs", default=0))}
                 for inning in innings if dig(inning, side, "runs") is not None]
        entry = {"homeAway": side, "team": team,
                 "score": "" if node.get("score") is None else str(node.get("score")),
                 "linescores": lines,
                 "hits": dig(line, "teams", side, "hits"),
                 "errors": dig(line, "teams", side, "errors"),
                 "records": [{"type": "total", "summary":
                              f"{_int(record.get('wins'))}-{_int(record.get('losses'))}"}]
                 if record else []}
        if node.get("isWinner"):
            entry["winner"] = True
        pitcher = node.get("probablePitcher")
        if isinstance(pitcher, dict) and pitcher.get("fullName"):
            entry["probables"] = [{"athlete": {"id": str(pitcher.get("id") or ""),
                                               "displayName": clean(pitcher["fullName"]),
                                               "shortName": short_name(
                                                   clean(pitcher["fullName"]))}}]
        competitors.append(entry)
    home, away = competitors
    sport = _int(dig(game, "teams", "home", "team", "sport", "id", default=0))
    league = clean(dig(game, "teams", "home", "team", "league", "name", default="") or "")
    level = MILB_LEVELS.get(sport, ("", ""))[0]
    notes = []
    kind = clean(game.get("gameType") or "R")
    if kind not in ("R", "S", "E", "A"):
        notes.append({"headline": clean(game.get("seriesDescription") or "Postseason")
                      + (f" - Game {game.get('seriesGameNumber')}"
                         if game.get("seriesGameNumber") else "")})
    elif level or league:
        notes.append({"headline": " · ".join(x for x in (level, league) if x)})
    if _int(line.get("scheduledInnings")) == 7:
        notes.append({"headline": "seven innings"})
    competition = {"competitors": competitors, "status": status,
                   "format": {"regulation": {"periods": _int(line.get("scheduledInnings"))
                                             or 9}},
                   "venue": {"fullName": clean(dig(game, "venue", "name", default="") or ""),
                             "address": {"city": clean(dig(game, "venue", "location", "city",
                                                           default="") or "")}},
                   "notes": notes,
                   "broadcasts": [{"market": "national", "names": [MILB_STREAM]}]}
    if status["type"]["state"] == "in":
        competition["situation"] = milb_situation(line)
    return {"id": str(game.get("gamePk") or ""),
            "name": f"{away['team']['displayName']} at {home['team']['displayName']}",
            "shortName": f"{away['team']['abbreviation']} @ {home['team']['abbreviation']}",
            "date": clean(game.get("gameDate") or ""),
            "status": status, "competitions": [competition],
            "season": {"year": _int(game.get("season")),
                       "type": 3 if kind not in ("R", "S", "E", "A") else 2},
            "seasonType": {"type": 3 if kind not in ("R", "S", "E", "A") else 2,
                           "name": "Postseason" if kind not in ("R", "S", "E", "A")
                           else "Regular Season"}}


MILB_HYDRATE = "team,linescore,venue(location),probablePitcher"


def milb_scoreboard(day_iso, timeout=15):
    """A day's minor-league games, every level, as ESPN's scoreboard."""
    data = milb_get(f"/schedule?sportId={MILB_SPORTS}&date={day_iso}"
                    f"&hydrate={MILB_HYDRATE}", timeout)
    parents = milb_parents(timeout)
    events = [milb_event(game, parents) for day in data.get("dates") or []
              for game in day.get("games") or []]
    events.sort(key=lambda e: (e["date"], e["shortName"]))
    try:
        year = int(day_iso[:4])
    except ValueError:
        year = Date.today().year
    return {"events": events, "day": {"date": day_iso},
            "leagues": [{"season": {"year": year}}]}


def milb_teams(timeout=15):
    """Every affiliated minor-league team, as ESPN's teams payload."""
    parents = milb_parents(timeout)
    season = milb_season()
    teams = []
    for sport in MILB_LEVELS:
        data = milb_get(f"/teams?sportId={sport}&season={season}", timeout)
        for node in data.get("teams") or []:
            if node.get("active", True):
                teams.append({"team": milb_team(node, parents)})
    teams.sort(key=lambda t: t["team"]["displayName"])
    return {"sports": [{"leagues": [{"teams": teams}]}]}


def milb_standings(timeout=15):
    """Every league's table, level by level and division by division, as
    ESPN's standings payload."""
    parents = milb_parents(timeout)
    season = milb_season()
    levels = []
    for sport, (level, _) in MILB_LEVELS.items():
        leagues = milb_get(f"/league?sportId={sport}&season={season}", timeout)
        divisions = milb_get(f"/divisions?sportId={sport}&season={season}", timeout)
        division_names = {d.get("id"): clean(d.get("nameShort") or d.get("name") or "")
                          for d in divisions.get("divisions") or []}
        mine = [lg for lg in leagues.get("leagues") or []
                if _int(dig(lg, "sport", "id", default=0)) == sport]
        if not mine:
            continue
        ids = ",".join(str(lg.get("id")) for lg in mine)
        table = milb_get(f"/standings?leagueId={ids}&season={season}"
                         "&standingsTypes=regularSeason&hydrate=team", timeout)
        children = {}
        for record in table.get("records") or []:
            league_id = dig(record, "league", "id")
            league_name = next((clean(lg.get("name") or "") for lg in mine
                                if lg.get("id") == league_id), "")
            entries = []
            for row in record.get("teamRecords") or []:
                wins, losses = _int(dig(row, "leagueRecord", "wins")), \
                    _int(dig(row, "leagueRecord", "losses"))
                scored, allowed = _int(row.get("runsScored")), _int(row.get("runsAllowed"))
                played = max(1, wins + losses)
                splits = {s.get("type"): s for s in dig(row, "records", "splitRecords",
                                                        default=[]) or []}

                def split(kind):
                    s = splits.get(kind) or {}
                    return f"{_int(s.get('wins'))}-{_int(s.get('losses'))}" if s else ""
                stats = [
                    {"name": "wins", "value": wins, "displayValue": str(wins)},
                    {"name": "losses", "value": losses, "displayValue": str(losses)},
                    {"name": "winPercent", "value": wins / played,
                     "displayValue": clean(dig(row, "leagueRecord", "pct", default="") or "")},
                    {"name": "gamesBehind", "displayValue": clean(row.get("gamesBack") or "-")},
                    {"name": "gamesPlayed", "value": wins + losses,
                     "displayValue": str(wins + losses)},
                    {"name": "streak", "displayValue": clean(dig(row, "streak", "streakCode",
                                                                default="") or "")},
                    {"name": "pointsFor", "value": scored, "displayValue": str(scored)},
                    {"name": "pointsAgainst", "value": allowed, "displayValue": str(allowed)},
                    {"name": "pointDifferential", "value": scored - allowed,
                     "displayValue": f"{scored - allowed:+d}"},
                    {"name": "differential", "value": (scored - allowed) / played,
                     "displayValue": f"{(scored - allowed) / played:+.1f}"},
                    {"name": "avgPointsFor", "value": scored / played,
                     "displayValue": f"{scored / played:.1f}"},
                    {"name": "avgPointsAgainst", "value": allowed / played,
                     "displayValue": f"{allowed / played:.1f}"},
                    {"name": "homeWins", "value": _int((splits.get("home") or {}).get("wins")),
                     "displayValue": str(_int((splits.get("home") or {}).get("wins")))},
                    {"name": "homeLosses",
                     "value": _int((splits.get("home") or {}).get("losses")),
                     "displayValue": str(_int((splits.get("home") or {}).get("losses")))},
                    {"name": "roadWins", "value": _int((splits.get("away") or {}).get("wins")),
                     "displayValue": str(_int((splits.get("away") or {}).get("wins")))},
                    {"name": "roadLosses",
                     "value": _int((splits.get("away") or {}).get("losses")),
                     "displayValue": str(_int((splits.get("away") or {}).get("losses")))},
                    {"name": "Home", "displayValue": split("home"), "summary": split("home")},
                    {"name": "Road", "displayValue": split("away"), "summary": split("away")},
                    {"name": "Last Ten Games", "displayValue": split("lastTen"),
                     "summary": split("lastTen")},
                    {"name": "playoffSeed", "value": 0, "displayValue": "0"},
                    {"name": "overall", "displayValue": f"{wins}-{losses}",
                     "summary": f"{wins}-{losses}"},
                ]
                entries.append({"team": milb_team(row.get("team") or {}, parents),
                                "stats": stats})
            entries.sort(key=lambda e: -float(e["stats"][2]["value"]))
            group = children.setdefault(league_name, {"name": league_name, "children": []})
            group["children"].append({"name": division_names.get(dig(record, "division",
                                                                    "id"), league_name),
                                      "standings": {"entries": entries}})
        levels.append({"name": level, "children": list(children.values())})
    return {"children": levels, "season": {"year": season}}


def milb_team_schedule(team_id, timeout=15):
    """The team's season, game by game, in the app's schedule form."""
    season = milb_season()
    data = milb_get(f"/schedule?teamId={team_id}&sportId={MILB_SPORTS}&season={season}"
                    f"&hydrate={MILB_HYDRATE}", timeout)
    parents = milb_parents(timeout)
    games, seen = [], set()
    for day in data.get("dates") or []:
        for game in day.get("games") or []:
            event = milb_event(game, parents)
            built = _season_game(event, str(team_id))
            if built and built["id"] and built["id"] not in seen:
                seen.add(built["id"])
                games.append(built)
    games.sort(key=lambda g: g["date"])
    done = [g for g in games if g["state"] == "post" and g.get("result") in ("W", "L")]
    wins = sum(1 for g in done if g["result"] == "W")
    return {"games": games, "season": str(season), "standing": "",
            "record": f"{wins}-{len(done) - wins}" if done else ""}


def milb_roster(team_id, timeout=15):
    """The team's active roster as ESPN's roster payload, by position group."""
    data = milb_get(f"/teams/{team_id}/roster?rosterType=active&season={milb_season()}"
                    "&hydrate=person", timeout)
    groups = {}
    order = {"Pitcher": "Pitchers", "Catcher": "Catchers", "Infielder": "Infielders",
             "Outfielder": "Outfielders", "Two-Way Player": "Pitchers",
             "Designated Hitter": "Designated Hitter"}
    for row in data.get("roster") or []:
        person = row.get("person") or {}
        kind = order.get(clean(dig(row, "position", "type", default="") or ""), "Others")
        name = clean(person.get("fullName") or "")
        place = ", ".join(x for x in (clean(person.get("birthCity") or ""),
                                      clean(person.get("birthStateProvince")
                                            or person.get("birthCountry") or "")) if x)
        groups.setdefault(kind, []).append({
            "id": str(person.get("id") or ""), "fullName": name, "displayName": name,
            "shortName": short_name(name), "jersey": clean(row.get("jerseyNumber") or ""),
            "position": {"abbreviation": clean(dig(row, "position", "abbreviation",
                                                   default="") or ""),
                         "displayName": clean(dig(row, "position", "name", default="") or "")},
            "age": person.get("currentAge"), "displayHeight": clean(person.get("height") or ""),
            "displayWeight": f"{person['weight']} lbs" if person.get("weight") else "",
            "birthPlace": {"city": clean(person.get("birthCity") or ""),
                           "state": clean(person.get("birthStateProvince") or ""),
                           "country": clean(person.get("birthCountry") or "")},
            "bats": clean(dig(person, "batSide", "description", default="") or ""),
            "throws": clean(dig(person, "pitchHand", "description", default="") or ""),
            "status": clean(dig(row, "status", "description", default="") or "Active"),
            "injuries": [], "place": place})
    return {"athletes": [{"position": name, "items": items}
                         for name, items in groups.items()]}


# a pitch's call in the Stats API, as ESPN names it
MILB_CALLS = {"called strike": "Strike Looking", "automatic strike": "Strike Looking",
              "swinging strike": "Strike Swinging", "swinging strike (blocked)":
              "Strike Swinging", "missed bunt": "Strike Swinging", "foul tip":
              "Strike Swinging", "foul": "Foul Ball", "foul bunt": "Foul Ball",
              "foul pitchout": "Foul Ball", "ball": "Ball", "ball in dirt": "Ball",
              "automatic ball": "Ball", "intent ball": "Ball", "pitchout": "Ball",
              "hit by pitch": "Hit By Pitch"}
MILB_STEALS = {"stolen base": "Stolen Base", "caught stealing": "Caught Stealing",
               "pickoff": "Pickoff", "wild pitch": "Wild Pitch", "passed ball": "Passed Ball",
               "balk": "Balk"}


# a play's text in ESPN's words: the Stats API writes in the present tense
# ("singles", "grounds out"), ESPN's MLB play by play in the past, and every
# reader of a play's text - its result's kind, the game's homers, the wire,
# the clips - reads MLB's, so MiLB's is put in the same tense
MILB_TENSE = [(r"\bcalled out on strikes\b", "struck out looking"),
              (r"\bstrikes out\b", "struck out"), (r"\bsingles\b", "singled"),
              (r"\bdoubles\b", "doubled"), (r"\btriples\b", "tripled"),
              (r"\bhomers\b", "homered"),
              (r"\bhits a grand slam\b", "homered for a grand slam"),
              (r"\bhits (an?) ", r"hit \1 "), (r"\bwalks\b", "walked"),
              (r"\bgrounds\b", "grounded"), (r"\bflies\b", "flied"),
              (r"\blines\b", "lined"), (r"\bpops\b", "popped"), (r"\bbunts\b", "bunted"),
              (r"\breaches\b", "reached"), (r"\bscores\b", "scored"),
              (r"\badvances\b", "advanced"), (r"\bsteals\b", "stole")]
# the Stats API's pitch names as ESPN's MLB play by play has them
MILB_PITCH_NAMES = {"Four-Seam Fastball": "Four-seam FB", "Two-Seam Fastball": "Two-seam FB",
                    "Split-Finger": "Splitter", "Knuckle Ball": "Knuckleball",
                    "Knuckle Curve": "Knuckle curve", "Slow Curve": "Slow curve",
                    "Pitch Out": "Pitchout"}
# the Stats API's kind of a plate appearance as baseball_result_kind's
MILB_EVENT_KIND = {"single": "1B", "double": "2B", "triple": "3B", "home_run": "HR",
                   "walk": "BB", "intent_walk": "IBB", "hit_by_pitch": "HBP",
                   "sac_fly": "SF", "sac_fly_double_play": "SF", "sac_bunt": "SAC",
                   "sac_bunt_double_play": "SAC", "strikeout": "K",
                   "strikeout_double_play": "K", "strikeout_triple_play": "K",
                   "grounded_into_double_play": "DP", "double_play": "DP",
                   "triple_play": "DP", "fielders_choice": "FC",
                   "fielders_choice_out": "FC", "force_out": "FC", "field_error": "E",
                   "catcher_interf": "CI"}
MILB_OUT_KIND = {"G": "GO", "F": "FO", "L": "LO", "P": "PO"}


def milb_text(text):
    """A Stats API play description in ESPN's tense (MILB_TENSE)."""
    text = clean(text or "")
    for pattern, past in MILB_TENSE:
        text = re.sub(pattern, past, text)
    return text


def _milb_runner(node):
    if not isinstance(node, dict) or not node.get("id"):
        return None
    return {"athlete": {"id": str(node.get("id")),
                        "shortName": short_name(clean(node.get("fullName") or "")),
                        "displayName": clean(node.get("fullName") or "")}}


def milb_plays(feed, ids):
    """The Stats API's plays as ESPN's baseball play stream: each half
    inning's start, each at-bat's start (who pitches to whom, the runners on),
    its pitches (call, speed, kind, where it crossed), the baserunning between
    them and its result (the outs, the score and the runners after it)."""
    plays = []
    away_id, home_id = ids
    half_key = None
    bases = {}
    score = (0, 0)
    sequence = 0
    outs_before = 0

    def add(entry):
        nonlocal sequence
        sequence += 1
        entry.setdefault("id", f"{sequence}")
        entry["sequenceNumber"] = str(sequence)
        plays.append(entry)
    for play in dig(feed, "liveData", "plays", "allPlays", default=[]) or []:
        about = play.get("about") or {}
        top = bool(about.get("isTopInning"))
        inning = _int(about.get("inning"))
        period = {"type": "Top" if top else "Bottom", "number": inning,
                  "displayValue": f"{ordinal(inning)} Inning"}
        batting = away_id if top else home_id
        if (inning, top) != half_key:
            half_key, bases, outs_before = (inning, top), {}, 0
            add({"type": {"id": "59", "text": "Start Inning"}, "summaryType": "I",
                 "text": f"{'Top' if top else 'Bottom'} of the {ordinal(inning)} inning",
                 "period": period, "team": {"id": batting}, "outs": 0,
                 "awayScore": score[0], "homeScore": score[1]})
        matchup = play.get("matchup") or {}
        batter, pitcher = matchup.get("batter") or {}, matchup.get("pitcher") or {}
        count = play.get("count") or {}
        result = play.get("result") or {}
        start = {"type": {"id": "1", "text": "Start Batter/Pitcher"}, "summaryType": "A",
                 "text": f"{clean(pitcher.get('fullName') or '')} pitches to "
                         f"{clean(batter.get('fullName') or '')}",
                 "period": period, "team": {"id": batting},
                 "participants": [{"type": "batter", "athlete": {"id": str(batter.get("id"))}},
                                  {"type": "pitcher",
                                   "athlete": {"id": str(pitcher.get("id"))}}],
                 "bats": {"abbreviation": clean(dig(matchup, "batSide", "code",
                                                    default="") or "")},
                 "outs": outs_before, "awayScore": score[0],
                 "homeScore": score[1], "pitchCount": {"balls": 0, "strikes": 0}}
        start.update(bases)
        add(start)
        number = 0
        path = None
        events = play.get("playEvents") or []
        for index, event in enumerate(events):
            details = event.get("details") or {}
            if event.get("isPitch"):
                number += 1
                call = clean(dig(details, "call", "description", default="")
                             or details.get("description") or "")
                low = call.lower()
                in_play = bool(details.get("isInPlay")) or low.startswith("in play")
                label = MILB_CALLS.get(low, "Ball" if "ball" in low else "Strike Looking")
                after = event.get("count") or {}
                pitch = {"summaryType": "P", "period": period, "team": {"id": batting},
                         "atBatPitchNumber": number,
                         "resultCount": {"balls": _int(after.get("balls")),
                                         "strikes": _int(after.get("strikes"))},
                         "outs": min(2, _int(after.get("outs"), outs_before))}
                if in_play:
                    pitch["type"] = {"text": clean(result.get("event") or "In Play")}
                    pitch["text"] = f"Pitch {number} : Ball In Play"
                else:
                    pitch["type"] = {"text": label}
                    pitch["text"] = f"Pitch {number} : {call}"
                data = event.get("pitchData") or {}
                speed = data.get("startSpeed")
                if isinstance(speed, (int, float)):
                    pitch["pitchVelocity"] = round(float(speed))
                kind = details.get("type") or {}
                if kind.get("description"):
                    pitch["pitchType"] = {"text": MILB_PITCH_NAMES.get(
                        clean(kind["description"]), clean(kind["description"])),
                                          "abbreviation": clean(kind.get("code") or "")}
                spot = data.get("coordinates") or {}
                if isinstance(spot.get("pX"), (int, float)) and \
                        isinstance(spot.get("pZ"), (int, float)):
                    x, y = feet_to_px(-float(spot["pX"]), float(spot["pZ"]))
                    pitch["pitchCoordinate"] = {"x": round(x), "y": round(y)}
                hit = event.get("hitData") or {}
                if in_play and hit:
                    trajectory = clean(hit.get("trajectory") or "").lower()
                    letter = {"ground_ball": "G", "fly_ball": "F", "line_drive": "L",
                              "popup": "P", "bunt_grounder": "G", "bunt_popup": "P",
                              "bunt_line_drive": "L"}.get(trajectory)
                    if letter:
                        pitch["trajectory"] = path = letter
                    spot = hit.get("coordinates") or {}
                    if spot.get("coordX") is not None:
                        pitch["hitCoordinate"] = {"x": spot.get("coordX"),
                                                  "y": spot.get("coordY")}
                add(pitch)
                continue
            text = milb_text(details.get("description"))
            kind = clean(details.get("event") or "")
            low = kind.lower()
            steal = next((name for key, name in MILB_STEALS.items() if low.startswith(key)),
                         None)
            if not text or low.startswith("pickoff attempt") or \
                    text.lower().startswith("pickoff attempt"):
                continue          # a throw over, not a play
            if "substitution" in low or "defensive switch" in low or low.startswith(
                    ("game advisory", "pitching change", "batter timeout", "mound visit")):
                if "pitching substitution" in low or "pitching change" in low:
                    found = re.match(r".*?:\s*(.+?) replaces (.+?)\.?$", text)
                    if found:
                        text = f"{short_name(found.group(1))} relieved " \
                               f"{short_name(found.group(2))}"
                if low.startswith(("game advisory", "batter timeout", "mound visit")):
                    continue
                add({"type": {"text": "Play Result"}, "summaryType": "N", "text": text,
                     "period": period, "team": {"id": batting},
                     "outs": _int(count.get("outs")),
                     "awayScore": score[0], "homeScore": score[1]})
                continue
            entry = {"type": {"text": steal or "Play Result"}, "summaryType": "N",
                     "text": text, "period": period, "team": {"id": batting},
                     "outs": _int(dig(event, "count", "outs"), outs_before),
                     "awayScore": _int(details.get("awayScore"), score[0]),
                     "homeScore": _int(details.get("homeScore"), score[1]),
                     "scoringPlay": bool(details.get("isScoringPlay"))}
            add(entry)
            if steal:
                add(dict(entry, type={"text": "Play Result"}))
        score = (_int(result.get("awayScore"), score[0]), _int(result.get("homeScore"),
                                                                 score[1]))
        bases = {}
        for key, field in (("onFirst", "postOnFirst"), ("onSecond", "postOnSecond"),
                           ("onThird", "postOnThird")):
            runner = _milb_runner(matchup.get(field))
            if runner:
                bases[key] = runner
        event_type = clean(result.get("eventType") or "")
        final = {"type": {"text": "Play Result", "abbreviation": event_type},
                 "summaryType": "N", "text": milb_text(result.get("description")),
                 "period": period, "team": {"id": batting},
                 "outs": _int(count.get("outs")), "awayScore": score[0],
                 "homeScore": score[1], "scoringPlay": bool(about.get("isScoringPlay")),
                 "scoreValue": _int(result.get("rbi"))}
        # the batter's result as baseball_trail counts it, and how the ball flew
        kind = MILB_EVENT_KIND.get(event_type)
        if event_type == "field_out" and path:
            kind = MILB_OUT_KIND.get(path)
        if kind:
            final["resultKind"] = kind
        if path:
            final["trajectory"] = path
        final.update(bases)
        if final["text"]:
            add(final)
        outs_before = min(3, _int(count.get("outs"), outs_before))
        if about.get("isComplete") and _int(count.get("outs")) >= 3:
            bases = {}
    return plays


def _ip_text(value):
    """'5.2' innings from the Stats API's '5.2'."""
    return clean(str(value or "0.0")) or "0.0"


def milb_box_players(team_box, decisions, notes_for, seen=None):
    """One team's batting and pitching tables as ESPN's box score block;
    `seen` each batter's pitches seen (the box has none), by id."""
    seen = seen or {}
    players = team_box.get("players") or {}
    batting_rows, pitching_rows = [], []
    totals_b = {k: 0 for k in ("AB", "R", "H", "RBI", "HR", "BB", "K", "P")}
    for pid in team_box.get("batters") or []:
        node = players.get(f"ID{pid}") or {}
        game = dig(node, "stats", "batting", default={}) or {}
        if not game:
            continue
        season = dig(node, "seasonStats", "batting", default={}) or {}
        person = node.get("person") or {}
        order = clean(str(node.get("battingOrder") or ""))
        values = {"AB": _int(game.get("atBats")), "R": _int(game.get("runs")),
                  "H": _int(game.get("hits")), "RBI": _int(game.get("rbi")),
                  "HR": _int(game.get("homeRuns")), "BB": _int(game.get("baseOnBalls")),
                  "K": _int(game.get("strikeOuts")),
                  "P": _int(game.get("numberOfPitches")) or seen.get(str(pid), 0)}
        for key in totals_b:
            totals_b[key] += values[key]
        name = clean(person.get("fullName") or "")
        batting_rows.append({
            "athlete": {"id": str(person.get("id") or ""), "displayName": name,
                        "shortName": short_name(name),
                        "position": {"abbreviation": clean(dig(node, "position",
                                                               "abbreviation", default="")
                                                           or "")}},
            "starter": order.endswith("00"), "batOrder": _int(order[:1]) if order else 0,
            "position": {"abbreviation": clean(dig(node, "position", "abbreviation",
                                                   default="") or "")},
            "stats": [f"{values['H']}-{values['AB']}", str(values["AB"]), str(values["R"]),
                      str(values["H"]), str(values["RBI"]), str(values["HR"]),
                      str(values["BB"]), str(values["K"]), str(values["P"]),
                      clean(season.get("avg") or ""), clean(season.get("obp") or ""),
                      clean(season.get("slg") or "")]})
    outs_total = 0
    totals_p = {k: 0 for k in ("H", "R", "ER", "BB", "K", "HR", "PC", "ST")}
    for pid in team_box.get("pitchers") or []:
        node = players.get(f"ID{pid}") or {}
        game = dig(node, "stats", "pitching", default={}) or {}
        if not game:
            continue
        season = dig(node, "seasonStats", "pitching", default={}) or {}
        person = node.get("person") or {}
        values = {"H": _int(game.get("hits")), "R": _int(game.get("runs")),
                  "ER": _int(game.get("earnedRuns")), "BB": _int(game.get("baseOnBalls")),
                  "K": _int(game.get("strikeOuts")), "HR": _int(game.get("homeRuns")),
                  "PC": _int(game.get("numberOfPitches") or game.get("pitchesThrown")),
                  "ST": _int(game.get("strikes"))}
        for key in totals_p:
            totals_p[key] += values[key]
        ip = _ip_text(game.get("inningsPitched"))
        outs_total += baseball_outs(ip) or 0
        name = clean(person.get("fullName") or "")
        role = "RP" if pitching_rows else "SP"
        row = {"athlete": {"id": str(person.get("id") or ""), "displayName": name,
                           "shortName": short_name(name), "position": {"abbreviation": role}},
               "starter": not pitching_rows, "position": {"abbreviation": role},
               "stats": [ip, str(values["H"]), str(values["R"]), str(values["ER"]),
                         str(values["BB"]), str(values["K"]), str(values["HR"]),
                         f"{values['PC']}-{values['ST']}", clean(season.get("era") or ""),
                         str(values["PC"])]}
        note = notes_for(person.get("id"), season)
        if note:
            row["notes"] = [{"type": "pitchingDecision", "text": note}]
        pitching_rows.append(row)
    batting = {"name": "batting", "type": "batting",
               "labels": ["H-AB", "AB", "R", "H", "RBI", "HR", "BB", "K", "#P", "AVG", "OBP",
                          "SLG"],
               "athletes": batting_rows,
               "totals": [f"{totals_b['H']}-{totals_b['AB']}", str(totals_b["AB"]),
                          str(totals_b["R"]), str(totals_b["H"]), str(totals_b["RBI"]),
                          str(totals_b["HR"]), str(totals_b["BB"]), str(totals_b["K"]),
                          str(totals_b["P"]), "", "", ""]}
    pitching = {"name": "pitching", "type": "pitching",
                "labels": ["IP", "H", "R", "ER", "BB", "K", "HR", "PC-ST", "ERA", "PC"],
                "athletes": pitching_rows,
                "totals": [f"{outs_total // 3}.{outs_total % 3}", str(totals_p["H"]),
                           str(totals_p["R"]), str(totals_p["ER"]), str(totals_p["BB"]),
                           str(totals_p["K"]), str(totals_p["HR"]),
                           f"{totals_p['PC']}-{totals_p['ST']}", "", str(totals_p["PC"])]}
    return [batting, pitching]


def _stat(name, abbr, value):
    text = clean(str(value)) if value not in (None, "") else "0"
    return {"name": name, "abbreviation": abbr, "shortDisplayName": abbr,
            "displayName": abbr, "label": abbr, "displayValue": text}


def milb_team_numbers(team_box, seen=None, lob=None):
    """One team's batting, pitching and fielding numbers as ESPN's; `seen`
    the pitches its batters saw (the other side's thrown), `lob` the line
    score's runners left on base (the box's own counts each batter's)."""
    bat = dict(dig(team_box, "teamStats", "batting", default={}) or {})
    if seen is not None and not bat.get("numberOfPitches"):
        bat["numberOfPitches"] = seen
    if lob is not None:
        bat["leftOnBase"] = lob
    pit = dig(team_box, "teamStats", "pitching", default={}) or {}
    fld = dict(dig(team_box, "teamStats", "fielding", default={}) or {})
    if not fld.get("doublePlays"):
        # the box's notes count them: "DP: 2 (Nishida-Galanie; ...)"
        for group in team_box.get("info") or []:
            for field in group.get("fieldList") or []:
                if field.get("label") == "DP":
                    fld["doublePlays"] = _int(re.match(r"\s*(\d*)",
                                                       str(field.get("value") or "")).group(1)
                                              or 1)
    xbh = _int(bat.get("doubles")) + _int(bat.get("triples")) + _int(bat.get("homeRuns"))
    ip = _ip_text(pit.get("inningsPitched"))
    outs = baseball_outs(ip) or 0
    innings = outs / 3.0
    era = f"{9 * _int(pit.get('earnedRuns')) / innings:.2f}" if innings else "0.00"
    whip = f"{(_int(pit.get('baseOnBalls')) + _int(pit.get('hits'))) / innings:.2f}" \
        if innings else "0.00"
    return [
        {"name": "batting", "stats": [
            _stat("runs", "R", bat.get("runs")), _stat("hits", "H", bat.get("hits")),
            _stat("homeRuns", "HR", bat.get("homeRuns")), _stat("extraBaseHits", "XBH", xbh),
            _stat("walks", "BB", bat.get("baseOnBalls")),
            _stat("strikeouts", "SO", bat.get("strikeOuts")),
            _stat("stolenBases", "SB", bat.get("stolenBases")),
            _stat("runnersLeftOnBase", "LOB", bat.get("leftOnBase")),
            _stat("atBats", "AB", bat.get("atBats")), _stat("doubles", "2B", bat.get("doubles")),
            _stat("triples", "3B", bat.get("triples")), _stat("RBIs", "RBI", bat.get("rbi")),
            _stat("avg", "AVG", bat.get("avg")), _stat("onBasePct", "OBP", bat.get("obp")),
            _stat("slugAvg", "SLG", bat.get("slg")), _stat("OPS", "OPS", bat.get("ops")),
            _stat("totalBases", "TB", bat.get("totalBases")),
            _stat("pitches", "P", bat.get("numberOfPitches") or 0),
            _stat("GIDPs", "GIDP", bat.get("groundIntoDoublePlay")),
            _stat("sacFlies", "SF", bat.get("sacFlies")),
            _stat("hitByPitch", "HBP", bat.get("hitByPitch"))]},
        {"name": "pitching", "stats": [
            _stat("innings", "IP", ip), _stat("hits", "H", pit.get("hits")),
            _stat("runs", "R", pit.get("runs")), _stat("earnedRuns", "ER", pit.get("earnedRuns")),
            _stat("walks", "BB", pit.get("baseOnBalls")),
            _stat("strikeouts", "K", pit.get("strikeOuts")),
            _stat("homeRuns", "HR", pit.get("homeRuns")), _stat("ERA", "ERA", era),
            _stat("WHIP", "WHIP", whip),
            _stat("pitchCount", "PC", pit.get("numberOfPitches") or pit.get("pitchesThrown")),
            _stat("strikes", "S", pit.get("strikes")), _stat("saves", "SV", pit.get("saves"))]},
        {"name": "fielding", "stats": [
            _stat("errors", "E", fld.get("errors")),
            _stat("doublePlays", "DP", fld.get("doublePlays") or 0),
            _stat("assists", "A", fld.get("assists")),
            _stat("putouts", "PO", fld.get("putOuts") or fld.get("putouts"))]},
    ]


# the box score's notes, from the Stats API's labels to ESPN's abbreviations
MILB_NOTE_LABELS = {"Runners left in scoring position, 2 out": "RISP 2-out",
                    "2-out RBI": "2Out RBI", "Pitches-strikes": "PC-ST",
                    "Groundouts-flyouts": "GB-FB", "Batters faced": "BF",
                    "Game Scores": "GS", "Inherited runners-scored": "IR-IS",
                    "Pitch timer violations": "PTV", "ABS Challenge": "ABS"}


def milb_details(info, extra=None):
    """A team's box score notes as ESPN's 'details': BATTING, BASERUNNING,
    FIELDING - and the game's pitching lines, for the home side."""
    out = []
    for section in info or []:
        title = clean(section.get("title") or "").title()
        stats = []
        for field in section.get("fieldList") or []:
            label = clean(field.get("label") or "")
            value = clean(field.get("value") or "").rstrip(".")
            if label and value:
                abbr = MILB_NOTE_LABELS.get(label, label)
                stats.append({"name": label, "abbreviation": abbr, "displayName": label,
                              "displayValue": value})
        if stats:
            out.append({"name": f"{title.lower()}Details", "displayName": title,
                        "stats": stats})
    if extra:
        out.append({"name": "pitchingDetails", "displayName": "Pitching", "stats": extra})
    return out


def milb_summary(game_pk, timeout=15):
    """One game's live feed as ESPN's summary: the header with the line score,
    the box score (both teams' tables and numbers, and its notes), every play
    pitch by pitch, and the game's own facts."""
    feed = http_json(MILB_FEED.format(game_pk), timeout)
    parents = milb_parents(timeout)
    data = feed.get("gameData") or {}
    live = feed.get("liveData") or {}
    line = live.get("linescore") or {}
    game = {"gamePk": game_pk, "gameDate": dig(data, "datetime", "dateTime", default=""),
            "status": data.get("status") or {}, "linescore": line,
            "gameType": dig(data, "game", "type", default="R"),
            "season": dig(data, "game", "season", default=""),
            "seriesDescription": dig(data, "game", "seriesDescription", default=""),
            "seriesGameNumber": dig(data, "game", "seriesGameNumber"),
            "venue": data.get("venue") or {},
            "teams": {}}
    box = live.get("boxscore") or {}
    for side in ("away", "home"):
        team = dig(data, "teams", side, default={}) or {}
        runs = dig(line, "teams", side, "runs")
        game["teams"][side] = {"team": team, "score": runs,
                               "leagueRecord": team.get("record", {}).get("leagueRecord")
                               if isinstance(team.get("record"), dict) else None,
                               "isWinner": None}
    state = dig(data, "status", "abstractGameState", default="")
    if state == "Final":
        a, h = _int(dig(line, "teams", "away", "runs")), _int(dig(line, "teams", "home", "runs"))
        if a != h:
            game["teams"]["away" if a > h else "home"]["isWinner"] = True
    event = milb_event(game, parents)
    comp = event["competitions"][0]
    decisions = live.get("decisions") or {}

    def notes_for(pid, season):
        for key, letter in (("winner", "W"), ("loser", "L"), ("save", "S")):
            if dig(decisions, key, "id") == pid:
                if letter == "S":
                    return f"S, {_int(season.get('saves'))}"
                return f"{letter}, {_int(season.get('wins'))}-{_int(season.get('losses'))}"
        return ""
    players, teams = [], []
    ids = (str(dig(data, "teams", "away", "id", default="")),
           str(dig(data, "teams", "home", "id", default="")))
    game_info = box.get("info") or []
    seen = {}
    for play in dig(live, "plays", "allPlays", default=[]) or []:
        batter = str(dig(play, "matchup", "batter", "id", default=""))
        seen[batter] = seen.get(batter, 0) + sum(
            1 for event in play.get("playEvents") or [] if event.get("isPitch"))
    pitching_notes = []
    for field in game_info:
        label = clean(field.get("label") or "")
        value = clean(field.get("value") or "").rstrip(".")
        if label in ("Pitches-strikes", "Groundouts-flyouts", "Batters faced", "HBP", "WP",
                     "Balk", "Inherited runners-scored", "Game Scores", "IBB", "Pitch timer "
                     "violations", "ABS Challenge") and value:
            pitching_notes.append({"name": label, "displayName": label,
                                   "abbreviation": MILB_NOTE_LABELS.get(label, label),
                                   "displayValue": value})
    for side in ("away", "home"):
        team_box = dig(box, "teams", side, default={}) or {}
        team = milb_team(team_box.get("team") or dig(data, "teams", side, default={}), parents)
        players.append({"team": team, "statistics": milb_box_players(team_box, decisions,
                                                                     notes_for, seen)})
        other = dig(box, "teams", "home" if side == "away" else "away", "teamStats",
                    "pitching", default={}) or {}
        lob = dig(line, "teams", side, "leftOnBase")
        teams.append({"team": team, "homeAway": side,
                      "statistics": milb_team_numbers(
                          team_box, _int(other.get("numberOfPitches")
                                         or other.get("pitchesThrown")),
                          _int(lob) if lob is not None else None),
                      "details": milb_details(team_box.get("info"),
                                              pitching_notes if side == "home" else None)})
    officials = []
    for order, node in enumerate(box.get("officials") or [], 1):
        where = clean(node.get("officialType") or "")
        officials.append({"displayName": clean(dig(node, "official", "fullName", default="")
                                               or ""),
                          "position": {"displayName": f"{where} Umpire" if where else "",
                                       "name": f"{where} Umpire" if where else ""},
                          "order": order})
    minutes = _int(dig(data, "gameInfo", "gameDurationMinutes", default=0))
    info = {"venue": {"fullName": clean(dig(data, "venue", "name", default="") or ""),
                      "address": {"city": clean(dig(data, "venue", "location", "city",
                                                    default="") or "")}},
            "attendance": _int(dig(data, "gameInfo", "attendance", default=0)),
            "officials": officials}
    if minutes:
        info["gameDuration"] = f"{minutes // 60}:{minutes % 60:02d}"
    weather = data.get("weather") or {}
    if weather.get("temp"):
        info["weather"] = {"temperature": _int(weather.get("temp")),
                           "displayValue": clean(weather.get("condition") or "")}
    return {"header": {"id": str(game_pk), "competitions": [comp],
                       "shortName": event["shortName"], "season": event.get("season")},
            "boxscore": {"teams": teams, "players": players},
            "plays": milb_plays(feed, ids), "gameInfo": info,
            "format": {"regulation": {"periods": _int(line.get("scheduledInnings")) or 9}},
            "sportst": {"feed": "milb"}}


def milb_team_stats(timeout=15):
    """{team id: {key: value}} - every team's season numbers from the Stats
    API, for the Stats tab and the Scouting comparison."""
    season = milb_season()
    out = {}
    for group in ("hitting", "pitching", "fielding"):
        data = milb_get(f"/teams/stats?season={season}&sportIds={MILB_SPORTS}"
                        f"&group={group}&stats=season&gameType=R&limit=500", timeout)
        for block in data.get("stats") or []:
            for split in block.get("splits") or []:
                ident = str(dig(split, "team", "id", default=""))
                stat = split.get("stat") or {}
                games = _int(stat.get("gamesPlayed")) or 1
                row = out.setdefault(ident, {})
                if group == "hitting":
                    row.update({"rpg": _int(stat.get("runs")) / games,
                                "avg": _num(stat.get("avg")), "obp": _num(stat.get("obp")),
                                "slg": _num(stat.get("slg")), "ops": _num(stat.get("ops")),
                                "hrpg": _int(stat.get("homeRuns")) / games,
                                "sbpg": _int(stat.get("stolenBases")) / games,
                                "kpg": _int(stat.get("strikeOuts")) / games})
                elif group == "pitching":
                    innings = (baseball_outs(_ip_text(stat.get("inningsPitched"))) or 0) / 3.0
                    row.update({"era": _num(stat.get("era")), "whip": _num(stat.get("whip")),
                                "rapg": _int(stat.get("runs")) / games,
                                "k9": 9 * _int(stat.get("strikeOuts")) / innings
                                if innings else None,
                                "bb9": 9 * _int(stat.get("baseOnBalls")) / innings
                                if innings else None,
                                "hr9": 9 * _int(stat.get("homeRuns")) / innings
                                if innings else None,
                                "oavg": _num(stat.get("avg"))})
                else:
                    row.update({"fld": _num(stat.get("fielding")),
                                "epg": _int(stat.get("errors")) / games})
    return out


def milb_postseason(season=None, timeout=15):
    """Each level's postseason as bracket rounds: {level: [(round, [series])]}
    - each league's division series and championship series, Triple-A's
    league championships and its national championship game."""
    season = season or milb_season()
    out = {}
    parents = milb_parents(timeout)
    for sport, (level, _) in MILB_LEVELS.items():
        data = milb_get(f"/schedule?sportId={sport}&season={season}&gameType=F,D,L,W,C"
                        f"&hydrate=team", timeout)
        found = {}
        for day in data.get("dates") or []:
            for game in day.get("games") or []:
                description = clean(game.get("seriesDescription") or "")
                low = description.lower()
                name = "Final" if "national championship" in low else \
                    "Championship" if "championship" in low else "Division Series"
                conference = clean(dig(game, "teams", "home", "team", "league", "name",
                                       default="") or "")
                pair = tuple(sorted(str(dig(game, "teams", s, "team", "id", default=""))
                                    for s in ("away", "home")))
                entry = found.setdefault((name, conference, pair), {
                    "teams": {}, "of": _int(game.get("gamesInSeries")) or 1})
                for which in ("away", "home"):
                    node = dig(game, "teams", which, default={}) or {}
                    team = milb_team(node.get("team") or {}, parents)
                    wins = entry["teams"].setdefault(team["id"], [team, 0])
                    if dig(game, "status", "abstractGameState") == "Final" and \
                            node.get("isWinner"):
                        wins[1] += 1
        rounds = {}
        for (name, conference, _), entry in found.items():
            need = (entry["of"] + 1) // 2
            sides = []
            for team, wins in sorted(entry["teams"].values(), key=lambda tw: -tw[1]):
                parsed = {"id": team["id"], "abbr": team["abbreviation"],
                          "name": team["displayName"], "short": team["shortDisplayName"],
                          "location": team["location"], "color": team["color"]}
                sides.append(side(parsed, None, wins, wins >= need))
            while len(sides) < 2:
                sides.append(side({}))
            status = f"best of {entry['of']}" if entry["of"] > 1 else "one game"
            if conference and name != "Final":
                status = f"{re.sub(r' League$', '', conference)} · {status}"
            rounds.setdefault(name, []).append(
                series(name, "" if name == "Final" else conference, sides[0], sides[1],
                       status))
        order = [r for r in ("Division Series", "Championship", "Final") if r in rounds]
        if order:
            out[level] = [(name, rounds[name]) for name in order]
    return out


