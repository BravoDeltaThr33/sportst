def youtube_feed(channel, timeout=15):
    """A channel's latest uploads from its public feed (no key)."""
    import xml.etree.ElementTree as ET
    text = http_text(YOUTUBE_FEED.format(channel), timeout)
    root = ET.fromstring(text)
    ns = {"a": "http://www.w3.org/2005/Atom", "yt": "http://www.youtube.com/xml/schemas/2015"}
    entries = []
    for entry in root.findall("a:entry", ns):
        ident = entry.findtext("yt:videoId", default="", namespaces=ns)
        title = clean(entry.findtext("a:title", default="", namespaces=ns))
        if ident and title:
            entries.append({"title": title, "url": f"https://www.youtube.com/watch?v={ident}",
                            "kind": "page", "source": "YouTube", "seconds": 0,
                            "match": title,
                            "at": entry.findtext("a:published", default="", namespaces=ns)})
    return entries


