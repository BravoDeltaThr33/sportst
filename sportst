SOCCER_BOX = [("G", "totalGoals"), ("A", "goalAssists"), ("SH", "totalShots"),
              ("ST", "shotsOnTarget"), ("FC", "foulsCommitted"), ("FA", "foulsSuffered"),
              ("YC", "yellowCards"), ("RC", "redCards"), ("SV", "saves")]


def prepare_summary(summary, league):
    """Fill in what a sport's summary leaves out, once: soccer has rosters
    with per-player stats but no box score."""
    if not isinstance(summary, dict) or summary.get("_prepared"):
        return summary
    summary["_prepared"] = True
    if sport_of(league) == "soccer" and not dig(summary, "boxscore", "players"):
        blocks = []
        for roster in summary.get("rosters") or []:
            starters, subs = [], []
            for entry in roster.get("roster") or []:
                if not (entry.get("starter") or entry.get("subbedIn")):
                    continue
                stats = {s.get("name"): s.get("displayValue") or clean(str(s.get("value", "")))
                         for s in entry.get("stats") or []}
                position = clean(dig(entry, "position", "abbreviation", default=""))
                row = {"athlete": {"displayName": clean(dig(entry, "athlete", "displayName",
                                                            default="?")),
                                   "shortName": clean(dig(entry, "athlete", "shortName",
                                                          default="")),
                                   "position": {"abbreviation": position}},
                       "stats": [clean(stats.get(key, "0") or "0").split(".")[0]
                                 for _, key in SOCCER_BOX],
                       "starter": bool(entry.get("starter"))}
                (starters if entry.get("starter") else subs).append(row)
            if starters or subs:
                blocks.append({"team": roster.get("team") or {},
                               "homeAway": roster.get("homeAway"),
                               "statistics": [{"text": "Players",
                                               "labels": [l for l, _ in SOCCER_BOX],
                                               "athletes": starters + subs}]})
        summary.setdefault("boxscore", {})["players"] = blocks
    return summary


def game_strip(summary, league, width):
    """One line for the top of the Plays screen: the score, the status, the
    venue, the crowd and the weather - what used to take six."""
    comp = dig(summary, "header", "competitions", 0, default={}) or {}
    away, home = summary_teams(summary)
    if not away or not home:
        return [Line().add("No header data.", "dim")]
    state = dig(comp, "status", "type", "state", default="pre")
    status = clean(dig(comp, "status", "type", "shortDetail", default="") or "")
    wide = width >= 90
    line = Line()
    for index, team in enumerate((away, home)):
        if index:
            line.add("  at  ", "muted")
        line.add(f"{team['name'] if wide else team['abbr']} ",
                 THEME.style(league, team, bold=True,
                             dim=state == "post" and not team["winner"]))
        line.add(str(team["score"] if team["score"] is not None else "-"), "bold")
    line.add(f"  · {status}", {"in": "live", "post": "final"}.get(state, "dim"))
    info = dig(summary, "gameInfo", default={}) or {}
    facts = []
    venue = clean(dig(info, "venue", "fullName", default=""))
    city = clean(dig(info, "venue", "address", "city", default=""))
    if venue:
        facts.append(venue + (f", {city}" if city else ""))
    attendance = info.get("attendance")
    if attendance:
        facts.append(f"att {attendance:,}" if isinstance(attendance, int)
                     else f"att {attendance}")
    weather = clean(dig(info, "weather", "displayValue", default=""))
    temperature = dig(info, "weather", "temperature")
    if weather or temperature:
        facts.append(" ".join(x for x in (f"{temperature}°" if temperature else "", weather) if x))
    used = sum(len(t) for t, _ in line)
    extra = "  · " + " · ".join(facts) if facts else ""
    if facts and used + len(extra) <= width:
        line.add(extra, "muted")
        return [line, blank()]
    return [line, Line().add(" · ".join(facts)[:width], "muted"), blank()] if facts \
        else [line, blank()]


def officials_text(summary):
    info = dig(summary, "gameInfo", default={}) or {}
    return ", ".join(o for o in (clean(dig(x, "displayName", default=""))
                                 for x in info.get("officials") or []) if o)


def football_scoring_lines(summary, league, width, by_id):
    """One line per score: quarter, clock, team, kind, score, what happened."""
    scoring = dig(summary, "scoringPlays", default=[]) or []
    if not scoring:
        return []
    lines = [heading("Scoring")]
    width -= 2                       # the clip mark's gutter
    for play in scoring:
        period = period_tag(league, dig(play, "period", "number", default=""))
        clock = clean(dig(play, "clock", "displayValue", default=""))
        side = by_id.get(str(dig(play, "team", "id", default="")))
        abbr = clean(dig(play, "team", "abbreviation", default="")) or (
            side["abbr"] if side else "")
        if side is None:
            side = next((c for c in by_id.values() if c["abbr"] == abbr), None)
        kind = clean(dig(play, "type", "abbreviation", default="")) or clean(
            dig(play, "type", "text", default=""))[:4]
        score = f"{play.get('awayScore', '')}-{play.get('homeScore', '')}"
        head = Line().add(f"{period:<3}{clock:>5} ", "muted")
        head.add(f"{abbr:<4} ", THEME.style(league, side, bold=True, fallback="accent")
                 if side else "accent")
        head.add(f"{kind:<3} ", "dim").add(f"{score:<6}", "bold")
        prefix = sum(len(t) for t, _ in head)
        text = clean(play.get("text") or "")
        chunks = wrap_spans(text, max(20, width - prefix), "normal")
        if chunks:
            for span in chunks[0]:
                head.append(span)
        lines.append(gutter(head, play, True))
        for chunk in chunks[1:]:
            lines.append(gutter(Line().add(" " * prefix, "normal").extend_spans(chunk),
                                play, False))
    lines.append(blank())
    return lines


def football_drive_lines(summary, league, width, by_id):
    drives = dig(summary, "drives", "previous", default=[]) or []
    if not drives:
        return []
    lines = []
    head = Line().add(f"{'Q':<3}{'team':<5}{'result':<15}{'plays':>5}{'yds':>5}"
                      f"{'time':>6}  start", "header")
    lines.append(head)
    for drive in drives:
        abbr = clean(dig(drive, "team", "abbreviation", default="")) or clean(
            dig(drive, "team", "shortDisplayName", default=""))
        side = next((c for c in by_id.values() if c["abbr"] == abbr), None)
        result = clean(drive.get("displayResult") or drive.get("result") or "")
        plays = drive.get("offensivePlays")
        yards = drive.get("yards")
        clock = clean(dig(drive, "timeElapsed", "displayValue", default=""))
        if plays is None or yards is None:
            found = re.match(r"(\d+) plays?, (-?\d+) yards?, ([\d:]+)",
                             clean(drive.get("description") or ""))
            if found:
                plays, yards, clock = found.group(1), found.group(2), found.group(3)
        quarter = period_tag(league, dig(drive, "start", "period", "number", default=""))
        start = clean(dig(drive, "start", "text", default=""))
        style = THEME.style(league, side) if side else "normal"
        scored = result.lower() in ("touchdown", "field goal", "td", "fg")
        row = Line().add(f"{quarter:<3}", "muted").add(f"{abbr:<5}", style)
        row.add(f"{result[:14]:<15}", "good" if scored else (
            "bad" if result.lower() in ("interception", "fumble", "downs", "safety",
                                        "blocked punt", "blocked fg", "missed fg")
            else "normal"))
        row.add(f"{plays if plays is not None else '':>5}{yards if yards is not None else '':>5}"
                f"{clock:>6}  ", "dim").add(start, "muted")
        lines.append(row)
    lines.append(blank())
    return lines


def football_plays_panes(summary, league, width):
    """(left, right): scoring and win probability; drives and officials."""
    away, home = summary_teams(summary)
    by_id = {t["id"]: t for t in (away, home) if t}
    left = game_strip(summary, league, width)
    left.extend(football_scoring_lines(summary, league, width, by_id))
    if away and home:
        left.extend(winprob_chart(summary, away, home, league, width, height=7))
    right = football_drive_lines(summary, league, width, by_id)
    officials = officials_text(summary)
    if officials:
        right.append(heading("Officials"))
        right.extend(wrap_spans(officials, width, "muted"))
    if len(left) <= 3 and not right:
        left.append(Line().add("Nothing published for this game yet.", "dim"))
    return left, right


def hockey_plays_panes(summary, league, width):
    """(left, right): goals and three stars; shots, penalties, officials."""
    away, home = summary_teams(summary)
    by_id = {t["id"]: t for t in (away, home) if t}
    lines = hockey_play_lines(summary, league, width, by_id, compact=True)
    left, right, target = game_strip(summary, league, width), [], None
    for line in lines:
        text = "".join(t for t, _ in line)
        if text in ("Shots on goal", "Penalties"):
            target = right
        elif text == "Three stars":
            target = left
        (target if target is not None else left).append(line)
    officials = officials_text(summary)
    if officials:
        right.append(heading("Officials"))
        right.extend(wrap_spans(officials, width, "muted"))
    if len(left) <= 3 and not right:
        left.append(Line().add("Nothing published for this game yet.", "dim"))
    return left, right


def render_plays(summary, league, width, favorites=None):
    lines = game_strip(summary, league, width)
    away, home = summary_teams(summary)
    by_id = {}
    if away:
        by_id[away["id"]] = away
    if home:
        by_id[home["id"]] = home

    info = dig(summary, "gameInfo", default={}) or {}
    facts = []
    venue = clean(dig(info, "venue", "fullName", default=""))
    city = clean(dig(info, "venue", "address", "city", default=""))
    state = clean(dig(info, "venue", "address", "state", default=""))
    if venue:
        place = ", ".join(part for part in (city, state) if part)
        facts.append(f"{venue}{' — ' + place if place else ''}")
    if info.get("attendance"):
        facts.append(f"attendance {info['attendance']:,}" if isinstance(
            info["attendance"], int) else f"attendance {info['attendance']}")
    weather = clean(dig(info, "weather", "displayValue", default=""))
    temperature = dig(info, "weather", "temperature")
    if weather:
        facts.append(f"{weather}{f', {temperature}°' if temperature else ''}")
    officials = [clean(dig(o, "displayName", default="")) for o in info.get("officials") or []]
    sport = sport_of(league)
    if sport == "hockey" and not dig(summary, "scoringPlays"):
        lines.extend(hockey_play_lines(summary, league, width, by_id))
    elif sport == "soccer":
        lines.extend(soccer_event_lines(summary, league, width, by_id))
    elif sport == "basketball":
        lines.extend(basketball_scoring_lines(summary, league, width, by_id))

    scoring = dig(summary, "scoringPlays", default=[]) or []
    if scoring:
        lines.append(heading("Scoring"))
        lines.append(rule(min(width, 72)))
        for play in scoring:
            period = period_tag(league, dig(play, "period", "number", default=""))
            clock = clean(dig(play, "clock", "displayValue", default=""))
            side = by_id.get(str(dig(play, "team", "id", default="")))
            abbr = clean(dig(play, "team", "abbreviation", default="")) or (
                side["abbr"] if side else "")
            if side is None:
                for candidate in by_id.values():
                    if candidate["abbr"] == abbr:
                        side = candidate
                        break
            kind = clean(dig(play, "type", "abbreviation", default="")) or clean(
                dig(play, "type", "text", default=""))
            away_score = play.get("awayScore", "")
            home_score = play.get("homeScore", "")
            head = Line()
            head.add(f"{period:<3}{clock:>6}  ", "muted")
            head.add(f"{abbr:<4} ", THEME.style(league, side, bold=True,
                                                fallback="accent") if side else "accent")
            head.add(f"{kind:<5} ", "dim")
            head.add(f"{away_score}-{home_score}", "bold")
            lines.append(gutter(head, play, True))
            text = clean(play.get("text") or "")
            if text:
                lines.extend(gutter(line, play, False) for line in
                             wrap_spans(text, width - 6, "normal", indent="      "))
        lines.append(blank())

    drives = dig(summary, "drives", "previous", default=[]) or []
    if drives:
        lines.append(heading("Drives"))
        lines.append(rule(min(width, 72)))
        rows, styles = [], []
        for drive in drives:
            abbr = clean(dig(drive, "team", "abbreviation", default="")) or clean(
                dig(drive, "team", "shortDisplayName", default=""))
            side = None
            for candidate in by_id.values():
                if candidate["abbr"] == abbr:
                    side = candidate
                    break
            result = clean(drive.get("displayResult") or drive.get("result") or "")
            description = clean(drive.get("description") or "")
            start = clean(dig(drive, "start", "text", default=""))
            rows.append([abbr, result, description, start])
            styles.append(THEME.style(league, side) if side else "normal")
        table = build_table(["team", "result", "drive", "start"], rows,
                            aligns=["<", "<", "<", "<"], row_styles=styles)
        lines.extend(table)
        lines.append(blank())

    if away and home:
        lines.extend(winprob_chart(summary, away, home, league, width))

    if officials:
        lines.append(heading("Officials"))
        lines.extend(wrap_spans(", ".join(o for o in officials if o), width, "muted"))
        lines.append(blank())

    if len(lines) <= 3:
        lines.append(Line().add("Nothing published for this game yet.", "dim"))
    return lines


# --------------------------------------------------------------------------
# basketball - the shot chart
#
# ESPN places every field-goal attempt on a half court in feet: x runs 0-50
# across the court, y is the distance out from the basket's baseline side,
# with the rim at (25, 0) - both teams mapped onto the same half. The court
# lines are drawn in braille dots (Unicode 1999, in every monospace font),
# which gives a pixel per dot, 2 x 4 to a cell, and square ones at that; the
# shots sit on top as whole characters in the shooting team's colour.
# --------------------------------------------------------------------------

COURTS = {
    # three-point radius, corner-three distance, lane half-width, rim to baseline
    "nba": {"arc": 23.75, "corner": 22.0, "lane": 8.0, "baseline": 5.25},
    "college": {"arc": 22.15, "corner": 21.65, "lane": 6.0, "baseline": 5.25},
    "fiba": {"arc": 22.15, "corner": 21.65, "lane": 8.04, "baseline": 5.17},
}
SHOT_DEPTH = 31.0          # feet out from the rim the chart reaches
SHOT_ZONES = ["Rim", "Paint", "Mid", "Corner 3", "Arc 3"]
BRAILLE_BITS = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))


def court_for(league):
    if league == "nba":
        return COURTS["nba"]
    if is_olympic(league):
        return COURTS["fiba"]
    return COURTS["college"]


def basketball_shots(summary):
    """Every field-goal attempt with a location: dicts of team id, x, y,
    made, three, distance, and who took it."""
    shots = []
    for play in dig(summary, "plays", default=[]) or []:
        if not play.get("shootingPlay"):
            continue
        kind = clean(dig(play, "type", "text", default="")).lower()
        text = clean(play.get("text") or "")
        if "free throw" in kind or "free throw" in text.lower():
            continue
        x, y = dig(play, "coordinate", "x"), dig(play, "coordinate", "y")
        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):
            continue
        if not (-2 <= x <= 52 and -8 <= y <= 94):
            continue       # ESPN's -214748340 means "no location"
        three = play.get("pointsAttempted") == 3 or "three point" in text.lower() \
            or "3-pt" in text.lower()
        shots.append({"team": str(dig(play, "team", "id", default="")),
                      "x": float(x), "y": float(y), "made": bool(play.get("scoringPlay")),
                      "three": bool(three), "text": text,
                      "period": dig(play, "period", "number", default=0),
                      "distance": ((float(x) - 25) ** 2 + float(y) ** 2) ** 0.5})
    return shots


def shot_zone(shot, court):
    if shot["three"]:
        corner_top = max(0.0, (court["arc"] ** 2 - court["corner"] ** 2) ** 0.5)
        return "Corner 3" if shot["y"] <= corner_top + 0.5 else "Arc 3"
    if shot["distance"] <= 4.5:
        return "Rim"
    if abs(shot["x"] - 25) <= court["lane"] and shot["y"] <= 19 - court["baseline"]:
        return "Paint"
    return "Mid"


def court_pixels(court, cols, rows):
    """The set of lit braille pixels for the court lines."""
    width_px, height_px = cols * 2, rows * 4
    feet_per_px = 50.0 / width_px
    top = -court["baseline"]          # the baseline, in the rim's coordinates
    lit = set()

    def dot(x_ft, y_ft):
        px = int(round(x_ft / feet_per_px))
        py = int(round((y_ft - top) / feet_per_px))
        if 0 <= px < width_px and 0 <= py < height_px:
            lit.add((px, py))

    def segment(x0, y0, x1, y1):
        steps = int(max(abs(x1 - x0), abs(y1 - y0)) / feet_per_px * 2) + 1
        for i in range(steps + 1):
            t = i / steps
            dot(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t)

    def arc(cx, cy, radius, start, end):
        import math
        steps = int(radius * abs(end - start) / feet_per_px * 2) + 2
        for i in range(steps + 1):
            angle = start + (end - start) * i / steps
            dot(cx + radius * math.cos(angle), cy + radius * math.sin(angle))

    import math
    bottom = top + height_px * feet_per_px - feet_per_px
    segment(0, top, 50, top)                       # baseline
    segment(0, top, 0, bottom)                     # sidelines
    segment(50 - feet_per_px, top, 50 - feet_per_px, bottom)
    free_throw = 19 - court["baseline"]
    lane = court["lane"]
    segment(25 - lane, top, 25 - lane, free_throw)  # the lane
    segment(25 + lane, top, 25 + lane, free_throw)
    segment(25 - lane, free_throw, 25 + lane, free_throw)
    arc(25, free_throw, 6, 0, math.pi)             # free-throw circle, outer half
    corner_top = (court["arc"] ** 2 - court["corner"] ** 2) ** 0.5
    segment(25 - court["corner"], top, 25 - court["corner"], corner_top)
    segment(25 + court["corner"], top, 25 + court["corner"], corner_top)
    reach = math.atan2(corner_top, court["corner"])
    arc(25, 0, court["arc"], reach, math.pi - reach)  # the three-point arc
    arc(25, 0, 4, 0, math.pi)                      # restricted area
    segment(22, -1.25, 28, -1.25)                  # backboard
    arc(25, 0, 0.75, 0, 2 * math.pi)               # rim
    if bottom >= 47 - court["baseline"]:
        segment(0, 47 - court["baseline"], 50, 47 - court["baseline"])
    return lit


def render_shot_chart(summary, league, width, view="both", favorites=None,
                      heading=True, lines_style="braille"):
    """The shot chart and the zone table under it. `view` is 'both', 'away'
    or 'home'. `lines_style` 'dots' draws the court in plain middle dots for
    a font with no braille."""
    away, home = summary_teams(summary)
    teams = {t["id"]: t for t in (away, home) if t}
    shots = basketball_shots(summary)
    lines = []
    if not shots:
        return [Line().add("No shot locations published for this game yet.", "dim")]
    court = court_for(league)
    wanted = {"away": {away["id"]} if away else set(),
              "home": {home["id"]} if home else set()}.get(view, set(teams))
    shown = [s for s in shots if s["team"] in wanted]

    cols = clamp(width - 1, 30, 100)
    feet_per_px = 50.0 / (cols * 2)
    rows = int((SHOT_DEPTH + court["baseline"]) / (feet_per_px * 4)) + 1
    lit = court_pixels(court, cols, rows)
    cells = [[0] * cols for _ in range(rows)]
    for px, py in lit:
        cells[py // 4][px // 2] |= BRAILLE_BITS[py % 4][px % 2]

    marks = {}
    beyond = 0
    for shot in shown:
        col = int((shot["x"] / 50.0) * cols)
        row = int((shot["y"] + court["baseline"]) / (feet_per_px * 4))
        if row >= rows:
            beyond += 1
            continue
        col, row = clamp(col, 0, cols - 1), clamp(row, 0, rows - 1)
        slot = marks.setdefault((row, col), {"made": {}, "missed": {}})
        bucket = slot["made" if shot["made"] else "missed"]
        bucket[shot["team"]] = bucket.get(shot["team"], 0) + 1

    if heading:
        title = Line().add("Shot chart", "title")
        title.add({"both": "  both teams", "away": f"  {away['abbr'] if away else ''} only",
                   "home": f"  {home['abbr'] if home else ''} only"}.get(view, ""),
                  "muted")
        lines.append(title)
    for row in range(rows):
        line = Line()
        for col in range(cols):
            slot = marks.get((row, col))
            if slot:
                if slot["made"]:
                    team_id = max(slot["made"], key=slot["made"].get)
                    line.add("●", THEME.style(league, teams.get(team_id), bold=True,
                                              fallback="good"))
                else:
                    team_id = max(slot["missed"], key=slot["missed"].get)
                    line.add("○", THEME.style(league, teams.get(team_id), dim=True,
                                              fallback="muted"))
                continue
            bits = cells[row][col]
            if not bits:
                line.add(" ", "zonefaint")
            elif lines_style == "dots":
                line.add("·", "zonefaint")
            else:
                line.add(chr(0x2800 + bits), "zonefaint")
        lines.append(merge_spans(line))

    legend = Line().add("● made  ○ missed", "muted")
    for team_id in [t for t in (away and away["id"], home and home["id"]) if t in wanted]:
        team = teams[team_id]
        mine = [s for s in shown if s["team"] == team_id]
        made = sum(1 for s in mine if s["made"])
        legend.add("   ", "normal").add(team["abbr"], THEME.style(league, team, bold=True,
                                                                  fallback="accent"))
        legend.add(f" {made}/{len(mine)}", "bold")
    lines.append(legend)
    if beyond:
        lines.append(Line().add(f"{beyond} more from beyond {SHOT_DEPTH:.0f} feet "
                                "(heaves) are counted below", "muted"))
    lines.append(blank())

    # where the points came from, zone by zone
    headers = ["", *SHOT_ZONES, "FG"]
    table_rows, styles = [], []
    for team_id in [t for t in (away and away["id"], home and home["id"]) if t in wanted]:
        team = teams[team_id]
        mine = [s for s in shots if s["team"] == team_id]
        row = [team["abbr"]]
        for zone in SHOT_ZONES:
            inside = [s for s in mine if shot_zone(s, court) == zone]
            made = sum(1 for s in inside if s["made"])
            row.append(f"{made}/{len(inside)}" if inside else "-")
        made = sum(1 for s in mine if s["made"])
        row.append(f"{made}/{len(mine)}")
        table_rows.append(row)
        styles.append("normal")
        pct = [""]
        for zone in SHOT_ZONES:
            inside = [s for s in mine if shot_zone(s, court) == zone]
            hits = sum(1 for s in inside if s["made"])
            pct.append(f"{100 * hits / len(inside):.0f}%" if inside else "")
        pct.append(f"{100 * made / len(mine):.0f}%" if mine else "")
        table_rows.append(pct)
        styles.append("dim")
    lines.append(Line().add("By zone", "title"))
    table = build_table(headers, table_rows, aligns=["<"] + [">"] * (len(headers) - 1),
                        row_styles=styles, sep="  ")
    for index, line in enumerate(table[1:], start=0):
        if index % 2 == 0 and line:
            text, _ = line[0]
            team = next((t for t in teams.values() if text.strip() == t["abbr"]), None)
            if team:
                line[0] = (text, THEME.style(league, team, bold=True, fallback="accent"))
    lines.extend(table)
    lines.append(Line().add("Rim: within 4 ft · Paint: the lane · Corner 3: below the "
                            "break of the arc", "muted"))
    return lines


# --------------------------------------------------------------------------
# baseball - pitch by pitch
# --------------------------------------------------------------------------

# ESPN puts pitches in a pixel grid seen from behind the plate. These
# constants come from regressing MLB's own pX/pZ (in feet) against the x/y
# ESPN publishes for the same pitch: x = 117 - 38.118 * pX, y = 238.78 - 27 * pZ.
PX_CENTRE = 117.0
PX_PER_FOOT = 38.118
PY_ZERO = 238.78
PY_PER_FOOT = 27.0
PLATE_HALF = 0.708            # feet, half of a 17-inch plate
ZONE_TOP_FT = 3.4             # a generic zone when nothing better is known
ZONE_BOTTOM_FT = 1.6

STEAL_TYPES = {"stolen base", "caught stealing", "pick off", "pickoff",
               "picked off", "balk", "wild pitch", "passed ball"}
HIT_TYPES = {"single", "double", "triple", "home run"}


def feet_to_px(x_ft, z_ft):
    return PX_CENTRE - PX_PER_FOOT * x_ft, PY_ZERO - PY_PER_FOOT * z_ft


def px_to_feet(x, y):
    return (PX_CENTRE - x) / PX_PER_FOOT, (PY_ZERO - y) / PY_PER_FOOT


def pitch_kind(text):
    """A pitch result, reduced to the five kinds worth colouring."""
    low = (text or "").lower()
    if "ball in play" in low or "in play" in low:
        return "inplay"
    if "foul" in low:
        return "foul"
    if "swinging" in low or "swing" in low:
        return "swing"
    if "strike" in low:
        return "strike"
    if "ball" in low or "hit by pitch" in low:
        return "ball"
    return "other"


PITCH_STYLE = {"strike": "pitchstrike", "swing": "pitchswing", "ball": "pitchball",
               "foul": "pitchfoul", "inplay": "pitchplay", "other": "dim"}
PITCH_WORD = {"strike": "called", "swing": "swinging", "ball": "ball",
              "foul": "foul", "inplay": "in play", "other": ""}


def athlete_names(summary):
    """{athlete id: (short name, position)} from the rosters and the box score."""
    out = {}
    for block in dig(summary, "rosters", default=[]) or []:
        for entry in block.get("roster") or []:
            athlete = entry.get("athlete") or {}
            if athlete.get("id"):
                out[str(athlete["id"])] = (
                    clean(athlete.get("shortName") or athlete.get("displayName") or ""),
                    clean(dig(athlete, "position", "abbreviation", default="")))
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        for section in block.get("statistics") or []:
            for entry in section.get("athletes") or []:
                athlete = entry.get("athlete") or {}
                if athlete.get("id"):
                    out.setdefault(str(athlete["id"]), (
                        clean(athlete.get("shortName") or athlete.get("displayName") or ""),
                        clean(dig(athlete, "position", "abbreviation", default=""))))
    return out


def parse_baseball_plays(summary):
    """Group ESPN's play stream into at-bats.

    Every at-bat carries its pitches (type, speed, location, result), what it
    ended in, who was on base afterwards, and anything that happened between
    pitches: a steal, a pick-off, a wild pitch.
    """
    plays = dig(summary, "plays", default=[]) or []
    names = athlete_names(summary)
    at_bats = []
    current = None
    inning, half = 0, "Top"
    for play in plays:
        kind = play.get("summaryType")
        period = play.get("period") or {}
        if period.get("number"):
            inning = period["number"]
            half = clean(period.get("type") or half)
        text = clean(play.get("text") or "")
        label = clean(dig(play, "type", "text", default=""))

        if kind == "A" or label == "Start Batter/Pitcher":
            pitcher = batter = ""
            if " pitches to " in text:
                pitcher, batter = [clean(part) for part in text.split(" pitches to ", 1)]
            for who in play.get("participants") or []:
                ident = str(dig(who, "athlete", "id", default=""))
                if who.get("type") == "pitcher" and ident in names and not pitcher:
                    pitcher = names[ident][0]
                if who.get("type") == "batter" and ident in names and not batter:
                    batter = names[ident][0]
            current = {"inning": inning, "half": half, "pitcher": pitcher,
                       "batter": batter, "team": str(dig(play, "team", "id", default="")),
                       "pitches": [], "events": [], "result": "", "result_type": "",
                       "scoring": False, "bases": {}, "outs": play.get("outs") or 0,
                       "away": play.get("awayScore"), "home": play.get("homeScore"),
                       "bats": clean(dig(play, "bats", "abbreviation", default=""))}
            at_bats.append(current)
            continue

        if current is None:
            continue

        if kind == "P" or play.get("pitchVelocity") or (
                play.get("pitchCoordinate") and kind not in ("N", None)):
            coord = play.get("pitchCoordinate") or {}
            current["pitches"].append({
                "number": play.get("atBatPitchNumber") or len(current["pitches"]) + 1,
                "call": label,
                "kind": pitch_kind(label if label not in ("Play Result",) else text),
                "speed": play.get("pitchVelocity"),
                "type": clean(dig(play, "pitchType", "text", default="")),
                "type_abbr": clean(dig(play, "pitchType", "abbreviation", default="")),
                "x": coord.get("x"), "y": coord.get("y"),
                "count": play.get("resultCount") or {},
                "hit": play.get("hitCoordinate") or None,
                "text": text,
            })
            if label.lower() in HIT_TYPES or play.get("hitCoordinate"):
                current["pitches"][-1]["kind"] = "inplay"
            continue

        if label.lower() in STEAL_TYPES:
            current["events"].append({"label": label, "text": text,
                                      "inning": inning, "half": half})
            continue

        if kind == "N" or label in ("Play Result", "End Batter/Pitcher"):
            if text:
                current["result"] = text
            if label not in ("Play Result", "End Batter/Pitcher"):
                current["result_type"] = label
            elif not current["result_type"]:
                current["result_type"] = clean(dig(play, "type", "abbreviation",
                                                   default="")) or ""
            current["scoring"] = current["scoring"] or bool(play.get("scoringPlay"))
            current["outs"] = play.get("outs", current["outs"])
            current["away"] = play.get("awayScore", current["away"])
            current["home"] = play.get("homeScore", current["home"])
            bases = {}
            for base in ("onFirst", "onSecond", "onThird"):
                ident = str(dig(play, base, "athlete", "id", default=""))
                if ident:
                    bases[base] = names.get(ident, (ident, ""))[0]
            current["bases"] = bases
    return at_bats


def at_bat_text(ab):
    """What an at-bat came to, in words: its result, or the text of the pitch
    put in play (ESPN sometimes keeps the description there), or who batted."""
    if ab.get("result"):
        return ab["result"]
    for pitch in reversed(ab.get("pitches") or []):
        text = clean(pitch.get("text") or "")
        if len(text.split()) >= 3 and not re.match(r"(?i)^(ball|strike|foul)\b", text):
            return text
    for event in reversed(ab.get("events") or []):
        if event.get("text"):
            return event["text"]
    return f"{ab.get('batter') or 'run'} at bat"


def baseball_state(event, at_bats):
    """What the diamond looks like right now: inning, outs, count, runners."""
    last = at_bats[-1] if at_bats else None
    state = {"inning": event.get("period") or (last or {}).get("inning") or 0,
             "half": (last or {}).get("half") or "Top",
             "outs": (last or {}).get("outs") or 0,
             "bases": (last or {}).get("bases") or {},
             "balls": 0, "strikes": 0,
             "batter": (last or {}).get("batter") or "",
             "pitcher": (last or {}).get("pitcher") or ""}
    if last and last["pitches"]:
        count = last["pitches"][-1].get("count") or {}
        state["balls"] = count.get("balls", 0)
        state["strikes"] = count.get("strikes", 0)
    situation = event.get("situation") or {}
    if situation:
        for key, field in (("balls", "balls"), ("strikes", "strikes"), ("outs", "outs")):
            if situation.get(field) is not None:
                state[key] = situation[field]
        runners = {}
        for base, field in (("onFirst", "onFirst"), ("onSecond", "onSecond"),
                            ("onThird", "onThird")):
            who = situation.get(field)
            if isinstance(who, dict):
                runners[base] = clean(dig(who, "athlete", "shortName", default="")
                                      or dig(who, "athlete", "displayName", default=""))
            elif who:
                runners[base] = ""
        if runners:
            state["bases"] = runners
    return state


def render_diamond(state, league, batting_side):
    """The bases, the count and the outs, in three lines."""
    bases = state.get("bases") or {}
    style = THEME.style(league, batting_side, bold=True, fallback="accent") \
        if batting_side else "accent"

    def mark(base):
        return ("◆", style) if bases.get(base) else ("◇", "muted")

    second, third, first = mark("onSecond"), mark("onThird"), mark("onFirst")
    outs = state.get("outs") or 0
    count = f"{state.get('balls', 0)}-{state.get('strikes', 0)}"
    lines = []
    row = Line().add("     ").add(*second).add("       ", "normal")
    row.add(f"{count:<5}", "bold").add("count   ", "muted")
    row.add("".join("●" if i < outs else "○" for i in range(3)), "accent")
    row.add(f" {'out' if outs == 1 else 'outs'}", "muted")
    lines.append(row)
    row = Line().add("  ").add(*third).add("     ").add(*first)
    runners = [f"{base[2:].lower()}: {who}" for base, who in
               (("onThird", bases.get("onThird")), ("onSecond", bases.get("onSecond")),
                ("onFirst", bases.get("onFirst"))) if who]
    if runners:
        row.add("   " + "   ".join(runners), "dim")
    lines.append(row)
    lines.append(Line().add("     ⌂", "muted"))
    return lines


def strike_zone_lines(pitches, width, zone=None, height=None):
    """The strike zone seen from behind the plate, with the pitches on it.

    The box is the rule-book zone; pitches are numbered in the order they
    were thrown and coloured by what they were called.
    """
    width = clamp(width if width % 2 else width - 1, 19, 33)
    top_ft, bottom_ft = (zone or (ZONE_TOP_FT, ZONE_BOTTOM_FT))
    span_x = 1.25                     # feet either side of the plate centre
    top = top_ft + 0.55
    bottom = bottom_ft - 0.55
    # A terminal cell is about twice as tall as it is wide, so the number of
    # rows is set from the number of columns: without this the zone comes out
    # looking like a letterbox rather than the square it is.
    if height is None:
        per_foot = width / (2 * span_x)
        height = clamp(int(round((top - bottom) * per_foot / 2.25)), 7, 19)
    grid = [[(" ", "normal") for _ in range(width)] for _ in range(height)]

    def cell(x_ft, z_ft):
        col = int(round((x_ft + span_x) / (2 * span_x) * (width - 1)))
        row = int(round((top - z_ft) / (top - bottom) * (height - 1)))
        return clamp(col, 0, width - 1), clamp(row, 0, height - 1)

    left, top_row = cell(-PLATE_HALF, top_ft)
    right, bottom_row = cell(PLATE_HALF, bottom_ft)
    for col in range(left, right + 1):
        grid[top_row][col] = ("─", "zone")
        grid[bottom_row][col] = ("─", "zone")
    for row in range(top_row, bottom_row + 1):
        grid[row][left] = ("│", "zone")
        grid[row][right] = ("│", "zone")
    grid[top_row][left] = ("┌", "zone")
    grid[top_row][right] = ("┐", "zone")
    grid[bottom_row][left] = ("└", "zone")
    grid[bottom_row][right] = ("┘", "zone")
    # thirds, the way a catcher would call them
    for third in (1, 2):
        col = left + round((right - left) * third / 3)
        row = top_row + round((bottom_row - top_row) * third / 3)
        for r in range(top_row + 1, bottom_row):
            if grid[r][col][0] == " ":
                grid[r][col] = ("·", "zonefaint")
        for c in range(left + 1, right):
            if grid[row][c][0] == " ":
                grid[row][c] = ("·", "zonefaint")

    for pitch in pitches:
        if pitch.get("x") is None or pitch.get("y") is None:
            continue
        x_ft, z_ft = px_to_feet(pitch["x"], pitch["y"])
        col, row = cell(x_ft, z_ft)
        number = pitch.get("number") or 0
        grid[row][col] = (str(number % 10) if number else "•",
                          PITCH_STYLE.get(pitch.get("kind"), "dim"))

    lines = []
    for row in grid:
        line = Line()
        for char, style in row:
            line.add(char, style)
        lines.append(merge_spans(line))
    return lines


def zone_legend(width):
    order = ["strike", "swing", "ball", "foul", "inplay"]
    line = Line()
    for kind in order:
        if len(line.text) + len(PITCH_WORD[kind]) + 3 > width:
            break
        line.add("● ", PITCH_STYLE[kind]).add(PITCH_WORD[kind] + "  ", "muted")
    return [line]


def pitch_rows(at_bat, width, statcast=None):
    """The at-bat, one line per pitch."""
    lines = []
    extra = (statcast or {}).get("pitches") or []
    for index, pitch in enumerate(at_bat["pitches"]):
        detail = extra[index] if index < len(extra) else {}
        row = Line().add(f"  {pitch.get('number', index + 1):>2} ", "muted")
        speed = pitch.get("speed") or detail.get("speed")
        row.add(f"{(str(round(speed)) + ' mph') if speed else '':<8}", "bold")
        kind = pitch.get("type") or detail.get("type") or ""
        row.add(f"{kind[:14]:<15}", "dim")
        call = pitch.get("call") or ""
        row.add(f"{call[:18]:<19}", PITCH_STYLE.get(pitch.get("kind"), "normal"))
        count = pitch.get("count") or {}
        if count:
            row.add(f"{count.get('balls', 0)}-{count.get('strikes', 0)}", "muted")
        spin = detail.get("spin")
        if spin and len(row.text) + 12 < width:
            row.add(f"   {spin:,} rpm", "muted")
        lines.append(row)
        hit = detail.get("hit") or {}
        if hit:
            note = Line().add("       ", "normal")
            if hit.get("launchSpeed"):
                note.add(f"{hit['launchSpeed']:.0f} mph off the bat", "good")
            if hit.get("launchAngle") is not None:
                note.add(f"   {hit['launchAngle']:.0f}° launch", "dim")
            if hit.get("totalDistance"):
                note.add(f"   {hit['totalDistance']:.0f} ft", "dim")
            lines.append(note)
    return lines


def game_highlights(at_bats):
    """Home runs, steals and the fastest pitch, gathered from the whole game."""
    homers, steals, fastest = [], [], None
    for at_bat in at_bats:
        result = (at_bat.get("result") or "")
        low = result.lower()
        if "homered" in low or "home run" in low or at_bat.get("result_type") == "HR":
            homers.append((at_bat["inning"], at_bat["half"], result))
        for event in at_bat.get("events") or []:
            steals.append((event["inning"], event["half"],
                           event.get("text") or event.get("label")))
        for pitch in at_bat["pitches"]:
            if pitch.get("speed") and (fastest is None or pitch["speed"] > fastest[0]):
                fastest = (pitch["speed"], pitch.get("type") or "", at_bat["pitcher"])
    return homers, steals, fastest


def render_baseball_plays(summary, event, league, width, at_bat_index=None,
                          statcast=None, favorites=None):
    """(left pane, right pane, chosen at-bat index).

    Left is the live picture: the diamond, the count, the current at-bat
    pitch by pitch, then the innings behind it. Right is the strike zone.
    """
    at_bats = parse_baseball_plays(summary)
    if not at_bats:
        return ([Line().add("No pitch-by-pitch data published for this game yet.",
                            "dim")], [], 0)
    index = clamp(at_bat_index if at_bat_index is not None else len(at_bats) - 1,
                  0, len(at_bats) - 1)
    at_bat = at_bats[index]
    away, home = event["away"], event["home"]
    batting = away if at_bat.get("half", "Top").lower().startswith("top") else home
    fielding = home if batting is away else away
    state = baseball_state(event, at_bats[:index + 1])
    live = event.get("state") == "in"

    left = []
    head = Line()
    head.add(f"{at_bat['half']} {ordinal(at_bat['inning'])}", "live" if live else "accent")
    head.add("   ", "normal")
    head.add(f"{away['abbr']} ", THEME.style(league, away, bold=True))
    head.add(str(at_bat.get("away") if at_bat.get("away") is not None
                 else away["score"] or 0), "bold")
    head.add("  —  ", "muted")
    head.add(f"{home['abbr']} ", THEME.style(league, home, bold=True))
    head.add(str(at_bat.get("home") if at_bat.get("home") is not None
                 else home["score"] or 0), "bold")
    if index < len(at_bats) - 1:
        head.add(f"    at-bat {index + 1} of {len(at_bats)}", "muted")
    left.append(head)
    left.append(blank())
    left.extend(render_diamond(state, league, batting))
    left.append(blank())

    matchup = Line().add("  P  ", "muted")
    matchup.add(f"{at_bat['pitcher'] or '—':<22}", THEME.style(league, fielding,
                                                               bold=True))
    matchup.add("  AB  ", "muted")
    bats = f" ({at_bat['bats']})" if at_bat.get("bats") else ""
    matchup.add(f"{(at_bat['batter'] or '—') + bats}", THEME.style(league, batting,
                                                                  bold=True))
    left.append(matchup)
    left.append(blank())
    rows = pitch_rows(at_bat, width, statcast)
    if rows:
        left.append(Line().add("  This at-bat", "title"))
        left.extend(rows)
    if at_bat.get("result"):
        left.append(blank())
        left.extend(wrap_spans(at_bat["result"], width - 2,
                               "upset" if at_bat.get("scoring") else "normal",
                               indent="  "))
    for happening in at_bat.get("events") or []:
        left.extend(wrap_spans(happening.get("text") or happening["label"],
                               width - 2, "accent", indent="  "))

    left.append(blank())
    left.append(Line().add("  Recent plays", "title"))
    for previous in reversed(at_bats[max(0, index - 40):index]):
        if not previous.get("result"):
            continue
        row = Line().add(f"  {previous['half'][:1]}{previous['inning']:<3}", "muted")
        row.add(f"{(previous['batter'] or '')[:16]:<17}",
                THEME.style(league, away if previous['half'].lower().startswith('top')
                            else home))
        row.add(previous["result"][: max(10, width - 26)],
                "upsetsoft" if previous.get("scoring") else "dim")
        left.append(row)

    # ---- right pane: the zone
    zone = (statcast or {}).get("zone")
    right = [Line().add("Strike zone", "title").add(
        f"   {at_bat['batter']} vs {at_bat['pitcher']}"[: max(0, width - 12)], "muted")]
    right.append(blank())
    art = strike_zone_lines(at_bat["pitches"], min(width - 2, 33), zone)
    pad = " " * max(0, (width - max((len(l.text) for l in art), default=0)) // 2 - 1)
    right.extend(Line([(pad, "normal")] + list(line)) for line in art)
    right.append(blank())
    right.extend(zone_legend(width))
    speeds = [p["speed"] for p in at_bat["pitches"] if p.get("speed")]
    if speeds:
        row = Line().add("  ")
        row.add(f"{len(speeds)} pitches", "normal")
        row.add(f"   fastest {max(speeds):.0f}", "dim")
        row.add(f"   average {sum(speeds) / len(speeds):.0f} mph", "dim")
        right.append(blank())
        right.append(row)

    homers, steals, fastest = game_highlights(at_bats)
    if fastest:
        right.append(Line().add("  fastest pitch of the game: ", "muted").add(
            f"{fastest[0]:.0f} mph", "bold").add(
            f" {fastest[1]} · {fastest[2]}"[: max(0, width - 34)], "dim"))
    hardest = (statcast or {}).get("hardest")
    if hardest:
        right.append(Line().add("  hardest hit: ", "muted").add(
            f"{hardest['speed']:.0f} mph", "bold").add(
            f" {hardest.get('distance', 0):.0f} ft · {hardest.get('text', '')}"
            [: max(0, width - 30)], "dim"))
    if homers:
        right.append(blank())
        right.append(Line().add("Home runs", "title"))
        for inning, half, text in homers[-6:]:
            right.append(Line().add(f"  {half[:1]}{inning:<3}", "muted").add(
                text[: max(10, width - 8)], "normal"))
    if steals:
        right.append(blank())
        right.append(Line().add("On the bases", "title"))
        for inning, half, text in steals[-8:]:
            right.append(Line().add(f"  {half[:1]}{inning:<3}", "muted").add(
                (text or "")[: max(10, width - 8)], "dim"))
    scored, before, last_play = [], (0, 0), None
    for ab in at_bats[:index + 1]:
        now = (_int(ab.get("away"), before[0]), _int(ab.get("home"), before[1]))
        result = (ab.get("result") or "").lower()
        bookkeeping = " relieved " in result or "pitching change" in result \
            or " replaced " in result or " substitut" in result or " hit for " in result \
            or " ran for " in result or (not result and not ab.get("batter"))
        if now != before or ab.get("scoring"):
            # the runs belong to the last real play, not a pitching change
            target = last_play if bookkeeping else ab
            if target is not None and (not scored or scored[-1][0] is not target):
                scored.append((target, now))
            elif scored and scored[-1][0] is target:
                scored[-1] = (target, now)
        if not bookkeeping:
            last_play = ab
        before = now
    if scored:
        right.append(blank())
        right.append(Line().add("Scoring plays", "title"))
        for ab, score in scored:
            team = away if ab["half"].lower().startswith("top") else home
            row = Line().add(f"  {ab['half'][:1]}{ab['inning']:<3}", "muted")
            row.add(f"{team['abbr']:<4}", THEME.style(league, team, bold=True))
            row.add(f"{score[0]}-{score[1]}  ", "bold")
            text = at_bat_text(ab)
            row.add(text[: max(10, width - 20)], "normal")
            right.append(gutter(row, ab, True))
    return left, right, index


