        if key.startswith("@"):
            self.stats_orderby[self.league] = key[1:]
            self.status_message = {"stat": "Best first in the sort column.",
                                   "name": "Teams A-Z.",
                                   "group": "By conference." if self.league in
                                   COLLEGE_LEAGUES else "By league and division."}[key[1:]]
        else:
            self.stats_sort[self.league] = key
            if self.stats_order() == "name":
                self.stats_orderby[self.league] = stats_default_order(self.league)
        self.stats_sel[self.league] = 0
        self.scroll["Stats"] = 0

    def step_sort(self, step):
        table = self.stats_table_ready()
        if not table:
            return
        shown = stats_view_groups(table, self.stats_view.get(self.league) or "All",
                                  self.stdscr.getmaxyx()[1] - 4,
                                  conf=self.stats_conf_column())
        stats = [s for s in table.get("stats") or [] if s["group"] in shown]
        keys = [stat["key"] for stat in stats]
        if not keys:
            return
        current = self.stats_sort.get(self.league)
        index = keys.index(current) if current in keys else 0
        self.stats_sort[self.league] = keys[(index + step) % len(keys)]
        self.scroll["Stats"] = 0
        stat = stats[keys.index(self.stats_sort[self.league])]
        self.status_message = f"Sorted by {stat.get('label', stat['short'])}."

    def open_event_picker(self):
        if not is_olympic(self.league):
