    # -- favourites ------------------------------------------------------

    def load_teams(self):
        url, fallbacks = self.api.teams(self.league)
        return self.fetcher.get(("teams", self.league), url, ttl=86400,
                                fallbacks=fallbacks)

    def toggle_favorite(self, team):
        if not team:
            return
        picked = self.favorites.setdefault(family(self.league), [])
        rank = fav_rank(self.favorites, self.league, team)
        if rank >= 0:
            removed = picked.pop(rank)
            self.status_message = f"Removed {removed['name'] or removed['abbr']}."
        else:
            picked.append({"abbr": team.get("abbr", ""), "name": team.get("name", ""),
                           "id": team.get("id", "")})
            self.status_message = f"Added {team.get('name') or team.get('abbr')}."
        self.persist_favorites()

    def persist_favorites(self):
        self._slate.clear()         # favourites sort first on the ticker
        self.config["favorites"] = {key: list(value)
                                    for key, value in self.favorites.items()}
        try:
            save_config(self.config, self.args.config)
        except OSError as exc:
            self.status_message = f"Could not save favourites: {exc}"

    # -- data ------------------------------------------------------------

    def scoreboard_key(self):
        if is_olympic(self.league):
            return ("sb", self.league)
        if self.week_mode and LEAGUES[self.league]["week_based"]:
            week = self.week if self.week_pinned else "current"
            return ("sb", self.league, "w", week, self.seasontype, self.season_year,
                    self.cfb_group if self.league == "cfb" else "")
        return ("sb", self.league, "d", self.day.isoformat(),
                self.cfb_group if self.league == "cfb" else "")

    def scoreboard_url(self):
        groups = self.cfb_group if self.league == "cfb" else LEAGUES[self.league].get("groups")
        if self.week_mode and LEAGUES[self.league]["week_based"]:
            if self.week_pinned and self.week:
                return self.api.scoreboard(
                    self.league, week=self.week, seasontype=self.seasontype,
                    year=self.season_year, groups=groups)
            return self.api.scoreboard(self.league, groups=groups)
        return self.api.scoreboard(self.league, day=self.day, groups=groups)

    def scoreboard_ttl(self):
        if any(e["state"] == "in" for e in self.events):
            return clamp(self.interval // 2, 10, 60)     # live: twice as often
        if is_olympic(self.league) and not games_live(self.league):
            return 6 * 3600
        return max(30, self.interval)

    def load_scoreboard(self):
        url, fallbacks = self.scoreboard_url()
        result = self.fetcher.get(self.scoreboard_key(), url,
                                  ttl=self.scoreboard_ttl(), fallbacks=fallbacks)
        if result.data:
            self.sync_season(result.data)
        return result

    def sync_season(self, data):
        year = dig(data, "leagues", 0, "season", "year") or dig(data, "season", "year")
        if isinstance(year, int):
            self.season_year = year
        week = dig(data, "week", "number")
        seasontype = (dig(data, "leagues", 0, "season", "type", "type")
                      or dig(data, "season", "type"))
        if not self.week_pinned:
            if isinstance(week, int):
                self.week = week
            if isinstance(seasontype, int):
                self.seasontype = seasontype

    def load_summary(self, event_id):
        if not event_id:
            return Result(None, None, False, 0.0)
        selected = self.current_event()
        ttl = 15 if (selected and selected["state"] == "in") else 300
        url, fallbacks = self.api.summary(self.league, event_id)
        result = self.fetcher.get(("sum", self.league, event_id), url, ttl=ttl,
                                  fallbacks=fallbacks)
        if result.data:
            prepare_summary(result.data, self.league)
        return result

    def load_standings(self):
        primary, fallbacks = self.api.standings(self.league)
        ttl = 6 * 3600 if is_olympic(self.league) and not games_live(self.league) else 900
        result = self.fetcher.get(("st", self.league), primary, ttl=ttl, fallbacks=fallbacks)
        # before a new season's first game ESPN's table is all zeros; last
        # season's final one is the useful thing to show until then
        year = standings_unplayed(result.data) if LEAGUES[self.league].get("source",
                                                                           "espn") == "espn" \
            and not is_olympic(self.league) else None
        if year:
            primary, fallbacks = self.api.standings(self.league, season=year - 1)
            previous = self.fetcher.get(("st", self.league, year - 1), primary, ttl=86400,
                                        fallbacks=fallbacks)
            if previous.data and not standings_unplayed(previous.data):
                return previous
        return result

    # -- season numbers, scouting --------------------------------------------

    def team_groups(self):
        """{team id: [conference, division]} from the standings, for filters."""
        result = self.load_standings()
        extra = catalog = None
        if self.league in ("cbase", "csoft"):
            hoops = "cbb" if self.league == "cbase" else "wcbb"
            primary, spare = self.api.standings(hoops)
            extra = self.fetcher.get(("st", hoops), primary, ttl=86400, fallbacks=spare)
            primary, spare = self.api.teams(self.league)
            catalog = self.fetcher.get(("teams", self.league), primary, ttl=86400,
                                       fallbacks=spare)
        stamp = (self.league, result.stamp, extra.stamp if extra else None,
                 catalog.stamp if catalog else None)
        if self._groups_cache[0] == stamp:
            return self._groups_cache[2]
        out = {}
        for ident, (_, _, path) in standings_rows(result.data).items():
            out.setdefault(ident, group_names(path, self.league))
        if extra and extra.data and catalog and catalog.data:
            schools = groups_by_school(extra.data, self.league)
            for node in dig(catalog.data, "sports", 0, "leagues", 0, "teams",
                            default=[]) or []:
                team = team_record(node.get("team") or {})
                if out.get(team["id"]):
                    continue
                for key in (team.get("location"), team.get("short")):
                    if key and norm_name(key) in schools:
                        out[team["id"]] = schools[norm_name(key)]
                        break
        self._groups_cache = (stamp, None, out)
        return out

    def load_team_table(self):
        extras = bool(self.config.get("extra_stat_sources", True))
        ttl = 12 * 3600 if self.league in ("cbase", "csoft") else 3600
        return self.fetcher.get(("tstats", self.league, extras),
                                Loader("team stats", team_stats_table, self.league,
                                       extras=extras), ttl=ttl)

    # -- betting -----------------------------------------------------------

    def load_bet_board(self):
        if self.league not in AN_LEAGUES or not self.config.get("betting_sources", True):
            return None
        if self.week_mode and LEAGUES[self.league]["week_based"]:
            key = ("an", self.league, "w", self.week, self.seasontype, self.season_year)
            loader = Loader("api.actionnetwork.com", an_board, self.league, week=self.week,
                            season=self.season_year, seasontype=self.seasontype)
        else:
            key = ("an", self.league, "d", self.day.isoformat())
            loader = Loader("api.actionnetwork.com", an_board, self.league, day=self.day)
        return self.fetcher.get(key, loader, ttl=120)

    def load_kalshi(self):
        if self.league not in KALSHI_SERIES or not self.config.get("betting_sources", True):
            return None
        return self.fetcher.get(("kalshi", self.league),
                                Loader("api.elections.kalshi.com", kalshi_board, self.league),
                                ttl=300)

    def top_books(self):
        chosen = self.config.get("betting_top_books") or TOP_BOOKS_DEFAULT
        known = [name for _, name, _ in BOOKS]
        return [name for name in chosen if name in known] or TOP_BOOKS_DEFAULT

    def bet_mode_label(self):
        if self.league in ("ahl", "milb", "csoft"):
            return "sportst's projection only"
        if self.league not in AN_LEAGUES or not self.config.get("betting_sources", True):
            return "ESPN's line where posted, sportst's projection"
        if self.bet_book == "best":
            return "best price at any book"
        if self.bet_book == "avg":
            return "average of " + " · ".join(self.top_books())
        return self.bet_book + " only"

    def min_edge(self):
        try:
            return max(0.5, float(self.config.get("betting_min_edge", 3.0)))
        except (TypeError, ValueError):
            return 3.0

    def bet_rows(self):
        """(rows, games hidden because they have started) for the Betting tab."""
        events = [e for e in self.events if e["state"] == "pre"]
        hidden = len(self.events) - len(events)
        table = self.load_team_table().data
        board = self.load_bet_board()
        markets = self.load_kalshi()
        rows = [self.bet_row(event, board, markets, table, index < 80) for index, event
                in enumerate(events)]
        # best bets ranked: most stars, then the biggest edge
        picks = sorted((r for r in rows if r["pick"]),
                       key=lambda r: (-r["pick"]["stars"], -r["pick"]["ev"]))
        for rank, row in enumerate(picks, 1):
            row["rank"] = rank
        if self.bet_picks_only:
            rows = picks if self.bet_sort == "value" else [r for r in rows if r["pick"]]
        elif self.bet_sort == "value":
            rest = sorted((r for r in rows if not r["pick"]),
                          key=lambda r: -(r["best"]["ev"] if r["best"] else -9))
            rows = picks + rest
        return rows, hidden

    def bet_row(self, event, board, markets, table, with_summary=True):
        """Everything the Betting tab knows about one game."""
        league = self.league
        mode = self.bet_book
        top = self.top_books()
        min_edge = self.min_edge()
        game = match_an_game(event, board.data) if board and board.data else None
        books = dict(game["books"]) if game else {}
        sellers = {n: l for n, l in books.items() if n not in ("Consensus", "Open")}
        espn = espn_line_as_book(event.get("line") or event.get("line_raw"))
        market = books.get("Consensus") or average_lines(list(sellers.values())) or espn
        if mode == "avg":
            shown = average_lines([sellers[n] for n in top if n in sellers]) or \
                average_lines(list(sellers.values())) or espn
            candidates = [shown]
        elif mode == "best":
            shown = market
            candidates = list(sellers.values()) or [espn]
        else:
            shown = sellers.get(mode)
            candidates = [shown]
        summary, loading = None, False
        if with_summary:
            result = self.load_summary(event["id"])
            summary = result.data
            loading = result.loading and not summary
        kalshi = match_kalshi(event, markets.data) if markets and markets.data else None
        public = game["public"] if game else {}
        model = project_game(event, league, table, market, summary, kalshi,
                             books.get("Open"), public)
        bets = bet_options(event, league, model, [c for c in candidates if c],
                           "best" if mode == "best" else "one", min_edge)
        pick = best_pick(bets)
        return {"event": event, "line": shown, "market": market, "books": books,
                "espn_line": espn, "model": model, "bets": bets, "pick": pick,
                "best": bets[0] if bets else None, "kalshi": kalshi,
                "public": public, "loading": loading,
                "move": line_move(market, books.get("Open"), event, league),
                "top_books": top if mode == "avg" else [mode]}

    def draw_betting(self, top, height, width):
        meta = LEAGUES[self.league]
        rows, hidden = self.bet_rows()
        self._bet_rows = rows
        inner = width - 4
        fam = family(self.league)
        caption = f"{meta['name']} betting · {self.bet_mode_label()}"
        if self.group_filter.get(fam):
            caption += f" · {short_group(self.group_filter[fam])}"
        picks = sum(1 for r in rows if r["pick"])
        if not rows:
            lines = []
            if self.bet_picks_only:
                lines.append(Line().add("No game clears the value bar right now. M shows "
                                        "every game again.", "dim"))
            else:
                lines.append(Line().add("No upcoming games " + (
                    "this week." if self.week_mode and meta["week_based"] else "on this day.")
                    + (f"  ({hidden} already started or finished.)" if hidden else ""), "dim"))
                lines.append(Line().add("h / l moves the " + (
                    "week" if self.week_mode and meta["week_based"] else "day") +
                    "; the filters (c, F) apply here too.", "muted"))
                board = self.load_bet_board()
                report = line_report_lines(self.events, self.league, inner,
                                           board.data if board else None,
                                           self.week_mode and meta["week_based"])
                if report:
                    lines += [blank()] + report
            if self.league in ("ahl", "milb", "csoft"):
                lines.append(blank())
                lines.append(Line().add(f"No sportsbook or feed posts "
                                        f"{ {'milb': 'Minor League', 'csoft': 'college softball'}.get(self.league, 'AHL')} lines, "
                                        "so this tab shows sportst's own projection only.",
                                        "muted"))
            elif self.league not in AN_LEAGUES:
                lines.append(blank())
                lines.append(Line().add("Sportsbook lines for this league come only from "
                                        "ESPN, when it has them; sportst's projection "
                                        "still runs.", "muted"))
            self.draw_lines_box(top, height, width, caption, lines, key="Betting")
            return
        self.bet_index = clamp(self.bet_index, 0, len(rows) - 1)
        list_lines = render_bet_list(rows, self.league, inner, self.bet_index,
                                     self.bet_book == "best")
        list_height = clamp(len(list_lines) + 2, 5, max(8, int(height * 0.25)))
        if height - list_height < 8:
            list_height = max(5, height - 8)
        caption += f" · {len(rows)} game{'s' if len(rows) != 1 else ''} · {picks} value " \
                   f"pick{'s' if picks != 1 else ''}"
        caption += " · best bets first" if self.bet_sort == "value" else " · by start time"
        self.draw_box(top, 0, list_height, width, caption, "accent")
        view = list_height - 3
        offset = self.scroll["BettingList"]
        if self.bet_index < offset:
            offset = self.bet_index
        elif self.bet_index >= offset + view:
            offset = self.bet_index - view + 1
        offset = clamp(offset, 0, max(0, len(list_lines) - 1 - view))
        self.scroll["BettingList"] = offset
        self.draw_lines(list_lines[:1], top + 1, 2, 1, inner, 0)
        self.draw_lines(list_lines[1:], top + 2, 2, view, inner, offset)
        for row in range(view):
            index = offset + row
            if index < len(rows):
                self.hot(top + 2 + row, 1, width - 2,
                         lambda i=index: self.click_bet(i),
                         lambda i=index: self.click_bet(i, True))
        self.wheel(top + list_height, top + height, 0, width, ord("J"), ord("K"))
        self.draw_scrollbar(top + 2, width - 2, view, len(list_lines) - 1, offset)

        row = rows[self.bet_index]
        event = row["event"]
        pane = self.pane_width(width)
        left = render_bet_books(row, self.league, pane, public=False)
        crowd = bet_public_lines(row)
        notes = []
        if hidden:
            notes.append(f"{hidden} game{'s' if hidden != 1 else ''} already started")
        notes.append(("B sportsbook · " if self.league in AN_LEAGUES else "") +
                     "s sort · M picks only · c / F filter · $ ask Kim · enter scouting")
        footnotes = []         # last, under whatever else the left pane holds (6.21.0)
        for text in notes:
            footnotes.extend(wrap_spans(text, pane, "muted"))
        footnotes.extend(wrap_spans("Estimates, not guarantees. Stake is an eighth-Kelly size "
                                    "in units of 1% of a bankroll. Problem gambling help: "
                                    "1-800-GAMBLER.", pane, "muted"))
        right = render_bet_model(row, self.league, pane, self.min_edge())
        # 6.21.0: the public beside the tale of the tape, and the blocks below
        # placed whichever way leaves the taller pane shortest, so the detail
        # fits a screen; the fine print goes last, under the shorter pane
        tape, blocks = [], []
        if self.league in ("nhl", "ahl"):
            standings = self.load_standings()
            tape = tale_of_tape(event, hockey_table(standings.data, self.league)
                                if standings.data else [], self.league, pane)
            odds = score_odds_lines(row.get("model"), event, self.league, pane,
                                    (row.get("line") or {}).get("total"))
            blocks.append((odds, True))
        elif sport_of(self.league) in ("basketball", "football") and \
                not is_olympic(self.league):
            standings = self.load_standings()
            tape = bball_tape(event, basketball_table(standings.data, self.league)
                              if standings.data else [], self.league, pane)
            posted = row.get("line") or {}
            blocks.append((margin_odds_lines(row.get("model"), event, self.league, pane,
                                             posted.get("spread"), posted.get("total")),
                           True))
        packed = pack_beside([crowd, tape], pane)
        if packed:
            left = list(left) + [blank()] + packed
        report = []
        if hidden:
            # the day's games already over, against their closing lines: in a
            # box of their own under the lines, scrolling on its own (7.0.0),
            # where the panes stand side by side
            board = self.load_bet_board()
            report = line_report_lines(self.events, self.league, pane,
                                       board.data if board else None,
                                       self.week_mode and meta["week_based"])
            if report and width < self.SPLIT_MIN_WIDTH:
                blocks.append((report, False))
                report = []
        # the week's lines' box takes the bottom of the left column: as tall
        # as it needs, up to half the detail; the blocks go where the columns
        # (that box counted in) come out shortest
        report_h = clamp(len(report) + 1, 6, max(6, (height - list_height) // 2)) \
            if report else 0
        base = len(left)
        left, right = balance_panes(list(left) + [Line()] * report_h, right, blocks)
        if report_h:
            left = left[:base] + left[base + report_h:]
        if footnotes:
            if len(left) + report_h <= len(right):
                left = list(left) + [blank()] + footnotes
            else:
                right = list(right) + [blank()] + footnotes
        away, home = event["away"], event["home"]
        title = Line().add(" ", "border").add(away["abbr"], THEME.style(self.league, away, bold=True))
        title.add(" @ ", "muted").add(home["abbr"], THEME.style(self.league, home, bold=True))
        title.add(f" · {bet_time(event)} · lines ", "dim")
        read_title = Line().add(" sportst's read ", "accent")
        if report:
            self.draw_betting_panes(top + list_height, height - list_height, width,
                                    title, left, read_title, right, report, report_h)
            return
        self.draw_two_panes(top + list_height, height - list_height, width, "Betting",
                            [(title, left), (read_title, right)])

    def draw_betting_panes(self, top, height, width, title, left, read_title, right,
                           report, report_h):
        """Betting's detail with the week's (or day's) finished games in a box
        of their own under the lines (7.0.0): the lines, that box and
        sportst's read each scroll on their own, tab moving from one to the
        next."""
        key = "Betting"
        left_width = width // 2
        body = report[1:]
        report_h = clamp(report_h, 4, max(4, height - 5))
        left_h = height - report_h
        boxes = [(0, top, left_h, left_width, title, left),
                 (1, top + left_h, report_h, left_width, None, body),
                 (2, top, height, width - left_width, read_title, right)]
        lengths = [len(left), len(body), len(right)]
        views = [left_h - 2, report_h - 2, height - 2]
        focus = self.split_focus(key, lengths, views,
                                 names=["the lines", "the week's lines", "sportst's read"])
        for index, y, h, w, head, lines in boxes:
            x = 0 if index < 2 else left_width
            view = h - 2
            offset = clamp(self.scroll[(key, index)], 0, max(0, len(lines) - view))
            dict.__setitem__(self.scroll, (key, index), offset)
            lit = self._split_scrolls and index == focus
            self.draw_box(y, x, h, w, border_style="accent" if lit else "border")
            if head is not None:
                self.draw_lines([head], y, x + 2, 1, w - 4, 0)
            else:
                self.draw_lines([Line().add(" ", "border").extend_spans(report[0])
                                 .add(" ", "border")], y, x + 2, 1, w - 4, 0)
            self.draw_lines(lines, y + 1, x + 2, view, w - 4, offset)
            self.draw_scrollbar(y + 1, x + w - 2, view, len(lines), offset)
            self.wheel(y, y + h, x, x + w,
                       lambda i=index: self.wheel_pane(key, i, 1),
                       lambda i=index: self.wheel_pane(key, i, -1))

    def handle_betting_key(self, key):
        rows = self._bet_rows
        if key in (ord("j"), curses.KEY_DOWN):
            self.bet_index = clamp(self.bet_index + 1, 0, max(0, len(rows) - 1))
            self.scroll["Betting"] = 0
        elif key in (ord("k"), curses.KEY_UP):
            self.bet_index = clamp(self.bet_index - 1, 0, max(0, len(rows) - 1))
            self.scroll["Betting"] = 0
        elif key == curses.KEY_NPAGE:
            self.bet_index = clamp(self.bet_index + 10, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_PPAGE:
            self.bet_index = clamp(self.bet_index - 10, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_HOME:
            self.bet_index = 0
        elif key in (curses.KEY_END, ord("G")):
            self.bet_index = max(0, len(rows) - 1)
        elif key == ord("J"):
            self.scroll_panes("Betting", 1)
        elif key == ord("K"):
            self.scroll_panes("Betting", -1)
        elif key == ord("b"):
            self.open_book_picker()
        elif key == ord("s"):
            self.bet_sort = "value" if self.bet_sort == "time" else "time"
            self.bet_index = 0
            self.status_message = ("Best bets first, ranked." if self.bet_sort == "value"
                                   else "In start-time order.")
        elif key == ord("m"):
            self.bet_picks_only = not self.bet_picks_only
            self.bet_index = 0
            self.status_message = ("Value picks only." if self.bet_picks_only
                                   else "Every upcoming game.")
        elif key in (10, 13, curses.KEY_ENTER):
            if rows:
                event = rows[clamp(self.bet_index, 0, len(rows) - 1)]["event"]
                self.selected_id = event["id"]
                self.sync_selection()
                self.tab = self.tabs.index("Scouting")
                self.scroll["Scouting"] = 0
        elif key == ord("z") and rows:
            # the Game Center over the Betting tab: esc comes back to the list
            self.open_center(self.league, rows[clamp(self.bet_index, 0, len(rows) - 1)]["event"])
        else:
            return False
        return True

