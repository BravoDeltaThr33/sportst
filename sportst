NFL_ROUNDS = ["Wild Card", "Divisional", "Championship", "Super Bowl"]
CFB_ROUNDS = ["First Round", "Quarterfinal", "Semifinal", "National Championship"]
MLB_ROUNDS = ["Wild Card", "Division Series", "Championship Series", "World Series"]
NHL_ROUNDS = ["1st Round", "2nd Round", "Conf Finals", "Stanley Cup Final"]
CBASE_ROUNDS = ["Regionals", "Super Regionals", "College World Series", "Finals"]

NHL_API = "https://api-web.nhle.com/v1"


PLACEHOLDER_NAMES = {"TBD", "TBA", "", "?"}


def real_team(team):
    """A named team, not a bracket placeholder like 'TBD' or 'AL 4/5 Winner'."""
    if not isinstance(team, dict):
        return False
    abbr = clean(team.get("abbr") or "").upper()
    if abbr and abbr not in PLACEHOLDER_NAMES:
        return bool(team.get("id")) or len(abbr) <= 5
    return False


def count_real_teams(rounds):
    seen = set()
    for _, entries in rounds:
        for entry in entries:
            for which in ("top", "bottom"):
                team = entry[which].get("team") or {}
                if real_team(team):
                    seen.add(team.get("id") or team.get("abbr"))
    return len(seen)


def side(team, seed=None, score=None, winner=False):
    return {"team": team or {}, "seed": seed, "score": score, "winner": bool(winner)}


def series(round_name, conference, top, bottom, status="", note="", best_of=None):
    return {"round": round_name, "conference": conference or "", "top": top,
            "bottom": bottom, "status": status, "note": note, "best_of": best_of}


def team_key(team):
    """Whatever identifies this team in the data at hand."""
    if not isinstance(team, dict):
        return ""
    return (str(team.get("id") or "") or clean(team.get("abbr") or "")
            or clean(team.get("name") or ""))


def series_winner(entry):
    for which in ("top", "bottom"):
        if entry[which].get("winner"):
            return team_key(entry[which].get("team"))
    return ""


def series_teams(entry):
    return [key for key in (team_key(entry[which].get("team"))
                            for which in ("top", "bottom")) if key]


def conference_of(text):
    text = (text or "").upper()
    for tag in ("AFC", "NFC", "AL", "NL", "EAST", "WEST"):
        if tag in text:
            return {"EAST": "East", "WEST": "West"}.get(tag, tag)
    return ""


def note_tail(headline):
    """The part of a bowl or tournament note worth showing under a series."""
    text = clean(headline or "")
    for marker in (" - ", " at the "):
        if marker in text:
            return text.split(marker, 1)[1][:24]
    if "Elimination" in text or "advances" in text:
        return text[:24]
    return ""


def cbase_round(headline):
    low = (headline or "").lower()
    if "championship final" in low or "finals" in low:
        return "Finals"
    if "world series" in low:
        return "College World Series"
    if "super regional" in low:
        return "Super Regionals"
    return "Regionals"


def bracket_from_events(events, league, rounds, seeds=None, keep=None, namer=None,
                        notes=True):
    """Single-elimination rounds built from ESPN postseason games."""
    seeds = seeds or {}
    grouped = {}
    for event in events:
        headline = ""
        for note in event.get("notes") or []:
            headline = headline or clean(note)
        if keep and not keep(headline):
            continue
        if namer:
            name = namer(headline)
        else:
            name = next((r for r in rounds
                         if r.lower().split()[0] in headline.lower()), "")
        if not name:
            name = headline or rounds[0]
        away, home = event["away"], event["home"]
        top = side(home, seeds.get(home["id"]) or home.get("rank"), home["score"],
                   home.get("winner"))
        bottom = side(away, seeds.get(away["id"]) or away.get("rank"), away["score"],
                      away.get("winner"))
        status = "" if event["state"] == "post" else status_text(event)
        if not status and notes and note_tail(headline):
            status = note_tail(headline)
        grouped.setdefault(name, []).append(
            series(name, conference_of(headline), top, bottom, status, headline))
    order = [r for r in rounds if r in grouped] + [k for k in grouped if k not in rounds]
    return [(name, grouped[name]) for name in order]


NBA_ROUNDS = ["1st Round", "Conf Semifinals", "Conf Finals", "NBA Finals"]
CBB_ROUNDS = ["First Four", "1st Round", "2nd Round", "Sweet 16", "Elite 8", "Final Four",
              "Championship"]
# where each seed's pod sits in a region, top to bottom
BRACKET_SEEDS = [1, 16, 8, 9, 5, 12, 4, 13, 6, 11, 3, 14, 7, 10, 2, 15]


WNBA_ROUNDS = ["1st Round", "Semifinals", "WNBA Finals"]


def wnba_round(headline):
    """A WNBA playoff game's round, from ESPN's note (7.0.0)."""
    low = (headline or "").lower()
    if "commissioner" in low:
        return ""
    if "wnba finals" in low:
        return "WNBA Finals"
    if "semifinal" in low:
        return "Semifinals"
    if "first round" in low or "1st round" in low:
        return "1st Round"
    return ""


def nba_round(headline):
    low = (headline or "").lower()
    if "play-in" in low:
        return ""
    if "wnba" in low:
        return wnba_round(headline)
    if "nba finals" in low:
        return "NBA Finals"
    if "first round" in low or "1st round" in low:
        return "1st Round"
    if "semifinal" in low:
        return "Conf Semifinals"
    if "final" in low:
        return "Conf Finals"
    return ""


def bracket_nba(events):
    """ESPN lists playoff games one at a time; fold them into series. The
    team at home in game one is the higher seed."""
    found = {}
    for event in sorted(events, key=lambda e: e["date"] or ""):
        headline = next((n for n in event.get("notes") or [] if n), "")
        name = nba_round(headline)
        if not name:
            continue
        away, home = event["away"], event["home"]
        key = (name, frozenset((away["id"], home["id"])))
        entry = found.get(key)
        if entry is None:
            conference = "East" if headline.lower().startswith("east") else (
                "West" if headline.lower().startswith("west") else "")
            entry = found[key] = {"name": name, "conference": conference,
                                  "top": home, "bottom": away, "wins": {}, "status": "",
                                  "done": False}
        info = dig(event, "raw", "competitions", 0, "series", default={}) or {}
        for team in info.get("competitors") or []:
            entry["wins"][str(team.get("id"))] = team.get("wins") or 0
        entry["done"] = bool(info.get("completed"))
        entry["status"] = clean(info.get("summary") or "")
    rounds = {}
    for entry in found.values():
        top, bottom = entry["top"], entry["bottom"]
        wins_top = entry["wins"].get(top["id"], 0)
        wins_bottom = entry["wins"].get(bottom["id"], 0)
        spots = [side(top, None, wins_top, entry["done"] and wins_top > wins_bottom),
                 side(bottom, None, wins_bottom, entry["done"] and wins_bottom > wins_top)]
        status = "" if entry["done"] else entry["status"]
        rounds.setdefault(entry["name"], []).append(
            series(entry["name"], entry["conference"], spots[0], spots[1], status,
                   best_of=7))
    for name in rounds:
        rounds[name].sort(key=lambda s: (s["conference"] != "East", s["conference"]))
    order = WNBA_ROUNDS if "WNBA Finals" in rounds or "Semifinals" in rounds else NBA_ROUNDS
    return [(name, rounds[name]) for name in order if name in rounds]


def cbb_round(headline):
    tail = (headline or "").split(" - ")[-1].strip().lower()
    for name, keys in (("First Four", ("first four",)), ("1st Round", ("1st round",
                                                                        "first round")),
                       ("2nd Round", ("2nd round", "second round")),
                       ("Sweet 16", ("sweet 16", "regional semifinal")),
                       ("Elite 8", ("elite 8", "elite eight", "regional final")),
                       ("Final Four", ("final four", "national semifinal")),
                       ("Championship", ("championship",))):
        if any(k in tail for k in keys):
            return name
    return ""


def bracket_cbb(events):
    """The NCAA tournament, each region's games in bracket order so the
    wiring runs straight."""
    rounds = bracket_from_events(
        events, "cbb", CBB_ROUNDS,
        keep=lambda h: "basketball championship" in h.lower() and bool(cbb_round(h)),
        namer=cbb_round, notes=False)
    regions = []
    for _, entries in rounds:
        for entry in entries:
            # the men's 'East Region', the women's 'Regional 2 in Sacramento' (7.0.0)
            match = re.search(r" - (\w+) Region\b", entry.get("note") or "") or \
                re.search(r" - (Regional \d+)", entry.get("note") or "")
            entry["conference"] = match.group(1) if match else ""
            if entry["conference"] and entry["conference"] not in regions:
                regions.append(entry["conference"])

    def position(entry):
        seeds = []
        for which in ("top", "bottom"):
            try:
                seeds.append(int(entry[which].get("seed")))
            except (TypeError, ValueError):
                pass
        low = min(seeds) if seeds else 99
        region = regions.index(entry["conference"]) if entry["conference"] in regions else 9
        return (region, BRACKET_SEEDS.index(low) if low in BRACKET_SEEDS else 99)
    # the First Four feeds only four of the 32 first-round games; wiring it in
    # would push the whole bracket out of seed order, so the field starts at 64
    return [(name, sorted(entries, key=position)) for name, entries in rounds
            if name != "First Four"]


def basketball_postseason_urls(api, league, season):
    """Where ESPN keeps a basketball postseason: the NBA by month, the NCAA
    tournament as one group."""
    if league in ("nba", "wnba"):
        months = (4, 5, 6) if league == "nba" else (9, 10)
        return [(month, api.espn._site(
            f"basketball/{league}/scoreboard?dates={season}{month:02d}"
            f"&seasontype=3&limit=300" if league == "wnba" else
            f"basketball/{league}/scoreboard?dates={season}{month:02d}&limit=300"))
            for month in months]
    path = LEAGUES[league]["path"]
    return [(0, api.espn._site(
        f"basketball/{path}/scoreboard?dates={season}"
        f"&seasontype=3&groups=100&limit=300"))]


def bracket_nhl(data):
    """NHL publishes its own bracket, seeds and series scores included."""
    rounds = {}
    for entry in dig(data, "series", default=[]) or []:
        title = clean(entry.get("seriesTitle") or "")
        name = {1: "1st Round", 2: "2nd Round", 3: "Conf Finals",
                4: "Stanley Cup Final"}.get(entry.get("playoffRound"), title)

        def team_of(node):
            if not node:
                return {}
            return {"id": str(node.get("id", "")), "abbr": clean(node.get("abbrev") or ""),
                    "name": clean(dig(node, "name", "default", default="")),
                    "short": clean(dig(node, "commonName", "default", default="")),
                    "location": clean(dig(node, "placeNameWithPreposition", "default",
                                          default="")),
                    "color": ""}

        top_team, bottom_team = team_of(entry.get("topSeedTeam")), \
            team_of(entry.get("bottomSeedTeam"))
        winner = str(entry.get("winningTeamId") or "")
        top = side(top_team, entry.get("topSeedRankAbbrev") or entry.get("topSeedRank"),
                   entry.get("topSeedWins"), winner and winner == top_team.get("id"))
        bottom = side(bottom_team,
                      entry.get("bottomSeedRankAbbrev") or entry.get("bottomSeedRank"),
                      entry.get("bottomSeedWins"),
                      winner and winner == bottom_team.get("id"))
        conference = clean(entry.get("conferenceAbbrev") or "")
        if not conference and entry.get("seriesLetter"):
            conference = "East" if entry["seriesLetter"] <= "D" else "West"
        status = ""
        if entry.get("neededToWin"):
            status = f"best of {2 * entry['neededToWin'] - 1}"
        rounds.setdefault(name, []).append(
            series(name, conference, top, bottom, status))
    order = [r for r in NHL_ROUNDS if r in rounds] + \
        [k for k in rounds if k not in NHL_ROUNDS]
    return [(name, rounds[name]) for name in order]


def bracket_mlb(schedule, teams_by_name=None):
    """MLB's postseason schedule, folded back into series."""
    teams_by_name = teams_by_name or {}
    found = {}
    for day in dig(schedule, "dates", default=[]) or []:
        for game in day.get("games") or []:
            description = clean(game.get("seriesDescription") or "")
            name = next((r for r in MLB_ROUNDS if r.lower() in description.lower()), "")
            if not name:
                name = description or "Postseason"
            pair = {}
            for which in ("away", "home"):
                node = dig(game, "teams", which, default={}) or {}
                team_name = clean(dig(node, "team", "name", default=""))
                pair[which] = (team_name, bool(node.get("isWinner")))
            key = (name, tuple(sorted(x[0] for x in pair.values())),
                   clean(game.get("description") or "").split("Game")[0].strip())
            entry = found.setdefault(key, {"name": name, "conference":
                                           conference_of(description),
                                           "wins": {}, "played": 0,
                                           "of": game.get("gamesInSeries")})
            state = dig(game, "status", "abstractGameState", default="")
            if state == "Final":
                entry["played"] += 1
                for team_name, won in pair.values():
                    entry["wins"].setdefault(team_name, 0)
                    if won:
                        entry["wins"][team_name] += 1
            else:
                for team_name, _ in pair.values():
                    entry["wins"].setdefault(team_name, 0)

    rounds = {}
    for (name, pair, _), entry in found.items():
        wins = entry["wins"]
        needed = ((entry["of"] or 3) + 1) // 2
        sides = []
        for team_name in sorted(pair, key=lambda n: -wins.get(n, 0)):
            team = teams_by_name.get(team_name.lower()) or {"id": "", "abbr": "",
                                                            "name": team_name}
            sides.append(side(team, None, wins.get(team_name, 0),
                              wins.get(team_name, 0) >= needed))
        while len(sides) < 2:
            sides.append(side({}))
        status = f"best of {entry['of']}" if entry.get("of") else ""
        rounds.setdefault(name, []).append(
            series(name, entry["conference"], sides[0], sides[1], status))
    order = [r for r in MLB_ROUNDS if r in rounds] + \
        [k for k in rounds if k not in MLB_ROUNDS]
    return [(name, rounds[name]) for name in order]


# the box-drawing joint where a bracket wire meets its column:
# (goes up, goes down, a feeder comes in from the left, the series goes right)
BRACKET_JOINTS = {(False, False, True, True): "─", (False, True, True, False): "┐",
                  (True, False, True, False): "┘", (True, True, True, False): "┤",
                  (False, True, False, True): "┌", (True, False, False, True): "└",
                  (True, True, False, True): "├", (True, True, True, True): "┼",
                  (False, True, True, True): "┬", (True, False, True, True): "┴",
                  (True, True, False, False): "│", (False, False, False, True): "─"}


def bracket_rows(rounds, connect=True):
    """({(column, index): top row}, {(column, index): [the series that fed it]}).

    A wired bracket is laid out as a tree from the final back: each series
    level with the ones that fed it, and those always next to each other, so
    no two wires cross. A series nothing fed (the first round, a team off a
    bye) takes the next free slot; a game for third sits under the final.
    """
    rows, feeders = {}, {}
    if not connect:
        for column, (_, entries) in enumerate(rounds):
            for index in range(len(entries)):
                rows[(column, index)] = index * 3
        return rows, feeders
    columns = len(rounds)
    parent = {}
    for column in range(1, columns):
        previous = rounds[column - 1][1]
        for index, entry in enumerate(rounds[column][1]):
            teams = set(series_teams(entry))
            fed = []
            for j, earlier in enumerate(previous):
                winner = series_winner(earlier)
                if (column - 1, j) not in parent and winner and winner in teams:
                    fed.append((column - 1, j))
                    parent[(column - 1, j)] = (column, index)
            feeders[(column, index)] = fed
    consolation = set()
    for column in range(1, columns):
        beaten = set()
        for entry in rounds[column - 1][1]:
            winner = series_winner(entry)
            if winner:
                beaten.update(t for t in series_teams(entry) if t != winner)
        for index, entry in enumerate(rounds[column][1]):
            teams = series_teams(entry)
            if not feeders[(column, index)] and (column, index) not in parent and (
                    (teams and all(t in beaten for t in teams))
                    or "bronze" in (entry.get("round") or "").lower()
                    or "third" in (entry.get("round") or "").lower()):
                consolation.add((column, index))
    groups = []
    for _, entries in rounds:
        for entry in entries:
            if entry.get("conference") and entry["conference"] not in groups:
                groups.append(entry["conference"])

    def group_rank(node):
        conference = rounds[node[0]][1][node[1]].get("conference") or ""
        return groups.index(conference) if conference in groups else -1

    roots = [(column, index) for column in range(columns)
             for index in range(len(rounds[column][1]))
             if (column, index) not in parent and (column, index) not in consolation]
    roots.sort(key=lambda node: (group_rank(node), -node[0], node[1]))
    slot = [0]

    def place(node):
        fed = feeders.get(node) or []
        for child in fed:
            place(child)
        if fed:
            rows[node] = sum(rows[child] for child in fed) / len(fed)
        else:
            rows[node] = slot[0] * 3
            slot[0] += 1

    for root in roots:
        place(root)
    for node in sorted(consolation):
        above = [row for (column, _), row in rows.items() if column == node[0]]
        if above:
            rows[node] = max(above) + 4
        else:
            rows[node] = slot[0] * 3
            slot[0] += 1
    return rows, feeders


BRACKET_MIRROR = {"┐": "┌", "┌": "┐", "┘": "└", "└": "┘", "┤": "├", "├": "┤"}


class BracketCanvas:
    """A grid of (character, style) cells the brackets draw on (7.0.0): text
    put at a row and column, a ─ crossing a │ becoming ┼."""

    def __init__(self, width, height):
        self.width, self.height = width, height
        self.cells = [[(" ", "normal") for _ in range(width)] for _ in range(height)]

    def put(self, row, col, text, style):
        if not 0 <= row < self.height:
            return
        for offset, char in enumerate(text):
            if not 0 <= col + offset < self.width:
                continue
            old = self.cells[row][col + offset][0]
            if {old, char} == {"─", "│"}:
                char = "┼"
            self.cells[row][col + offset] = (char, style)

    def lines(self):
        out = []
        for row in self.cells:
            line = Line()
            for char, style in row:
                line.add(char, style)
            out.append(merge_spans(line))
        while out and not out[-1].text.strip():
            out.pop()
        return out


def bracket_box(canvas, row, x, box, entry, league, favorites, status=True):
    """One series (or game) of a bracket: its two teams a line each - seed,
    name, score and a ✓ for the winner - and its status under them."""
    decided = bool(series_winner(entry)) and not entry.get("projected")
    for which, offset in (("top", 0), ("bottom", 1)):
        spot = entry[which]
        team = spot.get("team") or {}
        if not team:
            continue
        seed = spot.get("seed")
        label = f"({seed}) " if seed not in (None, "") else ""
        known = real_team(team)
        abbr = (team.get("abbr") if known else "") or team.get("short") \
            or team.get("name") or "?"
        score = spot.get("score")
        text = f"{label}{abbr}"[: box - 5]
        style = THEME.style(league, team, bold=spot.get("winner"),
                            dim=decided and not spot.get("winner"),
                            fallback="normal") if known else "muted"
        star = fav_rank(favorites or {}, league, team) >= 0
        canvas.put(row + offset, x, ("★" if star else " ") + text, "star" if star else style)
        canvas.put(row + offset, x + box - 4, f"{'' if score is None else score:>3}",
                   "bold" if spot.get("winner") else style)
        if spot.get("winner") and not spot.get("projected"):
            canvas.put(row + offset, x + box - 1, "✓", "good")
    if status and entry.get("status"):
        canvas.put(row + 2, x, entry["status"][:box], "muted")


def bracket_two_sided(rounds, width, league, favorites=None):
    """MLB's postseason drawn as its own bracket is (7.0.0): the American
    League's rounds from the left edge in, the National League's from the
    right edge in, each series level with the two that fed it and wired to
    the one it feeds, the World Series between the pennant winners in the
    middle. None where it will not fit, or the rounds do not split by
    league - then bracket_layout draws it left to right."""
    named = {name: entries for name, entries in rounds}
    early = MLB_ROUNDS[:-1]
    halves = []
    for conference in ("AL", "NL"):
        halves.append([(name, [e for e in named.get(name, [])
                               if (e.get("conference") or "") == conference])
                       for name in early])
    if not all(any(entries for _, entries in half) for half in halves):
        return None
    finals = named.get(MLB_ROUNDS[-1], [])
    cols, gap = 7, 3
    box = min(24, (width - 2 - gap * (cols - 1)) // cols)
    if box < 15:
        return None
    step = box + gap
    offset = max(0, (width - (step * cols - gap)) // 2)
    placed = [bracket_rows(half) for half in halves]
    tallest = max([int(r) for rows, _ in placed for r in rows.values()] + [0])
    canvas = BracketCanvas(width, tallest + 7)

    def column_x(half, index):
        return offset + (index if half == 0 else cols - 1 - index) * step
    heads = {"Wild Card": "{} Wild Card", "Division Series": "{} Division Series",
             "Championship Series": "{}CS"}
    for half, conference in ((0, "AL"), (1, "NL")):
        rows, feeders = placed[half]
        rounds_ = halves[half]
        for index, (name, entries) in enumerate(rounds_):
            x = column_x(half, index)
            canvas.put(0, x, heads[name].format(conference)[:box].center(box), "header")
            for number, entry in enumerate(entries):
                bracket_box(canvas, int(rows[(index, number)]) + 2, x, box, entry, league,
                            favorites)
            if index + 1 >= len(rounds_):
                continue
            nx = column_x(half, index + 1)
            mid = (x + box + gap // 2) if half == 0 else (nx + box + gap // 2)
            for child in range(len(rounds_[index + 1][1])):
                fed = sorted(int(rows[node]) + 2 + (1 if rounds_[node[0]][1][node[1]][
                    "bottom"].get("winner") else 0)
                             for node in feeders.get((index + 1, child), []))
                if not fed:
                    continue
                end = int(rows[(index + 1, child)]) + 2
                low, high = min(fed + [end]), max(fed + [end])
                for row in range(low, high + 1):
                    joint = BRACKET_JOINTS.get((row > low, row < high, row in fed, row == end),
                                               "│")
                    canvas.put(row, mid, joint if half == 0 else
                               BRACKET_MIRROR.get(joint, joint), "border")
                for feeder in fed:
                    span = range(x + box, mid) if half == 0 else range(mid + 1, x)
                    for col in span:
                        canvas.put(feeder, col, "─", "border")
                span = range(mid + 1, nx) if half == 0 else range(nx + box, mid)
                for col in span:
                    canvas.put(end, col, "─", "border")
    # the World Series between the two pennant winners
    x = column_x(0, 3)
    canvas.put(0, x, "World Series"[:box].center(box), "header")
    pennants = []
    for half in (0, 1):
        rows, _ = placed[half]
        last = len(halves[half]) - 1
        entries = halves[half][last][1]
        if entries:
            entry = entries[0]
            pennants.append(int(rows[(last, 0)]) + 2 +
                            (1 if entry["bottom"].get("winner") else 0))
    ws_row = int(round(sum(pennants) / len(pennants))) if pennants else 2
    if finals:
        bracket_box(canvas, ws_row, x, box, finals[0], league, favorites)
    else:
        canvas.put(ws_row, x, " to be decided".ljust(box)[:box], "muted")
    for half, row in zip((0, 1), pennants):
        lcs_x = column_x(half, 2)
        if half == 0:
            for col in range(lcs_x + box, x - 1):
                canvas.put(row, col, "─", "border")
            canvas.put(row, x - 1, "─" if row == ws_row else "┐" if row < ws_row else "┘",
                       "border")
            for r in range(min(row, ws_row) + 1, max(row, ws_row)):
                canvas.put(r, x - 1, "│", "border")
        else:
            for col in range(x + box + 1, lcs_x):
                canvas.put(row, col, "─", "border")
            canvas.put(row, x + box, "─" if row == ws_row else "┌" if row < ws_row else "└",
                       "border")
            for r in range(min(row, ws_row) + 1, max(row, ws_row)):
                canvas.put(r, x + box, "│", "border")
    return canvas.lines()


def wcws_rounds(rounds):
    """The Women's College World Series's games by stage (7.0.0), worked out
    from each team's record going into each game: the opening round, the
    winners' games, the elimination games, the semifinals (a team without a
    loss against one with one, played again if the unbeaten side loses),
    then the finals. None without the eight teams' games."""
    named = {name: entries for name, entries in rounds}
    games = list(named.get("College World Series") or [])
    if len(games) < 4:
        return None
    finals, seen = [], set()
    for game in named.get("Finals") or []:
        if "advances" in (game.get("status") or "").lower():
            games.append(game)       # a semifinal ESPN notes as sending a team on
            continue
        key = (tuple(sorted(series_teams(game))), game["top"].get("score"),
               game["bottom"].get("score"), game.get("status"))
        if key not in seen:          # ESPN lists some finals games twice
            seen.add(key)
            finals.append(game)
    record, stages = {}, {}
    for game in games:
        teams = series_teams(game)
        if len(teams) < 2:
            continue
        a, b = teams[:2]
        ra, rb = record.get(a, [0, 0]), record.get(b, [0, 0])
        if ra == [0, 0] and rb == [0, 0]:
            stage = "Opening"
        elif ra[1] == 0 and rb[1] == 0:
            stage = "Winners"
        elif (ra[1] == 0) != (rb[1] == 0) and ra[0] + rb[0] >= 3:
            stage = "Semifinals"
        elif ra[1] == 1 and rb[1] == 1 and ra[0] >= 2 and rb[0] >= 2:
            stage = "Semifinals"          # the if-necessary game
        else:
            stage = "Elimination"
        # the column names the stage, so the game's own note goes
        stages.setdefault(stage, []).append(dict(game, status=""))
        winner = series_winner(game)
        for key in (a, b):
            row = record.setdefault(key, [0, 0])
            row[0 if key == winner else 1] += 1
    order = ["Opening", "Winners", "Elimination", "Semifinals"]
    out = [(name, stages[name]) for name in order if stages.get(name)]
    if finals:
        out.append(("Finals", finals))
    return out or None


def cws_bracket(rounds, width, league, favorites=None):
    """College baseball's Men's College World Series drawn as its brackets
    are (7.0.0): two four-team double-elimination brackets - the opening
    games, the winners' game, the elimination games, the bracket final -
    each game wired to the next, the championship final's games between
    them and the champion. None without the eight teams' games."""
    named = {name: entries for name, entries in rounds}
    games = list(named.get("College World Series") or [])
    finals = list(named.get("Finals") or [])
    if len(games) < 4:
        return None
    # the two brackets: the teams that played each other
    links = {}
    for game in games:
        a, b = series_teams(game)[:2] if len(series_teams(game)) >= 2 else (None, None)
        if a and b:
            links.setdefault(a, set()).add(b)
            links.setdefault(b, set()).add(a)
    groups, seen = [], set()
    for key in links:
        if key in seen:
            continue
        stack, group = [key], set()
        while stack:
            node = stack.pop()
            if node in group:
                continue
            group.add(node)
            stack.extend(links.get(node, ()))
        seen |= group
        groups.append(group)
    if len(groups) != 2:
        return None

    def stages(group):
        """The bracket's games by stage, worked out from each team's record
        going into each game: (label, game) in the order played."""
        record, out = {}, []
        mine = [g for g in games if set(series_teams(g)) <= group]
        for game in mine:
            a, b = series_teams(game)[:2]
            ra, rb = record.get(a, [0, 0]), record.get(b, [0, 0])
            if ra[1] == 0 and rb[1] == 0 and ra[0] == 0 and rb[0] == 0:
                label = "Opening"
            elif ra[1] == 0 and rb[1] == 0:
                label = "Winners"
            elif ra[1] == 1 and rb[1] == 1:
                label = "Elimination"
            elif ra[1] == 1 and rb[1] == 1 and ra[0] + rb[0] == 0:
                label = "Elimination"
            elif ra[1] + rb[1] == 1 and ra[0] + rb[0] >= 3:
                label = "Bracket final"
            elif ra[1] + rb[1] == 2 and ra[0] >= 2 and rb[0] >= 2:
                label = "Final, again"
            else:
                label = "Elimination"
            out.append((label, game))
            winner = series_winner(game)
            for key in (a, b):
                row = record.setdefault(key, [0, 0])
                row[0 if key == winner else 1] += 1
        return out
    box = 18
    column_w = box + 3
    blocks = []
    for number, group in enumerate(groups):
        played = stages(group)
        canvas = BracketCanvas(column_w * 3, 20)
        canvas.put(0, 0, f"Bracket {number + 1}", "title")
        slots = {"Opening": [(2, 0), (6, 0)], "Winners": [(4, 1)],
                 "Elimination": [(11, 0), (11, 1)], "Bracket final": [(7, 2)],
                 "Final, again": [(11, 2)]}
        used = {}
        spots = {}
        for label, game in played:
            places = slots.get(label) or []
            index = used.get(label, 0)
            if index >= len(places):
                continue
            used[label] = index + 1
            row, col = places[index]
            canvas.put(row - 1, col * column_w, label if index == 0 or label == "Opening"
                       else label, "muted")
            bracket_box(canvas, row, col * column_w, box, game, league, favorites,
                        status=False)
            spots[(label, index)] = (row, col)

        def winner_row(spot):
            """The row a game's winner leaves it on."""
            label, index = spot
            game = [g for lab, g in played if lab == label][index]
            return spots[spot][0] + (1 if game["bottom"].get("winner") else 0)

        def wire(sources, target):
            """Each source game's winner wired into the target game: across,
            down or up the gap, and across into it; the joints joined."""
            sources = [spot for spot in sources if spot in spots]
            if target not in spots or not sources:
                return
            r1, c1 = spots[target]
            mid = None
            rows_from = []
            for spot in sources:
                r0, c0 = spots[spot]
                out_row = winner_row(spot)
                mid = c0 * column_w + box + 1
                for col in range(c0 * column_w + box, mid):
                    canvas.put(out_row, col, "─", "border")
                rows_from.append(out_row)
            low, high = min(rows_from + [r1]), max(rows_from + [r1])
            for r in range(low, high + 1):
                up, down = r > low, r < high
                into = r in rows_from          # a wire comes in from the left
                out = r == r1                  # the wire leaves to the right
                canvas.put(r, mid, BRACKET_JOINTS.get((up, down, into, out), "│"), "border")
            for col in range(mid + 1, c1 * column_w):
                canvas.put(r1, col, "─", "border")
        wire([("Opening", 0), ("Opening", 1)], ("Winners", 0))
        wire([("Elimination", 0)], ("Elimination", 1))
        wire([("Winners", 0), ("Elimination", 1)], ("Bracket final", 0))
        blocks.append(canvas.lines())
    middle = [Line().add("Championship final", "title"), blank()]
    for index, game in enumerate(finals[:3]):
        middle.append(Line().add(f"Game {index + 1}", "muted"))
        canvas = BracketCanvas(box, 2)
        bracket_box(canvas, 0, 0, box, game, league, favorites, status=False)
        middle.extend(canvas.lines())
        middle.append(blank())
    champion = champion_line([("Finals", finals)], league) if finals else None
    if champion:
        middle.append(champion)
    if width >= column_w * 6 + box + 8:
        return flow_columns([blocks[0], middle, blocks[1]], width) if "flow_columns" in \
            globals() else None
    return blocks[0] + [blank()] + blocks[1] + [blank()] + middle


def bracket_layout(rounds, width, league, favorites=None, connect=True):
    """Draw the rounds as columns, each series wired to the one it feeds.

    A series sits level with the two it came from, so a team's run reads
    left to right across the page. MLB's postseason is drawn from both edges
    in, the World Series in the middle, and the College World Series as its
    two double-elimination brackets, where they fit (7.0.0).
    """
    if not rounds:
        return []
    special = None
    try:
        if league == "mlb":
            special = bracket_two_sided(rounds, width, league, favorites)
        elif league in ("cbase", "csoft"):
            special = cws_bracket(rounds, width, league, favorites)
    except Exception:  # noqa: BLE001 - the plain bracket stands in
        special = None
    if special:
        return special
    if league == "csoft":
        # 7.0.0: the Women's College World Series crosses its two brackets
        # over after the winners' games, so it is drawn stage by stage
        rounds, connect = wcws_rounds(rounds) or rounds, False
    favorites = favorites or {}
    columns = len(rounds)
    gap = 4
    box = clamp((width - 2) // columns - gap, 15, 26)
    step = box + gap

    rows, feeders = bracket_rows(rounds, connect)
    height = int(max(rows.values(), default=0)) + 5
    canvas = [[(" ", "normal") for _ in range(width)] for _ in range(height)]

    joints = set("─│┌┐└┘├┤┬┴┼")

    def put(row, col, text, style):
        if not 0 <= row < height:
            return
        for offset, char in enumerate(text):
            if not 0 <= col + offset < width:
                continue
            old = canvas[row][col + offset][0]
            if {old, char} == {"─", "│"}:
                char = "┼"
            canvas[row][col + offset] = (char, style)

    for column, (name, entries) in enumerate(rounds):
        x = column * step
        put(0, x, name[:box].center(box), "header")
        for index, entry in enumerate(entries):
            row = int(rows[(column, index)]) + 2
            decided = bool(series_winner(entry)) and not entry.get("projected")
            for which, offset in (("top", 0), ("bottom", 1)):
                spot = entry[which]
                team = spot.get("team") or {}
                if not team:
                    continue
                seed = spot.get("seed")
                label = f"({seed}) " if seed not in (None, "") else ""
                known = real_team(team)
                abbr = (team.get("abbr") if known else "") or team.get("short") \
                    or team.get("name") or "?"
                score = spot.get("score")
                text = f"{label}{abbr}"[: box - 4]
                style = THEME.style(league, team, bold=spot.get("winner"),
                                    dim=decided and not spot.get("winner"),
                                    fallback="normal") if known else "muted"
                star = fav_rank(favorites, league, team) >= 0
                put(row + offset, x, ("★" if star else " ") + text,
                    "star" if star else style)
                put(row + offset, x + 1 + len(text), "", style)
                put(row + offset, x + box - 4,
                    f"{'' if score is None else score:>3}",
                    "bold" if spot.get("winner") else style)
                if spot.get("winner") and not spot.get("projected"):
                    put(row + offset, x + box - 1, "✓", "good")
            if entry.get("status") and row + 2 < height:
                put(row + 2, x, entry["status"][: box], "muted")

        if column + 1 >= columns or not connect:
            continue
        # wire each series in the next round back to the ones that fed it
        mid = x + box + gap // 2
        for child in range(len(rounds[column + 1][1])):
            # each wire leaves from the winner's line of the series that fed it
            fed = sorted(int(rows[node]) + 2
                         + (1 if rounds[node[0]][1][node[1]]["bottom"].get("winner") else 0)
                         for node in feeders.get((column + 1, child), []))
            if not fed:
                continue
            end = int(rows[(column + 1, child)]) + 2
            low, high = min(fed + [end]), max(fed + [end])
            for row in range(low, high + 1):
                put(row, mid, BRACKET_JOINTS.get((row > low, row < high, row in fed,
                                                  row == end), "│"), "border")
            for feeder in fed:
                for col in range(x + box, mid):
                    put(feeder, col, "─", "border")
            for col in range(mid + 1, x + step):
                put(end, col, "─", "border")

    lines = []
    for row in canvas:
        line = Line()
        for char, style in row:
            line.add(char, style)
        lines.append(merge_spans(line))
    while lines and not lines[-1].text.strip():
        lines.pop()
    return lines


def milb_champion_lines(level, rounds, league):
    """♛ each champion of one MiLB level (7.0.0): Triple-A's national
    champion, or each league's at the levels below - the last round's
    winners."""
    lines = []
    name, entries = rounds[-1] if rounds else ("", [])
    for entry in entries:
        for which in ("top", "bottom"):
            spot = entry[which]
            team = spot.get("team") or {}
            if not spot.get("winner") or not team:
                continue
            title = level if name == "Final" else (entry.get("conference") or level)
            line = Line().add("♛ ", "medalgold")
            line.add(team.get("name") or team.get("abbr") or "?",
                     THEME.style(league, team, bold=True, fallback="accent"))
            lines.append(line.add(f"  {title} champions", "dim"))
    return lines


def champion_line(rounds, league):
    """♛ and the champion, once the last round is decided."""
    if not rounds:
        return None
    if league == "csoft":
        rounds = wcws_rounds(rounds) or rounds     # the finals alone, not the semis
    name, entries = rounds[-1]
    if is_olympic(league):
        entries = [e for e in entries if e.get("round") == "Gold"]
        name = "Olympic gold"
    elif league in ("cbase", "csoft") and name == "Finals":
        name = f"{CHAMPIONSHIP_NAME[league]} champions"
    else:
        name = f"{name} winner"
    wins, teams = {}, {}
    for entry in entries:
        for which in ("top", "bottom"):
            spot = entry[which]
            key = team_key(spot.get("team"))
            if key and spot.get("winner"):
                wins[key] = wins.get(key, 0) + 1
                teams[key] = spot["team"]
    # one series, or a final played as single games (best of three; the
    # College World Series' finals always are, however many are in yet)
    need = 1 if len(entries) == 1 and league not in ("cbase", "csoft") else 2
    champion = next((key for key, count in wins.items() if count >= need), None)
    if not champion:
        return None
    team = teams[champion]
    line = Line().add("♛ ", "medalgold")
    line.add(team.get("name") or team.get("abbr") or "?",
             THEME.style(league, team, bold=True, fallback="accent"))
    line.add(f"  {name}", "dim")
    return line


POLL_TOP = ("cfp", "ap", "usa")      # the polls of the top division, first


def poll_block(poll, league, favorites, field=0, name_w=16, count=25):
    """One poll as a single column: its name and week, then its top `count`,
    each with how far it moved since the last poll (▲ ▼, new), a favourite's
    star, the team in its colours and its record; a rule under the last team
    in the playoff `field`."""
    ranks = [r for r in poll.get("ranks") or [] if isinstance(r.get("current"), int)]
    if not ranks:
        return []
    name = clean(poll.get("name") or poll.get("shortName") or "Poll")
    lines = [Line().add(name, "title"),
             Line().add(clean(dig(poll, "occurrence", "displayValue", default="")) +
                        (f" · top {count}" if count < len(ranks) else ""), "muted")]
    for row in ranks[:count]:
        team = {"id": str(dig(row, "team", "id", default="")),
                "abbr": clean(dig(row, "team", "abbreviation", default="")),
                "name": clean(dig(row, "team", "name", default="")),
                "short": clean(dig(row, "team", "shortDisplayName", default="")),
                "location": clean(dig(row, "team", "location", default="")),
                "color": clean(dig(row, "team", "color", default=""))}
        rank, before = row["current"], row.get("previous")
        inside = not field or rank <= field
        line = Line().add(f"{rank:>2} ", "accent" if inside else "muted")
        if isinstance(before, int) and before > 0 and before != rank:
            line.add(f"{'▲' if before > rank else '▼'}{abs(before - rank):<2}",
                     "good" if before > rank else "bad")
        elif before == 0:
            line.add("new", "accent")
        else:
            line.add("   ", "normal")
        star = fav_rank(favorites, league, team) >= 0
        line.add("★" if star else " ", "star" if star else "normal")
        line.add(f"{standings_name(league, team)[:name_w]:<{name_w + 1}}",
                 THEME.style(league, team, bold=inside, dim=not inside))
        line.add(clean(row.get("recordSummary") or ""), "normal")
        lines.append(line)
        if field and rank == field and count > field:
            lines.append(Line().add("┄" * (8 + name_w + 5), "border"))
    return lines


def render_ranking_picture(data, league, width, favorites, field=12):
    """College football has no seeds until December, so the poll stands in for
    the playoff field: the committee's (or the first poll's) top 25 in a
    column, the playoff field ruled off, and beside it the other polls of the
    top division (the AP, the coaches'), as many as fit across. (The lower
    divisions' polls, under them in 6.21.0, are gone in 6.22.0.)"""
    polls = [p for p in dig(data, "rankings", default=[]) or [] if p.get("ranks")]
    if not polls:
        return []
    top = [p for p in polls if p.get("type") in POLL_TOP] or polls[:1]
    count = max(1, min(len(top), (width + 4) // 35))
    name_w = clamp((width + 4) // count - 4 - 13, 12, 22)
    blocks = [poll_block(poll, league, favorites, field if index == 0 else 0, name_w)
              for index, poll in enumerate(top[:count])]
    return flow_columns([b for b in blocks if b], width)


# how many make the postseason from each group, and where the cut lines go
# (the NBA's 7 to 10 play in for the last two spots)
PICTURE_CUTS = {"nfl": [(7, "")], "nhl": [(8, "")], "mlb": [(6, "")],
                "cfb": [(12, "")], "cbase": [(8, "")], "nba": [(6, "play-in"), (10, "")]}


def render_playoff_picture(data, league, width, favorites):
    """Before the postseason starts: who would be in, by seed, conference by
    conference (division by division in the AHL, whose playoffs run that way)."""
    if not isinstance(data, dict):
        return [Line().add("No standings to build a playoff picture from.", "dim")]
    root = data
    if "content" in data:
        root = dig(data, "content", "standings", default=data) or data
    groups = []
    walk_standings(root, [], groups)
    if not groups:
        return [Line().add("No standings to build a playoff picture from.", "dim")]
    hockey = LEAGUES[league]["sport"] == "hockey"
    seeded = {}
    for title, entries in groups:
        parts = title.split(" — ")
        # the conference, not the division: the seeds run conference-wide
        conference = parts[-1] if league == "ahl" or len(parts) < 3 else parts[-2]
        for entry in entries:
            table = stat_lookup(entry)
            try:
                seed = int(stat_display(table, ["playoffSeed"]))
            except (TypeError, ValueError):
                continue
            wins, losses = stat_display(table, ["wins"]), stat_display(table, ["losses"])
            record = f"{wins}-{losses}" if wins != "-" else ""
            if hockey and record:
                extra = [stat_display(table, ["otLosses", "OTL"])]
                if league == "ahl":
                    extra.append(stat_display(table, ["shootoutLosses", "SOL"]))
                record += "".join(f"-{x}" for x in extra if x not in ("", "-"))
            elif record:
                ties = stat_display(table, ["ties"])
                if ties not in ("", "-", "0"):
                    record += f"-{ties}"
            points = stat_display(table, ["points"]) if hockey else ""
            seeded.setdefault(conference, []).append(
                (seed, entry_team(entry), record, points, stat_display(table, ["streak"])))
    if not seeded:
        return []
    blocks = []
    for conference, rows in seeded.items():
        cuts = PICTURE_CUTS.get(league, [(8, "")])
        if league == "ahl":
            cuts = [(next((n for key, n in AHL_PLAYOFF_SPOTS.items() if key in conference),
                          5), "")]
        last = cuts[-1][0]
        rows.sort(key=lambda row: row[0])
        block = [Line().add("── ", "subborder").add(f"{conference} ", "title")]
        for seed, team, record, points, streak in rows[: last + 4]:
            line = Line()
            inside = seed <= last
            line.add(f" {seed:>2} ", "accent" if inside else "muted")
            star = fav_rank(favorites, league, team) >= 0
            line.add("★" if star else " ", "star" if star else "normal")
            name = standings_name(league, team)
            line.add(f"{name[:22]:<23}", THEME.style(league, team, bold=inside,
                                                     dim=not inside))
            line.add(f"{record:<10}", "normal" if inside else "dim")
            if hockey:
                line.add(f"{points + ' pts' if points not in ('', '-') else '':<8}",
                         "normal" if inside else "dim")
            line.add(streak if streak != "-" else "", "dim")
            block.append(line)
            for spot, label in cuts:
                if seed == spot:
                    rule_text = f" {label} " if label else ""
                    dashes = (45 if hockey else 37) - len(rule_text)
                    block.append(Line().add("    " + "┄" * (dashes // 2) + rule_text
                                            + "┄" * (dashes - dashes // 2), "border"))
        blocks.append(block)
    return flow_columns(blocks, width)


