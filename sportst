def sd(key, label, short, group, better, *sources, per_game=False, fmt=None, vs=None):
    """One stat definition. sources are tried in order:
         ("espn", category, name, "own" | "opp")
         ("st", standings stat name)
         ("x", key in the extra source's values)"""
    return {"key": key, "label": label, "short": short, "group": group,
            "better": better, "sources": [list(s) for s in sources],
            "per_game": per_game, "fmt": fmt, "vs": vs}


