# -- number parsing -------------------------------------------------------


def _num(value):
    if value in (None, ""):
        return None
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return float(value)
    text = str(value).strip().lower().replace(",", "").rstrip("%")
    if text in ("", "-", "--", "—"):
        return None
    if text in ("pk", "pick", "pick'em", "pickem", "ev", "even"):
        return 0.0
    text = text.lstrip("ou").replace("½", ".5")
    try:
        return float(text)
    except ValueError:
        return None


def _american(value):
    """American odds from 130, -155.0, "+130", "EVEN". None when absent."""
    if value in (None, ""):
        return None
    if isinstance(value, str) and value.strip().lower() in ("even", "ev"):
        return 100
    number = _num(value)
    if number is None or number == 0:
        return None
    return int(round(number))


def money_text(value):
    if value is None:
        return "-"
    return f"+{value}" if value > 0 else str(value)


def number_text(value):
    if value is None:
        return "-"
    return f"{value:g}"


def implied(american):
    """Win probability an American price implies, vig included."""
    if american is None or american == 0:
        return None
    if american < 0:
        return (-american) / ((-american) + 100.0)
    return 100.0 / (american + 100.0)


def no_vig(away_ml, home_ml):
    """(away, home) probabilities with the bookmaker's margin taken out."""
    a, h = implied(away_ml), implied(home_ml)
    if a is None or h is None or a + h <= 0:
        return None, None
    return a / (a + h), h / (a + h)


