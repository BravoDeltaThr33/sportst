                spots = [n - 2 for n in getattr(self, "_stats_row_lines", [])]
                line_at = spots[chosen] if chosen < len(spots) else chosen
                # scrolling up shows the headings above the team as well
                above = spots[chosen - 1] + 1 if 0 < chosen < len(spots) + 1 else 0
                if min(above, line_at) < self.scroll[key]:
                    self.scroll[key] = min(above, line_at)
                elif line_at >= self.scroll[key] + view_rows:
                    self.scroll[key] = line_at - view_rows + 1
