def _build_xterm_palette():
    """Indices 16-255: the 6x6x6 colour cube and the 24-step grey ramp.

    The first sixteen are skipped on purpose. Terminal themes redefine them,
    so a team colour mapped onto one would come out whatever the user's
    scheme says rather than what the team actually wears.
    """
    palette = []
    for r in _CUBE_LEVELS:
        for g in _CUBE_LEVELS:
            for b in _CUBE_LEVELS:
                palette.append((r, g, b))
    grey = [(8 + 10 * i,) * 3 for i in range(24)]
    return palette + grey


_XTERM = _build_xterm_palette()

_BASIC = [
    (0, (0, 0, 0)), (1, (170, 0, 0)), (2, (0, 170, 0)), (3, (170, 85, 0)),
    (4, (0, 0, 170)), (5, (170, 0, 170)), (6, (0, 170, 170)), (7, (170, 170, 170)),
    (8, (85, 85, 85)), (9, (255, 85, 85)), (10, (85, 255, 85)), (11, (255, 255, 85)),
    (12, (85, 85, 255)), (13, (255, 85, 255)), (14, (85, 255, 255)), (15, (255, 255, 255)),
]


def hex_to_rgb(value):
    value = str(value).strip().lstrip("#")
    if len(value) == 3:
        value = "".join(c * 2 for c in value)
    if not re.fullmatch(r"[0-9a-fA-F]{6}", value or ""):
        return None
    return (int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16))


def luminance(rgb):
    r, g, b = rgb
    return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0


def lift(rgb, floor=0.62):
    """Raise a colour until it is legible on a dark background, keeping its hue.

    The measure is the strongest channel, not relative luminance. Pure red is
    perfectly readable on black but its luminance is only 0.21, so a luminance
    floor would scale every maroon up into the same blown-out red. Scaling all
    three channels by one factor moves the colour away from the background
    while leaving the hue alone: navy stays navy, Aggie maroon stays maroon.
    Black has no hue to preserve, so it becomes a light grey.
    """
    if floor <= 0:
        return rgb
    peak = max(rgb) / 255.0
    if peak >= floor:
        return rgb
    if max(rgb) < 12:
        level = int(255 * min(1.0, floor + 0.14))
        return (level, level, level)
    scale = (floor * 255.0) / max(rgb)
    return tuple(min(255, int(round(c * scale))) for c in rgb)


def color_distance(a, b):
    return 2 * (a[0] - b[0]) ** 2 + 4 * (a[1] - b[1]) ** 2 + 3 * (a[2] - b[2]) ** 2


def darken(rgb, factor=0.62, floor=0.62):
    """Knock a colour back, for the plain-text output where colour is free."""
    faded = tuple(max(0, int(round(c * factor))) for c in rgb)
    return lift(faded, floor * 0.76)


def _nearest(rgb, candidates):
    r, g, b = rgb
    best_index, best_distance = 0, None
    for index, (cr, cg, cb) in candidates:
        # weighted to match how the eye reads the channels
        distance = 2 * (r - cr) ** 2 + 4 * (g - cg) ** 2 + 3 * (b - cb) ** 2
        if best_distance is None or distance < best_distance:
            best_index, best_distance = index, distance
    return best_index


def nearest_xterm(rgb):
    return _nearest(rgb, enumerate(_XTERM, start=16))


def nearest_basic(rgb, depth=16):
    return _nearest(rgb, [(i, c) for i, c in _BASIC if i < depth])


def style_for(hex_color, selected=False, bold=False, dim=False, fallback="normal"):
    """Build the style token the renderers pass around.

    A token starting with '#' carries a colour; anything else is a named style
    from the base palette. Modifiers ride after a tilde: b bold, s selected
    background, d darkened.
    """
    if not hex_color:
        if selected:
            return "sel"
        return fallback
    mods = ""
    if bold:
        mods += "b"
    if selected:
        mods += "s"
    if dim:
        mods += "d"
    return f"{hex_color}~{mods}" if mods else hex_color


