CRT_STANDARD = 5            # every effect's level as it comes
CRT_LEVEL_TOP = 10
CRT_LEVELS = {}             # the levels in use; an effect missing is at the standard
# Since 6.8.1 the glass's standard is the owner's own setting from 6.8.0:
# the grille, bloom, soft focus, fringes and grain at 2 of 6.8.0's 10 and
# the hum bar at 1, which drew them at these shares of 6.8.0's standard. A
# config written by 6.8.0 (every effect listed, no "scale") has its levels
# for these moved onto the new scale, so the screen looks as it did.
CRT_SCALE = 2
CRT_EFFECTS_680 = ("blacks", "power", "trails", "burn", "slips", "scanlines", "grille",
                   "bloom", "focus", "fringes", "vignette", "grain", "flicker", "hum")
CRT_RESCALED = {"grille": 0.4, "bloom": 0.4, "focus": 0.4, "fringes": 0.4, "grain": 0.4,
                "hum": 0.2}


def crt_levels(raw):
    """Every effect's level from config.json's "crt_levels": a whole number
    from 0 to 10, the standard for one missing or unreadable (and 6.8.0's
    levels on today's scale; a config from before 6.10.0, when the glare
    came with the curve, has Glare at its Curvature level)."""
    raw = raw if isinstance(raw, dict) else {}
    old = "scale" not in raw and all(key in raw for key in CRT_EFFECTS_680) and \
        any(raw.get(key) != CRT_STANDARD for key in CRT_RESCALED)
    out = {}
    for key, *_ in CRT_EFFECTS:
        value = raw.get(key, CRT_STANDARD)
        if key == "glare" and key not in raw and "curve" in raw:
            value = raw["curve"]
        try:
            level = CRT_STANDARD if isinstance(value, bool) else float(value)
            if old and key in CRT_RESCALED:
                level /= CRT_RESCALED[key]
            level = int(round(level))
        except (TypeError, ValueError, OverflowError):
            level = CRT_STANDARD
        out[key] = max(0, min(CRT_LEVEL_TOP, level))
    return out


def crt_levels_saved(levels):
    """Levels as config.json keeps them: every effect, and the scale."""
    out = {key: levels.get(key, CRT_STANDARD) for key, *_ in CRT_EFFECTS}
    out["scale"] = CRT_SCALE
    return out


def crt_amount(key):
    """An effect's strength as a share of the standard: 0 off, 1 the
    standard, 2 the most."""
    return CRT_LEVELS.get(key, CRT_STANDARD) / CRT_STANDARD


def crt_black(spec, amount=None):
    """A phosphor's raised black at the Raised blacks level (or `amount`)."""
    amount = crt_amount("blacks") if amount is None else amount
    return tuple(min(255, round(c * amount)) for c in spec[1])


CRT_EFFECT_INFO = {key: (label, layer, text) for key, label, layer, text in CRT_EFFECTS}


def crt_levels_summary(raw):
    """(the CRT effects' levels in a few words, whether any differs from the
    default), for the Settings row: "the default", or how many are changed
    and how many are off."""
    levels = crt_levels(raw)
    default = crt_levels(DEFAULT_CONFIG["crt_levels"])
    off = sum(1 for key, level in levels.items() if level == 0 and default.get(key) != 0)
    changed = sum(1 for key, level in levels.items()
                  if level != default.get(key) and level != 0)
    if not off and not changed:
        return "the default", False
    parts = ([f"{changed} changed"] if changed else []) + ([f"{off} off"] if off else [])
    return " · ".join(parts), True


def crt_level_word(level):
    return {0: "off", CRT_STANDARD: "standard", CRT_LEVEL_TOP: "most"}.get(level, "")


