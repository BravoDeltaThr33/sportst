# how much each estimate of the margin counts; missing ones drop out
WEIGHTS = {"market": 0.55, "kalshi": 0.15, "espn": 0.15, "stats": 0.15}
TOTAL_STATS_WEIGHT = 0.2
# the season numbers that make a team's points for and against
SCORING_KEYS = {"football": ("pts", "pa"), "basketball": ("ppg", "opp_ppg"),
                "hockey": ("gf", "ga"), "baseball": ("rpg", "rapg")}


# -- normal distribution ----------------------------------------------------

def norm_cdf(x):
    return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))


def norm_ppf(p):
    """Inverse of norm_cdf (Acklam's rational approximation)."""
    p = clamp(p, 1e-6, 1 - 1e-6)
    a = (-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02,
         1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00)
    b = (-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02,
         6.680131188771972e+01, -1.328068155288572e+01)
    c = (-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00,
         -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00)
    d = (7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00,
         3.754408661907416e+00)
    low = 0.02425
    if p < low:
        q = math.sqrt(-2 * math.log(p))
        return (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / \
            ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1)
    if p > 1 - low:
        return -norm_ppf(1 - p)
    q = p - 0.5
    r = q * q
    return (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q / \
        (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1)


def decimal_odds(american):
    if american is None or american == 0:
        return None
    return 1 + (american / 100.0 if american > 0 else 100.0 / -american)


def american_from_prob(p):
    if p is None or p <= 0 or p >= 1:
        return None
    if p >= 0.5:
        return int(round(-100 * p / (1 - p)))
    return int(round(100 * (1 - p) / p))


def half_round(value):
    return round(value * 2) / 2 if value is not None else None


# -- Action Network ---------------------------------------------------------

def an_book_ids():
    return ",".join(str(i) for i in [CONSENSUS_BOOK, OPEN_BOOK] + [b[0] for b in BOOKS])


def _an_side_line(markets):
    """One book's game line from Action Network's v2 markets block."""
    event = (markets or {}).get("event") or {}
    line = {"spread": None, "spread_home_price": None, "spread_away_price": None,
            "total": None, "over_price": None, "under_price": None,
            "away_ml": None, "home_ml": None}
    public = {}
    for outcome in event.get("spread") or []:
        side = outcome.get("side")
        if side == "home":
            line["spread"] = _num(outcome.get("value"))
            line["spread_home_price"] = _american(outcome.get("odds"))
        elif side == "away":
            line["spread_away_price"] = _american(outcome.get("odds"))
            if line["spread"] is None and _num(outcome.get("value")) is not None:
                line["spread"] = -_num(outcome.get("value"))
        public[("spread", side)] = _an_bet_info(outcome)
    for outcome in event.get("total") or []:
        side = outcome.get("side")
        if side in ("over", "under"):
            line["total"] = _num(outcome.get("value"))
            line[side + "_price"] = _american(outcome.get("odds"))
        public[("total", side)] = _an_bet_info(outcome)
    for outcome in event.get("moneyline") or []:
        side = outcome.get("side")
        if side in ("away", "home"):
            line[side + "_ml"] = _american(outcome.get("odds"))
        public[("ml", side)] = _an_bet_info(outcome)
    if all(v is None for v in line.values()):
        return None, {}
    return line, public


def _an_bet_info(outcome):
    info = outcome.get("bet_info") or {}
    tickets = _num(dig(info, "tickets", "percent"))
    money = _num(dig(info, "money", "percent"))
    if not tickets and not money:
        return None
    return (tickets or 0.0, money or 0.0)


def an_board(league, timeout=15, day=None, week=None, season=None, seasontype=None):
    """Every game's lines at every book for one day (or football week)."""
    params = {"bookIds": an_book_ids()}
    if week:
        params["week"] = str(week)
        if season:
            params["season"] = str(season)
        params["seasonType"] = {1: "pre", 3: "post"}.get(seasontype, "reg")
    elif day:
        params["date"] = day.strftime("%Y%m%d")
    if league == "cfb":
        params["division"] = "FBS"
    elif league == "cbb":
        params["division"] = "D1"
    url = f"{AN_API}/{AN_LEAGUES[league]}?" + urllib.parse.urlencode(params)
    data = http_json(url, timeout)
    names = {book_id: name for book_id, name, _ in BOOKS}
    names.update({CONSENSUS_BOOK: "Consensus", OPEN_BOOK: "Open"})
    games = []
    for game in data.get("games") or []:
        teams = {team.get("id"): team for team in game.get("teams") or []}
        away, home = teams.get(game.get("away_team_id")), teams.get(game.get("home_team_id"))
        if not away or not home:
            continue
        books, public = {}, {}
        for book_id, markets in (game.get("markets") or {}).items():
            name = names.get(_int(book_id, -1))
            if not name:
                continue
            line, info = _an_side_line(markets)
            if line:
                line["book"] = name
                books[name] = line
            if name == "Consensus":
                public = {f"{k[0]}:{k[1]}": v for k, v in info.items() if v}

        def who(team):
            return {"name": team.get("full_name") or "", "location": team.get("location") or "",
                    "short": team.get("display_name") or "", "abbr": team.get("abbr") or ""}
        games.append({"id": game.get("id"), "start": game.get("start_time"),
                      "away": who(away), "home": who(home), "books": books,
                      "public": public, "num_bets": game.get("num_bets")})
    return {"games": games}


# -- Kalshi ------------------------------------------------------------------

_MONTHS = {m: i for i, m in enumerate(
    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}


def kalshi_board(league, timeout=15):
    """Kalshi's open game-winner markets: [{date, teams: [(name, abbr, prob)]}]."""
    url = f"{KALSHI_API}?" + urllib.parse.urlencode(
        {"series_ticker": KALSHI_SERIES[league], "status": "open", "limit": "1000"})
    data = http_json(url, timeout)
    events = {}
    for market in data.get("markets") or []:
        ticker = market.get("event_ticker") or ""
        match = re.search(r"-(\d\d)([A-Z]{3})(\d\d)", ticker)
        if not match or match.group(2) not in _MONTHS:
            continue
        try:
            day = Date(2000 + int(match.group(1)), _MONTHS[match.group(2)], int(match.group(3)))
        except ValueError:
            continue
        bid = _num(market.get("yes_bid_dollars"))
        ask = _num(market.get("yes_ask_dollars"))
        if not bid or not ask or ask - bid > 0.12:
            prob = None                    # too thin a market to read a price from
        else:
            prob = (bid + ask) / 2
        volume = _num(market.get("volume_fp")) or 0
        entry = events.setdefault(ticker, {"date": day.isoformat(), "teams": []})
        entry["teams"].append((market.get("yes_sub_title") or "",
                               (market.get("ticker") or "").rsplit("-", 1)[-1], prob, volume))
    out = []
    for entry in events.values():
        if len(entry["teams"]) != 2:
            continue
        probs = [t[2] for t in entry["teams"]]
        if None in probs or sum(probs) <= 0:
            continue
        total = sum(probs)
        entry["teams"] = [(n, a, p / total, v) for n, a, p, v in entry["teams"]]
        out.append(entry)
    return {"events": out}


# -- matching other feeds to ESPN's games ----------------------------------

def _team_keys(team):
    keys = set()
    for field in ("name", "location", "short"):
        value = norm_name(team.get(field) or "")
        if value:
            keys.add(value)
            keys.add(value.replace(" state", " st"))
    return keys


def _team_matches(espn_team, names, abbr=""):
    keys = _team_keys(espn_team)
    for name in names:
        value = norm_name(name)
        if value and (value in keys or value.replace(" state", " st") in keys):
            return True
    return bool(abbr) and abbr.upper() == str(espn_team.get("abbr", "")).upper()


def match_an_game(event, board):
    start = parse_iso(event.get("date"))
    for game in (board or {}).get("games") or []:
        when = parse_iso(game.get("start"))
        if start and when and abs((when - start).total_seconds()) > 36 * 3600:
            continue
        a, h = game["away"], game["home"]
        if _team_matches(event["away"], [a["name"], a["location"], a["short"]], a["abbr"]) and \
                _team_matches(event["home"], [h["name"], h["location"], h["short"]], h["abbr"]):
            return game
    return None


def match_kalshi(event, board):
    """The market's home-team win probability, or None."""
    start = parse_iso(event.get("date"))
    local = start.astimezone().date() if start else None
    for entry in (board or {}).get("events") or []:
        if local:
            try:
                gap = abs((Date.fromisoformat(entry["date"]) - local).days)
            except ValueError:
                continue
            if gap > 1:
                continue
        found = {}
        for name, abbr, prob, volume in entry["teams"]:
            for side in ("away", "home"):
                if _team_matches(event[side], [name], abbr):
                    found[side] = (prob, volume)
        if len(found) == 2:
            return found["home"][0], found["home"][1] + found["away"][1]
    return None


# -- one line out of many books ---------------------------------------------

def average_lines(lines):
    """The books' lines averaged: spreads and totals to the nearest half point,
    prices averaged as probabilities (so -110 and +100 make -105, not -5)."""
    lines = [l for l in lines if l]
    if not lines:
        return None
    out = {"book": "Avg " + "·".join(BOOK_SHORT.get(l["book"], l["book"]) for l in lines)}

    def mean(key, rounder=None):
        values = [l[key] for l in lines if l.get(key) is not None]
        if not values:
            return None
        value = sum(values) / len(values)
        return rounder(value) if rounder else value

    def mean_price(key):
        probs = [implied(l[key]) for l in lines if l.get(key) is not None]
        return american_from_prob(sum(probs) / len(probs)) if probs else None

    out["spread"] = mean("spread", half_round)
    out["total"] = mean("total", half_round)
    for key in ("spread_home_price", "spread_away_price", "over_price", "under_price",
                "away_ml", "home_ml"):
        out[key] = mean_price(key)
    return out


def espn_line_as_book(line):
    """An ESPN scoreboard line in the Betting tab's shape."""
    if not line:
        return None
    return {"book": line.get("provider") or "ESPN", "spread": line.get("spread"),
            "spread_home_price": None, "spread_away_price": None,
            "total": line.get("total"), "over_price": None, "under_price": None,
            "away_ml": line.get("away_ml"), "home_ml": line.get("home_ml")}


def market_home_prob(line, league):
    """The market's home win probability with the vig taken out."""
    if not line:
        return None
    away, home = no_vig(line.get("away_ml"), line.get("home_ml"))
    if home is not None:
        return home
    spread = line.get("spread")
    if spread is not None and league not in MONEYLINE_LEAGUES:
        return norm_cdf(-spread / MODEL.get(league, MODEL["nfl"])["sigma"])
    return None


# -- what ESPN's game summary adds -----------------------------------------

def _leader_names(summary, team_id):
    """{normalised short name: category} of a team's season leaders."""
    out = {}
    for block in (summary or {}).get("leaders") or []:
        if str(dig(block, "team", "id", default="")) != str(team_id):
            continue
        for category in block.get("leaders") or []:
            top = (category.get("leaders") or [None])[0]
            if not top:
                continue
            for key in ("shortName", "displayName"):
                name = dig(top, "athlete", key, default="")
                if name:
                    out[norm_name(name)] = (category.get("name") or
                                            category.get("displayName") or "").lower()
    return out


def _status_tag(status):
    low = (status or "").lower()
    for word, tag in (("injured reserve", "IR"), ("out", "out"), ("doubtful", "doubtful"),
                      ("questionable", "quest."), ("day-to-day", "DTD"), ("suspen", "susp.")):
        if word in low:
            return f"({tag})"
    return f"({low})" if low else ""


def _injury_weight(status):
    low = (status or "").lower()
    if "out" in low or "injured reserve" in low or low == "ir" or "suspen" in low:
        return 1.0
    if "doubtful" in low:
        return 0.75
    if "questionable" in low or "day-to-day" in low:
        return 0.3
    return 0.0


def injury_hits(summary, team, league):
    """(margin cost, [notes]) for a team's season leaders on the injury report."""
    cfg = MODEL.get(league) or {}
    if not summary or not cfg.get("star"):
        return 0.0, []
    leaders = _leader_names(summary, team.get("id"))
    if not leaders:
        return 0.0, []
    cost, notes = 0.0, []
    for status, name, position in summary_injuries(summary, team.get("id")):
        weight = _injury_weight(status)
        if not weight:
            continue
        key = norm_name(name)
        category = leaders.get(key)
        if category is None:
            continue
        passer = "pass" in category and position in ("QB", "")
        value = (cfg["qb"] if passer and cfg.get("qb") else cfg["star"]) * weight
        cost += value
        notes.append(f"{name} {_status_tag(status)}")
    return min(cost, cfg["cap"] + (cfg.get("qb") or 0)), notes


def _last_games(summary, team_id):
    for block in (summary or {}).get("lastFiveGames") or []:
        if str(dig(block, "team", "id", default="")) == str(team_id):
            return block.get("events") or []
    return []


def rest_days(summary, team, event):
    start = parse_iso(event.get("date"))
    latest = None
    for game in _last_games(summary, team.get("id")):
        when = parse_iso(game.get("gameDate"))
        if when and start and when < start and (latest is None or when > latest):
            latest = when
    if not latest or not start:
        return None
    return (start - latest).total_seconds() / 86400


def recent_margin(summary, team):
    margins = []
    for game in _last_games(summary, team.get("id")):
        home_id = str(game.get("homeTeamId") or "")
        hs, aw = _num(game.get("homeTeamScore")), _num(game.get("awayTeamScore"))
        if hs is None or aw is None:
            continue
        margins.append(hs - aw if home_id == str(team.get("id")) else aw - hs)
    return sum(margins) / len(margins) if margins else None


def weather_total_adjust(summary, league, event=None):
    if sport_of(league) != "football" or (event or {}).get("indoor"):
        return 0.0, ""
    weather = dig(summary, "gameInfo", "weather", default=None) or {}
    if not weather:
        return 0.0, ""
    gust = _num(weather.get("gust")) or 0
    wind = _num(weather.get("windSpeed")) or 0
    temp = _num(weather.get("temperature"))
    rain = _num(weather.get("precipitation")) or 0
    adjust, notes = 0.0, []
    blow = max(wind, gust * 0.75)
    if blow >= 18:
        adjust -= 3.0
        notes.append(f"wind {int(blow)} mph")
    elif blow >= 13:
        adjust -= 1.5
        notes.append(f"wind {int(blow)} mph")
    if temp is not None and temp <= 25:
        adjust -= 1.0
        notes.append(f"{int(temp)}°F")
    if rain >= 60:
        adjust -= 1.0
        notes.append(f"{int(rain)}% rain")
    return adjust, ", ".join(notes)


# -- sportst's projection ----------------------------------------------------

def _scoring(row, league, table):
    """(points for, points against, games) per game, shrunk toward the league
    average while the sample is small."""
    keys = SCORING_KEYS.get(sport_of(league), ("pf", "pa"))
    if league == "ahl" or is_olympic(league):
        keys = ("gf", "ga") if league == "ahl" else ("pf", "pa")
    values = (row or {}).get("values") or {}
    pf, pa = values.get(keys[0]), values.get(keys[1])
    if pa is None and league == "cbase" and values.get("era") is not None:
        pa = values["era"] * 1.1          # unearned runs on top of ERA
    if pf is None or pa is None:
        return None
    teams = (table or {}).get("teams") or []
    pool = [t["values"].get(keys[0]) for t in teams if t["values"].get(keys[0]) is not None]
    mean = sum(pool) / len(pool) if pool else (pf + pa) / 2
    games = _games_played(row)
    n0 = MODEL.get(league, MODEL["nfl"])["n0"]
    trust = games / (games + n0) if games else 0.5
    return (mean + (pf - mean) * trust, mean + (pa - mean) * trust, games, mean)


def _games_played(row):
    record = str((row or {}).get("record") or "").split(",")[0]
    numbers = [int(n) for n in re.findall(r"\d+", record)]
    return sum(numbers) if numbers else 0


def project_game(event, league, table, line, summary=None, kalshi=None, open_line=None,
                 public=None):
    """sportst's read on one game: a projected margin and total, the win and
    cover probabilities they imply, and the reasons."""
    cfg = MODEL.get(league, MODEL["nfl"])
    sigma, tsigma = cfg["sigma"], cfg["tsigma"]
    hfa = 0.0 if event.get("neutral") else cfg["hfa"]
    away, home = event["away"], event["home"]
    out = {"components": [], "adjust": [], "signals": [], "notes": []}

    # 1. the market
    p_market = market_home_prob(line, league)
    if line and line.get("spread") is not None and league not in MONEYLINE_LEAGUES:
        out["components"].append(("market", -line["spread"], "spread"))
    elif p_market is not None:
        out["components"].append(("market", sigma * norm_ppf(p_market), "moneyline"))
    out["p_market"] = p_market

    # 2. Kalshi
    if kalshi:
        out["components"].append(("kalshi", sigma * norm_ppf(kalshi[0]),
                                  f"{home['abbr']} {kalshi[0] * 100:.0f}%"))
        out["p_kalshi"] = kalshi[0]

    # 3. ESPN's predictor (FPI / BPI)
    projection = _num(dig(summary, "predictor", "homeTeam", "gameProjection", default=None))
    if projection is not None and 0 < projection < 100:
        p = projection / 100.0
        out["components"].append(("espn", sigma * norm_ppf(p), f"{home['abbr']} {projection:.0f}%"))
        out["p_espn"] = p

    # 4. season numbers, adjusted for what they cannot know
    a_row, h_row = find_team_row(table, away), find_team_row(table, home)
    a_sc, h_sc = _scoring(a_row, league, table), _scoring(h_row, league, table)
    stats_total = None
    if a_sc and h_sc:
        exp_home = (h_sc[0] + a_sc[1]) / 2 + hfa / 2
        exp_away = (a_sc[0] + h_sc[1]) / 2 - hfa / 2
        stats_margin = exp_home - exp_away
        stats_total = exp_home + exp_away
        adjust = 0.0
        for side, team, sign in (("away", away, 1), ("home", home, -1)):
            cost, names = injury_hits(summary, team, league)
            if cost:
                adjust += sign * cost
                more = f" +{len(names) - 2} more" if len(names) > 2 else ""
                out["adjust"].append((f"{team['abbr']} without {', '.join(names[:2])}{more}",
                                      sign * cost))
            days = rest_days(summary, team, event)
            if days is not None:
                out.setdefault("rest", {})[side] = days
                if days < 1.6 and cfg["b2b"]:
                    adjust += sign * cfg["b2b"]
                    out["adjust"].append((f"{team['abbr']} on a back-to-back", sign * cfg["b2b"]))
                elif days < 5.5 and cfg["short"]:
                    adjust += sign * cfg["short"]
                    out["adjust"].append((f"{team['abbr']} on a short week", sign * cfg["short"]))
                elif days >= 12.5 and cfg["bye"]:
                    adjust -= sign * cfg["bye"]
                    out["adjust"].append((f"{team['abbr']} off a bye", -sign * cfg["bye"]))
            recent = recent_margin(summary, team)
            row = a_sc if side == "away" else h_sc
            if recent is not None and row and row[2] >= 3:
                drift = clamp(0.15 * (recent - (row[0] - row[1])), -cfg["form"], cfg["form"])
                if abs(drift) >= cfg["form"] / 3:
                    adjust -= sign * drift
                    out["adjust"].append((f"{team['abbr']} form, last 5 {recent:+.1f}",
                                          -sign * drift))
        out["components"].append(("stats", stats_margin + adjust,
                                  f"{home['abbr']} {exp_home:.1f} - {away['abbr']} {exp_away:.1f}"))
        out["stats_margin"] = stats_margin

    if not out["components"]:
        return None
    weights = {name: WEIGHTS[name] for name, _, _ in out["components"]}
    scale = sum(weights.values())
    margin = sum(value * weights[name] / scale for name, value, _ in out["components"])
    out["weights"] = {name: weights[name] / scale for name in weights}
    out["margin"] = margin
    # probabilities start from the market's own (vig removed) and move only by
    # how far sportst's margin is from the market's
    m_market = next((v for n, v, _ in out["components"] if n == "market"), None)
    out["m_market"] = m_market
    out["market_line"] = line
    if p_market is not None and m_market is not None:
        out["p_home"] = norm_cdf(norm_ppf(p_market) + (margin - m_market) / sigma)
    else:
        out["p_home"] = norm_cdf(margin / sigma)

    # totals: the market's number moved toward the season numbers and weather
    market_total = (line or {}).get("total")
    weather_adj, weather_note = weather_total_adjust(summary, league, event)
    # the market already prices the forecast, so weather only moves the
    # season-numbers estimate, like injuries and rest do for the margin
    if market_total is not None and stats_total is not None:
        total = market_total + TOTAL_STATS_WEIGHT * (stats_total + weather_adj - market_total)
    elif market_total is not None:
        total = market_total + TOTAL_STATS_WEIGHT * weather_adj
    elif stats_total is not None:
        total = stats_total + weather_adj
    else:
        total = None
    out["total"] = total
    out["stats_total"] = stats_total
    if weather_note:
        out["adjust"].append((f"weather: {weather_note}", weather_adj))
    if total is not None:
        out["proj"] = (total / 2 - margin / 2, total / 2 + margin / 2)   # away, home

    # market signals: line movement, the public, sharp money
    out["signals"] = market_signals(event, league, line, open_line, public)
    return out


def market_signals(event, league, line, open_line, public):
    """[(market, side, text)] - moves and money that say something."""
    signals = []
    if not line:
        return signals
    away, home = event["away"]["abbr"], event["home"]["abbr"]
    if open_line:
        if league not in MONEYLINE_LEAGUES and line.get("spread") is not None and \
                open_line.get("spread") is not None:
            move = line["spread"] - open_line["spread"]           # + means toward away
            if abs(move) >= (1.5 if sport_of(league) == "football" else 1.0):
                toward = "away" if move > 0 else "home"
                signals.append(("spread", toward, f"spread moved {abs(move):g} toward "
                                f"{away if toward == 'away' else home} since the open"))
        a0, h0 = no_vig(open_line.get("away_ml"), open_line.get("home_ml"))
        a1, h1 = no_vig(line.get("away_ml"), line.get("home_ml"))
        if h0 is not None and h1 is not None and abs(h1 - h0) >= 0.04:
            toward = "home" if h1 > h0 else "away"
            signals.append(("ml", toward, f"moneyline moved {abs(h1 - h0) * 100:.0f} pts "
                            f"toward {home if toward == 'home' else away}"))
        if line.get("total") is not None and open_line.get("total") is not None:
            move = line["total"] - open_line["total"]
            if abs(move) >= (1.0 if sport_of(league) in ("football", "basketball") else 0.5):
                signals.append(("total", "over" if move > 0 else "under",
                                f"total moved {move:+g} since the open"))
    for market, sides in (("spread", ("away", "home")), ("ml", ("away", "home")),
                          ("total", ("over", "under"))):
        for side in sides:
            info = (public or {}).get(f"{market}:{side}")
            if not info:
                continue
            tickets, money = info
            label = {"away": away, "home": home}.get(side, side)
            if money - tickets >= 10 and money >= 50:
                signals.append((market, side, f"sharp money: {label} {market} has "
                                f"{money:.0f}% of the money on {tickets:.0f}% of bets"))
            if tickets >= 75:
                signals.append((market, "!" + side, f"public side: {tickets:.0f}% of "
                                f"{market} bets on {label}"))
    # reverse line movement: most bets one way, the line moving the other
    for market, sides in (("spread", ("away", "home")),):
        for side in sides:
            info = (public or {}).get(f"{market}:{side}")
            if not info or info[0] < 60:
                continue
            other = "home" if side == "away" else "away"
            if any(m == "spread" and s == other and "moved" in t for m, s, t in signals):
                label = away if other == "away" else home
                signals.append((market, other, f"reverse line move: {info[0]:.0f}% of bets "
                                f"on the other side, line moving to {label}"))
    return signals


def bet_options(event, league, model, books, mode, min_edge):
    """Every bet with its probability, price and expected value; the best
    price wins when mode is 'best'."""
    if not model:
        return []
    cfg = MODEL.get(league, MODEL["nfl"])
    sigma, tsigma = cfg["sigma"], cfg["tsigma"]
    margin, total = model["margin"], model.get("total")
    ref = model.get("market_line") or {}
    m_market = model.get("m_market")
    ref_spread, ref_total = ref.get("spread"), ref.get("total")
    # the market's own (no-vig) chance of a home cover and of the over
    pc_ref = no_vig(ref.get("spread_away_price"), ref.get("spread_home_price"))[1]
    po_ref = no_vig(ref.get("under_price"), ref.get("over_price"))[1]
    moneyline_sport = league in MONEYLINE_LEAGUES
    out = []
    for line in books:
        if not line:
            continue
        book = line.get("book", "")
        candidates = []
        p_home = model["p_home"]
        candidates.append(("ml", "home", None, line.get("home_ml"), p_home))
        candidates.append(("ml", "away", None, line.get("away_ml"), 1 - p_home))
        spread = line.get("spread")
        if spread is not None:
            p_cover = None
            if ref_spread is not None and m_market is not None:
                base = pc_ref if pc_ref is not None else (None if moneyline_sport else 0.5)
                if base is not None and (not moneyline_sport or spread == ref_spread):
                    p_cover = norm_cdf(norm_ppf(base) +
                                       (margin - m_market + (spread - ref_spread)) / sigma)
            elif not moneyline_sport:
                p_cover = norm_cdf((margin + spread) / sigma)
            if p_cover is not None:
                candidates.append(("spread", "home", spread,
                                   line.get("spread_home_price") or -110, p_cover))
                candidates.append(("spread", "away", -spread,
                                   line.get("spread_away_price") or -110, 1 - p_cover))
        if total is not None and line.get("total") is not None:
            if ref_total is not None:
                base = po_ref if po_ref is not None else 0.5
                p_over = norm_cdf(norm_ppf(base) + (total - line["total"]) / tsigma)
            else:
                p_over = 1 - norm_cdf((line["total"] - total) / tsigma)
            candidates.append(("total", "over", line["total"], line.get("over_price") or -110,
                               p_over))
            candidates.append(("total", "under", line["total"], line.get("under_price") or -110,
                               1 - p_over))
        for kind, side, number, price, p in candidates:
            dec = decimal_odds(price)
            if dec is None:
                continue
            ev = p * dec - 1
            out.append({"kind": kind, "side": side, "line": number, "price": price,
                        "book": book, "p": p, "ev": ev, "dec": dec})
    if mode == "best":
        best = {}
        for bet in out:
            key = (bet["kind"], bet["side"])
            if key not in best or bet["ev"] > best[key]["ev"]:
                best[key] = bet
        out = list(best.values())
    for bet in out:
        rate_bet(bet, event, model, min_edge)
    out.sort(key=lambda b: -b["ev"])
    return out


def rate_bet(bet, event, model, min_edge):
    """Stars (0-3) and a stake for one bet, from its edge and how many of the
    independent signals agree with it."""
    edge = min_edge / 100.0
    ev = bet["ev"]
    stars = 0
    if ev >= edge:
        stars = 1
    if ev >= 2 * edge:
        stars = 2
    if ev >= 3.5 * edge:
        stars = 3
    agree, disagree = [], []
    side = bet["side"]
    if bet["kind"] in ("ml", "spread"):
        home_side = side == "home"
        market_margin = next((v for n, v, _ in model["components"] if n == "market"), None)
        for name, value, _ in model["components"]:
            if name == "market" or market_margin is None:
                continue
            leans_home = value > market_margin
            label = {"kalshi": "Kalshi", "espn": "ESPN predictor", "stats": "season stats"}[name]
            (agree if leans_home == home_side else disagree).append(label)
    elif bet["kind"] == "total" and model.get("stats_total") is not None:
        leans_over = model["stats_total"] > bet["line"]
        (agree if leans_over == (side == "over") else disagree).append("season stats")
    for market, sig_side, text in model.get("signals") or []:
        if market != bet["kind"] and not (market == "ml" and bet["kind"] == "spread"):
            continue
        if bet["kind"] == "total" and sig_side.lstrip("!") not in ("over", "under"):
            continue
        name = signal_name(text)
        if sig_side == side:
            agree.append(name)
        elif sig_side == "!" + side:
            disagree.append("public side")
        elif not sig_side.startswith("!"):
            disagree.append(name)
    if stars and len(disagree) > len(agree):
        stars -= 1
    if stars and len(agree) >= 3 and not disagree:
        stars = min(3, stars + 1)
    if (bet["price"] or 0) >= 300:
        stars = 0                      # long shots: where a model is least trustworthy
    elif ev > 0.15 or (bet["price"] or 0) >= 200:
        stars = min(stars, 1)          # huge edges usually mean news the model lacks
    bet["stars"] = stars
    bet["agree"], bet["disagree"] = agree, disagree
    dec = bet["dec"]
    kelly = (bet["p"] * dec - 1) / (dec - 1) if dec > 1 else 0
    # an eighth of the Kelly stake, as % of bankroll: the model's edges are
    # estimates, and full Kelly on an over-estimated edge loses money
    bet["stake"] = round(clamp(kelly / 8 * 100, 0.1, 2.0), 1) if stars else 0.0
    return bet


def line_move(line, open_line, event, league):
    """('BAL▲3.5', big?) - how far the market's favourite has moved since
    the open; ▲ stronger, ▼ weaker, ◆ the favourite changed."""
    if not line or not open_line:
        return None
    fav_now, fav_then = _fav(line, league), _fav(open_line, league)
    if league not in MONEYLINE_LEAGUES and line.get("spread") is not None and \
            open_line.get("spread") is not None:
        delta = abs(line["spread"]) - abs(open_line["spread"])
        if fav_now and fav_then and fav_now != fav_then:
            return (f"{event[fav_now]['abbr']}◆", True)
        if not delta or not fav_now:
            return None
        big = abs(delta) >= (1.5 if sport_of(league) == "football" else 1.0)
        return (f"{'▲' if delta > 0 else '▼'}{abs(delta):g}", big)
    a0, h0 = no_vig(open_line.get("away_ml"), open_line.get("home_ml"))
    a1, h1 = no_vig(line.get("away_ml"), line.get("home_ml"))
    if h0 is None or h1 is None or not fav_now:
        return None
    then = h0 if fav_now == "home" else a0
    now = h1 if fav_now == "home" else a1
    points = (now - then) * 100
    if abs(points) < 1:
        return None
    return (f"{'▲' if points > 0 else '▼'}{abs(points):.0f}%", abs(points) >= 4)


def signal_name(text):
    for start, name in (("sharp", "sharp money"), ("reverse", "reverse line move"),
                        ("public", "public side")):
        if text.startswith(start):
            return name
    return "line move"


def bet_label(bet, event, short=False):
    if not bet:
        return ""
    if bet["kind"] == "total":
        word = "O" if bet["side"] == "over" else "U"
        return f"{word} {bet['line']:g}" if short else \
            f"{'Over' if bet['side'] == 'over' else 'Under'} {bet['line']:g}"
    team = event[bet["side"]]["abbr"]
    if bet["kind"] == "ml":
        return f"{team} ML"
    number = bet["line"]
    return f"{team} {'PK' if number == 0 else f'{number:+g}'}"


# -- the Betting tab's screens ----------------------------------------------

def bet_time(event):
    when = parse_iso(event.get("date"))
    if not when:
        return ""
    local = when.astimezone()
    hour = local.strftime("%I:%M").lstrip("0")
    return f"{local.strftime('%a')} {hour}{'a' if local.hour < 12 else 'p'}"


def _rank_abbr(team, league):
    rank = team.get("rank")
    if league in COLLEGE_LEAGUES and rank:
        return f"{rank} {team['abbr']}"
    return team["abbr"]


def _fav(line, league):
    """'home', 'away' or None - who the line favours."""
    if not line:
        return None
    spread = line.get("spread")
    if spread not in (None, 0) and league not in MONEYLINE_LEAGUES:
        return "home" if spread < 0 else "away"
    a, h = line.get("away_ml"), line.get("home_ml")
    if a is not None and h is not None and a != h:
        return "home" if h < a else "away"
    if spread not in (None, 0):
        return "home" if spread < 0 else "away"
    return None


def spread_text(line, event, league, price=True):
    if not line or line.get("spread") is None:
        return "-"
    spread = line["spread"]
    if spread == 0:
        return "PK" + (f" {money_text(line.get('spread_home_price'))}"
                       if price and line.get("spread_home_price") else "")
    side = "home" if spread < 0 else "away"
    cost = line.get(f"spread_{side}_price")
    text = f"{event[side]['abbr']} -{abs(spread):g}"
    return text + (f" {money_text(cost)}" if price and cost is not None else "")


def ml_text(line):
    if not line or (line.get("away_ml") is None and line.get("home_ml") is None):
        return "-"
    return f"{money_text(line.get('away_ml'))}/{money_text(line.get('home_ml'))}"


BET_COLUMNS = [
    # key, header, width, drop order (higher drops first)
    ("rank", "#", 2, 0),
    ("time", "time", 10, 6),
    ("game", "game", 15, 0),
    ("spread", "spread", 14, 0),
    ("total", "total", 5, 5),
    ("ml", "moneyline", 11, 7),
    ("win", "win% mkt→sportst", 16, 1),
    ("proj", "proj", 7, 4),
    ("public", "bets·$", 12, 8),
    ("move", "move", 7, 9),
    ("pick", "best bet", 19, 0),
    ("ev", "edge", 6, 0),
    ("stars", "", 3, 0),
    ("stake", "stake", 5, 10),
]


def bet_columns(width):
    cols = list(BET_COLUMNS)
    while sum(c[2] + 1 for c in cols) + 3 > width:
        droppable = [c for c in cols if c[3] > 0]
        if not droppable:
            break
        cols.remove(max(droppable, key=lambda c: c[3]))
    return cols


def bet_row_cells(row, league, show_book):
    """{column key: [(text, style)]} for one game."""
    event, line, model, pick = row["event"], row["line"], row["model"], row["pick"]
    away, home = event["away"], event["home"]
    cells = {"time": [(bet_time(event), "dim")]}
    if row.get("rank"):
        cells["rank"] = [(str(row["rank"]), "upset")]
    game = [(_rank_abbr(away, league), THEME.style(league, away, bold=True)),
            (" @ ", "muted"), (_rank_abbr(home, league), THEME.style(league, home, bold=True))]
    if event.get("neutral"):
        game[1] = (" v ", "muted")
    cells["game"] = game
    fav = _fav(line, league)
    cells["spread"] = [(spread_text(line, event, league), "normal" if line else "dim")]
    cells["total"] = [(number_text((line or {}).get("total")), "normal")]
    cells["ml"] = [(ml_text(line), "normal")]
    if model:
        side = fav or ("home" if model["p_home"] >= 0.5 else "away")
        p_model = model["p_home"] if side == "home" else 1 - model["p_home"]
        p_mkt = model.get("p_market")
        p_mkt = (p_mkt if side == "home" else 1 - p_mkt) if p_mkt is not None else None
        win = [(event[side]["abbr"] + " ", THEME.style(league, event[side])),
               (f"{p_mkt * 100:.0f}" if p_mkt is not None else "--", "dim"), ("→", "muted")]
        gap = (p_model - p_mkt) if p_mkt is not None else 0
        win.append((f"{p_model * 100:.0f}%", "good" if gap >= 0.03 else
                    ("bad" if gap <= -0.03 else "normal")))
        cells["win"] = win
        if model.get("proj"):
            a, h = model["proj"]
            digits = 1 if sport_of(league) in ("hockey", "baseball") else 0
            cells["proj"] = [(f"{a:.{digits}f}-{h:.{digits}f}", "dim")]
    else:
        cells["win"] = [("loading" if row.get("loading") else "-", "muted")]
    public = row.get("public") or {}
    best = None
    for side in ("away", "home"):
        info = public.get(f"spread:{side}") or public.get(f"ml:{side}")
        if info and (best is None or info[0] > best[1][0]):
            best = (side, info)
    if best:
        side, (tickets, money) = best
        sharp = money - tickets >= 10
        cells["public"] = [(f"{event[side]['abbr']} ", "dim"),
                           (f"{tickets:.0f}·{money:.0f}", "accent" if sharp else "normal")]
    move = row.get("move")
    if move:
        cells["move"] = [(move[0], "upset" if move[1] else "dim")]
    if pick:
        text = bet_label(pick, event, short=True) + f" {money_text(pick['price'])}"
        if show_book:
            text += f" {BOOK_SHORT.get(pick['book'], pick['book'][:4])}"
        team = event.get(pick["side"]) if pick["side"] in ("away", "home") else None
        cells["pick"] = [(text, THEME.style(league, team, bold=True) if team else "bold")]
        cells["ev"] = [(f"{pick['ev'] * 100:+.1f}%", "good")]
        cells["stars"] = [(STAR * pick["stars"], "upset")]
        cells["stake"] = [(f"{pick['stake']:.1f}u", "dim")]
    elif row.get("best"):
        best_bet = row["best"]
        if best_bet["ev"] > 0:
            text = bet_label(best_bet, event, short=True) + f" {money_text(best_bet['price'])}"
            if show_book:
                text += f" {BOOK_SHORT.get(best_bet['book'], best_bet['book'][:4])}"
            cells["pick"] = [(text, "muted")]
        else:
            cells["pick"] = [("no edge", "muted")]
        cells["ev"] = [(f"{best_bet['ev'] * 100:+.1f}%", "muted")]
    return cells


def render_bet_list(rows, league, width, selected, show_book):
    """The header and one line per game."""
    cols = bet_columns(width)
    header = Line().add("  ", "normal")
    for key, title, size, _ in cols:
        align = "<" if key in ("time", "game", "spread", "pick", "win", "public") else ">"
        header.add(f"{title[:size]:{align}{size}} ", "header")
    lines = [header]
    for index, row in enumerate(rows):
        cells = bet_row_cells(row, league, show_book)
        line = Line().add("▌ " if index == selected else "  ",
                          "accent" if index == selected else "normal")
        for key, _, size, _ in cols:
            spans = cells.get(key) or [("", "normal")]
            used = sum(len(t) for t, _ in spans)
            if used > size:                       # trim from the end
                trimmed, room = [], size
                for text, style in spans:
                    trimmed.append((text[:room], style))
                    room -= len(text[:room])
                spans, used = trimmed, size
            if key in ("time", "game", "spread", "pick", "win", "public"):
                for text, style in spans:
                    line.add(text, style)
                line.add(" " * (size - used + 1), "normal")
            else:
                line.add(" " * (size - used), "normal")
                for text, style in spans:
                    line.add(text, style)
                line.add(" ", "normal")
        if row.get("pick"):
            # a best bet: the whole row on the upset-watch tint
            line = Line(line[:1] + [(text, _tinted(style)) for text, style in line[1:]])
            used = sum(len(t) for t, _ in line)
            if used < width:
                line.append((" " * (width - used), "upsetrow"))
        lines.append(line)
    return lines


def _on_cursor(style):
    """The same span on the selected-row bar."""
    if style.startswith("#"):
        return style + ("s" if "~" in style else "~s")
    if style in ("muted", "dim"):
        return "seldim"
    if style in ("upset", "accent", "star"):
        return "selbar"
    return "sel"


def _tinted(style):
    if style.startswith("#"):
        return style + ("u" if "~" in style else "~u")
    if style in ("upset", "good", "accent", "bold", "warn"):
        return "upsetmark"
    if style in ("star",):
        return "upsetstar"
    if style in ("muted", "dim", "header"):
        return "upsetmuted"
    return "upsetrow"


def cli_bets(league, events, data, args, config, width, timeout, favorites):
    """The Betting tab as plain text: every upcoming game, then the picks."""
    mode = args.book or str(config.get("betting_book", "avg") or "avg")
    names = {name.lower(): name for _, name, _ in BOOKS}
    mode = names.get(mode.lower(), mode)
    top = [n for n in (config.get("betting_top_books") or TOP_BOOKS_DEFAULT)
           if n in names.values()] or TOP_BOOKS_DEFAULT
    try:
        min_edge = max(0.5, float(config.get("betting_min_edge", 3.0)))
    except (TypeError, ValueError):
        min_edge = 3.0
    api = Espn()
    sources = config.get("betting_sources", True)
    board = markets = None
    if sources and league in AN_LEAGUES:
        week = dig(data, "week", "number")
        try:
            if LEAGUES[league]["week_based"] and not args.date:
                board = an_board(league, timeout, week=args.week or week,
                                 season=args.season or dig(data, "season", "year"),
                                 seasontype=args.seasontype or dig(data, "season", "type"))
            else:
                board = an_board(league, timeout, day=args.date or Date.today())
        except Exception as exc:  # noqa: BLE001 - ESPN's line still works
            print(f"Action Network: {exc}", file=sys.stderr)
    if sources and league in KALSHI_SERIES:
        try:
            markets = kalshi_board(league, timeout)
        except Exception:  # noqa: BLE001 - optional
            markets = None
    table = team_stats_table(league, timeout, extras=bool(config.get("extra_stat_sources", True)))
    rows = []
    for index, event in enumerate(e for e in events if e["state"] == "pre"):
        game = match_an_game(event, board) if board else None
        books = dict(game["books"]) if game else {}
        sellers = {n: l for n, l in books.items() if n not in ("Consensus", "Open")}
        espn = espn_line_as_book(event.get("line_raw"))
        market = books.get("Consensus") or average_lines(list(sellers.values())) or espn
        if mode == "best":
            shown, candidates = market, list(sellers.values()) or [espn]
        elif mode in names.values():
            shown = sellers.get(mode)
            candidates = [shown]
        else:
            shown = average_lines([sellers[n] for n in top if n in sellers]) or \
                average_lines(list(sellers.values())) or espn
            candidates = [shown]
        summary = None
        if index < 40:
            try:
                summary = fetch_first(api.summary(league, event["id"]), timeout)
            except Exception:  # noqa: BLE001 - the projection works without it
                summary = None
        kalshi = match_kalshi(event, markets) if markets else None
        model = project_game(event, league, table, market, summary, kalshi, books.get("Open"),
                             game["public"] if game else {})
        bets = bet_options(event, league, model, [c for c in candidates if c],
                           "best" if mode == "best" else "one", min_edge)
        pick = next((b for b in bets if b["stars"]), None)
        rows.append({"event": event, "line": shown, "model": model, "bets": bets, "pick": pick,
                     "best": bets[0] if bets else None, "public": game["public"] if game else {},
                     "move": line_move(market, books.get("Open"), event, league)})
    picks = sorted((r for r in rows if r["pick"]),
                   key=lambda r: (-r["pick"]["stars"], -r["pick"]["ev"]))
    for rank, row in enumerate(picks, 1):
        row["rank"] = rank
    rows = picks + sorted((r for r in rows if not r["pick"]),
                          key=lambda r: -(r["best"]["ev"] if r["best"] else -9))
    label = {"avg": "average of " + " · ".join(top), "best": "best price at any book"}.get(
        mode, f"{mode} only")
    lines = [Line().add(f"{LEAGUES[league]['name']} betting — lines: {label}", "title"), blank()]
    if not rows:
        lines.append(Line().add("No upcoming games.", "dim"))
        return lines
    lines.extend(render_bet_list(rows, league, width, -1, mode == "best"))
    picks = [r for r in rows if r["pick"]]
    lines.append(blank())
    lines.append(Line().add(f"Value picks ({len(picks)})", "accent"))
    for row in sorted(picks, key=lambda r: -r["pick"]["ev"]):
        event, pick = row["event"], row["pick"]
        out = Line().add(f"  {event['away']['abbr']} @ {event['home']['abbr']}  ", "normal")
        out.add(f"{bet_label(pick, event)} {money_text(pick['price'])}", "bold")
        out.add(f" {BOOK_SHORT.get(pick['book'], pick['book'][:4])}", "dim")
        out.add(f"  {pick['ev'] * 100:+.1f}%  ", "good").add(STAR * pick["stars"], "upset")
        out.add(f"  {pick['stake']:.1f}u", "dim")
        if pick["agree"]:
            out.add("  for: " + ", ".join(dict.fromkeys(pick["agree"])), "dim")
        lines.append(out)
