            for x, column in logos.items():
                picked = chosen_at if 0 <= chosen_at < view and column[chosen_at] and \
                    column[chosen_at]["id"] == self.standings_sel.get(self.league) else -1
                self.logo_column(self.league, column, top + 1, 2 + x + 3, selected=picked)
            for row, x, wide, first in self._standings_picks:
                shown_at = row - offset
                if 0 <= shown_at < view and first:
                    self.hot(top + 1 + shown_at, 2 + x, 2 + x + wide,
                             lambda t=first: self.click_standing(t))
