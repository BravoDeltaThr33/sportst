def hockey_period_name(number, league):
    number = _int(number)
    if number <= 3:
        return f"{ordinal(number)} Period"
    tag = period_tag(league, number)
    return "Shootout" if tag == "SO" else ("Overtime" if tag == "OT" else tag)


def _side_for(play, by_id):
    return by_id.get(str(dig(play, "team", "id", default="")))


def _is_penalty(play):
    if play.get("penalty") or dig(play, "type", "penaltyMinutes"):
        return True
    kind = clean(dig(play, "type", "text", default="")).lower()
    text = clean(play.get("text") or "").lower()
    if play.get("scoringPlay") or not kind or kind in HOCKEY_NOT_PENALTIES:
        return False
    return "penalty" in text or "minutes" in text or " against " in text or bool(kind)


def hockey_play_lines(summary, league, width, by_id, compact=False):
    plays = dig(summary, "plays", default=[]) or []
    extra = summary.get("sportst") or {}
    lines = []
    goals = [p for p in plays if p.get("scoringPlay")]
    penalties = [p for p in plays if _is_penalty(p)]
    full_width = width
    width -= 2                       # the clip mark's gutter
    if goals:
        lines.append(heading("Scoring summary"))
        if not compact:
            lines.append(rule(min(width, 72)))
        period = None
        for play in goals:
            number = dig(play, "period", "number", default=0)
            if number != period and not compact:
                period = number
                lines.append(Line().add(hockey_period_name(number, league), "accent"))
            side = _side_for(play, by_id)
            abbr = side["abbr"] if side else ""
            strength = clean(dig(play, "strength", "abbreviation", default="")).lower()
            tag = {"power-play": "PPG", "short-handed": "SHG", "powerplay": "PPG",
                   "shorthanded": "SHG"}.get(strength, "")
            if not tag and "/" not in strength and strength.upper() in ("PPG", "SHG", "ENG"):
                tag = strength.upper()
            if "/" in strength:
                tag = strength.upper()
            text = clean(play.get("text") or "")
            if not tag and "empty net" in text.lower():
                tag = "ENG"
            text = re.sub(r"^(Even Strength|Power Play|Shorthanded|Short Handed)"
                          r"(, [^G]*)? Goal Scored by ", "", text)
            clock = clean(dig(play, 'clock', 'displayValue', default=''))
            if compact:
                text = re.sub(r",? assists?: ", " · A: ", text)
                text = re.sub(r" Goal \((\d+)\)", r" (\1)", text)
                row = Line().add(f"{period_tag(league, number):<3}{clock:>5} ", "muted")
                row.add(f"{abbr:<4}", THEME.style(league, side, bold=True, fallback="accent")
                        if side else "accent")
                row.add(f"{tag:<4}", "warn" if tag else "normal")
                row.add(f"{play.get('awayScore', '')}-{play.get('homeScore', '')}  ", "bold")
                prefix = sum(len(t) for t, _ in row)
                chunks = wrap_spans(text, max(20, width - prefix), "normal")
                if chunks:
                    for span in chunks[0]:
                        row.append(span)
                lines.append(gutter(row, play, True))
                for chunk in chunks[1:]:
                    lines.append(gutter(Line().add(" " * prefix, "normal")
                                        .extend_spans(chunk), play, False))
                continue
            row = Line().add(f"  {clock:>5}  ", "muted")
            row.add(f"{abbr:<4} ", THEME.style(league, side, bold=True, fallback="accent")
                    if side else "accent")
            row.add(f"{tag:<4} ", "warn" if tag else "normal")
            row.add(f"{play.get('awayScore', '')}-{play.get('homeScore', '')}  ", "bold")
            lines.append(gutter(row, play, True))
            lines.extend(gutter(line, play, False) for line in
                         wrap_spans(text, width - 6, "normal", indent="        "))
        lines.append(blank())
    width = full_width

    # shots on goal by period
    shots = extra.get("shots") or {}
    table = {}
    if shots:
        away, home = summary_teams(summary)
        for side_name, team in (("away", away), ("home", home)):
            if team:
                table[team["abbr"]] = {_int(k): _int(v)
                                       for k, v in (shots.get(side_name) or {}).items()}
    elif any(dig(p, "type", "text", default="") == "Shot" for p in plays):
        for play in plays:
            if dig(play, "type", "text", default="") in ("Shot", "Goal"):
                side = _side_for(play, by_id)
                if side:
                    number = dig(play, "period", "number", default=0)
                    bucket = table.setdefault(side["abbr"], {})
                    bucket[number] = bucket.get(number, 0) + 1
    if table:
        periods = sorted({p for counts in table.values() for p in counts if p})
        headers = [""] + [period_tag(league, p) for p in periods] + ["T"]
        rows = [[abbr] + [str(counts.get(p, 0)) for p in periods] +
                [str(sum(counts.values()))] for abbr, counts in table.items()]
        lines.append(heading("Shots on goal"))
        lines.extend(build_table(headers, rows, aligns=["<"] + [">"] * (len(headers) - 1),
                                 sep="  "))
        lines.append(blank())

    if penalties:
        lines.append(heading("Penalties"))
        if not compact:
            lines.append(rule(min(width, 72)))
        period = None
        for play in penalties:
            number = dig(play, "period", "number", default=0)
            if number != period and not compact:
                period = number
                lines.append(Line().add(hockey_period_name(number, league), "accent"))
            side = _side_for(play, by_id)
            minutes = clean(str(play.get("minutes") or dig(play, "type", "penaltyMinutes",
                                                            default="") or ""))
            text = clean(play.get("text") or "")
            if not minutes:
                found = re.search(r"(\d+) minutes?", text)
                minutes = found.group(1) if found else ""
            text = re.sub(r"^Penalty to ", "", text)
            clock = clean(dig(play, 'clock', 'displayValue', default=''))
            if compact:
                row = Line().add(f"{period_tag(league, number):<3}{clock:>5} ", "muted")
                row.add(f"{(side or {}).get('abbr', ''):<4}",
                        THEME.style(league, side, fallback="accent") if side else "accent")
                row.add(f"{minutes + 'm' if minutes else '':<4}", "warn")
                row.add(text[: max(10, width - 17)], "normal")
                lines.append(row)
                continue
            row = Line().add(f"  {clock:>5}  ", "muted")
            row.add(f"{(side or {}).get('abbr', ''):<4} ",
                    THEME.style(league, side, fallback="accent") if side else "accent")
            row.add(f"{(minutes + ' min') if minutes else '':<7}", "warn")
            row.add(text[: max(10, width - 22)], "normal")
            lines.append(row)
        lines.append(blank())

    stars = extra.get("stars") or []
    if stars:
        lines.append(heading("Three stars"))
        for index, star in enumerate(stars[:3]):
            team = star.get("team") or {}
            parsed = {"abbr": team.get("abbreviation", ""), "name": team.get("displayName", ""),
                      "id": team.get("id", "")}
            row = Line().add(f"  {'★' * (index + 1):<4}", "star")
            row.add(f"{parsed['abbr']:<5}", THEME.style(league, parsed, bold=True,
                                                        fallback="accent"))
            row.add(star.get("name", ""), "normal")
            lines.append(row)
        lines.append(blank())
    return lines


