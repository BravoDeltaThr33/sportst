def render_ranking_picture(data, league, width, favorites, field=12):
    """College football has no seeds until December, so the poll stands in for
    the playoff field."""
    polls = dig(data, "rankings", default=[]) or []
    if not polls:
        return []
    poll = polls[0]
    lines = [Line().add(clean(poll.get("name") or "Poll"), "title"),
             Line().add(clean(dig(poll, "occurrence", "displayValue", default="")),
                        "muted"), blank()]
    block = []
    for row in poll.get("ranks") or []:
        team = {"id": str(dig(row, "team", "id", default="")),
                "abbr": clean(dig(row, "team", "abbreviation", default="")),
                "name": clean(dig(row, "team", "name", default="")),
                "short": clean(dig(row, "team", "shortDisplayName", default="")),
                "location": clean(dig(row, "team", "location", default="")),
                "color": clean(dig(row, "team", "color", default=""))}
        rank = row.get("current")
        inside = isinstance(rank, int) and rank <= field
        line = Line().add(f" {rank:>2} ", "accent" if inside else "muted")
        star = fav_rank(favorites, league, team) >= 0
        line.add("★" if star else " ", "star" if star else "normal")
        line.add(f"{standings_name(league, team)[:22]:<23}",
                 THEME.style(league, team, bold=inside, dim=not inside))
        line.add(f"{clean(row.get('recordSummary') or ''):<8}", "normal")
        points = row.get("points")
        line.add(f"{points:,}" if points else "", "dim")
        block.append(line)
        if rank == field:
            block.append(Line().add("    " + "┄" * 34, "border"))
    lines.extend(flow_columns([block[: len(block) // 2 + 1], block[len(block) // 2 + 1:]],
                              width))
    return lines


def render_playoff_picture(data, league, width, favorites):
    """Before the postseason starts: who would be in, by seed."""
    if not isinstance(data, dict):
        return [Line().add("No standings to build a playoff picture from.", "dim")]
    root = data
    if "content" in data:
        root = dig(data, "content", "standings", default=data) or data
    groups = []
    walk_standings(root, [], groups)
    if not groups:
        return [Line().add("No standings to build a playoff picture from.", "dim")]

    seeded = {}
    for title, entries in groups:
        conference = title.split(" — ")[-1]
        for entry in entries:
            table = stat_lookup(entry)
            seed = stat_display(table, ["playoffSeed"])
            try:
                seed = int(seed)
            except (TypeError, ValueError):
                continue
            team = entry_team(entry)
            record = stat_display(table, ["total", "overall"])
            if record in ("", "-"):
                wins = stat_display(table, ["wins"])
                losses = stat_display(table, ["losses"])
                record = f"{wins}-{losses}" if wins != "-" else ""
            seeded.setdefault(conference, []).append((seed, team, record,
                                                      stat_display(table, ["streak"])))
    if not seeded:
        return []
    spots_by_league = {"nfl": 7, "nhl": 8, "mlb": 6, "cfb": 12, "cbase": 8,
                       "nba": 10}.get(league, 8)
    blocks = []
    for conference, rows in seeded.items():
        spots = spots_by_league
        if league == "ahl":
            spots = next((n for key, n in AHL_PLAYOFF_SPOTS.items() if key in conference), 5)
        rows.sort(key=lambda row: row[0])
        block = [Line().add("── ", "border").add(f"{conference} ", "title")]
        for seed, team, record, streak in rows[: spots + 4]:
            line = Line()
            inside = seed <= spots
            line.add(f" {seed:>2} ", "accent" if inside else "muted")
            star = fav_rank(favorites, league, team) >= 0
            line.add("★" if star else " ", "star" if star else "normal")
            name = standings_name(league, team)
            line.add(f"{name[:22]:<23}", THEME.style(league, team, bold=inside,
                                                     dim=not inside))
            line.add(f"{record:<8}", "normal" if inside else "dim")
            line.add(streak if streak != "-" else "", "dim")
            block.append(line)
            if seed == spots:
                block.append(Line().add("    " + "┄" * 34, "border"))
        blocks.append(block)
    return flow_columns(blocks, width)


