def stat_number(key, text):
    """The number a bar is drawn from. '7-11' on 3rd down is a rate, '4-41'
    penalties is a count, '35:40' possession is seconds."""
    text = (text or "").strip()
    if not text or text in ("-", "--"):
        return None
    match = re.fullmatch(r"(\d+):(\d{2})", text)
    if match:
        return int(match.group(1)) * 60 + int(match.group(2))
    match = re.fullmatch(r"(-?\d+(?:\.\d+)?)\s*[-/]\s*(\d+(?:\.\d+)?)", text)
    if match:
        made, total = float(match.group(1)), float(match.group(2))
        if key.endswith("Eff") or key.endswith("Attempts") and "redZone" in key:
            return made / total if total else 0.0
        return made
    try:
        return float(text.rstrip("%"))
    except ValueError:
        return None


def team_stat_index(block):
    """{key: (label, value)} plus the order ESPN sent them in.

    Baseball nests its team stats under batting / pitching / fielding, so
    those keys are namespaced: 'batting.hits'."""
    out, order = {}, []
    for stat in block.get("statistics") or []:
        group = stat.get("stats")
        if isinstance(group, list) and group:
            section = stat.get("name") or ""
            for sub in group:
                name = sub.get("name")
                key = f"{section}.{name}"
                if not name or key in out:
                    continue
                label = clean(sub.get("shortDisplayName") or sub.get("displayName")
                              or name)
                order.append(key)
                out[key] = (label, clean(sub.get("displayValue") or ""))
            continue
        key = stat.get("name") or stat.get("label")
        if not key or key in out:
            continue
        order.append(key)
        out[key] = (clean(stat.get("label") or key), clean(stat.get("displayValue") or ""))
    return out, order


def stat_bar(share, width, left_style, right_style, left_char="▄", right_char="▄"):
    """One two-colour bar, left team's share first, split by a one-cell gap."""
    width = max(6, width)
    fill = width - 1
    left = int(round(share * fill)) if share is not None else fill // 2
    left = clamp(left, 0, fill)
    bar = Line()
    if left:
        pattern = (left_char * left)[:left]
        bar.add(pattern, left_style)
    bar.add(" ", "normal")
    if fill - left:
        bar.add(right_char * (fill - left), right_style)
    return bar


def team_stat_sections(summary, league, width):
    """(graphic lines, remaining-stats table lines), away team on the left as
    on ESPN's own page."""
    teams = dig(summary, "boxscore", "teams", default=[]) or []
    home_block, away_block = split_by_side(teams, summary)
    if home_block is None or away_block is None:
        return [Line().add("No team statistics published for this game yet.", "dim")], []
    away, home = block_team(away_block), block_team(home_block)
    left, left_order = team_stat_index(away_block)
    right, right_order = team_stat_index(home_block)
    keys = left_order + [k for k in right_order if k not in left]
    sport = LEAGUES[league]["sport"]
    wanted = [k for k in GRAPH_STATS.get(sport, []) if k in left or k in right]

    away_style = THEME.style(league, away, fallback="away")
    home_style = THEME.style(league, home, fallback="home")
    # two teams in near-identical colours (Georgia and Arkansas) get the
    # away side hatched, the way ESPN does it
    away_rgb = hex_to_rgb(THEME.color(league, away) or "") or (0, 0, 0)
    home_rgb = hex_to_rgb(THEME.color(league, home) or "") or (255, 255, 255)
    clash = color_distance(away_rgb, home_rgb) < 9000
    left_char = "▖▗" if clash else "▄"

    # one line a stat: label, away number, the two-colour bar, home number
    labels = {key: GRAPH_LABELS.get(key) or (left.get(key) or right.get(key))[0]
              for key in wanted}
    values = {key: (left.get(key, ("", "-"))[1] or "-", right.get(key, ("", "-"))[1] or "-")
              for key in wanted}
    label_w = min(18, max([len(v) for v in labels.values()] + [6]))
    value_w = max([max(len(a), len(h)) for a, h in values.values()] + [3])
    bar_width = clamp(width - label_w - 2 * value_w - 4, 12, 60)
    graph = []
    head = Line().add(f"{'':<{label_w}} ", "normal")
    head.add(f"{away['abbr'] or 'AWAY':>{value_w}} ",
             THEME.style(league, away, bold=True, fallback="away"))
    head.add(" " * bar_width, "normal")
    head.add(f" {home['abbr'] or 'HOME'}", THEME.style(league, home, bold=True, fallback="home"))
    graph.append(head)

    for key in wanted:
        a_text, h_text = values[key]
        a_num, h_num = stat_number(key, a_text), stat_number(key, h_text)
        share = None
        if a_num is not None and h_num is not None and (a_num + h_num) > 0:
            share = a_num / (a_num + h_num)
        row = Line().add(f"{labels[key][:label_w]:<{label_w}} ", "dim")
        row.add(f"{a_text:>{value_w}} ", "bold")
        if share is None and a_num == 0 and h_num == 0:
            bar = stat_bar(0.5, bar_width, "muted", "muted", "▄", "▄")
        else:
            bar = stat_bar(share, bar_width, away_style, home_style, left_char)
        row.extend_spans(bar)
        row.add(f" {h_text}", "bold")
        graph.append(row)
    if graph and not graph[-1]:
        graph.pop()

    allowed = MORE_STATS.get(sport)
    rest_keys = [k for k in keys if k not in wanted]
    if allowed:
        rest_keys = [k for k in allowed if (k in left or k in right) and k not in wanted]
    rest = []
    if rest_keys:
        rows = []
        for key in rest_keys:
            label = (left.get(key) or right.get(key))[0]
            rows.append([left.get(key, ("", "-"))[1] or "-", label,
                         right.get(key, ("", "-"))[1] or "-"])
        rest.append(Line().add("More team stats", "title"))
        table = build_table([away["abbr"] or "A", "", home["abbr"] or "B"], rows,
                            aligns=[">", "^", "<"], sep="   ")
        if table:
            head = table[0]
            rebuilt = Line()
            rebuilt.add(head[0][0], THEME.style(league, away, bold=True, fallback="header"))
            for text, _ in head[1:-1]:
                rebuilt.add(text, "header")
            rebuilt.add(head[-1][0], THEME.style(league, home, bold=True, fallback="header"))
            table[0] = rebuilt
        rest.extend(table)
    return graph, rest


BASEBALL_LEADERS = [
    ("batting", "Hitting", ["H", "AB", "R", "RBI", "HR", "BB", "K"], "H",
     ["H", "RBI", "HR"]),
    ("pitching", "Pitching", ["IP", "H", "R", "ER", "BB", "K", "ERA"], "K",
     ["IP", "K", "ERA"]),
]


def _stat_cell(labels, stats, want):
    for label, value in zip(labels, stats):
        if label == want:
            return value
    return ""


def render_baseball_leaders(summary, league, width, heading=True):
    """ESPN publishes no leaders block for baseball, so the best hitter and
    pitcher on each side come out of the box score."""
    blocks = dig(summary, "boxscore", "players", default=[]) or []
    if not blocks:
        return []
    home_block, away_block = split_by_side(blocks, summary)
    ordered = [b for b in (away_block, home_block) if b is not None]
    known = {t["id"]: t for t in summary_teams(summary) if t}
    lines = [Line().add("Game leaders", "title"), rule(clamp(width, 20, 72))] \
        if heading else []
    for kind, title, _cols, sort_by, show in BASEBALL_LEADERS:
        rows = []
        for block in ordered:
            team = known.get(block_team(block)["id"]) or block_team(block)
            section = next((x for x in block.get("statistics") or []
                            if (x.get("type") or x.get("name")) == kind), None)
            if not section:
                continue
            labels = [clean(l) for l in (section.get("labels") or [])]
            best, best_value = None, None
            for entry in section.get("athletes") or []:
                stats = [clean(v) for v in (entry.get("stats") or [])]
                if not stats:
                    continue
                raw = _stat_cell(labels, stats, sort_by)
                try:
                    value = float(str(raw).split("-")[0] or 0)
                except ValueError:
                    value = 0.0
                if kind == "pitching" and not entry.get("starter"):
                    value -= 0.001  # a starter wins ties over a reliever
                if best_value is None or value > best_value:
                    best, best_value = (entry, labels, stats), value
            if best:
                rows.append((team, best))
        if not rows:
            continue
        lines.append(Line().add(title, "accent"))
        for team, (entry, labels, stats) in rows:
            name = clean(dig(entry, "athlete", "shortName", default="")
                         or dig(entry, "athlete", "displayName", default="?"))
            position = clean(dig(entry, "athlete", "position", "abbreviation",
                                 default=""))
            row = Line().add("  ")
            row.add(f"{team['abbr']:<5}", THEME.style(league, team, bold=True,
                                                      fallback="accent"))
            row.add(f"{(name + ' ' + position).strip()[:22]:<23}", "normal")
            for want in show:
                value = _stat_cell(labels, stats, want)
                row.add(f"{value:>6} ", "bold").add(f"{want:<4}", "muted")
            lines.append(row)
        lines.append(blank())
    if lines and not lines[-1]:
        lines.pop()
    return lines


def render_game_leaders(summary, league, width, heading=True):
    """ESPN's Game Leaders card: each category, away leader then home."""
    if is_baseball(league):
        return render_baseball_leaders(summary, league, width, heading)
    blocks = dig(summary, "leaders", default=[]) or []
    if not blocks:
        return []
    home_block, away_block = split_by_side(blocks, summary)
    ordered = [b for b in (away_block, home_block) if b is not None]
    if not ordered:
        return []
    categories = []
    for block in ordered:
        for category in block.get("leaders") or []:
            name = category.get("name") or category.get("displayName")
            if name and name not in categories:
                categories.append(name)

    # the leaders payload carries a thin team object; the game header has the
    # full one, which is what the colour lookup needs
    known = {t["id"]: t for t in summary_teams(summary) if t}
    name_width = clamp(width - 30, 14, 26)
    lines = [Line().add("Game leaders", "title"), rule(clamp(width, 20, 72))] if heading else []
    for name in categories:
        rows = []
        title = ""
        for block in ordered:
            team = known.get(block_team(block)["id"]) or block_team(block)
            entry = next((c for c in block.get("leaders") or []
                          if (c.get("name") or c.get("displayName")) == name), None)
            if not entry:
                continue
            title = title or clean(entry.get("displayName") or name)
            top = (entry.get("leaders") or [None])[0]
            if not top:
                continue
            athlete = clean(dig(top, "athlete", "shortName", default="")
                            or dig(top, "athlete", "displayName", default="?"))
            position = clean(dig(top, "athlete", "position", "abbreviation", default=""))
            main = top.get("mainStat") or {}
            value = clean(str(main.get("value") or "")) or clean(top.get("displayValue") or "")
            unit = clean(main.get("label") or "") if main else ""
            detail = clean(top.get("summary") or "")
            if not main and "," in value:  # older shape: '20/27, 212 YDS, 1 TD'
                detail, value = value, ""
            rows.append((team, athlete, position, value, unit, detail))
        if not rows:
            continue
        lines.append(Line().add(title, "accent"))
        for team, athlete, position, value, unit, detail in rows:
            who = f"{athlete} {position}".strip()
            row = Line().add("  ")
            row.add(f"{team['abbr']:<5}", THEME.style(league, team, bold=True, fallback="accent"))
            row.add(f"{who[:name_width]:<{name_width}}", "normal")
            row.add(f"{value:>5}", "bold")
            row.add(f" {unit:<6}" if unit else " " * 7, "muted")
            if detail:
                row.add(detail, "dim")
            lines.append(row)
        lines.append(blank())
    if lines and not lines[-1]:
        lines.pop()
    return lines


def winprob_chart(summary, away, home, league, width, height=9):
    points = []
    for node in dig(summary, "winprobability", default=[]) or []:
        value = node.get("homeWinPercentage")
        if isinstance(value, (int, float)):
            points.append(float(value))
    if len(points) < 4 or width < 24:
        return []

    plot_width = clamp(width - 8, 10, 160)
    grid = [[" "] * plot_width for _ in range(height)]
    total = len(points)
    for column in range(plot_width):
        low = int(column * total / plot_width)
        high = max(low + 1, int((column + 1) * total / plot_width))
        chunk = points[low:high] or [points[min(low, total - 1)]]
        average = sum(chunk) / len(chunk)
        row = int(round(average * (height - 1)))
        grid[clamp(row, 0, height - 1)][column] = "•"

    away_style = THEME.style(league, away, fallback="away")
    home_style = THEME.style(league, home, fallback="home")
    lines = [Line().add("Win probability", "title")]
    middle = height // 2
    for index, row in enumerate(grid):
        if index == 0:
            label = f"{away['abbr']:>5} "
        elif index == height - 1:
            label = f"{home['abbr']:>5} "
        elif index == middle:
            label = "  50% "
        else:
            label = "      "
        label_style = away_style if index == 0 else (
            home_style if index == height - 1 else "muted")
        style = away_style if index < middle else (home_style if index > middle else "muted")
        lines.append(Line().add(label, label_style).add("".join(row), style))
    lines.append(blank())
    return lines


