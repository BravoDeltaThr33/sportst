def disk_cached(name, max_age, build):
    """build() once per max_age seconds, kept as JSON in the cache folder so a
    slow source is not re-read every time the app starts."""
    path = os.path.join(CACHE_DIR, name)
    try:
        if time.time() - os.path.getmtime(path) < max_age:
            with open(path, encoding="utf-8") as handle:
                return json.load(handle)
    except (OSError, ValueError):
        pass
    data = build()
    if data:
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(path + ".tmp", "w", encoding="utf-8") as handle:
                json.dump(data, handle)
            os.replace(path + ".tmp", path)
        except OSError:
            pass
    return data


def ncaa_extras(timeout=15):
    """College baseball team stats from the NCAA API, keyed by school name.
    NCAA.com is read a page at a time, so the result is kept on disk for 12h."""
    return disk_cached("ncaa-baseball-stats.json", 12 * 3600,
                       lambda: _ncaa_extras(timeout))


def _ncaa_extras(timeout=15):
    out = {}
    for key, stat_id, column in NCAA_BASEBALL:
        page, pages = 1, 1
        while page <= pages and page <= 8:
            try:
                data = http_json(f"{NCAA_API}/stats/baseball/d1/current/team/{stat_id}"
                                 f"?page={page}", timeout)
            except Exception:  # noqa: BLE001 - a missing page leaves a gap
                break
            pages = _int(data.get("pages"), 1)
            for row in data.get("data") or []:
                name = norm_name(re.sub(r"\s*\(.*?\)", "", row.get("Team") or ""))
                out.setdefault(name, {})[key] = _num(row.get(column))
            page += 1
            time.sleep(0.25)       # the API asks for a few requests a second at most
    return out


