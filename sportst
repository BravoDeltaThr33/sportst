class Line(list):
    """A row of (text, style) spans."""

    def add(self, text, style="normal"):
        text = clean(text)
        if text:
            self.append((text, style))
        return self

    def extend_spans(self, spans):
        for text, style in spans:
            self.append((text, style))
        return self

    def pad(self, width, style="normal"):
        used = sum(len(t) for t, _ in self)
        if used < width:
            self.append((" " * (width - used), style))
        return self

    def restyle(self, style):
        return Line((text, style) for text, _ in self)

    @property
    def text(self):
        return "".join(text for text, _ in self)


def blank():
    return Line()


def heading(text, style="title"):
    return Line().add(text, style)


def rule(width, style="border"):
    return Line().add("─" * max(0, width), style)


def build_table(headers, rows, aligns=None, header_style="header",
                row_styles=None, sep="  ", cell_styles=None):
    """Column-aligned table. rows is a list of lists of str."""
    columns = len(headers)
    widths = [len(str(h)) for h in headers]
    for row in rows:
        for index in range(min(columns, len(row))):
            widths[index] = max(widths[index], len(str(row[index])))
    aligns = list(aligns or ["<"] * columns)
    while len(aligns) < columns:
        aligns.append("<")

    out = []
    if any(str(h) for h in headers):
        line = Line()
        for index, header in enumerate(headers):
            if index:
                line.add(sep, header_style)
            line.add(f"{str(header):{aligns[index]}{widths[index]}}", header_style)
        out.append(line)

    for row_index, row in enumerate(rows):
        base = "normal"
        if row_styles and row_index < len(row_styles) and row_styles[row_index]:
            base = row_styles[row_index]
        line = Line()
        for index in range(columns):
            value = str(row[index]) if index < len(row) else ""
            if index:
                line.add(sep, base)
            style = base
            if cell_styles:
                override = cell_styles.get((row_index, index))
                if override:
                    style = override
            line.add(f"{value:{aligns[index]}{widths[index]}}", style)
        out.append(line)
    return out


def wrap_spans(text, width, style="normal", indent=""):
    """Word-wrap a plain string into styled lines."""
    words = clean(text).split()
    lines, current = [], indent
    for word in words:
        candidate = (current + " " + word) if current.strip() else (indent + word)
        if len(candidate) > width and current.strip():
            lines.append(Line().add(current, style))
            current = indent + word
        else:
            current = candidate
    if current.strip():
        lines.append(Line().add(current, style))
    return lines or [Line()]


