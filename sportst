def cli_options():
    """(option strings, help) for every command-line flag."""
    out = []
    for action in make_parser()._actions:
        if not action.option_strings or action.help == argparse.SUPPRESS:
            continue
        flags = ", ".join(action.option_strings)
        if action.metavar:
            flags += f" {action.metavar}"
        elif action.nargs != 0 and action.dest not in ("help", "version"):
            flags += " " + action.dest.upper()
        text = (action.help or "").split(":")[0] if action.dest == "league" else \
            (action.help or "")
        out.append((flags, text))
    return out


