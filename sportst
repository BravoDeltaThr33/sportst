CARD_LABELS = {"TOI/G": "TOI", "MIN": "TOI", "WINS": "W", "SPCT": "S%", "SVPCT": "SV%",
               "SHOTS": "S", "SOG": "S", "PP": "PPG", "SH": "SHG", "GW": "GWG",
               "+/-": "+/-", "PLUSMINUS": "+/-", "PIM": "PIM", "OT": "OTL", "SO%": "SV%"}
