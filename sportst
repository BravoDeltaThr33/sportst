    return LEAGUES.get(league, {}).get("sport") == "baseball"


def sport_of(league):
    return LEAGUES.get(league, {}).get("sport", "")


def family(league):
    """The league as the picker and the favourites know it. Every Olympic
    sport of every Games is its own entry in LEAGUES ('owg2026.hockey-m'),
    and all of them belong to 'owg' or 'osg'."""
    return LEAGUES.get(league, {}).get("family", league)


def is_olympic(league):
    return family(league) in ("owg", "osg")


def is_wiki_sport(league):
    """An Olympic sport drawn from Wikipedia's results tables, as opposed to
    a team tournament ESPN covers game by game."""
    return LEAGUES.get(league, {}).get("source") == "wiki"


