_EMPTY_CELLS = {"", "-", "--", "0", "0.0", "0-0", "0/0", "0:00", ".000", "0.00", "0%"}


def last_game_sections(block, layout_entry):
    """(title, labels, rows, row styles) for one part of the layout."""
    _, title, names, wanted, _ = layout_entry
    sections = []
    for section in block.get("statistics") or []:
        key = section.get("name") or section.get("type")
        if None in names or key in names:
            sections.append(section)
    labels, rows, styles, seen = None, [], [], set()
    totals_row = None
    for section in sections:
        section_labels = [clean(l) for l in (section.get("labels") or
                                             section.get("names") or [])]
        picks = list(range(len(section_labels))) if wanted is None else \
            [section_labels.index(l) for l in wanted if l in section_labels]
        if not picks:
            continue
        if labels is None:
            labels = [section_labels[i] for i in picks]
        elif len(labels) != len(picks):
            continue
        for entry in section.get("athletes") or []:
            ident = str(dig(entry, "athlete", "id", default="") or
                        dig(entry, "athlete", "displayName", default=""))
            stats = [clean(s) for s in (entry.get("stats") or [])]
            if not stats or ident in seen:
                continue
            values = [stats[i] if i < len(stats) else "" for i in picks]
            meaningful = [v for v, label in zip(values, labels) if label not in ("MIN", "TOI")]
            if all(v in _EMPTY_CELLS for v in (meaningful or values)):
                continue
            seen.add(ident)
            name = clean(dig(entry, "athlete", "shortName", default="") or
                         dig(entry, "athlete", "displayName", default="?"))
            position = clean(dig(entry, "athlete", "position", "abbreviation", default=""))
            rows.append([f"{name} {position}".strip()] + values)
            styles.append("normal" if entry.get("starter") is not False else "dim")
        totals = [clean(t) for t in (section.get("totals") or [])]
        if totals and len(sections) == 1:
            totals_row = ["Totals"] + [totals[i] if i < len(totals) else "" for i in picks]
    if totals_row and rows and any(v not in _EMPTY_CELLS for v in totals_row[1:]):
        rows.append(totals_row)
        styles.append("accent")
    return title, labels or [], rows, styles


def render_last_game(summary, league, team, pane_width, full_width):
