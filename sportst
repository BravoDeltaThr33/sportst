# what main() learnt about the terminal before curses started
TERMINAL = {"name": "", "graphics": False, "images": False, "why": "not checked"}


def probe_terminal(timeout=1.0):
    """(name, graphics) as the terminal reports them: its name from XTVERSION
    when it answers, and whether it accepts a Kitty graphics query. Sent
    before curses starts; the reply to the device-attributes request that
    follows (which nearly every terminal answers, at once) ends the wait, so
    the timeout only matters for a terminal that stays silent, or a slow
    link."""
    try:
        import select
        import termios
    except ImportError:
        return "", False
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return "", False
    fd = sys.stdin.fileno()
    try:
        saved = termios.tcgetattr(fd)
    except termios.error:
        return "", False
    data = b""
    try:
        quiet = termios.tcgetattr(fd)
        quiet[3] &= ~(termios.ICANON | termios.ECHO)
        quiet[6][termios.VMIN] = 0
        quiet[6][termios.VTIME] = 0
        termios.tcsetattr(fd, termios.TCSANOW, quiet)
        os.write(sys.stdout.fileno(),
                 b"\x1b[>0q\x1b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\x1b\\\x1b[c")
        end = time.time() + timeout
        while time.time() < end:
            ready, _, _ = select.select([fd], [], [], max(0.0, end - time.time()))
            if not ready:
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            data += chunk
            if re.search(rb"\x1b\[\?[\d;]*c", data):
                break
    except OSError:
        pass
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSAFLUSH, saved)
        except termios.error:
            pass
    named = re.search(rb"\x1bP>\|([^\x1b]*)\x1b\\", data)
    name = named.group(1).decode("utf-8", "replace") if named else ""
    return name, b"\x1b_Gi=31;OK" in data


def choose_pictures(config, probe=probe_terminal):
    """Decide once, before curses starts, whether this run shows real
    images, and remember why (the Settings tab shows it)."""
    want = str(config.get("pictures", "auto") or "auto").lower()
    term = os.environ.get("TERM", "")
    program = os.environ.get("TERM_PROGRAM", "")
    if want == "text":
        TERMINAL.update(images=False, why="text art (Settings, Pictures)")
        return TERMINAL
    name, graphics = probe()
    lower = name.lower()
    kind = ("kitty" if "kitty" in lower or term == "xterm-kitty" or
            os.environ.get("KITTY_WINDOW_ID") else
            "ghostty" if "ghostty" in lower or term == "xterm-ghostty" or
            program.lower() == "ghostty" else "")
    TERMINAL.update(name=name or kind or term, graphics=graphics)
    if want == "images":
        TERMINAL.update(images=True, why="real images (Settings, Pictures)")
    elif graphics and kind:
        TERMINAL.update(images=True, why=f"real images ({kind} answered)")
    elif graphics:
        TERMINAL.update(images=False, why="text art (this terminal's images are untested)")
    else:
        TERMINAL.update(images=False, why="text art (no image support found)")
    return TERMINAL


def cell_pixels():
    """A terminal cell's size in pixels, (width, height); 10 x 20 when the
    terminal does not say."""
    try:
        import fcntl
        import struct
        import termios
        raw = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, xpix, ypix = struct.unpack("HHHH", raw)
        if rows and cols and xpix and ypix:
            return xpix / cols, ypix / rows
    except Exception:  # noqa: BLE001 - a guess is fine
        pass
    return 10.0, 20.0


def kitty_transmit(image_id, png, cols, rows):
    """Escape codes that store a PNG as picture `image_id` and make it show
    in placeholder cells, `cols` x `rows` of them (q=2: no replies)."""
    import base64
    data = base64.b64encode(png)
    parts = [f"\x1b_Ga=d,d=I,i={image_id},q=2\x1b\\".encode()]
    for start in range(0, len(data), 4096):
        more = 1 if start + 4096 < len(data) else 0
        head = (f"a=T,U=1,f=100,t=d,q=2,i={image_id},c={cols},r={rows},m={more}"
                if start == 0 else f"m={more}")
        parts.append(b"\x1b_G" + head.encode() + b";" + data[start:start + 4096] + b"\x1b\\")
    return b"".join(parts)


def kitty_store(image_id, png):
    """Escape codes that store a PNG as picture `image_id` without showing it
    (it is laid where it goes, under the text, by a placement of its own).
    Sent again under a number in use it takes the old picture's place - and
    no delete goes first: Kitty's delete-and-free (d=I) also frees every
    picture that has no placement yet, as this one has not."""
    import base64
    data = base64.b64encode(png)
    parts = []
    for start in range(0, len(data), 4096):
        more = 1 if start + 4096 < len(data) else 0
        head = f"a=t,f=100,t=d,q=2,i={image_id},m={more}" if start == 0 else f"m={more}"
        parts.append(b"\x1b_G" + head.encode() + b";" + data[start:start + 4096] + b"\x1b\\")
    return b"".join(parts)


# Pictures laid under the text (Kitty, Ghostty), a row of cells at a time: a
# span whose style is "!u:<number>:<row>|<style>" starts that row of one,
# UNDERLAYS[number] saying what it is - (key, maker(cell width, cell height)
# -> PNG, cols, rows). The text is drawn over it, the cells' own backgrounds
# under it; a row scrolled out of sight is simply not laid.
UNDER_BASE = 880        # their picture numbers: 880-885
UNDER_SLOTS = 6
UNDERLAYS = {}


def underlay_number(key, maker, cols, rows):
    """Note a picture to lay under some lines of text: its number."""
    number = str(abs(hash(key)) % 1000000007)
    UNDERLAYS.pop(number, None)
    UNDERLAYS[number] = (key, maker, cols, rows)
    while len(UNDERLAYS) > 48:
        UNDERLAYS.pop(next(iter(UNDERLAYS)))
    return number


def underlay_lines(lines, number):
    """The lines with each one's first cell starting its row of picture
    `number` under them."""
    out = []
    for band, line in enumerate(lines):
        spans = list(line)
        if not spans or not spans[0][0]:
            out.append(line)
            continue
        text, style = spans[0]
        marked = [(text[:1], f"!u:{number}:{band}|{style}")]
        if len(text) > 1:
            marked.append((text[1:], style))
        new = Line(marked + spans[1:])
        for name in ("click", "play_ref", "play_first", "section", "player_ref"):
            if hasattr(line, name):
                setattr(new, name, getattr(line, name))
        out.append(new)
    return out


def image_cells(image_id, cols, rows):
    """Lines of placeholder cells for picture `image_id`: one span a cell, its
    style naming the picture, the row and the column (cell_text spells the
    cell out when it is drawn)."""
    return [Line([(PLACEHOLDER, f"!img:{image_id}:{row}:{col}") for col in range(cols)])
            for row in range(rows)]


def cell_text(text, style):
    """What to write for a span: a placeholder span becomes U+10EEEE with
    its row and column marks; everything else is itself."""
    if style and style.startswith("!img:"):
        try:
            parts = style.split(":")
            row, col = int(parts[2]), int(parts[3])
            mark = PLACEHOLDER_MARKS[row]
            # past the last column mark the terminal takes the column from the
            # cell on the left, one more
            return PLACEHOLDER + mark + (PLACEHOLDER_MARKS[col] if col < len(PLACEHOLDER_MARKS)
                                         else "")
        except (ValueError, IndexError):
            return " "
    return text


def fit_cells(size, cols, rows, cell=(10.0, 20.0)):
    """(cols, rows) of the largest box no bigger than cols x rows that has
    the picture's shape, given the cell's shape."""
    width, height = size
    cw, ch = cell
    if cols < 1 or rows < 1 or not width or not height:
        return 0, 0
    if cols * cw / (rows * ch) > width / height:
        rows_used = rows
        cols_used = max(1, min(cols, round(rows * ch * width / height / cw)))
    else:
        cols_used = cols
        rows_used = max(1, min(rows, round(cols * cw * height / width / ch)))
    return min(cols_used, IMAGE_MAX_COLS), min(rows_used, IMAGE_MAX)


# Rounded ends for chips - the tab picked, the badges, the result chips - in a
# terminal that draws the Powerline half circles itself (Kitty and Ghostty do,
# whatever the font): a chip's style starts with "(" and its first and last
# spaces become the ends. Elsewhere a "(" chip is drawn square, as before.
SHAPES = {"round": False}
PILL_LEFT, PILL_RIGHT = "\ue0b6", "\ue0b4"


class Graphics:
    """Pictures for a terminal that shows them: each sent once, into one of
    IMAGE_SLOTS numbered slots, then shown wherever placeholder cells name
    its number. Off, it does nothing."""

    def __init__(self, enabled, write=None):
        self.enabled = bool(enabled)
        self.write = write
        self.slots = {}          # (key, cols, rows) -> slot
        self.last = {}           # slot -> the frame it was last shown in
        self.frame = 0
        self.pending = []
        self.tint = None         # CRT mode: a picture turned to the phosphor's colours
        self.under = {}          # a picture under the text: key -> its number
        self.under_last = {}     # its number -> the frame it was last laid in
        self.under_now = {}      # (number, its row) -> (row, col, cols, cw, ch) this frame
        self.under_shown = set()  # the (number, its row) laid in the frame before
        self.under_png = {}      # its number -> the PNG, to send again after a gap
        self.pending_under = []  # the pictures under the text to send this frame

    def place(self, key, png, cols, rows):
        """The number to name this picture by at cols x rows cells, sending
        it first if the terminal does not have it yet; None when off or when
        every slot is on screen already."""
        if not self.enabled or not png or not 0 < cols <= IMAGE_MAX_COLS or \
                not 0 < rows <= IMAGE_MAX:
            return None
        ident = (key, cols, rows)
        slot = self.slots.get(ident)
        if slot is None:
            taken = set(self.slots.values())
            free = [s for s in range(IMAGE_SLOTS) if s not in taken]
            if free:
                slot = free[0]
            else:
                idle = [s for s in range(IMAGE_SLOTS) if self.last.get(s, -1) != self.frame]
                if not idle:
                    return None
                slot = min(idle, key=lambda s: self.last.get(s, -1))
                self.slots = {k: v for k, v in self.slots.items() if v != slot}
            self.slots[ident] = slot
            if self.tint:
                png = self.tint(png)
            self.pending.append(kitty_transmit(IMAGE_BASE + slot, png, cols, rows))
        self.last[slot] = self.frame
        return IMAGE_BASE + slot

    def underlay(self, key, maker, row, col, cols, band, cw, ch):
        """Lay row `band` of a picture under the text at row, col over cols
        cells this frame (the picture cw x ch pixels a cell), making it
        (maker() -> PNG) and sending it the first time."""
        if not self.enabled or cols <= 0 or row < 0 or col < 0:
            return
        number = self.under.get(key)
        if number is None:
            try:
                png = maker()
            except Exception:  # noqa: BLE001 - the text is drawn anyway
                png = b""
            if not png:
                return
            if self.tint:
                png = self.tint(png)
            taken = set(self.under.values())
            free = [UNDER_BASE + n for n in range(UNDER_SLOTS) if UNDER_BASE + n not in taken]
            if free:
                number = free[0]
            else:
                number = min(taken, key=lambda n: self.under_last.get(n, -1))
                self.under = {k: v for k, v in self.under.items() if v != number}
            self.under[key] = number
            self.under_png[number] = png
            self.pending_under.append((number, png))
        elif number not in {n for n, _ in self.under_shown} and \
                all(n != number for n, _ in self.pending_under) and number in self.under_png:
            # back after a frame or more unlaid: a picture with no placement
            # may have been freed by another picture's delete, so send it again
            self.pending_under.append((number, self.under_png[number]))
        self.under_last[number] = self.frame
        self.under_now[(number, band)] = (row, col, cols, cw, ch)

    def cover(self, top, left, height, width):
        """A box drawn over part of the screen: no picture under the text
        there this frame."""
        self.under_now = {k: u for k, u in self.under_now.items()
                          if u[0] >= top + height or u[0] < top or
                          u[1] >= left + width or u[1] + u[2] <= left}

    def drop_under(self):
        self.under_now = {}

    def flush(self):
        """After curses has drawn a frame: send the pictures it named, and lay
        (again: a cleared screen takes them away) the ones under the text."""
        self.frame += 1
        out = []
        if self.pending:
            out.append(b"".join(self.pending))
            self.pending = []
        # the pictures under the text after the others (whose deletes would free
        # them), right before they are laid
        if self.pending_under:
            out.append(b"".join(kitty_store(number, png) for number, png in self.pending_under))
            self.pending_under = []
        laid = set(self.under_now)
        if self.under_now or self.under_shown:
            parts = ["\x1b7"]
            for (number, band), (row, col, cols, cw, ch) in self.under_now.items():
                parts.append(f"\x1b[{row + 1};{col + 1}H\x1b_Ga=p,i={number},p={band + 1},"
                             f"x=0,y={band * ch},w={cols * cw},h={ch},c={cols},r=1,z=-1,"
                             f"C=1,q=2\x1b\\")
            for number, band in sorted(self.under_shown - laid):
                parts.append(f"\x1b_Ga=d,d=i,i={number},p={band + 1},q=2\x1b\\")
            parts.append("\x1b8")
            out.append("".join(parts).encode())
        self.under_shown, self.under_now = laid, {}
        if out and self.write:
            self.write(b"".join(out))

    def clear(self):
        """Forget every picture (on the way out, or when turned off)."""
        if (self.slots or self.under) and self.write:
            self.write(b"".join(f"\x1b_Ga=d,d=I,i={IMAGE_BASE + s},q=2\x1b\\".encode()
                                for s in sorted(set(self.slots.values()))) +
                       b"".join(f"\x1b_Ga=d,d=I,i={n},q=2\x1b\\".encode()
                                for n in sorted(set(self.under.values()))))
        self.slots, self.last, self.pending = {}, {}, []
        self.under, self.under_last, self.under_now, self.under_shown = {}, {}, {}, set()
        self.under_png, self.pending_under = {}, []


def write_terminal(data):
    """Bytes straight to the terminal, past curses (it has flushed its own)."""
    fd = sys.stdout.fileno()
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except InterruptedError:
            continue
        except OSError:
            return
        view = view[written:]


# --------------------------------------------------------------------------
# CRT mode: an old phosphor screen (Settings, Display: CRT effect)
# --------------------------------------------------------------------------
#
# Two layers, the way the real thing has two. In any colour terminal sportst
# draws what a screen of text can show: the phosphor's own colours (or the
# scheme's, on raised blacks), the power-on sweep, trails where text moves
# away, burn-in of the borders shown longest, and now and then a row that
# slips sideways out of sync. Where the terminal shows pictures (Kitty,
# Ghostty) see-through pictures laid over the text add the glass: scanlines
# and the aperture grille, the vignette, a glow round bright text with red
