def hockey_shots(summary, event):
    """Shots on goal and goals with a location, each turned so the away team
    attacks the left net and the home team the right: dicts of side, x
    (0-200 ft) and y (0-85 ft), goal."""
    out = []
    for play in hockey_shot_plays(summary):
        kind = clean(dig(play, "type", "text", default="")).lower()
        if kind not in ("shot", "goal"):
            continue
        x, y = dig(play, "coordinate", "x"), dig(play, "coordinate", "y")
        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)) \
                or abs(x) > 100 or abs(y) > 43:
            continue
        side = side_of(event, dig(play, "team", "id"))
        if not side:
            continue
        if (side == "away" and x > 0) or (side == "home" and x < 0):
            x, y = -x, -y
        out.append({"side": side, "x": float(x) + 100.0, "y": float(y) + 42.5,
                    "goal": kind == "goal"})
    return out


RINK_ICE = "DDE7EF"        # the ice, in text (7.0.0)
RINK_CREASE = "9CC9EC"     # the goal crease


def _aa_disc(buf, width, height, cx, cy, r, rgb, alpha=1.0, keep=None):
    """An anti-aliased filled disc in an RGBA buffer; `keep(dx, dy)` limits it
    to part of itself (a half) (7.0.0)."""
    import math
    if r <= 0:
        return
    stride = width * 4
    for y in range(max(0, int(cy - r - 1)), min(height, int(cy + r + 2))):
        dy = y + 0.5 - cy
        if abs(dy) > r + 1:
            continue
        reach = math.sqrt(max(0.0, (r + 1) ** 2 - dy * dy))
        for x in range(max(0, int(cx - reach)), min(width, int(cx + reach) + 1)):
            dx = x + 0.5 - cx
            if keep is not None and not keep(dx, dy):
                continue
            cover = r + 0.5 - math.sqrt(dx * dx + dy * dy)
            if cover > 0:
                _blend(buf, y * stride + x * 4, rgb, alpha * min(1.0, cover))


def _aa_ring(buf, width, height, cx, cy, r, thick, rgb, alpha=1.0, keep=None):
    """An anti-aliased circle `thick` pixels wide; `keep(dx, dy)` limits it
    to part of itself (7.0.0)."""
    import math
    half = thick / 2.0
    outer, inner = r + half + 1, max(0.0, r - half - 1)
    stride = width * 4
    for y in range(max(0, int(cy - outer)), min(height, int(cy + outer) + 1)):
        dy = y + 0.5 - cy
        if abs(dy) > outer:
            continue
        far = math.sqrt(max(0.0, outer * outer - dy * dy))
        near = math.sqrt(max(0.0, inner * inner - dy * dy)) if abs(dy) < inner else 0.0
        spans = ((cx - far, cx - near), (cx + near, cx + far)) if near else ((cx - far, cx + far),)
        for lo, hi in spans:
            for x in range(max(0, int(lo)), min(width, int(hi) + 1)):
                dx = x + 0.5 - cx
                if keep is not None and not keep(dx, dy):
                    continue
                cover = half + 0.5 - abs(math.sqrt(dx * dx + dy * dy) - r)
                if cover > 0:
                    _blend(buf, y * stride + x * 4, rgb, alpha * min(1.0, cover))


def _aa_segment(buf, width, height, x0, y0, x1, y1, thick, rgb, alpha=1.0):
    """An anti-aliased line `thick` pixels wide with round ends (7.0.0)."""
    import math
    half = thick / 2.0
    vx, vy = x1 - x0, y1 - y0
    length2 = vx * vx + vy * vy or 1e-9
    stride = width * 4
    for y in range(max(0, int(min(y0, y1) - half - 1)),
                   min(height, int(max(y0, y1) + half + 2))):
        for x in range(max(0, int(min(x0, x1) - half - 1)),
                       min(width, int(max(x0, x1) + half + 2))):
            px, py = x + 0.5 - x0, y + 0.5 - y0
            t = max(0.0, min(1.0, (px * vx + py * vy) / length2))
            cover = half + 0.5 - math.hypot(px - t * vx, py - t * vy)
            if cover > 0:
                _blend(buf, y * stride + x * 4, rgb, alpha * min(1.0, cover))


def _on_ice(rgb):
    """A team's colour as it reads on white ice: a light one darkened."""
    return _mix(rgb, (0, 0, 0), 0.4) if luminance(rgb) > 0.62 else rgb


def rink_png(spec, cw, ch):
    """A real rink from above, as a picture under rink_lines' cells (7.0.0):
    the boards and their yellow kickplate round the ice, the red centre line
    and goal lines, the blue lines, the blue centre circle, the red faceoff
    circles with their hash marks and dots, the creases in blue, the nets and
    the trapezoids behind them, the referees' crease - then every shot on
    goal a dot and every goal a ringed disc in the shooting team's colour
    (the away team's hollow when the colours clash), a picked goal ringed in
    gold."""
    import math
    cw, ch = max(4, int(cw)), max(8, int(ch))
    W, H = spec["cols"] * cw, spec["rows"] * ch
    buf = bytearray(W * H * 4)
    pad = 3.0
    scale = min((W - 2 * pad) / 200.0, (H - 2 * pad) / 85.0)
    ox, oy = (W - 200 * scale) / 2.0, (H - 85 * scale) / 2.0

    def X(ft):
        return ox + ft * scale

    def Y(ft):
        return oy + ft * scale
    board = max(2.0, 0.9 * scale)
    corner = 28.0 * scale
    kick = max(1.0, 0.3 * scale)
    raster_shape(buf, W, int(X(0) - board), int(Y(0) - board), X(200) + board,
                 int(math.ceil(Y(85) + board)), ((78, 86, 100), (52, 58, 70)),
                 radius=corner + board)
    raster_shape(buf, W, int(round(X(0))), int(round(Y(0))), X(200), int(round(Y(85))),
                 (232, 192, 64), radius=corner, replace=True)
    raster_shape(buf, W, int(round(X(0) + kick)), int(round(Y(0) + kick)), X(200) - kick,
                 int(round(Y(85) - kick)), ((240, 245, 250), (222, 231, 240)),
                 radius=max(1.0, corner - kick), replace=True)
    red, blue = (206, 32, 48), (28, 80, 186)
    thin = max(1.2, scale * 2 / 12.0)

    def ice_span(x_ft):
        """The ice's top and bottom at a distance along the rink."""
        reach = min(x_ft, 200 - x_ft)
        if reach >= 28:
            return 0.0, 85.0
        inset = 28 - math.sqrt(max(0.0, 28 * 28 - (28 - reach) ** 2))
        return inset, 85 - inset

    def stripe(x_ft, wide_ft, rgb):
        top, bottom = ice_span(x_ft)
        half = max(thin / 2.0, wide_ft * scale / 2.0)
        raster_shape(buf, W, X(x_ft) - half, int(round(Y(top) + kick)), X(x_ft) + half,
                     int(round(Y(bottom) - kick)), rgb)
    # the creases first, so the goal line runs over them
    for gx, toward in ((11.0, 1), (189.0, -1)):
        keep = (lambda dx, dy, t=toward: dx * t >= 0)
        _aa_disc(buf, W, H, X(gx), Y(42.5), 6 * scale, (150, 198, 236), keep=keep)
        _aa_ring(buf, W, H, X(gx), Y(42.5), 6 * scale, thin, red, keep=keep)
    stripe(100, 1.0, red)
    for x in (75.0, 125.0):
        stripe(x, 1.0, blue)
    for x in (11.0, 189.0):
        stripe(x, 2 / 12.0, red)
    # the centre circle and dot, the referees' crease
    _aa_ring(buf, W, H, X(100), Y(42.5), 15 * scale, thin, blue)
    _aa_disc(buf, W, H, X(100), Y(42.5), max(1.5, 0.5 * scale), blue)
    _aa_ring(buf, W, H, X(100), Y(85) - kick, 10 * scale, thin, red,
             keep=lambda dx, dy: dy <= 0)
    # the end zones' faceoff circles, their hash marks and dots; the neutral dots
    for cx in (31.0, 169.0):
        for cy in (20.5, 64.5):
            _aa_ring(buf, W, H, X(cx), Y(cy), 15 * scale, thin, red)
            _aa_disc(buf, W, H, X(cx), Y(cy), max(1.6, 1.0 * scale), red)
            rise = math.sqrt(15 ** 2 - 2.875 ** 2)
            for hx in (cx - 2.875, cx + 2.875):
                for sign in (-1, 1):
                    _aa_segment(buf, W, H, X(hx), Y(cy + sign * rise), X(hx),
                                Y(cy + sign * (rise + 2)), thin, red)
    for cx in (80.0, 120.0):
        for cy in (20.5, 64.5):
            _aa_disc(buf, W, H, X(cx), Y(cy), max(1.6, 1.0 * scale), red)
    # the nets and the trapezoids behind them
    for gx, back in ((11.0, -1), (189.0, 1)):
        x0, x1 = sorted((X(gx), X(gx + back * 40 / 12.0)))
        raster_shape(buf, W, x0, int(round(Y(39.5))), x1, int(round(Y(45.5))),
                     (196, 202, 212), radius=max(1.0, scale))
        _aa_segment(buf, W, H, x0, Y(39.5), x1, Y(39.5), thin, red)
        _aa_segment(buf, W, H, x0, Y(45.5), x1, Y(45.5), thin, red)
        far = X(gx + back * 40 / 12.0)
        _aa_segment(buf, W, H, far, Y(39.5), far, Y(45.5), thin, red)
        edge = 0.0 if back < 0 else 200.0
        for sign in (-1, 1):
            _aa_segment(buf, W, H, X(gx), Y(42.5 + sign * 11), X(edge) - back * kick,
                        Y(42.5 + sign * 14), thin, red)
    # the shots, then the goals over them, then the picked one
    colours = [_on_ice(hex_to_rgb("#" + spec["away"]) or (90, 90, 90)),
               _on_ice(hex_to_rgb("#" + spec["home"]) or (150, 150, 150))]
    white, ink = (255, 255, 255), (30, 34, 42)
    dot_r = max(2.2, 1.25 * scale)
    goal_r = max(3.6, 2.3 * scale)
    for x_ft, y_ft, side, goal, focus in sorted(spec["shots"], key=lambda s: (s[3], s[4])):
        cx, cy = X(x_ft), Y(y_ft)
        rgb = colours[side]
        if focus:
            _aa_ring(buf, W, H, cx, cy, goal_r + 3.5, 2.4, (255, 176, 40))
        if goal or focus:
            _aa_disc(buf, W, H, cx, cy, goal_r + 1.6, ink, alpha=0.85)
            _aa_disc(buf, W, H, cx, cy, goal_r + 0.8, white)
            _aa_disc(buf, W, H, cx, cy, goal_r, rgb)
            _aa_disc(buf, W, H, cx, cy, goal_r * 0.32, white, alpha=0.9)
        else:
            _aa_disc(buf, W, H, cx, cy, dot_r + 1.0, white, alpha=0.95)
            if spec.get("clash") and side == 0:
                _aa_ring(buf, W, H, cx, cy, dot_r - 0.6, 1.4, rgb)
            else:
                _aa_disc(buf, W, H, cx, cy, dot_r, rgb)
    return png_encode(W, H, buf)


def rink_lines(shots, event, league, cols):
    """A rink from above with every shot on goal (•) and goal (●) in the
    shooting team's colour; the away team shoots at the left net. Where the
    terminal shows pictures, a real rink drawn under blank cells (rink_png,
    7.0.0); elsewhere in braille - the boards, the red centre and goal lines,
    the blue lines, the circles - on white ice, the creases blue (7.0.0)."""
    import math
    width_px = cols * 2
    feet_per_px = 200.0 / width_px
    rows = int(math.ceil(85.0 / feet_per_px / 4))
    if UNDER["on"]:
        clash = teams_clash(league, event["away"], event["home"])
        spec = {"cols": cols, "rows": rows,
                "away": team_hex(league, event["away"]), "home": team_hex(league, event["home"]),
                "clash": clash,
                "shots": tuple((round(float(s["x"]), 1), round(float(s["y"]), 1),
                                0 if s["side"] == "away" else 1, int(bool(s.get("goal"))),
                                int(bool(s.get("focus")))) for s in shots)}
        number = underlay_number(("rink", repr(spec)),
                                 lambda cw, ch, sp=spec: rink_png(sp, cw, ch), cols, rows)
        return underlay_lines([Line().add(" " * cols, "normal") for _ in range(rows)],
                              number)
    layers = {"board": set(), "red": set(), "blue": set()}

    def dot(layer, x_ft, y_ft):
        px, py = int(round(x_ft / feet_per_px)), int(round(y_ft / feet_per_px))
        if 0 <= px < width_px and 0 <= py < rows * 4:
            layers[layer].add((px, py))

    def segment(layer, x0, y0, x1, y1):
        steps = int(max(abs(x1 - x0), abs(y1 - y0)) / feet_per_px * 2) + 1
        for i in range(steps + 1):
            t = i / steps
            dot(layer, x0 + (x1 - x0) * t, y0 + (y1 - y0) * t)

    def arc(layer, cx, cy, radius, start, end):
        steps = int(radius * abs(end - start) / feet_per_px * 2) + 4
        for i in range(steps + 1):
            angle = start + (end - start) * i / steps
            dot(layer, cx + radius * math.cos(angle), cy + radius * math.sin(angle))

    corner = 28.0
    bottom = 85.0 - feet_per_px
    right = 200.0 - feet_per_px
    segment("board", corner, 0, 200 - corner, 0)
    segment("board", corner, bottom, 200 - corner, bottom)
    segment("board", 0, corner, 0, 85 - corner)
    segment("board", right, corner, right, 85 - corner)
    arc("board", corner, corner, corner, math.pi, 1.5 * math.pi)
    arc("board", 200 - corner, corner, corner, 1.5 * math.pi, 2 * math.pi)
    arc("board", corner, 85 - corner, corner, 0.5 * math.pi, math.pi)
    arc("board", 200 - corner, 85 - corner, corner, 0, 0.5 * math.pi)
    segment("red", 100, 1, 100, 84)                       # the centre line
    for x in (11.0, 189.0):                               # the goal lines
        reach = 6.0
        segment("red", x, reach, x, 85 - reach)
        arc("red", x + (-2.5 if x < 100 else 2.5), 42.5, 3.0, 0, 2 * math.pi)  # the nets
    for x in (75.0, 125.0):                               # the blue lines
        segment("blue", x, 1, x, 84)
    arc("blue", 100, 42.5, 15, 0, 2 * math.pi)            # the centre circle
    for x in (31.0, 169.0):
        for y in (20.5, 64.5):
            arc("red", x, y, 15, 0, 2 * math.pi)          # the faceoff circles
    for x in (80.0, 120.0, 31.0, 169.0):
        for y in (20.5, 64.5):
            dot("red", x, y)                              # the faceoff dots
    cells = {}
    for layer in ("board", "blue", "red"):
        for px, py in layers[layer]:
            key = (py // 4, px // 2)
            bits, _ = cells.get(key, (0, layer))
            cells[key] = (bits | BRAILLE_BITS[py % 4][px % 2], layer)
    marks = {}
    ring = None
    for shot in shots:
        key = (min(rows - 1, int(shot["y"] / feet_per_px / 4)),
               min(cols - 1, int(shot["x"] / feet_per_px / 2)))
        if shot.get("focus"):
            ring = key           # the goal a card is about, drawn last, on top
            continue
        goal, side = marks.get(key, (False, shot["side"]))
        marks[key] = (goal or shot["goal"], shot["side"] if shot["goal"] or not goal else side)

    def inside(row, col):
        """Is this cell's middle on the ice (inside the rounded boards)?"""
        x = (col + 0.5) * 2 * feet_per_px
        y = (row + 0.5) * 4 * feet_per_px
        if not (0 <= x <= 200 and 0 <= y <= 85):
            return False
        cx = min(max(x, corner), 200 - corner)
        cy = min(max(y, corner), 85 - corner)
        return (x - cx) ** 2 + (y - cy) ** 2 <= corner ** 2

    def crease(row, col):
        x = (col + 0.5) * 2 * feet_per_px
        y = (row + 0.5) * 4 * feet_per_px
        return any(0 <= (x - gx) * toward <= 6.5 and (x - gx) ** 2 + (y - 42.5) ** 2 <= 6.5 ** 2
                   for gx, toward in ((11.0, 1), (189.0, -1)))
    ink = {"board": "4E5664", "red": "C8303C", "blue": "2456B8"}
    team_ink = {}
    for side in ("away", "home"):
        rgb = hex_to_rgb("#" + team_hex(league, event[side])) or (90, 90, 90)
        team_ink[side] = "%02X%02X%02X" % _on_ice(rgb)
    lines = []
    for row in range(rows):
        line = Line()
        for col in range(cols):
            ground = (RINK_CREASE if crease(row, col) else RINK_ICE) if inside(row, col) \
                else None
            back = f":{ground}" if ground else ""
            if (row, col) == ring:
                line.add("◉", f"@C25A00{back}~b" if ground else "warn")
            elif (row, col) in marks:
                goal, side = marks[(row, col)]
                line.add("●" if goal else "•", f"@{team_ink[side]}{back}" +
                         ("~b" if goal else ""))
            elif (row, col) in cells:
                bits, layer = cells[(row, col)]
                line.add(chr(0x2800 + bits), f"@{ink[layer]}{back}")
            else:
                line.add(" ", f"@{RINK_ICE}:{ground}" if ground else "normal")
        lines.append(merge_spans(line))
    return lines


def hockey_strength(summary, event):
    """Who is on the power play now, from the latest play's strength: the
    side and its abbreviation, or None at even strength."""
    for play in reversed(dig(summary, "plays", default=[]) or []):
        strength = clean(dig(play, "strength", "text", default="")).lower()
        side = side_of(event, dig(play, "team", "id"))
        if not strength or not side:
            continue
        if strength.startswith("power"):
            return side
        if strength.startswith("short"):
            return "home" if side == "away" else "away"
        return None
    return None


def hockey_goalies(summary, event, league):
    """'J. Woll  21 saves on 26  .808' for each team's goalies."""
    lines = []
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = side_of(event, dig(block, "team", "id"))
        if not side:
            continue
        for group in block.get("statistics") or []:
            if group.get("name") != "goalies":
                continue
            keys = group.get("labels") or group.get("keys") or []
            for athlete in group.get("athletes") or []:
                stats = dict(zip(keys, athlete.get("stats") or []))
                if not stats.get("SA") or stats.get("SA") == "0":
                    continue
                who = clean(dig(athlete, "athlete", "shortName", default="") or "?")
                team = event[side]
                line = Line().add(f"{team.get('abbr', ''):<5}", THEME.style(league, team,
                                                                            bold=True))
                line.add(f"{who:<14}", "normal")
                line.add(f"{stats.get('SV', '?')} saves on {stats.get('SA', '?')}", "dim")
                if stats.get("SV%"):
                    line.add(f"  {stats['SV%']}", "bold")
                lines.append(line)
    return lines


def hockey_story(summary, event, league, goalies=True):
    away, home = event["away"], event["home"]
    lines = []
    shots = (box_stat(summary, away.get("id"), "shotsTotal"),
             box_stat(summary, home.get("id"), "shotsTotal"))
    if any(shots):
        lines.append(_stat_line("SHOTS", event, league, shots[0] or "0", shots[1] or "0"))
    if event["state"] == "in":
        side = hockey_strength(summary, event)
        line = Line().add(f"{'STRENGTH':<14}", "muted")
        if side:
            team = event[side]
            line.add(f"{team.get('abbr', '')} POWER PLAY", THEME.style(league, team,
                                                                       bold=True))
        else:
            line.add("even", "dim")
        lines.append(line)
    pp = []
    for team in (away, home):
        goals = box_stat(summary, team.get("id"), "powerPlayGoals")
        chances = box_stat(summary, team.get("id"), "powerPlayOpportunities")
        pp.append(f"{goals}/{chances}" if chances else "")
    if tracked(*pp):
        lines.append(_stat_line("POWER PLAYS", event, league, pp[0] or "-", pp[1] or "-"))
    faceoffs = (box_stat(summary, away.get("id"), "faceoffPercent"),
                box_stat(summary, home.get("id"), "faceoffPercent"))
    if tracked(*faceoffs):
        lines.append(_stat_line("FACEOFFS", event, league, f"{faceoffs[0] or '-'}%",
                                f"{faceoffs[1] or '-'}%"))
    hits = (box_stat(summary, away.get("id"), "hits"), box_stat(summary, home.get("id"),
                                                                   "hits"))
    if tracked(*hits):
        lines.append(_stat_line("HITS", event, league, hits[0] or "0", hits[1] or "0"))
    keepers = hockey_goalies(summary, event, league) if goalies else []
    if keepers:
        lines.append(blank())
        lines.append(Line().add("GOALIES", "title"))
        lines.extend(keepers)
    return lines


def short_player(name):
    """'Morgan Geekie' as 'M. Geekie' (a name already short is kept)."""
    name = clean(name).strip()
    first, _, rest = name.partition(" ")
    if not rest or first.endswith("."):
        return name
    return f"{first[0]}. {rest}"


def goal_assists(play):
    """A goal's assists, short names: from the play's participants, else
    from its text ('assists: A (3), B (7)', 'assisted by A and B')."""
    names = [clean(dig(p, "athlete", "shortName", default="") or "")
             for p in play.get("participants") or []
             if "assist" in str(p.get("type") or "").lower()]
    names = [name for name in names if name]
    if names:
        return names
    found = re.search(r"assist(?:s:|ed by)\s+(.+)$", clean(play.get("text") or ""))
    if not found:
        return []
    parts = [re.sub(r"\s*\(\d+\)", "", part).strip()
             for part in re.split(r",|\band\b", found.group(1))]
    return [short_player(part) for part in parts
            if part and part.lower() not in ("none", "unassisted")]


def hockey_goals(summary, event, league, limit=12, width=None):
    """GOALS: period, time, team, scorer, PP or SH - every one, or the last
    `limit` when there are more (the heading then says so); with `width`,
    the assists after the scorer where they fit."""
    lines = []
    goals = []
    for play in dig(summary, "plays", default=[]) or []:
        if not play.get("scoringPlay"):
            continue
        side = side_of(event, dig(play, "team", "id"))
        if not side:
            continue
        text = clean(play.get("text") or "")
        who = next((clean(dig(p, "athlete", "shortName", default=""))
                    for p in play.get("participants") or []
                    if p.get("type") == "scorer"), "")
        if not who:
            found = re.search(r"Goal Scored by (.+?)(?: assisted| \(|$)", text) or \
                re.match(r"(.+?)(?: Goal| \(|,|$)", text)
            who = found.group(1).strip() if found else text
        strength = clean(dig(play, "strength", "text", default="")).lower() + " " + text.lower()
        tag = "PP" if "power play" in strength else "SH" if "short" in strength \
            else "EN" if "empty net" in strength else ""
        number = dig(play, "period", "number", default=0) or 0
        period = clean(dig(play, "period", "displayValue", default="") or "") or \
            {1: "1st", 2: "2nd", 3: "3rd", 4: "OT"}.get(number, f"{number - 3}OT"
                                                         if number > 4 else "")
        goals.append((period, clean(dig(play, "clock", "displayValue", default="")), side,
                      who, tag, goal_assists(play) if width else []))
    if goals:
        lines.append(Line().add("GOALS" if len(goals) <= limit else
                                f"GOALS · the last {limit} of {len(goals)}", "title"))
        for period, clock, side, who, tag, assists in goals[-limit:]:
            team = event[side]
            line = Line().add(f"{period:<4}{clock:>6}  ", "dim")
            line.add(f"{team.get('abbr', ''):<5}", THEME.style(league, team, bold=True))
            line.add(who[:22], "normal")
            if tag:
                line.add(f"  {tag}", "accent")
            if assists and width:
                while assists and len(line.text) + len(", ".join(assists)) + 4 > width:
                    assists = assists[:-1]
                if assists:
                    line.add(f"  ({', '.join(assists)})", "dim")
            lines.append(line)
    return lines


def hockey_panel(summary, event, league, width, height):
    numbers = hockey_story(summary, event, league)
    # as many goals as the height leaves room for, the latest kept
    goals = hockey_goals(summary, event, league, limit=max(4, height - len(numbers) - 2))
    story = numbers + ([blank()] + goals if goals else [])
    story_w = 44
    room = width - story_w - 4
    shots = hockey_shots(summary, event)
    if not shots or room < 40 or height < 8:
        # no shot locations (the Olympics): the goals on a
        # period timeline, then the numbers and the goals side by side
        timeline = hockey_timeline(summary, event, league, min(width, 110))
        if timeline and height >= len(timeline) + 6:
            timeline = timeline + [blank()]
        else:
            timeline = []
        height -= len(timeline)
        if width < 96 or not goals:
            return timeline + story[:height]
        left_w = max([len(l.text) for l in numbers] + [40]) + 6
        merged = []
        for index in range(max(len(numbers), len(goals))):
            line = Line()
            part = numbers[index] if index < len(numbers) else Line()
            line.extend(part)
            line.add(" " * max(0, left_w - len(part.text)), "normal")
            if index < len(goals):
                line.extend(goals[index])
            merged.append(line)
        return timeline + merged[:height]
    import math
    # as wide as fits, as tall as the room allows (85 x 200 ft)
    cols = clamp(room, 40, 84)
    while cols > 40 and math.ceil(85.0 / (200.0 / (cols * 2)) / 4) > height - 2:
        cols -= 2
    rink = rink_lines(shots, event, league, cols)
    head = Line()
    for side in ("away", "home"):
        team = event[side]
        mine = [s for s in shots if s["side"] == side]
        if head:
            head.add("   ", "normal")
        head.add(f"{team.get('abbr', '')} ", THEME.style(league, team, bold=True))
        head.add(("◀ " if side == "away" else "▶ ") + f"{len(mine)} shots", "dim")
    legend = Line().add("• shot on goal  ● goal", "muted")
    left = [head] + rink + [legend]
    merged = []
    for index in range(max(len(left), len(story))):
        line = Line()
        part = left[index] if index < len(left) else Line()
        line.extend(part)
        line.add(" " * max(2, cols + 4 - len(part.text)), "normal")
        if index < len(story):
            line.extend(story[index])
        merged.append(line)
    return merged[:height]


