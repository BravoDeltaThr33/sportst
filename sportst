def _ht_rec(row, prefix=""):
    w, l = row.get(prefix + "w", 0) or 0, row.get(prefix + "l", 0) or 0
    otl = (row.get(prefix + "otl", 0) or 0) + (row.get(prefix + "sl", 0) or 0)
    return f"{w}-{l}-{otl}"


def ahl_preview_lines(preview, side):
    """(label, text) rows for one side of an AHL scouting report."""
    team = (preview or {}).get("visitor_team" if side == "away" else "home_team") or {}
    if not team:
        return None
    out = []
    form = []
    if team.get("last10"):
        form.append(f"L10 {team['last10']}")
    if team.get("streak"):
        form.append(f"streak {team['streak']}")
    form.append(f"home {_ht_rec(team, 'home_')}")
    form.append(f"road {_ht_rec(team, 'away_')}")
    out.append(("Form", " · ".join(form)))
    pp, pk = team.get("pp") or {}, team.get("pk") or {}
    where = "pp_away" if side == "away" else "pp_home"
    kill = "pk_away" if side == "away" else "pk_home"
    special = []
    if pp:
        special.append(f"PP {pp.get('percentage', 0):.1f}% "
                       f"({pp.get('power_play_goals', 0)}/{pp.get('power_plays', 0)})")
    if pk:
        special.append(f"PK {pk.get('percentage', 0):.1f}%")
    if (team.get(where) or {}).get("power_plays"):
        special.append(f"{'road' if side == 'away' else 'home'} PP "
                       f"{team[where].get('percentage', 0):.1f}% · PK "
                       f"{(team.get(kill) or {}).get('percentage', 0):.1f}%")
    if special:
        out.append(("Special", " · ".join(special)))
    scorers = []
    for row in (team.get("leadingScorers") or [])[:4]:
        scorers.append(f"{row.get('first_name', '')[:1]}. {row.get('last_name', '')} "
                       f"{row.get('goals', 0)}-{row.get('assists', 0)}-{row.get('points', 0)}")
    if scorers:
        out.append(("Scorers", ", ".join(scorers)))
    hot = (dig(team, "longest_player_streaks", "points", default=[]) or [])
    hot = sorted(hot, key=lambda r: -(r.get("length") or 0))[:2]
    if hot and (hot[0].get("length") or 0) >= 2:
        out.append(("Hot", ", ".join(f"{r.get('last_name', '')} {r.get('length')}-game "
                                     f"point streak" for r in hot
                                     if (r.get("length") or 0) >= 2)))
    rookie = team.get("rookie") or {}
    if rookie.get("last_name"):
        out.append(("Rookie", f"{rookie.get('first_name', '')[:1]}. {rookie['last_name']} "
                              f"{rookie.get('goals', 0)}G {rookie.get('assists', 0)}A"))
    records = team.get("season_records") or {}
    when = []
    for key, label in (("leading_after_2nd", "lead after 2"),
                       ("trailing_after_2nd", "trail after 2"),
                       ("one_goal_game", "1-goal games")):
        if records.get(key):
            when.append(f"{label} {records[key]}")
    if when:
        out.append(("Records", " · ".join(when)))
    if team.get("last_game"):
        out.append(("Last", team["last_game"]))
    return out


def ahl_head_to_head(preview, event, league):
    """The season series and recent meetings out of an AHL preview."""
    lines = [Line().add("── Season series ", "border")]
