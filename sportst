    # -- today across every sport: the slate, the BottomLine, score alerts ---

    def slate_leagues(self):
        """The leagues the background slate reads: all of them while the
        BottomLine or the Overview's Today list is showing, otherwise only
        those with a favourite team (for score alerts)."""
        if self._slate_all:
            return SLATE_LEAGUES
        if self.config.get("score_alerts", True):
            return tuple(league for league in SLATE_LEAGUES
                         if self.favorites.get(league))
        return ()

    def slate_result(self, league):
        today = Date.today()
        group = self.cfb_group if league == "cfb" else ""
        groups = self.cfb_group if league == "cfb" else LEAGUES[league].get("groups")
        url, spare = self.api.scoreboard(league, day=today, groups=groups)
        live = self._slate_live.get(league, False)
        return self.fetcher.get(("sb", league, "d", today.isoformat(), group), url,
                                ttl=45 if live else 300, fallbacks=spare, background=True)

    def today_slate(self):
        """{league: [event]}: every league's games today worth a look (every
        pro game; ranked and favourite college games), favourites first, then
        live, upcoming and final. Leagues still loading are left out."""
        if time.time() - self.started < 1.5:
            return {}                   # the first screen's own data comes first
        out = {}
        for league in self.slate_leagues():
            try:
                result = self.slate_result(league)
            except Exception:  # noqa: BLE001 - one league never stops the rest
                continue
            if not result.data:
                continue
            cached = self._slate.get(league)
            if cached and cached[0] is result.data:
                out[league] = cached[1]
                continue
            events = [e for e in parse_scoreboard(result.data)
                      if slate_keep(e, league, self.favorites)]
            events = slate_order(events, league, self.favorites)
            self._slate[league] = (result.data, events)
            self._slate_live[league] = any(e["state"] == "in" for e in events)
            self.check_score_alerts(league, events)
            out[league] = events
        return out

    def check_score_alerts(self, league, events):
        """Compare your teams' games with the last look and put what changed on
        the bottom line: under way, a score, final; in basketball, a close
        finish instead of every basket."""
        if not self.config.get("score_alerts", True):
            return
        messages = []
        for event in events:
            sides = [side for side in ("away", "home")
                     if fav_rank(self.favorites, league, event[side]) >= 0]
            if not sides:
                continue
            now = (event["state"], event["away"]["score"], event["home"]["score"])
            before = self._alert_seen.get(event["id"])
            self._alert_seen[event["id"]] = now
            if before is None or before == now:
                continue
            text = score_alert(event, league, before, sides)
            if not text and close_late(event, league) and event["id"] not in self._alert_close:
                self._alert_close.add(event["id"])
                away, home = event["away"], event["home"]
                text = (f"{STAR} CLOSE FINISH: {away['abbr']} {away['score']}, "
                        f"{home['abbr']} {home['score']} · {short_clock(event)}")
            if text:
                messages.append(text)
        if messages:
            self.status_message = "  ·  ".join(messages)
            self.dirty = True
            if self.config.get("score_bell", False):
                try:
                    curses.beep()
                except curses.error:
                    pass

    def ticker_shown(self, height, width):
        mode = str(self.config.get("ticker", "auto") or "auto")
        if mode == "off" or height < 16 or width < 60:
            return False
        return mode == "on" or height >= 30

    def draw_ticker(self, row, width):
        """The BottomLine: one league's games at a time behind its bug, a new
        page every few seconds, your teams first."""
        self.put(row, 0, " " * width, self.palette("normal"))
        try:
            slate = self.today_slate()
            pages = ticker_pages(slate, self.favorites, width - 8)
        except Exception:  # noqa: BLE001 - the ticker is a nicety, never a crash
            slate, pages = {}, []
        if not pages:
            text = ("Today's games are on their way…" if time.time() - self.started < 20
                    else "No games on today's slate.")
            self.put(row, 1, " BOTTOMLINE ", self.palette("tabsel"))
            self.put(row, 14, text, self.palette("muted"))
            return
        index = int(time.time() // TICKER_SECONDS) % len(pages)
        bug, items = pages[index]
        self.put(row, 1, f" {bug} ", self.palette("tabsel"))
        x = len(bug) + 4
        for number, (chip, league, event) in enumerate(items):
            if number:
                self.put(row, x, " │ ", self.palette("border"))
                x += 3
            start = x
            for text, style in chip:
                if x + len(text) >= width - 6:
                    text = text[: max(0, width - 6 - x)]
                self.put(row, x, text, self.palette(style))
                x += len(text)
            self.hot(row, start, x, lambda lg=league, ev=event: self.click_ticker(lg, ev))
        if len(pages) > 1:
            tag = f"{index + 1}/{len(pages)}"
            self.put(row, width - len(tag) - 1, tag, self.palette("muted"))

    def click_ticker(self, league, event):
        """A game on the BottomLine opens as it would from Today; from the Game
        Center a live one takes its place."""
        if self.center:
            self.close_center()
        self.open_game_best(league, event)
        return True

    def open_game(self, league, event, target=None):
        """Go to one game anywhere: switch league, find its day, select it,
        and open `target` (a tab name, 'center' for the Game Center, or the
        Scoreboard)."""
        if not event:
            return
        if league != self.league:
            self.switch_league(league)
        moment = _local(event.get("date"))
        if moment and not is_olympic(league):
            self.day = moment.date()
        self.week_mode = False
        self.week_pinned = False
        self.selected_id = event["id"]
        self.selected_index = 0
        self.detail_scroll = 0
        tabs = self.tabs
        if target == "center":
            self.tab = tabs.index("Scoreboard") if "Scoreboard" in tabs else 1
            self.open_center(league, event)
            return
        name = target if target in tabs else ("Scoreboard" if "Scoreboard" in tabs
                                              else tabs[1])
        self.tab = tabs.index(name)
        self.scroll[name] = 0

    def hot(self, row, start, end, action, activate=None):
        """Make columns start..end of a row clickable: `action` on a click,
        `activate` (or `action` again) on a double click."""
        if end > start:
            self.hotspots.append((row, start, end, action, activate))

    def apply_mouse(self):
        try:
            if self.config.get("mouse", True):
                mask = (curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED |
                        curses.BUTTON4_PRESSED | getattr(curses, "BUTTON5_PRESSED", 0))
                curses.mousemask(mask)
                curses.mouseinterval(180)
            else:
                curses.mousemask(0)
        except (curses.error, AttributeError):
            pass

    # tabs whose lists move one row per notch of the mouse wheel
    WHEEL_ROW_TABS = ("Overview", "Favorites", "Settings", "Stats", "Betting")

    def wheel(self, top, bottom, left, right, down, up, times=3):
        """Make the mouse wheel over rows top..bottom-1, columns left..right-1
        send the key `down` or `up`, `times` per notch."""
        self.wheel_zones.append((top, bottom, left, right, down, up, times))

    def handle_mouse(self):
        """A click runs what is under it - a tab, a game, a team, a setting, a
        menu item, a calendar day - and a click on what is already picked
        opens it, as enter would (so does a double click). The wheel moves
        through the list, or scrolls the pane under the pointer. A click
        closes help and the i pop-up, skips Ask Kim ahead, and outside a menu
        or the calendar closes it."""
        try:
            _, x, y, _, state = curses.getmouse()
        except curses.error:
            return True
        up = state & curses.BUTTON4_PRESSED
        down = state & getattr(curses, "BUTTON5_PRESSED", 0)
        if up or down:
            if not (self.popup or self.calendar or self.kim or self.center or
                    self.show_info or self.show_help or self.article):
                for top, bottom, left, right, down_key, up_key, times in \
                        reversed(self.wheel_zones):
                    if top <= y < bottom and left <= x < right:
                        for _ in range(times):
                            self.handle_key(down_key if down else up_key)
                        return True
            if self.popup or self.calendar or self.center:
                times = 1
            elif self.show_info or self.show_help or self.kim or self.article:
                times = 3
            elif self.tab_name == "Stats" and self.stats_team and \
                    self.players_view != "schedule":
                times = 3          # a team's players: scroll
            elif self.on_board or self.tab_name in self.WHEEL_ROW_TABS:
                times = 1
            else:
                times = 3
            for _ in range(times):
                self.handle_key(curses.KEY_DOWN if down else curses.KEY_UP)
            return True
        double = bool(state & curses.BUTTON1_DOUBLE_CLICKED)
        if not (state & curses.BUTTON1_CLICKED or double):
            return True
        self.dirty = True
        self.status_message = ""      # as a key does: the old message has had its turn
        self.pending_center = None
        guard, self._click_guard = self._click_guard, None
        if guard and time.time() - guard[0] < 0.6 and guard[2] == y and \
                abs(guard[1] - x) <= 2:
            return True     # the second half of a double click that already opened
        if self.show_help or self.show_info:
            return self.handle_key(27)
        if self.article:
            self.article = None          # a click closes the article card
            return True
        if self.kim:
            return self.handle_kim_key(10)
        for row, start, end, action, activate in reversed(self.hotspots):
            if row == y and start <= x < end:
                opened = (activate or action)() if double else action()
                if opened:
                    self._click_guard = (time.time(), x, y)
                return True
        if self.popup or self.calendar:
            return self.handle_key(27)     # a click outside closes it
        return True

    def click_popup(self, index):
        """A click on a menu item chooses it, as enter would."""
        if self.popup is None:
            return False
        self.popup.cursor = index
        self.handle_popup_key(10)
        return True

    def click_tab(self, index):
        if 0 <= index < len(self.tabs):
            self.tab = index
        return False

    def clicked_again(self, *row):
        """True when this click lands on the row the last click picked, with no
        key pressed since: the second click opens it. A row the keyboard
        highlighted is only picked by its first click."""
        again = self._mouse_pick and self._last_pick == row
        self._mouse_pick = True
        self._last_pick = row
        return again

    def click_game(self, index, open_it=False):
        """A game on the scoreboard: the first click picks it, a click on the
        picked one opens it (enter)."""
        if not 0 <= index < len(self.events):
            return False
        again = self.clicked_again("game", self.league, self.events[index]["id"])
        if index != self.selected_index:
            self.selected_index = index
            self.selected_id = self.events[index]["id"]
            self.detail_scroll = 0
            self.at_bat = None
        if again or open_it:
            self.handle_key(10)
            return True
        return False

    def click_bet(self, index, open_it=False):
        again = self.clicked_again("bet", self.league, index)
        self.bet_index = index
        if again or open_it:
            self.handle_betting_key(10)
            return True
        return False

    def click_stats_row(self, league, number, open_it=False):
