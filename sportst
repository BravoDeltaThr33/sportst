def sextant_char(pattern):
    """The Unicode sextant for a 6-bit pattern. Bit 0 is top-left, bit 1
    top-right, then the middle pair, then the bottom pair. The block skips
    the four patterns older characters already cover."""
    if pattern == 0:
        return " "
    if pattern == 63:
        return "█"
    if pattern == 21:
        return "▌"
    if pattern == 42:
        return "▐"
    return chr(0x1FB00 + pattern - 1 - (pattern > 21) - (pattern > 42))


def _near(pixel, choices):
    """Index of the choice closest to pixel; None stands for the background."""
    rgb = pixel or (0, 0, 0)
    best, best_d = 0, None
    for index, choice in enumerate(choices):
        d = color_distance(rgb, choice or (0, 0, 0))
        if best_d is None or d < best_d:
            best, best_d = index, d
    return best


def block_cell(pixels, charset):
    """(character, style) for one cell, drawn in two colours.

    A cell holds six pixels (sextants) or eight (octants) but only two
    colours, so this tries every pair of the colours present and keeps the
    pair that covers the pixels best, then encodes which pixels take the
    foreground."""
    present = []
    for pixel in pixels:
        if pixel not in present:
            present.append(pixel)
    if len(present) == 1:
        only = present[0]
        return (" ", "normal") if only is None else ("█", "@" + _hex(only))
    if len(present) > 5:  # keep the search small on a busy cell
        present = present[:5]
    best = None
    for i in range(len(present)):
        for j in range(i + 1, len(present)):
            pair = (present[i], present[j])
            cost = 0
            for pixel in pixels:
                choice = pair[_near(pixel, pair)]
                cost += color_distance(pixel or (0, 0, 0), choice or (0, 0, 0))
            if best is None or cost < best[0]:
                best = (cost, pair)
    a, b = best[1]
    # background side: transparency if there is any, else a fixed order so
    # the same two colours always make the same colour pair
    if a is None:
        fg, bg = b, None
    elif b is None:
        fg, bg = a, None
    else:
        fg, bg = max(a, b), min(a, b)
    pattern = 0
    for bit, pixel in enumerate(pixels):
        if _near(pixel, (bg, fg)) == 1:
            pattern |= 1 << bit
    style = "@" + _hex(fg) + (":" + _hex(bg) if bg is not None else "")
    if callable(charset):
        return charset(pattern), style
    return charset[pattern], style


def sextant_cell(pixels):
    return block_cell(pixels, sextant_char)


def octant_cell(pixels):
    return block_cell(pixels, OCTANT_CHARS)


# 2 x 2 pixels per cell, bit 0 top-left then left to right, top to bottom.
# Every one of the 16 patterns is a classic Block Elements character
# (Unicode 1.0, 1991) -- the same vintage as the half-blocks, so every
# monospace font draws all of them evenly, unlike the year-old octants.
QUADRANT_CHARS = " ▘▝▀▖▌▞▛▗▚▐▜▄▙▟█"


def quadrant_cell(pixels):
    return block_cell(pixels, QUADRANT_CHARS)


def render_logo(image, max_cols, max_rows, style="sextants", indent=0):
    """Lines for a logo no larger than max_cols x max_rows cells.

    sextants    2 x 3 pixels per cell (Unicode 13, 2020); the default, and
                what "blocks" means too
    octants     2 x 4 pixels per cell, the sharpest on paper, but octants are
                Unicode 16 (2024) and many fonts draw the rarer 230-odd of
                them unevenly or not at all
    quadrants   2 x 2 pixels per cell, built entirely from classic Block
                Elements (Unicode 1.0, 1991) -- lower resolution than
                sextants but every monospace font renders it consistently
    halfblocks  ▀ ▄: 1 x 2 pixels per cell, works in any UTF-8 terminal
    ascii       .:-=+*#%@ in the logo's colours
    """
    if not image or max_cols < 4 or max_rows < 2:
        return []
    box = opaque_box(image)
    if box is None:
        return []
    width, height = box[2] - box[0], box[3] - box[1]
    # one cell is one pixel wide and two tall, so rows x (2*rows) is square
    rows = max_rows
    cols = max(1, int(round(rows * 2 * width / height)))
    if cols > max_cols:
        cols = max_cols
        rows = max(1, int(round(cols * height / width / 2)))
    pad = " " * max(0, indent)
    if style in ("blocks", "octants", "octant", "sextants", "sextant", "quadrants", "quadrant"):
        if style.startswith("oct"):
            tall, cell = 4, octant_cell
        elif style.startswith("quad"):
            tall, cell = 2, quadrant_cell
        else:
            tall, cell = 3, sextant_cell
        grid = trim_grid(quantize(logo_cells(image, cols, rows, box, 2, tall), limit=6),
                         2, tall)
        lines = []
        for y in range(0, len(grid) - tall + 1, tall):
            line = Line().add(pad, "normal")
            for x in range(0, len(grid[0]) - 1, 2):
                pixels = [grid[y + dy][x + dx] for dy in range(tall) for dx in (0, 1)]
                char, token = cell(pixels)
                line.add(char, token)
            lines.append(merge_spans(line))
        return lines

    grid = trim_grid(quantize(logo_cells(image, cols, rows, box), limit=6))
    if not grid:
        return []
    lines = []
    for y in range(0, len(grid) - 1, 2):
        top, bottom = grid[y], grid[y + 1]
        line = Line().add(pad, "normal")
        for upper, lower in zip(top, bottom):
            if style == "ascii":
                pick = upper or lower
                if pick is None:
                    line.add(" ", "normal")
                    continue
                shade = max(pick) / 255
                char = ASCII_RAMP[clamp(int(shade * (len(ASCII_RAMP) - 1)), 1,
                                        len(ASCII_RAMP) - 1)]
                line.add(char, "@" + _hex(pick))
            elif upper is None and lower is None:
                line.add(" ", "normal")
            elif upper is None:
                line.add("▄", "@" + _hex(lower))
            elif lower is None:
                line.add("▀", "@" + _hex(upper))
            elif upper == lower:
                line.add("█", "@" + _hex(upper))
            else:
                line.add("▀", "@" + _hex(upper) + ":" + _hex(lower))
        lines.append(merge_spans(line))
    return lines


def merge_spans(line):
    merged = Line()
    for text, style in line:
        if merged and merged[-1][1] == style:
            merged[-1] = (merged[-1][0] + text, style)
        else:
            merged.append((text, style))
    return merged


def logo_score(image):
    """How well a logo variant reads on black: colourful and visible wins.
    ESPN's '-dark' variants are sometimes the better choice (Iowa, Auburn)
    and sometimes a plain white knockout (Clemson), so both get scored."""
    width, height, data = image
    opaque = visible = colourful = 0
    for i in range(0, len(data), 16):  # every fourth pixel is plenty
        if data[i + 3] < 110:
            continue
        opaque += 1
        top = max(data[i], data[i + 1], data[i + 2])
        low = min(data[i], data[i + 1], data[i + 2])
        if top >= 70:
            visible += 1
            if top - low >= 60:
                colourful += 1
    if not opaque:
        return -1.0
    return colourful / opaque + 0.5 * visible / opaque


# College baseball logos. ESPN numbers its college baseball teams apart from
# its other college sports, so a baseball id cannot go into the usual logo
# address (58 is Arkansas in baseball and South Florida's logo): the logo
# comes from the team's own data, or from the league's team list. Programs
# that wear a mark of their own on their caps - Arkansas's A, LSU's
# interlocking letters, Mississippi State's M-over-S - show that mark
# instead, from Wikimedia: ESPN's college baseball id -> the file the
# program's Wikipedia article uses (on Commons). Every other team shows
# the school's own mark from ESPN.
CBASE_LOGOS = {
    "58": "Arkansas Razorbacks baseball logo.png",           # Arkansas: the A
    "85": "LSU Baseball logo.png",                           # LSU: interlocking LSU
    "150": "Mississippi State Bulldogs baseball logo.svg",   # Mississippi State: M-over-S
    "193": "USC baseball logo.svg",                          # South Carolina: script SC
    "117": "Clemson Baseball cap logo.svg",                  # Clemson: the C
    "72": "Florida State Seminoles baseball logo.svg",       # Florida State: FS
    "59": "Arizona State Sun Devils baseball logo.svg",      # Arizona State: AS
    "264": "Kansas State baseball cap insignia 2019 version.png",  # Kansas State: KS
    "92": "Ole Miss Rebels baseball logo.svg",               # Ole Miss: the baseball script
    "137": "Fresno State Bulldogs baseball logo.svg",        # Fresno State: FS
}
CBASE_LOGO_TAG = "bb"     # in the logo cache's file names: 6.0 kept wrong ones
_CBASE_SCHOOLS = {"logos": None, "tried": 0.0}
WIKIMEDIA_HOST = "upload.wikimedia.org"


def wikimedia_url(name, px=0):
    """A file on Wikimedia's image servers: a thumbnail `px` wide (always a
    PNG, even for an SVG), or with no px the original. Names starting "en:"
    live on English Wikipedia rather than Commons."""
    import hashlib
    repo = "commons"
    if name.startswith("en:"):
        repo, name = "en", name[3:]
    name = name.replace(" ", "_")
    digest = hashlib.md5(name.encode("utf-8")).hexdigest()
    quoted = urllib.parse.quote(name)
    base = f"https://{WIKIMEDIA_HOST}/wikipedia/{repo}"
    if not px:
        return f"{base}/{digest[0]}/{digest[:2]}/{quoted}"
    tail = ".png" if name.lower().endswith(".svg") else ""
    return f"{base}/thumb/{digest[0]}/{digest[:2]}/{quoted}/{px}px-{quoted}{tail}"


def clear_backdrop(image):
    """A logo drawn on a white sheet with no transparency (LSU's baseball
    mark) has the white around it made see-through: everything near-white
    that reaches the edge, softly at its rim. White inside the mark (letters
    filled white) stays. Returns the image, changed or not."""
    width, height, data = image
    if any(data[i] < 250 for i in range(3, len(data), 4)):
        return image                     # it has transparency already
    def light(i):
        return min(data[i], data[i + 1], data[i + 2])
    corners = [0, width - 1, (height - 1) * width, height * width - 1]
    if sum(light(p * 4) >= 240 for p in corners) < 2:
        return image                     # not a white sheet
    out = bytearray(data)
    seen = bytearray(width * height)
    stack = list(range(width)) + [(height - 1) * width + x for x in range(width)]
    stack += [y * width for y in range(height)] + [y * width + width - 1 for y in range(height)]
    while stack:
        p = stack.pop()
        if seen[p]:
            continue
        seen[p] = 1
        value = light(p * 4)
        if value < 200:
            continue
        out[p * 4 + 3] = 0 if value >= 240 else 255 * (240 - value) // 40
        x, y = p % width, p // width
        if x:
            stack.append(p - 1)
        if x < width - 1:
            stack.append(p + 1)
        if y:
            stack.append(p - width)
        if y < height - 1:
            stack.append(p + width)
    return width, height, out


def cbase_school_logo(ident, timeout=15):
    """ESPN's logo for a college baseball team id, from the league's team
    list (asked for once, on the logo thread, only for a team that came
    without a logo of its own: a favourite, a poll entry)."""
    logos = _CBASE_SCHOOLS["logos"]
    if logos is None and time.time() - _CBASE_SCHOOLS["tried"] > 300:
        _CBASE_SCHOOLS["tried"] = time.time()
        url, spare = Espn().teams("cbase")
        for candidate in [url] + spare:
            try:
                data = http_json(candidate, timeout)
            except Exception:  # noqa: BLE001 - a missing logo is cosmetic
                continue
            logos = {team["id"]: team["logo"] for team in parse_teams(data)
                     if team["id"] and team["logo"]}
            _CBASE_SCHOOLS["logos"] = logos
            break
    return (logos or {}).get(str(ident or ""), "")


def cbase_logo_urls(team, size):
    """A college baseball team's own mark from Wikimedia where it wears one,
    then the school's logo from ESPN; never ESPN's address built from the
    baseball id, which belongs to another school."""
    ident = str(team.get("id") or "")
    urls = []
    mark = CBASE_LOGOS.get(ident)
    if mark:
        # 250 is a thumbnail width Wikimedia keeps ready, and one file does
        # for both sizes; a PNG smaller than that has no thumbnail, so its
        # original comes next
        urls.append(wikimedia_url(mark, 250))
        if not mark.lower().endswith(".svg"):
            urls.append(wikimedia_url(mark))
    href = team.get("logo") or (cbase_school_logo(ident) if ident else "")
    if href:
        urls.extend(espn_logo_variants(href, size) if "espncdn.com" in href else [href])
    return urls


def espn_logo_variants(href, size):
    """ESPN's dark-background variant of a logo and the logo itself, both
    resized on ESPN's side, then the full-size original."""
    path = urllib.parse.urlsplit(href).path
    dark = path.replace("/500/", "/500-dark/", 1)
    urls = []
    for candidate in ([dark] if dark != path else []) + [path]:
        urls.append(f"https://a.espncdn.com/combiner/i?img={candidate}&w={size}&h={size}")
    urls.append(href)
    return urls


def logo_urls(league, team, size=LOGO_SOURCE_PX):
    """Candidate variants: ESPN's dark-background logo and the normal one,
    both resized on ESPN's side, then the full-size original."""
    if league == "cbase":
        return cbase_logo_urls(team, size)
    href = team.get("logo") or ""
    if not href and league == "ahl" and team.get("id"):
        href = HT_LOGO.format(team["id"])         # a favourite keeps no logo of its own
    if "assets.leaguestat.com" in href:
        # the AHL keeps some logos per season (335_90.png) and some not
        ident = team.get("id") or ""
        seasons = [s.get("season_id") for s in _HT_SEASONS["list"]][:5] or \
            ["94", "93", "92", "90", "86"]
        base = HT_LOGO.rsplit("/", 1)[0]
        return [href] + [f"{base}/{ident}_{sid}.png" for sid in seasons] + \
            [f"{base}/50x50/{ident}.png"]
    if href and "espncdn.com" not in href:
        return [href]
    if not href:
        # (college baseball went to cbase_logo_urls: its ids are not these)
        folder = {"nfl": "nfl", "nhl": "nhl", "cfb": "ncaa", "nba": "nba",
                  "cbb": "ncaa", "mlb": "mlb"}.get(league)
        if not folder:
            return []
        ident = team.get("id") if league in COLLEGE_LEAGUES else \
            (team.get("abbr") or "").lower()
        if not ident:
            return []
        href = f"https://a.espncdn.com/i/teamlogos/{folder}/500/{ident}.png"
    return espn_logo_variants(href, size)


def shrink_image(image, target=LOGO_SOURCE_PX):
    """Box-filter a big logo down to about `target` pixels a side, once, so
    drawing it every frame stays cheap. ESPN resizes its own; the AHL's
    arrive at 500 x 500."""
    width, height, data = image
    factor = max(width, height) // target
    if factor < 2:
        if max(width, height) > target * 5 // 4:      # a 250-pixel picture, say
            scale = target / max(width, height)
            return scale_rgba(image, round(width * scale), round(height * scale))
        return image
    new_w, new_h = width // factor, height // factor
    out = bytearray(new_w * new_h * 4)
    area = factor * factor
    for y in range(new_h):
        for x in range(new_w):
            r = g = b = a = 0
            for dy in range(factor):
                base = ((y * factor + dy) * width + x * factor) * 4
                for dx in range(factor):
                    i = base + dx * 4
                    alpha = data[i + 3]
                    r += data[i] * alpha
                    g += data[i + 1] * alpha
                    b += data[i + 2] * alpha
                    a += alpha
            o = (y * new_w + x) * 4
            if a:
                out[o:o + 4] = bytes((r // a, g // a, b // a, a // area))
    return new_w, new_h, out


def http_bytes(url, timeout=15):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT,
                                                   "Accept": "image/png,*/*"})
    return net_read(request, timeout)[0]


class LogoStore:
    """Fetches and decodes logos on a background thread, keeps the PNGs on
    disk so each team downloads once, and never blocks the screen."""

    def __init__(self, on_ready=None, timeout=15, directory=LOGO_DIR):
        self.directory = directory
        self.timeout = timeout
        self.on_ready = on_ready
        self.images = {}
        self.failed = set()
        self.pending = set()
        self.lock = threading.Lock()
        self.queue = queue.Queue()
        threading.Thread(target=self._worker, daemon=True).start()

    def _path(self, key):
        return os.path.join(self.directory, re.sub(r"[^A-Za-z0-9_-]", "_",
                                                   "-".join(key)) + ".png")

    def get(self, league, team, raw=False):
        """The decoded logo for drawing in blocks; with raw, the PNG file
        itself (LOGO_IMAGE_PX) for a terminal that shows real images. None
        while it loads, or when there is none."""
        ident = str(team.get("id") or team.get("abbr") or "")
        if not ident:
            return None
        if league == "cbase":
            ident += "-" + CBASE_LOGO_TAG      # a new file name, so 6.0's are not reused
        key = (league, ident, "png") if raw else (league, ident)
        with self.lock:
            if key in self.images:
                return self.images[key]
            if key in self.failed or key in self.pending:
                return None
            self.pending.add(key)
        # the addresses are worked out on the logo thread: a college
        # baseball team may need the league's team list first
        self.queue.put((key, league, dict(team), LOGO_IMAGE_PX if raw else LOGO_SOURCE_PX))
        return None

    def _worker(self):
        while True:
            key, league, team, size = self.queue.get()
            raw = len(key) > 2
            image = None
            path = self._path(key)
            try:
                with open(path, "rb") as handle:
                    blob = handle.read()
                image = (blob if png_size(blob) else None) if raw else png_decode(blob)
            except OSError:
                image = None
            if image is None:
                try:
                    urls = logo_urls(league, team, size)
                except Exception:  # noqa: BLE001 - a missing logo is cosmetic
                    urls = []
                best, mark_failed = None, False
                for url in urls:
                    decoded = None
                    for attempt in range(2):
                        try:
                            blob = http_bytes(url, self.timeout)
                            decoded = png_decode(blob)
                        except urllib.error.HTTPError as exc:
                            if exc.code == 429 and not attempt:
                                time.sleep(2)      # busy for a moment: once more
                                continue
                        except Exception:  # noqa: BLE001 - a missing logo is cosmetic
                            pass
                        break
                    if decoded is None:
                        mark_failed = mark_failed or WIKIMEDIA_HOST in url
                        continue
                    if WIKIMEDIA_HOST in url:
                        cleared = clear_backdrop(decoded)
                        if cleared is not decoded:
                            decoded, blob = cleared, png_encode(*cleared)
                    score = logo_score(decoded)
                    # the full-size original is only a fallback for when
                    # both resized variants fail
                    if best is None or score > best[0]:
                        best = (score, blob, decoded, url)
                    resized = [u for u in urls if "combiner" in u]
                    if url not in resized or url == resized[-1]:
                        break
                if best is not None:
                    _, blob, image, used = best
                    if raw:
                        image = blob
                    # a team's own mark that could not be fetched this time
                    # (Wikimedia busy) is tried again next run: the school
                    # logo standing in for it is shown but not kept
                    keep = WIKIMEDIA_HOST in used or not mark_failed
                    # one Wikimedia file serves both sizes, so it is kept for
                    # both: the other size then needs no request of its own
                    paths = [path] if keep else []
                    if WIKIMEDIA_HOST in used:
                        paths.append(self._path(key[:2] if raw else key + ("png",)))
                    try:
                        for target in paths:
                            os.makedirs(self.directory, exist_ok=True)
                            with open(target + ".tmp", "wb") as handle:
                                handle.write(blob)
                            os.replace(target + ".tmp", target)
                    except OSError:
                        pass
            if image is not None and not raw:
                image = shrink_image(image)
            with self.lock:
                self.pending.discard(key)
                if image is None:
                    self.failed.add(key)
                else:
                    self.images[key] = image
            if self.on_ready:
                self.on_ready()


# --------------------------------------------------------------------------
# pictures: team badges, and real images in terminals that can show them
# --------------------------------------------------------------------------
#
# In a text terminal (GNOME Terminal, Konsole, xterm ...) a team is shown by
# its badge: its letters in a bold pixel font on its own colours, with a rim
# and a bottom bar like a 1980s score bug - sharp in six rows, where a logo
# drawn in blocks only reads when it is big. Kitty and Ghostty can show real
# images: there sportst sends each picture once with the Kitty graphics
# protocol and then draws Unicode placeholder cells where it goes (U+10EEEE
# with two combining marks giving the cell's row and column in the picture,
# and a foreground colour - a palette index - naming the picture). curses
# keeps drawing the screen as text; the terminal paints the picture over
# those cells. main() asks the terminal what it can do before curses starts.

def png_encode(width, height, rgba):
    """A PNG of `width` x `height` RGBA pixels (4 bytes each), standard
    library only."""
    import struct
    import zlib
    stride = width * 4
    raw = b"".join(b"\x00" + bytes(rgba[y * stride:(y + 1) * stride]) for y in range(height))

    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + \
            struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)
    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def png_size(blob):
    """(width, height) from a PNG's header, or None."""
    if not blob or len(blob) < 24 or not blob.startswith(b"\x89PNG\r\n\x1a\n"):
        return None
    width = int.from_bytes(blob[16:20], "big")
    height = int.from_bytes(blob[20:24], "big")
    return (width, height) if width and height else None


def pixel_png(rows, colours, out_w, out_h):
    """Pixel art - rows of palette letters, '.' clear - as a PNG of about
    out_w x out_h, each pixel a block of whole pixels so the terminal shows
    it crisp rather than blurred."""
    src_h, src_w = len(rows), len(rows[0])
    scale = max(1e-6, min(out_w / src_w, out_h / src_h))
    width, height = max(1, round(src_w * scale)), max(1, round(src_h * scale))
    xs = [min(src_w - 1, int(x / scale)) for x in range(width)]
    ys = [min(src_h - 1, int(y / scale)) for y in range(height)]
    palette = {".": b"\x00\x00\x00\x00"}
    for letter, value in colours.items():
        rgb = hex_to_rgb("#" + value) or (0, 0, 0)
        palette[letter] = bytes(rgb) + b"\xff"
    cache = {}
    out = []
    for sy in ys:
        line = cache.get(sy)
        if line is None:
            source = rows[sy]
            line = b"".join(palette.get(source[sx], palette["."]) for sx in xs)
            cache[sy] = line
        out.append(line)
    return png_encode(width, height, b"".join(out))


