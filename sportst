    # -- the Game Center (Z) ----------------------------------------------

    def open_center(self, league=None, event=None):
        league = league or self.league
        event = event or self.current_event()
        if not event:
            if is_olympic(league) and self.on_board:
                self.status_message = ("Nothing on file for this sport at these Games yet "
                                       "- h / l step to another Games, E picks a sport.")
            else:
                self.status_message = ("No games on this day - h / l or C finds one, "
                                       "then Z." if self.on_board else
                                       "Pick a game first - the Game Center shows one "
                                       "game.")
            return
        if is_wiki_sport(league):
            # an Olympic event Wikipedia covers: the Event Center, its podium
            events, _ = self.wiki_events() if league == self.league else ([], None)
            self.center = {"league": league, "id": event["id"], "event": event,
                           "wiki": True, "events": events or [event], "flash": None,
                           "scores": (None, None), "state": "post", "day": None,
                           "data": None, "opened": time.time()}
            self.dirty = True
            return
        moment = _local(event.get("date"))
        self.center = {"league": league, "id": event["id"], "event": event,
                       "day": moment.date() if moment else self.day,
                       "scores": (event["away"]["score"], event["home"]["score"]),
                       "state": event["state"], "flash": None, "events": [event],
                       "data": None, "opened": time.time()}
        self.dirty = True

    def close_center(self):
        self.center = None
        self.palette.logo_begin(("free", time.time()))
        self.dirty = True

    def center_data(self):
        """(event, summary) for the game on the Game Center, refreshed every ten
        seconds while it is live; also keeps that day's games for j / k."""
        center = self.center
        league = center["league"]
        live = center["event"]["state"] == "in"
        if is_olympic(league):
            key = ("sb", league)
            url, spare = self.api.scoreboard(league)
        else:
            group = self.cfb_group if league == "cfb" else ""
            groups = self.cfb_group if league == "cfb" else LEAGUES[league].get("groups")
            key = ("sb", league, "d", center["day"].isoformat(), group)
            url, spare = self.api.scoreboard(league, day=center["day"], groups=groups)
        result = self.fetcher.get(key, url, ttl=10 if live else 60, fallbacks=spare)
        if result.data is not None and result.data is not center["data"]:
            events = parse_scoreboard(result.data)
            if BETTING.enabled and league in BETTING_LEAGUES:
                attach_lines(events, league, self.book, None, center["id"])
            center["data"] = result.data
            center["events"] = events or center["events"]
            found = next((e for e in events if e["id"] == center["id"]), None)
            if found:
                center["event"] = found
        url, spare = self.api.summary(league, center["id"])
        summary = self.fetcher.get(("sum", league, center["id"]), url,
                                   ttl=10 if live else 300, fallbacks=spare)
        if summary.data:
            prepare_summary(summary.data, league)
        return center["event"], summary.data

    def center_step(self, delta):
        """The previous or next game of that day on the Game Center."""
        center = self.center
        events = center.get("events") or []
        ids = [e["id"] for e in events]
        if center["id"] not in ids or len(ids) < 2:
            return
        event = events[(ids.index(center["id"]) + delta) % len(events)]
        league = center["league"]
        self.open_center(league, event)
        if league == self.league:
            self.selected_id = event["id"]

    def draw_center(self, height, width):
        try:
            self._draw_center(height, width)
        except curses.error:
            pass
        except Exception as exc:  # noqa: BLE001 - a TUI must not die over a screen
            self.close_center()
            self.status_message = f"⚠ Game Center stopped: {type(exc).__name__}: {exc}"

    def _draw_center(self, height, width):
        center = self.center
        league = center["league"]
        if center.get("wiki"):
            event = center["event"]
            page = self.load_event_page(event)
            meta = LEAGUES[league]
            rows = compose_event_center(event, page.data, league, width, height,
                                        self.favorites, f"{meta['label']} · {meta['games']}",
                                        loading=page.loading and not page.data)
            for y, line in enumerate(rows[:height]):
                self.put_spans(y, 0, line)
            return
        event, summary = self.center_data()
        now = time.time()
        # a score since the last look flashes across the screen
        scores = (event["away"]["score"], event["home"]["score"])
        old = center["scores"]
        if event["state"] == "in" and center["state"] == "in":
            for index, side in enumerate(("away", "home")):
                if scores[index] is not None and old[index] is not None and \
                        scores[index] > old[index]:
                    word = center_score_word(league, scores[index] - old[index])
                    if word:
                        center["flash"] = (side, word, now + 6)
        if event["state"] == "post" and center["state"] == "in":
            winner = "home" if (scores[1] or 0) > (scores[0] or 0) else "away"
            center["flash"] = (winner, "FINAL", now + 6)
        center["scores"], center["state"] = scores, event["state"]
        flash = center["flash"] if center["flash"] and now < center["flash"][2] else None
        meta = LEAGUES[league]
        context = f"{meta['label'] if is_olympic(league) else meta['name']}"
        if not is_olympic(league):
            moment = _local(event.get("date"))
            if moment:
                context += f" · {moment.strftime('%a %b %-d')}"
        if summary is None and event["state"] != "pre":
            context += " · loading the game file…"
        self.palette.logo_begin(("center", league, center["id"]))
        rows = compose_center(event, summary, league, width, height, now, flash,
                              self.favorites, context,
                              art=lambda side, cols, rows_, ev=event:
                              self.team_art(league, ev[side], cols, rows_))
        for y, line in enumerate(rows[:height]):
            self.put_spans(y, 0, line)
        if flash or (event["state"] == "pre" and countdown_text(event)[1].startswith("MIN")):
            self.dirty = True           # keep the banner flashing, the seconds ticking

    def handle_center_key(self, key):
        if key == curses.KEY_RESIZE:
            self.apply_background()
        elif key in (27, ord("q"), ord("z")):
            self.close_center()
        elif key == ord("?"):
            self.show_help = True
            self.help_scroll = 0
            self._help_fits = False
        elif key == ord("i"):
            self.show_info = True
            self.info_scroll = 0
            self._info_fits = False
        elif key in (ord("j"), ord("l"), curses.KEY_DOWN, curses.KEY_RIGHT):
            self.center_step(1)
        elif key in (ord("k"), ord("h"), curses.KEY_UP, curses.KEY_LEFT):
            self.center_step(-1)
        elif key in (10, 13, curses.KEY_ENTER) and self.center.get("wiki"):
            event = self.center["event"]
            self.close_center()
            self.selected_id = event["id"]
            if "Results" in self.tabs:
                self.tab = self.tabs.index("Results")
                self.scroll["Results"] = 0
        elif key in (10, 13, curses.KEY_ENTER):
            event = self.center["event"]
            league = self.center["league"]
            self.close_center()
            self.open_game(league, event, "Scouting" if event["state"] == "pre"
                           else "Boxscore")
        elif key == ord("r"):
            center = self.center
            if center.get("wiki"):
                ident = center["id"]
                self.fetcher.expire(lambda k: isinstance(k, tuple) and (
                    k == ("wikievent", ident) or k == ("wikisport", center["league"])))
            else:
                self.fetcher.expire(lambda k: isinstance(k, tuple) and len(k) > 1 and
                                    k[0] in ("sb", "sum") and k[1] == center["league"])
            self.status_message = "Refreshing."
        elif key == ord("x") and self.player:
            self.stop_clip()
        return True

    def draw_overview(self, top, height, width):
        inner = width - 4
        entries = overview_entries(self.favorites)
        self.overview_cursor = clamp(self.overview_cursor, 0, max(0, len(entries) - 1))
        if not entries:
            self.overview_side = "today"
        elif self.overview_side not in ("last", "next", "today"):
            self.overview_side = "next"
        room = min(height - (8 if entries else 6), 11)
        logo = self.title_lines(inner, room)
        self.draw_lines(logo, top, 2, len(logo), inner, 0)
        rest_top = top + len(logo)
        rest = height - len(logo)
        if rest < 4:
            return
        today_min = 7
        if not entries:
            hint = wrap_spans("No favourite teams yet. Star yours on the Favorites tab (0) - L "
                              "picks the league - and their latest results, next games and "
                              "live scores will lead this screen, with alerts when they "
                              "score.", inner, "dim")
            hint_h = len(hint) + 2
            if rest >= hint_h + today_min:
                self.draw_lines_box(rest_top, hint_h, width, "Your teams", hint)
                self.draw_today(rest_top + hint_h, rest - hint_h, width)
            else:
                self.draw_lines_box(rest_top, rest, width, "Your teams", hint)
            return
        glances = {(league, team["id"]): self.load_glance(league, team)
                   for league, team in entries}
        key = "Overview"
        narrow = width < self.SPLIT_MIN_WIDTH
        # real logos beside the teams where the terminal shows pictures
        gap = 3 if self.graphics.enabled and self.team_logos != "off" else 0
        spots_both, spots_last, spots_next = {}, {}, {}
        if narrow:
            both, cursor_line = render_overview_rows(self, entries, glances, inner, "both",
                                                     gap, spots_both)
            need = len(both) + 2
        else:
            pane = self.pane_width(width) - 4
            last, cursor_line = render_overview_rows(self, entries, glances, pane, "last",
                                                     gap, spots_last)
            upcoming, _ = render_overview_rows(self, entries, glances, pane, "next", gap,
                                               spots_next)
            need = max(len(last), len(upcoming)) + 2
        fav_h = rest
        if rest - min(need, rest) >= today_min:
            fav_h = min(need, rest)
        elif rest >= 6 + today_min + 4:
            fav_h = rest - today_min - 4   # the favourites scroll; Today still shows
        view = fav_h - 2
        if narrow:
            offset = self.scroll[key]
            if self._mouse_pick:
                pass
            elif cursor_line < offset:
                offset = max(0, cursor_line - 1)
            elif cursor_line + 1 >= offset + view:
                offset = cursor_line + 2 - view
            self.scroll[key] = clamp(offset, 0, max(0, len(both) - view))
            caption = Line().add(" Your teams ", "accent").add(
                "· result: enter for game stats · next: enter for scouting · ← → ", "muted")
            self.draw_box(rest_top, 0, fav_h, width)
            self.draw_lines([caption], rest_top, 2, 1, inner, 0)
            self.draw_lines(both, rest_top + 1, 2, view, inner, self.scroll[key])
            self.draw_scrollbar(rest_top + 1, width - 2, view, len(both), self.scroll[key])
            if gap:
                self.overview_logos(spots_both, rest_top + 1, 3, view, self.scroll[key],
                                    cursor_line if self.overview_side == "last" else -1)
            self.hot_overview(entries, "both", rest_top + 1, view, 1, width - 2,
                              self.scroll[key])
        else:
            offset = self.scroll[key]
            if self._mouse_pick:
                pass
            elif cursor_line < offset:
                offset = max(0, cursor_line - 1)
            elif cursor_line >= offset + view:
                offset = cursor_line - view + 1
            self.scroll[key] = offset
            self.draw_two_panes(rest_top, fav_h, width, key, [
                (Line().add(" Latest results ", "accent").add(
                    "· enter: game stats · ← → other side ", "muted"),
                 last),
                (Line().add(" Up next ", "accent").add("· enter: its scouting report ",
                                                      "muted"), upcoming)])
            half = width // 2
            for which, x0, x1 in (("last", 1, half - 2), ("next", half + 1, width - 2)):
                self.hot_overview(entries, which, rest_top + 1, fav_h - 2, x0, x1,
                                  self.scroll[key])
            if gap:
                for which, spots, x in (("last", spots_last, 3),
                                        ("next", spots_next, half + 3)):
                    self.overview_logos(spots, rest_top + 1, x, view, self.scroll[key],
                                        cursor_line if self.overview_side == which else -1)
        self.wheel(rest_top + 1, rest_top + fav_h - 1, 1, width - 1, WHEEL_TEAMS[0],
                   WHEEL_TEAMS[1], 1)
        if rest - fav_h >= today_min:
            self.draw_today(rest_top + fav_h, rest - fav_h, width)
        else:
            self._today_items = []

    def overview_logos(self, spots, top, x, view, offset, chosen):
        """The favourites' logos down one Overview pane: `spots` maps a line
        of the pane to its (league, team); `chosen` is the highlighted line."""
        rows = [spots.get(offset + row) for row in range(view)]
        self.logo_column(None, rows, top, x,
                         selected=chosen - offset if 0 <= chosen - offset < view else -1)

    def title_lines(self, width, room):
        """The Overview's SPORTS TERMINAL title: a real picture where the
        terminal shows them (Kitty, Ghostty), the block letters elsewhere.
        Either way it takes the same rows, and the tagline stays text."""
        lines = render_logo_lines(width, room)
        if not self.graphics.enabled or len(lines) < 5:
            return lines
        rows = len(lines) - 1
        cols = min(width, 150)
        scheme = CURRENT_SCHEME["name"]
        key = (scheme, cols, rows, self.cell)
        png = self._title_pngs.get(key)
        if png is None:
            try:
                png = title_picture(scheme, int(cols * self.cell[0]), int(rows * self.cell[1]))
            except Exception:  # noqa: BLE001 - the block letters will do
                return lines
            self._title_pngs = {key: png}
        image_id = self.graphics.place(("title", scheme), png, cols, rows)
        if not image_id:
            return lines
        pad = " " * max(0, (width - cols) // 2)
        art = [Line().add(pad, "normal").extend_spans(cells)
               for cells in image_cells(image_id, cols, rows)]
        return art + lines[-1:]

    def draw_today(self, top, height, width):
        """Every league's games today in columns: live now, coming up, final."""
        try:
            slate = self.today_slate()
        except Exception:  # noqa: BLE001 - never a crash over a list
            slate = {}
        sections = today_sections(slate, self.favorites)
        items = [item for _, group in sections for item in group]
        self._today_items = items
        self.today_cursor = clamp(self.today_cursor, 0, max(0, len(items) - 1))
        focus = self.overview_side == "today"
        counts = {name: len(group) for name, group in sections}
        caption = Line().add(" Today across every sport ", "accent")
        caption.add(f"· {counts['LIVE NOW']} live · {counts['COMING UP']} to come · "
                    f"{counts['FINAL']} final ", "muted")
        caption.add("· enter opens " if focus else "· ↓ to pick one ", "muted")
        self.draw_box(top, 0, height, width)
        self.draw_lines([caption], top, 2, 1, width - 4, 0)
        view = max(1, height - 2)
        inner = width - 4
        if not items:
            waiting = time.time() - self.started < 20
            self.put(top + 1, 2, "Today's games are on their way…" if waiting else
                     "No games today in any league.", self.palette("dim"))
            return
        cols = max(1, (inner + 2) // 56) if inner >= 100 else 1
        col_w = (inner - 2 * (cols - 1)) // cols
        cells = []
        index = 0
        for name, group in sections:
            if not group:
                continue
            cells.append(("head", name, len(group)))
            for _ in group:
                cells.append(("game", index))
                index += 1
        capacity = view * cols
        cursor_cell = next((n for n, cell in enumerate(cells)
                            if cell[0] == "game" and cell[1] == self.today_cursor), 0)
        page = cursor_cell // capacity if focus else 0
        pages = (len(cells) + capacity - 1) // capacity
        self._today_view = view
        self._today_cells = cells
        self.wheel(top + 1, top + height - 1, 1, width - 1, WHEEL_TODAY[0], WHEEL_TODAY[1], 1)
        for n, cell in enumerate(cells[page * capacity:(page + 1) * capacity]):
            col, row = divmod(n, view)
            x = 2 + col * (col_w + 2)
            y = top + 1 + row
            if cell[0] == "head":
                self.put(y, x, f" {cell[1]} · {cell[2]}"[:col_w], self.palette("header"))
                continue
            league, event = items[cell[1]]
            chosen = focus and cell[1] == self.today_cursor
            line = today_line(league, event, self.favorites, col_w, chosen)
            self.draw_lines([line], y, x, 1, col_w, 0)
            self.hot(y, x, x + col_w, lambda i=cell[1]: self.click_today(i),
                     lambda i=cell[1]: self.click_today(i, True))
        if pages > 1:
            tag = f" page {page + 1}/{pages} · j/k "
            self.put(top + height - 1, max(2, width - len(tag) - 3), tag,
                     self.palette("muted"))

    def hot_overview(self, entries, which, top, view, x0, x1, offset):
        """Clickable rows for your teams on the Overview."""
        for at, spot in enumerate(overview_line_map(entries, which)):
            shown_at = at - offset
            if spot and 0 <= shown_at < view:
                index, side = spot
                self.hot(top + shown_at, x0, x1,
                         lambda i=index, s=side: self.click_overview(i, s),
                         lambda i=index, s=side: self.click_overview(i, s, True))

    def today_beside(self, direction):
        """The game in the next column over (direction 1) or the one before
        (-1), level with the picked one - the columns hold section headings
        too, so this goes by screen position, not by count."""
        cells = getattr(self, "_today_cells", []) or []
        view = max(1, self._today_view)
        games = [n for n, cell in enumerate(cells) if cell[0] == "game"]
        if not games:
            return self.today_cursor
        here = next((n for n in games if cells[n][1] == self.today_cursor), games[0])
        target = clamp(here + direction * view, games[0], games[-1])
        while target < len(cells) and cells[target][0] != "game":
            target += 1
        if target >= len(cells):
            target = games[-1]
        return cells[target][1]

    def click_today(self, index, open_it=False):
        """A click on the Today list picks that game; a second click opens it."""
        items = getattr(self, "_today_items", [])
        game = items[index] if 0 <= index < len(items) else (None, {})
        again = self.clicked_again("today", game[0], game[1].get("id"))
        self.overview_side = "today"
        self.today_cursor = index
        if again or open_it:
            self.open_today(index)
            return True
        return False

    def open_today(self, index=None):
        items = getattr(self, "_today_items", [])
        if not items:
            return
        index = clamp(self.today_cursor if index is None else index, 0, len(items) - 1)
        league, event = items[index]
        self.open_game_best(league, event)

    def open_game_best(self, league, event):
        """A live game opens in the Game Center, one to come in its Scouting
        report, a final in its Game Stats."""
        state = event.get("state")
        if state == "in":
            self.open_game(league, event, "center")
        elif state == "pre":
            self.open_game(league, event, "Scouting")
        else:
            self.open_game(league, event, "Game Stats")

    def peek_center(self, league, game):
        """The Game Center for a game known only from a team's schedule (a
        team page, the Overview): it opens over the screen you are on once
        that day's scoreboard has the game, and esc comes back to it."""
        day = game_day(game.get("date"), bool(game.get("time_tba")))
        if not day and not is_olympic(league):
            self.status_message = "That game has no date yet."
            return
        self.pending_center = (league, str(game["id"]), day)
        self.status_message = "Opening the Game Center…"

    def resolve_pending_center(self):
        """Open the Game Center peek_center asked for, once its day's
        scoreboard is in (it loads in the background)."""
        league, ident, day = self.pending_center
        if is_olympic(league):
            key = ("sb", league)
            url, spare = self.api.scoreboard(league)
        else:
            groups = self.cfb_group if league == "cfb" else LEAGUES[league].get("groups")
            key = ("sb", league, "d", day, self.cfb_group if league == "cfb" else "")
            url, spare = self.api.scoreboard(league, day=Date.fromisoformat(day),
                                              groups=groups)
        result = self.fetcher.get(key, url, ttl=60, fallbacks=spare)
        if result.data is not None:
            found = next((e for e in parse_scoreboard(result.data)
                          if str(e["id"]) == ident), None)
            self.pending_center = None
            if found:
                self.status_message = ""
                self.open_center(league, found)
            else:
                self.status_message = "That game is not on its day's scoreboard yet."
        elif result.error and not result.loading:
            self.pending_center = None
            self.status_message = f"Could not open the Game Center: {result.error}"
        else:
            self.dirty = True          # still loading: look again on the next frame

    def open_overview_game(self, which, center=False):
        entries = overview_entries(self.favorites)
        if not entries:
            self.status_message = "Star some teams on the Favorites tab first (0)."
            return
        league, team = entries[clamp(self.overview_cursor, 0, len(entries) - 1)]
        glance = self.load_glance(league, team).data
        if not glance:
            self.status_message = "Still loading that team's schedule."
            return
        game = (glance.get("live") or glance.get("next")) if which == "next" \
            else glance.get("last")
        live = which == "next" and game is glance.get("live") and game is not None
        if not game:
            self.status_message = ("No game scheduled." if which == "next"
                                   else "No completed game yet.")
            return
        if center:
            # the Game Center over the Overview: esc comes back here
            self.peek_center(league, game)
            return
        moment = _local(game["date"])
        if game.get("time_tba"):
            try:
                moment = datetime.strptime(str(game["date"])[:10], "%Y-%m-%d")
            except ValueError:
                pass
        self.switch_league(league)
        if moment:
            self.day = moment.date()
        self.week_mode = False
        self.week_pinned = False
        self.selected_id = game["id"]
        self.selected_index = 0
        # a result opens its Game Stats; the next game its Scouting report,
        # or its Game Stats once it has started; z asked for the Game Center
        target = "Scouting" if which == "next" and not live else "Game Stats"
        tabs = self.tabs
        self.tab = tabs.index(target) if target in tabs else tabs.index("Scoreboard")
        self.scroll[target] = 0
        self.detail_scroll = 0

    def handle_overview_key(self, key):
        count = len(overview_entries(self.favorites))
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10,
                 curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        today = self._today_items
        if key in WHEEL_TODAY:
            # the wheel over the Today list moves through it, wherever the focus was
            if today:
                self.overview_side = "today"
                self.today_cursor = clamp(self.today_cursor + (1 if key == WHEEL_TODAY[0]
                                                               else -1), 0, len(today) - 1)
            return True
        if key in WHEEL_TEAMS:
            if count:
                if self.overview_side == "today":
                    self.overview_side = "next"
                self.overview_cursor = clamp(self.overview_cursor + (
                    1 if key == WHEEL_TEAMS[0] else -1), 0, count - 1)
            return True
        if self.overview_side == "today":
            if key in moves:
                target = self.today_cursor + moves[key]
                if target < 0 and count and moves[key] == -1:
                    self.overview_side = "next"     # back up into your teams
                    self.overview_cursor = count - 1
                else:
                    self.today_cursor = clamp(target, 0, max(0, len(today) - 1))
            elif key in (ord("h"), curses.KEY_LEFT, ord("l"), curses.KEY_RIGHT):
                self.today_cursor = self.today_beside(
                    1 if key in (ord("l"), curses.KEY_RIGHT) else -1)
            elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
                self.open_today()
            elif key == ord("z") and today:
                league, event = today[clamp(self.today_cursor, 0, len(today) - 1)]
                self.open_center(league, event)       # over the Overview: esc comes back
            else:
                return False
            return True
        if key in moves:
            target = self.overview_cursor + moves[key]
            if target > count - 1 and moves[key] == 1 and today:
                self.overview_side = "today"        # down into today's games
                self.today_cursor = 0
            else:
                self.overview_cursor = clamp(target, 0, max(0, count - 1))
        elif key in (ord("h"), curses.KEY_LEFT):
            self.overview_side = "last"
        elif key in (ord("l"), curses.KEY_RIGHT):
            self.overview_side = "next"
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.open_overview_game(self.overview_side)
        elif key == ord("b"):
            self.open_overview_game("last")
        elif key == ord("z") and count:
            self.open_overview_game(self.overview_side, center=True)
        else:
            return False
        return True

    # -- the Settings tab ------------------------------------------------

    def setting_value(self, spec):
        """What the app is using right now, which for the keys that change it
        for one run (a, + and -, b) can differ from what is saved."""
        key = spec["key"]
        if key == "auto_refresh":
            return self.auto_refresh
        if key == "refresh_seconds":
            return self.interval
        if key == "betting_book":
            return self.bet_book
        value = self.config.get(key, DEFAULT_CONFIG.get(key))
        if key == "betting_top_books":
            return self.top_books()
        return value

    def setting_unsaved(self, spec):
        key = spec["key"]
        if key == "auto_refresh":
            return bool(self.config.get("auto_refresh", True)) != self.auto_refresh
        if key == "refresh_seconds":
            return int(self.config.get("refresh_seconds", 30)) != self.interval
        return False

    def cache_usage(self):
        """Walking the cache folder every frame would be wasteful."""
        stamp, usage = getattr(self, "_cache_usage", (0.0, {}))
        if time.time() - stamp > 10:
            usage = cache_usage()
            self._cache_usage = (time.time(), usage)
        return usage

    def save_settings(self, quiet=False):
        try:
            save_config(self.config, self.args.config)
        except OSError as exc:
            self.status_message = f"⚠ Could not save settings: {exc}"
            return False
        if not quiet:
            self.status_message = f"Saved to {home_path(self.args.config)}."
        return True

    def rebuild_palette(self):
        self.palette = Palette(enabled=not self.args.no_color,
                               floor=float(self.config.get("color_floor", 0.62)),
                               true_color=not self.args.no_true_color,
                               background=self.config.get("background", APP_BG))
        if not self.palette.image_pair_base:
            self.graphics.clear()
            self.graphics.enabled = False    # no colour pair to name a picture by
        try:
            self.stdscr.bkgd(" ", 0)
        except curses.error:
            pass
        self.apply_background()
        self.stdscr.clearok(True)

    def apply_setting(self, key):
        """Make a changed value take effect without a restart."""
        config = self.config
        if key == "auto_refresh":
            self.auto_refresh = bool(config["auto_refresh"])
        elif key == "refresh_seconds":
            self.interval = int(config["refresh_seconds"])
        elif key == "timeout_seconds":
            self.fetcher.timeout = int(config["timeout_seconds"])
            self.logos.timeout = int(config["timeout_seconds"])
        elif key == "api_host":
            self.api = Api(config["api_host"])
            self.fetcher.expire()
        elif key in ("team_colors", "team_color_overrides") or key.startswith("upset_") \
                or key in ("betting_lines", "odds_provider", "line_history_days"):
            THEME.configure(config)
            if key == "upset_color":
                self.rebuild_palette()
        elif key in ("color_floor", "background"):
            self.rebuild_palette()
        elif key == "color_scheme":
            apply_scheme(config["color_scheme"])
            self.rebuild_palette()
        elif key == "logo_art":
            self.logo_style = str(config["logo_art"] or "off").lower()
        elif key == "team_logos":
            self.team_logos = str(config["team_logos"] or "badges").lower()
        elif key == "pictures" and str(config["pictures"]).lower() == "text":
            self.graphics.clear()            # text art from now on; the rest waits
            self.graphics.enabled = False    # for the next start, which asks again
            if TERMINAL.get("images"):
                TERMINAL.update(images=False, why="text art (Settings, Pictures)")
        elif key == "mlb_statcast":
            self.statcast = bool(config["mlb_statcast"])
        elif key == "mouse":
            self.apply_mouse()
        elif key == "cfb_group":
            self.cfb_group = str(config["cfb_group"])
            self.selected_id = None
            self.selected_index = 0
        elif key == "betting_book":
            self.bet_book = str(config["betting_book"] or "avg")
            self.bet_index = 0
        elif key in ("extra_stat_sources", "betting_sources"):
            self.fetcher.expire()

    def set_setting(self, spec, value):
        key = spec["key"]
        if key == "color_scheme":
            # a background left at the old scheme's own follows the new one
            before = scheme_background(self.config.get("color_scheme", "espn"))
            if str(self.config.get("background", APP_BG)).upper() == before.upper():
                self.config["background"] = scheme_background(value)
        self.config[key] = value
        self.apply_setting(key)
        if self.save_settings(quiet=True):
            note = " (next start)" if spec.get("apply") == "start" else ""
            self.status_message = f"{spec['label']}: {setting_text(spec, value)}{note}."

    def settings_spec(self):
        self.settings_cursor = clamp(self.settings_cursor, 0, len(SETTING_ROWS) - 1)
        return SETTING_ROWS[self.settings_cursor]

    def edit_setting(self):
        spec = self.settings_spec()
        kind = spec["kind"]
        value = self.setting_value(spec)
        if kind == "action":
            self.run_setting_action(spec["key"])
        elif kind == "bool":
            self.set_setting(spec, not value)
        elif kind == "choice":
            choices = spec_choices(spec)
            items = [{"label": label, "detail": "current" if str(option) == str(value)
                      else ("default" if option == setting_default(spec) else ""),
                      "action": ("choice", option)} for option, label in choices]
            cursor = next((i for i, (option, _) in enumerate(choices)
                           if str(option) == str(value)), 0)
            self.popup = Popup(spec["label"], items,
                               lambda picked, spec=spec: self.set_setting(spec, picked[1]),
                               cursor, "enter picks · esc closes")
        else:
            if kind == "books":
                initial = ", ".join(value)
            elif kind == "float":
                initial = f"{float(value):g}"
            else:
                initial = str(value)
            if kind == "int":
                hint = f"{spec['min']}-{spec['max']}"
            elif kind == "float":
                hint = f"{spec['min']:g}-{spec['max']:g}"
            elif kind == "color":
                hint = "#RRGGBB" + (" or terminal" if spec.get("allow") else "")
            else:
                hint = "up to three, comma separated"
            text = self.prompt(f"{spec['label']} ({hint}): ", initial)
            if text is None or not text.strip():
                return
            try:
                self.set_setting(spec, coerce_setting(spec, text))
            except ValueError as exc:
                self.status_message = f"⚠ {exc}."

    def confirm(self, question):
        answer = self.prompt(f"{question} type yes: ")
        return bool(answer) and answer.strip().lower() in ("y", "yes")

    def run_setting_action(self, action):
        if action == "_save":
            self.config["auto_refresh"] = self.auto_refresh
            self.config["refresh_seconds"] = self.interval
            self.config["betting_book"] = self.bet_book
            self.save_settings()
        elif action == "_reload":
            try:
                fresh = load_config(self.args.config)
            except Exception as exc:  # noqa: BLE001 - a bad file must not end the app
                self.status_message = f"⚠ Could not read the config: {exc}"
                return
            self.config.clear()
            self.config.update(fresh)
            self.favorites = normalize_favorites(self.config.get("favorites"))
            for spec in SETTING_ROWS:
                if spec["kind"] != "action":
                    self.apply_setting(spec["key"])
            self.status_message = f"Reloaded {home_path(self.args.config)}."
        elif action == "_refresh":
            self.fetcher.expire()
            self.status_message = "Refreshing everything."
        elif action == "_clear_cache":
            if not self.confirm("Delete the saved logos, pages and college stats?"):
                self.status_message = "Nothing deleted."
                return
            removed = 0
            for name, size in cache_usage().items():
                if name == os.path.basename(LINES_PATH):
                    continue
                path = os.path.join(CACHE_DIR, name)
                try:
                    if os.path.isdir(path):
                        shutil.rmtree(path)
                    else:
                        os.remove(path)
                    removed += size
                except OSError:
                    pass
            self._cache_usage = (0.0, {})
            self.status_message = f"Cleared {human_bytes(removed)} of cached files."
        elif action == "_clear_lines":
            if not self.confirm("Delete the saved line history?"):
                self.status_message = "Nothing deleted."
                return
            try:
                os.remove(LINES_PATH)
            except OSError:
                pass
            self.book = LineBook()
            self._cache_usage = (0.0, {})
            self.status_message = "Line history cleared."
        elif action == "_reset":
            if not self.confirm("Put every setting back to its default?"):
                self.status_message = "Nothing changed."
                return
            for spec in SETTING_ROWS:
                if spec["kind"] == "action":
                    continue
                default = DEFAULT_CONFIG.get(spec["key"])
                self.config[spec["key"]] = list(default) if isinstance(default, list) \
                    else default
                self.apply_setting(spec["key"])
            self.save_settings(quiet=True)
            self.status_message = "Settings are back to their defaults."

    def draw_settings(self, top, height, width):
        wide = width >= self.SPLIT_MIN_WIDTH
        left_width = clamp(width * 46 // 100, 58, 76) if wide else width
        inner = left_width - 4
        rows, cursor_line = render_setting_rows(self, inner)
        detail = render_setting_detail(self, inner)
        caption = Line().add(" Settings ", "accent").add(
            "· saved as you go ", "muted")
        if wide:
            view = max(3, height - 2 - len(detail))
            offset = self.scroll["Settings"]
            if self._mouse_pick:
                pass                    # the row clicked stays under the pointer
            elif cursor_line < offset + 1:
                offset = max(0, cursor_line - 1)
            elif cursor_line >= offset + view - 1:
                offset = cursor_line - view + 2
            offset = clamp(offset, 0, max(0, len(rows) - view))
            self.scroll["Settings"] = offset
            self.draw_box(top, 0, height, left_width)
            self.draw_lines([caption], top, 2, 1, inner, 0)
            self.draw_lines(rows, top + 1, 2, view, inner, offset)
            self.draw_scrollbar(top + 1, left_width - 2, view, len(rows), offset)
            self.hot_settings(top + 1, view, left_width, offset)
            self.wheel(top, top + height, left_width, width, ord("J"), ord("K"))
            self.draw_lines(detail, top + 1 + view, 2, len(detail), inner, 0)
            right_width = width - left_width
            about = render_settings_about(self, right_width - 4)
            right_view = height - 2
            key = "SettingsAbout"
            self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(about) - right_view))
            self.draw_box(top, left_width, height, right_width)
            self.draw_lines([Line().add(" About sportst ", "accent").add(
                "· data sources · controls · J / K scroll ", "muted")],
                top, left_width + 2, 1, right_width - 4, 0)
            self.draw_lines(about, top + 1, left_width + 2, right_view, right_width - 4,
                            self.scroll[key])
            self.draw_scrollbar(top + 1, width - 2, right_view, len(about), self.scroll[key])
            return
        # the list and the About text scroll together; the highlighted
        # setting's explanation stays pinned underneath when there is room
        lines = rows + [blank()] + render_settings_about(self, inner)
        if height - 2 - len(detail) < 6:
            detail = []
        view = height - 2 - len(detail)
        offset = self.scroll["Settings"]
        if self._settings_follow:
            if cursor_line < offset + 1:
                offset = max(0, cursor_line - 1)
            elif cursor_line >= offset + view - 1:
                offset = cursor_line - view + 2
            self._settings_follow = False
        offset = clamp(offset, 0, max(0, len(lines) - view))
        self.scroll["Settings"] = offset
        self.draw_box(top, 0, height, width)
        self.draw_lines([caption], top, 2, 1, inner, 0)
        self.draw_lines(lines, top + 1, 2, view, inner, offset)
        self.draw_scrollbar(top + 1, width - 2, view, len(lines), offset)
        self.hot_settings(top + 1, view, width, offset)
        if detail:
            self.draw_lines(detail, top + 1 + view, 2, len(detail), inner, 0)

    def hot_settings(self, top, view, width, offset):
        """Clickable rows for the settings list drawn at `top`."""
        for index, at in enumerate(setting_row_lines()):
            shown_at = at - offset
            if 0 <= shown_at < view:
                self.hot(top + shown_at, 1, width - 2,
                         lambda i=index: self.click_setting(i),
                         lambda i=index: self.click_setting(i, True))

    def handle_settings_key(self, key):
        """Return True when the Settings screen has taken the key."""
        count = len(SETTING_ROWS)
        wide = self.stdscr.getmaxyx()[1] - 1 >= self.SPLIT_MIN_WIDTH
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6}
        if key in moves:
            self.settings_cursor = clamp(self.settings_cursor + moves[key], 0, count - 1)
            self._settings_follow = True
        elif key in (ord("h"), curses.KEY_LEFT, ord("l"), curses.KEY_RIGHT):
            spec = self.settings_spec()
            if spec["kind"] in ("bool", "choice", "int", "float", "color"):
                delta = -1 if key in (ord("h"), curses.KEY_LEFT) else 1
                self.set_setting(spec, step_setting(spec, self.setting_value(spec), delta))
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.edit_setting()
        elif key == ord("R"):
            spec = self.settings_spec()
            if spec["kind"] != "action":
                default = setting_default(spec)
                self.set_setting(spec, list(default) if isinstance(default, list) else default)
        elif key in (ord("J"), ord("K"), curses.KEY_NPAGE, curses.KEY_PPAGE):
            step = {ord("J"): 1, ord("K"): -1}.get(key, 0)
            if not step:
                page = max(1, self.stdscr.getmaxyx()[0] - 8)
                step = page if key == curses.KEY_NPAGE else -page
            target = "SettingsAbout" if wide else "Settings"
            self.scroll[target] = max(0, self.scroll[target] + step)
        elif key == ord("G"):
            self.settings_cursor = count - 1
            self._settings_follow = True
        else:
            return False
        return True

    # -- a team's last game (Stats tab, player view) -----------------------

    def load_team_schedule(self, team):
        if self.league == "ahl":
            source = Loader("lscluster.hockeytech.com", ahl_team_schedule, team["id"])
        else:
            source = Loader(SITE_HOSTS[0], espn_team_schedule, self.league, team["id"])
        return self.fetcher.get(("schedule", self.league, team["id"]), source, ttl=600)

    def draw_team_schedule(self, top, height, width, team, caption,
                           back="g goes on to the season · esc to the team table."):
        """The team's whole season; enter opens the picked game. The Stats tab
        and the Standings tab both show it."""
        def notice(text):
            self.draw_box(top, 0, height, width)
            self.draw_lines([caption], top, 2, 1, width - 4, 0)
            lines = wrap_spans(text, width - 4, "dim") + [Line().add(back, "muted")]
            self.draw_lines(lines, top + 1, 2, max(1, height - 2), width - 4, 0)

        self._sched_games = []
        self._sched_team = team
        if is_olympic(self.league):
            notice("Team schedules are not published for the Olympic tournaments. The "
                   "Scoreboard has every game.")
            return
        if self.league == "cbase":
            notice("ESPN does not publish college baseball team schedules. The Scoreboard "
                   "tab and the calendar (C) have every day's games.")
            return
        result = self.load_team_schedule(team)
        data = result.data
        if not data:
            notice("Loading the schedule…" if result.loading else
                   f"Could not load the schedule: {result.error}")
            return
        games = data.get("games") or []
        self._sched_games = games
        if not team.get("color"):
            # standings rows carry no colour; the schedule's games do
            team["color"] = next((g["color"] for g in games if g.get("color")), "")
        key = (self.league, team["id"])
        if self.sched_cursor.get(key) is None:
            self.sched_cursor[key] = schedule_focus(games)
        cursor = clamp(self.sched_cursor[key], 0, max(0, len(games) - 1))
        self.sched_cursor[key] = cursor
        inner = width - 4
        wide = inner >= TEAM_PAGE_WIDE
        self._team_page_wide = wide
        list_w = clamp(inner * 48 // 100, 70, 92) if wide else inner
        dash_w = inner - list_w - 3 if wide else 0
        title = Line(list(caption))
        bits = [b for b in (data.get("season"), data.get("standing")) if b]
        if bits:
            title.add(" " + " · ".join(bits) + " ", "dim")
        self.draw_box(top, 0, height, width)
        self.draw_lines([title], top, 2, 1, width - 4, 0)
        self.palette.logo_begin(("teampage", self.league, team["id"]))
        if not wide and self.sched_view == "season":
            # a narrow screen: the panels on their own, j / k scroll them
            panel = self.team_page_lines(team, data, inner, 10 ** 6)
            view = max(1, height - 2)
            offset = clamp(self.scroll["TeamPage"], 0, max(0, len(panel) - view))
            self.scroll["TeamPage"] = offset
            self.draw_lines(panel, top + 1, 2, view, inner, offset)
            self.draw_scrollbar(top + 1, width - 2, view, len(panel), offset)
            self.wheel(top + 1, top + height - 1, 1, width - 1, ord("j"), ord("k"), 3)
            return
        row_lines = []
        gap = 3 if self.graphics.enabled and self.team_logos != "off" else 0
        lines = render_team_schedule(data, self.league, list_w, cursor, row_lines,
                                     summary=not wide, logo_gap=gap)
        fixed = (2 if wide else 3) if games else 0
        body = lines[fixed:]
        view = max(1, height - 2 - fixed)
        offset = self.scroll["Schedule"]
        if games and not self._mouse_pick:
            line_at = row_lines[cursor] - fixed
            if line_at < offset:
                offset = max(0, line_at - 2)        # the month heading above too
            elif line_at >= offset + view:
                offset = line_at - view + 2
        offset = clamp(offset, 0, max(0, len(body) - view))
        self.scroll["Schedule"] = offset
        if fixed:
            self.draw_lines(lines[:fixed], top + 1, 2, fixed, list_w, 0)
        self.draw_lines(body, top + 1 + fixed, 2, view, list_w, offset)
        self.draw_scrollbar(top + 1 + fixed, 2 + list_w if wide else width - 2, view,
                            len(body), offset)
        column = [None] * view
        for index, at in enumerate(row_lines):
            shown_at = at - fixed - offset
            if 0 <= shown_at < view:
                self.hot(top + 1 + fixed + shown_at, 1, 2 + list_w,
                         lambda i=index: self.click_schedule(i),
                         lambda i=index: self.click_schedule(i, True))
                game = games[index]
                column[shown_at] = {"id": game.get("opp_id"), "abbr": game.get("opp"),
                                    "logo": game.get("opp_logo")}
        if gap:
            self.logo_column(self.league, column, top + 1 + fixed,
                             2 + schedule_logo_x(self.league),
                             selected=(row_lines[cursor] - fixed - offset) if games else -1)
        if wide:
            x = 2 + list_w + 2
            for row in range(height - 2):
                self.put(top + 1 + row, x, "│", self.palette("border"))
            panel = self.team_page_lines(team, data, dash_w - 1, height - 2)
            self.draw_lines(panel, top + 1, x + 2, height - 2, dash_w - 1, 0)

    def team_page_lines(self, team, data, width, height):
        """The team page's panels for a box `width` x `height`: the team card
        and the season chart across the top, then the next game, the
        division, the splits, the season's numbers, the road ahead, the
        report card and the title odds, in one or two columns - leaving out
        whatever does not fit."""
        league = self.league
        games = data.get("games") or []
        numbers = season_numbers(games, league)
        standings = self.load_standings()
        index = standings_index(standings.data) if standings.data else {}
        row = index.get(str(team.get("id")))
        numbers.update(opponent_numbers(numbers, index))
        known = dict((row or {}).get("team") or {})
        known.update({k: v for k, v in team.items() if v})
        art = self.team_art(league, known, 30, 6) if height >= 12 else []
        card = team_card(known, numbers, row, league, width, art, data.get("season") or "",
                         data.get("standing") or "",
                         smaller=lambda: self.team_art(league, known, 24, 6))
        rows = 4 if height >= 40 else 3 if height >= 30 else 2
        chart = chart_panel(numbers, league, width, rows)
        top_part = card + [Line()] + chart
        if len(top_part) > height:
            top_part = card[:height]
        columns = 2 if width >= 84 else 1
        col_w = (width - 2) // 2 if columns == 2 else width
        board, sources = self.championship_rows()[:2]
        panels = [next_up_panel(numbers, index, league, col_w,
                                self.next_game_line(numbers["next"], known)),
                  division_panel(row, league, col_w, self.favorites),
                  splits_panel(numbers, row, league, col_w),
                  numbers_panel(numbers, league, col_w),
                  road_panel(numbers, numbers, league, col_w),
                  report_panel(index, team.get("id"), league, col_w),
                  odds_panel(board, team.get("id"), league, col_w, sources)]
        room = height - len(top_part) - 1
        rest = layout_panels(panels, width, max(0, room), columns) if room > 3 else []
        return top_part + ([Line()] + rest if rest else [])

    def next_game_line(self, game, team):
        """'BUF -3.5 · o/u 47.5' for the team's next game when a sportsbook
        line for it has been seen, or ''."""
        if not game or not BETTING.enabled or self.league not in BETTING_LEAGUES:
            return ""
        entry = self.book.get(self.league, game.get("id")) if self.book else None
        line = (entry or {}).get("line")
        if not line:
            found = next((e for e in self.events or [] if e.get("id") == game.get("id")),
                         None)
            line = (found or {}).get("line")
        if not line:
            return ""
        us = {"abbr": team.get("abbr") or "?"}
        them = {"abbr": game.get("opp") or "?"}
        event = {"home": us, "away": them} if game.get("home") else {"home": them, "away": us}
        text, _ = line_label(line, event, self.league)
        if line.get("total") is not None:
            text += f" · o/u {line['total']:g}" if isinstance(line["total"], (int, float)) \
                else f" · o/u {line['total']}"
        return text.strip(" ·")

    def click_schedule(self, index, open_it=False):
        if not self._sched_team:
            return False
        key = (self.league, self._sched_team["id"])
        again = self.clicked_again("schedule", key, index)
        self.sched_cursor[key] = index
        if again or open_it:
            self.open_schedule_game()
            return True
        return False

    def open_schedule_game(self, center=False):
        """Open the picked game of a team's schedule: its scouting report
        before the start, its box score once under way or played - or, with
        `center`, the Game Center, once that day's scoreboard has it."""
        games = getattr(self, "_sched_games", [])
        if not games or not self._sched_team:
            return
        key = (self.league, self._sched_team["id"])
        game = games[clamp(self.sched_cursor.get(key) or 0, 0, len(games) - 1)]
        if game.get("tbd"):
            self.status_message = "That game is postponed - no date yet."
            return
        if center:
            self.peek_center(self.league, game)      # over the team page: esc comes back
            return
        target = "Scouting" if game["state"] == "pre" else "Boxscore"
        self.open_game(self.league, game, target if target in self.tabs else None)

    def handle_schedule_key(self, key, team):
        """j / k pick a game of a team's schedule, enter opens it, z puts it
        in the Game Center, t goes back to the next game, v switches a narrow
        screen between the games and the season. True when the key was one
        of those."""
        games = self._sched_games
        team_key = (self.league, team["id"])
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10, ord("J"): 10,
                 ord("K"): -10, curses.KEY_HOME: -10 ** 6,
                 curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key == ord("v") and team_schedules(self.league):
            if self._team_page_wide:
                self.status_message = "The season and the games are both on screen here."
            else:
                self.sched_view = "games" if self.sched_view == "season" else "season"
                self.scroll["TeamPage"] = 0
                self.status_message = ("The season: j / k scroll, V back to the games."
                                       if self.sched_view == "season" else
                                       "The games, one a line; V the season again.")
            return True
        season = self.sched_view == "season" and not self._team_page_wide
        if season and key in moves:
            step = moves[key]
            self.scroll["TeamPage"] = max(0, self.scroll["TeamPage"] + (
                step if abs(step) < 10 ** 5 else (10 ** 5 if step > 0 else -10 ** 5)))
            return True
        if key == ord("z") and games:
            self.open_schedule_game(center=True)
            return True
        if key in moves and games:
            now = self.sched_cursor.get(team_key) or 0
            self.sched_cursor[team_key] = clamp(now + moves[key], 0, len(games) - 1)
            return True
        if key in (10, 13, curses.KEY_ENTER):
            self.open_schedule_game()
            return True
        if key == ord("t") and games:
            self.sched_cursor[team_key] = schedule_focus(games)
            return True
        return False

    def handle_standings_key(self, key):
        """j / k pick a team in the standings and enter opens its whole
        schedule; there, esc or backspace come back."""
        if self.standings_team and self.standings_team[0] == self.league:
            if key in (27, curses.KEY_BACKSPACE, 127, 8):
                self.standings_team = None
                return True
            return self.handle_schedule_key(key, self.standings_team[1])
        spots = self._standings_spots
        if not spots:
            return False
        ids = [s["team"]["id"] for s in spots]
        now = self.standings_sel.get(self.league)
        index = ids.index(now) if now in ids else 0
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10, curses.KEY_HOME: -10 ** 6,
                 curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key in moves:
            self.standings_sel[self.league] = ids[clamp(index + moves[key], 0,
                                                        len(ids) - 1)]
            return True
        if key in (10, 13, curses.KEY_ENTER):
            self.open_standings_schedule(spots[index]["team"])
            return True
        return False

    def open_standings_schedule(self, team):
        self.standings_team = (self.league, team)
        self.sched_cursor.pop((self.league, team["id"]), None)
        self.scroll["Schedule"] = 0
        if team_schedules(self.league):
            self.status_message = f"{team.get('name') or team.get('abbr')}: the season, " \
                                  "game by game - enter opens one."

    def click_standing(self, team_id, open_it=False):
        again = self.clicked_again("standing", self.league, team_id)
        self.standings_sel[self.league] = team_id
        if again or open_it:
            team = next((s["team"] for s in self._standings_spots
                         if s["team"]["id"] == team_id), None)
            if team:
                self.open_standings_schedule(team)
                return True
        return False

    def step_players_view(self):
        """g on a team: season totals, then the last game, then the schedule."""
        order = ("season", "game", "schedule")
        now = self.players_view if self.players_view in order else "season"
        self.players_view = order[(order.index(now) + 1) % len(order)]
        self.scroll["Players"] = 0
        if self.players_view == "schedule" and self.stats_team:
            self.sched_cursor.pop((self.league, self.stats_team[1]["id"]), None)
            self.scroll["Schedule"] = 0
        self.status_message = {"season": "Season totals.",
                               "game": "Last game, player by player.",
                               "schedule": "The season, game by game - enter opens one."}[
                                   self.players_view]

    def load_last_game(self, team):
        if self.league == "ahl":
            source = Loader("lscluster.hockeytech.com", ahl_last_game, team["id"])
        else:
            source = Loader(SITE_HOSTS[0], espn_last_game, self.league, team["id"])
        return self.fetcher.get(("lastgame", self.league, team["id"]), source, ttl=900)

