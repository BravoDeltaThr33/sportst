def logo_rows(text, gap=2):
    """The block letters for `text` as five strings."""
    rows = ["", "", "", "", ""]
    for index, char in enumerate(text):
        glyph = LOGO_FONT.get(char.upper(), LOGO_FONT[" "])
        for r in range(5):
            rows[r] += (" " * gap if index else "") + glyph[r]
    return rows


def render_logo_lines(width, room=99):
    """The SPORTS TERMINAL title: block letters in bands of colour, leaning
    forward, over a solid drop shadow, with racing stripes and a tagline
    underneath. `room` is how many rows it may take."""
    bands, stripes, shadow = LOGO_COLORS.get(CURRENT_SCHEME["name"], LOGO_COLORS["espn"])
    if room < 10:
        stripes = stripes[:max(0, room - 7)]
    elif room < 20:
        stripes = stripes[:1]
    blocks, scale = None, 1
    for px, gap in ((2, 2), (1, 2), (1, 1)):
        one_line = logo_rows("SPORTS TERMINAL", gap)
        if len(one_line[0]) * px + 6 <= width and room >= 7:
            blocks, scale = [one_line], px
            break
    if blocks is None:
        if len(logo_rows("TERMINAL")[0]) + 6 <= width and room >= 16:
            blocks = [logo_rows("SPORTS"), logo_rows("TERMINAL")]
        else:
            return [Line().add("SPORTS TERMINAL", "title"),
                    Line().add(f"scores · stats · lines · v{VERSION}", "dim"), blank()]
    lines = []
    dark = "@" + shadow.lstrip("#")
    for rows in blocks:
        lean = [1, 1, 1, 0, 0]
        grid = ["".join(ch * scale for ch in " " * lean[r] + row) + "  "
                for r, row in enumerate(rows)]
        span = max(len(g) for g in grid) + 1
        grid = [g.ljust(span) for g in grid] + [" " * span]
        left = max(0, (width - span) // 2)

        def filled(r, c):
            return 0 <= r < len(grid) and 0 <= c < len(grid[r]) and grid[r][c] == "█"

        for r in range(len(grid)):
            line = Line().add(" " * left, "normal")
            for c in range(span):
                if filled(r, c):
                    line.append(("█", "@" + bands[min(r, len(bands) - 1)].lstrip("#")))
                elif scale == 2 and filled(r - 1, c - 1):
                    line.append(("█", dark))          # half a pixel right, a row down
                elif scale == 1 and filled(r, c - 1):
                    line.append(("▌", dark))          # a slim edge on the right
                elif scale == 1 and filled(r - 1, c):
                    line.append(("▀", dark))          # and underneath
                else:
                    line.append((" ", "normal"))
            lines.append(_merge_spans(line))
    # racing stripes and the tagline
    stripe_width = min(width - 4, max(len(l.text.strip()) for l in lines) + 8)
    pad = max(0, (width - stripe_width) // 2)
    for colour in stripes:
        lines.append(Line().add(" " * pad, "normal").add("▀" * stripe_width,
                                                          "@" + colour.lstrip("#")))
    tag = f"S C O R E S   ·   S T A T S   ·   L I N E S   ·   v{VERSION}"
    if len(tag) > width - 2:
        tag = f"scores · stats · lines · v{VERSION}"
    lines.append(Line().add(" " * max(0, (width - len(tag)) // 2), "normal").add(tag, "accent"))
    return lines


def _merge_spans(line):
    """Join neighbouring cells of one style into one span."""
    out = Line()
    for text, style in line:
        if out and out[-1][1] == style:
            out[-1] = (out[-1][0] + text, style)
        else:
            out.append((text, style))
    return out


def _glance_game(event, team_id):
    """One schedule entry, from the team's side: who, when, where, score."""
    comp = (event.get("competitions") or [{}])[0]
    status = dig(comp, "status", "type", default={}) or dig(event, "status", "type",
                                                             default={}) or {}
    us, them = None, None
    for side in comp.get("competitors") or []:
        if str(dig(side, "team", "id", default="")) == str(team_id):
            us = side
        else:
            them = side
    if not us or not them:
        return None

    def score(side):
        value = side.get("score")
        if isinstance(value, dict):
            value = value.get("displayValue", value.get("value"))
        return _int(value) if value not in (None, "") else None

    state = status.get("state") or ("post" if status.get("completed") else "pre")
    mine, theirs = score(us), score(them)
    result = ""
    if state == "post":
        if us.get("winner") is True:
            result = "W"
        elif them.get("winner") is True:
            result = "L"
        elif mine is not None and theirs is not None:
            result = "W" if mine > theirs else "L" if mine < theirs else "T"
    rank = dig(them, "curatedRank", "current", default=None)
    tv = ""
    for cast in comp.get("broadcasts") or []:
        tv = clean(dig(cast, "media", "shortName", default="") or "")
        if tv:
            break
    return {"id": str(event.get("id") or comp.get("id") or ""),
            "date": event.get("date") or comp.get("date") or "",
            "state": state, "detail": clean(status.get("shortDetail") or
                                            status.get("detail") or ""),
            "home": us.get("homeAway") == "home",
            "neutral": bool(comp.get("neutralSite")),
            "opp": clean(dig(them, "team", "abbreviation", default="")
                         or dig(them, "team", "shortDisplayName", default="?")),
            "opp_name": clean(dig(them, "team", "shortDisplayName", default="")
                              or dig(them, "team", "displayName", default="")),
            "opp_rank": rank if isinstance(rank, int) and 0 < rank <= 25 else None,
            "us": mine, "them": theirs, "result": result, "tv": tv,
            "time_tba": comp.get("timeValid") is False,
            "color": str(dig(us, "team", "color", default="") or ""),
            "tbd": bool(status.get("name") == "STATUS_POSTPONED")}


def espn_team_glance(league, team_id, timeout=15):
    """{'last', 'next', 'live'} for one team, any of which may be None."""
    meta = LEAGUES[league]
    base = (f"apis/site/v2/sports/{meta['sport']}/{meta['path']}/teams/"
            f"{urllib.parse.quote(str(team_id))}/schedule")
    year = Date.today().year
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M")
    glance = {"last": None, "next": None, "live": None, "color": ""}
    failures = 0
    for query in ["", "?seasontype=2", "?seasontype=3", "?seasontype=1",
                  f"?season={year}", f"?season={year - 1}"]:
        if glance["last"] and glance["next"]:
            break
        if query.startswith("?season=") and glance["last"]:
            break
        try:
            data = fetch_first((f"https://{SITE_HOSTS[0]}/{base}{query}",
                                [f"https://{SITE_HOSTS[1]}/{base}{query}"]), timeout)
        except Exception:  # noqa: BLE001 - the next season type may answer
            failures += 1
            if failures >= 3 and not (glance["last"] or glance["next"]):
                raise
            continue
        games = [g for g in (_glance_game(e, team_id) for e in data.get("events") or [])
                 if g and g["id"]]
        for game in games:
            glance["color"] = glance["color"] or game["color"]
            if game["state"] == "in":
                glance["live"] = game
            elif game["state"] == "post":
                if not glance["last"] or game["date"] > glance["last"]["date"]:
                    glance["last"] = game
            elif game["date"][:16] >= now[:13]:
                if not glance["next"] or game["date"] < glance["next"]["date"]:
                    glance["next"] = game
    return glance


def ahl_team_glance(team_id, timeout=15):
    data = ht_get({"feed": "modulekit", "view": "schedule", "team_id": str(team_id)},
                  timeout)
    glance = {"last": None, "next": None, "live": None, "color": ""}
    for g in dig(data, "SiteKit", "Schedule", default=[]) or []:
        home = str(g.get("home_team")) == str(team_id)
        mine = _int(g.get("home_goal_count" if home else "visiting_goal_count"))
        theirs = _int(g.get("visiting_goal_count" if home else "home_goal_count"))
        final, started = str(g.get("final")) == "1", str(g.get("started")) == "1"
        tail = " SO" if g.get("shootout") == "1" else \
            " OT" if _int(g.get("overtime")) else ""
        game = {"id": str(g.get("game_id") or g.get("id")),
                "date": g.get("GameDateISO8601") or g.get("date_time_played") or "",
                "state": "post" if final else "in" if started else "pre",
                "detail": clean(g.get("game_status") or ""),
                "home": home, "neutral": False,
                "opp": clean(g.get("visiting_team_code" if home else "home_team_code")),
                "opp_name": clean(g.get("visiting_team_city" if home else "home_team_city")),
                "opp_rank": None, "us": mine, "them": theirs, "tv": "", "color": "",
                "result": (("W" if mine > theirs else "L" if mine < theirs else "T") + tail)
                if final else "", "tbd": False}
        try:
            stamp = datetime.fromisoformat(game["date"]).astimezone(timezone.utc)
            game["date"] = stamp.strftime("%Y-%m-%dT%H:%MZ")
        except ValueError:
            pass
        if game["state"] == "in":
            glance["live"] = game
        elif final:
            if not glance["last"] or game["date"] > glance["last"]["date"]:
                glance["last"] = game
        elif not glance["next"] or game["date"] < glance["next"]["date"]:
            if game["date"] >= datetime.now(timezone.utc).strftime("%Y-%m-%dT%H"):
                glance["next"] = game
    return glance


def _local(stamp):
    try:
        return datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).astimezone()
    except (TypeError, ValueError):
        return None


def glance_when(game, with_time=True):
    moment = _local(game.get("date"))
    if not moment:
        return ""
    if game.get("time_tba"):
        # ESPN parks a game with no kick-off time yet at midnight Eastern,
        # which is the evening before in the central and western zones
        try:
            moment = datetime.strptime(str(game["date"])[:10], "%Y-%m-%d").replace(
                hour=12).astimezone()
        except ValueError:
            pass
    today = datetime.now().astimezone().date()
    days = (moment.date() - today).days
    if days == 0:
        day = "Today"
    elif days == 1:
        day = "Tomorrow"
    elif days == -1:
        day = "Yesterday"
    elif 1 < days < 7:
        day = moment.strftime("%a")
    else:
        day = moment.strftime("%a %b %-d")
    if not with_time:
        return day
    if game.get("time_tba"):
        return f"{day} TBA"
    clock = moment.strftime("%-I:%M %p").replace(":00 ", " ")
    return f"{day} {clock}"


def glance_opponent(game, league):
    where = "vs" if game.get("home") else "at"
    if game.get("neutral"):
        where = "vs"
    rank = f"#{game['opp_rank']} " if game.get("opp_rank") else ""
    name = game.get("opp") or "?"
    if league in COLLEGE_LEAGUES and game.get("opp_name"):
        name = game["opp_name"]
    return f"{where} {rank}{name}"


def overview_entries(favorites):
    """[(league, team)] for every favourite outside the Olympics, in the
    usual league order."""
    out = []
    for fam in LEAGUE_ORDER:
        if fam in ("owg", "osg"):
            continue
        for team in favorites.get(fam) or []:
            if team.get("id"):
                out.append((fam, team))
    return out


def render_overview_rows(app, entries, glances, width, which):
    """Favourites grouped under league headings: each team's latest result
    ('last'), its next game ('next'), or both, the next game on a second
    line underneath ('both', for a narrow screen)."""
    lines, cursor_line = [], 0
    name_width = clamp(max([len(t.get("name") or t.get("abbr") or "")
                            for _, t in entries] + [8]) + 1, 10, 26)
    previous = None

    def describe(glance, result, league, kind, chosen):
        base = "sel" if chosen else "normal"
        out = Line()
        if glance is None:
            text = "loading…" if result is None or result.loading else \
                f"unavailable: {result.error}" if result.error else "-"
            return out.add(text, "seldim" if chosen else "dim")
        if kind == "last":
            game = glance.get("last")
            if not game:
                return out.add("no results yet", "seldim" if chosen else "dim")
            mark = game["result"] or "-"
            style = "good" if mark.startswith("W") else "bad" if mark.startswith("L") \
                else "accent"
            out.add(f"{mark:<5}", "sel" if chosen else style)
            score = f"{game['us']}-{game['them']}" if game.get("us") is not None else ""
            out.add(f"{score:<8}", base if chosen else "bold")
            out.add(f"{glance_opponent(game, league)[:22]:<23}", base)
            return out.add(glance_when(game, with_time=False), "seldim" if chosen else "dim")
        live = glance.get("live")
        game = live or glance.get("next")
        if not game:
            return out.add("nothing scheduled", "seldim" if chosen else "dim")
        if live:
            out.add("LIVE ", "sel" if chosen else "live")
            score = f"{live['us']}-{live['them']}" if live.get("us") is not None else ""
            out.add(f"{score:<8}", base if chosen else "bold")
            out.add(f"{glance_opponent(live, league)[:22]:<23}", base)
            return out.add(live.get("detail") or "", "seldim" if chosen else "accent")
        out.add(f"{glance_opponent(game, league)[:24]:<25}", base)
        out.add(f"{glance_when(game):<17}", base if chosen else "accent")
        if game.get("tv"):
            out.add(game["tv"][:10], "seldim" if chosen else "dim")
        return out

    def finish(line, chosen):
        used = sum(len(t) for t, _ in line)
        if used > width:
            trimmed, room = Line(), width
            for text, style in line:
                if room <= 0:
                    break
                trimmed.append((text[:room], style))
                room -= len(text)
            line = trimmed
        elif chosen and used < width:
            line.append((" " * (width - used), "sel"))
        return line

    for index, (league, team) in enumerate(entries):
        if league != previous:
            if lines:
                lines.append(blank())
            lines.append(Line().add(f" {LEAGUE_SHORT.get(league, league)}", "header"))
            previous = league
        row_chosen = index == app.overview_cursor
        side = getattr(app, "overview_side", "next")
        if row_chosen:
            cursor_line = len(lines)
        result = glances.get((league, team["id"]))
        glance = result.data if result else None
        shown = dict(team)
        if glance and glance.get("color") and not shown.get("color"):
            shown["color"] = glance["color"]
        first = "last" if which == "both" else which
        # the highlight sits on the game enter will open: the result or the
        # next game; the team's other game keeps a faint marker
        chosen = row_chosen and side == first
        line = Line().add("▌" if row_chosen else " ",
                          "selbar" if chosen else "muted" if row_chosen else "normal")
        name = (team.get("name") or team.get("abbr") or "?")[:name_width - 1]
        line.add(STAR + " ", "seldim" if chosen else "star")
        line.add(f"{name:<{name_width}}", THEME.style(league, shown, selected=chosen,
                                                       bold=True, fallback="sel" if chosen
                                                       else "normal"))
        line.extend_spans(describe(glance, result, league, first, chosen))
        lines.append(finish(line, chosen))
        if which == "both":
            chosen = row_chosen and side == "next"
            second = Line().add("▌" if row_chosen else " ",
                                "selbar" if chosen else "muted" if row_chosen else "normal")
            second.add(" " * 2 + f"{'next':>{name_width - 1}} ", "seldim" if chosen else "muted")
            second.extend_spans(describe(glance, result, league, "next", chosen))
            lines.append(finish(second, chosen))
    return lines, cursor_line


