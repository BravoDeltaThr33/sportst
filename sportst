def footer_spans(auto, interval, busy, requests, status, error, width, hints=None,
                 round_keys=False, page=0):
    """Lay out the bottom line inside `width` columns.

    Left: 'sportst 4.7.0 │ auto 30s │' and then the keys that matter on this
    screen ('j/k game  enter open …'). Right: the message. The message keeps
    room for itself first; the hints fill what is left. Since 6.22.0 keys
    that do not all fit take turns: they are split into pages that do, page
    `page` (counted round) shown with its number ('›2/3'); the app name is
    the last to go.
    """
    message = status or ""
    if not message and error:
        text, age = error
        message = f"⚠ {text} ({_ago(age)})"
    if message.startswith("⚠"):
        style = "err"
    elif message.startswith("▲"):
        style = "upset"
    elif message.startswith(STAR):
        style = "star"
    else:
        style = "accent"

    spans = [(f" {APP} ", "(appchip"), (f" {VERSION}", "dim")] if round_keys else \
        [(APP, "title"), (f" {VERSION}", "dim")]
    used = len(APP) + len(VERSION) + 1 + (2 if round_keys else 0)
    if used > width:
        return [(APP[:max(0, width)], "title")], "", style
    keep = (min(len(message), max(24, width // 3)) + 3) if message else 0
    refresh = "loading…" if busy else (f"auto {interval}s" if auto else "auto off")
    if used + 3 + len(refresh) + keep <= width:
        spans += [(" │ ", "border"), (refresh, "muted")]
        used += 3 + len(refresh)
    hints = list(hints or [])

    def size(index, key, label):
        cap = f" {key} " if round_keys else key
        return (3 if index == 0 else 2) + len(cap) + 1 + len(label)
    room = width - used - keep
    pages = [hints]
    if sum(size(i, k, l) for i, (k, l) in enumerate(hints)) > room and len(hints) > 1:
        marker = 6                       # '  ›2/3'
        pages, current, taken = [], [], 0
        for key, label in hints:
            piece = size(len(current), key, label)
            if current and taken + piece + marker > room:
                pages.append(current)
                current, taken = [], 0
                piece = size(0, key, label)
            current.append((key, label))
            taken += piece
        if current:
            pages.append(current)
    shown = pages[page % len(pages)] if pages else []
    first = True
    for key, label in shown:
        cap = f" {key} " if round_keys else key
        piece = (3 if first else 2) + len(cap) + 1 + len(label)
        if used + piece + keep > width:
            break
        spans.append((" │ " if first else "  ", "border" if first else "normal"))
        spans.append((cap, "(keycap" if round_keys else "accent"))
        spans.append((" " + label, "muted"))
        used += piece
        first = False
    if len(pages) > 1 and not first:
        mark = f"  ›{page % len(pages) + 1}/{len(pages)}"
        if used + len(mark) + keep <= width:
            spans.append((mark, "dim"))
            used += len(mark)
    room = max(0, width - used - 3)
    if len(message) > room:
        message = message[:max(0, room - 1)] + "…" if room > 1 else ""
    return spans, message, style


