def _num(value):
    if value in (None, ""):
        return None
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return float(value)
    text = str(value).strip().lower().replace(",", "").rstrip("%")
    if text in ("", "-", "--", "—"):
        return None
    if text in ("pk", "pick", "pick'em", "pickem", "ev", "even"):
        return 0.0
    text = text.lstrip("ou").replace("½", ".5")
    try:
        return float(text)
    except ValueError:
        return None


def _american(value):
    """American odds from 130, -155.0, "+130", "EVEN". None when absent."""
    if value in (None, ""):
        return None
    if isinstance(value, str) and value.strip().lower() in ("even", "ev"):
        return 100
    number = _num(value)
    if number is None or number == 0:
        return None
    return int(round(number))


def money_text(value):
    if value is None:
        return "-"
    return f"+{value}" if value > 0 else str(value)


def number_text(value):
    if value is None:
        return "-"
    return f"{value:g}"


def implied(american):
    """Win probability an American price implies, vig included."""
    if american is None or american == 0:
        return None
    if american < 0:
        return (-american) / ((-american) + 100.0)
    return 100.0 / (american + 100.0)


def no_vig(away_ml, home_ml):
    """(away, home) probabilities with the bookmaker's margin taken out."""
    a, h = implied(away_ml), implied(home_ml)
    if a is None or h is None or a + h <= 0:
        return None, None
    return a / (a + h), h / (a + h)


# -- one line from either payload ------------------------------------------


def _side_from_flags(item, flag):
    if dig(item, "homeTeamOdds", flag) is True:
        return "home"
    if dig(item, "awayTeamOdds", flag) is True:
        return "away"
    return None


def _favorite_from_numbers(spread, away_ml, home_ml):
    if spread is not None and spread != 0:
        return "home" if spread < 0 else "away"
    if away_ml is not None and home_ml is not None and away_ml != home_ml:
        return "home" if home_ml < away_ml else "away"
    return None


def _spread_from_details(details, away, home):
    """'CAR -2.5' -> home-relative spread, when nothing else is present."""
    match = re.match(r"\s*([A-Za-z0-9&.' ]+?)\s+([+-]?\d+(?:\.\d+)?)\s*$", details or "")
    if not match or not away or not home:
        return None
    team, value = match.group(1).strip().upper(), abs(float(match.group(2)))
    if team == str(home.get("abbr", "")).upper():
        return -value
    if team == str(away.get("abbr", "")).upper():
        return value
    return None


def parse_line_item(item, away=None, home=None):
    """Normalise one bookmaker's line from a scoreboard or core payload."""
    if not isinstance(item, dict):
        return None
    away_odds = item.get("awayTeamOdds") or {}
    home_odds = item.get("homeTeamOdds") or {}

    spread = _num(item.get("spread"))
    if spread is None:
        spread = _num(dig(item, "pointSpread", "home", "close", "line"))
    if spread is None:
        spread = _num(dig(home_odds, "current", "pointSpread", "american"))
    details = clean(item.get("details") or "")
    if spread is None:
        spread = _spread_from_details(details, away, home)

    total = _num(item.get("overUnder"))
    if total is None:
        total = _num(dig(item, "total", "over", "close", "line"))
    if total is None:
        total = _num(dig(item, "current", "total", "american"))

    away_ml = (_american(dig(item, "moneyline", "away", "close", "odds"))
               or _american(away_odds.get("moneyLine"))
               or _american(dig(away_odds, "current", "moneyLine", "american")))
    home_ml = (_american(dig(item, "moneyline", "home", "close", "odds"))
               or _american(home_odds.get("moneyLine"))
               or _american(dig(home_odds, "current", "moneyLine", "american")))

    opening = {
        "spread": (_num(dig(item, "pointSpread", "home", "open", "line"))
                   if dig(item, "pointSpread", "home", "open", "line") is not None
                   else _num(dig(home_odds, "open", "pointSpread", "american"))),
        "total": (_num(dig(item, "total", "over", "open", "line"))
                  if dig(item, "total", "over", "open", "line") is not None
                  else _num(dig(item, "open", "total", "american"))),
        "away_ml": (_american(dig(item, "moneyline", "away", "open", "odds"))
                    or _american(dig(away_odds, "open", "moneyLine", "american"))),
        "home_ml": (_american(dig(item, "moneyline", "home", "open", "odds"))
                    or _american(dig(home_odds, "open", "moneyLine", "american"))),
    }

    favorite = _side_from_flags(item, "favorite") or _favorite_from_numbers(
        spread, away_ml, home_ml)
    favorite_open = _side_from_flags(item, "favoriteAtOpen")
    if favorite_open is None:
        if dig(home_odds, "open", "favorite") is True:
            favorite_open = "home"
        elif dig(away_odds, "open", "favorite") is True:
            favorite_open = "away"
        else:
            favorite_open = _favorite_from_numbers(
                opening["spread"], opening["away_ml"], opening["home_ml"])

    if spread is None and total is None and away_ml is None and home_ml is None:
        return None

    return {
        "provider": clean(dig(item, "provider", "displayName", default="")
                          or dig(item, "provider", "name", default="")) or "line",
        "priority": dig(item, "provider", "priority", default=99),
        "details": details,
        "spread": spread,
        "total": total,
        "away_ml": away_ml,
        "home_ml": home_ml,
        "favorite": favorite,
        "favorite_open": favorite_open,
        "open": opening if any(v is not None for v in opening.values()) else None,
    }


def pick_line(items, away=None, home=None, preferred=""):
    """One line out of however many books ESPN returned."""
    parsed = [parse_line_item(item, away, home) for item in (items or [])]
    parsed = [p for p in parsed if p]
    if not parsed:
        return None
    if preferred:
        needle = preferred.lower()
        for entry in parsed:
            if needle in entry["provider"].lower():
                return entry

    def rank(entry):
        priority = entry.get("priority")
        return priority if isinstance(priority, (int, float)) else 99

    parsed.sort(key=rank)
    return parsed[0]


def parse_core_odds(data, away=None, home=None):
    items = dig(data, "items", default=None)
    if items is None and isinstance(data, list):
        items = data
    return pick_line(items or [], away, home, BETTING.provider)


# -- reading a line from the favourite's side ------------------------------


def favorite_side(line):
    return (line or {}).get("favorite")


def side_spread(line, side, key="spread"):
    """The spread as `side` sees it (home-relative value flipped for away)."""
    source = line if key == "spread" else (line or {}).get("open") or {}
    value = (source or {}).get("spread")
    if value is None:
        return None
    return value if side == "home" else -value


def favorite_number(line, league, which="now"):
    """How strong the favourite is, as a signed number where more negative is
    stronger: the spread in football, the moneyline in hockey (the puck line is
    always 1.5, so it says nothing about how big a favourite is)."""
    if not line:
        return None
    side = line.get("favorite")
    if which == "open":
        opening = line.get("open") or {}
        side = line.get("favorite_open") or side
        if not side:
            return None
        if league in MONEYLINE_LEAGUES or opening.get("spread") in (None, 0):
            return opening.get(f"{side}_ml")
        return -abs(opening["spread"])
    if not side:
        return None
    if league in MONEYLINE_LEAGUES or line.get("spread") in (None, 0):
        return line.get(f"{side}_ml")
    return -abs(line["spread"])


def line_label(line, event, league):
    """'CAR -2.5', 'PK', or, where the moneyline is what matters (hockey and
    baseball), the favourite's moneyline: 'BOS -150'."""
    if not line:
        return "", None
    side = line.get("favorite")
    if league in MONEYLINE_LEAGUES:
        if side:
            team = event[side]
            return f"{team['abbr']} {money_text(line.get(side + '_ml'))}", team
        return "PK", None
    spread = line.get("spread")
    if spread is not None and spread == 0:
        return "PK", None
    if side and spread is not None:
        team = event[side]
        return f"{team['abbr']} -{abs(spread):g}", team
    if side and line.get(side + "_ml") is not None:
        team = event[side]
        return f"{team['abbr']} {money_text(line.get(side + '_ml'))}", team
    return "", None


def movement(line, league):
    """'flip' when the favourite changed, 'up' when the favourite got stronger
    since the open, 'down' when weaker, None when flat or unknown."""
    if not line:
        return None
    if line.get("favorite_open") and line.get("favorite") and \
            line["favorite_open"] != line["favorite"]:
        return "flip"
    now = favorite_number(line, league, "now")
    then = favorite_number(line, league, "open")
    if now is None or then is None or now == then:
        return None
    return "up" if now < then else "down"


MOVE_MARK = {"up": "▲", "down": "▼", "flip": "◆"}


# --------------------------------------------------------------------------
# line book - a persistent record of every line we have seen
# --------------------------------------------------------------------------


def _snapshot(line):
    return {
        "t": int(time.time()),
        "provider": line.get("provider"),
        "spread": line.get("spread"),
        "total": line.get("total"),
        "away_ml": line.get("away_ml"),
        "home_ml": line.get("home_ml"),
        "favorite": line.get("favorite"),
    }


def _same(a, b):
    keys = ("spread", "total", "away_ml", "home_ml", "favorite")
    return all((a or {}).get(k) == (b or {}).get(k) for k in keys)


class LineBook:
    """Pre-game lines, remembered across refreshes and restarts.

    Every change a refresh sees is kept, so 'how has this moved since I last
    looked' has an answer, and the last line before kickoff - the closing
    line - is still here once ESPN drops it from the scoreboard.
    """

    def __init__(self, path=LINES_PATH):
        self.path = path
        self.games = {}
        self.dirty = False
        self.load()

    @staticmethod
    def key(league, event_id):
        return f"{league}:{event_id}"

    def load(self):
        try:
            with open(self.path, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            games = data.get("games") if isinstance(data, dict) else None
            self.games = games if isinstance(games, dict) else {}
        except FileNotFoundError:
            self.games = {}
        except (OSError, json.JSONDecodeError):
            self.games = {}
        self.prune()

    def save(self):
        if not self.dirty:
            return
        try:
            os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
            temporary = self.path + ".tmp"
            with open(temporary, "w", encoding="utf-8") as handle:
                json.dump({"version": 1, "games": self.games}, handle,
                          separators=(",", ":"))
            os.replace(temporary, self.path)
            self.dirty = False
        except OSError:
            pass

    def prune(self):
        horizon = time.time() - max(1, BETTING.history_days) * 86400
        stale = []
        for key, entry in self.games.items():
            kickoff = parse_iso(entry.get("kickoff"))
            stamp = kickoff.timestamp() if kickoff else entry.get("seen", 0)
            if stamp and stamp < horizon:
                stale.append(key)
        for key in stale:
            self.games.pop(key, None)
        if stale:
            self.dirty = True

    def get(self, league, event_id):
        return self.games.get(self.key(league, event_id))

    def _entry(self, league, event):
        key = self.key(league, event["id"])
        entry = self.games.get(key)
        if entry is None:
            entry = {
                "league": league,
                "id": event["id"],
                "matchup": event.get("short_name", ""),
                "kickoff": event.get("date"),
                "seen": int(time.time()),
                "history": [],
                "closed": False,
                "source": "",
            }
            self.games[key] = entry
        return entry

    def observe(self, league, event, line):
        """A pre-game line from the scoreboard. True when it moved."""
        entry = self._entry(league, event)
        entry["line"] = line
        entry["closed"] = False
        entry["source"] = "scoreboard"
        history = entry["history"]
        snap = _snapshot(line)
        if history and _same(history[-1], snap):
            return False
        history.append(snap)
        if len(history) > HISTORY_CAP:
            # keep the first sighting; it is the reference for "since I looked"
            del history[1:len(history) - HISTORY_CAP + 1]
        self.dirty = True
        return len(history) > 1

    def close(self, league, event):
        """Game has started: whatever we hold now is the closing line."""
        entry = self.games.get(self.key(league, event["id"]))
        if entry and not entry.get("closed"):
            entry["closed"] = True
            self.dirty = True

    def adopt(self, league, event, line, source="core"):
        """A line recovered after kickoff, for a game we never saw pre-game."""
        entry = self._entry(league, event)
        if entry.get("line") and entry.get("source") == "scoreboard":
            return
        entry["line"] = line
        entry["closed"] = event.get("state") != "pre"
        entry["source"] = source
        if not entry["history"]:
            entry["history"].append(_snapshot(line))
        self.dirty = True


def attach_lines(events, league, book, fetch_core=None, selected_id=None):
    """Give every event its best available line.

    Pre-game games read the scoreboard and are recorded. Started games use the
    closing line in the book; a started game the book has never seen gets its
    line from the core endpoint through fetch_core(event), which returns a
    parsed line or None while it is still loading.
    """
    moved = []
    for event in events:
        raw = event.get("line_raw")
        if event["state"] == "pre":
            if raw:
                if book is not None and book.observe(league, event, raw):
                    moved.append(event)
                event["line"] = raw
            else:
                entry = book.get(league, event["id"]) if book else None
                event["line"] = (entry or {}).get("line")
            event["line_source"] = "live" if raw else "saved"
        else:
            if book is not None:
                book.close(league, event)
            entry = book.get(league, event["id"]) if book else None
            line = (entry or {}).get("line")
            if line is None and fetch_core is not None and (
                    event["state"] == "in" or event["id"] == selected_id):
                line = fetch_core(event)
                if line is not None and book is not None:
                    book.adopt(league, event, line)
            event["line"] = line
            event["line_source"] = "closing" if line else ""
        entry = book.get(league, event["id"]) if book else None
        event["line_history"] = (entry or {}).get("history") or []
        event["line_origin"] = (entry or {}).get("source") or ""
        event["upset"] = upset_state(event, league)
    return moved


