    def handle_stats_key(self, key):
        """j / k pick a team, enter opens its players; in the player view
        esc, backspace or enter go back and [ ] step through the teams."""
        order = self._stats_order
        if self.stats_team:
            if key in (27, curses.KEY_BACKSPACE, 127, 8, 10, 13, curses.KEY_ENTER):
                self.stats_team = None
                return True
            if key in (ord("["), ord("]")) and order:
                ids = [t["id"] for t in order]
                current = self.stats_team[1]["id"]
                index = ids.index(current) if current in ids else 0
                index = (index + (1 if key == ord("]") else -1)) % len(order)
                self.stats_sel[self.league] = index
                self.stats_team = (self.league, order[index])
                self.scroll["Players"] = 0
                return True
            if key == ord("g"):
                self.players_view = "game" if self.players_view == "season" else "season"
                self.scroll["Players"] = 0
                self.status_message = ("Last game, player by player." if self.players_view
                                       == "game" else "Season totals.")
                return True
            if key in (ord("j"), curses.KEY_DOWN, ord("J")):
                self.scroll["Players"] += 1
                return True
            if key in (ord("k"), curses.KEY_UP, ord("K")):
                self.scroll["Players"] = max(0, self.scroll["Players"] - 1)
                return True
            if key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
                step = self.stdscr.getmaxyx()[0] // 2
                self.scroll["Players"] = max(0, self.scroll["Players"] +
                                             (step if key == curses.KEY_NPAGE else -step))
                return True
            return False
        if key in (ord("["), ord("]")):
            self.step_group(1 if key == ord("]") else -1)
            return True
        if not order:
            return False
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 15, curses.KEY_PPAGE: -15,
                 curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key in moves:
            self.stats_sel[self.league] = clamp(self.stats_sel.get(self.league, 0) + moves[key],
                                                0, len(order) - 1)
            return True
        if key in (10, 13, curses.KEY_ENTER):
            index = clamp(self.stats_sel.get(self.league, 0), 0, len(order) - 1)
            self.stats_team = (self.league, order[index])
            self.scroll["Players"] = 0
            return True
        return False

