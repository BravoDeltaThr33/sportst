class Result:
    __slots__ = ("data", "error", "loading", "stamp")

    def __init__(self, data=None, error=None, loading=False, stamp=0.0):
        self.data = data
        self.error = error
        self.loading = loading
        self.stamp = stamp

    @property
    def ok(self):
        return self.data is not None


def http_json(url, timeout=15):
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": "application/json, text/plain, */*",
            "Accept-Language": "en-US,en;q=0.9",
            "Cache-Control": "no-cache",
        },
    )
    raw, _ = net_read(request, timeout)
    return json.loads(raw.decode("utf-8", "replace"))


ERROR_TTL = 120


class Loader:
    """A data source that is not one plain ESPN URL: a function that makes
    whatever requests it needs and hands back ESPN-shaped JSON, so the
    AHL's HockeyTech feed and Wikipedia's Olympic tables go through the same
    cache, the same background threads and the same renderers."""

    def __init__(self, host, function, *args, **kwargs):
        self.host = host
        self.function = function
        self.args = args
        self.kwargs = kwargs

    def __call__(self, timeout):
        return self.function(*self.args, timeout=timeout, **self.kwargs)


def source_host(candidate):
    if isinstance(candidate, Loader):
        return candidate.host
    return urllib.parse.urlsplit(candidate).netloc


def load_source(candidate, timeout=15):
    if isinstance(candidate, Loader):
        return candidate(timeout)
    return http_json(candidate, timeout)


def describe_network_error(exc, host):
    """Turn socket errors into something a person can act on."""
    reason = getattr(exc, "reason", exc)
    errno = getattr(reason, "errno", None)
    text = str(reason)
    if isinstance(reason, OSError) and errno in (-2, -3, -5) or "Name or service" in text \
            or "Temporary failure in name resolution" in text:
        return f"DNS lookup failed for {host}"
    if isinstance(reason, (TimeoutError,)) or "timed out" in text:
        return f"{host} timed out"
    if "refused" in text:
        return f"{host} refused the connection"
    if "unreachable" in text.lower():
        return "network unreachable"
    return f"{host}: {text}"


class Fetcher:
    """Non-blocking cache. Ask for a URL, get whatever is on hand right now."""

    def __init__(self, workers=4, timeout=15):
        self.timeout = timeout
        self.cache = {}
        self.inflight = set()
        self.lock = threading.Lock()
        self.queue = queue.Queue()
        self.generation = 0
        self.requests_made = 0
        self.errors = {}
        for _ in range(workers):
            thread = threading.Thread(target=self._worker, daemon=True)
            thread.start()

    def _worker(self):
        while True:
            key, url, fallbacks = self.queue.get()
            data, error = None, None
            for candidate in [url] + list(fallbacks or []):
                host = source_host(candidate)
                # A failed DNS lookup or dropped connection is nearly always a
                # blip, so give each URL one quiet second try before giving up.
                for attempt in range(2):
                    try:
                        data = load_source(candidate, self.timeout)
                        error = None
                        break
                    except urllib.error.HTTPError as exc:
                        error = f"HTTP {exc.code} from {host}"
                        break
                    except urllib.error.URLError as exc:
                        error = describe_network_error(exc, host)
                    except (TimeoutError, ConnectionError) as exc:
                        error = describe_network_error(exc, host)
                    except json.JSONDecodeError:
                        error = f"bad JSON from {host}"
                        break
                    except Exception as exc:  # noqa: BLE001 - a TUI must not die here
                        error = f"{type(exc).__name__}: {exc}"
                        break
                    if attempt == 0:
                        time.sleep(0.75)
                if data is not None:
                    break
            with self.lock:
                self.requests_made += 1
                previous = self.cache.get(key)
                if data is None and previous is not None and previous.data is not None:
                    previous.error = error
                    previous.stamp = time.time()
                else:
                    self.cache[key] = Result(data, error, False, time.time())
                # A game with no posted line is normal, not worth a footer
                # warning. Everything else is remembered per request and
                # forgotten the moment that same request next succeeds.
                quiet = (isinstance(key, tuple) and key
                         and key[0] in ("odds", "mlbsched", "mlbpbp"))
                if error and not quiet:
                    self.errors[key] = (error, time.time())
                elif data is not None:
                    self.errors.pop(key, None)
                self.inflight.discard(key)
                self.generation += 1
            self.queue.task_done()

    def get(self, key, url, ttl=30, fallbacks=None):
        now = time.time()
        with self.lock:
            entry = self.cache.get(key)
            fresh = entry is not None and (now - entry.stamp) < ttl
            pending = key in self.inflight
            if not fresh and not pending:
                self.inflight.add(key)
                self.queue.put((key, url, fallbacks))
                pending = True
            if entry is None:
                return Result(None, None, pending, 0.0)
            return Result(entry.data, entry.error, pending, entry.stamp)

    def expire(self, predicate=None):
        with self.lock:
            if predicate is None:
                self.cache.clear()
            else:
                for key in [k for k in self.cache if predicate(k)]:
                    self.cache.pop(key, None)
            self.generation += 1

    def busy(self):
        with self.lock:
            return len(self.inflight)

    @property
    def last_error(self):
        """The newest failure that has not since been fixed by a retry, as
        (message, age in seconds), or None. Old failures age out so one DNS
        hiccup at 3 PM is not still on screen at 9 PM."""
        now = time.time()
        with self.lock:
            live = [(stamp, message) for message, stamp in self.errors.values()
                    if now - stamp < ERROR_TTL]
        if not live:
            return None
        stamp, message = max(live)
        return message, now - stamp


