def half_court(shots, league, team, cols):
    """One team's shots on a half court seen from above (the rim at the top):
    braille court lines, ● a make and ○ a miss in the team's colour."""
    court = court_for(league)
    depth = 28.0
    feet_per_px = 50.0 / (cols * 2)
    rows = int((depth + court["baseline"]) / (feet_per_px * 4)) + 1
    lit = court_pixels(court, cols, rows)
    cells = [[0] * cols for _ in range(rows)]
    for px, py in lit:
        cells[py // 4][px // 2] |= BRAILLE_BITS[py % 4][px % 2]
    marks = {}
    for shot in shots:
        row = int((shot["y"] + court["baseline"]) / (feet_per_px * 4))
        if row >= rows:
            continue
        col = clamp(int(shot["x"] / 50.0 * cols), 0, cols - 1)
        made, missed = marks.get((row, col), (0, 0))
        marks[(row, col)] = (made + shot["made"], missed + (not shot["made"]))
    if UNDER["on"]:
        # 7.0.0: a real court drawn under blank cells, the lane in the team's colour
        spec = {"cols": cols, "rows": rows, "baseline": court["baseline"],
                "lane": court["lane"], "arc": court["arc"], "corner": court["corner"],
                "paint": court_paint_hex(league, team), "teams": (team_hex(league, team),),
                "shots": tuple((round(s["x"], 1), round(s["y"], 1), int(s["made"]), 0, 0)
                               for s in shots)}
        number = underlay_number(("court", repr(spec)),
                                 lambda cw, ch, sp=spec: court_png(sp, cw, ch), cols, rows)
        return underlay_lines([Line().add(" " * cols, "normal") for _ in range(rows)], number)
    paint, ink = court_paint_hex(league, team), court_shot_hex(league, team)
    lines = []
    for row in range(rows):
        line = Line()
        for col in range(cols):
            ground = COURT_WOOD if court_text_cell(court, cols, rows, row, col) == "wood" \
                else paint
            made, missed = marks.get((row, col), (0, 0))
            if made:
                line.add("●", f"@{ink}:{ground}~b")
            elif missed:
                line.add("○", f"@{ink}:{ground}")
            elif cells[row][col]:
                line.add(chr(0x2800 + cells[row][col]), f"@F4F1EA:{ground}")
            else:
                line.add(" ", f"@{ground}:{ground}")
        lines.append(merge_spans(line))
    return lines


def basketball_story(summary, event, league, scorers=True):
    """What a broadcast puts beside the court: the run, the lead changes, the
    biggest leads, team fouls this period, points in the paint and on the
    break, and (`scorers`) each side's top scorer."""
    away, home = event["away"], event["home"]
    plays = dig(summary, "plays", default=[]) or []
    lines = []
    scoring = [p for p in plays if p.get("scoringPlay") and (p.get("scoreValue") or 0) > 0
               and dig(p, "team", "id")]
    if scoring and event["state"] == "in":
        last = str(dig(scoring[-1], "team", "id"))
        run = 0
        for play in reversed(scoring):
            if str(dig(play, "team", "id")) != last:
                break
            run += play.get("scoreValue") or 0
        side = side_of(event, last)
        if side and run >= 5:
            team = event[side]
            lines.append(Line().add(f"{'RUN':<14}", "muted")
                         .add(f"{team.get('abbr', '')} {run}-0", THEME.style(league, team,
                                                                              bold=True))
                         .add(" unanswered", "dim"))
    changes, ties, last_leader, state = 0, 0, 0, 0
    for play in scoring:
        a, h = play.get("awayScore"), play.get("homeScore")
        if not isinstance(a, int) or not isinstance(h, int):
            continue
        now = (a > h) - (a < h)
        if now == 0 and state != 0:
            ties += 1
        if now:
            if last_leader and now != last_leader:
                changes += 1
            last_leader = now
        state = now
    if scoring:
        line = Line().add(f"{'LEAD':<14}", "muted").add(f"{changes}", "bold")
        line.add(f" change{'s' if changes != 1 else ''} · tied ", "dim").add(f"{ties}", "bold")
        line.add(f" time{'s' if ties != 1 else ''}", "dim")
        lines.append(line)
    biggest = (box_stat(summary, away.get("id"), "largestLead"),
               box_stat(summary, home.get("id"), "largestLead"))
    if any(biggest):
        lines.append(_stat_line("BIGGEST LEAD", event, league, biggest[0] or "0",
                                biggest[1] or "0"))
    period = max([dig(p, "period", "number", default=0) or 0 for p in plays] or [0])
    if period and event["state"] == "in":
        fouls = {"away": 0, "home": 0}
        for play in plays:
            if (dig(play, "period", "number", default=0) or 0) != period:
                continue
            kind = clean(dig(play, "type", "text", default="")).lower()
            if "foul" not in kind or "technical" in kind or "offensive" in kind \
                    or "double" in kind:
                continue
            side = side_of(event, dig(play, "team", "id"))
            if side:
                fouls[side] += 1
        label = "FOULS THIS Q" if quarters(league) else "FOULS THIS HALF"
        lines.append(_stat_line(label, event, league, fouls["away"], fouls["home"],
                                label_width=16))
    for label, stat in (("IN THE PAINT", "pointsInPaint"), ("FAST BREAK", "fastBreakPoints"),
                        ("TURNOVERS", "totalTurnovers")):
        pair = (box_stat(summary, away.get("id"), stat), box_stat(summary, home.get("id"),
                                                                    stat))
        if any(pair):
            lines.append(_stat_line(label, event, league, pair[0] or "0", pair[1] or "0"))
    tops = [(event[side], game_top_scorer(summary, event[side].get("id")))
            for side in ("away", "home")] if scorers else []
    if any(text for _, text in tops):
        lines.append(blank())
        lines.append(Line().add("TOP SCORERS", "title"))
        for team, text in tops:
            if text:
                lines.append(Line().add(f"{team.get('abbr', ''):<5}", THEME.style(
                    league, team, bold=True)).add(text, "normal"))
    return lines


def half_court_rows(league, cols):
    """How many rows half_court draws at `cols` columns."""
    court = court_for(league)
    return int((28.0 + court["baseline"]) / ((50.0 / (cols * 2)) * 4)) + 1


def bball_courts(summary, event, league, cols):
    """Both teams' shots on half courts side by side, each headed by its
    makes, the key underneath; [] when no shot has a location."""
    shots = basketball_shots(summary)
    if not shots:
        return []
    courts = []
    for side in ("away", "home"):
        team = event[side]
        mine = [s for s in shots if s["team"] == str(team.get("id"))]
        made = sum(1 for s in mine if s["made"])
        head = Line().add(f"{team.get('abbr', '')} ", THEME.style(league, team, bold=True))
        text = f"{made}/{len(mine)} from the field"
        if len(head.text) + len(text) > cols:
            text = f"{made}/{len(mine)} FG"
        head.add(text[: max(0, cols - len(head.text))], "dim")
        courts.append([head] + half_court(mine, league, team, cols))
    out = []
    for index in range(max(len(court) for court in courts)):
        line = Line()
        for number, court in enumerate(courts):
            part = court[index] if index < len(court) else Line()
            if number:
                line.add("   ", "normal")
            line.extend(part)
            line.add(" " * max(0, cols - len(part.text)), "normal")
        out.append(line)
    out.append(Line().add("● made  ○ missed", "muted"))
    return out


def bball_box_refs(summary, event):
    """Every player in a basketball box score: his name, id, photo, number,
    team, side and stats by their labels."""
    refs = []
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        ident = str(dig(block, "team", "id", default=""))
        side = "home" if ident == str(event["home"].get("id")) else "away"
        for section in block.get("statistics") or []:
            labels = [clean(label) for label in section.get("labels") or []]
            for entry in section.get("athletes") or []:
                athlete = entry.get("athlete") or {}
                refs.append({
                    "name": clean(athlete.get("shortName") or athlete.get("displayName")
                                  or ""),
                    "id": str(athlete.get("id") or ""),
                    "headshot": clean(dig(athlete, "headshot", "href", default="") or ""),
                    "jersey": clean(athlete.get("jersey") or ""),
                    "team": event[side], "side": side,
                    "stats": dict(zip(labels, [clean(s) for s in entry.get("stats") or []]))})
    return refs


def bball_center_performers(summary, event, league, width, count=3, face=None):
    """The Game Center's TOP PERFORMERS card: each team's best by game score,
    a line each - his name, game score and line - with foul trouble flagged
    while the game is on (two fouls from fouling out, then one) and a player
    who fouled out; where the terminal shows pictures, each team's best in his
    photo beside them (`face(ref, cols, rows)`)."""
    refs = bball_box_refs(summary, event)
    limit = 5 if league in COLLEGE_LEAGUES else 6   # the fouls that put a player out
    live = event["state"] == "in"
    teams = {side: [ref for ref in refs if ref["side"] == side] for side in ("away", "home")}
    best = {side: bball_performers(teams[side])[:count] for side in teams}
    name_w = min(18, max([len(teams[side][index]["name"]) for side in best
                          for _, index in best[side]] + [6]))
    compact = width < 56          # a narrow card: his points, rebounds and assists
    out = []
    for side in ("away", "home"):
        team = event[side]
        mine, ranked = teams[side], best[side]
        if not ranked:
            continue
        if out:
            out.append(blank())
        photo = []
        if face and width >= 56:
            try:
                photo = face(mine[ranked[0][1]], 12, len(ranked) + 1) or []
            except Exception:  # noqa: BLE001 - a photo is a nicety
                photo = []
        photo_w = max((len(line.text) for line in photo), default=0)
        room = width - (photo_w + 2 if photo_w else 0)
        block = [Line().add(f"{team.get('abbr', ''):<5}", THEME.style(
            league, team, bold=True, fallback="accent")).add(
                clean(team.get("name") or ""), "dim")]
        for value, index in ranked:
            ref = mine[index]
            fouls = _int(ref["stats"].get("PF"))
            stats = ref["stats"]
            line = Line().add(f"{ref['name'][:name_w]:<{name_w}} ", "normal")
            if not compact:
                line.add(f"{value:5.1f}  ", "bold")
            if fouls >= limit:
                line.add("fouled out  " if not compact else "out ", "bad")
            elif live and fouls >= limit - 2:
                line.add(f"{fouls} fouls  " if not compact else f"{fouls}PF ",
                         "bad" if fouls == limit - 1 else "warn")
            if compact:
                parts = [f"{_int(stats.get(key))} {key}" for key in ("PTS", "REB", "AST")]
                joint = " "
            else:
                parts = [f"{stats.get('PTS') or '0'} PTS"] +                     [f"{stats[key]} {key}" for key in ("REB", "AST") if _int(stats.get(key))]
                if stats.get("FG"):
                    parts.append(f"{stats['FG']} FG")
                parts += [f"{stats[key]} {key}" for key in ("STL", "BLK")
                          if _int(stats.get(key)) >= 2]
                joint = " · "
            # whole items only: the last ones go when the card is narrow
            left = room - len(line.text)
            while len(parts) > 1 and len(joint.join(parts)) > left:
                parts.pop()
            line.add(joint.join(parts), "dim")
            block.append(fit_line(line, room))
        for row in range(max(len(photo), len(block))):
            line = Line()
            if photo_w:
                line.extend(photo[row] if row < len(photo) else
                            Line().add(" " * photo_w, "normal"))
                line.add("  ", "normal")
            if row < len(block):
                line.extend(block[row])
            out.append(line)
    return out


def compose_basketball(canvas, y, event, summary, league, width, height, corners=None,
                       face=None):
    """Basketball's Game Center under the score band, every part on a card of
    its own. Along the top the shot chart, the score by quarter over the
    game's story, and the top performers in the room under the home team's
    logo; then win probability across the screen; then the team stats beside
    the last plays. On a smaller screen the top row gives way first (the top
    scorers move into the story), then win probability. Before tip-off: the
    matchup and the season leaders."""
    rest = height - y
    if rest < 4 or width < 30:
        return
    if event["state"] == "pre":
        center_pregame_cards(canvas, y, event, summary, league, width, height, corners)
        return
    period_word = "BY QUARTER" if quarters(league) else "BY HALF"
    by_period = render_linescore(event, league)
    quarters_w = min(width, max([len(line.text) for line in by_period] + [10]) + 6)
    if not summary:
        if by_period:
            canvas.card(y, 0, min(rest, len(by_period) + 2), quarters_w, period_word,
                        by_period, corners)
        return
    # the top row: which cards fit across, and how wide each is
    shots = basketball_shots(summary)
    mid_w, perf_min = 42, 36
    courts_on = bool(shots) and width >= 47 + mid_w
    perf_on = width >= mid_w + perf_min + (47 if courts_on else 0)
    if courts_on and perf_on:
        cols = clamp((width - mid_w - max(perf_min, int(width * 0.38)) - 7) // 2, 20, 34)
    else:
        cols = clamp((width - mid_w - 7) // 2, 20, 34)
    # how tall: the bottom row keeps six rows; the top row takes what it wants
    # of the rest; win probability what is left
    room = rest - min(rest, 6)
    while courts_on and half_court_rows(league, cols) + 4 > room:
        cols -= 1
        if cols < 20:
            courts_on = False
    courts = bball_courts(summary, event, league, cols) if courts_on else []
    court_w = 2 * cols + 7 if courts else 0
    perf_w = width - court_w - mid_w if perf_on else 0
    if perf_on and perf_w < perf_min:
        perf_on, perf_w = False, 0
    performers = []
    if perf_on:
        for count in (4, 3, 2, 1):
            performers = bball_center_performers(summary, event, league, perf_w - 4, count,
                                                  face)
            if len(performers) + 2 <= room:
                break
        if len(performers) + 2 > room:
            performers = []
    story = basketball_story(summary, event, league, scorers=not performers)
    quarters_up = bool(by_period) and len(by_period) + 2 + len(story) + 2 <= room
    mid_h = (len(by_period) + 2 if quarters_up else 0) + (len(story) + 2 if story else 0)
    top_h = max([len(courts) + 2 if courts else 0, mid_h,
                 len(performers) + 2 if performers else 0])
    top_h = min(top_h, room)
    if top_h < 7:
        top_h, courts, performers, quarters_up = 0, [], [], False
    # win probability across the screen, its curve shorter when room is short
    win = []
    left_over = rest - top_h - 6
    for curve in (3, 2):
        if left_over >= curve + 3:
            win = render_winbar(summary, event, league, width - 4, rows=curve)[1:]
            break
    win_h = len(win) + 2 if win else 0
    low_h = rest - top_h - win_h
    # the top row
    if top_h:
        x = 0
        if courts:
            canvas.card(y, x, top_h, court_w, "SHOT CHART", courts, corners)
            x += court_w
        wide = width - x - (perf_w if performers else 0)
        column_y = y
        if quarters_up:
            canvas.card(column_y, x, len(by_period) + 2, wide, period_word, by_period, corners)
            column_y += len(by_period) + 2
        if story or column_y < y + top_h:
            canvas.card(column_y, x, y + top_h - column_y, wide, "THE GAME", story, corners)
        x += wide
        if performers:
            canvas.card(y, x, top_h, width - x,
                        [("TOP PERFORMERS", "title"), ("  by game score", "muted")],
                        performers, corners)
    if win:
        canvas.card(y + top_h, 0, win_h, width,
                    [("WIN PROBABILITY", "title"), ("  ESPN's model", "muted")], win, corners)
    # the bottom row: the team stats (the score by quarter over them when it
    # is not up top) beside the last plays
    if low_h < 3:
        return
    low_y = y + top_h + win_h
    left_w = width // 2
    right_w = width - left_w
    column_y = low_y
    if by_period and not quarters_up:
        tall = min(low_h, len(by_period) + 2)
        if low_h - tall < 3:
            tall = low_h            # no room for the team stats: the card fills it
        canvas.card(column_y, 0, tall, left_w, period_word, by_period, corners)
        column_y += tall
    stats_h = low_y + low_h - column_y
    if stats_h >= 3:
        stats, _ = team_stat_sections(summary, league, left_w - 4)
        canvas.card(column_y, 0, stats_h, left_w, "TEAM STATS", stats, corners)
    inner = low_h - 2
    plays = recent_plays(summary, event, league, right_w - 4, count=max(4, inner))
    if plays and plays[0].text == "LAST PLAYS":
        plays = plays[1:]
    title = "LAST PLAYS"
    if not plays and event["state"] == "post":
        plays, title = render_game_leaders(summary, league, right_w - 4, heading=False), \
            "GAME LEADERS"
    if not plays and event["state"] == "in":
        last = clean(dig(event.get("situation") or {}, "lastPlay", "text", default=""))
        plays = wrap_spans(last, right_w - 4, "normal") if last else \
            [Line().add("The plays come in as the game goes on.", "dim")]
    canvas.card(low_y, left_w, low_h, right_w, title, plays[:inner], corners)


def center_pregame_cards(canvas, y, event, summary, league, width, height, corners=None):
    """Before the start, on cards: THE MATCHUP (the line, ESPN's predictor,
    the weather, the probable pitchers, each team's form, the venue, the TV)
    and SEASON LEADERS."""
    rest = height - y
    if rest < 3:
        return
    away, home = event["away"], event["home"]
    half = width // 2
    left = center_pregame(event, summary, league, half - 4)[1:]
    right = render_leaders(league, [away, home], width - half - 4) \
        if summary and (away.get("leaders") or home.get("leaders")) else []
    while right and not right[-1]:
        right.pop()
    tall = clamp(max(len(left), len(right)) + 2, 3, rest)
    if right and width >= 80:
        canvas.card(y, 0, tall, half, "THE MATCHUP", left, corners)
        canvas.card(y, half, tall, width - half, "SEASON LEADERS", right, corners)
    else:
        canvas.card(y, 0, tall, width, "THE MATCHUP", left + right, corners)


CENTER_PERIODS = {"football": "BY QUARTER", "hockey": "BY PERIOD", "baseball": "BY INNING",
                  "soccer": "BY HALF"}


def center_stack(canvas, y, x, height, width, cards, corners=None):
    """`cards` [(title, lines)] one under another in a column `height` rows
    tall: each as tall as its lines, the last one the rest. A card with no
    title is a row of cards drawn already: its lines go in as they are, or
    not at all."""
    top = y
    for number, (title, lines) in enumerate(cards):
        room = y + height - top
        if title is None:
            if len(lines) <= room:
                canvas.lines(top, x, lines, width)
                top += len(lines)
            continue
        if room < 3:
            break
        tall = room if number == len(cards) - 1 else min(room, len(lines) + 2)
        canvas.card(top, x, tall, width, title, lines, corners)
        top += tall


# LEADERS' tags for a player's tables, and the order his lines go in when
# they earned him the same
FOOTBALL_LEADER_TAGS = {"passing": "PASS", "rushing": "RUSH", "receiving": "REC",
                        "defensive": "DEF", "interceptions": "INT", "fumbles": "FUM",
                        "kickreturns": "KR", "puntreturns": "PR", "kicking": "KICK",
                        "punting": "PUNT"}
FOOTBALL_LEADER_ORDER = ("passing", "rushing", "receiving", "defensive", "interceptions",
                         "kicking", "kickreturns", "puntreturns", "punting", "fumbles")
# a position worked out from a man's tables when nothing names it
FOOTBALL_POSITION_GUESS = {"passing": ("QB", "Quarterback"), "kicking": ("PK", "Place Kicker"),
                           "punting": ("P", "Punter")}


def football_stat_text(group, stats):
    """A player's numbers in one table the way ESPN's leaders read them:
    '27/37, 304 YDS, 2 TD, 1 INT', '15 CAR, 52 YDS, 1 TD', '9 REC, 134 YDS',
    '9 TKL, 1 SACK, 2 TFL', '1 INT, 35 YDS', 'FG 2/2, XP 3/3, 9 PTS',
    '4 PUNTS, 44.3 AVG'; '' when there is nothing to tell."""
    kind = football_group(group)
    s = {clean(str(key)).strip().upper(): clean(str(value)).strip()
         for key, value in (stats or {}).items()}

    def some(key):
        return s.get(key) not in (None, "", "0", "0.0", "0-0", "0/0", "--", "-")

    def count(key, word, plural=None):
        if not some(key):
            return ""
        return f"{s[key]} {plural if plural and football_count(s[key]) != 1 else word}"
    if kind == "passing":
        if not (some("C/ATT") or some("YDS")):
            return ""
        parts = [s.get("C/ATT") or "", f"{s.get('YDS') or 0} YDS", count("TD", "TD"),
                 count("INT", "INT")]
    elif kind == "rushing":
        if not (some("CAR") or some("YDS")):
            return ""
        parts = [f"{s.get('CAR') or 0} CAR", f"{s.get('YDS') or 0} YDS", count("TD", "TD")]
    elif kind == "receiving":
        if not (some("REC") or some("YDS")):
            return ""
        parts = [f"{s.get('REC') or 0} REC", f"{s.get('YDS') or 0} YDS", count("TD", "TD")]
    elif kind in ("defensive", "tackles"):
        parts = [count("TOT", "TKL"), count("SACKS", "SACK", "SACKS"), count("TFL", "TFL"),
                 count("PD", "PD"), count("TD", "TD")]
    elif kind == "interceptions":
        if not some("INT"):
            return ""
        parts = [count("INT", "INT"), count("YDS", "YDS"), count("TD", "TD")]
    elif kind in ("kickreturns", "puntreturns"):
        if not some("NO"):
            return ""
        parts = [count("NO", "RET"), f"{s.get('YDS') or 0} YDS", count("TD", "TD")]
    elif kind == "kicking":
        parts = [f"FG {s['FG']}" if some("FG") and re.search(r"[/-]", s["FG"]) else "",
                 f"XP {s['XP']}" if some("XP") else "", count("PTS", "PTS")]
    elif kind == "punting":
        if not some("NO"):
            return ""
        parts = [count("NO", "PUNT", "PUNTS"), f"{s['AVG']} AVG" if some("AVG") else ""]
    elif kind == "fumbles":
        parts = [count("FUM", "FUM"), count("LOST", "LOST"), count("REC", "REC")]
    else:
        return ""
    return ", ".join(part for part in parts if part)


def football_positions(summary, known=None):
    """{athlete id: (abbreviation, name, number)}: what each man plays and
    wears, from the two teams' rosters (`known`, the App's) and ESPN's game
    leaders, who carry theirs."""
    out = dict(known or {})
    for block in dig(summary, "leaders", default=[]) or []:
        for category in block.get("leaders") or []:
            for item in category.get("leaders") or []:
                athlete = item.get("athlete") or {}
                ident = str(athlete.get("id") or "")
                position = athlete.get("position") or {}
                if ident and ident not in out and position.get("abbreviation"):
                    out[ident] = (clean(position.get("abbreviation") or ""),
                                  clean(position.get("displayName") or
                                        position.get("name") or ""),
                                  clean(str(athlete.get("jersey") or "")))
    return out


def football_position_of(player, positions):
    """(abbreviation, name) of a LEADERS player's position: the rosters' or
    the game leaders', else a quarterback, kicker or punter by his tables;
    ('', '') when nothing says."""
    found = positions.get(str(player.get("id") or ""))
    if found and found[0]:
        return found[0], found[1]
    kinds = {football_group(group): stats for group, stats in player.get("lines") or []}
    passing = kinds.get("passing") or {}
    tries = football_made((passing.get("C/ATT") or "").replace("/", "-"))[1]
    if tries >= 5:
        return FOOTBALL_POSITION_GUESS["passing"]
    for kind in ("kicking", "punting"):
        if kind in kinds and not any(k in kinds for k in ("passing", "rushing", "receiving")):
            return FOOTBALL_POSITION_GUESS[kind]
    return "", ""


def football_leader_text(player, value, league, width, positions):
    """A LEADERS player's lines, `width` wide: his name in his team's colour
    and his fantasy points; his number, position and team; then his line in
    each table he is in, the one that earned him most first (three at most)."""
    team = player["team"]
    colour = THEME.style(league, team, bold=True, fallback="accent")
    points = f"{value:g} fantasy pts"
    name = player["name"]
    if len(name) + 2 + len(points) > width:
        points = f"{value:g} pts"
    if len(name) + 2 + len(points) > width:
        name = player.get("short") or name
    head = Line().add(name[:width], colour)
    if len(name) + 2 + len(points) <= width:
        head.add(" " * (width - len(name) - len(points)), "normal").add(points, "muted")
    abbr, full = football_position_of(player, positions)
    # his number before his position (the box score's, else the roster's):
    # on a narrow card the position and the team shorten, the number stays
    found = positions.get(str(player.get("id") or "")) or ()
    number = player.get("jersey") or (found[2] if len(found) > 2 else "")
    number = f"#{number}" if number else ""
    team_name = clean(team.get("name") or team.get("abbr") or "")
    short = team.get("abbr") or ""
    who = None
    for spot, side in ((full, team_name), (abbr, team_name), (abbr, short), ("", team_name),
                       ("", short), ("", "")):
        words = " ".join(part for part in (number, spot) if part)
        if len(words) + (3 if words and side else 0) + len(side) <= width:
            who = Line()
            if number:
                who.add(number, "bold")
                if spot:
                    who.add(" ", "normal")
            if spot:
                who.add(spot, "normal")
            if words and side:
                who.add(" · ", "muted")
            if side:
                who.add(side, THEME.style(league, team, fallback="accent"))
            break
    text = [head] + ([who] if who else [])
    order = {kind: index for index, kind in enumerate(FOOTBALL_LEADER_ORDER)}
    lines = sorted(player.get("lines") or [],
                   key=lambda item: (-football_points([item]),
                                     order.get(football_group(item[0]), 99)))
    shown = 0
    for group, stats in lines:
        words = football_stat_text(group, stats)
        kind = football_group(group)
        if not words or shown >= 3:
            continue
        tag = FOOTBALL_LEADER_TAGS.get(kind, kind[:4].upper())
        line = Line().add(f"{tag:<6}", "muted")
        bits = words.split(", ")
        while len(bits) > 1 and len(", ".join(bits)) > width - 6:
            bits.pop()
        line.add(", ".join(bits), "bold" if not shown else "normal")
        text.append(fit_line(line, width))
        shown += 1
    return text


def football_center_leaders(summary, event, league, width, face=None, rows=None,
                            positions=None):
    """The Game Center's LEADERS card for football: the game's top three
    players by fantasy points (the Boxscore's measure), each in his photo
    where the terminal shows pictures, beside his name and points, his
    position and team, and his line in every table he is in. As many whole
    players as `rows` holds, a blank line between them when there is room."""
    best = football_best_players(summary, event, 3)
    if not best:
        return []
    known = football_positions(summary, positions)
    cols, tall = CENTER_LEADER_PHOTO
    photos = []
    for _, player in best:
        photo = []
        if face and width >= 46:
            try:
                photo = face({"id": player["id"], "headshot": player["headshot"]}, cols,
                             tall) or []
            except Exception:  # noqa: BLE001 - a photo is a nicety
                photo = []
        photos.append(photo)
    photo_w = max((len(line.text) for photo in photos for line in photo), default=0)
    room = width - (photo_w + 2 if photo_w else 0)
    blocks = []
    for (value, player), photo in zip(best, photos):
        text = football_leader_text(player, value, league, room, known)
        block = []
        for row in range(max(len(photo), len(text))):
            line = Line()
            if photo_w:
                # every text in one column, with a photo or without
                cells = photo[row] if row < len(photo) else Line()
                line.extend(cells)
                line.add(" " * (photo_w - len(cells.text) + 2), "normal")
            if row < len(text):
                line.extend(text[row])
            block.append(line)
        blocks.append(block)
    for count in range(len(blocks), 0, -1):
        for gap in (1, 0):
            if rows is None or sum(len(block) for block in blocks[:count]) + \
                    gap * (count - 1) <= rows:
                out = []
                for index, block in enumerate(blocks[:count]):
                    if index and gap:
                        out.append(blank())
                    out.extend(block)
                return out
    return blocks[0]


CENTER_LEADER_PHOTO = (14, 5)     # a LEADERS photo at most, in cells


def football_best_players(summary, event, count=1):
    """The game's best by fantasy points: [(points, {'name', 'short', 'id',
    'jersey', 'headshot', 'team', 'lines'})], best first."""
    players = []
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = "home" if str(dig(block, "team", "id", default="")) == \
            str(event["home"].get("id")) else "away"
        found = {}
        for section in block.get("statistics") or []:
            labels = [clean(l) for l in section.get("labels") or []]
            for entry in section.get("athletes") or []:
                athlete = entry.get("athlete") or {}
                ident = str(athlete.get("id") or "")
                name = clean(athlete.get("displayName") or athlete.get("shortName") or "")
                if not ident or not name:
                    continue
                headshot = athlete.get("headshot")
                found.setdefault(ident, {
                    "id": ident, "name": name,
                    "short": clean(athlete.get("shortName") or name),
                    "jersey": clean(str(athlete.get("jersey") or "")),
                    "headshot": clean((headshot.get("href") if isinstance(headshot, dict)
                                       else headshot) or ""),
                    "team": event[side], "lines": []})
                found[ident]["lines"].append(
                    (clean(section.get("name") or ""),
                     dict(zip(labels, [clean(s) for s in entry.get("stats") or []]))))
        players.extend(found.values())
    ranked = sorted(((football_points(player["lines"]), player) for player in players),
                    key=lambda item: -item[0])
    return [(value, player) for value, player in ranked if value > 0][:count]


def baseball_center_pitching(summary, event, league, width):
    """The Game Center's PITCHING card: each team's pitchers in the order
    they came in - innings, hits, runs, earned runs, walks, strikeouts and
    pitches - with the decisions marked (W, L, S)."""
    decisions = {}
    status = dig(summary, "header", "competitions", 0, "status", default={}) or {}
    for item in status.get("featuredAthletes") or []:
        tag = {"winningPitcher": "W", "losingPitcher": "L", "savingPitcher": "S"}.get(
            item.get("name"))
        ident = str(dig(item, "athlete", "id", default="") or "")
        if tag and ident:
            decisions[ident] = tag
    teams = {}
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = side_of(event, dig(block, "team", "id"))
        if not side:
            continue
        for group in block.get("statistics") or []:
            labels = [clean(label) for label in group.get("labels") or []]
            if "IP" not in labels:
                continue
            rows = []
            for entry in group.get("athletes") or []:
                stats = dict(zip(labels, [clean(s) for s in entry.get("stats") or []]))
                if not stats.get("IP"):
                    continue
                athlete = entry.get("athlete") or {}
                rows.append((clean(athlete.get("shortName") or athlete.get("displayName")
                                   or ""), decisions.get(str(athlete.get("id") or ""), ""),
                             stats))
            if rows:
                teams[side] = rows
    if not teams:
        return []
    name_w = min(18, max(len(row[0]) for rows in teams.values() for row in rows))
    out = []
    for side in ("away", "home"):
        if side not in teams:
            continue
        team = event[side]
        if out:
            out.append(blank())
        out.append(Line().add(f"{team.get('abbr', ''):<5}", THEME.style(
            league, team, bold=True, fallback="accent")).add(clean(team.get("name") or ""),
                                                             "dim"))
        for name, tag, stats in teams[side]:
            line = Line().add(f"{name[:name_w]:<{name_w}} ", "normal")
            line.add(f"{tag:<2}", "good" if tag == "W" else "bad" if tag == "L" else "accent")
            parts = [f"{stats.get('IP')} IP"] + [f"{stats[key]} {key}" for key in
                                                ("H", "R", "ER", "BB", "K")
                                                if stats.get(key) not in (None, "")]
            pitches = stats.get("PC") or (stats.get("PC-ST") or "").split("-")[0]
            if pitches:
                parts.append(f"{pitches} P")
            while len(parts) > 1 and len("  ".join(parts)) > width - len(line.text):
                parts.pop()
            line.add("  ".join(parts), "dim")
            out.append(fit_line(line, width))
    return out


def baseball_scoring_lines(summary, event, league, width, count):
    """The last `count` scoring plays: half inning, team, the play, the score
    after it."""
    scoring = [p for p in dig(summary, "plays", default=[]) or [] if p.get("scoringPlay")]
    lines = []
    text_w = max(16, width - 18)
    for play in scoring[-max(1, count):]:
        number = dig(play, "period", "number", default=0) or 0
        half = "B" if str(dig(play, "period", "type", default="")).lower().startswith(
            "bot") else "T"
        side = side_of(event, dig(play, "team", "id")) or ("home" if half == "B" else "away")
        team = event[side]
        line = Line().add(f"{half}{number:<3}", "dim")
        line.add(f"{team.get('abbr', ''):<5}", THEME.style(league, team, bold=True))
        line.add(f"{cut_text(clean(play.get('text') or ''), text_w):<{text_w}}", "normal")
        a, h = play.get("awayScore"), play.get("homeScore")
        if isinstance(a, int) and isinstance(h, int):
            line.add(f" {a}-{h}", "bold")
        lines.append(line)
    return lines


def soccer_center_parts(summary, event, league, width):
    """Soccer's Game Center cards' contents: the match timeline, the match's
    numbers (possession and the rest), the goals and the cards."""
    items = soccer_events(summary, event)
    away, home = event["away"], event["home"]
    timeline = soccer_timeline(items, event, league, min(width, 110)) if items else []
    numbers = []
    possession = (box_stat(summary, away.get("id"), "possessionPct"),
                  box_stat(summary, home.get("id"), "possessionPct"))
    try:
        share = float(possession[0]) / max(1.0, float(possession[0]) + float(possession[1]))
    except (TypeError, ValueError):
        share = None
    if share is not None:
        bar_w = clamp(width - 40, 10, 50)
        cut = int(round(share * bar_w))
        line = Line().add(f"{'POSSESSION':<14}", "muted")
        line.add(f"{away.get('abbr', '')} {float(possession[0]):.0f}% ",
                 THEME.style(league, away, bold=True))
        line.add("█" * cut, "@" + team_hex(league, away))
        line.add("█" * (bar_w - cut), "@" + team_hex(league, home))
        line.add(f" {float(possession[1]):.0f}% {home.get('abbr', '')}",
                 THEME.style(league, home, bold=True))
        numbers.append(line)
    for label, stat, extra in (("SHOTS", "totalShots", "shotsOnTarget"),
                               ("CORNERS", "wonCorners", None),
                               ("FOULS", "foulsCommitted", None), ("SAVES", "saves", None),
                               ("OFFSIDES", "offsides", None)):
        values = []
        for team in (away, home):
            value = box_stat(summary, team.get("id"), stat)
            if extra and value:
                on = box_stat(summary, team.get("id"), extra)
                value = f"{value} ({on} on target)" if on else value
            values.append(value)
        if any(values):
            numbers.append(_stat_line(label, event, league, values[0] or "0",
                                      values[1] or "0"))
    goals, cards = [], []
    for _, minute_text, side, mark, who in items:
        team = event[side]
        line = Line().add(f"{minute_text:>7}  ", "dim")
        if mark != "goal":
            line.add("▮ ", "@" + (CARD_RED if mark == "red" else CARD_YELLOW))
        line.add(f"{team.get('abbr', ''):<5}", THEME.style(league, team, bold=True))
        line.add(who[:32] or ("goal" if mark == "goal" else mark), "normal")
        (goals if mark == "goal" else cards).append(line)
    return timeline, numbers, goals, cards


def hockey_rink_lines(shots, event, league, cols):
    """The rink with every shot on goal, headed by each side's shots, the
    key underneath."""
    head = Line()
    for side in ("away", "home"):
        team = event[side]
        mine = [s for s in shots if s["side"] == side]
        if head:
            head.add("   ", "normal")
        head.add(f"{team.get('abbr', '')} ", THEME.style(league, team, bold=True))
        head.add(("◀ " if side == "away" else "▶ ") + f"{len(mine)} shots", "dim")
    return [head] + rink_lines(shots, event, league, cols) + \
        [Line().add("• shot on goal  ● goal", "muted")]


def rink_rows(cols):
    """How many rows rink_lines draws at `cols` columns (85 x 200 ft)."""
    import math
    return math.ceil(85.0 / (200.0 / (cols * 2)) / 4)


def compose_cards(canvas, y, event, summary, league, width, height, corners=None,
                  face=None, positions=None, pictures=False):
    """Football's, hockey's, baseball's and soccer's Game Center under the
    score band, every part on a card of its own, as basketball's is: along
    the top the score by period and the sport's own picture - the field and
    the down (the scoring summary once it is over), the rink with every shot
    on goal and the game's numbers, the diamond (the scoring plays once it
    is over), the match timeline - with, in the room under the home team's
    logo, what matters most in the sport: football's leaders, hockey's goals
    and goalies, baseball's pitching, soccer's goals and cards; then win
    probability across the screen; then the team stats beside the last plays
    (football: the drive). Parts give way on a smaller screen as
    basketball's do. Before the start: the matchup and the season leaders."""
    rest = height - y
    if rest < 4 or width < 30:
        return
    if event["state"] == "pre":
        center_pregame_cards(canvas, y, event, summary, league, width, height, corners)
        return
    sport = sport_of(league)
    away, home = event["away"], event["home"]
    quarters = render_linescore(event, league)
    if sport == "soccer" and not (away.get("linescores") or home.get("linescores")):
        quarters = []           # ESPN keeps no half-by-half score for these
    period_word = CENTER_PERIODS.get(sport, "BY PERIOD")
    quarters_w = min(width, max([len(line.text) for line in quarters] + [10]) + 6)
    if not summary:
        if quarters:
            canvas.card(y, 0, min(rest, len(quarters) + 2), quarters_w, period_word,
                        quarters, corners)
        return
    room = rest - min(rest, 6)
    live = event["state"] == "in"
    quarters_card = [(period_word, quarters)] if quarters else []
    columns = []                 # [(width, [(title, lines)])], left to right
    banner = None                # (title, lines): a card across the screen over them
    if sport == "football":
        right_w = clamp(width * 36 // 100, 50, 70) if width >= 110 else 0
        # no taller than the drive chart's column (its row, the chart's card)
        leaders = football_center_leaders(summary, event, league, right_w - 4, face,
                                          rows=room - 7, positions=positions) \
            if right_w else []
        if not leaders:
            right_w = 0
        left_w = width - right_w
        # along the top, side by side: the score by quarter, the down and
        # distance, the line and the biggest play (or the game's facts)
        row, down_shown = football_top_row(summary, event, league, left_w, quarters,
                                           corners)
        row_h = len(row) if row else (len(quarters) + 2 if quarters else 0)
        chart_rows = room - row_h - 2 - 5
        chart = football_drive_chart(summary, event, league, min(left_w - 4, 150),
                                     chart_rows, info_line=not down_shown,
                                     pictures=pictures) \
            if chart_rows >= 5 else []
        if chart:
            pad = " " * max(0, (left_w - 4 - min(left_w - 4, 150)) // 2)
            picture = [("DRIVE CHART", [Line().add(pad, "normal").extend_spans(line)
                                        for line in chart])]
        elif live:
            driving = str(dig(summary, "drives", "current", "team", "id", default="") or "")
            hint = "away" if driving and driving == str(away.get("id")) else \
                "home" if driving and driving == str(home.get("id")) else ""
            field_w = min(left_w - 4, 132)
            pad = " " * max(0, (left_w - 4 - field_w) // 2)
            picture = [("THE FIELD", [Line().add(pad, "normal").extend_spans(line)
                                      for line in render_field(event, league, field_w,
                                                               hint)])]
        else:
            tall = max(1, room - row_h - 2)
            scoring = football_panel(summary, event, league, left_w - 4, tall + 1)[1:]
            picture = [("SCORING SUMMARY", scoring)] if scoring else []
        columns.append((left_w, ([(None, row)] if row else quarters_card) + picture))
        if leaders:
            columns.append((right_w, [("LEADERS", leaders)]))
    elif sport == "hockey":
        shots = hockey_shots(summary, event)
        numbers = hockey_story(summary, event, league, goalies=False)
        keepers = hockey_goalies(summary, event, league)
        goals = hockey_goals(summary, event, league, limit=max(3, room - 5 - len(keepers)),
                             width=max(40, width - 46 - (64 if shots else 0) - 4))
        goals = goals[1:]
        side_cards = ([("GOALS", goals)] if goals else []) +             ([("GOALIES", keepers)] if keepers else [])
        mid = quarters_card + ([("THE GAME", numbers)] if numbers else [])
        three = bool(shots) and width >= 126
        cols = 0
        if shots and width >= 86:
            target = clamp(width - 42 - (max(44, int(width * 0.36)) if three else 0), 44, 64)
            cols = target - 4
            while cols >= 40 and (rink_rows(cols) > 12 or rink_rows(cols) + 4 > room):
                cols -= 2
            if cols < 40:
                cols = 0
        if cols:
            columns.append((cols + 4, [("SHOTS ON GOAL", hockey_rink_lines(
                shots, event, league, cols))]))
        rest_w = width - (cols + 4 if cols else 0)
        if side_cards and rest_w >= 82:
            columns.append((42, mid))
            columns.append((rest_w - 42, side_cards))
        else:
            columns.append((rest_w, mid + side_cards))
        if not shots and width >= 60:
            timeline = hockey_timeline(summary, event, league, min(width - 4, 110))
            if timeline:
                banner = ("THE GAME BY PERIOD", timeline)
    elif sport == "baseball":
        right_w = clamp(width * 38 // 100, 46, 72) if width >= 104 else 0
        pitching = baseball_center_pitching(summary, event, league, right_w - 4)             if right_w else []
        if not pitching:
            right_w = 0
        left_w = width - right_w
        if live:
            picture = [("THE DIAMOND", center_diamond(event, league, min(left_w - 4, 84)))]
        else:
            tall = max(1, room - (len(quarters) + 2 if quarters else 0) - 2)
            scoring = baseball_scoring_lines(summary, event, league, left_w - 4, tall)
            picture = [("SCORING PLAYS", scoring)] if scoring else []
        columns.append((left_w, quarters_card + picture))
        if pitching:
            columns.append((right_w, [("PITCHING", pitching)]))
    else:                       # soccer
        right_w = clamp(width * 34 // 100, 40, 60) if width >= 100 else 0
        timeline, numbers, goals, cards = soccer_center_parts(
            summary, event, league, width - right_w - 4)
        side_cards = ([("GOALS", goals)] if goals else []) +             ([("CARDS", cards)] if cards else [])
        if not side_cards:
            right_w = 0
        left_w = width - right_w
        match = timeline + ([blank()] if timeline and numbers else []) + numbers
        columns.append((left_w, quarters_card + ([("THE MATCH", match)] if match else [])))
        if right_w:
            columns.append((right_w, side_cards))
        elif side_cards:
            columns[-1] = (left_w, columns[-1][1] + side_cards)
    natural = max([sum(len(lines) + (0 if title is None else 2) for title, lines in cards)
                   for _, cards in columns if cards] + [0])
    banner_h = len(banner[1]) + 2 if banner else 0
    if banner_h and room - banner_h < min(natural, 7):
        banner_h, banner = 0, None
    top_h = min(natural, room - banner_h)
    if top_h < 7:
        top_h, columns = 0, []
    quarters_up = bool(quarters_card) and top_h >= len(quarters) + 2
    if banner:
        canvas.card(y, 0, banner_h, width, banner[0], banner[1], corners)
    x = 0
    for wide, cards in columns:
        if wide <= 0 or not cards:
            continue
        center_stack(canvas, y + banner_h, x, top_h, wide, cards, corners)
        x += wide
    used = banner_h + top_h
    # win probability across the screen
    win = []
    left_over = rest - used - 6
    for curve in (3, 2):
        if left_over >= curve + 3:
            win = render_winbar(summary, event, league, width - 4, rows=curve)[1:]
            break
    win_h = len(win) + 2 if win else 0
    if win:
        canvas.card(y + used, 0, win_h, width,
                    [("WIN PROBABILITY", "title"), ("  ESPN's model", "muted")], win, corners)
    low_h = rest - used - win_h
    if low_h < 3:
        return
    low_y = y + used + win_h
    left_w = width // 2
    right_w = width - left_w
    column_y = low_y
    if quarters and not quarters_up:
        tall = min(low_h, len(quarters) + 2)
        if low_h - tall < 3:
            tall = low_h
        canvas.card(column_y, 0, tall, left_w, period_word, quarters, corners)
        column_y += tall
    stats_h = low_y + low_h - column_y
    if stats_h >= 3:
        stats, _ = team_stat_sections(summary, league, left_w - 4)
        canvas.card(column_y, 0, stats_h, left_w, "TEAM STATS", stats, corners)
    inner = low_h - 2
    plays = recent_plays(summary, event, league, right_w - 4, count=max(4, inner))
    title = "LAST PLAYS"
    if sport == "football" and event["state"] == "post" and columns and \
            any(name == "DRIVE CHART" for _, cards in columns for name, _ in cards):
        scoring = football_panel(summary, event, league, right_w - 4, inner + 1)[1:]
        if scoring:
            plays = [Line().add("SCORING SUMMARY", "title")] + scoring
    if plays and plays[0].text in ("LAST PLAYS", "COMMENTARY", "SCORING SUMMARY"):
        title = plays[0].text
        plays = plays[1:]
    elif plays and plays[0] and plays[0][0][0] == "DRIVE ":
        title = "DRIVE"
        plays = [Line(plays[0][1:])] + plays[1:]
    if not plays and event["state"] == "post":
        plays, title = render_game_leaders(summary, league, right_w - 4, heading=False), \
            "GAME LEADERS"
    if not plays and live:
        last = clean(dig(event.get("situation") or {}, "lastPlay", "text", default=""))
        plays = wrap_spans(last, right_w - 4, "normal") if last else \
            [Line().add("The plays come in as the game goes on.", "dim")]
    canvas.card(low_y, left_w, low_h, right_w, title, plays[:inner], corners)


def basketball_panel(summary, event, league, width, height):
    """Both teams' shot charts side by side and the story of the game."""
    shots = basketball_shots(summary)
    story = basketball_story(summary, event, league)
    story_w = 40
    room = width - story_w - 4
    out = []
    if shots and room >= 44 and height >= 9:
        cols = clamp((room - 4) // 2, 20, 34)
        courts = []
        for side in ("away", "home"):
            team = event[side]
            mine = [s for s in shots if s["team"] == str(team.get("id"))]
            made = sum(1 for s in mine if s["made"])
            head = Line().add(f"{team.get('abbr', '')} ", THEME.style(league, team, bold=True))
            head.add(f"{made}/{len(mine)} from the field"[: max(0, cols - 5)], "dim")
            courts.append([head] + half_court(mine, league, team, cols)[: height - 2])
        rows = max(len(c) for c in courts)
        for index in range(rows):
            line = Line()
            for number, court in enumerate(courts):
                part = court[index] if index < len(court) else Line()
                if number:
                    line.add("   ", "normal")
                line.extend(part)
                line.add(" " * max(0, cols - len(part.text)), "normal")
            out.append(line)
        legend = Line().add("● made  ○ missed", "muted")
        out.append(legend)
        left_w = 2 * cols + 3
    else:
        left_w = 0
    if not out:
        return story[:height]
    merged = []
    for index in range(max(len(out), len(story))):
        line = Line()
        part = out[index] if index < len(out) else Line()
        line.extend(part)
        line.add(" " * max(2, left_w + 4 - len(part.text)), "normal")
        if index < len(story):
            line.extend(story[index])
        merged.append(line)
    return merged[:height]


