                                         self.favorites,
                                         self.group_filter.get(family(self.league), ""),
                                         self.filter_text, selected=chosen, spots=spots,
                                         logo_gap=gap)
                if spots and chosen not in [s["team"]["id"] for s in spots]:
                    # nothing picked yet, or filtered away: the first team
                    self.standings_sel[self.league] = spots[0]["team"]["id"]
                    lines = render_standings(standings.data, self.league, inner_width,
                                             self.favorites,
                                             self.group_filter.get(family(self.league), ""),
                                             self.filter_text,
                                             selected=spots[0]["team"]["id"], spots=[],
                                             logo_gap=gap)
