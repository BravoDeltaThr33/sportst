     "sources": [...]}."""
    defs = stat_defs(league)
    api = Espn()
    sources = []
    teams = {}           # id -> record
    values = {}          # id -> {key: value}
    groups = {}          # id -> [group names]

    standings = {}
    if not is_olympic(league) and league != "ahl":
        try:
            standings = standings_rows(fetch_first(api.standings(league), timeout))
        except Exception:  # noqa: BLE001 - stats still work without groups
            standings = {}
    elif is_olympic(league):
        standings = standings_rows(fetch_first(api.standings(league), timeout))
    for ident, (team, table, path) in standings.items():
        teams[ident] = team
        groups[ident] = group_names(path, league)
        values[ident] = {"_st": table}

    extra_by_id = {}
    if is_olympic(league):
        # ESPN's Olympic tables leave goals at zero; count them from the games
        try:
            events = parse_scoreboard(fetch_first(api.scoreboard(league), timeout))
        except Exception:  # noqa: BLE001 - the record still works
            events = []
        tally = {}
        for event in events:
            if event["state"] != "post":
                continue
            for side, other in (("away", "home"), ("home", "away")):
                ident = str(event[side]["id"])
                own, opp = _num(event[side].get("score")), _num(event[other].get("score"))
                if own is None or opp is None:
                    continue
                row = tally.setdefault(ident, [0, 0, 0])
                row[0] += own
                row[1] += opp
                row[2] += 1
        for ident, (gf, ga, played) in tally.items():
            extra_by_id[ident] = {"pf": gf / played, "pa": ga / played,
                                  "diff": (gf - ga) / played}
        if tally:
            sources.append("ESPN scoreboard")

    espn = {}
    if league in ("nfl", "cfb", "nba", "cbb", "nhl"):
        espn = espn_byteam(league, timeout)
        sources.append("ESPN team statistics")
        for ident, (team, _, _) in espn.items():
            if league in ("cfb", "cbb") and standings and ident not in standings:
                continue        # an exhibition opponent from outside the division
            teams.setdefault(ident, team)
            values.setdefault(ident, {})

    if league == "ahl":
        table = ahl_standings(timeout)
        special = ahl_extras(timeout) if extras else {}
        sources.append("HockeyTech")
        for ident, (team, st, path) in standings_rows(table).items():
            teams[ident] = team
            groups[ident] = group_names(path, league)
            gp = _st_number(st, "gamesPlayed") or 0
            row = dict(special.get(ident, {}))
            if gp:
                row["pim"] = (_st_number(st, "penaltyMinutes") or 0) / gp
                row["gf"] = (_st_number(st, "goalsFor") or 0) / gp
                row["ga"] = (_st_number(st, "goalsAgainst") or 0) / gp
                row["ptspct"] = (_st_number(st, "points") or 0) / (2 * gp)
            values[ident] = {"_st": st}
            extra_by_id[ident] = row
    elif league == "mlb" and extras:
        by_name = mlb_extras(timeout)
        sources.append("MLB Stats API")
        if not teams:
            for node in dig(fetch_first(api.teams(league), timeout), "sports", 0,
                            "leagues", 0, "teams", default=[]) or []:
                team = team_record(node.get("team") or {})
                teams[team["id"]] = team
                values.setdefault(team["id"], {})
        for ident, team in teams.items():
            extra_by_id[ident] = by_name.get(norm_name(team["name"]), {})
    elif league == "nhl" and extras:
        try:
            by_name = nhl_extras(timeout)
            sources.append("NHL stats API")
            for ident, team in teams.items():
                extra_by_id[ident] = by_name.get(norm_name(team["name"]), {})
        except Exception:  # noqa: BLE001 - ESPN's numbers alone are fine
            pass
    elif league == "cbase" and extras:
        by_name = ncaa_extras(timeout)
        sources.append("NCAA.com via ncaa-api.henrygd.me")
        catalog = {}
        for node in dig(fetch_first(api.teams(league), timeout), "sports", 0, "leagues",
                        0, "teams", default=[]) or []:
            team = team_record(node.get("team") or {})
            catalog[team["id"]] = team
        for ident, team in catalog.items():
            for key in (team["location"], team["name"], team["short"]):
                row = by_name.get(norm_name(key))
                if row:
                    teams.setdefault(ident, team)
                    values.setdefault(ident, {})
                    extra_by_id[ident] = row
                    break
        # ESPN's college baseball table holds a few conferences only;
        # basketball's conference list, matched by school, fills in the rest
        try:
            schools = groups_by_school(fetch_first(api.standings("cbb"), timeout), league)
        except Exception:  # noqa: BLE001 - fewer conferences to filter by
            schools = {}
        for ident, team in teams.items():
            if not groups.get(ident):
                for key in (team.get("location"), team.get("short")):
                    if key and norm_name(key) in schools:
                        groups[ident] = schools[norm_name(key)]
                        break
    if standings and league not in ("ahl",):
        sources.append("ESPN standings")

    out_teams = []
    for ident, team in teams.items():
        row = {}
        st = values.get(ident, {}).get("_st") or {}
        espn_values = espn.get(ident, (None, {}, None))[1]
        games = espn.get(ident, (None, {}, None))[2]
        extra = dict(record_extras(st)) if st else {}
        extra.update({k: v for k, v in extra_by_id.get(ident, {}).items() if v is not None})
        if "margin" not in extra and st:
            pf, pa = _st_number(st, "avgPointsFor"), _st_number(st, "avgPointsAgainst")
            if pf is not None and pa is not None and (pf or pa):
                extra["margin"] = pf - pa
        if not games and st:
            games = _st_number(st, "gamesPlayed") or (
                (_st_number(st, "wins") or 0) + (_st_number(st, "losses") or 0)) or None
        for stat in defs:
            value = None
            for source in stat["sources"]:
                kind = source[0]
                if kind == "espn":
                    value = _num(espn_values.get((source[1], source[2], source[3])))
                    if value is not None and stat["per_game"]:
                        value = value / games if games else None
                elif kind == "st":
                    value = _st_number(st, source[1]) if st else None
                elif kind == "x":
                    value = _num(extra.get(source[1]))   # already per game
                if value is not None:
                    break
            row[stat["key"]] = value
        if not any(v is not None for v in row.values()):
            continue
        record = ""
        if st:
            record = stat_display(st, ["overall", "total"])
            if record in ("", "-"):
                wins, losses = stat_display(st, ["wins"]), stat_display(st, ["losses"])
                record = f"{wins}-{losses}" if wins != "-" else ""
        out_teams.append(dict(team, values=row, groups=groups.get(ident, []),
                              record=record))
    stats = [{k: v for k, v in s.items() if k != "sources"} for s in defs]
    # drop stats nobody has a number for (an off-season, a missing source)
    stats = [s for s in stats if any(t["values"].get(s["key"]) is not None
                                     for t in out_teams)]
    return {"stats": stats, "teams": out_teams, "sources": sources}


def stat_ranks(table):
    """{stat key: {team id: rank}}, 1 the best in the league."""
    ranks = {}
    for stat in table.get("stats") or []:
        key = stat["key"]
        rows = [(t["values"].get(key), t["id"]) for t in table.get("teams") or []
                if t["values"].get(key) is not None]
        rows.sort(key=lambda r: r[0], reverse=stat["better"] == "high")
        place, last = 0, None
        out = {}
        for index, (value, ident) in enumerate(rows):
            if value != last:
                place = index + 1
                last = value
            out[ident] = place
        ranks[key] = out
    return ranks


def stat_text(stat, value, decimal=False):
    if value is None:
        return "-"
    fmt = stat.get("fmt")
    if decimal and not fmt:
        return f"{value:.1f}"
    if fmt:
        text = format(value, fmt)
        if fmt.endswith(".3f") and text.startswith("0."):
            text = text[1:]            # .312, the way averages are written
        return text
    return f"{value:.1f}" if abs(value - round(value)) > 1e-9 else f"{int(round(value))}"


def find_team_row(table, team):
    if not table or not team:
        return None
    ident = str(team.get("id") or "")
    for row in table.get("teams") or []:
        if row["id"] == ident:
            return row
    name = norm_name(team.get("name") or "")
    code = noc_code(team) if is_olympic(team.get("_league", "")) else ""
    for row in table.get("teams") or []:
        if name and norm_name(row["name"]) == name:
            return row
        if code and row["abbr"] == code:
            return row
    return None


# -- the Stats tab ------------------------------------------------------------

def stat_groups(table):
    out = []
    for stat in table.get("stats") or []:
        if stat["group"] not in out:
            out.append(stat["group"])
    return out


def stats_columns(table, view):
    """The stats shown for a view: 'All' or one group's name."""
    stats = table.get("stats") or []
    if view and view != "All":
        return [s for s in stats if s["group"] == view]
    return stats


def stats_layout_fits(table, view, width, name_width=24):
    stats = stats_columns(table, view)
    return name_width + 29 + sum(max(len(s["short"]) + 1, 5) + 2 for s in stats) <= width


def stats_view_groups(table, view, width):
    """The stat groups on screen: everything for 'All', otherwise the chosen
    group plus as many of the ones after it as still fit the width."""
    groups = stat_groups(table)
    if not view or view == "All" or view not in groups:
        return groups
    name_width = clamp(width // 6, 16, 26)
    used = name_width + 29
    shown = []
    for group in groups[groups.index(view):]:
        cost = sum(max(len(s["short"]) + 1, 5) + 2 for s in stats_columns(table, group))
        if shown and used + cost > width:
            break
        shown.append(group)
        used += cost
    return shown


def team_matches_text(team, text):
    """Does a team's name, school, nickname or abbreviation contain `text`?"""
    needle = norm_name(text or "")
    if not needle:
        return True
    for key in ("name", "location", "short", "abbr", "nickname"):
        if needle in norm_name(str((team or {}).get(key) or "")):
            return True
    return False


def group_label(team):
    """A team's conference (college) or division (pros), short."""
    groups = (team or {}).get("groups") or []
    if not groups:
        return ""
    label = short_group(groups[-1])
    for long, short in (("American League", "AL"), ("National League", "NL")):
        label = label.replace(long, short)
    return label


def render_stats_table(table, league, width, favorites, view="All", sort_key=None,
                       group_filter="", top25=None, ranks=None, selected=None, order=None,
                       text="", order_by="stat"):
    """Every team on one screen: a row each, a column per stat, the league's
    best fifth in green and worst fifth in red, sorted best-first by one
    column."""
    ranks = ranks or stat_ranks(table)
    shown = stats_view_groups(table, view, width)
    stats = [s for s in table.get("stats") or [] if s["group"] in shown]
    if not stats:
        return [Line().add("No team statistics published for this league yet.", "dim")]
    sort_stat = next((s for s in stats if s["key"] == sort_key), stats[0])
    rows = list(table.get("teams") or [])
    if group_filter:
        rows = [t for t in rows if group_filter in t.get("groups", [])]
    if top25 is not None:
        rows = [t for t in rows if t["id"] in top25]
    if text:
        rows = [t for t in rows if team_matches_text(t, text)]
    sort_ranks = ranks.get(sort_stat["key"], {})

    def shown_name(team):
        return standings_name(league, team) if league in COLLEGE_LEAGUES else team["name"]

    # with one conference or division (or the Top 25) on screen, # is the
    # place within it and lg the league-wide rank beside it
    narrowed = bool(group_filter or top25 is not None)
    local_ranks = {}
    if narrowed:
        by_stat = sorted(rows, key=lambda t: (sort_ranks.get(t["id"], 10 ** 6), t["name"]))
        place = 0
        for team in by_stat:
            if sort_ranks.get(team["id"]) is not None:
                place += 1
                local_ranks[team["id"]] = place
    rank_width = 9 if narrowed else 5

    if order_by == "name":
        rows.sort(key=lambda t: norm_name(shown_name(t)))
    elif order_by == "group":
        rows.sort(key=lambda t: (group_label(t) or "~", sort_ranks.get(t["id"], 10 ** 6),
                                 t["name"]))
    else:
        rows.sort(key=lambda t: (sort_ranks.get(t["id"], 10 ** 6), t["name"]))
    conf_width = min(12, max([len(group_label(t)) for t in rows] + [0]))
    if conf_width:
        conf_width = max(conf_width, 4)
    if group_filter and len({group_label(t) for t in rows}) <= 1:
        conf_width = 0          # one conference on screen: the column says nothing

    name_width = clamp(width // 6, 16, 26)
    widths = []
    decimals = []
    for stat in stats:
        numbers = [t["values"].get(stat["key"]) for t in rows]
        decimal = any(v is not None and abs(v - round(v)) > 1e-9 for v in numbers)
        decimals.append(decimal)
        texts = [stat_text(stat, v, decimal) for v in numbers]
        widths.append(max([len(stat["short"]) + (1 if stat is sort_stat else 0), 4] +
                          [len(x) for x in texts]))
    lines = []
    # group headings over their columns
    heads = Line().add(" " * (rank_width + 1 + name_width + 9 +
                              (conf_width + 1 if conf_width else 0)), "normal")
    cramped = False
    index = 0
    while index < len(stats):
        group = stats[index]["group"]
        span = 0
        start = index
        while index < len(stats) and stats[index]["group"] == group:
            span += widths[index] + 2
            index += 1
        label = f" {group} "
        if len(label) > span - 1:
            cramped = True
        fill = max(0, span - 1 - len(label))
        heads.add(("─" * (fill // 2) + label + "─" * (fill - fill // 2))[: span - 1] + " ",
                  "border")
    lines.append(blank() if cramped else heads)
    header = Line().add(f"{'#':>3}  {'lg':>3} " if narrowed else f"{'#':>4} ", "header")
    header.add(" ", "normal")
    header.add(f"{'team':<{name_width}} ", "header" if order_by != "name" else "tabsel")
    if conf_width:
        header.add(f"{'conf' if league in COLLEGE_LEAGUES else 'div':<{conf_width}}",
                   "tabsel" if order_by == "group" else "header").add(" ", "normal")
    header.add(f"{'record':>8} ", "header")
    for stat, size in zip(stats, widths):
        label = stat["short"] + ("▼" if stat is sort_stat else "")
        header.add(f"{label:>{size}}", "tabsel" if stat is sort_stat else "header")
        header.add("  ", "normal")
    lines.append(header)
    counts = {key: len(r) for key, r in ranks.items()}
    if order is not None:
        order.extend(rows)
    for row_index, team in enumerate(rows):
        star = fav_rank(favorites, league, team) >= 0
        rank = sort_ranks.get(team["id"])
        if narrowed:
            local = local_ranks.get(team["id"])
            line = Line().add(f"{local if local else '-':>3}", "bold")
            line.add(f"  {rank if rank else '-':>3} ", "muted")
        else:
            line = Line().add(f"{rank if rank else '-':>4} ", "muted")
        line.add(STAR if star else " ", "star")
        name = standings_name(league, team) if league in COLLEGE_LEAGUES else team["name"]
        line.add(f"{name[:name_width]:<{name_width}} ",
                 THEME.style(league, team, bold=star))
        if conf_width:
            label = group_label(team)
            first = row_index == 0 or group_label(rows[row_index - 1]) != label
            if order_by == "group":
                line.add(f"{(label if first else ''):<{conf_width}} ",
                         "accent" if first else "muted")
            else:
                line.add(f"{label[:conf_width]:<{conf_width}} ", "muted")
        record = str(team.get("record") or "").split(",")[0].strip()[:8]
        line.add(f"{record:>8} ", "dim")
        for stat, size, decimal in zip(stats, widths, decimals):
            value = team["values"].get(stat["key"])
            place = ranks.get(stat["key"], {}).get(team["id"])
            total = counts.get(stat["key"], 0)
            style = "normal"
            if place and total >= 5:
                if place <= max(1, total // 5):
                    style = "good"
                elif place > total - max(1, total // 5):
                    style = "bad"
            if stat is sort_stat:
                style = "bold" if style == "normal" else style
            line.add(f"{stat_text(stat, value, decimal):>{size}}  ", style)
        if row_index == selected:
            line = Line([(text, _on_cursor(style)) for text, style in line])
            used = sum(len(t) for t, _ in line)
            if used < width:
                line.append((" " * (width - used), "sel"))
        lines.append(line)
    if not rows:
        lines.append(Line().add("  No teams match this filter.", "dim"))
    return lines


