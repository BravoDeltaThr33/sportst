def summary_teams(summary):
    """Return (away, home) parsed competitors from a summary payload."""
    comp = dig(summary, "header", "competitions", 0, default={}) or {}
    away = home = None
    for node in comp.get("competitors") or []:
        parsed = parse_competitor(node)
        if parsed["home_away"] == "home":
            home = parsed
        else:
            away = parsed
    return away, home


def summary_header_lines(summary, league, width):
    comp = dig(summary, "header", "competitions", 0, default={}) or {}
    away, home = summary_teams(summary)
    if not away or not home:
        return [Line().add("No header data.", "dim")]
    status = dig(comp, "status", "type", "shortDetail", default="") or ""
    state = dig(comp, "status", "type", "state", default="pre")
    style = {"in": "live", "post": "final"}.get(state, "dim")

    line = Line()
    line.add(f"{away['name']} ", THEME.style(league, away, bold=True,
                                             dim=state == "post" and not away["winner"]))
    line.add(str(away["score"] if away["score"] is not None else "-"), "bold")
    line.add("   at   ", "muted")
    line.add(f"{home['name']} ", THEME.style(league, home, bold=True,
                                             dim=state == "post" and not home["winner"]))
    line.add(str(home["score"] if home["score"] is not None else "-"), "bold")
    return [line, Line().add(clean(status), style), blank()]


def stat_section_title(section):
    for key in ("text", "displayName", "name", "type"):
        value = section.get(key)
        if value:
            return clean(value).title() if key in ("name", "type") else clean(value)
    return "Stats"


def block_team(block):
    """Pull a comparable team dict out of a boxscore block."""
    team = block.get("team") or {}
    return {
        "id": str(team.get("id", "")),
        "abbr": clean(team.get("abbreviation") or ""),
        "name": clean(team.get("displayName") or ""),
        "short": clean(team.get("shortDisplayName") or ""),
        "location": clean(team.get("location") or ""),
        "color": clean(team.get("color") or ""),
    }


def order_blocks(blocks, favorites, league):
    """A favourite team's half of the box score comes first."""
    ranked = []
    for position, block in enumerate(blocks):
        rank = fav_rank(favorites or {}, league, block_team(block))
        ranked.append(((0, rank) if rank >= 0 else (1, 0), position, block))
    ranked.sort(key=lambda row: (row[0], row[1]))
    return [row[2] for row in ranked]


def render_boxscore(summary, league, width, favorites=None):
    """Single column, used by --box: both teams, one after the other."""
    boxscore = dig(summary, "boxscore", default={}) or {}
    players = boxscore.get("players") or []
    if not players:
        return [Line().add("No player box score published for this game yet.", "dim")]

    lines = summary_header_lines(summary, league, width)
    for team_block in order_blocks(players, favorites, league):
        team = block_team(team_block)
        display = team["name"] or team["abbr"] or "?"
        starred = fav_rank(favorites or {}, league, team) >= 0
        head = Line().add("── ", "border")
        if starred:
            head.add(STAR + " ", "star")
        head.add(f"{display} ", THEME.style(league, team, bold=True, fallback="title"))
        head.add("─" * max(0, width - len(display) - 4 - (2 if starred else 0)), "border")
        lines.append(head)
        lines.append(blank())
        lines.extend(boxscore_team_lines(team_block, league, width))
    return lines


def split_by_side(blocks, summary):
    """(home, away) from a list of per-team blocks, matched on team id, with
    ESPN's usual away-then-home order as the fallback."""
    away, home = summary_teams(summary)
    by_id = {block_team(b)["id"]: b for b in blocks}
    home_block = by_id.get(home["id"]) if home else None
    away_block = by_id.get(away["id"]) if away else None
    for block in blocks:
        side = block.get("homeAway")
        if side == "home" and home_block is None:
            home_block = block
        elif side == "away" and away_block is None:
            away_block = block
    if home_block is None and away_block is None and len(blocks) >= 2:
        away_block, home_block = blocks[0], blocks[1]
    return home_block, away_block


def short_name(name):
    """'Matthew Knies LW' -> 'M. Knies LW', for a table that will not fit."""
    parts = name.split(" ", 1)
    if len(parts) == 2 and len(parts[0]) > 2 and parts[0] not in ("Totals", "Team"):
        return f"{parts[0][0]}. {parts[1]}"
    return name


# Columns a half-width pane gives up first, least useful first. Mostly the
# NHL's 21-column skater table: shootout and year-to-date figures, then the
# special-teams splits of ice time.
EXPENDABLE_COLUMNS = ["YTDG", "SOG", "SOS", "SOSA", "SM", "ESTOI", "SHTOI", "PPTOI",
                      "PN", "FL", "FW", "ESSV", "PPSV", "SHSV", "GV", "TK", "QB HUR",
                      "LONG", "AVG"]


def fitted_table(headers, rows, width, aligns, row_styles):
    """build_table, tightened until it fits `width`: single-space columns,
    then first initials, then the expendable columns one at a time."""
    def build(h, r, a, sep):
        return build_table(h, r, aligns=a, row_styles=row_styles, sep=sep)

    def fits(table):
        return not table or max(len(line.text) for line in table) <= width

    table = build(headers, rows, aligns, "  ")
    if width is None or fits(table):
        return table
    table = build(headers, rows, aligns, " ")
    if fits(table):
        return table
    rows = [[short_name(r[0])] + list(r[1:]) for r in rows]
    headers, aligns = list(headers), list(aligns)
    for label in EXPENDABLE_COLUMNS:
        table = build(headers, rows, aligns, " ")
        if fits(table):
            return table
        if label in headers[1:]:
            index = headers.index(label, 1)
            headers.pop(index)
            aligns.pop(index)
            rows = [r[:index] + r[index + 1:] for r in rows]
    return build(headers, rows, aligns, " ")


def boxscore_team_lines(team_block, league, width=None):
    """Every stat table for one team, each squeezed to fit `width`."""
    lines = []
    team = block_team(team_block)
    for section in team_block.get("statistics") or []:
        labels = section.get("labels") or section.get("names") or []
        athletes = section.get("athletes") or []
        rows = []
        row_styles = []
        for entry in athletes:
            name = clean(dig(entry, "athlete", "displayName", default="?"))
            position = clean(dig(entry, "athlete", "position", "abbreviation", default=""))
            if position:
                name = f"{name} {position}"
            stats = [clean(s) for s in (entry.get("stats") or [])]
            rows.append([name] + stats)
            row_styles.append("normal" if entry.get("starter") else "dim")
        if not rows:
            continue
        totals = [clean(t) for t in (section.get("totals") or [])]
        if totals:
            rows.append(["Totals"] + totals)
            row_styles.append("accent")
        title = stat_section_title(section)
        # the section's name sits in its own header row's empty first cell
        # (the pane already says which team), saving a line per table
        for prefix in (team.get("name"), team.get("location"), team.get("short")):
            if prefix and title.lower().startswith(prefix.lower() + " "):
                title = title[len(prefix) + 1:]
                break
        aligns = ["<"] + [">"] * len(labels)
        table = fitted_table([title] + [clean(l) for l in labels], rows,
                             None if width is None else width - 2, aligns, row_styles)
        if table and len(table[0]):
            text, _ = table[0][0]
            table[0][0] = (text, THEME.style(league, team, bold=True, fallback="accent"))
        for row in table:
            lines.append(Line([("  ", "normal")] + list(row)))
        lines.append(blank())
    while lines and not lines[-1]:
        lines.pop()
    return lines


def pane_title(league, team, score, side, favorites, extra=""):
    """A pane caption in the team's own colour: ★ Arkansas Razorbacks 17 · home"""
    line = Line().add(" ", "border")
    if team is None:
        return line.add(f"{side} ", "accent")
    if fav_rank(favorites or {}, league, team) >= 0:
        line.add(STAR + " ", "star")
    line.add(team.get("name") or team.get("abbr") or "?",
             THEME.style(league, team, bold=True, fallback="accent"))
    if score is not None:
        line.add(f" {score}", "bold")
    line.add(f" · {side}", "muted")
    if extra:
        line.add(f" · {extra}", "dim")
    return line.add(" ", "border")


def render_team_stats(summary, league, width, favorites=None):
    """Single column, used by --team-stats: bars, leaders, then the rest."""
    teams = dig(summary, "boxscore", "teams", default=[]) or []
    if len(teams) < 2:
        return [Line().add("No team statistics published for this game yet.", "dim")]
    lines = summary_header_lines(summary, league, width)
    graph, rest = team_stat_sections(summary, league, width)
    lines.extend(graph)
    lines.append(blank())
    leaders = render_game_leaders(summary, league, width)
    if leaders:
        lines.extend(leaders)
        lines.append(blank())
    lines.extend(rest)
    return lines


