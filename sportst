# Letters whose capital has no command of its own work in either case, so
# Caps Lock never gets in the way, and the bottom line and the help show them
# as capitals. Letters whose capital is a different command keep their case:
# c/C, g/G, h/H, j/J, k/K, l/L, n/N, o/O, s/S (and R on the Settings tab).
CASE_FREE_KEYS = frozenset("ABDEFIMPQRTUVWXYZ")


def key_label(key):
    """How a key is shown: a case-free letter as its capital."""
    return key.upper() if len(key) == 1 and key.upper() in CASE_FREE_KEYS else key


