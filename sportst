def _ago(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s ago"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h ago"
    return f"{seconds // 86400}d ago"


def footer_spans(auto, interval, busy, requests, status, error, width, hints=None):
    """Lay out the bottom line inside `width` columns.

    Left: 'sportst 4.7.0 │ auto 30s │' and then the keys that matter on this
    screen ('j/k game  enter open …'). Right: the message. The message keeps
    room for itself first; the hints fill what is left, least important
    (the end of the list) dropping first; the app name is the last to go.
    """
    message = status or ""
    if not message and error:
        text, age = error
        message = f"⚠ {text} ({_ago(age)})"
    if message.startswith("⚠"):
        style = "err"
    elif message.startswith("▲"):
        style = "upset"
    else:
        style = "accent"

    spans = [(APP, "title"), (f" {VERSION}", "dim")]
    used = len(APP) + len(VERSION) + 1
    if used > width:
        return [(APP[:max(0, width)], "title")], "", style
    keep = (min(len(message), max(24, width // 3)) + 3) if message else 0
    refresh = "loading…" if busy else (f"auto {interval}s" if auto else "auto off")
    if used + 3 + len(refresh) + keep <= width:
        spans += [(" │ ", "border"), (refresh, "muted")]
        used += 3 + len(refresh)
    first = True
    for key, label in hints or []:
        piece = (3 if first else 2) + len(key) + 1 + len(label)
        if used + piece + keep > width:
            break
        spans.append((" │ " if first else "  ", "border" if first else "normal"))
        spans.append((key, "accent"))
        spans.append((" " + label, "muted"))
        used += piece
        first = False
    room = max(0, width - used - 3)
    if len(message) > room:
        message = message[:max(0, room - 1)] + "…" if room > 1 else ""
    return spans, message, style


class ScrollMap(dict):
    """Scroll offsets by tab name; a tab never seen before starts at the top."""

    def __missing__(self, key):
        return 0


class Popup:
    """A menu drawn over the screen: the league picker and the Olympic event
    picker. Items are dicts with a label, a detail, and what to do when
    chosen; an item with no action is a heading."""

    def __init__(self, title, items, on_pick, cursor=0, hint=""):
        self.title = title
        self.items = items
        self.on_pick = on_pick
        self.filter = ""
        self.hint = hint
        self.cursor = cursor
        self.offset = 0
        self.snap()

    def visible(self):
        if not self.filter:
            return self.items
        low = self.filter.lower()
        out = []
        for item in self.items:
            if item.get("action") is None:
                out.append(item)
            elif low in (item["label"] + " " + item.get("detail", "")).lower():
                out.append(item)
        # drop headings left with nothing under them
        cleaned = []
        for index, item in enumerate(out):
            if item.get("action") is None:
                following = out[index + 1] if index + 1 < len(out) else None
                if following is None or following.get("action") is None:
                    continue
            cleaned.append(item)
        return cleaned

    def snap(self, step=1):
        items = self.visible()
        if not items:
            self.cursor = 0
            return
        self.cursor = clamp(self.cursor, 0, len(items) - 1)
        tries = 0
        while items[self.cursor].get("action") is None and tries < len(items):
            self.cursor = (self.cursor + step) % len(items)
            tries += 1

    def move(self, delta):
        items = self.visible()
        if not items:
            return
        step = 1 if delta > 0 else -1
        target = clamp(self.cursor + delta, 0, len(items) - 1)
        self.cursor = target
        if items[self.cursor].get("action") is None:
            self.snap(step)
            if items[self.cursor].get("action") is None:
                self.snap(-step)

    def chosen(self):
        items = self.visible()
        if not items:
            return None
        item = items[clamp(self.cursor, 0, len(items) - 1)]
        return item if item.get("action") is not None else None


