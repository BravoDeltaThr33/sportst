        now = time.time()
        if force or (self.book.dirty and now - self.last_book_save > 10):
            self.book.save()
            self.last_book_save = now

    def visible_events(self, events):
        out = events
        group = self.group_filter.get(family(self.league), "")
        members = self.team_groups() if not is_wiki_sport(self.league) else {}
        if group:
            if members:
                out = [e for e in out
                       if group in members.get(e["away"]["id"], ())
                       or group in members.get(e["home"]["id"], ())]
        if self.ranked_only and self.league in RANKED_LEAGUES:
            out = [e for e in out if e["away"]["rank"] or e["home"]["rank"]]
        elif self.ranked_only and self.league == "cbase":
            top = self.top25_ids()
            if top:
                out = [e for e in out if e["away"]["id"] in top or e["home"]["id"] in top]
        if self.filter_text:
            needle = self.filter_text.lower()
            out = [e for e in out
                   if needle in e["short_name"].lower()
                   or needle in e["name"].lower()
                   or needle in e["away"]["name"].lower()
                   or needle in e["home"]["name"].lower()]
        return sort_by_favorites(self.favorites, self.league, out)

    def current_event(self):
        if not self.events:
            return None
        return self.events[clamp(self.selected_index, 0, len(self.events) - 1)]

    def sync_selection(self):
        if not self.events:
            self.selected_index = 0
            return
        if self.selected_id:
            for index, event in enumerate(self.events):
                if event["id"] == self.selected_id:
                    self.selected_index = index
                    return
        self.selected_index = clamp(self.selected_index, 0, len(self.events) - 1)
        self.selected_id = self.events[self.selected_index]["id"]

    # -- period label ----------------------------------------------------

    def period_caption(self):
        meta = LEAGUES[self.league]
        if is_olympic(self.league):
            return meta["games"]
        if self.week_mode and meta["week_based"]:
            names = meta["seasontype_names"]
            label = names.get(self.seasontype, "Week")
            if self.seasontype == 3 and self.league == "cfb":
                return "Bowls"
            if not self.week:
                return "This week"
            suffix = "" if self.week_pinned else " (current)"
            if label in ("Pre", "Post"):
                return f"{label} Wk {self.week}{suffix}"
            return f"Week {self.week}{suffix}"
        return self.day.strftime("%A, %B %-d, %Y")

    # -- drawing ---------------------------------------------------------

    def apply_background(self):
        """Fill unwritten cells too, so erase() and the margins stay black."""
        if not (self.palette and self.palette.enabled and self.palette.bg_rgb):
            return
        try:
            self.stdscr.bkgd(" ", self.palette("normal"))
        except curses.error:
            pass

    def corners(self):
        if self.config.get("rounded_borders", True):
            return "╭", "╮", "╰", "╯"
        return "┌", "┐", "└", "┘"

    def draw_box(self, top, left, height, width, title=None, title_style="accent"):
        if height < 2 or width < 2:
            return
        tl, tr, bl, br = self.corners()
        win = self.stdscr
        border = self.palette("border")
        self.put(top, left, tl + "─" * (width - 2) + tr, border)
        self.put(top + height - 1, left, bl + "─" * (width - 2) + br, border)
        for row in range(1, height - 1):
            self.put(top + row, left, "│", border)
            self.put(top + row, left + width - 1, "│", border)
        if title:
            text = f" {title} "[: max(0, width - 4)]
            self.put(top, left + 2, text, self.palette(title_style))

    def put(self, y, x, text, attr=0):
        height, width = self.stdscr.getmaxyx()
        if y < 0 or y >= height or x >= width:
            return
        if x < 0:
            text = text[-x:]
            x = 0
        text = text[: max(0, width - x)]
        if not text:
            return
        try:
            self.stdscr.addstr(y, x, text, attr)
        except curses.error:
            pass

    def draw_lines(self, lines, top, left, height, width, scroll):
        for row in range(height):
            index = scroll + row
            if index >= len(lines):
                break
            x = left
            remaining = width
            for text, style in lines[index]:
                if remaining <= 0:
                    break
                chunk = text[:remaining]
                self.put(top + row, x, chunk, self.palette(style))
                x += len(chunk)
                remaining -= len(chunk)

    def draw_scrollbar(self, top, left, height, total, scroll):
        if total <= height or height < 3:
            return
        span = max(1, int(height * height / total))
        position = int(scroll * (height - span) / max(1, total - height))
        for row in range(height):
            mark = "█" if position <= row < position + span else "░"
            self.put(top + row, left, mark, self.palette("border"))

    def draw_tabbar(self, width):
        self.draw_box(0, 0, 3, width)
        x = 2
        tabs = self.tabs
        # on a narrow screen the tab names give way before the league does
        full = sum(len(n) + 3 for n in tabs)
        short = full > width - 40
        tiny = sum(len(TAB_SHORT.get(n, n)) + 3 for n in tabs) > width - 6
        for index, name in enumerate(tabs):
            style = "tabsel" if index == self.tab else "tab"
            text = TAB_SHORT.get(name, name) if short else name
            if tiny and index != self.tab:
                text = TAB_TINY.get(name, text[:3])
            label = f" {text} "
            self.put(1, x, label, self.palette(style))
            x += len(label)
            if index < len(tabs) - 1:
                self.put(1, x, "│", self.palette("border"))
                x += 1

        meta = LEAGUES[self.league]
        if is_olympic(self.league):
            right = f" {meta['games']} · {meta['label']} "
        else:
            right = f" {meta['name']} · {self.period_caption()} "
        if self.filter_text:
            right += f"· /{self.filter_text} "
        if self.ranked_only and self.league in COLLEGE_LEAGUES:
            right += "· top 25 "
        if self.group_filter.get(family(self.league)):
            right += f"· {short_group(self.group_filter[family(self.league)])} "
        right += " "
        start = width - len(right) - 2
        if start <= x + 2 and is_olympic(self.league):
            right = f" {meta['label']} "
            start = width - len(right) - 2
        if start > x + 2:
            self.put(1, start, right, self.palette("dim"))

    def draw_footer(self, width, height):
        """One line, always: name and version, refresh state, then whatever
        message there is, trimmed to fit rather than wrapped."""
        try:
            hints = self.screen_hints()
        except Exception:  # noqa: BLE001 - hints are a nicety, never a crash
            hints = []
        spans, message, style = footer_spans(
            self.auto_refresh, self.interval, self.fetcher.busy(),
            self.fetcher.requests_made, self.status_message or self.player_status(),
            self.fetcher.last_error, width - 2, hints)
        x = 1
        for text, token in spans:
            self.put(height - 1, x, text, self.palette(token))
            x += len(text)
        if message:
            self.put(height - 1, width - len(message) - 1, message, self.palette(style))

    def draw_help(self, height, width):
        column = max(23 + len(v) for _, v in HELP_TEXT if v) + 2
        blocks = [HELP_TEXT]
        if len(HELP_TEXT) + 4 > height - 2 and width >= 2 * column + 8:
            # too tall for the screen: two columns, split at a section break
            middle = len(HELP_TEXT) // 2
            breaks = [i for i, (k, v) in enumerate(HELP_TEXT) if not k and not v]
            cut = min(breaks, key=lambda i: abs(i - middle)) if breaks else middle
            blocks = [HELP_TEXT[:cut], HELP_TEXT[cut + 1:]]
        col_width = clamp(column, 40, (width - 6) // len(blocks))
        box_width = col_width * len(blocks) + 4
        box_height = clamp(max(len(b) for b in blocks) + 4, 8, height - 2)
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        self.draw_box(top, left, box_height, box_width, f"{APP} {VERSION}", "title")
        for number, block in enumerate(blocks):
            x = left + 3 + number * col_width
            row = top + 2
            for key, description in block:
                if row >= top + box_height - 2:
                    break
                if key and not description:
                    self.put(row, x, key, self.palette("title"))
                elif key:
                    self.put(row, x, f"{key:<16}", self.palette("accent"))
                    self.put(row, x + 17, description[: col_width - 19],
                             self.palette("dim"))
                row += 1
        self.put(top + box_height - 2, left + 3, "press any key to close",
                 self.palette("muted"))

    def draw_info(self, height, width):
        """The Info pop-up: what everything on the current screen means."""
        box_width = clamp(width - 4, 40, 112)
        box_height = max(8, height - 4)
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        try:
            sections = info_sections(self)
        except Exception as exc:  # noqa: BLE001 - never let Info take the app down
            sections = [("Info", [(None, f"Could not build this screen's notes: {exc}")])]
        lines = info_lines(sections, box_width - 6)
        view = box_height - 4
        self.info_scroll = clamp(self.info_scroll, 0, max(0, len(lines) - view))
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        title = f"Info · {self.tab_name}"
        if self.tab_name == "Stats" and self.stats_team and self.stats_team[0] == self.league:
            title += " · players"
        title += f" · {LEAGUE_SHORT.get(family(self.league), self.league.upper())}"
        self.draw_box(top, left, box_height, box_width, title, "title")
        self.draw_lines(lines, top + 1, left + 3, view, box_width - 6, self.info_scroll)
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(lines), self.info_scroll)
        hint = "j / k scroll · PgDn / PgUp page · any other key closes"
        if len(lines) <= view:
            hint = "any key closes"
        self.put(top + box_height - 2, left + 3, hint, self.palette("muted"))

    def draw(self):
        self.stdscr.erase()
        height, width = self.stdscr.getmaxyx()
        if height < 10 or width < 50:
            self.put(0, 0, "Terminal too small — 50x10 minimum.", self.palette("warn"))
            self.stdscr.noutrefresh()
            curses.doupdate()
            return

        layout_width = width - 1
        body_top = 3
        body_height = height - 4

        # The body draws first: fetching the scoreboard is what tells us which
        # week we are looking at, and the tab bar wants to print that.
        self.tab = clamp(self.tab, 0, len(self.tabs) - 1)
        if self.tab_name == "Overview":
            self.draw_overview(body_top, body_height, layout_width)
        elif self.on_board and is_wiki_sport(self.league):
            self.draw_events_tab(body_top, body_height, layout_width)
        elif self.on_board:
            self.draw_scoreboard_tab(body_top, body_height, layout_width)
        else:
            self.draw_panel_tab(body_top, body_height, layout_width, self.tab_name)

        self.draw_tabbar(layout_width)
        self.draw_footer(layout_width, height)
        if self.show_help:
            self.draw_help(height, width)
        elif self.show_info:
            self.draw_info(height, width)
        elif self.calendar:
            self.draw_calendar(height, width)
        elif self.popup:
            self.draw_popup(height, width)
        self.stdscr.noutrefresh()
        curses.doupdate()

    def draw_scoreboard_tab(self, top, height, width):
        share = 0.56 if (BETTING.enabled and BETTING.columns) else 0.52
        left_width = clamp(int(width * share), 46, max(46, width - 34))
        if width < 90:
            left_width = width
        right_width = width - left_width

        result = self.load_scoreboard()
        all_events = self.prepare_events(result.data)
        self.events = self.visible_events(all_events)
        self.sync_selection()

        caption = self.period_caption()
        if self.week_mode and LEAGUES[self.league]["week_based"] and self.season_year:
            caption = f"{caption} · {self.season_year}"
        self.draw_box(top, 0, height, left_width, caption, "sel")
        alerts = sum(1 for e in self.events
                     if e.get("upset") and e["upset"]["level"] == "live")
        if alerts:
            badge = f" ▲ {alerts} on upset watch "
            start = left_width - len(badge) - 2
            if start > len(caption) + 6:
                self.put(top, start, badge, self.palette("upsetbar"))

        inner_width = left_width - 4
        column_header, rows = render_game_list(self.events, inner_width,
                                               self.selected_index, self.favorites,
                                               self.league)
        sticky = True
        if not result.data and result.loading:
            column_header, rows, sticky = None, [Line().add("Loading…", "dim")], False
        elif not result.data and result.error:
            column_header = None
            sticky = False
            source = {"hockeytech": "HockeyTech (the AHL's stats feed)"}.get(
                LEAGUES[self.league].get("source"), "ESPN")
            rows = wrap_spans(f"Could not reach {source}: {result.error}", inner_width, "err")

        body_top = top + 1
        view_height = height - 2
        if sticky and column_header is not None:
            self.draw_lines([column_header], top + 1, 2, 1, inner_width, 0)
            body_top = top + 2
            view_height = height - 3

        offset = self.scroll["Scoreboard"]
        if self.selected_index >= offset + view_height:
            offset = self.selected_index - view_height + 1
        if self.selected_index < offset:
            offset = self.selected_index
        offset = clamp(offset, 0, max(0, len(rows) - view_height))
        self.scroll["Scoreboard"] = offset

        self.draw_lines(rows, body_top, 2, view_height, inner_width, offset)
        self.draw_scrollbar(body_top, left_width - 2, view_height, len(rows), offset)

        if right_width < 30:
            return
        event = self.current_event()
        self.draw_box(top, left_width, height, right_width,
                      event["short_name"] if event else "Game", "accent")
        detail_width = right_width - 4
        if event:
            winner = game_winner(event) if self.logo_style != "off" else None
            logo = self.logos.get(self.league, winner) if winner else None
            if logo is not None:
                self.palette.logo_begin((self.league, winner.get("id")))
            detail = render_game_preview(event, self.league, detail_width,
                                         self.favorites, height=height - 2,
                                         logo=logo, logo_style=self.logo_style)
        else:
            detail = [Line().add("No game selected.", "dim")]
        self.detail_scroll = clamp(self.detail_scroll, 0,
                                   max(0, len(detail) - (height - 2)))
        self.draw_lines(detail, top + 1, left_width + 2, height - 2, detail_width,
                        self.detail_scroll)
        self.draw_scrollbar(top + 1, left_width + right_width - 2, height - 2,
                            len(detail), self.detail_scroll)

    def draw_lines_box(self, top, height, width, caption, lines, key=None):
        """The usual single panel: a box, the lines, a scrollbar."""
        key = key or self.tab_name
        inner_width = width - 4
        self.draw_box(top, 0, height, width, caption, "accent")
        self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(lines) - (height - 2)))
        self.draw_lines(lines, top + 1, 2, height - 2, inner_width, self.scroll[key])
        self.draw_scrollbar(top + 1, width - 2, height - 2, len(lines), self.scroll[key])

    def draw_panel_tab(self, top, height, width, title):
        # keep the game list in sync so the header and selection stay correct
        if is_wiki_sport(self.league):
            events, _ = self.wiki_events()
            self.events = self.visible_wiki_events(events)
            self.sync_selection()
        else:
            result = self.load_scoreboard()
            if result.data:
                self.events = self.visible_events(self.prepare_events(result.data))
                self.sync_selection()

        inner_width = width - 4
        meta = LEAGUES[self.league]
        if title == "Betting":
            self.draw_betting(top, height, width)
            return
        if title == "Settings":
            self.draw_settings(top, height, width)
            return
        if title == "Scouting":
            event = self.current_event()
            if not event:
                self.draw_lines_box(top, height, width, "Scouting", [
                    Line().add("Pick a game on the Scoreboard tab first.", "dim")])
                return
            self.draw_two_panes(top, height, width, title, self.scouting_panes(event, width))
            return
        if title == "Stats" and self.stats_team and self.stats_team[0] == self.league:
            self.draw_team_players(top, height, width, self.stats_team[1])
            return
        if title == "Stats":
            table = self.load_team_table()
            fam = family(self.league)
            view = self.stats_view.get(self.league, "")
            lines = []
            if table.data:
                groups = stat_groups(table.data)
                if not view:
                    view = "All" if stats_layout_fits(table.data, "All", inner_width) \
                        else (groups[0] if groups else "All")
                    self.stats_view[self.league] = view
                shown = stats_view_groups(table.data, view, inner_width)
                top25 = self.top25_ids() if self.ranked_only else None
                order = []
                selected = self.stats_sel.get(self.league, 0)
                lines = render_stats_table(table.data, self.league, inner_width,
                                           self.favorites, view,
                                           self.stats_sort.get(self.league),
                                           self.group_filter.get(fam, ""), top25,
                                           ranks=self.table_ranks(table.data),
                                           selected=selected, order=order,
                                           text=self.filter_text,
                                           order_by=self.stats_orderby.get(self.league,
                                                                           "stat"))
                self._stats_order = order
                if order and selected >= len(order):
                    self.stats_sel[self.league] = len(order) - 1
                lines.append(blank())
                hint = "j / k pick a team, enter its players  ·  [ ] one conference / " \
                       "division at a time, c the list  ·  / find a team  ·  s sort or A-Z" \
                       "  ·  g stat groups"
                if self.league in COLLEGE_LEAGUES:
                    hint += ", top 25"
                lines.append(Line().add(hint + "  ·  green best fifth, red worst fifth "
                                        "of the league", "muted"))
                if table.data.get("sources"):
                    lines.append(Line().add("Sources: " + ", ".join(table.data["sources"]),
                                            "muted"))
            elif table.loading:
                lines = [Line().add("Loading every team's season numbers…", "dim")]
                if self.league == "cbase":
                    lines.append(Line().add("College baseball comes from the NCAA, a page "
                                            "at a time - about a minute the first time.",
                                            "muted"))
            else:
                lines = wrap_spans(f"Team statistics unavailable: {table.error}",
                                   inner_width, "err")
            caption = f"{meta['label'] if is_olympic(self.league) else meta['name']} " \
                      "team stats · " + (" + ".join(shown) if table.data and view != "All"
                                         else "all groups")
            if self.group_filter.get(fam):
                caption += f" · {short_group(self.group_filter[fam])}"
            if self.ranked_only and self.league in COLLEGE_LEAGUES:
                caption += " · top 25"
            order_by = self.stats_orderby.get(self.league, "stat")
            if order_by == "name":
                caption += " · A-Z"
            elif order_by == "group":
                caption += " · by " + ("conference" if self.league in COLLEGE_LEAGUES
                                       else "division")
            if self.filter_text:
                caption += f" · find '{self.filter_text}'"
            if table.data:
                lines.insert(0, self.group_selector_line(inner_width))
            if table.data and not self._stats_order:
                lines[3:3] = [Line().add("  No team matches. / changes the search (empty "
                                         "clears it), c the conference.", "dim")]
            key = self.tab_name
            self.draw_box(top, 0, height, width, caption, "accent")
            # keep the two header rows in place while the teams scroll
            fixed = 3 if table.data else 0
            body = lines[fixed:]
            view_rows = height - 2 - fixed
            if table.data and self._stats_order:
                # keep the selected team on screen
                chosen = self.stats_sel.get(self.league, 0)
                if chosen < self.scroll[key]:
                    self.scroll[key] = chosen
                elif chosen >= self.scroll[key] + view_rows:
                    self.scroll[key] = chosen - view_rows + 1
            self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(body) - view_rows))
            if fixed:
                self.draw_lines(lines[:fixed], top + 1, 2, fixed, inner_width, 0)
            self.draw_lines(body, top + 1 + fixed, 2, view_rows, inner_width,
                            self.scroll[key])
            self.draw_scrollbar(top + 1 + fixed, width - 2, view_rows, len(body),
                                self.scroll[key])
            return
        if title == "Medals":
            table = self.load_medal_table()
            lines = render_medal_table(table.data, self.league, inner_width, self.favorites,
                                       table.loading, table.error)
            self.draw_lines_box(top, height, width, f"{meta['games']} · medal table", lines)
            return
        if title in ("Results", "Medalists"):
            if title == "Results":
                event = self.current_event()
                if not event:
                    lines = [Line().add("Pick an event on the Events tab first.", "dim")]
                    caption = "Results"
                else:
                    page = self.load_event_page(event)
                    caption = f"{event['name']} · results"
                    if page.data:
                        lines = render_event_results(event, page.data, self.league,
                                                     inner_width, self.favorites)
                    elif page.loading:
                        lines = [Line().add("Loading the event page…", "dim")]
                    else:
                        lines = wrap_spans(f"Could not load the event page: {page.error}",
                                           inner_width, "err")
            else:
                _, page = self.wiki_events()
                caption = f"{meta['label']} · medallists"
                if page.data:
                    lines = render_sport_medallists(page.data, self.league, inner_width,
                                                    self.favorites)
                elif page.loading:
                    lines = [Line().add("Loading the sport's page…", "dim")]
                else:
                    lines = wrap_spans(f"Could not load the sport's page: {page.error}",
                                       inner_width, "err")
            self.draw_lines_box(top, height, width, caption, lines)
            return
        if title == "Favorites":
            teams_result = self.load_teams()
            teams = parse_teams(teams_result.data) if teams_result.data else []
            self.fav_rows = favorites_rows(teams, self.favorites, self.league,
                                           self.fav_filter)
            self.fav_cursor = clamp(self.fav_cursor, 0, max(0, len(self.fav_rows) - 1))
            state = {
                "league": self.league,
                "favorites": self.favorites,
                "rows": self.fav_rows,
                "cursor": self.fav_cursor,
                "filter": self.fav_filter,
                "loading": teams_result.loading,
                "error": None if teams_result.data else teams_result.error,
            }
            lines = render_favorites(state, inner_width)
            caption = "Favorites"
            self.draw_box(top, 0, height, width, caption, "accent")
            key = self.tab_name
            view = height - 2
            head = 9 + len(LEAGUE_ORDER) - 3
            cursor_line = next((i for i, line in enumerate(lines)
                                if line and line[0][1] == "selbar"), 0)
            offset = self.scroll[key]
            if cursor_line >= offset + view:
                offset = cursor_line - view + 1
            if cursor_line < offset:
                offset = max(0, cursor_line - head)
            offset = clamp(offset, 0, max(0, len(lines) - view))
            self.scroll[key] = offset
            self.draw_lines(lines, top + 1, 2, view, inner_width, offset)
            self.draw_scrollbar(top + 1, width - 2, view, len(lines), offset)
            return

        if title in ("Playoffs", "Medal Round"):
            self.draw_playoffs(top, height, width, title)
            return

        if title == "Standings":
            standings = self.load_standings()
            if standings.data:
                lines = render_standings(standings.data, self.league, inner_width,
                                         self.favorites,
                                         self.group_filter.get(family(self.league), ""),
                                         self.filter_text)
            elif standings.loading:
                lines = [Line().add("Loading standings…", "dim")]
            else:
                lines = wrap_spans(f"Standings unavailable: {standings.error}",
                                   inner_width, "err")
            caption = (f"{meta['label']} · groups" if is_olympic(self.league)
                       else f"{meta['name']} standings")
            shown = standings_season_name(standings.data)
            if shown and not is_olympic(self.league):
                caption += f" · {shown}"
            if self.group_filter.get(family(self.league)):
                caption += f" · {short_group(self.group_filter[family(self.league)])}"
            if self.filter_text:
                caption += f" · find '{self.filter_text}'"
        else:
            event = self.current_event()
            if not event:
                lines = [Line().add("Pick a game on the Scoreboard tab first.", "dim")]
                caption = title
            else:
                summary = self.load_summary(event["id"])
                caption = f"{event['short_name']} · {title}"
                if summary.data and title == "Plays" and \
                        sport_of(self.league) == "basketball":
                    panes = self.basketball_panes(summary.data, event, width)
                    if panes:
                        self.draw_play_panes(top, height, width, panes, event,
                                             summary.data)
                        return
                if summary.data and title == "Plays" and \
                        sport_of(self.league) in ("football", "hockey"):
                    panes = self.plays_panes(summary.data, event, width)
                    if panes:
                        self.draw_play_panes(top, height, width, panes, event,
                                             summary.data)
                        return
                if summary.data and title == "Plays" and is_baseball(self.league):
                    panes = self.baseball_panes(summary.data, event, width)
                    if panes:
                        self.draw_play_panes(top, height, width, panes, event,
                                             summary.data)
                        return
                if summary.data and title in ("Boxscore", "Game Stats"):
                    panes = (self.boxscore_panes(summary.data, width)
                             if title == "Boxscore"
                             else self.team_stats_panes(summary.data, width))
                    if panes:
                        self.draw_two_panes(top, height, width, title, panes)
                        return
                    lines = [Line().add("Nothing published for this game yet.", "dim")]
                elif summary.data:
                    lines = render_plays(summary.data, self.league,
                                         inner_width, self.favorites)
                    if title == "Plays":
                        single = [(None, lines)]
                        self.decorate_plays(event, summary.data, single, inner_width)
                        self.follow_play(single, height, 10 ** 6)
                elif summary.loading:
                    lines = [Line().add("Loading game data…", "dim")]
                else:
                    lines = wrap_spans(f"Could not load this game: {summary.error}",
                                       inner_width, "err")

        self.draw_box(top, 0, height, width, caption, "accent")
        key = self.tab_name
        self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(lines) - (height - 2)))
        self.draw_lines(lines, top + 1, 2, height - 2, inner_width, self.scroll[key])
        self.draw_scrollbar(top + 1, width - 2, height - 2, len(lines), self.scroll[key])

    # -- split panes -----------------------------------------------------

    SPLIT_MIN_WIDTH = 110

    def pane_width(self, width):
        return width // 2 - 4 if width >= self.SPLIT_MIN_WIDTH else width - 4

    def boxscore_panes(self, summary, width):
        players = dig(summary, "boxscore", "players", default=[]) or []
        if not players:
            return None
        home_block, away_block = split_by_side(players, summary)
        away, home = summary_teams(summary)
        status = clean(dig(summary, "header", "competitions", 0, "status", "type",
                           "shortDetail", default="") or "")
        panes = []
        for block, team, side, extra in ((home_block, home, "home", ""),
                                         (away_block, away, "away", status)):
            title = pane_title(self.league, team, team["score"] if team else None,
                               side, self.favorites, extra)
            if block is None:
                body = [Line().add("No box score for this team yet.", "dim")]
            else:
                body = boxscore_team_lines(block, self.league, self.pane_width(width))
            panes.append((title, body))
        return panes

    def team_stats_panes(self, summary, width):
        teams = dig(summary, "boxscore", "teams", default=[]) or []
        if len(teams) < 2:
            return None
        inner = self.pane_width(width)
        graph, rest = team_stat_sections(summary, self.league, inner)
        left = list(graph)
        if rest:
            left += [blank()] + rest
        right = render_game_leaders(summary, self.league, inner, heading=False) or [
            Line().add("ESPN has not published game leaders for this game yet.", "dim")]

        away, home = summary_teams(summary)
        status = clean(dig(summary, "header", "competitions", 0, "status", "type",
                           "shortDetail", default="") or "")
        title = Line().add(" ", "border")
        for index, team in enumerate((away, home)):
            if not team:
                continue
            if index:
                title.add(" @ ", "muted")
            title.add(team["abbr"], THEME.style(self.league, team, bold=True,
                                                fallback="accent"))
            if team["score"] is not None:
                title.add(f" {team['score']}", "bold")
        title.add(f" · {status}" if status else "", "dim").add(" ", "border")
        return [(title, left), (Line().add(" Game leaders ", "accent"), right)]

    def draw_two_panes(self, top, height, width, key, panes):
        """Two boxes side by side, scrolled together. On a narrow terminal the
        same content stacks in one box instead."""
        view = height - 2
        if width < self.SPLIT_MIN_WIDTH:
            lines = []
            for title, body in panes:
                if lines:
                    lines.append(blank())
                lines.append(Line(list(title)))
                lines.extend(body)
            self.draw_box(top, 0, height, width)
            self.scroll[key] = clamp(self.scroll[key], 0, max(0, len(lines) - view))
            self.draw_lines(lines, top + 1, 2, view, width - 4, self.scroll[key])
            self.draw_scrollbar(top + 1, width - 2, view, len(lines), self.scroll[key])
            return
        left_width = width // 2
        longest = max(len(body) for _, body in panes)
        self.scroll[key] = clamp(self.scroll[key], 0, max(0, longest - view))
        offset = self.scroll[key]
        for (title, body), x, w in zip(panes, (0, left_width),
                                       (left_width, width - left_width)):
            self.draw_box(top, x, height, w)
            self.draw_lines([title], top, x + 2, 1, w - 4, 0)
            self.draw_lines(body, top + 1, x + 2, view, w - 4, offset)
            self.draw_scrollbar(top + 1, x + w - 2, view, len(body), offset)

    # -- input -----------------------------------------------------------

    def prompt(self, label, initial=""):
        buffer = list(initial)
        height, width = self.stdscr.getmaxyx()
        cursor(True)
        try:
            while True:
                text = "".join(buffer)
                self.put(height - 1, 0, " " * (width - 1), self.palette("normal"))
                self.put(height - 1, 1, label, self.palette("accent"))
                self.put(height - 1, 1 + len(label), text, self.palette("normal"))
                self.stdscr.move(height - 1, min(width - 2, 1 + len(label) + len(text)))
                self.stdscr.refresh()
                key = self.stdscr.getch()
                if key == -1:
                    continue
                if key in (10, 13, curses.KEY_ENTER):
                    return "".join(buffer)
                if key == 27:
                    return None
                if key in (curses.KEY_BACKSPACE, 127, 8):
                    if buffer:
                        buffer.pop()
                elif key == 21:  # ctrl-u
                    buffer = []
                elif 32 <= key < 127:
                    buffer.append(chr(key))
        finally:
            cursor(False)

    def shift_period(self, delta):
        self.detail_scroll = 0
        self.scroll["Scoreboard"] = 0
        if self.week_mode and LEAGUES[self.league]["week_based"]:
            meta = LEAGUES[self.league]
            week = (self.week or 1) + delta
            seasontype = self.seasontype
            top = meta["weeks"].get(seasontype, 18)
            while week > top:
                if seasontype >= 3:
                    week = top
                    break
                seasontype += 1
                week -= top
                top = meta["weeks"].get(seasontype, 18)
            while week < 1:
                if seasontype <= 1:
                    week = 1
                    break
                seasontype -= 1
                week += meta["weeks"].get(seasontype, 18)
                if week > meta["weeks"].get(seasontype, 18):
                    week = meta["weeks"].get(seasontype, 18)
            self.week = clamp(week, 1, meta["weeks"].get(seasontype, 18))
            self.seasontype = seasontype
            self.week_pinned = True
        else:
            self.day = self.day + timedelta(days=delta)
        self.selected_id = None
        self.selected_index = 0

    def goto_today(self):
        self.day = Date.today()
        self.week_pinned = False
        self.selected_id = None
        self.selected_index = 0
        self.scroll["Scoreboard"] = 0
        self.detail_scroll = 0

    def parse_date_input(self, text):
        text = text.strip().lower()
        if not text:
            return None
        if text in ("today", "t"):
            return Date.today()
        if text in ("yesterday", "y"):
            return Date.today() - timedelta(days=1)
        if text in ("tomorrow", "tm"):
            return Date.today() + timedelta(days=1)
        today = Date.today()
        for pattern, builder in (
            (r"^(\d{4})-(\d{1,2})-(\d{1,2})$", lambda m: Date(int(m[1]), int(m[2]), int(m[3]))),
            (r"^(\d{4})(\d{2})(\d{2})$", lambda m: Date(int(m[1]), int(m[2]), int(m[3]))),
            (r"^(\d{1,2})[/-](\d{1,2})$", lambda m: Date(today.year, int(m[1]), int(m[2]))),
            (r"^(\d{1,2})$", lambda m: Date(today.year, today.month, int(m[1]))),
        ):
            match = re.match(pattern, text)
            if match:
                try:
                    return builder(match)
                except ValueError:
                    return None
        return None

    def switch_league(self, league):
        """Open a league. A family ('owg') opens on its current Games and
        the sport last looked at there."""
        if league in ("owg", "osg"):
            league = olympic_default(league, self.olympic_events.get(league))
        if league not in LEAGUES or LEAGUES[league].get("virtual"):
            return
        before = self.tab_name
        self.league = league
        self.week_mode = LEAGUES[league]["week_based"]
        self.week_pinned = False
        self.week = None
        self.seasontype = 2
        self.season_year = None
        self.selected_id = None
        self.selected_index = 0
        self.detail_scroll = 0
        self.fav_cursor = 0
        self.fav_filter = ""
        self.at_bat = None
        self.events = []
        self.scroll = ScrollMap()
        # stay on the same screen where the new league has one
        tabs = self.tabs
        self.tab = tabs.index(before) if before in tabs else 1
        if is_olympic(league):
            fam = family(league)
            slug = LEAGUES[league]["slug"]
            if self.olympic_events.get(fam) != slug:
                self.olympic_events[fam] = slug
                self.config["olympic_events"] = dict(self.olympic_events)
                try:
                    save_config(self.config, self.args.config)
                except OSError:
                    pass

    def cycle_league(self, step=1):
        current = LEAGUE_ORDER.index(family(self.league))
        self.switch_league(LEAGUE_ORDER[(current + step) % len(LEAGUE_ORDER)])

    def shift_games(self, step):
        """h / l in the Olympics: the previous or next Games, same sport."""
        meta = LEAGUES[self.league]
        games_list = OLYMPIC_GAMES[meta["family"]]
        index = next(i for i, g in enumerate(games_list) if g["year"] == meta["year"])
        target = index + step
        if not 0 <= target < len(games_list):
            self.status_message = ("That is the first Games on file." if step < 0
                                   else "That is the last Games on file.")
            return
        games = games_list[target]
        self.switch_league(olympic_default(meta["family"], meta["slug"], games["year"]))
        self.status_message = f"{games['name']}."

