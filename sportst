# (a list of game days; for MLB a list of the days without games inside the
# season), the month's scoreboard for football, and HockeyTech's season
# schedule for the AHL. Which days your teams play: each favourite's own
# schedule.

def game_day(stamp, tba=False):
    """The day a game is filed under on the scoreboard: ESPN's days run on
    US Eastern time; a game with no start time yet keeps its own date."""
    if not stamp:
        return None
    text = str(stamp)
    if tba:
        return text[:10]
    when = parse_iso(text)
    if not when:
        return text[:10]
    return (when.astimezone(timezone.utc) - timedelta(hours=5)).date().isoformat()


def espn_game_days(league, month_iso, groups=None, timeout=15):
    """{'days': [iso dates with games in that month and around it]}."""
    meta = LEAGUES[league]
    year, month = int(month_iso[:4]), int(month_iso[5:7])
    football = sport_of(league) == "football"
    params = {"dates": f"{year}{month:02d}" if football else f"{year}{month:02d}15"}
    if not football:
        params["limit"] = "1"
    if groups:
        params["groups"] = str(groups)
    tail = f"{meta['sport']}/{meta['path']}/scoreboard?" + urllib.parse.urlencode(params)
    data = fetch_first((f"https://{SITE_HOSTS[0]}/apis/site/v2/sports/{tail}",
                        [f"https://{SITE_HOSTS[1]}/apis/site/v2/sports/{tail}"]), timeout)
    days = set()
    if football:
        for event in data.get("events") or []:
            comp = dig(event, "competitions", 0, default={}) or {}
            day = game_day(event.get("date"), comp.get("timeValid") is False)
            if day:
                days.add(day)
        return {"days": sorted(days)}
    league_node = (data.get("leagues") or [{}])[0]
    entries = [str(e)[:10] for e in league_node.get("calendar") or [] if isinstance(e, str)]
    if league_node.get("calendarIsWhitelist", True):
        days.update(entries)
    else:
        start = str(league_node.get("calendarStartDate") or "")[:10]
        end = str(league_node.get("calendarEndDate") or "")[:10]
        try:
            day = Date.fromisoformat(start)
            last = Date.fromisoformat(end)
        except ValueError:
            return {"days": []}
        skip = set(entries)
        while day <= last:
            if day.isoformat() not in skip:
                days.add(day.isoformat())
            day += timedelta(days=1)
    return {"days": sorted(days)}


def ahl_season_games(timeout=15):
    """Every game of the AHL season: [{day, home, away, id, label}]."""
    data = ht_get({"feed": "modulekit", "view": "schedule"}, timeout)
    games = []
    for game in dig(data, "SiteKit", "Schedule", default=[]) or []:
        day = str(game.get("date_played") or "")[:10]
        if not day:
            continue
        games.append({"day": day, "id": str(game.get("game_id") or game.get("id")),
                      "home": str(game.get("home_team")), "away": str(game.get("visiting_team")),
                      "home_code": clean(game.get("home_team_code") or ""),
                      "away_code": clean(game.get("visiting_team_code") or ""),
                      "time": clean(game.get("scheduled_time") or "")})
