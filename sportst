SITE_HOSTS = ["site.api.espn.com", "site.web.api.espn.com"]


class Espn:
    """Every builder returns (url, [fallback_urls]).

    ESPN serves the same site API from two hostnames. One is occasionally
    rate limited or blocked where the other is not, so always carry a spare.
    """

    def __init__(self, host="site.api.espn.com"):
        self.hosts = [host] + [h for h in SITE_HOSTS if h != host]

    def _site(self, tail, league=None):
        hosts = self.hosts
        preferred = LEAGUES.get(league, {}).get("hosts") if league else None
        if preferred:
            # ESPN answers its Olympic tournaments on site.web.api only
            hosts = preferred + [h for h in hosts if h not in preferred]
        return [f"https://{h}/apis/site/v2/sports/{tail}" for h in hosts]

    def _core(self, tail):
        return [f"https://{h}/apis/v2/sports/{tail}" for h in self.hosts]

    def scoreboard(self, league, day=None, week=None, seasontype=None, year=None,
                   groups=None, limit=None):
        meta = LEAGUES[league]
        params = {}
        if week:
            params["week"] = str(week)
            params["seasontype"] = str(seasontype or 2)
            if year:
                params["dates"] = str(year)
        elif day:
            params["dates"] = day.strftime("%Y%m%d")
        if groups:
            params["groups"] = str(groups)
        if meta.get("year"):
            # an Olympic tournament: the whole thing in one payload
            params = {"dates": str(meta["year"])}
        if limit or meta.get("limit"):
            params["limit"] = str(limit or meta["limit"])
        query = ("?" + urllib.parse.urlencode(params)) if params else ""
        urls = self._site(f"{meta['sport']}/{meta['path']}/scoreboard{query}", league)
        return urls[0], urls[1:]

    def summary(self, league, event_id):
        meta = LEAGUES[league]
        tail = (f"{meta['sport']}/{meta['path']}/summary"
                f"?event={urllib.parse.quote(str(event_id))}")
        urls = self._site(tail, league)
        return urls[0], urls[1:]

    def odds(self, league, event_id):
        """Core odds for one game. Unlike the scoreboard, this keeps the line
        after kickoff and after the final."""
        meta = LEAGUES[league]
        event_id = urllib.parse.quote(str(event_id))
        url = (f"https://sports.core.api.espn.com/v2/sports/{meta['sport']}/leagues/"
               f"{meta['path']}/events/{event_id}/competitions/{event_id}/odds")
        return url, []

    def teams(self, league):
        meta = LEAGUES[league]
        urls = self._site(f"{meta['sport']}/{meta['path']}/teams?limit=1000", league)
        return urls[0], urls[1:]

    def rankings(self, league):
        meta = LEAGUES[league]
        urls = self._site(f"{meta['sport']}/{meta['path']}/rankings")
        return urls[0], urls[1:]

    def standings(self, league, season=None):
        meta = LEAGUES[league]
        params = {"level": "3"}
        if season:
            params["season"] = str(season)
        if meta.get("year"):
            params = {"season": str(meta["year"])}
            query = urllib.parse.urlencode(params)
            urls = [f"https://{h}/apis/v2/sports/{meta['sport']}/{meta['path']}/standings?{query}"
                    for h in ("site.web.api.espn.com", "site.api.espn.com")]
            return urls[0], urls[1:]
        query = urllib.parse.urlencode(params)
        urls = self._core(f"{meta['sport']}/{meta['path']}/standings?{query}")
        urls.append(f"https://cdn.espn.com/core/{meta['path']}/standings?xhr=1")
        return urls[0], urls[1:]


