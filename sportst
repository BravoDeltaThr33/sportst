_NOC_BY_NAME = {}


def _index_nocs():
    for code, (name, aliases) in NOCS.items():
        for alias in [name, code] + [a for a in aliases.split("|") if a]:
            _NOC_BY_NAME.setdefault(norm_name(alias), code)


def noc_code(team):
    """The IOC code for a team or country dict, or ''."""
    if not isinstance(team, dict):
        return ""
    if not _NOC_BY_NAME:
        _index_nocs()
    abbr = str(team.get("abbr") or "").upper()
    if abbr in NOCS:
        return abbr
    for field in ("name", "location", "short"):
        value = norm_name(team.get(field) or "")
        value = re.sub(r" (u ?23|u ?21|olympic team|men|women)$", "", value)
        if value in _NOC_BY_NAME:
            return _NOC_BY_NAME[value]
    return ""


