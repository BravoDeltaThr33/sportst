def poisson_chances(lam, top=12):
    import math
    lam = max(0.05, lam)
    return [math.exp(-lam) * lam ** k / math.factorial(k) for k in range(top)]


def score_odds_lines(model, event, league, width, total=None):
    """A picture of sportst's projected score, taking each team's goals as a
    Poisson count: how many goals the game might have (the posted total
    marked), the likeliest scores, and the chance it goes to overtime. The
    bets' own chances come from the model, not from this."""
    if not model or not model.get("proj"):
        return []
    a_goals, h_goals = model["proj"]
    away, home = event["away"], event["home"]
    pa, ph = poisson_chances(a_goals), poisson_chances(h_goals)
    grid = [[pa[i] * ph[j] for j in range(len(ph))] for i in range(len(pa))]
    totals = [0.0] * 11
    for i in range(len(pa)):
        for j in range(len(ph)):
            totals[min(10, i + j)] += grid[i][j]
    lines = [heading("Score odds"),
             Line().add(f"the projected {away['abbr']} {a_goals:.1f}-{h_goals:.1f} "
                        f"{home['abbr']} as Poisson goals: a picture, not the bets' "
                        "chances"[:width], "muted")]
    peak = max(totals) or 1
    bars = Line().add("  goals  ", "muted")
    labels = Line().add("         ", "muted")
    marked = False
    for k, value in enumerate(totals[:10]):
        level = int(round(value / peak * 7))
        over = total is not None and k > total
        if over and not marked:
            bars.add("┊ ", "border")         # where the posted total falls
            labels.add("  ", "muted")
            marked = True
        bars.add(SPARK_BARS[clamp(level, 0, 7)] + " ", "warn" if over else "accent")
        labels.add(f"{k if k < 9 else '9+':<2}"[:2], "muted")
    if marked:
        labels.add(f"   ┊ the total, {total:g}", "dim")
    lines.extend([bars, labels])
    cells = sorted(((grid[i][j], i, j) for i in range(8) for j in range(8)), reverse=True)
    likely = Line().add("  likeliest ", "muted")
    for index, (chance, i, j) in enumerate(cells[:4]):
        if index:
            likely.add(" · ", "muted")
        likely.add(f"{away['abbr']} {i}-{j} {home['abbr']}", "normal")
        likely.add(f" {chance * 100:.0f}%", "dim")
    lines.append(fit_line(likely, width))
    tie = sum(grid[i][i] for i in range(min(len(pa), len(ph))))
    lines.append(Line().add(f"  tied after 60 minutes {tie * 100:.0f}%", "normal")
                 .add("  (overtime, then a shootout)", "dim"))
    return [fit_line(line, width) for line in lines]


def tale_of_tape(event, teams, league, width):
    """The two teams side by side from the standings: record, points %, goals
    for and against a game, last ten, streak, and the home team's record at
    home against the visitor's on the road."""
    by_id = {str(t["team"].get("id")): t for t in teams}
    a, h = by_id.get(str(event["away"].get("id"))), by_id.get(str(event["home"].get("id")))
    if not a or not h:
        return []
    away, home = event["away"], event["home"]
    label_w = 16
    lines = [heading("Tale of the tape")]
    head = Line().add(" " * label_w, "normal")
    head.add(f"{away['abbr']:>9}", THEME.style(league, away, bold=True, fallback="accent"))
    head.add(f"{home['abbr']:>9}", THEME.style(league, home, bold=True, fallback="accent"))
    lines.append(head)

    def row(label, left, right, better=0):
        line = Line().add(f"{label:<{label_w}}", "muted")
        line.add(f"{left:>9}", "good" if better > 0 else "normal")
        line.add(f"{right:>9}", "good" if better < 0 else "normal")
        lines.append(fit_line(line, width))

    def per_game(entry, key):
        return entry[key] / entry["gp"] if entry[key] is not None and entry["gp"] else None

    row("Points %", f"{a['pct']:.3f}".replace("0.", ".", 1),
        f"{h['pct']:.3f}".replace("0.", ".", 1), (a["pct"] > h["pct"]) - (a["pct"] < h["pct"]))
    row("Points", f"{a['pts']} in {a['gp']}", f"{h['pts']} in {h['gp']}")
    for label, key, higher in (("Goals for / gm", "gf", True), ("Goals agst / gm", "ga", False)):
        left, right = per_game(a, key), per_game(h, key)
        if left is None or right is None:
            continue
        better = (left > right) - (left < right)
        row(label, f"{left:.2f}", f"{right:.2f}", better if higher else -better)
    if a["l10"] and h["l10"]:
        row("Last ten", a["l10"], h["l10"],
            ((a["l10_pts"] or 0) > (h["l10_pts"] or 0)) - ((a["l10_pts"] or 0) <
                                                         (h["l10_pts"] or 0)))
    if all(re.fullmatch(r"[A-Z]{1,3}\d+", t["streak"] or "") for t in (a, h)):
        row("Streak", a["streak"], h["streak"])
    if a["road"] and h["home"]:
        row("Road · home", a["road"], h["home"])
    return lines


