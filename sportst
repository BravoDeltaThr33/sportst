                                         self.favorites, self.league)
        if not page.data and page.loading:
            header, rows = None, [Line().add("Loading the sport from Wikipedia…", "dim")]
        elif not page.data and page.error:
            header, rows = None, wrap_spans(f"Could not reach Wikipedia: {page.error}",
                                            inner_width, "err")
        elif page.data and page.data.get("missing"):
            header, rows = None, wrap_spans(
                f"Wikipedia has no page for {meta['label']} at {meta['games']} yet.",
                inner_width, "dim")
        elif events and not self.events and self.filter_text:
            header, rows = None, wrap_spans(
                f"No event matches '{self.filter_text}'. / changes the search (an empty "
                "search clears it).", inner_width, "dim")
        body_top, view = top + 1, height - 2
        if header is not None:
            self.draw_lines([header], top + 1, 2, 1, inner_width, 0)
            body_top, view = top + 2, height - 3
        offset = self.scroll["Scoreboard"]
        if self.selected_index >= offset + view:
            offset = self.selected_index - view + 1
        if self.selected_index < offset:
            offset = self.selected_index
        offset = clamp(offset, 0, max(0, len(rows) - view))
        self.scroll["Scoreboard"] = offset
        self.draw_lines(rows, body_top, 2, view, inner_width, offset)
        self.draw_scrollbar(body_top, left_width - 2, view, len(rows), offset)
        if self.events and header is not None:
            for row in range(view):
                index = offset + row
                if index < len(self.events):
                    self.hot(body_top + row, 1, left_width - 2,
                             lambda i=index: self.click_game(i),
                             lambda i=index: self.click_game(i, True))
        if right_width < 30:
            return
        event = self.current_event()
        self.draw_box(top, left_width, height, right_width,
                      event["name"] if event else "Event", "accent")
        detail_width = right_width - 4
        if event:
            result = self.load_event_page(event)
            detail = render_event_preview(event, result.data, self.league, detail_width,
                                          self.favorites, loading=result.loading)
            if result.error and not result.data:
                detail.extend(wrap_spans(f"Could not load the event page: {result.error}",
                                         detail_width, "err"))
        else:
            detail = [Line().add("No event selected.", "dim")]
        self.detail_scroll = clamp(self.detail_scroll, 0, max(0, len(detail) - (height - 2)))
        self.draw_lines(detail, top + 1, left_width + 2, height - 2, detail_width,
                        self.detail_scroll)
        self.draw_scrollbar(top + 1, left_width + right_width - 2, height - 2,
                            len(detail), self.detail_scroll)

    def scroll_active(self, delta, page=False):
        key = self.tab_name
        height = max(1, self.stdscr.getmaxyx()[0] - 6)
        step = delta * (height if page else 1)
        if self.on_board:
            self.detail_scroll = max(0, self.detail_scroll + step)
        else:
            self.scroll[key] = max(0, self.scroll[key] + step)

    def move_selection(self, delta):
        if not self.events:
            return
        self.selected_index = clamp(self.selected_index + delta, 0, len(self.events) - 1)
        self.selected_id = self.events[self.selected_index]["id"]
        self.detail_scroll = 0
        self.at_bat = None

    # -- scoring-play clips (Plays tab) -------------------------------------

    def mlb_game_pk(self, event):
        """MLB's id for this game, from MLB's schedule for the day."""
        game_pk = self.game_pks.get(event["id"])
        if game_pk is not None:
            return game_pk
        when = parse_iso(event["date"])
        day = when.astimezone().date() if when else Date.today()
        for offset in (0, -1, 1):
            probe = day + timedelta(days=offset)
            result = self.fetcher.get(("mlbsched", probe.isoformat()),
                                      statcast_schedule_url(probe), ttl=3600)
            if not result.data:
                continue
            found = find_game_pk(result.data, event)
            if found:
                self.game_pks[event["id"]] = found
                return found
        return None

    def clip_sources(self, event, summary):
        """(one-play clips, game highlight, nhl.com goal links, loading) for a
        game, from whichever free source covers its league."""
        league = self.league
        loading = False
        plays, game, nhl_links = [], None, {}
        if league == "mlb":
            game_pk = self.mlb_game_pk(event)
            if game_pk:
                result = self.fetcher.get(("mlbclips", game_pk),
                                          Loader("statsapi.mlb.com", mlb_clips, game_pk),
                                          ttl=120 if event["state"] == "in" else 1800)
                loading = result.loading and not result.data
                if result.data:
                    plays, game = result.data["plays"], result.data["game"]
        elif league in YOUTUBE_CHANNELS:
            if self.config.get("youtube_clips", True):
                channel = YOUTUBE_CHANNELS[league]
                result = self.fetcher.get(("ytfeed", channel),
                                          Loader("www.youtube.com", youtube_feed, channel),
                                          ttl=300)
                loading = result.loading and not result.data
                entries = result.data or []
                plays = entries
                game = youtube_game_clip(entries, event)
        else:
            plays, game = espn_clips(summary)
            if league == "nhl" and event["state"] != "pre":
                when = parse_iso(event["date"])
                if when:
                    day = (when.astimezone(timezone.utc) - timedelta(hours=5)).date()
                    result = self.fetcher.get(
                        ("nhlclips", event["id"]),
                        Loader("api-web.nhle.com", nhl_goal_clips, day.isoformat(), event),
                        ttl=120 if event["state"] == "in" else 1800)
                    nhl_links = result.data or {}
        return plays, game, nhl_links, loading

    def match_play_clips(self, event, summary, refs):
        """{play index: clip} and the game's highlight clip. Every play gets
        something to open: its own clip, the NHL's goal page, or a YouTube
        search for it."""
        plays, game, nhl_links, loading = self.clip_sources(event, summary)
        texts = [re.sub(r"^(Even Strength|Power Play|Shorthanded|Short Handed|Empty Net)"
                        r"(, [^G]*)? Goal Scored by ", "",
                        clean(at_bat_text(ref) if "pitches" in ref else (ref.get("text") or "")))
                 for ref in refs]
        matched = assign_clips(texts, plays, team_words(event)) if plays else {}
        out = {}
        youtube = self.config.get("youtube_clips", True)
        for index, ref in enumerate(refs):
            clip = matched.get(index)
            if clip is None and nhl_links:
                number = dig(ref, "period", "number", default=0)
                clock = clean(dig(ref, "clock", "displayValue", default="")).lstrip("0")
                clip = nhl_links.get((_int(number), clock or "0:00"))
            if clip is None and youtube:
                clip = {"title": "a YouTube search for this play",
                        "url": play_search_url(event, self.league, texts[index]),
                        "kind": "search", "source": "YouTube", "seconds": 0}
            if clip is not None:
                out[index] = clip
        if game is None and youtube:
            game = {"title": "a YouTube search for this game's highlights",
                    "url": game_search_url(event, self.league), "kind": "search",
                    "source": "YouTube", "seconds": 0}
        return out, game, loading

    def decorate_plays(self, event, summary, panes, inner):
        """Mark each scoring play's clip (♪ plays here, ↗ opens the browser)
        and highlight the chosen one; keep it on screen. `panes` is a list of
        (title, lines); returns them changed in place."""
        refs, seen = [], set()
        for _, body in panes:
            for line in body:
                ref = getattr(line, "play_ref", None)
                if ref is not None and getattr(line, "play_first", False) \
                        and id(ref) not in seen:
                    seen.add(id(ref))
                    refs.append(ref)
        self._play_event = event["id"]
        self._play_refs = refs
        clips, game, loading = self.match_play_clips(event, summary, refs)
        if not refs:
            self._play_clips, self._game_clip = {}, game
            return panes
        self._play_clips, self._game_clip, self._clips_loading = clips, game, loading
        chosen = self.play_sel.get(event["id"])
        if chosen is not None:
            chosen = clamp(chosen, 0, len(refs) - 1)
            self.play_sel[event["id"]] = chosen
        index_of = {id(ref): i for i, ref in enumerate(refs)}
        playing = self.player and self.player.get("event") == event["id"] and \
            self.player.get("play")
        focus = None
        for pane_index, (_, body) in enumerate(panes):
            for line_index, line in enumerate(body):
                ref = getattr(line, "play_ref", None)
                if ref is None:
                    continue
                index = index_of.get(id(ref))
                selected = index == chosen
                if getattr(line, "play_first", False) and line and line[0][0] == "  ":
                    clip = clips.get(index)
                    mark = ""
                    if playing is not None and playing == index:
                        mark = "▶"
                    elif clip and clip["kind"] == "audio":
                        mark = "♪"
                    elif clip and clip["kind"] == "page":
                        mark = "↗"
                    line[0] = (f"{mark} " if mark else "  ",
                               "live" if mark == "▶" else "accent")
                if selected:
                    if focus is None:
                        focus = (pane_index, line_index)
                    restyled = [(text, _on_cursor(style)) for text, style in line]
                    line[:] = restyled
                    used = sum(len(t) for t, _ in line)
                    if used < inner:
                        line.append((" " * (inner - used), "sel"))
        if focus and self._play_follow:
            self._play_focus = focus
        return panes

    def follow_play(self, panes, height, width):
        """Scroll the Plays panes so the chosen play is in view, once, right
        after j / k picked it (J / K and PgDn still scroll freely)."""
        focus = getattr(self, "_play_focus", None)
        if not (focus and self._play_follow):
            return
        self._play_follow = False
        self._play_focus = None
        self.scroll_into_view(panes, height, width, "Plays", *focus)

    def player_status(self):
        if not self.player:
            return ""
        return f"♪ {self.player['title']} · {self.player['source']} · X stops"

    def stop_clip(self, quiet=False):
        if self.player:
            try:
                self.player["proc"].terminate()
            except (OSError, AttributeError):
                pass
            self.player = None
            if not quiet:
                self.status_message = "Stopped."

    def poll_player(self):
        """Forget a clip once its player has finished."""
        if self.player and self.player["proc"].poll() is not None:
            self.player = None
            self.dirty = True

    def play_clip(self, clip, play_index=None):
        if not clip:
            self.status_message = "No clip for this play."
            return
        choice = str(self.config.get("clip_player", "auto") or "auto")
        if clip["kind"] == "audio" and choice != "browser":
            name, path = find_player(choice)
            if path:
                self.stop_clip(quiet=True)
                try:
                    proc = start_player(path, name, clip["url"],
                                        video=bool(self.config.get("clip_video", False)))
                except OSError as exc:
                    self.status_message = f"⚠ Could not start {name}: {exc}"
                    return
                self.player = {"proc": proc, "title": clip["title"], "source": clip["source"],
                               "event": getattr(self, "_play_event", None),
                               "play": play_index, "url": clip["url"]}
                self.status_message = ""
                return
            hint = " (install mpv to hear it here)" if choice == "auto" else \
                f" ({choice} is not installed)"
        else:
            hint = ""
        if open_in_browser(clip["url"]):
            what = {"search": "Searching YouTube", "page": "Opening"}.get(clip["kind"],
                                                                         "Opening")
            title = "" if clip["kind"] == "search" else f": {clip['title']}"
            self.status_message = f"↗ {what} in your browser{title}{hint}."
        else:
            self.status_message = f"⚠ No browser found to open {clip['url']}"

    def handle_plays_key(self, key):
        """Return True when the Plays tab has used the key: j / k pick a
        scoring play, enter plays its clip, y the game's highlights, x stops."""
        event = self.current_event()
        refs = self._play_refs if event and self._play_event == event["id"] else []
        if key in (ord("j"), curses.KEY_DOWN, ord("k"), curses.KEY_UP) and refs:
            current = self.play_sel.get(event["id"])
            step = 1 if key in (ord("j"), curses.KEY_DOWN) else -1
            if current is None:
                current = 0 if step > 0 else len(refs) - 1
            else:
                current = clamp(current + step, 0, len(refs) - 1)
            self.play_sel[event["id"]] = current
            self._play_follow = True
            clip = self._play_clips.get(current)
            if clip and clip["kind"] != "search":
                self.status_message = f"{'♪' if clip['kind'] == 'audio' else '↗'} " \
                                      f"{clip['title']} · enter " + \
                                      ("plays it" if clip["kind"] == "audio" else "opens it")
            return True
        if key in (ord("n"), ord("N")) and refs:
            have = sorted(i for i, c in self._play_clips.items() if c["kind"] != "search")
            if not have:
                self.status_message = ("Still looking for this game's clips…"
                                       if self._clips_loading else
                                       "No clips found for this game's plays.")
                return True
            current = self.play_sel.get(event["id"])
            if key == ord("n"):
                later = [i for i in have if current is None or i > current]
                target = later[0] if later else have[0]
            else:
                earlier = [i for i in have if current is not None and i < current]
                target = earlier[-1] if earlier else have[-1]
            self.play_sel[event["id"]] = target
            self._play_follow = True
            clip = self._play_clips[target]
            self.status_message = f"{'♪' if clip['kind'] == 'audio' else '↗'} " \
                                  f"{clip['title']} · enter " + \
                                  ("plays it" if clip["kind"] == "audio" else "opens it")
            return True
        if key in (10, 13, curses.KEY_ENTER) and refs:
            chosen = self.play_sel.get(event["id"])
            if chosen is None:
                self.status_message = "j / k pick a scoring play first."
                return True
            if self.player and self.player.get("play") == chosen and \
                    self.player.get("event") == event["id"]:
                self.stop_clip()
                return True
            self.play_clip(self._play_clips.get(chosen), chosen)
            return True
        if key == ord("y") and event:
            if self._play_event != event["id"]:
                self.status_message = "Still loading this game."
                return True
            self.play_clip(self._game_clip, None)
            return True
        if key == ord("x") and self.player:
            self.stop_clip()
            return True
        if key in (ord("J"), ord("K")):
            self.scroll["Plays"] = max(0, self.scroll["Plays"] + (3 if key == ord("J") else -3))
            return True
        return False

    def draw_play_panes(self, top, height, width, panes, event, summary):
        inner = self.pane_width(width)
        self.decorate_plays(event, summary, panes, inner)
        self.follow_play(panes, height, width)
        self.draw_two_panes(top, height, width, "Plays", panes)

    # -- headlines on the Scouting tab, and the article card ------------------

    def decorate_news(self, event, panes, inner):
        """Number the Scouting tab's headlines for n / N and enter, and
        highlight the picked one (`panes` is changed in place). Returns where
        each headline is, as (pane, line) pairs."""
        found = []
        for pane_index, (_, body) in enumerate(panes):
            for line_index, line in enumerate(body):
                ref = getattr(line, "news_ref", None)
                if ref is not None:
                    found.append((ref, pane_index, line_index))
        self._news_event = event["id"]
        self._news_refs = [ref for ref, _, _ in found]
        spots = [(pane_index, line_index) for _, pane_index, line_index in found]
        if found:
            # the first News heading says how to open them
            _, pane_index, line_index = found[0]
            heading = panes[pane_index][1][line_index - 1] if line_index else None
            hint = "  n / N pick a headline · enter reads it"
            if heading is not None and heading.text.strip() == "News" and \
                    len(heading.text) + len(hint) <= inner:
                heading.add(hint, "muted")
        chosen = self.news_sel.get(event["id"])
        if chosen is None or not found:
            self._news_follow = False
            return spots
        chosen = clamp(chosen, 0, len(found) - 1)
        self.news_sel[event["id"]] = chosen
        _, pane_index, line_index = found[chosen]
        line = panes[pane_index][1][line_index]
        line[:] = [(text, _on_cursor(style)) for text, style in line]
        used = sum(len(text) for text, _ in line)
        if used < inner:
            line.append((" " * (inner - used), "sel"))
        self._news_focus = (pane_index, line_index)
        return spots

    def draw_scouting(self, top, height, width, event):
        """The Scouting tab: the two panes, the picked headline kept in view
        once n / N picked it, and every headline clickable."""
        panes = self.scouting_panes(event, width)
        spots = self.decorate_news(event, panes, self.pane_width(width))
        if self._news_follow and self._news_focus:
            self._news_follow = False
            self.scroll_into_view(panes, height, width, "Scouting", *self._news_focus)
        self.draw_two_panes(top, height, width, "Scouting", panes)
        for index, (pane_index, line_index) in enumerate(spots):
            spot = self.pane_spot(panes, top, height, width, "Scouting", pane_index,
                                  line_index)
            if spot:
                y, start, end = spot
                self.hot(y, start, end, lambda i=index: self.click_headline(i),
                         lambda i=index: self.click_headline(i, True))

    def pane_position(self, panes, width, pane_index, line_index):
        """Which row of the scrolled content a pane's line is: its own row
        side by side, or counted down the stack on a narrow screen (a blank
        and the title before each pane), as draw_two_panes lays them out."""
        if width >= self.SPLIT_MIN_WIDTH or len(panes) < 2:
            return line_index
        position = 0
        for index, (_, body) in enumerate(panes):
            if index:
                position += 1
            position += 1
            if index == pane_index:
                return position + line_index
            position += len(body)
        return position

    def pane_spot(self, panes, top, height, width, key, pane_index, line_index):
        """(screen row, first column, end column) of a pane's line as drawn,
        or None when it is scrolled out of view."""
        row = self.pane_position(panes, width, pane_index, line_index) - self.scroll[key]
        if not 0 <= row < height - 2:
            return None
        if width < self.SPLIT_MIN_WIDTH:
            return top + 1 + row, 2, width - 2
        left_width = width // 2
        x, w = (0, left_width) if pane_index == 0 else (left_width, width - left_width)
        return top + 1 + row, x + 2, x + w - 2

    def scroll_into_view(self, panes, height, width, key, pane_index, line_index):
        """Scroll two panes so a line of one is in view, with a line of
        room around it."""
        line_index = self.pane_position(panes, width, pane_index, line_index)
        view = height - 2
        offset = self.scroll[key]
        if line_index < offset + 1:
            offset = max(0, line_index - 2)
        elif line_index >= offset + view - 1:
            offset = line_index - view + 3
        self.scroll[key] = max(0, offset)

    def news_hint(self, ref):
        kind = news_kind(ref)
        mark = "▶" if kind == "video" else "›"
        return f"{mark} {clean(ref.get('headline') or '')} · enter opens it"

    def handle_scouting_key(self, key):
        """n / N pick the next / previous headline on the Scouting tab, enter
        opens the picked one in the article card (or, with none picked,
        picks the first), esc lets go of it."""
        event = self.current_event()
        refs = self._news_refs if event and self._news_event == event["id"] else []
        if not refs:
            return False
        current = self.news_sel.get(event["id"])
        if key in (ord("n"), ord("N")):
            step = 1 if key == ord("n") else -1
            if current is None:
                current = 0 if step > 0 else len(refs) - 1
            else:
                current = (current + step) % len(refs)
            self.news_sel[event["id"]] = current
            self._news_follow = True
            self.status_message = self.news_hint(refs[min(current, len(refs) - 1)])
            return True
        if key in (10, 13, curses.KEY_ENTER):
            if current is None:
                self.news_sel[event["id"]] = 0
                self._news_follow = True
                self.status_message = self.news_hint(refs[0])
                return True
            current = min(current, len(refs) - 1)
            self.open_article(refs[current], current)
            return True
        if key == 27 and current is not None:
            self.news_sel.pop(event["id"], None)
            return True
        return False

    def click_headline(self, index, open_it=False):
        """A headline on the Scouting tab: the first click picks it, a click
        on the picked one (or a double click) opens it."""
        event = self.current_event()
        if not event or not 0 <= index < len(self._news_refs):
            return False
        again = self.clicked_again("news", event["id"], index)
        self.news_sel[event["id"]] = index
        if again or open_it:
            self.open_article(self._news_refs[index], index)
            return True
        self.status_message = self.news_hint(self._news_refs[index])
        return False

    def open_article(self, ref, index=None):
        self.article = {"ref": ref, "league": self.league, "event": self._news_event,
                        "index": index, "scroll": 0}
        self.dirty = True

    def article_data(self):
        """The open card's story (or video) from ESPN's content API."""
        url = article_api_url(self.article["ref"])
        if not url:
            return Result(None, "no link to the story", False, 0.0)
        result = self.fetcher.get(("article", url), url, ttl=3600)
        if result.data is None and result.error and not result.loading:
            # a story that failed is asked for again a minute later, not an hour
            result = self.fetcher.get(("article", url), url, ttl=60)
        return result

    def article_step(self, step):
        """The next / previous headline, opened in the card in place."""
        art = self.article
        refs = self._news_refs if self._news_event == art.get("event") else []
        if not refs or art.get("index") is None:
            self.status_message = "Only this one - close the card to pick another."
            return
        index = (art["index"] + step) % len(refs)
        if art.get("event"):
            self.news_sel[art["event"]] = index
        self._news_follow = True
        self.open_article(refs[index], index)
        self.article["event"] = art.get("event")

    def draw_article(self, height, width):
        """The article card: the whole story, scrolled with j / k."""
        art = self.article
        box_width = clamp(width - 4, 40, 100)
        inner = box_width - 6
        result = self.article_data()
        stamp = (id(result.data), inner, result.loading, result.error,
                 bool(self.config.get("clip_video", False)))
        if art.get("_stamp") != stamp:
            art["_stamp"] = stamp
            art["_lines"] = article_lines(art["ref"], result.data, inner,
                                          loading=result.loading, error=result.error,
                                          video_window=stamp[-1])
            art["_video"] = article_video(result.data) if result.data else None
            art["_web"] = article_web_url(art["ref"], result.data)
        lines = art["_lines"]
        # as tall as the story, up to the whole screen; a short one is a card
        box_height = clamp(len(lines) + 4, min(14, height - 2), max(8, height - 4))
        top = (height - box_height) // 2
        left = (width - box_width) // 2
        view = box_height - 4
        art["_view"] = view
        art["scroll"] = clamp(art["scroll"], 0, max(0, len(lines) - view))
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        team = art["ref"].get("team_abbr") or ""
        title = f"{team} news" if team else "News"
        refs = self._news_refs if self._news_event == art.get("event") else []
        if refs and art.get("index") is not None:
            title += f" · {art['index'] + 1} of {len(refs)}"
        self.draw_box(top, left, box_height, box_width, title, "title")
        self.draw_lines(lines, top + 1, left + 3, view, inner, art["scroll"])
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(lines), art["scroll"])
        parts = ["j / k scroll", "space a page"]
        if art.get("_web"):
            parts.append("o espn.com")
        if art.get("_video"):
            parts.append("enter plays the video")
        if len(refs) > 1:
            parts.append("n / N next headline")
        parts.append("esc closes")
        hint = " · ".join(parts)
        if len(hint) > inner:
            hint = " · ".join(p for p in parts if p != "space a page")
        self.put(top + box_height - 2, left + 3, hint[:inner], self.palette("muted"))

    def handle_article_key(self, key):
        """Keys while the article card is open: j / k and the page keys
        scroll; o opens the page in the browser; enter plays the video;
        n / N go to the next / previous headline; esc or q closes."""
        art = self.article
        view = max(1, art.get("_view", 10) - 1)
        steps = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: view, ord(" "): view, ord("J"): view,
                 curses.KEY_PPAGE: -view, ord("K"): -view,
                 curses.KEY_HOME: -10 ** 6, ord("g"): -10 ** 6,
                 curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key == curses.KEY_RESIZE:
            self.apply_background()
        elif key in steps:
            art["scroll"] = max(0, art.get("scroll", 0) + steps[key])
        elif key in (ord("o"), ord("O")):
            web = art.get("_web") or article_web_url(art["ref"])
            if not web:
                self.status_message = "No page on espn.com for this one."
            elif open_in_browser(web):
                self.status_message = f"↗ Opening in your browser: {web}"
            else:
                self.status_message = f"⚠ No browser found to open {web}"
        elif key in (10, 13, curses.KEY_ENTER):
            video = art.get("_video")
            if video:
                title, url, _ = video
                self.play_clip({"title": title or clean(art["ref"].get("headline") or ""),
                                "url": url, "kind": "audio", "source": "ESPN"})
            else:
                self.article = None
        elif key in (ord("n"), ord("N")):
            self.article_step(1 if key == ord("n") else -1)
        elif key == ord("x") and self.player:
            self.stop_clip()
        elif key in (27, ord("q"), curses.KEY_BACKSPACE, 127, 8):
            self.article = None
        return True

