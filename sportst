class NetStats:
    """How every host's requests have gone this run, for the Settings tab."""

    def __init__(self):
        self.lock = threading.Lock()
        self.hosts = {}
        self.started = time.time()

    def record(self, host, ok, seconds, size=0, error=""):
        with self.lock:
            entry = self.hosts.setdefault(host, {"ok": 0, "fail": 0, "bytes": 0,
                                                 "ms": 0, "at": 0.0, "error": "",
                                                 "error_at": 0.0, "last_ok": None})
            entry["at"] = time.time()
            entry["ms"] = int(seconds * 1000)
            entry["last_ok"] = ok
            if ok:
                entry["ok"] += 1
                entry["bytes"] += size
            else:
                entry["fail"] += 1
                entry["error"] = error
                entry["error_at"] = entry["at"]

    def snapshot(self):
        with self.lock:
            return {host: dict(entry) for host, entry in self.hosts.items()}


NET = NetStats()


def net_read(request, timeout):
    """urlopen + read, with the outcome counted against the host."""
    host = urllib.parse.urlsplit(request.full_url).hostname or "?"
    start = time.time()
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
            headers = response.headers
    except urllib.error.HTTPError as exc:
        NET.record(host, False, time.time() - start, error=f"HTTP {exc.code}")
        raise
    except Exception as exc:  # noqa: BLE001 - counted, then passed on
        reason = getattr(exc, "reason", None) or exc
        NET.record(host, False, time.time() - start,
                   error=clean(f"{type(exc).__name__}: {reason}")[:60])
        raise
    NET.record(host, True, time.time() - start, len(raw))
    return raw, headers


def human_bytes(size):
    size = float(size or 0)
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} GB"


def home_path(path):
    """~/.config/... rather than the full home directory."""
    home = os.path.expanduser("~")
    path = os.path.abspath(path)
    return "~" + path[len(home):] if home and path.startswith(home + os.sep) else path


def cache_usage():
    """{entry name: bytes} for the cache folder's top level."""
    usage = {}
    try:
        names = os.listdir(CACHE_DIR)
    except OSError:
        return usage
    for name in names:
        path = os.path.join(CACHE_DIR, name)
        total = 0
        if os.path.isdir(path):
            for root, _, files in os.walk(path):
                for file_name in files:
                    try:
                        total += os.path.getsize(os.path.join(root, file_name))
                    except OSError:
                        pass
        else:
            try:
                total = os.path.getsize(path)
            except OSError:
                pass
        usage[name] = total
    return usage


def _uptime(seconds):
    seconds = int(seconds)
    if seconds < 3600:
        return f"{seconds // 60}m {seconds % 60:02d}s"
    if seconds < 86400:
        return f"{seconds // 3600}h {seconds % 3600 // 60:02d}m"
    return f"{seconds // 86400}d {seconds % 86400 // 3600}h"


def spec_choices(spec):
    choices = spec.get("choices") or []
    return choices() if callable(choices) else list(choices)


def setting_default(spec):
    if spec["key"] == "background":
        return scheme_background(CURRENT_SCHEME["name"])
    return DEFAULT_CONFIG.get(spec["key"])


def setting_text(spec, value):
    kind = spec["kind"]
    unit = spec.get("unit", "")
    if kind == "action":
        return ""
    if kind == "bool":
        return "on" if value else "off"
    if kind == "choice":
        for option, label in spec_choices(spec):
            if str(option) == str(value):
                return label
        return str(value) if value not in (None, "") else "-"
    if kind == "int":
        try:
            return f"{int(value)}{unit}"
        except (TypeError, ValueError):
            return str(value)
    if kind == "float":
        try:
            return f"{float(value):g}{unit}"
        except (TypeError, ValueError):
            return str(value)
    if kind == "books":
        names = value if isinstance(value, list) else []
        return ", ".join(BOOK_SHORT.get(n, n) for n in names) or "-"
    if kind == "color":
        for option, label in spec.get("choices") or []:
            if str(option).lower() == str(value).lower():
                return f"{value} {label}" if option.startswith("#") else label
        return str(value)
    return str(value)


def coerce_setting(spec, raw):
    """A typed value from what was typed, or ValueError with the reason."""
    kind = spec["kind"]
    text = str(raw).strip()
    if kind in ("int", "float"):
        try:
            value = float(text.rstrip("%").replace("−", "-"))
        except ValueError:
            raise ValueError(f"'{text}' is not a number") from None
        value = clamp(value, spec["min"], spec["max"])
        return int(round(value)) if kind == "int" else round(value, 2)
    if kind == "color":
        if text.lower() in spec.get("allow", ()):
            return text.lower()
        if not text.startswith("#"):
            text = "#" + text
        if not re.fullmatch(r"#[0-9A-Fa-f]{6}", text):
            raise ValueError("a colour is #RRGGBB" + (", or terminal"
                                                       if spec.get("allow") else ""))
        return text.upper()
    if kind == "books":
        known = {name.lower(): name for _, name, _ in BOOKS}
        known.update({short.lower(): name for _, name, short in BOOKS})
        picked = []
        for part in re.split(r"[,/]+", text):
            part = part.strip().lower()
            if not part:
                continue
            if part not in known:
                raise ValueError(f"no sportsbook called '{part}'")
            if known[part] not in picked:
                picked.append(known[part])
        if not picked:
            raise ValueError("name at least one sportsbook")
        return picked[:3]
    if kind == "choice":
        for option, label in spec_choices(spec):
            if text.lower() in (str(option).lower(), str(label).lower()):
                return option
        raise ValueError(f"'{text}' is not one of the choices")
    return text


def step_setting(spec, value, delta):
    """The value one step left (-1) or right (+1)."""
    kind = spec["kind"]
    if kind == "bool":
        return not value
    if kind in ("int", "float"):
        try:
            current = float(value)
        except (TypeError, ValueError):
            current = float(setting_default(spec) or 0)
        result = clamp(current + delta * spec["step"], spec["min"], spec["max"])
        return int(round(result)) if kind == "int" else round(result, 2)
    if kind in ("choice", "color"):
        options = [o for o, _ in (spec_choices(spec) if kind == "choice"
                                  else spec.get("choices") or [])]
        if not options:
            return value
        lowered = [str(o).lower() for o in options]
        index = lowered.index(str(value).lower()) if str(value).lower() in lowered else -1
        return options[(index + delta) % len(options)]
    return value


def render_setting_rows(app, width):
    """(lines, line index of the cursor) for the left pane's settings list."""
    lines = []
    cursor_line = 0
    label_width = clamp(max(len(s["label"]) for s in SETTING_ROWS) + 1, 16, 30)
    index = 0
    for group, specs in SETTING_GROUPS:
        if lines:
            lines.append(blank())
        lines.append(Line().add(f" {group}", "header"))
        for spec in specs:
            chosen = index == app.settings_cursor
            if chosen:
                cursor_line = len(lines)
            base = "sel" if chosen else "normal"
            line = Line().add("▌" if chosen else " ", "selbar" if chosen else "normal")
            line.add(f" {spec['label']:<{label_width}}", base)
            tag, tag_style = "", "muted"
            if spec["kind"] == "action":
                line.add("enter", "seldim" if chosen else "muted")
            else:
                value = app.setting_value(spec)
                text = setting_text(spec, value)
                room = max(4, width - label_width - 14)
                if len(text) > room:
                    text = text[:room - 1] + "…"
                changed = value != setting_default(spec)
                style = "sel" if chosen else ("accent" if changed else "normal")
                if spec["kind"] == "bool":
                    style = ("sel" if chosen else "good") if value else \
                        ("seldim" if chosen else "muted")
                line.add(text, style)
                rgb = hex_to_rgb(str(value)) if spec["kind"] == "color" else None
                if rgb and sum(rgb) > 40:
                    line.add(" ", base).add("██", str(value).upper())
                if app.setting_unsaved(spec):
                    tag, tag_style = "this run", "warn"
                elif spec.get("apply") == "start":
                    tag = "next start"
                elif changed:
                    tag, tag_style = "changed", "accent"
            used = sum(len(t) for t, _ in line)
            if tag and used + len(tag) + 2 <= width:
                line.add(" " * (width - used - len(tag) - 1), base)
                line.add(tag, "seldim" if chosen else tag_style)
            line.pad(width, base if chosen else "normal")
            lines.append(line)
            index += 1
    return lines, cursor_line


