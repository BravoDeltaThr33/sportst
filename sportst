def card_hand(hand):
    """('SHOOTS', 'left') from a card's 'shoots left', 'catches L' or 'bats /
    throws R/R'; ('', '') when it has none."""
    hand = clean(hand or "").strip()
    for prefix, label in (("bats / throws ", "B/T"), ("shoots ", "SHOOTS"),
                          ("catches ", "CATCHES")):
        if hand.lower().startswith(prefix):
            return label, hand[len(prefix):]
    return ("HAND", hand) if hand else ("", "")


def roster_pairs(card, player, league):
    """Who he is, as (label, value, style) for the roster card: size, age,
    where he is from, his college, his hand, the draft, his years (his class,
    in college) and a status other than active."""
    card = card or {}
    pick = lambda key: card.get(key) or player.get(key) or ""   # noqa: E731
    pairs = []
    size = ", ".join(part for part in (pick("height"), pick("weight")) if part)
    if size:
        pairs.append(("HT/WT", size, "normal"))
    age = card.get("age") if card.get("age") is not None else player.get("age")
    if age is not None:
        pairs.append(("AGE", f"{age}" + (f" ({card['born']})" if card.get("born") else ""),
                      "normal"))
    elif card.get("born"):
        pairs.append(("BORN", card["born"], "normal"))
    if pick("birthplace"):
        pairs.append(("FROM", pick("birthplace"), "normal"))
    if pick("college"):
        pairs.append(("COLLEGE", pick("college"), "normal"))
    label, value = card_hand(pick("hand"))
    if value:
        pairs.append((label, value, "normal"))
    if pick("experience"):
        pairs.append(("CLASS" if league in COLLEGE_LEAGUES else "EXP", pick("experience"),
                      "normal"))
    if card.get("draft"):
        pairs.append(("DRAFT", card["draft"], "normal"))
    status = player.get("injury") or (card.get("status") if card.get("status") not in
                                      ("", "Active") else "")
    if status:
        pairs.append(("STATUS", status.upper(), "warn"))
    return pairs


def pair_grid(pairs, width):
    """(label, value, style) pairs as Lines: two to a row where both fit in
    half the width (in order), a long one on a row of its own after them."""
    if not pairs or width <= 0:
        return []
    label_w = min(9, max(len(label) for label, _, _ in pairs) + 1)
    half = (width - 2) // 2
    short = [pair for pair in pairs if width >= 40 and label_w + len(pair[1]) <= half]
    long_ = [pair for pair in pairs if pair not in short]
    lines = []
    for index in range(0, len(short), 2):
        first = short[index]
        line = Line().add(f"{first[0]:<{label_w}}", "muted")
        if index + 1 < len(short):
            other = short[index + 1]
            line.add(f"{first[1]:<{half - label_w}}", first[2]).add("  ", "normal")
            line.add(f"{other[0]:<{label_w}}", "muted").add(other[1], other[2])
        else:
            line.add(first[1], first[2])
        lines.append(line)
    for label, value, style in long_:
        lines.append(Line().add(f"{label:<{label_w}}", "muted")
                     .add(cut_text(value, width - label_w), style))
    return lines


def pair_grid_width(pairs):
    """How wide pair_grid would like to be: two short pairs a row, a long
    one whole."""
    if not pairs:
        return 0
    label_w = min(9, max(len(label) for label, _, _ in pairs) + 1)
    values = sorted(len(value) for _, value, _ in pairs)
    short = [n for n in values if n <= 22] or values[:1]
    return max(2 * (label_w + max(short)) + 2, label_w + values[-1])


def number_table(groups, labels, rows, width, label_w, cut=False, first_bold=True):
    """A table of numbers within `width`: each row's label (a Line) down the
    left, the columns under their group's name (PASSING, RUSHING ...) when
    there are groups. A group that does not fit beside the others goes under
    them, one too wide on its own is split - or, with `cut`, whatever does not
    fit in one band is left out. rows: [(label Line, [values])].
    (lines, the width it would like)."""
    count = len(labels)
    widths = []
    for index, label in enumerate(labels):
        cells = [values[index] if index < len(values) else "" for _, values in rows]
        widths.append(max([len(label)] + [len(cell) for cell in cells]) + 1)
    parts = [(name, list(range(start, min(count, start + size))))
             for name, start, size in groups or [] if size > 0 and start < count]
    if sum(len(cols) for _, cols in parts) != count:
        parts = [("", list(range(count)))]
    named = any(name for name, _ in parts)
    for name, cols in parts:
        short = len(name) + 1 - sum(widths[index] for index in cols)
        if named and cols and short > 0:
            widths[cols[0]] += short          # room for the group's name over it
    natural = label_w + sum(widths) + 2 * (len(parts) - 1)
    room = max(1, width - label_w)
    bands, band, used = [], [], 0
    for name, cols in parts:
        need = sum(widths[index] for index in cols)
        if band and used + 2 + need <= room:
            band.append((name, cols))
            used += 2 + need
            continue
        if band:
            bands.append(band)
            band, used = [], 0
        if need <= room:
            band, used = [(name, cols)], need
            continue
        chunk, chunk_w = [], 0
        for index in cols:
            if chunk and chunk_w + widths[index] > room:
                bands.append([(name, chunk)])
                chunk, chunk_w = [], 0
            chunk.append(index)
            chunk_w += widths[index]
        band, used = [(name, chunk)], chunk_w
    if band:
        bands.append(band)
    if cut:
        bands = bands[:1]
    lines = []
    for band in bands:
        if named:
            line = Line().add(" " * label_w, "normal")
            for number, (name, cols) in enumerate(band):
                span = sum(widths[index] for index in cols)
                if number:
                    line.add("  ", "normal")
                line.add(f"{(' ' + name.upper())[:span]:<{span}}", "title")
            lines.append(line)
        line = Line().add(" " * label_w, "normal")
        for number, (_, cols) in enumerate(band):
            if number:
                line.add("  ", "normal")
            for index in cols:
                line.add(f"{labels[index]:>{widths[index]}}", "header")
        lines.append(line)
        for row_number, (label, values) in enumerate(rows):
            line = Line()
            used_w = 0
            for text, style in label:
                piece = text[:max(0, label_w - 1 - used_w)]
                if piece:
                    line.append((piece, style))
                    used_w += len(piece)
            line.pad(label_w)
            style = "bold" if first_bold and row_number == 0 else "normal"
            for number, (_, cols) in enumerate(band):
                if number:
                    line.add("  ", "normal")
                for index in cols:
                    value = values[index] if index < len(values) else ""
                    line.add(f"{value:>{widths[index]}}", style)
            lines.append(line)
    return lines, natural


def flow_items(items, width, separator=" · "):
    """[(text, style)] items run together in lines of `width`, an item never
    split unless it is longer than a line."""
    lines, line, used = [], Line(), 0
    for text, style in items:
        text = cut_text(text, width)
        gap = len(separator) if used else 0
        if used and used + gap + len(text) > width:
            lines.append(line)
            line, used, gap = Line(), 0, 0
        if gap:
            line.add(separator, "muted")
        line.add(text, style)
        used += gap + len(text)
    if used:
        lines.append(line)
    return lines


def list_cap(lines, most, width):
    """At most `most` lines, the last one saying there is more."""
    if most is None or len(lines) <= most:
        return lines
    return lines[:max(0, most - 1)] + [Line().add(cut_text("… more on the player's page (W)",
                                                           width),
                                                  "dim")]


def award_lines(awards, width, compact=False, most=None):
    """His awards: one a line with how many times and the seasons (wrapped
    under it), or, compact, their names and times run together."""
    if compact:
        lines = flow_items([(name + (f" {count}" if count and count != "1x" else ""), "bold")
                            for name, count, _ in awards], width)
        return list_cap(lines, most, width)
    lines = []
    for name, count, seasons in awards:
        line = Line().add(cut_text(name, width), "bold")
        if count and count != "1x" and len(line.text) + 2 + len(count) <= width:
            line.add(f"  {count}", "accent")
        if seasons and len(line.text) + 2 + len(seasons) <= width:
            lines.append(line.add(f"  {seasons}", "dim"))
            continue
        lines.append(line)
        if seasons:
            lines.extend(wrap_spans(seasons, width, "dim", indent="  "))
    return list_cap(lines, most, width)


def team_lines(teams, width, compact=False, most=None):
    """The teams he has played for and when: one a line, or run together."""
    if compact:
        return list_cap(flow_items([(f"{name} {seasons}".strip(), "normal")
                                    for name, seasons in teams], width), most, width)
    lines = []
    for name, seasons in teams:
        line = Line().add(cut_text(name, width), "normal")
        if seasons and len(line.text) + 2 + len(seasons) <= width:
            line.add(f"  {seasons}", "dim")
        lines.append(line)
    return list_cap(lines, most, width)


