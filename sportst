def post_check(app, index):
    """The POST screen's check `index` (of CRT_POST_LINES): (what, the
    finding, its verdict - "OK", "NONE" or "WARN" - and, for a figure that
    counts up while it is checked, that figure; the finding has {n} where it
    goes)."""
    try:
        return _post_check(app, index)
    except Exception as exc:  # noqa: BLE001 - the self test must never cost the app
        return ("Check", f"{type(exc).__name__}", "WARN", None)


def _post_check(app, index):
    kind = terminal_kind()
    if index == 0:
        return ("CPU", f"{platform.machine() or 'processor'} · {os.cpu_count() or 1} cores · "
                       f"Python {platform.python_version()}", "OK", None)
    if index == 1:
        try:
            import resource
            used = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
            kilobytes = used // 1024 if sys.platform == "darwin" else used
        except (ImportError, AttributeError, OSError, ValueError):
            return ("Memory", "not measured here", "OK", None)
        return ("Memory", "{n} K in use", "OK", int(kilobytes))
    if index == 2:
        height, width = app.term.getmaxyx()
        depth = getattr(app.palette, "depth", 0) or 0
        colours = "24-bit colour" if depth >= 1 << 24 else f"{depth} colours"
        return ("Display", f"{width} × {height} cells · {os.environ.get('TERM', '?')} · "
                           f"{colours}", "OK", None)
    if index == 3:
        if app.crt.glass:
            name = TERMINAL.get("name") or kind or "this terminal"
            framed = " · a bezel" if any(app.stdscr.margin) else ""
            return ("Glass", f"pictures in {name}{framed}", "OK", None)
        return ("Glass", "none: this terminal shows no pictures", "NONE", None)
    if index == 4:
        return ("Phosphor", CRT_PHOSPHORS[app.crt.phosphor][0], "OK", None)
    if index == 5:
        current, path = terminal_font(kind)
        pick = crt_font_key(app.config.get("crt_font"))
        if current:
            return ("Font", f"{current} (from {os.path.basename(path)})", "OK", None)
        if pick == "own":
            return ("Font", "the terminal's own", "OK", None)
        word = crt_font_word(pick, kind)
        return ("Font", f"{CRT_FONT_INFO[pick][0]} · {word}",
                "WARN" if word == "not installed" else "OK", None)
    if index == 6:
        path = app.args.config
        there = os.path.isfile(path)
        return ("Config", f"{home_path(path)}" + ("" if there else " · not written yet"),
                "OK", None)
    if index == 7:
        usage = app.cache_usage()
        if not usage:
            return ("Cache", "empty", "OK", None)
        return ("Cache", f"{len(usage)} entries · {human_bytes(sum(usage.values()))}",
                "OK", None)
    if index == 8:
        name = LEAGUES[app.league]["name"]
        return ("Leagues", f"{len(LEAGUES)} leagues and sports · {name} first", "OK", None)
    fetcher = app.fetcher
    failed = fetcher.last_error
    return ("Network", f"{fetcher.requests_made} requests · {fetcher.busy()} in flight" +
            (" · one failed" if failed else ""), "WARN" if failed else "OK", None)


class InsetScreen:
    """The terminal's window as the app draws on it: inside a margin of
    cells (CRT mode's bezel takes the outer ring), its size and every row
    and column moved to match. Everything else goes to the window itself."""

    def __init__(self, win):
        self.win = win
        self.margin = (0, 0, 0, 0)          # top, left, bottom, right

    def getmaxyx(self):
        height, width = self.win.getmaxyx()
        top, left, bottom, right = self.margin
        return max(1, height - top - bottom), max(1, width - left - right)

    def addstr(self, y, x, *args):
        return self.win.addstr(y + self.margin[0], x + self.margin[1], *args)

    def move(self, y, x):
        return self.win.move(y + self.margin[0], x + self.margin[1])

    def __getattr__(self, name):
        return getattr(self.win, name)


