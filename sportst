        primary, spare = api_news(self.api.espn, self.league)
        return self.fetcher.get(("kimnews", self.league), primary, ttl=600, fallbacks=spare)

    def kim_slates(self):
        """([(scoreboard data, Action Network Result or None)], label, waiting)
        for the week Kim looks at: football's current week, or today and the
        six days after."""
        league = self.league
        meta = LEAGUES[league]
        group = self.cfb_group if league == "cfb" else ""
        groups = self.cfb_group if league == "cfb" else meta.get("groups")
        sources = self.config.get("betting_sources", True) and league in AN_LEAGUES
        slates, waiting = [], 0
        if meta["week_based"]:
            url, spare = self.api.scoreboard(league, groups=groups)
            board_data = self.fetcher.get(("kimsb", league, group), url, ttl=600,
                                          fallbacks=spare)
            if board_data.data is None:
                return [], "this week", (1 if board_data.loading else 0)
            data = board_data.data
            week = dig(data, "week", "number")
            season, stype = dig(data, "season", "year"), dig(data, "season", "type")
            board = None
            if sources:
                board = self.fetcher.get(("an", league, "w", week, stype, season),
                                         Loader("api.actionnetwork.com", an_board, league,
                                                week=week, season=season, seasontype=stype),
                                         ttl=300)
                waiting += 1 if board.loading and board.data is None else 0
            slates.append((data, board))
            return slates, (f"Week {week}" if week else "this week"), waiting
        today = Date.today()
        label = f"{today:%b %-d} – {today + timedelta(days=KIM_DAYS - 1):%b %-d}"
        for offset in range(KIM_DAYS):
            day = today + timedelta(days=offset)
            url, spare = self.api.scoreboard(league, day=day, groups=groups)
            result = self.fetcher.get(("sb", league, "d", day.isoformat(), group), url,
                                      ttl=600, fallbacks=spare)
            if result.data is None:
                waiting += 1 if result.loading else 0
                continue
            board = None
            if sources:
                board = self.fetcher.get(("an", league, "d", day.isoformat()),
                                         Loader("api.actionnetwork.com", an_board, league,
                                                day=day), ttl=300)
                waiting += 1 if board.loading and board.data is None else 0
            slates.append((result.data, board))
        return slates, label, waiting

    def kim_gather(self):
        """Ask for everything Kim reads (the fetcher loads it in the
        background). Returns (gathered, files read, files wanted, still
        waiting); gathered is what kim_result() takes."""
        league = self.league
        slates, label, waiting = self.kim_slates()
        stamp = tuple((id(data), board.stamp if board else None) for data, board in slates)
        kim = self.kim
        if kim.get("games") is None or kim.get("games_stamp") != stamp:
            games, seen = [], set()
            for data, board in slates:
                events = parse_scoreboard(data)
                attach_lines(events, league, self.book)
                for event in events:
                    if event["state"] != "pre" or event["id"] in seen:
                        continue
                    seen.add(event["id"])
                    game = match_an_game(event, board.data) if board and board.data else None
                    if game or event.get("line") or event.get("line_raw"):
                        games.append((event, game))
            games.sort(key=lambda g: g[0].get("date") or "")
            kim["games"], kim["games_stamp"] = games[:KIM_GAMES], stamp
        extras = [self.load_kalshi(), self.load_team_table(), self.kim_news()] \
            if kim["games"] else [None, None, None]
        waiting += sum(1 for r in extras if r is not None and r.loading and r.data is None)
        markets, table, news = (r.data if r is not None else None for r in extras)
        out, read = [], 0
        for event, game in kim["games"]:
            url, spare = self.api.summary(league, event["id"])
            result = self.fetcher.get(("sum", league, event["id"]), url, ttl=600,
                                      fallbacks=spare)
            if result.data is None and result.loading:
                waiting += 1
            else:
                read += 1
            out.append((event, game, result.data))
        gathered = {"games": out, "markets": markets, "table": table, "news": news,
                    "label": label, "missing": sum(1 for _, _, s in out if s is None)}
        return gathered, read, len(out), waiting

    def kim_think(self):
        """Gather; once everything is in (or Kim has waited long enough),
        choose the picks."""
        kim = self.kim
        gathered, read, total, waiting = self.kim_gather()
        now = time.time()
        if waiting and now - kim["opened"] < KIM_WAIT:
            return read, total
        for _, _, summary in gathered["games"]:
            if summary:
                prepare_summary(summary, self.league)
        try:
            kim["result"] = kim_result(self.league, gathered, self.bet_book, self.top_books(),
                                       self.min_edge())
        except Exception as exc:  # noqa: BLE001 - Kim says so instead of crashing
            kim["result"] = {"error": f"{type(exc).__name__}: {exc}"}
        kim["talk"] = now
        return read, total

    def kim_lines(self, width):
        """What is in the bubble right now, and whether he is talking."""
        kim = self.kim
        result = kim.get("result")
        name = LEAGUE_SHORT.get(family(self.league), self.league.upper())
        if result is None:
            dots = "." * (1 + int(time.time() * 2) % 3)
            return [Line().add(f"KIM'S PICKS · {name}".upper(), "head"), blank(),
                    Line().add(f"Kim is thinking{dots}", "text")]
        if result.get("error"):
            return [Line().add(f"KIM'S PICKS · {name}".upper(), "head"), blank(),
                    Line().add("Kim is not ready to speak. Ask again (R).", "text"),
                    Line().add(result["error"][: max(10, width)], "dim")]
        cached = kim.get("speech")
        if cached and cached[0] == width:
            return cached[1]
        lines = kim_speech(result, self.league, width)
        kim["speech"] = (width, lines)
        return lines

    def draw_kim(self, height, width):
        try:
            self._draw_kim(height, width)
        except curses.error:
            pass
        except Exception as exc:  # noqa: BLE001 - a TUI must not die over a pop-up
            self.close_kim()
            self.status_message = f"⚠ Ask Kim stopped: {type(exc).__name__}: {exc}"

    def _draw_kim(self, height, width):
        kim = self.kim
        now = time.time()
        if kim.get("result") is None:
            kim["progress"] = self.kim_think()
        size = kim_size(height - 2, width - 2) if self.palette.enabled else None
        art_rows = len(KIM_ART[size]["open"]) // 2 if size else 0
        art_cols = len(KIM_ART[size]["open"][0]) if size else 0
        room = width - 4 - (art_cols + 3 if size else 0)
        bubble_w = clamp(room, 30, KIM_BUBBLE_MAX)
        box_w = min(width - 2, bubble_w + 4 + (art_cols + 3 if size else 0))
        box_h = clamp(max(art_rows + 3, 16), 8, height - 2)
        top = max(0, (height - 1 - box_h) // 2)
        left = max(0, (width - box_w) // 2)
        for row in range(box_h):
            self.put(top + row, left, " " * box_w, self.palette("normal"))
        self.draw_box(top, left, box_h, box_w, "★ ASK KIM ★", "title")
        result = kim.get("result")
        speech = self.kim_lines(bubble_w - 4)
        reveal = None
        talking = False
        if result is not None and not kim["done"]:
            reveal = int((now - (kim["talk"] or now)) * KIM_CPS)
            if reveal >= sum(len(line.text) for line in speech):
                kim["done"] = True
                reveal = None
            else:
                talking = True
        if talking:
            frame = KIM_TALK[int((now - kim["talk"]) / 0.12) % len(KIM_TALK)]
        elif result is None:
            frame = "mid" if int(now * 2.5) % 6 == 0 else "closed"
        else:
            frame = "open"
        bubble_x = left + 2 + (art_cols + 3 if size else 0)
        bubble_y = top + 1
        bubble_h = box_h - 3
        tail = None
        if size:
            art_y = top + 1 + max(0, (box_h - 3 - art_rows) // 2)
            picture = None
            if self.graphics.enabled:
                # all three mouths stay with the terminal while he talks
                mouths = {name: self.kim_picture(name, art_cols, art_rows)
                          for name in ("open", "mid", "closed")}
                picture = mouths.get(frame)
            if picture:
                art = image_cells(picture, art_cols, art_rows)
            else:
                self.palette.logo_begin(("kim", size))
                art = kim_art_lines(size, frame)
            for offset, line in enumerate(art):
                self.put_spans(art_y + offset, left + 2, line)
            tail = art_y + kim_mouth_row(size) - bubble_y
            if not 1 <= tail <= bubble_h - 2:
                tail = None
        view = bubble_h - 2
        if reveal is not None:
            # the bubble scrolls along as he talks, like an NES text box
            left_over, at = reveal, len(speech) - 1
            for index, line in enumerate(speech):
                if left_over <= len(line.text):
                    at = index
                    break
                left_over -= len(line.text)
            if at >= kim["scroll"] + view:
                kim["scroll"] = at - view + 1
        kim["scroll"] = clamp(kim["scroll"], 0, max(0, len(speech) - view))
        bubble = kim_bubble(speech, bubble_w, bubble_h, kim["scroll"], reveal, tail)
        for offset, line in enumerate(bubble):
            x = bubble_x
            for text, style in line:
                self.put(bubble_y + offset, x, text, self.palette(style))
                x += len(text)
        if tail is not None:
            self.put(bubble_y + tail, bubble_x - 2, "◀▬", self.palette(KIM_BUBBLE["tail"]))
        hint = ("enter skips · " if talking else "") + "R asks again · j/k scrolls · " \
               "esc closes"
        self.put(top + box_h - 2, left + 2, hint[: box_w - 4], self.palette("muted"))
        if talking or result is None:
            self.dirty = True           # keep the mouth and the dots moving

    def handle_kim_key(self, key):
        kim = self.kim
        if key == curses.KEY_RESIZE:
            self.apply_background()
            kim["backdrop"] = None
        elif key in (27, ord("q"), ord("$")):
            self.close_kim()
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            if kim.get("result") is not None and not kim["done"]:
                kim["done"] = True
            elif kim.get("result") is not None:
                self.close_kim()
        elif key == ord("r"):
            self.fetcher.expire(lambda k: isinstance(k, tuple) and k and
                                k[0] in ("kimsb", "kimnews", "an", "kalshi", "sum"))
            self.kim.update({"opened": time.time(), "result": None, "talk": None,
                             "done": False, "scroll": 0, "games": None, "speech": None})
            self.status_message = "Kim is reading again."
        elif key in (ord("j"), curses.KEY_DOWN):
            kim["scroll"] += 1
        elif key in (ord("k"), curses.KEY_UP):
            kim["scroll"] = max(0, kim["scroll"] - 1)
        elif key == curses.KEY_NPAGE:
            kim["scroll"] += 10
        elif key == curses.KEY_PPAGE:
            kim["scroll"] = max(0, kim["scroll"] - 10)
        elif key == curses.KEY_HOME:
            kim["scroll"] = 0
        elif key in (curses.KEY_END, ord("G")):
            kim["scroll"] = 10 ** 6
        return True

    def handle_favorites_key(self, key):
        """Return True when the Favorites screen has taken the key for itself."""
        rows = self.fav_rows
        if key in (ord("j"), curses.KEY_DOWN):
            self.fav_cursor = clamp(self.fav_cursor + 1, 0, max(0, len(rows) - 1))
        elif key in (ord("k"), curses.KEY_UP):
            self.fav_cursor = clamp(self.fav_cursor - 1, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_NPAGE:
            self.fav_cursor = clamp(self.fav_cursor + 12, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_PPAGE:
            self.fav_cursor = clamp(self.fav_cursor - 12, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_HOME:
            self.fav_cursor = 0
        elif key in (curses.KEY_END, ord("G")):
            self.fav_cursor = max(0, len(rows) - 1)
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            if rows:
                team = rows[clamp(self.fav_cursor, 0, len(rows) - 1)]
                self.toggle_favorite(team)
                if team:
                    self._fav_follow = str(team.get("id"))
                    self._last_pick = None       # the next click picks afresh
        elif key == ord("/"):
            text = self.prompt("search teams: ", self.fav_filter)
            if text is not None:
                self.fav_filter = text.strip()
                self.fav_cursor = 0
                self.scroll["Favorites"] = 0
        elif key == ord("x"):
            self.fav_filter = ""
            self.fav_cursor = 0
            self.scroll["Favorites"] = 0
        else:
            return False
        return True

    def fold_key(self, key):
        """A capital letter with no command of its own acts as its small
        letter (CASE_FREE_KEYS), so U and u both jump to an upset. R stays R
        on the Settings tab, where it resets a setting."""
        if not 65 <= key <= 90 or chr(key) not in CASE_FREE_KEYS:
            return key
        if key == ord("R") and self.tab_name == "Settings" and not (
                self.show_help or self.show_info or self.calendar or self.popup
                or getattr(self, "kim", None) or getattr(self, "center", None)):
            return key
        return key + 32

    def handle_key(self, key):
        if key == -1:
            return True
        if key == curses.KEY_MOUSE:
            return self.handle_mouse()
        self._mouse_pick = False      # the keyboard again: lists follow the cursor
        self.pending_center = None    # a key changes the plan
        if key == 12:                 # ctrl-l repaints a garbled terminal, whatever is open
            self.stdscr.clearok(True)
            self.dirty = True
            return True
        key = self.fold_key(key)
        self.dirty = True
        self.status_message = ""
        if key == curses.KEY_RESIZE and self.graphics.enabled:
            self.cell = cell_pixels()     # a new font size changes a cell's shape

        if self.show_help:
            steps = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                     curses.KEY_NPAGE: 10, ord(" "): 10, curses.KEY_PPAGE: -10,
                     curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6,
                     ord("J"): 10, ord("K"): -10}
            if key == curses.KEY_RESIZE:
                self.apply_background()
            elif key in steps and not getattr(self, "_help_fits", False):
                self.help_scroll = max(0, self.help_scroll + steps[key])
            else:
                self.show_help = False
            return True
        if self.show_info:
            steps = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                     curses.KEY_NPAGE: 10, ord(" "): 10, curses.KEY_PPAGE: -10,
                     curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6,
                     ord("J"): 10, ord("K"): -10}
            if key == curses.KEY_RESIZE:
                self.apply_background()
            elif key in steps and not getattr(self, "_info_fits", False):
                self.info_scroll = max(0, self.info_scroll + steps[key])
            else:
                self.show_info = False
            return True
        if self.article:
            if key in (ord("?"), ord("i")):
                self.show_help, self.help_scroll = key == ord("?"), 0
                self.show_info, self.info_scroll = key == ord("i"), 0
                self._help_fits = self._info_fits = False
                return True
            return self.handle_article_key(key)
        if self.center:
            return self.handle_center_key(key)
        if self.kim:
            return self.handle_kim_key(key)
        if self.calendar:
            return self.handle_calendar_key(key)
        if self.popup:
            if key == curses.KEY_RESIZE:
                self.apply_background()
                return True
            return self.handle_popup_key(key)

        if key in (ord("q"), ord("Q")):
            return False
        if key == curses.KEY_RESIZE:
            self.apply_background()
            return True
        if key == 12:  # ctrl-l, repaint a garbled terminal
            self.stdscr.clearok(True)
            return True
        if self.tab_name == "Favorites" and self.handle_favorites_key(key):
            return True
        if self.tab_name == "Betting" and self.handle_betting_key(key):
            return True
        if self.tab_name == "Standings" and self.handle_standings_key(key):
            return True
        if self.tab_name == "Stats" and self.handle_stats_key(key):
            return True
        if self.tab_name == "Settings" and self.handle_settings_key(key):
            return True
        if self.tab_name == "Overview" and self.handle_overview_key(key):
            return True
        if self.tab_name == "Plays" and self.handle_plays_key(key):
            return True
        if self.tab_name == "Scouting" and self.handle_scouting_key(key):
            return True
        if key == ord("x") and self.player and self.tab_name != "Favorites":
            self.stop_clip()
            return True
        tabs = self.tabs
        olympic = is_olympic(self.league)
        if key == ord("?"):
            self.show_help = True
            self.help_scroll = 0
            self._help_fits = False
        elif key == ord("i"):
            self.show_info = True
            self.info_scroll = 0
            self._info_fits = False
        elif key == ord("p"):
            self.open_league_picker()
        elif key == ord("e"):
            self.open_event_picker()
        elif ord("0") <= key <= ord("9"):
            # 1 … 9 are the tabs after Overview, in order; 0 is always Favorites
            if key == ord("0"):
                self.tab = tabs.index("Favorites")
            elif key - ord("0") < len(tabs) and tabs[key - ord("0")] != "Settings":
                self.tab = key - ord("0")
        elif key == ord("O"):
            self.tab = tabs.index("Settings")
        elif key == ord("C"):
            self.open_calendar()
        elif key == ord("H"):
            self.tab = tabs.index("Overview")
        elif key == 9:
            self.tab = (self.tab + 1) % len(tabs)
        elif key in (curses.KEY_BTAB, 353):
            self.tab = (self.tab - 1) % len(tabs)
        elif key in (10, 13, curses.KEY_ENTER):
            event = self.current_event()
            if event and self.on_board:
                target = tabs[self.tab + 1]
                if "Scouting" in tabs:
                    target = "Scouting" if event["state"] == "pre" else "Boxscore"
                self.tab = tabs.index(target)
                self.scroll[target] = 0
                self.detail_scroll = 0
        elif key == ord("J"):
            self.detail_scroll += 1 if self.on_board else 0
            if not self.on_board:
                self.scroll_active(1, page=True)
        elif key == ord("K"):
            if self.on_board:
                self.detail_scroll = max(0, self.detail_scroll - 1)
            else:
                self.scroll_active(-1, page=True)
        elif key in (ord("j"), curses.KEY_DOWN):
            if self.on_board:
                self.move_selection(1)
            else:
                self.scroll_active(1)
        elif key in (ord("k"), curses.KEY_UP):
            if self.on_board:
                self.move_selection(-1)
            else:
                self.scroll_active(-1)
        elif key == curses.KEY_NPAGE:
            if self.on_board:
                self.move_selection(10)
            else:
                self.scroll_active(1, page=True)
        elif key == curses.KEY_PPAGE:
            if self.on_board:
                self.move_selection(-10)
            else:
                self.scroll_active(-1, page=True)
        elif key == curses.KEY_HOME:
            if self.on_board:
                self.move_selection(-10**6)
            else:
                self.scroll[self.tab_name] = 0
        elif key in (curses.KEY_END, ord("G")):
            if self.on_board:
                self.move_selection(10**6)
            else:
                self.scroll[self.tab_name] = 10**6
        elif key in (ord("h"), curses.KEY_LEFT, ord("[")):
            if olympic:
                self.shift_games(-1)
            else:
                self.shift_period(-1)
        elif key in (ord("l"), curses.KEY_RIGHT, ord("]")):
            if olympic:
                self.shift_games(1)
            else:
                self.shift_period(1)
        elif key == ord("t"):
            if olympic:
                self.switch_league(olympic_default(family(self.league),
                                                   LEAGUES[self.league]["slug"]))
            else:
                self.goto_today()
        elif key == ord("d"):
            if olympic:
                self.status_message = "An Olympic sport shows its whole schedule at once."
            else:
                text = self.prompt("date: ")
                if text is not None:
                    parsed = self.parse_date_input(text)
                    if parsed:
                        self.day = parsed
                        self.week_mode = False
                        self.selected_id = None
                        self.selected_index = 0
                    else:
                        self.status_message = "Could not read that date."
        elif key == ord("w"):
            if LEAGUES[self.league]["week_based"]:
                self.week_mode = not self.week_mode
                self.week_pinned = False
                self.selected_id = None
                self.selected_index = 0
            elif olympic:
                self.status_message = "An Olympic sport shows its whole schedule at once."
            else:
                self.status_message = f"The {LEAGUE_SHORT.get(family(self.league))} " \
                                      "scoreboard is day by day."
        elif key == ord("L"):
            self.cycle_league(1)
        elif key == ord("/"):
            text = self.prompt("find team (empty clears): ", self.filter_text)
            if text is not None:
                self.filter_text = text.strip()
                self.selected_id = None
                self.selected_index = 0
                self.stats_sel[self.league] = 0
                self.bet_index = 0
                for key_name in ("Scoreboard", "Stats", "Standings", "Betting", "BettingList"):
                    self.scroll[key_name] = 0
                self.status_message = (f"Showing teams matching '{self.filter_text}'."
                                       if self.filter_text else "Search cleared.")
        elif key == ord("f"):
            self.toggle_top25()
        elif key == ord("c"):
            self.open_group_picker()
        elif key == ord("g"):
            self.cycle_stats_view(1)
        elif key == ord("s"):
            self.open_sort_picker()
        elif key == ord("S"):
            self.step_sort(1)
        elif key in (ord(","), ord(".")) and is_baseball(self.league):
            at_bats = self.at_bat_count()
            if at_bats:
                current = self.at_bat if self.at_bat is not None else at_bats - 1
                step = -1 if key == ord(",") else 1
                self.at_bat = clamp(current + step, 0, at_bats - 1)
                self.at_bat_for = (self.current_event() or {}).get("id")
                if self.at_bat == at_bats - 1:
                    self.at_bat = None
        elif key == ord("v") and sport_of(self.league) == "basketball":
            order = ["both", "away", "home"]
            self.shot_view = order[(order.index(self.shot_view) + 1) % 3]
            event = self.current_event()
            if event:
                who = {"both": "both teams", "away": event["away"]["abbr"],
                       "home": event["home"]["abbr"]}[self.shot_view]
                self.status_message = f"Shot chart: {who}."
        elif key == ord("u"):
            self.jump_to_upset()
        elif key == ord("$"):
            self.open_kim()
        elif key == ord("z"):
            self.open_center()
        elif key == ord("o"):
            BETTING.columns = not BETTING.columns
            where = "" if self.on_board else " on the Scoreboard"
            self.status_message = (f"Line columns shown{where}." if BETTING.columns else
                                   f"Line columns hidden{where} - o shows them.")
        elif key == ord("r"):
            self.fetcher.expire()
            self.status_message = "Refreshing."
        elif key == ord("a"):
            self.auto_refresh = not self.auto_refresh
            self.fetcher.frozen = not self.auto_refresh
            self.status_message = (f"Auto-refresh on: every {self.interval} s, live games "
                                   "twice as often." if self.auto_refresh else
                                   "Auto-refresh off: nothing reloads until R.")
        elif key in (ord("+"), ord("=")):
            self.interval = clamp(self.interval + 5, 5, 600)
            self.status_message = f"Refresh every {self.interval} s (live games twice as often)."
        elif key == ord("-"):
            self.interval = clamp(self.interval - 5, 5, 600)
            self.status_message = f"Refresh every {self.interval} s (live games twice as often)."
        return True

    def run(self):
        cursor(False)
        self.stdscr.timeout(200)
        self.apply_mouse()
        self.palette = Palette(enabled=not self.args.no_color,
                               floor=float(self.config.get("color_floor", 0.62)),
                               true_color=not self.args.no_true_color,
                               background=self.config.get("background", APP_BG))
        if self.graphics.enabled and not self.palette.image_pair_base:
            self.graphics.enabled = False    # no colour pair to name a picture by
            TERMINAL.update(images=False, why="text art (no colours to name pictures by)")
        self.apply_background()
        running = True
        while running:
            now = time.time()
            self.fetcher.frozen = not self.auto_refresh
            if self.auto_refresh and now - self.last_auto > self.interval:
                self.last_auto = now
                self.dirty = True
            generation = self.fetcher.generation
            if self.dirty or generation != self.last_generation or now - self.last_draw > 1.0:
                self.last_generation = generation
                self.last_draw = now
                self.dirty = False
                try:
                    self.draw()
                except curses.error:
                    pass
            running = self.handle_key(self.stdscr.getch())
            self.poll_player()
            self.save_book()
        self.stop_clip(quiet=True)
        self.save_book(force=True)
        self.graphics.clear()


