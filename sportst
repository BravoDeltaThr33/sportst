def _snapshot(line):
    return {
        "t": int(time.time()),
        "provider": line.get("provider"),
        "spread": line.get("spread"),
        "total": line.get("total"),
        "away_ml": line.get("away_ml"),
        "home_ml": line.get("home_ml"),
        "favorite": line.get("favorite"),
    }


def _same(a, b):
    keys = ("spread", "total", "away_ml", "home_ml", "favorite")
    return all((a or {}).get(k) == (b or {}).get(k) for k in keys)


class LineBook:
    """Pre-game lines, remembered across refreshes and restarts.

    Every change a refresh sees is kept, so 'how has this moved since I last
    looked' has an answer, and the last line before kickoff - the closing
    line - is still here once ESPN drops it from the scoreboard.
    """

    def __init__(self, path=LINES_PATH):
        self.path = path
        self.games = {}
        self.dirty = False
        self.load()

    @staticmethod
    def key(league, event_id):
        return f"{league}:{event_id}"

    def load(self):
        try:
            with open(self.path, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            games = data.get("games") if isinstance(data, dict) else None
            self.games = games if isinstance(games, dict) else {}
        except FileNotFoundError:
            self.games = {}
        except (OSError, json.JSONDecodeError):
            self.games = {}
        self.prune()

    def save(self):
        if not self.dirty:
            return
        try:
            os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
            temporary = self.path + ".tmp"
            with open(temporary, "w", encoding="utf-8") as handle:
                json.dump({"version": 1, "games": self.games}, handle,
                          separators=(",", ":"))
            os.replace(temporary, self.path)
            self.dirty = False
        except OSError:
            pass

    def prune(self):
        horizon = time.time() - max(1, BETTING.history_days) * 86400
        stale = []
        for key, entry in self.games.items():
            kickoff = parse_iso(entry.get("kickoff"))
            stamp = kickoff.timestamp() if kickoff else entry.get("seen", 0)
            if stamp and stamp < horizon:
                stale.append(key)
        for key in stale:
            self.games.pop(key, None)
        if stale:
            self.dirty = True

    def get(self, league, event_id):
        return self.games.get(self.key(league, event_id))

    def _entry(self, league, event):
        key = self.key(league, event["id"])
        entry = self.games.get(key)
        if entry is None:
            entry = {
                "league": league,
                "id": event["id"],
                "matchup": event.get("short_name", ""),
                "kickoff": event.get("date"),
                "seen": int(time.time()),
                "history": [],
                "closed": False,
                "source": "",
            }
            self.games[key] = entry
        return entry

    def observe(self, league, event, line):
        """A pre-game line from the scoreboard. True when it moved."""
        entry = self._entry(league, event)
        entry["line"] = line
        entry["closed"] = False
        entry["source"] = "scoreboard"
        history = entry["history"]
        snap = _snapshot(line)
        if history and _same(history[-1], snap):
            return False
        history.append(snap)
        if len(history) > HISTORY_CAP:
            # keep the first sighting; it is the reference for "since I looked"
            del history[1:len(history) - HISTORY_CAP + 1]
        self.dirty = True
        return len(history) > 1

    def close(self, league, event):
        """Game has started: whatever we hold now is the closing line."""
        entry = self.games.get(self.key(league, event["id"]))
        if entry and not entry.get("closed"):
            entry["closed"] = True
            self.dirty = True

    def adopt(self, league, event, line, source="core"):
        """A line recovered after kickoff, for a game we never saw pre-game."""
        entry = self._entry(league, event)
        if entry.get("line") and entry.get("source") == "scoreboard":
            return
        entry["line"] = line
        entry["closed"] = event.get("state") != "pre"
        entry["source"] = source
        if not entry["history"]:
            entry["history"].append(_snapshot(line))
        self.dirty = True


def attach_lines(events, league, book, fetch_core=None, selected_id=None):
    """Give every event its best available line.

    Pre-game games read the scoreboard and are recorded. Started games use the
    closing line in the book; a started game the book has never seen gets its
    line from the core endpoint through fetch_core(event), which returns a
    parsed line or None while it is still loading.
    """
    moved = []
    for event in events:
        raw = event.get("line_raw")
        if event["state"] == "pre":
            if raw:
                if book is not None and book.observe(league, event, raw):
                    moved.append(event)
                event["line"] = raw
            else:
                entry = book.get(league, event["id"]) if book else None
                event["line"] = (entry or {}).get("line")
            event["line_source"] = "live" if raw else "saved"
        else:
            if book is not None:
                book.close(league, event)
            entry = book.get(league, event["id"]) if book else None
            line = (entry or {}).get("line")
            if line is None and fetch_core is not None and (
                    event["state"] == "in" or event["id"] == selected_id):
                line = fetch_core(event)
                if line is not None and book is not None:
                    book.adopt(league, event, line)
            event["line"] = line
            event["line_source"] = "closing" if line else ""
        entry = book.get(league, event["id"]) if book else None
        event["line_history"] = (entry or {}).get("history") or []
        event["line_origin"] = (entry or {}).get("source") or ""
        event["upset"] = upset_state(event, league)
    return moved


