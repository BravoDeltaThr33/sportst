#
# ESPN's own team-stats page reads teams/{id}/athletes/statistics: every
# player's season numbers, grouped into lists (passing, rushing, defensive,
# kicking ... or one "game" list in basketball). The AHL's come from
# HockeyTech. Both are flattened into one shape:
#     {"athletes": {id: {"name", "pos", "stats": {(group, stat): text}}},
#      "lists": {list name: [ids in ESPN's order]}}

def espn_team_players(league, team_id, timeout=15):
    meta = LEAGUES[league]
    query = "?seasontype=2" if league == "mlb" else ""
    path = (f"apis/site/v2/sports/{meta['sport']}/{meta['path']}/teams/"
            f"{urllib.parse.quote(str(team_id))}/athletes/statistics{query}")
    data = fetch_first((f"https://site.web.api.espn.com/{path}",
                        [f"https://site.api.espn.com/{path}"]), timeout)
    athletes, lists = {}, {}
    for category in data.get("results") or []:
        name = category.get("name") or ""
        order = []
        for leader in category.get("leaders") or []:
            person = leader.get("athlete") or {}
            ident = str(person.get("id") or "")
            if not ident:
                continue
            entry = athletes.setdefault(ident, {
                "name": clean(person.get("shortName") or person.get("displayName") or "?"),
                "pos": clean(dig(person, "position", "abbreviation", default="")),
                "stats": {}})
            for group in leader.get("statistics") or []:
                for stat in group.get("stats") or []:
                    key = (group.get("name"), stat.get("name"))
                    if key not in entry["stats"]:
                        entry["stats"][key] = clean(str(stat.get("displayValue", "")))
            order.append(ident)
        lists[name] = order
    season = dig(data, "season", "displayName", default="") or ""
    return {"athletes": athletes, "lists": lists, "season": season,
            "source": "ESPN"}


def ahl_team_players(team_id, timeout=15):
    season = ht_season("regular", timeout) or {}
    athletes, lists = {}, {}
    for position, sort in (("skaters", "points"), ("goalies", "gaa")):
        data = ht_get({"feed": "statviewfeed", "view": "players",
                       "season": season.get("season_id", ""), "team": str(team_id),
                       "position": position, "rookies": "0", "statsType": "standard",
                       "league_id": "4", "sort": sort, "limit": "80"}, timeout)
        order = []
        for item in dig(data, 0, "sections", 0, "data", default=[]) or []:
            row = item.get("row") or {}
            ident = str(row.get("player_id") or "")
            if not ident:
                continue
            name = clean(row.get("name") or "?")
            parts = name.split()
            short = f"{parts[0][0]}. {' '.join(parts[1:])}" if len(parts) > 1 else name
            athletes[ident] = {"name": short,
                               "pos": clean(row.get("position") or ("G" if position == "goalies"
                                                                     else "")),
                               "stats": {(position, k): clean(str(v)) for k, v in row.items()}}
            order.append(ident)
        lists[position] = order
    return {"athletes": athletes, "lists": lists, "source": "HockeyTech",
            "season": (season.get("season_name") or "")}


