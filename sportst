def bet_read_line(row, league, width):
    """One line for the Scouting tab: sportst's margin and its best bet."""
    model = (row or {}).get("model")
    if not model:
        return None
    event = row["event"]
    away, home = event["away"], event["home"]
    leader = home if model["margin"] >= 0 else away
    line = Line().add(f"{'Betting':<9}", "muted")
    line.add(f"sportst {leader['abbr']} by {abs(model['margin']):.1f}",
             THEME.style(league, leader, bold=True))
    line.add(f" ({max(model['p_home'], 1 - model['p_home']) * 100:.0f}%)", "normal")
    pick = row.get("pick")
    if pick:
        line.add(" · value: ", "muted")
        line.add(f"{bet_label(pick, event)} {money_text(pick['price'])}", "bold")
        line.add(f" {pick['ev'] * 100:+.1f}% ", "good").add(STAR * pick["stars"], "upset")
    else:
        line.add(" · no bet clears the value bar (tab 9 has the lines)", "dim")
    return line


def render_bet_books(row, league, width):
    """Left half of the detail: every book's line, Kalshi and the public."""
    event = row["event"]
    away, home = event["away"], event["home"]
    lines = []
    name_w = 11
    head = Line().add(f"{'book':<{name_w}}", "header").add(f"{'spread':<17}", "header")
    head.add(f"{'total':<17}", "header").add("moneyline", "header")
    lines.append(head)
    books = row.get("books") or {}
    order = [name for _, name, _ in BOOKS if name in books] + \
        [name for name in ("Consensus", "Open") if name in books]
    if not books and row.get("espn_line"):
        books = {"ESPN": row["espn_line"]}
        order = ["ESPN"]
    best_ml = {}
    for side in ("away_ml", "home_ml"):
        prices = [books[n].get(side) for n in order if n not in ("Consensus", "Open")
                  and books[n].get(side) is not None]
        best_ml[side] = max(prices) if prices else None
    for name in order:
        line = books[name]
        style = "dim" if name in ("Consensus", "Open") else "normal"
        if name in (row.get("top_books") or []):
            style = "bold"
        out = Line().add(f"{name[:name_w - 1]:<{name_w}}", style)
        out.add(f"{spread_text(line, event, league):<17}", "normal")
        if line.get("total") is not None:
            total = f"{line['total']:g} {money_text(line.get('over_price'))}/" \
                    f"{money_text(line.get('under_price'))}" if line.get("over_price") else \
                f"{line['total']:g}"
        else:
            total = "-"
        out.add(f"{total:<17}", "normal")
        for side, sep in (("away_ml", "/"), ("home_ml", "")):
            value = line.get(side)
            best = value is not None and value == best_ml[side] and name not in ("Consensus", "Open")
            out.add(money_text(value), "good" if best else "normal")
            if sep:
                out.add(sep, "muted")
        lines.append(out)
    if not order:
        lines.append(Line().add("No sportsbook has posted a line for this game yet.", "dim"))
    if row.get("kalshi"):
        prob, volume = row["kalshi"]
        out = Line().add(f"{'Kalshi':<{name_w}}", "accent")
        out.add(f"{away['abbr']} {(1 - prob) * 100:.0f}% · {home['abbr']} {prob * 100:.0f}%",
                "normal")
        out.add(f"  prediction market, ${volume:,.0f} traded" if volume else
                "  prediction market", "dim")
        lines.append(out)
    public = row.get("public") or {}
    if public:
        lines.append(blank())
        lines.append(Line().add("Public  ", "accent").add("% of bets · % of money", "dim"))
        for market, sides, label in (("spread", ("away", "home"), "Spread"),
                                     ("ml", ("away", "home"), "Moneyline"),
                                     ("total", ("over", "under"), "Total")):
            parts = [(side, public.get(f"{market}:{side}")) for side in sides]
            if not any(info for _, info in parts):
                continue
            out = Line().add(f"  {label:<10}", "muted")
            for index, (side, info) in enumerate(parts):
                if index:
                    out.add("  ", "normal")
                name = event[side]["abbr"] if side in ("away", "home") else side.title()
                if info:
                    sharp = info[1] - info[0] >= 10
                    out.add(f"{name} {info[0]:.0f}·{info[1]:.0f}", "accent" if sharp else "normal")
            lines.append(out)
    return lines


def render_bet_model(row, league, width, min_edge):
    """Right half of the detail: the projection, its parts, and every bet."""
    event, model = row["event"], row["model"]
    away, home = event["away"], event["home"]
    lines = []
    if not model:
        lines.append(Line().add("Not enough data for a projection yet.", "dim"))
        return lines
    cfg = MODEL.get(league, MODEL["nfl"])
    unit = {"hockey": "goals", "baseball": "runs"}.get(sport_of(league), "pts")
    margin = model["margin"]
    leader = home if margin >= 0 else away
    head = Line().add("sportst  ", "accent")
    head.add(f"{leader['abbr']} by {abs(margin):.1f}", THEME.style(league, leader, bold=True))
    head.add(f" · {home['abbr']} {model['p_home'] * 100:.0f}% / {away['abbr']} "
             f"{(1 - model['p_home']) * 100:.0f}%", "normal")
    if model.get("proj"):
        a, h = model["proj"]
        digits = 1 if unit != "pts" else 0
        head.add(f" · proj {away['abbr']} {a:.{digits}f}-{h:.{digits}f} {home['abbr']}", "dim")
    lines.append(head)
    names = {"market": "Market", "kalshi": "Kalshi", "espn": "ESPN predictor",
             "stats": "Season stats"}
    for name, value, note in model["components"]:
        who = home if value >= 0 else away
        out = Line().add(f"  {names[name]:<15}", "muted")
        out.add(f"{who['abbr']} {abs(value):4.1f}", THEME.style(league, who))
        out.add(f"  {model['weights'][name] * 100:3.0f}%  ", "dim")
        out.add(note[: max(0, width - 34)], "dim")
        lines.append(out)
    for text, value in model.get("adjust") or []:
        if not value:
            continue
        lines.append(Line().add("    ± ", "muted").add(text[: width - 16], "normal")
                     .add(f"  {value:+.1f}", "warn"))
    if model.get("total") is not None:
        out = Line().add(f"  {'Total':<15}", "muted").add(f"{model['total']:.1f}", "normal")
        if model.get("stats_total") is not None:
            out.add(f"   season numbers say {model['stats_total']:.1f}", "dim")
        lines.append(out)
    signals = model.get("signals") or []
    if signals:
        lines.append(Line().add("Signals", "accent"))
        for market, side, text in signals[:5]:
            style = "warn" if side.startswith("!") else "normal"
            lines.append(Line().add("  • ", "muted").add(text[: width - 6], style))
    bets = row.get("bets") or []
    if bets:
        lines.append(Line().add("Bets  ", "accent").add(
            f"p = sportst's chance · edge = expected return per $1 · ★ at "
            f"{min_edge:g}% / {min_edge * 2:g}% / {min_edge * 3.5:g}%"[: width - 7], "dim"))
        seen = set()
        for bet in bets:
            key = (bet["kind"], bet["side"])
            if key in seen:
                continue
            seen.add(key)
            team = event.get(bet["side"]) if bet["side"] in ("away", "home") else None
            out = Line().add("  ", "normal")
            out.add(f"{bet_label(bet, event):<12}", THEME.style(league, team) if team else "normal")
            out.add(f"{money_text(bet['price']):>5} {BOOK_SHORT.get(bet['book'], bet['book'][:4]):<5}",
                    "dim")
            out.add(f" p {bet['p'] * 100:4.1f}%", "normal")
            out.add(f"  {bet['ev'] * 100:+5.1f}%", "good" if bet["ev"] > 0 else "bad")
            if bet["stars"]:
                out.add(f" {STAR * bet['stars']:<3}", "upset").add(f" {bet['stake']:.1f}u", "dim")
            lines.append(out)
        pick = row.get("pick")
        if pick and (pick["agree"] or pick["disagree"]):
            out = Line().add("  why  ", "muted")
            if pick["agree"]:
                out.add("for: " + ", ".join(dict.fromkeys(pick["agree"])), "good")
            if pick["disagree"]:
                out.add("  against: " + ", ".join(dict.fromkeys(pick["disagree"])), "bad")
            lines.append(out)
    return lines



