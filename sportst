def espn_byteam(league, timeout=15):
    """{team id: (team record, {(category, stat, side): value})} from ESPN."""
    meta = LEAGUES[league]
    group = {"cfb": "&group=80", "cbb": "&group=50"}.get(league, "")
    url = (f"{ESPN_STATS}/{meta['sport']}/{meta['path']}/statistics/byteam?region=us"
           f"&lang=en&contentorigin=espn&limit=500{group}")
    data = http_json(url, timeout)
    names = {}
    for category in data.get("categories") or []:
        if category.get("names") and category.get("name") not in names:
            names[category["name"]] = category["names"]
    out = {}
    for node in data.get("teams") or []:
        team = team_record(node.get("team") or {})
        values = {}
        for category in node.get("categories") or []:
            side = "opp" if (category.get("splitId") == "900" or str(
                category.get("displayName") or "").startswith("Opponent")) else "own"
            for index, name in enumerate(names.get(category.get("name"), [])):
                key = (category.get("name"), name, side)
                if key not in values and index < len(category.get("values") or []):
                    values[key] = category["values"][index]
        games = values.get(("general", "gamesPlayed", "own")) or values.get(
            ("general", "games", "own"))
        out[team["id"]] = (team, values, games)
    return out


