    def group_tree(self):
        """[(outer heading, [names])] of the conferences and divisions."""
        members = dict(self.team_groups())
        table = self.load_team_table().data if self.tab_name == "Stats" else None
        for team in (table or {}).get("teams") or []:
            if team.get("groups"):
                members.setdefault(team["id"], team["groups"])
        tree = {}
        for names in members.values():
            if not names:
                continue
            outer = names[0]
            tree.setdefault(outer, set())
            if len(names) > 1:
                tree[outer].update(names[1:])
        return [(outer, sorted(inner)) for outer, inner in sorted(tree.items())]

    def open_group_picker(self):
        if self.tab_name not in ("Scoreboard", "Stats", "Betting", "Standings"):
            self.status_message = "c filters the Scoreboard, Standings, Stats and Betting tabs."
            return
        tree = self.group_tree()
        fam = family(self.league)
        current = self.group_filter.get(fam, "")
        items = [{"label": "Show", "action": None},
                 {"label": "All teams", "detail": "clear the filter", "action": ""}]
        if self.league in COLLEGE_LEAGUES:
            items.append({"label": "Top 25 " + ("(on)" if self.ranked_only else "(off)"),
                          "detail": "toggle, works with a conference too", "action": "\x00top25"})
        if not tree:
            self.status_message = "Still loading the conference list - try again in a moment."
            return
        flat = [outer for outer, inner in tree if not inner]
        if flat:
            items.append({"label": "Conferences" if self.league in COLLEGE_LEAGUES
                          else "Divisions", "action": None})
            for outer in flat:
                items.append({"label": short_group(outer), "detail": outer, "action": outer})
        for outer, inner in tree:
            if not inner:
                continue
            items.append({"label": outer, "action": None})
            items.append({"label": f"All {short_group(outer)}", "detail": outer,
                          "action": outer})
            for name in inner:
                items.append({"label": short_group(name), "detail": name, "action": name})
        cursor = next((i for i, item in enumerate(items) if item["action"] == current
                       and item["action"] is not None), 1)
        self.popup = Popup(f"{LEAGUE_SHORT.get(fam, fam)} · filter teams", items,
                           self.pick_group, cursor,
                           "enter picks · type / to search · esc closes")

    def group_choices(self):
        """'' (every team) and then each conference and division, in the
        order the c list shows them."""
        names = [""]
        tree = self.group_tree()
        flat = [outer for outer, inner in tree if not inner]
        names.extend(flat)
        for outer, inner in tree:
            if inner:
                names.append(outer)
                names.extend(inner)
        return names

