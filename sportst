                        "ESPN published no box score for this game - it keeps one for "
                        "the games it covers. The Scoreboard has its score.",
                        inner_width, "dim")
                elif summary.data and title in ("Boxscore", "Game Stats"):
                    panes = (self.boxscore_panes(summary.data, width)
                             if title == "Boxscore"
                             else self.team_stats_panes(summary.data, width, height - 2))
                    if panes and title == "Boxscore" and self.league in CARD_LEAGUES:
                        self.draw_boxscore(top, height, width, event, summary.data, panes)
                        return
                    if panes:
                        self.draw_two_panes(top, height, width, title, panes)
                        return
                    lines = [Line().add("Nothing published for this game yet.", "dim")]
                elif summary.data:
                    boxed = title == "Plays"
                    lines = render_plays(summary.data, self.league,
                                         inner_width - (4 if boxed else 0), self.favorites)
                    if boxed:
                        single = [(None, lines)]
                        self.decorate_plays(event, summary.data, single, inner_width - 4)
