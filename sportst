def _side_from_flags(item, flag):
    if dig(item, "homeTeamOdds", flag) is True:
        return "home"
    if dig(item, "awayTeamOdds", flag) is True:
        return "away"
    return None


def _favorite_from_numbers(spread, away_ml, home_ml):
    if spread is not None and spread != 0:
        return "home" if spread < 0 else "away"
    if away_ml is not None and home_ml is not None and away_ml != home_ml:
        return "home" if home_ml < away_ml else "away"
    return None


def _spread_from_details(details, away, home):
    """'CAR -2.5' -> home-relative spread, when nothing else is present."""
    match = re.match(r"\s*([A-Za-z0-9&.' ]+?)\s+([+-]?\d+(?:\.\d+)?)\s*$", details or "")
    if not match or not away or not home:
        return None
    team, value = match.group(1).strip().upper(), abs(float(match.group(2)))
    if team == str(home.get("abbr", "")).upper():
        return -value
    if team == str(away.get("abbr", "")).upper():
        return value
    return None


def parse_line_item(item, away=None, home=None):
    """Normalise one bookmaker's line from a scoreboard or core payload."""
    if not isinstance(item, dict):
        return None
    away_odds = item.get("awayTeamOdds") or {}
    home_odds = item.get("homeTeamOdds") or {}

    spread = _num(item.get("spread"))
    if spread is None:
        spread = _num(dig(item, "pointSpread", "home", "close", "line"))
    if spread is None:
        spread = _num(dig(home_odds, "current", "pointSpread", "american"))
    details = clean(item.get("details") or "")
    if spread is None:
        spread = _spread_from_details(details, away, home)

    total = _num(item.get("overUnder"))
    if total is None:
        total = _num(dig(item, "total", "over", "close", "line"))
    if total is None:
        total = _num(dig(item, "current", "total", "american"))

    away_ml = (_american(dig(item, "moneyline", "away", "close", "odds"))
               or _american(away_odds.get("moneyLine"))
               or _american(dig(away_odds, "current", "moneyLine", "american")))
    home_ml = (_american(dig(item, "moneyline", "home", "close", "odds"))
               or _american(home_odds.get("moneyLine"))
               or _american(dig(home_odds, "current", "moneyLine", "american")))

    opening = {
        "spread": (_num(dig(item, "pointSpread", "home", "open", "line"))
                   if dig(item, "pointSpread", "home", "open", "line") is not None
                   else _num(dig(home_odds, "open", "pointSpread", "american"))),
        "total": (_num(dig(item, "total", "over", "open", "line"))
                  if dig(item, "total", "over", "open", "line") is not None
                  else _num(dig(item, "open", "total", "american"))),
        "away_ml": (_american(dig(item, "moneyline", "away", "open", "odds"))
                    or _american(dig(away_odds, "open", "moneyLine", "american"))),
        "home_ml": (_american(dig(item, "moneyline", "home", "open", "odds"))
                    or _american(dig(home_odds, "open", "moneyLine", "american"))),
    }

    favorite = _side_from_flags(item, "favorite") or _favorite_from_numbers(
        spread, away_ml, home_ml)
    favorite_open = _side_from_flags(item, "favoriteAtOpen")
    if favorite_open is None:
        if dig(home_odds, "open", "favorite") is True:
            favorite_open = "home"
        elif dig(away_odds, "open", "favorite") is True:
            favorite_open = "away"
        else:
            favorite_open = _favorite_from_numbers(
                opening["spread"], opening["away_ml"], opening["home_ml"])

    if spread is None and total is None and away_ml is None and home_ml is None:
        return None

    return {
        "provider": clean(dig(item, "provider", "displayName", default="")
                          or dig(item, "provider", "name", default="")) or "line",
        "priority": dig(item, "provider", "priority", default=99),
        "details": details,
        "spread": spread,
        "total": total,
        "away_ml": away_ml,
        "home_ml": home_ml,
        "favorite": favorite,
        "favorite_open": favorite_open,
        "open": opening if any(v is not None for v in opening.values()) else None,
    }


def pick_line(items, away=None, home=None, preferred=""):
    """One line out of however many books ESPN returned."""
    parsed = [parse_line_item(item, away, home) for item in (items or [])]
    parsed = [p for p in parsed if p]
    if not parsed:
        return None
    if preferred:
        needle = preferred.lower()
        for entry in parsed:
            if needle in entry["provider"].lower():
                return entry

    def rank(entry):
        priority = entry.get("priority")
        return priority if isinstance(priority, (int, float)) else 99

    parsed.sort(key=rank)
    return parsed[0]


def parse_core_odds(data, away=None, home=None):
    items = dig(data, "items", default=None)
    if items is None and isinstance(data, list):
        items = data
    return pick_line(items or [], away, home, BETTING.provider)


# -- reading a line from the favourite's side ------------------------------


def favorite_side(line):
    return (line or {}).get("favorite")


def side_spread(line, side, key="spread"):
    """The spread as `side` sees it (home-relative value flipped for away)."""
    source = line if key == "spread" else (line or {}).get("open") or {}
    value = (source or {}).get("spread")
    if value is None:
        return None
    return value if side == "home" else -value


def favorite_number(line, league, which="now"):
    """How strong the favourite is, as a signed number where more negative is
    stronger: the spread in football, the moneyline in hockey (the puck line is
    always 1.5, so it says nothing about how big a favourite is)."""
    if not line:
        return None
    side = line.get("favorite")
    if which == "open":
        opening = line.get("open") or {}
        side = line.get("favorite_open") or side
        if not side:
            return None
        if league in MONEYLINE_LEAGUES or opening.get("spread") in (None, 0):
            return opening.get(f"{side}_ml")
        return -abs(opening["spread"])
    if not side:
        return None
    if league in MONEYLINE_LEAGUES or line.get("spread") in (None, 0):
        return line.get(f"{side}_ml")
    return -abs(line["spread"])


def line_label(line, event, league):
    """'CAR -2.5', 'PK', or, where the moneyline is what matters (hockey and
    baseball), the favourite's moneyline: 'BOS -150'."""
    if not line:
        return "", None
    side = line.get("favorite")
    if league in MONEYLINE_LEAGUES:
        if side:
            team = event[side]
            return f"{team['abbr']} {money_text(line.get(side + '_ml'))}", team
        return "PK", None
    spread = line.get("spread")
    if spread is not None and spread == 0:
        return "PK", None
    if side and spread is not None:
        team = event[side]
        return f"{team['abbr']} -{abs(spread):g}", team
    if side and line.get(side + "_ml") is not None:
        team = event[side]
        return f"{team['abbr']} {money_text(line.get(side + '_ml'))}", team
    return "", None


def movement(line, league):
    """'flip' when the favourite changed, 'up' when the favourite got stronger
    since the open, 'down' when weaker, None when flat or unknown."""
    if not line:
        return None
    if line.get("favorite_open") and line.get("favorite") and \
            line["favorite_open"] != line["favorite"]:
        return "flip"
    now = favorite_number(line, league, "now")
    then = favorite_number(line, league, "open")
    if now is None or then is None or now == then:
        return None
    return "up" if now < then else "down"


MOVE_MARK = {"up": "▲", "down": "▼", "flip": "◆"}


