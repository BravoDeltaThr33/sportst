def render_setting_rows(app, width, number):
    """(lines, {its index in SETTING_ROWS: its line}) for group `number`'s
    card: each setting with its value."""
    specs = SETTING_GROUPS[number][1]
    start = SETTING_GROUP_START[number]
    label_width = clamp(max(len(s["label"]) for s in specs) + 1, 16, 30)
    room = max(4, width - label_width - 14)
    lines, at = [], {}
    for offset, spec in enumerate(specs):
        index = start + offset
        chosen = index == app.settings_cursor
        base = "sel" if chosen else "normal"
        line = Line().add("▌" if chosen else " ", "selbar" if chosen else "normal")
        line.add(f" {spec['label']:<{label_width}}", base)
        tag, tag_style = "", "muted"
        if spec["kind"] == "action" and spec.get("shows"):
            text, changed = spec["shows"](app)
            if len(text) > room:
                text = text[:room - 1] + "…"
            line.add(text, "sel" if chosen else ("accent" if changed else "normal"))
            if changed:
                tag, tag_style = "changed", "accent"
        elif spec["kind"] == "action":
            line.add("enter", "seldim" if chosen else "muted")
        else:
            value = app.setting_value(spec)
            text = setting_text(spec, value)
            if len(text) > room:
                text = text[:room - 1] + "…"
            changed = value != setting_default(spec)
            style = "sel" if chosen else ("accent" if changed else "normal")
            if spec["kind"] == "bool":
                style = ("sel" if chosen else "good") if value else \
                    ("seldim" if chosen else "muted")
            line.add(text, style)
            rgb = hex_to_rgb(str(value)) if spec["kind"] == "color" else None
            if rgb and sum(rgb) > 40:
                line.add(" ", base).add("██", str(value).upper())
            if app.setting_unsaved(spec):
                tag, tag_style = "this run", "warn"
            elif spec.get("apply") == "start":
                tag = "next start"
            elif changed:
                tag, tag_style = "changed", "accent"
        used = sum(len(t) for t, _ in line)
        if tag and used + len(tag) + 2 <= width:
            line.add(" " * (width - used - len(tag) - 1), base)
            line.add(tag, "seldim" if chosen else tag_style)
        line.pad(width, base if chosen else "normal")
        at[index] = len(lines)
        lines.append(line)
    return lines, at


def render_setting_detail(app, width):
    """The picked setting explained, under its card's list, in three parts:
    (its name, what it does, its default and keys) - the middle one is cut
    short when the card has little room."""
    spec = app.settings_spec()
    head = [rule(width), Line().add(spec["label"], "bold")]
    body = wrap_spans(spec["help"], width, "dim")
    if spec.get("preview"):
        body.append(Line().add("looks like  ", "muted")
                    .extend_spans(meter_spans(0.75, max(4, min(24, width - 30)), "good"))
                    .add("  ", "normal").extend_spans(meter_spans(0.4, 10, "accent")))
    kind = spec["kind"]
