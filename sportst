def info_standings(league):
    source = OLYMPIC_STANDINGS.get(sport_of(league), []) if is_olympic(league) \
        else STANDINGS_COLUMNS.get(league, [])
    columns = [name for name, _ in source] or ["W", "L", "PCT", "GB", "STRK"]
    rows = [(name, INFO_STANDINGS.get(name, "")) for name in columns]
    sections = [("This screen", [_p("Every division or conference, flowed into as many "
                                    "columns as fit. Teams are in standings order; your "
                                    "favourites are starred (and each team has its "
                                    "logo beside it, in a terminal that shows "
                                    "pictures). j / k pick a team (▌) and enter opens "
                                    "its team page: every game, result and start time, "
                                    "beside the season at a glance (I there says what "
                                    "is what); esc comes back. A click picks a team, a "
                                    "second click opens its page. c shows one "
                                    "conference or division, / finds a team by name "
                                    "(empty clears).")]),
                ("Columns", rows)]
    if league in ("nhl", "ahl"):
        sections.append(("Points", [_p("2 points for a win, 1 for an overtime or "
                                       "shootout loss, 0 for a regulation loss.")]))
    return sections


def info_stats(league, table):
    sections = [("This screen", [
        _p("Every team's season numbers, one row each, as many stat groups side by "
           "side as the width allows (offense and defense together on a wide "
           "terminal). "
           + ("The teams are ranked best-first by the sort column. "
              if league in COLLEGE_LEAGUES else
              "The teams are grouped by league (or conference) and division, under a "
              "heading for each, best-first inside each division; s switches to the "
              "whole league best-first, or A-Z. ")
           + "j / k highlight a team; enter shows its players. [ and ] show one "
           "conference or division at a time (stepping through them, back round to "
           "All teams), c picks one from the list; s picks the sort column or the "
           "order, S steps to the next column, g changes stat group"
           + (", F keeps the Top 25" if league in COLLEGE_LEAGUES else "") + ", and / "
           "finds a team by name (type part of it - "
           + SEARCH_EXAMPLES.get(league, "'swe' finds Sweden")
           + "; an empty search clears it)."),
        ("◂ SEC ▸", "the conference or division on screen (All teams: everyone), and "
         "how many teams that leaves"),
        ("── AFC ──", "pro leagues: a league or conference heading, then each "
         "division's name over its teams"),
        ("conf / div", "the team's conference or division, when the teams are not "
         "grouped under headings"),
        ("#", "the team's rank in the sort column (▼ marks it) - #1 is best, even for "
         "stats where lower is better. With one conference or division (or the Top "
         "25) on screen it is the place within that selection"),
        ("lg", "shown beside # when the table is narrowed: the team's rank in the "
         "whole league"),
        ("record", "wins-losses (-ties or overtime losses)"),
        ("green / red", "the league's best fifth / worst fifth in that column - still "
         "measured against the whole league when one conference is shown"),
    ])]
    stats = (table or {}).get("stats") or stat_defs(league)
    by_group = {}
    for stat in stats:
        better = "higher is better" if stat.get("better") == "high" else "lower is better"
        by_group.setdefault(stat["group"], []).append(
            (stat["short"], f"{stat['label'].lower()} - {better}"))
    for group, entries in by_group.items():
        sections.append((group, entries))
    if table and table.get("sources"):
        sections.append(("Sources", [_p(", ".join(table["sources"]))]))
    return sections


def info_players(league):
    sections = [("This screen", [
        _p("One team's players for the season: offense on the left, defense on the "
           "right, special teams (or minutes, or fielding) across the bottom. [ ] step "
           "through the teams, esc goes back."),
        ("name POS", "player and position: QB quarterback, RB running back, WR wide "
         "receiver, TE tight end, OL/OT/G/C offensive line, DE/DT/NT defensive line, LB "
         "linebacker, CB cornerback, S safety, PK kicker, P punter, LS long snapper; G "
         "guard, F forward, C centre; LW/RW wings, D defence, G goalie; SP/RP starting "
         "/ relief pitcher, C catcher, 1B 2B 3B SS infield, LF CF RF outfield, DH"),
    ])]
    for section in player_specs(league):
        _, title, _, columns, _, _ = section
        entries = []
        for group, stat, label in columns:
            text = PLAYER_STAT_NAMES.get(stat) or _camel_words(stat)
            entries.append((label, text))
        sections.append((title, entries))
    return sections


