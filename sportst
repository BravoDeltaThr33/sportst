class Palette:
    """Resolves a style token to a curses attribute.

    A token is either a name from BASE_STYLES or a colour: '#RRGGBB', with
    optional modifiers after a tilde. b bold, s selected background, d faded
    for a team that lost. Colour pairs and colour slots are allocated on first
    use and cached, so a long college slate costs only as many as it shows.
    """

    def __init__(self, enabled=True, floor=0.62, true_color=True, background=APP_BG):
        self.floor = floor
        # Painted onto every pair, so the app sits on a solid field rather than
        # letting the terminal's own background show through. "terminal" opts out.
        self.bg_rgb = None
        if background and str(background).strip().lower() not in ("terminal", "default", "none", ""):
            self.bg_rgb = hex_to_rgb(background)
        self.attrs = {}
        self._tokens = {}
        self._pairs = {}
        self._colors = {}
        self._by_bg = {}
        self._slots = []
        self._next_pair = 1
        self._next_color = 16
        self.slot_limit = 232
        self.logo_pair_count = 0
        self.logo_slot_count = 0
        self._logo_key = None
        self._logo_reset()
        self.exact = False
        self.enabled = bool(enabled) and curses.has_colors()

        styles = base_styles()
        self.upset_bg = hex_to_rgb(upset_background())
        if not self.enabled:
            for name in styles:
                self.attrs[name] = PLAIN_ATTRS.get(name, curses.A_NORMAL)
            self.max_pairs = 0
            self.depth = 0
            return

        curses.start_color()
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        self.depth = curses.COLORS
        self.max_pairs = max(8, min(curses.COLOR_PAIRS - 1, 250))
        if true_color and self.depth >= 256:
            try:
                self.exact = curses.can_change_color()
            except curses.error:
                self.exact = False
        # Only one logo is on screen at a time, so logo art gets its own small
        # block of pairs (and colour slots) that is recycled for each new
        # logo instead of eating into the pool the team colours live in.
        if self.max_pairs >= 150:
            self.logo_pair_count = LOGO_PAIRS
            self.max_pairs -= LOGO_PAIRS
            self.logo_pair_base = self.max_pairs + 1
        if self.exact:
            self.logo_slot_count = LOGO_SLOTS
            self.slot_limit = min(self.depth, 232) - LOGO_SLOTS
        for name, (fg, bg, extra) in styles.items():
            self.attrs[name] = self._attr(fg, bg, extra)

    # -- allocation ------------------------------------------------------

    def _index_rgb(self, rgb):
        """Colour index for an RGB triple.

        In exact mode the colour cube has been overwritten by init_color, so
        once the private slots run out the nearest cube index would be a lie.
        Reuse the closest slot already defined instead.
        """
        if rgb is None:
            return -1
        cached = self._colors.get(rgb)
        if cached is not None:
            return cached
        if self.exact:
            if self._next_color < min(self.depth, self.slot_limit):
                slot = self._next_color
                try:
                    curses.init_color(slot, round(rgb[0] * 1000 / 255),
                                      round(rgb[1] * 1000 / 255),
                                      round(rgb[2] * 1000 / 255))
                    self._next_color += 1
                    self._colors[rgb] = slot
                    self._slots.append((rgb, slot))
                    return slot
                except curses.error:
                    self.exact = False
            elif self._slots:
                nearest = min(self._slots, key=lambda item: color_distance(rgb, item[0]))
                self._colors[rgb] = nearest[1]
                return nearest[1]
        index = nearest_xterm(rgb) if self.depth >= 256 else nearest_basic(rgb, self.depth)
        self._colors[rgb] = index
        return index

    def _attr_rgb(self, fg_rgb, bg_rgb, extra=0):
        """A pair for this fg/bg, or the closest pair already allocated.

        Python encodes the pair number inside the attribute, which caps the
        usable pairs at 255 however many the terminal advertises. A full
        college slate has more teams than that, so running out has to degrade
        to a near colour rather than to no colour.
        """
        if bg_rgb is None:
            bg_rgb = self.bg_rgb
        fg = self._index_rgb(fg_rgb)
        bg = self._index_rgb(bg_rgb)
        key = (fg, bg)
        if key in self._pairs:
            return self._pairs[key] | extra
        if self._next_pair <= self.max_pairs:
            slot = self._next_pair
            try:
                curses.init_pair(slot, fg, bg)
                self._next_pair += 1
                attr = curses.color_pair(slot)
                self._pairs[key] = attr
                self._by_bg.setdefault(bg, []).append((fg_rgb or (230, 227, 220), attr))
                return attr | extra
            except (curses.error, ValueError):
                pass
        pool = self._by_bg.get(bg) or self._by_bg.get(-1) or []
        if pool and fg_rgb:
            nearest = min(pool, key=lambda item: color_distance(fg_rgb, item[0]))
            return nearest[1] | extra
        return self.attrs.get("normal", curses.A_NORMAL) | extra

    def _attr(self, fg_hex, bg_hex, extra=0):
        return self._attr_rgb(hex_to_rgb(fg_hex) if fg_hex else None,
                              hex_to_rgb(bg_hex) if bg_hex else None, extra)

    # -- lookup ----------------------------------------------------------

    def __call__(self, style):
        if not style:
            return self.attrs.get("normal", curses.A_NORMAL)
        if style[0] == "@":
            cache = self._logo_tokens if self.logo_pair_count else self._tokens
            cached = cache.get(style)
            if cached is None:
                cached = self._resolve_pixel(style)
                cache[style] = cached
            return cached
        if style[0] != "#":
            return self.attrs.get(style, self.attrs.get("normal", curses.A_NORMAL))
        cached = self._tokens.get(style)
        if cached is not None:
            return cached
        attr = self._resolve_team(style)
        self._tokens[style] = attr
        return attr

    # -- logo art ----------------------------------------------------------

    def _logo_reset(self):
        self._logo_tokens = {}
        self._logo_pairs = {}
        self._logo_colors = {}
        self._logo_next_pair = 0
        self._logo_next_slot = 0

    def logo_begin(self, key):
        """Start drawing a (possibly different) logo: recycle the logo block."""
        if key != self._logo_key:
            self._logo_key = key
            self._logo_reset()

    def _logo_index(self, rgb):
        hit = self._logo_colors.get(rgb)
        if hit is not None:
            return hit
        if self.exact and self.logo_slot_count:
            if self._logo_next_slot < self.logo_slot_count:
                slot = self.slot_limit + self._logo_next_slot
                try:
                    curses.init_color(slot, *(round(c * 1000 / 255) for c in rgb))
                    self._logo_next_slot += 1
                    self._logo_colors[rgb] = slot
                    return slot
                except curses.error:
                    pass
            if self._logo_colors:
                near = min(self._logo_colors, key=lambda c: color_distance(rgb, c))
                return self._logo_colors[near]
        index = nearest_xterm(rgb) if self.depth >= 256 else nearest_basic(rgb, self.depth)
        self._logo_colors[rgb] = index
        return index

    def _logo_attr(self, fg_rgb, bg_rgb):
        fg = self._logo_index(fg_rgb)
        bg = self._index_rgb(self.bg_rgb) if bg_rgb is None else self._logo_index(bg_rgb)
        key = (fg, bg)
        hit = self._logo_pairs.get(key)
        if hit is not None:
            return hit
        if self._logo_next_pair < self.logo_pair_count:
            number = self.logo_pair_base + self._logo_next_pair
            try:
                curses.init_pair(number, fg, bg)
                self._logo_next_pair += 1
                self._logo_pairs[key] = curses.color_pair(number)
                return self._logo_pairs[key]
            except (curses.error, ValueError):
                pass
        return self._attr_rgb(fg_rgb, bg_rgb)

    def _resolve_pixel(self, token):
        """'@RRGGBB' or '@RRGGBB:RRGGBB' - exact colours for logo art, with no
        legibility lift, on the app background or on a second colour."""
        fg_hex, _, bg_hex = token[1:].partition(":")
        fg = hex_to_rgb("#" + fg_hex)
        bg = hex_to_rgb("#" + bg_hex) if bg_hex else None
        if not self.enabled or fg is None:
            return self.attrs.get("normal", curses.A_NORMAL)
        if self.logo_pair_count:
            return self._logo_attr(fg, bg)
        return self._attr_rgb(fg, bg)

    def _resolve_team(self, token):
        hex_part, _, mods = token.partition("~")
        rgb = hex_to_rgb(hex_part)
        if rgb is None or not self.enabled:
            base = "sel" if "s" in mods else ("upsetrow" if "u" in mods else "normal")
            attr = self.attrs.get(base, curses.A_NORMAL)
            return attr | (curses.A_BOLD if "b" in mods else 0)
        rgb = lift(rgb, self.floor)
        extra = curses.A_BOLD if "b" in mods else 0
        if "s" in mods or "u" in mods:
            # On the dark red cursor bar or the orange tint a dimmed, dark
            # team colour (South Carolina, South Dakota) all but vanishes, so
            # it is brightened further and never dimmed there.
            rgb = lift(rgb, max(self.floor, 0.86))
            mods = mods.replace("d", "")
        if "d" in mods:
            # A_DIM rather than a second, darker colour: a losing team would
            # otherwise double the number of pairs the screen needs.
            extra |= curses.A_DIM
        bg = None
        if "s" in mods:
            bg = hex_to_rgb(SEL_BG)
        elif "u" in mods:
            bg = self.upset_bg
        return self._attr_rgb(rgb, bg, extra)


