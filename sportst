    def load_kalshi(self):
        if self.league not in KALSHI_SERIES or not self.config.get("betting_sources", True):
            return None
        return self.fetcher.get(("kalshi", self.league),
                                Loader("api.elections.kalshi.com", kalshi_board, self.league),
                                ttl=300)

    def top_books(self):
        chosen = self.config.get("betting_top_books") or TOP_BOOKS_DEFAULT
        known = [name for _, name, _ in BOOKS]
        return [name for name in chosen if name in known] or TOP_BOOKS_DEFAULT

    def bet_mode_label(self):
        if self.league not in AN_LEAGUES or not self.config.get("betting_sources", True):
            return "ESPN's line where posted, sportst's projection"
        if self.bet_book == "best":
            return "best price at any book"
        if self.bet_book == "avg":
            return "average of " + " · ".join(self.top_books())
        return self.bet_book + " only"

    def min_edge(self):
        try:
            return max(0.5, float(self.config.get("betting_min_edge", 3.0)))
        except (TypeError, ValueError):
            return 3.0

    def bet_rows(self):
        """(rows, games hidden because they have started) for the Betting tab."""
        events = [e for e in self.events if e["state"] == "pre"]
        hidden = len(self.events) - len(events)
        table = self.load_team_table().data
        board = self.load_bet_board()
        markets = self.load_kalshi()
        rows = [self.bet_row(event, board, markets, table, index < 80) for index, event
                in enumerate(events)]
        # best bets ranked: most stars, then the biggest edge
        picks = sorted((r for r in rows if r["pick"]),
                       key=lambda r: (-r["pick"]["stars"], -r["pick"]["ev"]))
        for rank, row in enumerate(picks, 1):
            row["rank"] = rank
        if self.bet_picks_only:
            rows = picks
        elif self.bet_sort == "value":
            rest = sorted((r for r in rows if not r["pick"]),
                          key=lambda r: -(r["best"]["ev"] if r["best"] else -9))
            rows = picks + rest
        return rows, hidden

    def bet_row(self, event, board, markets, table, with_summary=True):
        """Everything the Betting tab knows about one game."""
        league = self.league
        mode = self.bet_book
        top = self.top_books()
        min_edge = self.min_edge()
        game = match_an_game(event, board.data) if board and board.data else None
        books = dict(game["books"]) if game else {}
        sellers = {n: l for n, l in books.items() if n not in ("Consensus", "Open")}
        espn = espn_line_as_book(event.get("line") or event.get("line_raw"))
        market = books.get("Consensus") or average_lines(list(sellers.values())) or espn
        if mode == "avg":
            shown = average_lines([sellers[n] for n in top if n in sellers]) or \
                average_lines(list(sellers.values())) or espn
            candidates = [shown]
        elif mode == "best":
            shown = market
            candidates = list(sellers.values()) or [espn]
        else:
            shown = sellers.get(mode)
            candidates = [shown]
        summary, loading = None, False
        if with_summary:
            result = self.load_summary(event["id"])
            summary = result.data
            loading = result.loading and not summary
        kalshi = match_kalshi(event, markets.data) if markets and markets.data else None
        public = game["public"] if game else {}
        model = project_game(event, league, table, market, summary, kalshi,
                             books.get("Open"), public)
        bets = bet_options(event, league, model, [c for c in candidates if c],
                           "best" if mode == "best" else "one", min_edge)
        pick = next((b for b in bets if b["stars"]), None)
        return {"event": event, "line": shown, "market": market, "books": books,
                "espn_line": espn, "model": model, "bets": bets, "pick": pick,
                "best": bets[0] if bets else None, "kalshi": kalshi,
                "public": public, "loading": loading,
                "move": line_move(market, books.get("Open"), event, league),
                "top_books": top if mode == "avg" else [mode]}

    def draw_betting(self, top, height, width):
        meta = LEAGUES[self.league]
        rows, hidden = self.bet_rows()
        self._bet_rows = rows
        inner = width - 4
        fam = family(self.league)
        caption = f"{meta['name']} betting · {self.bet_mode_label()}"
        if self.group_filter.get(fam):
            caption += f" · {short_group(self.group_filter[fam])}"
        if self.ranked_only and self.league in COLLEGE_LEAGUES:
            caption += " · top 25"
        picks = sum(1 for r in rows if r["pick"])
        if not rows:
            lines = []
            if self.bet_picks_only:
                lines.append(Line().add("No game clears the value bar right now. m shows "
                                        "every game again.", "dim"))
            else:
                lines.append(Line().add("No upcoming games " + (
                    "this week." if self.week_mode and meta["week_based"] else "on this day.")
                    + (f"  ({hidden} already started or finished.)" if hidden else ""), "dim"))
                lines.append(Line().add("h / l moves the " + (
                    "week" if self.week_mode and meta["week_based"] else "day") +
                    "; the filters (c, f) apply here too.", "muted"))
            if self.league not in AN_LEAGUES:
                lines.append(blank())
                lines.append(Line().add("Sportsbook lines for this league come only from "
                                        "ESPN, when it has them; sportst's projection "
                                        "still runs.", "muted"))
            self.draw_lines_box(top, height, width, caption, lines, key="Betting")
            return
        self.bet_index = clamp(self.bet_index, 0, len(rows) - 1)
        list_lines = render_bet_list(rows, self.league, inner, self.bet_index,
                                     self.bet_book == "best")
        list_height = clamp(len(list_lines) + 2, 5, max(5, int(height * 0.5)))
        if height - list_height < 8:
            list_height = max(5, height - 8)
        caption += f" · {len(rows)} games · {picks} value pick{'s' if picks != 1 else ''}"
        caption += " · best bets first" if self.bet_sort == "value" else " · by start time"
        self.draw_box(top, 0, list_height, width, caption, "accent")
        view = list_height - 3
        offset = self.scroll["BettingList"]
        if self.bet_index < offset:
            offset = self.bet_index
        elif self.bet_index >= offset + view:
            offset = self.bet_index - view + 1
        offset = clamp(offset, 0, max(0, len(list_lines) - 1 - view))
        self.scroll["BettingList"] = offset
        self.draw_lines(list_lines[:1], top + 1, 2, 1, inner, 0)
        self.draw_lines(list_lines[1:], top + 2, 2, view, inner, offset)
        self.draw_scrollbar(top + 2, width - 2, view, len(list_lines) - 1, offset)

        row = rows[self.bet_index]
        event = row["event"]
        pane = self.pane_width(width)
        left = render_bet_books(row, self.league, pane)
        left.append(blank())
        notes = []
        if hidden:
            notes.append(f"{hidden} game{'s' if hidden != 1 else ''} already started")
        notes.append(("b sportsbook · " if self.league in AN_LEAGUES else "") +
                     "s sort · m picks only · c / f filter · enter scouting")
        for text in notes:
            left.extend(wrap_spans(text, pane, "muted"))
        left.extend(wrap_spans("Estimates, not guarantees. Stake is an eighth-Kelly size in "
                               "units of 1% of a bankroll. Problem gambling help: "
                               "1-800-GAMBLER.", pane, "muted"))
        right = render_bet_model(row, self.league, pane, self.min_edge())
        away, home = event["away"], event["home"]
        title = Line().add(" ", "border").add(away["abbr"], THEME.style(self.league, away, bold=True))
        title.add(" @ ", "muted").add(home["abbr"], THEME.style(self.league, home, bold=True))
        title.add(f" · {bet_time(event)} · lines ", "dim")
        self.draw_two_panes(top + list_height, height - list_height, width, "Betting",
                            [(title, left), (Line().add(" sportst's read ", "accent"), right)])

    def handle_betting_key(self, key):
        rows = self._bet_rows
        if key in (ord("j"), curses.KEY_DOWN):
            self.bet_index = clamp(self.bet_index + 1, 0, max(0, len(rows) - 1))
            self.scroll["Betting"] = 0
        elif key in (ord("k"), curses.KEY_UP):
            self.bet_index = clamp(self.bet_index - 1, 0, max(0, len(rows) - 1))
            self.scroll["Betting"] = 0
        elif key == curses.KEY_NPAGE:
            self.bet_index = clamp(self.bet_index + 10, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_PPAGE:
            self.bet_index = clamp(self.bet_index - 10, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_HOME:
            self.bet_index = 0
        elif key in (curses.KEY_END, ord("G")):
            self.bet_index = max(0, len(rows) - 1)
        elif key == ord("J"):
            self.scroll["Betting"] += 1
        elif key == ord("K"):
            self.scroll["Betting"] = max(0, self.scroll["Betting"] - 1)
        elif key == ord("b"):
            self.open_book_picker()
        elif key == ord("s"):
            self.bet_sort = "value" if self.bet_sort == "time" else "time"
            self.bet_index = 0
            self.status_message = ("Best bets first, ranked." if self.bet_sort == "value"
                                   else "In start-time order.")
        elif key == ord("m"):
            self.bet_picks_only = not self.bet_picks_only
            self.bet_index = 0
            self.status_message = ("Value picks only." if self.bet_picks_only
                                   else "Every upcoming game.")
        elif key in (10, 13, curses.KEY_ENTER):
            if rows:
                event = rows[clamp(self.bet_index, 0, len(rows) - 1)]["event"]
                self.selected_id = event["id"]
                self.sync_selection()
                self.tab = self.tabs.index("Scouting")
                self.scroll["Scouting"] = 0
        else:
            return False
        return True

    def open_book_picker(self):
        if self.league not in AN_LEAGUES:
            self.status_message = "Only ESPN's single line is available for this league."
            return
        items = [{"label": "Lines shown", "action": None},
                 {"label": "Top-3 average", "detail": " · ".join(self.top_books()),
                  "action": "avg"},
                 {"label": "Best price", "detail": "shop every book for each bet",
                  "action": "best"},
                 {"label": "One sportsbook", "action": None}]
        for _, name, _ in BOOKS:
            items.append({"label": name, "detail": "its lines and prices only", "action": name})
        cursor = next((i for i, item in enumerate(items) if item["action"] == self.bet_book), 1)
        self.popup = Popup("Betting lines from", items, self.pick_book, cursor,
                           "enter picks · esc closes")

