# College baseball teams are the same schools as college football.
TEAM_COLOR_TABLES = {"nfl": NFL_COLORS, "nhl": NHL_COLORS, "cfb": CFB_COLORS,
                     "mlb": MLB_COLORS, "cbase": CFB_COLORS, "ahl": AHL_COLORS,
                     "nba": NBA_COLORS, "cbb": CFB_COLORS,
                     "owg": COUNTRY_COLORS, "osg": COUNTRY_COLORS}

NAME_KEYED = {"cfb", "cbase", "cbb"}


def norm_name(text):
    """Lowercase, strip punctuation, collapse whitespace. 'Texas A&M' -> 'texas am'."""
    text = clean(text).lower()
    text = (text.replace("é", "e").replace("ô", "o").replace("ü", "u")
            .replace("ç", "c").replace("ã", "a").replace("í", "i"))
    text = re.sub(r"[^a-z0-9 ]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def team_color(league, team, overrides=None):
    """Primary colour for a team, as '#RRGGBB', or '' when nothing is known.

    Order: config override, the tables above, then ESPN's own team.color.
    """
    if not isinstance(team, dict):
        return ""
    league = family(league)
    abbr = str(team.get("abbr") or "").upper()
    if league in ("owg", "osg"):
        abbr = noc_code(team) or abbr
    table = TEAM_COLOR_TABLES.get(league, {})
    keys = []
    if league in NAME_KEYED:
        for field in ("location", "short", "name"):
            value = norm_name(team.get(field))
            if value:
                keys.append(value)
                if value.endswith(" state"):
                    keys.append(value)
        keys.append(norm_name(team.get("name", "")).replace(" university", ""))
    else:
        keys.append(abbr)

    if overrides:
        league_overrides = overrides.get(league) or {}
        lookup = {norm_name(k) if league in NAME_KEYED else str(k).upper(): v
                  for k, v in league_overrides.items()}
        for key in keys:
            if key in lookup:
                return str(lookup[key])

    for key in keys:
        if key in table:
            substitute = DARK_SUBSTITUTE.get(
                (league, key if league in NAME_KEYED else abbr))
            return substitute or table[key]

    espn = str(team.get("color") or "").strip().lstrip("#")
    if re.fullmatch(r"[0-9a-fA-F]{6}", espn):
        return "#" + espn.upper()
    return ""


