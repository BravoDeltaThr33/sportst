def split_scoring_plays(lines):
    """(the scoring plays' section, everything else) of basketball's Plays
    lines: the section runs from its 'Scoring plays' heading to the next
    heading or section (6.22.0)."""
    def is_head(line):
        return bool(getattr(line, "section", None)) or \
            (bool(line) and line[0][1] == "title" and bool(line.text.strip()))
    start = next((i for i, line in enumerate(lines) if is_head(line) and
                  line.text.strip().lower().startswith("scoring plays")), None)
    if start is None:
        return [], list(lines)
    end = next((i for i in range(start + 1, len(lines)) if is_head(lines[i])), len(lines))
    return list(lines[start:end]), list(lines[:start]) + list(lines[end:])


