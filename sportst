        elif "condensed game" in tags or title.lower().startswith("condensed game"):
            full.append(whole)
        elif "in game highlight" in tags and "pitching" not in tags \
                and "defense" not in tags:
            plays.append(clip)
    plays.sort(key=lambda c: c["at"])
    return {"plays": plays, "game": game, "full": full}


