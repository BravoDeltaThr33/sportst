def player_specs(league):
    if league == "ahl":
        return AHL_PLAYERS
    return {"football": FOOTBALL_PLAYERS, "basketball": BASKETBALL_PLAYERS,
            "hockey": HOCKEY_PLAYERS, "baseball": BASEBALL_PLAYERS}.get(sport_of(league), [])


def _sort_number(text):
    value = _num(str(text or "").replace(":", "."))
    return value if value is not None else -1e9


def player_section_lines(data, section, league, team, width, row_limit=None):
    """One section's table, its name in the header's first cell."""
    _, title, list_name, columns, limit, options = section
    athletes = data.get("athletes") or {}
    ids = [i for i in (data.get("lists") or {}).get(list_name) or [] if i in athletes]
    if options.get("sort"):
        key = tuple(options["sort"])
        ids.sort(key=lambda i: -_sort_number(athletes[i]["stats"].get(key)))
    rows = []
    for ident in ids:
        entry = athletes[ident]
        values = [entry["stats"].get((group, stat), "") or "-" for group, stat, _ in columns]
        if options.get("nonzero") and not any(_sort_number(v) > 0 for v in values
                                              if not v.endswith("%")):
            continue
        if all(v in ("-", "0", "0.0", ".000", "0.00") for v in values):
            continue
        label = entry["name"] + (f" {entry['pos']}" if entry.get("pos") else "")
        rows.append([label] + values)
    rows = rows[: row_limit or limit]
    if not rows:
        return []
    table = fitted_table([title] + [label for _, _, label in columns], rows, width,
                         ["<"] + [">"] * len(columns), ["normal"] * len(rows))
    if table and len(table[0]):
        text, _ = table[0][0]
        table[0][0] = (text, THEME.style(league, team, bold=True, fallback="accent"))
    return list(table) + [blank()]


def side_by_side(blocks, width, gap=3):
    """Lay tables out left to right while they fit, wrapping to a new band."""
    out = []
    band, band_width = [], 0
    for block in blocks:
        if not block:
            continue
        block_width = max(sum(len(t) for t, _ in line) for line in block)
        if band and band_width + gap + block_width > width:
            out.extend(_join_band(band, gap))
            band, band_width = [], 0
        band.append((block, block_width))
        band_width += block_width + (gap if band_width else 0)
    if band:
        out.extend(_join_band(band, gap))
    return out


def _join_band(band, gap):
    height = max(len(block) for block, _ in band)
    lines = []
    for row in range(height):
        line = Line()
        for index, (block, block_width) in enumerate(band):
            cell = block[row] if row < len(block) else Line()
            used = sum(len(t) for t, _ in cell)
            line.extend_spans(cell)
            if index < len(band) - 1:
                line.add(" " * (block_width - used + gap), "normal")
        lines.append(line)
    return lines


def render_team_players(data, league, team, pane_width, full_width):
    """(left, right, bottom) line lists for one team's players."""
    specs = player_specs(league)
    left, right, bottom_blocks = [], [], []
    for section in specs:
        where = section[0]
        if where == "bottom":
            options = section[5]
            lines = player_section_lines(data, section, league, team, full_width)
            if options.get("split") and len(lines) > 8:
                # a long table goes into two columns side by side
                body = lines[1:-1]
                half = (len(body) + 1) // 2
                first = [lines[0]] + body[:half]
                second = [lines[0]] + body[half:]
                block_width = max(sum(len(t) for t, _ in l) for l in first)
                if block_width * 2 + 3 <= full_width:
                    bottom_blocks.extend([first, second])
                    continue
            bottom_blocks.append([l for l in lines if l])
        else:
            lines = player_section_lines(data, section, league, team, pane_width)
            (left if where == "left" else right).extend(lines)
    bottom = side_by_side(bottom_blocks, full_width)
    return left, right, bottom


