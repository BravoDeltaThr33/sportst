def standings_season_name(data):
    """'2025-26' from a standings payload, if it says."""
    root = dig(data, "content", "standings", default=data) if isinstance(data, dict) else {}
    node = root
    while isinstance(node, dict):
        name = dig(node, "standings", "seasonDisplayName")
        if name:
            return clean(name)
        children = node.get("children") or []
        node = children[0] if children else None
    return clean(dig(root, "season", "displayName", default=""))


def standings_unplayed(data):
    """The season year of a standings payload in which nobody has played a
    game yet, or None."""
    if not isinstance(data, dict):
        return None
    groups = []
    walk_standings(dig(data, "content", "standings", default=data) or data, [], groups)
    played = 0
    for _, entries in groups:
        for entry in entries:
            table = stat_lookup(entry)
            for key in ("wins", "losses", "gamesPlayed"):
                try:
                    played += int(float(stat_display(table, [key]) or 0))
                except ValueError:
                    pass
    if not groups or played:
        return None
    year = dig(data, "season", "year")
    return year if isinstance(year, int) else None


def stat_lookup(entry):
    table = {}
    for stat in entry.get("stats") or []:
        for key in ("name", "abbreviation", "type", "shortDisplayName"):
            value = stat.get(key)
            if value and value not in table:
                table[value] = stat
    return table


def stat_display(table, names):
    for name in names:
        stat = table.get(name)
        if stat is None:
            continue
        display = stat.get("displayValue")
        if display in (None, ""):
            value = stat.get("value")
            display = "" if value is None else str(value)
        display = clean(display)
        if re.fullmatch(r"-?\d+\.0", display) and name in ("points", "wins", "losses"):
            display = display[:-2]
        return display
    return "-"


def walk_standings(node, path, out):
    """Both the v2 API and the cdn core payload nest the same way."""
    if not isinstance(node, dict):
        return
    name = clean(node.get("name") or node.get("displayName") or node.get("shortName") or "")
    here = path + [name] if name else path
    entries = dig(node, "standings", "entries", default=None)
    if entries:
        out.append((" — ".join(p for p in here if p) or "Standings", entries))
    for key in ("children", "groups"):
        children = node.get(key)
        if isinstance(children, list):
            for child in children:
                walk_standings(child, here, out)


def entry_team(entry):
    team = entry.get("team") or {}
    return {
        "id": str(team.get("id", "")),
        "abbr": clean(team.get("abbreviation") or ""),
        "name": clean(team.get("displayName") or team.get("name") or "?"),
        "short": clean(team.get("shortDisplayName") or ""),
        "location": clean(team.get("location") or ""),
        "color": clean(team.get("color") or ""),
    }


def standings_name(league, team):
    """College tables use the school ('Mississippi State'); the pros use the
    full name ('Buffalo Bills')."""
    if league in COLLEGE_LEAGUES:
        return team["location"] or team["short"] or team["name"]
    return team["name"]


def group_titles(titles):
    """ESPN nests groups ('FBS — Southeastern Conference'). The last part is
    enough unless two groups would then share a name."""
    last = [t.split(" — ")[-1] for t in titles]
    return [short if last.count(short) == 1 else title
            for short, title in zip(last, titles)]


def flow_columns(blocks, width, gap=4):
    """Lay blocks of lines out newspaper-style: as many columns as fit, each
    block dropped into whichever column is shortest so far. Blocks keep
    their order, so the first ones (favourites) land top-left."""
    if not blocks:
        return []
    col_width = max(max((len(line.text) for line in block), default=0) for block in blocks)
    count = max(1, min(len(blocks), (width + gap) // (col_width + gap)))
    columns = [[] for _ in range(count)]
    for block in blocks:
        target = min(range(count), key=lambda i: (len(columns[i]), i))
        if columns[target]:
            columns[target].append(blank())
        columns[target].extend(block)
    lines = []
    for row in range(max(len(c) for c in columns)):
        line = Line()
        for index, column in enumerate(columns):
            part = column[row] if row < len(column) else Line()
            if index < count - 1:
                part = Line(list(part)).pad(col_width + gap)
            line.extend(part)
        lines.append(line)
    return lines


def render_standings(data, league, width, favorites, group_filter="", text=""):
    if not isinstance(data, dict):
        return [Line().add("No standings data.", "dim")]

    root = data
    if "content" in data:
        root = dig(data, "content", "standings", default=data) or data

    groups = []
    walk_standings(root, [], groups)
    if not groups:
        for key in ("children", "groups"):
            for child in root.get(key) or []:
                walk_standings(child, [], groups)
    if not groups:
        return [Line().add("Standings are not available for this league right now.", "dim")]
    if group_filter:
        groups = [(title, entries) for title, entries in groups
                  if group_filter in [GROUP_ALIASES.get(p, p) for p in title.split(" — ")]]
    if text:
        groups = [(title, [e for e in entries if team_matches_text(entry_team(e), text)])
                  for title, entries in groups]
        groups = [(title, entries) for title, entries in groups if entries]
    if not groups:
        return [Line().add("No team matches the filter. c changes the conference or "
                           "division, / the search (an empty search clears it).", "dim")]

    # A division's own order is the standing, so rows stay put. What moves is
    # the division: any group holding a favourite is drawn first.
    if league in ("nba", "cbb"):
        # ESPN sends these tables in no useful order: best record first,
        # conference record first for college
        def record_pct(text):
            match = re.match(r"(\d+)-(\d+)", text or "")
            if not match:
                return 0.0
            wins, losses = int(match.group(1)), int(match.group(2))
            return wins / (wins + losses) if wins + losses else 0.0

        def order(entry):
            table = stat_lookup(entry)
            try:
                overall = float(stat_display(table, ["winPercent"]))
            except ValueError:
                overall = 0.0
            if league == "cbb":
                return (-record_pct(stat_display(table, ["vs. Conf.", "vsconf"])), -overall)
            return (-overall,)
        groups = [(title, sorted(entries, key=order)) for title, entries in groups]
    decorated = []
    for position, (title, entries) in enumerate(groups):
        ranks = [fav_rank(favorites, league, entry_team(e)) for e in entries]
        ranks = [r for r in ranks if r >= 0]
        key = (0, min(ranks)) if ranks else (1, 0)
        decorated.append((key, position, title, entries))
    decorated.sort(key=lambda row: (row[0], row[1]))

    columns = standings_columns(league)
    titles = group_titles([row[2] for row in decorated])
    groups_rows = []
    for (_, _, _, entries), title in zip(decorated, titles):
        rows, styles, cells = [], [], {}
        for index, entry in enumerate(entries):
            team = entry_team(entry)
            starred = fav_rank(favorites, league, team) >= 0
            name = standings_name(league, team)
            label = f"{STAR} {name}" if starred else f"  {name}"
            table = stat_lookup(entry)
            rows.append([label] + [stat_display(table, names) for _, names in columns])
            styles.append("normal")
            cells[(index, 0)] = THEME.style(league, team, bold=starred)
        if rows:
            groups_rows.append((title, rows, styles, cells))

    # One set of column widths for every division, so stacked tables line up.
    headers = [""] + [label for label, _ in columns]
    aligns = ["<"] + [">"] * len(columns)
    widths = [len(h) for h in headers]
    for _, rows, _, _ in groups_rows:
        for row in rows:
            for index, value in enumerate(row):
                widths[index] = max(widths[index], len(value))
    headers = [f"{h:{a}{w}}" for h, a, w in zip(headers, aligns, widths)]
    tables = []
    for title, rows, styles, cells in groups_rows:
        rows = [[f"{v:{a}{w}}" for v, a, w in zip(row, aligns, widths)] for row in rows]
        tables.append((title, build_table(headers, rows, aligns=aligns,
                                          row_styles=styles, cell_styles=cells)))
    if not tables:
        return [Line().add("Standings are not available for this league right now.", "dim")]

    # every block the same width, so the columns line up
    block_width = max(max(len(line.text) for line in table) for _, table in tables)
    block_width = max(block_width, max(len(title) + 5 for title, _ in tables))
    block_width = min(block_width, width)
    blocks = []
    for title, table in tables:
        title = title[: max(1, block_width - 5)]
        head = Line().add("── ", "border").add(f"{title} ", "title")
        head.add("─" * max(0, block_width - len(title) - 4), "border")
        blocks.append([head] + table)
    return flow_columns(blocks, width)


