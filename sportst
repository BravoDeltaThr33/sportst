            return info_playoffs(league)
        return info_playoffs(league) + [info_championship(league)]
    if tab == "Betting":
        return info_betting(league)
    if tab == "Favorites":
        return info_favorites()
    return [("This screen", [_p("Nothing to explain here yet.")])]


def info_lines(sections, width):
    """The pop-up's text: headings, then each term with its explanation
    wrapped beside it."""
    term_width = min(20, max([len(term) for _, entries in sections
                              for term, _ in entries if term] + [6]) + 2)
    lines = []
    for heading_text, entries in sections:
        if heading_text:
            if lines:
                lines.append(blank())
            lines.append(Line().add(heading_text, "title"))
        for term, text in entries:
            if term is None:
                lines.extend(wrap_spans(text, width - 2, "normal", indent="  "))
                continue
            text = text or "-"
            if len(term) > term_width - 1:
                lines.append(Line().add(f"  {term}", "accent"))
                lines.extend(wrap_spans(text, width - term_width - 2, "dim",
                                        indent=" " * (term_width + 2)))
                continue
            chunks = wrap_spans(text, width - term_width - 2, "dim")
            first = Line().add(f"  {term:<{term_width}}", "accent")
            if chunks:
                first.extend_spans(chunks[0])
            lines.append(first)
            for chunk in chunks[1:]:
                lines.append(Line().add(" " * (term_width + 2), "normal").extend_spans(chunk))
    return lines


