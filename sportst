def about_sources(app, width):
    """Every data source and how this run's requests to it went."""
    lines = [Line().add(" all free, no sign-up · bright: used by this league", "muted")]
    stats = NET.snapshot()
    league = app.league
    fam = family(league)
    name_width = max(len(name) for _, name, _, _ in DATA_SOURCES) + 1
    now = time.time()
    for host, name, purpose, leagues in DATA_SOURCES:
        entry = stats.get(host)
        used = league in leagues or fam in leagues
        if entry is None:
            dot, dot_style = "○", "muted"
        elif entry["last_ok"]:
            dot, dot_style = "●", "good"
        else:
            dot, dot_style = "●", "bad"
        line = Line().add(f" {dot} ", dot_style)
        line.add(f"{name:<{name_width}}", "bold" if used else "dim")
        if entry:
            state = f"{entry['ok']} ok"
            if entry["fail"]:
                state += f" · {entry['fail']} failed"
            state += f" · {entry['ms']} ms · {_ago(time.time() - entry['at'])}"
            line.add(state, "normal" if used else "muted")
        else:
            line.add("not used yet", "muted")
        lines.append(line)
        text = f"{host} - {purpose}"
        for chunk in wrap_spans(text, max(10, width - 4), "muted"):
            lines.append(Line().add("   ", "normal").extend_spans(chunk))
        if entry and entry["fail"] and entry["error"] and now - entry["error_at"] < 3600:
            lines.append(Line().add(f"   last failure: {entry['error']} "
                                    f"({_ago(time.time() - entry['error_at'])})", "warn"))
    other = sorted(set(stats) - {h for h, _, _, _ in DATA_SOURCES})
    for host in other:
        entry = stats[host]
        lines.append(Line().add(" ● " if entry["last_ok"] else " ● ",
                                "good" if entry["last_ok"] else "bad")
                     .add(f"{host:<{name_width}}", "dim")
                     .add(f"{entry['ok']} ok · {entry['fail']} failed", "muted"))
    lines.append(blank())
    lines.extend(wrap_spans("Data: ESPN, MLB, NHL, HockeyTech, NCAA, Action Network, "
                            "Kalshi and Wikipedia, read through their public endpoints. "
                            "Not affiliated with any of them.", width, "muted", " "))
    return lines


def about_problems(app, width):
    """The requests that failed lately and have not worked since."""
    errors = sorted(app.fetcher.errors.items(), key=lambda item: -item[1][1])[:10]
    if not errors:
        return [Line().add(" none: every request is working", "good")]
    lines = []
    for _, (text, at) in errors:
        lines.extend(Line().add(" ", "normal").extend_spans(chunk) for chunk in
                     wrap_spans(f"{text} ({_ago(time.time() - at)})", max(10, width - 2),
                                "warn"))
    return lines


def about_controls(app, width):
    """Every key, as the ? screen lists them."""
    lines = [Line().add(" ? shows these anywhere", "muted")]
    key_width = 16
    for key, text in HELP_TEXT:
        if not key and not text:
            continue
        if not text:
            lines.append(Line().add(f"  {key}", "accent"))
            continue
        chunks = wrap_spans(text, max(10, width - key_width - 4), "dim")
        lines.append(Line().add(f"   {key:<{key_width}}", "normal").extend_spans(chunks[0]))
        for chunk in chunks[1:]:
            lines.append(Line().add(" " * (key_width + 3), "normal").extend_spans(chunk))
    return lines


def about_options(app, width):
    """Every command-line option, as sportst --help prints them."""
    lines = [Line().add(" sportst --help prints these too", "muted")]
    options = cli_options()
    column = min(28, max(len(flags) for flags, _ in options) + 2)
    for flags, text in options:
        chunks = wrap_spans(text, max(10, width - column - 4), "dim")
        lines.append(Line().add(f"   {flags:<{column}}", "normal").extend_spans(chunks[0]))
        for chunk in chunks[1:]:
            lines.append(Line().add(" " * (column + 3), "normal").extend_spans(chunk))
    return lines


def cli_options():
    """(option strings, help) for every command-line flag."""
    out = []
    for action in make_parser()._actions:
        if not action.option_strings or action.help == argparse.SUPPRESS:
            continue
        flags = ", ".join(action.option_strings)
        if action.metavar:
            flags += f" {action.metavar}"
        elif action.nargs != 0 and action.dest not in ("help", "version"):
            flags += " " + action.dest.upper()
        text = (action.help or "").split(":")[0] if action.dest == "league" else \
            (action.help or "")
        out.append((flags, text))
    return out


