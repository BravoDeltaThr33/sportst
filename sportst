    # -- a team's roster (the team page, M) ---------------------------------------

    ROSTER_WAIT = 0.35        # a player's card is asked for once the pick rests this long

    def open_roster(self, team):
        """The team's roster on a card over its page: the players down a thin
        list on the left, the picked one's card on the right."""
        self.roster = {"team": dict(team), "league": self.league, "cursor": 0, "offset": 0,
                       "scroll": 0, "due": time.monotonic(), "box": None}

    def roster_data(self):
        """(the roster's groups, its fetch) for the open card."""
        roster = self.roster
        team, league = roster["team"], roster["league"]
        if league == "ahl":
            result = self.fetcher.get(("ahlroster", team["id"]),
                                      Loader("lscluster.hockeytech.com", ahl_roster,
                                             team["id"]), ttl=3600)
            return (result.data or []), result
        result = self.load_roster(team)
        return roster_groups(result.data, league) if result.data else [], result

    def roster_players(self, groups):
        """[(line kind, heading or player)] down the list: a heading, then its
        players."""
        rows = []
        for heading, players in groups:
            rows.append(("head", heading))
            rows.extend(("player", player) for player in players)
        return rows

    def handle_roster_key(self, key):
        roster = self.roster
        groups, _ = self.roster_data()
        players = [player for _, members in groups for player in members]
        count = len(players)
        if key in (27, ord("q"), ord("m"), curses.KEY_BACKSPACE, 127, 8):
            self.roster = None
            return True
        if key == curses.KEY_RESIZE:
            self.apply_background()
            return True
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_HOME: -10 ** 6, ord("g"): -10 ** 6, curses.KEY_END: 10 ** 6,
                 ord("G"): 10 ** 6}
        if key in moves and count:
            roster["cursor"] = clamp(roster["cursor"] + moves[key], 0, count - 1)
            roster["scroll"] = 0
            roster["due"] = time.monotonic() + self.ROSTER_WAIT
            return True
        if key in (9, curses.KEY_BTAB, 353) and groups:
            # the first player of the next / previous group
            starts, at = [], 0
            for _, members in groups:
                starts.append(at)
                at += len(members)
            now = roster["cursor"]
            if key == 9:
                later = [s for s in starts if s > now]
                roster["cursor"] = later[0] if later else starts[0]
            else:
                earlier = [s for s in starts if s < now]
                roster["cursor"] = earlier[-1] if earlier else starts[-1]
            roster["scroll"] = 0
            roster["due"] = time.monotonic() + self.ROSTER_WAIT
            return True
        page = max(1, (roster.get("view") or 10) - 2)
        steps = {ord("J"): page, curses.KEY_NPAGE: page, ord(" "): page,
                 ord("K"): -page, curses.KEY_PPAGE: -page}
        if key in steps:
            roster["scroll"] = max(0, roster["scroll"] + steps[key])
            return True
        if key in (ord("w"), ord("W")) and count:
            player = players[clamp(roster["cursor"], 0, count - 1)]
            card = self.fetcher.get(*player_card_source(roster["league"], player,
                                                        roster["team"]), ttl=6 * 3600).data
            url = (card or {}).get("url")
            if url:
                open_in_browser(url)
                self.status_message = f"Opening {player['name']}'s page in your browser."
            else:
                self.status_message = "No page of his to open."
            return True
        return True

    def click_roster_player(self, index, open_it=False):
        roster = self.roster
        if roster is None:
            return False
        roster["cursor"] = index
        roster["scroll"] = 0
        roster["due"] = time.monotonic()
        return False

    def roster_hints(self):
        hints = [("j/k", "player"), ("tab", "next group")]
        if self.roster and not self.roster.get("fits", True):
            hints.append(("J/K", "scroll his card"))
        return hints + [("w", "his page"), ("esc", "close")]

    def draw_roster(self, height, width):
        """The roster card: a thin list of the players on the left (by side of
        the ball or position), the picked one's card on the right - his photo
        where the terminal shows pictures, who he is, the latest note on him,
        his numbers, his last games, his awards and his teams."""
        roster = self.roster
        team, league = roster["team"], roster["league"]
        groups, result = self.roster_data()
        players = [player for _, members in groups for player in members]
        box_w = max(20, width - 2)
        box_h = max(8, height - 2)
        top, left = 0, max(0, (width - box_w) // 2)
        for row in range(box_h):
            self.put(top + row, left, " " * box_w, self.palette("normal"))
        name = team.get("name") or team.get("abbr") or "Team"
        self.draw_box(top, left, box_h, box_w, f"{name} · roster", "title")
        roster["box"] = (top, left, box_h, box_w)
        inner_h = box_h - 2
        if not players:
            text = "Loading the roster…" if result.loading or result.data is None and \
                not result.error else (f"Could not load the roster: {result.error}"
                                       if result.error else "No roster on file.")
            self.draw_lines(wrap_spans(text, box_w - 4, "dim"), top + 1, left + 2, inner_h,
                            box_w - 4, 0)
            return
        roster["cursor"] = clamp(roster["cursor"], 0, len(players) - 1)
        picked = players[roster["cursor"]]
        list_w = clamp(box_w * 24 // 100, 24, 34)
        # the list: headings and players, the picked one kept in view
        lines, at, index = [], {}, 0
        for heading, members in groups:
            if lines:
                lines.append(blank())
            lines.append(Line().add(f" {heading}", "header"))
            for player in members:
                chosen = index == roster["cursor"]
                base = "sel" if chosen else "normal"
                line = Line().add("▌" if chosen else " ", "selbar" if chosen else "normal")
                line.add(f"{player['jersey']:>3} ", "seldim" if chosen else "muted")
                pos = player["pos"]
                room = list_w - 6 - len(pos) - 1
                line.add(f"{player['name'][:room]:<{room}} ", base)
                line.add(pos, "seldim" if chosen else "dim")
                line.pad(list_w - 1, base if chosen else "normal")
                at[index] = len(lines)
                lines.append(line)
                index += 1
        view = inner_h
        offset = roster["offset"]
        line_at = at[roster["cursor"]]
        if line_at < offset + 1:
            offset = max(0, line_at - 2)
        elif line_at >= offset + view - 1:
            offset = line_at - view + 2
        offset = roster["offset"] = clamp(offset, 0, max(0, len(lines) - view))
        self.draw_lines(lines, top + 1, left + 1, view, list_w - 1, offset)
        self.draw_scrollbar(top + 1, left + list_w, view, len(lines), offset)
        for number, line_index in at.items():
            shown = line_index - offset
            if 0 <= shown < view:
                self.hot(top + 1 + shown, left + 1, left + list_w,
                         lambda i=number: self.click_roster_player(i))
        self.wheel(top + 1, top + 1 + view, left + 1, left + list_w, ord("j"), ord("k"), 1)
        for row in range(inner_h):
            self.put(top + 1 + row, left + list_w + 1, "│", self.palette("border"))
        # the card: boxes packed to fit (roster_card_layout), J / K when it runs long
        x = left + list_w + 2
        card_w = box_w - list_w - 4
        card, note = None, ""
        result = None
        if time.monotonic() >= roster["due"]:
            result = self.fetcher.get(*player_card_source(league, picked, team),
                                      ttl=6 * 3600)
            card = result.data
        if card is None:
            note = (f"No card for him: {result.error}" if result is not None and
                    result.error and not result.loading else "Loading his card…")
        ref = {"id": picked["id"], "headshot": (card or {}).get("photo") or picked["photo"],
               "jersey": picked["jersey"], "team": team}
        size = ROSTER_PHOTO if inner_h >= 30 else (12, 5) if inner_h >= 18 else None
        photo = self.player_photo(league, ref, card, *size) if size else []
        key = (picked["id"], id(card), card_w, inner_h, self.corners(), note,
               tuple(tuple(line) for line in photo))
        kept = roster.get("layout")
        if kept and kept[0] == key:
            rows, fits = kept[1], kept[2]
        else:
            rows, fits = roster_card_layout(card, picked, league, team, card_w, inner_h,
                                            photo, self.corners(), note)
            roster["layout"] = (key, rows, fits)
        roster["fits"] = fits
        roster["view"] = inner_h
        roster["scroll"] = 0 if fits else clamp(roster["scroll"], 0,
                                                 max(0, len(rows) - inner_h))
        self.draw_lines(rows, top + 1, x, inner_h, card_w, roster["scroll"])
        if not fits:
            self.draw_scrollbar(top + 1, left + box_w - 2, inner_h, len(rows),
                                roster["scroll"])
        self.wheel(top + 1, top + 1 + inner_h, left + list_w + 1, left + box_w - 1,
                   ord("J"), ord("K"), 1)

    # -- Ask Kim ($ on the Betting tab) -----------------------------------

    def open_kim(self):
        if self.tab_name != "Betting":
            self.status_message = ("Ask Kim is on the Betting tab: press 9, then $."
                                   if "Betting" in self.tabs else
                                   "Ask Kim needs betting lines; the Olympics have none.")
            return
        if self.league not in BET_LEAGUES:
            self.status_message = "Ask Kim covers the leagues with betting lines."
            return
        self.kim = {"league": self.league, "opened": time.time(), "result": None,
                    "talk": None, "done": False, "scroll": 0, "backdrop": None,
                    "games": None}
