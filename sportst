    def prepare_events(self, data):
        events = parse_scoreboard(data) if data else []
        if is_olympic(self.league):
            # a whole tournament in one list: the day goes in front of the status
            for event in events:
                when = parse_iso(event["date"])
                day = when.astimezone().strftime("%b %-d") if when else ""
                if event["state"] == "pre":
                    event["label"] = f"{day} {local_time(event['date'])}".strip()
                else:
                    event["label"] = f"{day} {event['detail']}".strip()
            return events
        if BETTING.enabled and self.league in BETTING_LEAGUES:
            attach_lines(events, self.league, self.book, self.core_line,
                         self.selected_id)
            self.announce_upsets(events)
        return events

    def announce_upsets(self, events):
        live = [e for e in events if e.get("upset") and e["upset"]["level"] == "live"]
        fresh = []
        for event in live:
            key = (self.league, event["id"], event["upset"]["tag"])
            if key not in self.alerted:
                self.alerted.add(key)
                fresh.append(event)
        if not fresh:
            return
        if self.league not in self.alerts_primed:
            # first look at this slate: one summary rather than one per game
            self.alerts_primed.add(self.league)
            if len(fresh) == 1:
                self.flash_upset(fresh[0])
            else:
                self.status_message = f"▲ {len(fresh)} games on upset watch — press u"
                self.status_style = "upset"
        else:
            self.flash_upset(fresh[-1])
        if BETTING.bell:
            try:
                curses.beep()
            except curses.error:
                pass

    def flash_upset(self, event):
        upset = event["upset"]
        self.status_message = (f"▲ {upset['tag']}: {event['short_name']}  "
                               f"{upset['note']}  ({status_text(event)})")
        self.status_style = "upset"

    def at_bat_count(self):
        """How many at-bats the selected game has on record right now."""
        event = self.current_event()
