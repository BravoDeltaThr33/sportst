    "nba": r"^nba\s*-\s*(winner|championship)", "cbb": r"ncaa\(b\).*(winner|national champ)",
    "nhl": r"stanley cup", "mlb": r"world series",
}
FUTURES_SKIP = r"conference|division|regular|mvp|award|trophy|final 4|final four|to make|" \
               r"in-season|east|west|league\s*-"
BOOK_SHORT_NAMES = {"DraftKings": "DK", "ESPN BET": "EBET", "FanDuel": "FD",
                    "BetMGM": "MGM", "Caesars": "CZR"}


def futures_season(league):
    """The season label ESPN files this year's futures under."""
    today = Date.today()
    sport = sport_of(league)
    if sport in ("basketball", "hockey"):
        return today.year + 1 if today.month >= 8 else today.year
    if sport == "football":
        return today.year if today.month >= 3 else today.year - 1
    return today.year + 1 if today.month >= 11 else today.year


def american_to_prob(text):
    value = _num(str(text or "").replace("+", ""))
    if value is None or value == 0:
        return None
    return 100.0 / (value + 100.0) if value > 0 else -value / (-value + 100.0)


def prob_to_american(prob):
    if not prob or prob <= 0 or prob >= 1:
        return ""
    if prob >= 0.5:
        return f"-{round(prob / (1 - prob) * 100)}"
    return f"+{round((1 - prob) / prob * 100)}"


def kalshi_champions(league, timeout=15):
    """Kalshi's open championship market for a league:
    {'teams': [{'name', 'abbr', 'prob'}], 'title', 'at'}."""
    url = f"{KALSHI_API}?" + urllib.parse.urlencode(
        {"series_ticker": KALSHI_CHAMPIONS[league], "status": "open", "limit": "1000"})
    data = http_json(url, timeout)
    events = {}
    for market in data.get("markets") or []:
        events.setdefault(market.get("event_ticker") or "", []).append(market)
    if not events:
        return {"teams": [], "title": "", "at": time.time()}
    # the current season's market is the one that settles first
    ticker = min(events, key=lambda t: min(str(m.get("close_time") or "9")
                                           for m in events[t]))
    teams = []
    for market in events[ticker]:
        bid = _num(market.get("yes_bid_dollars"))
        ask = _num(market.get("yes_ask_dollars"))
        last = _num(market.get("last_price_dollars"))
        if bid and ask and ask - bid <= 0.10:
            prob = (bid + ask) / 2
        elif last:
            prob = last
        elif bid:
            prob = bid
        else:
            prob = (ask or 0) / 2
        teams.append({"name": clean(market.get("yes_sub_title") or ""),
                      "abbr": (market.get("ticker") or "").rsplit("-", 1)[-1],
                      "prob": prob or 0.0})
    return {"teams": teams, "title": clean(events[ticker][0].get("title") or ""),
            "at": time.time()}


def espn_champion_futures(league, timeout=15):
    """A sportsbook's championship prices from ESPN's futures feed:
    {'provider', 'title', 'teams': [{'id', 'odds', 'prob'}]}."""
    meta = LEAGUES[league]
    year = futures_season(league)
    url = (f"https://sports.core.api.espn.com/v2/sports/{meta['sport']}/leagues/"
           f"{meta['path']}/seasons/{year}/futures?limit=100")
    data = http_json(url, timeout)
    pattern = FUTURES_PATTERN.get(league)
    chosen = None
    for item in data.get("items") or []:
        name = clean(item.get("name") or "")
        low = name.lower()
        if pattern and re.search(pattern, low) and not re.search(FUTURES_SKIP, low):
            chosen = item
            break
    if not chosen:
        return {"provider": "", "title": "", "teams": []}
    boards = [f for f in chosen.get("futures") or [] if f.get("books")]
    if not boards:
        return {"provider": "", "title": "", "teams": []}
    board = next((f for f in boards if dig(f, "provider", "name", default="") == "DraftKings"),
                 boards[0])
    teams = []
    for book in board.get("books") or []:
        ref = dig(book, "team", "$ref", default="") or ""
        found = re.search(r"/teams/(\d+)", ref)
        prob = american_to_prob(book.get("value"))
        if found and prob:
            teams.append({"id": found.group(1), "odds": clean(str(book.get("value"))),
                          "prob": prob})
    return {"provider": clean(dig(board, "provider", "name", default="")),
            "title": clean(chosen.get("name") or ""), "teams": teams}


KALSHI_ALIASES = {"north carolina st.": "NC State", "north carolina st": "NC State",
                  "miami (fl)": "Miami", "miami (oh)": "Miami (OH)", "ole miss": "Ole Miss",
                  "southern california": "USC", "louisiana st.": "LSU"}


def _kalshi_match(team, entry):
    alias = KALSHI_ALIASES.get(entry["name"].lower())
    names = [entry["name"], re.sub(r"\s*\(.*?\)", "", entry["name"])] + ([alias] if alias
                                                                           else [])
    return _team_matches(team, names, entry["abbr"])


def championship_board(league, teams, kalshi=None, book=None, estimate=None):
    """Blend the sources into rows, most likely champion first:
    [{'team', 'chance', 'market', 'odds', 'book'}]."""
    rows = {t["id"]: {"team": t, "market": None, "book": None, "odds": "", "estimate": None}
            for t in teams}
    if kalshi and kalshi.get("teams"):
        total = sum(e["prob"] for e in kalshi["teams"]) or 1.0
        for entry in kalshi["teams"]:
            team = next((t for t in teams if _kalshi_match(t, entry)), None)
            if team and team["id"] in rows and entry["prob"] > 0:
                rows[team["id"]]["market"] = entry["prob"] / total
    if book and book.get("teams"):
        total = sum(e["prob"] for e in book["teams"]) or 1.0
        for entry in book["teams"]:
            if entry["id"] in rows:
                rows[entry["id"]]["book"] = entry["prob"] / max(total, 1.0)
                rows[entry["id"]]["odds"] = entry["odds"]
    if estimate:
        for ident, prob in estimate.items():
            if ident in rows:
                rows[ident]["estimate"] = prob
    out = []
    for row in rows.values():
        values = [v for v in (row["market"], row["book"], row["estimate"]) if v]
        if not values:
            continue
        row["chance"] = sum(values) / len(values)
        out.append(row)
    total = sum(r["chance"] for r in out) or 1.0
    for row in out:
        row["chance"] /= total
    out.sort(key=lambda r: -r["chance"])
    return out


def ahl_estimate(standings):
    """A rough Calder Cup chance from the standings: points percentage,
    pulled toward .500 early in the season, turned into odds."""
    raw = {}
    for ident, (team, table, _path) in standings_rows(standings).items():
        wins = _st_number(table, "wins") or 0
        losses = _st_number(table, "losses") or 0
        extra = _st_number(table, "otLosses", "ties") or 0
        games = wins + losses + extra
        rating = (wins + 0.5 * extra + 5.0) / (games + 10.0)
        raw[ident] = math.exp(9.0 * rating)
    total = sum(raw.values()) or 1.0
    return {ident: value / total for ident, value in raw.items()}


def cbase_estimate(poll, teams):
    """A rough College World Series chance from the D1Baseball Top 25: the
    ranked teams share most of it, by rank."""
    ranks = (poll or {}).get("ranks") or {}
    raw = {}
    for team in teams:
        rank = next((ranks[k] for k in (norm_name(team.get(f) or "")
                                        for f in ("location", "name", "short"))
                     if k in ranks), None)
        if rank:
            raw[team["id"]] = math.exp(-(rank - 1) / 6.0)
    total = sum(raw.values()) or 1.0
    return {ident: 0.85 * value / total for ident, value in raw.items()}


_EIGHTHS = " ▏▎▍▌▋▊▉"


def hbar(fraction, width):
    """A bar `width` cells long at full, in eighths of a cell."""
    cells = max(0.0, min(1.0, fraction)) * width
    full = int(cells)
    rest = int(round((cells - full) * 8))
    if rest == 8:
        full, rest = full + 1, 0
    return "█" * full + (_EIGHTHS[rest] if rest and full < width else "")


def _ink(rgb_hex):
    """Black or white text, whichever reads on a colour."""
    rgb = hex_to_rgb(rgb_hex) or (0, 0, 0)
    light = 0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]
    return "000000" if light > 150 else "FFFFFF"


def render_championship(board, league, width, favorites, sources, note="", loading=False):
    """The odds panel: a share-of-the-field strip, then every contender with
    a bar, the blended chance, the market's price and the book's odds."""
    title = CHAMPIONSHIP_NAME.get(league, "championship")
    lines = [Line().add(f"Chances to win the {title}", "title")]
    if sources:
        lines.append(Line().add(" · ".join(sources), "muted"))
    if note:
        lines.extend(wrap_spans(note, width, "dim"))
    if not board:
        lines.append(Line().add("Loading the odds…" if loading else
                                "No championship odds are posted for this league yet.",
                                "dim"))
        return lines
    lines.append(blank())

    # the whole field as one strip: each contender's share, in its colours,
    # its abbreviation under the start of its stretch
    strip_width = max(10, width)
    strip, labels = Line(), Line()
    used = shown = 0
    for row in board:
        cells = int(round(row["chance"] * strip_width))
        if cells < 2 or used + cells > strip_width:
            break
        colour = THEME.color(league, row["team"]) or "#9C9691"
        strip.append(("█" * (cells - 1) + "▉", colour))
        abbr = row["team"]["abbr"]
        label_used = sum(len(t) for t, _ in labels)
        if (label_used == 0 or label_used < used) and len(abbr) <= cells:
            labels.append((" " * (used - label_used), "normal"))
            labels.append((abbr, THEME.style(league, row["team"], bold=True)))
        used += cells
        shown += 1
    if used < strip_width and shown < len(board):
        strip.append(("░" * (strip_width - used), "muted"))
    lines.append(strip)
    lines.append(labels)
    rest = len(board) - shown
    lines.append(Line().add(f"to scale: the top {shown} in colour"
                            + (f", the other {rest} in grey" if rest else ""), "muted"))
    lines.append(blank())

    has_market = any(r["market"] for r in board)
    has_book = any(r["book"] for r in board)
    book_name = next((s for s in sources if s in BOOK_SHORT_NAMES), "")
    book_head = BOOK_SHORT_NAMES.get(book_name, "book")
    name_width = clamp(width // 4, 12, 22)
    tail = (6 if has_market else 0) + (7 if has_book else 0)
    bar_width = max(6, width - (4 + 2 + name_width + 7 + 1 + tail))
    header = Line().add(f"{'#':>3} ", "header").add(f"  {'team':<{name_width}}", "header")
    header.add(f"{'chance':>7} ", "header").add(f"{'':<{bar_width}}", "normal")
    if has_market:
        header.add(f"{'mkt':>6}", "header")
    if has_book:
        header.add(f"{book_head:>7}", "header")
    lines.append(header)
    top = board[0]["chance"] or 1.0
    for place, row in enumerate(board, 1):
        if row["chance"] < 0.0005 and place > 12:
            rest = len(board) - place + 1
            lines.append(Line().add(f"    + {rest} more under 0.1%", "muted"))
            break
        team = row["team"]
        star = fav_rank(favorites, league, team) >= 0
        line = Line().add(f"{place:>3} ", "muted")
        line.add(STAR + " " if star else "  ", "star")
        name = (standings_name(league, team) if league in COLLEGE_LEAGUES
                else team.get("short") or team["name"])
        line.add(f"{name[:name_width]:<{name_width}}", THEME.style(league, team, bold=star))
        pct = row["chance"] * 100
        line.add(f"{pct:>6.1f}%" if pct >= 0.95 else f"{pct:>6.2f}%", "bold")
        line.add(" ", "normal")
        bar = hbar(row["chance"] / top, bar_width)
        line.add(f"{bar:<{bar_width}}", THEME.style(league, team, fallback="accent"))
        if has_market:
            market = row["market"]
            line.add(f"{market * 100:>5.0f}%" if market and market >= 0.005
                     else f"{'<1%' if market else '-':>6}", "dim")
        if has_book:
            line.add(f"{row['odds'] or '-':>7}", "dim")
        lines.append(line)
    return lines


