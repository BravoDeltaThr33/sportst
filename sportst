def parse_competitor(node):
    team = dig(node, "team", default={}) or {}
    rank = dig(node, "curatedRank", "current")
    if not isinstance(rank, int) or rank > 25:
        rank = None
    linescores = []
    for entry in dig(node, "linescores", default=[]) or []:
        value = entry.get("value") if isinstance(entry, dict) else entry
        if value is None:
            value = entry.get("displayValue") if isinstance(entry, dict) else None
        linescores.append(value)
    records = (dig(node, "records", default=None)
               or dig(node, "record", "items", default=None)
               or dig(node, "record", default=None) or [])
    if isinstance(records, dict):
        records = [records]
    record = ""
    for item in records:
        if not isinstance(item, dict):
            continue
        if item.get("type") in (None, "total") or item.get("name") == "overall":
            record = item.get("summary", "")
            break
    if not record and records and isinstance(records[0], dict):
        record = records[0].get("summary", "")
    score = node.get("score")
    try:
        score_num = int(float(score)) if score not in (None, "") else None
    except (TypeError, ValueError):
        score_num = None
    return {
        "id": str(team.get("id", "")),
        "color": clean(team.get("color") or ""),
        "alt_color": clean(team.get("alternateColor") or ""),
        "abbr": clean(team.get("abbreviation") or team.get("shortDisplayName") or "?"),
        "short": clean(team.get("shortDisplayName") or team.get("name") or ""),
        "name": clean(team.get("displayName") or team.get("location") or "?"),
        "location": clean(team.get("location") or ""),
        "score": score_num,
        "record": clean(record),
        "rank": rank,
        "winner": bool(node.get("winner")),
        "linescores": linescores,
        "home_away": node.get("homeAway", ""),
        "leaders": dig(node, "leaders", default=[]) or [],
        "logo": clean(team.get("logo") or dig(team, "logos", 0, "href", default="") or ""),
        "hits": node.get("hits"),
        "errors": node.get("errors"),
        "probable": dig(node, "probables", 0, "athlete", "displayName", default=""),
        "probable_record": dig(node, "probables", 0, "record", default=""),
    }


def parse_event(event):
    comp = dig(event, "competitions", 0, default={}) or {}
    competitors = comp.get("competitors") or []
    away, home = None, None
    for node in competitors:
        parsed = parse_competitor(node)
        if parsed["home_away"] == "home":
            home = parsed
        elif parsed["home_away"] == "away":
            away = parsed
    if home is None or away is None:
        parsed_all = [parse_competitor(c) for c in competitors]
        if len(parsed_all) != 2:
            return None
        away, home = parsed_all[0], parsed_all[1]

    status = dig(comp, "status", default=dig(event, "status", default={})) or {}
    state = dig(status, "type", "state", default="pre")
    if state == "pre":
        # ESPN reports 0-0 for games that have not started
        away["score"] = None
        home["score"] = None
    broadcasts = []
    for node in comp.get("broadcasts") or []:
        broadcasts.extend(node.get("names") or [])
    line_raw = None
    if BETTING.enabled:
        line_raw = pick_line(comp.get("odds") or [], away, home, BETTING.provider)

    return {
        "id": str(event.get("id", "")),
        "short_name": clean(event.get("shortName") or ""),
        "name": clean(event.get("name") or ""),
        "date": event.get("date"),
        "time_tba": comp.get("timeValid") is False,
        "state": state,
        "completed": bool(dig(status, "type", "completed", default=False)),
        "detail": clean(dig(status, "type", "shortDetail", default="")),
        "long_detail": clean(dig(status, "type", "detail", default="")),
        "period": dig(status, "period", default=0) or 0,
        "clock": clean(dig(status, "displayClock", default="")),
        "away": away,
        "home": home,
        "venue": clean(dig(comp, "venue", "fullName", default="")),
        "venue_city": clean(dig(comp, "venue", "address", "city", default="")),
        "neutral": bool(comp.get("neutralSite")),
        "indoor": bool(dig(comp, "venue", "indoor", default=False)),
        "broadcast": ", ".join(dict.fromkeys(clean(b) for b in broadcasts if b)),
        "line_raw": line_raw,
        "line": line_raw if state == "pre" else None,
        "line_source": "",
        "line_history": [],
        "upset": None,
        "situation": comp.get("situation") or {},
        "notes": [clean(n.get("headline", "")) for n in (comp.get("notes") or [])],
        "raw": event,
    }


def parse_scoreboard(data):
    events = []
    for raw in dig(data, "events", default=[]) or []:
        parsed = parse_event(raw)
        if parsed:
            events.append(parsed)
    events.sort(key=lambda e: (parse_iso(e["date"]) or datetime.max.replace(
        tzinfo=timezone.utc), e["short_name"]))
    return events


def ordinal(number):
    try:
        number = int(number)
    except (TypeError, ValueError):
        return str(number)
    if 10 <= number % 100 <= 20:
        return f"{number}th"
    return f"{number}{ {1: 'st', 2: 'nd', 3: 'rd'}.get(number % 10, 'th') }"


def period_labels(count, league):
    meta = LEAGUES[league]
    regulation = meta["regulation"]
    if meta["sport"] == "baseball":
        return [str(i + 1) for i in range(count)]
    labels = []
    hockey = meta["sport"] == "hockey"
    soccer = meta["sport"] == "soccer"
    for index in range(count):
        if index < regulation:
            labels.append(str(index + 1))
        elif soccer:
            labels.append({regulation: "ET1", regulation + 1: "ET2"}.get(index, "PK"))
        elif hockey and index == regulation:
            labels.append("OT")
        elif hockey and index == regulation + 1:
            labels.append("SO")
        elif index == regulation:
            labels.append("OT")
        else:
            labels.append(f"OT{index - regulation + 1}")
    return labels


def period_tag(league, number):
    """Q1..Q4 / P1..P3, then OT and SO rather than Q5 / P4."""
    meta = LEAGUES.get(league, LEAGUES["nfl"])
    try:
        number = int(number)
    except (TypeError, ValueError):
        return str(number)
    regulation = meta["regulation"]
    if meta["sport"] == "baseball":
        return ordinal(number)
    if meta["sport"] == "soccer":
        return {1: "1H", 2: "2H", 3: "ET1", 4: "ET2"}.get(number, "PK")
    if number <= regulation:
        return f"{meta['period']}{number}"
    if meta["sport"] == "hockey":
        return "OT" if number == regulation + 1 else "SO"
    return "OT" if number == regulation + 1 else f"OT{number - regulation}"


def status_style(event):
    if event["state"] == "in":
        return "live"
    if event["state"] == "post":
        return "final"
    return "dim"


def event_when(event, with_zone=False):
    """'Sat Oct 31, 2:30 PM' for a game, or 'Sat Oct 31 · time TBA' when ESPN
    has no kick-off time yet (it parks those at midnight Eastern, which is
    the evening before in the central and western time zones)."""
    when = parse_iso(event.get("date"))
    if not when:
        return ""
    if event.get("time_tba"):
        try:
            day = datetime.strptime(str(event["date"])[:10], "%Y-%m-%d")
            return day.strftime("%a %b %-d") + " · time TBA"
        except ValueError:
            pass
    return when.astimezone().strftime("%a %b %-d, %-I:%M %p" + (" %Z" if with_zone else ""))


def status_text(event):
    if event.get("label"):
        return event["label"]
    if event["state"] == "pre":
        if event.get("time_tba"):
            return "time TBA"     # ESPN parks these at midnight Eastern
        return local_time(event["date"]) or (event["detail"] or "Scheduled")
    return event["detail"] or event["long_detail"] or event["state"]


