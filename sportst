    def mlb_game_pk(self, event):
        """MLB's id for this game, from MLB's schedule for the day."""
        game_pk = self.game_pks.get(event["id"])
        if game_pk is not None:
            return game_pk
        when = parse_iso(event["date"])
        day = when.astimezone().date() if when else Date.today()
        for offset in (0, -1, 1):
            probe = day + timedelta(days=offset)
            result = self.fetcher.get(("mlbsched", probe.isoformat()),
                                      statcast_schedule_url(probe), ttl=3600)
            if not result.data:
                continue
            found = find_game_pk(result.data, event)
            if found:
                self.game_pks[event["id"]] = found
                return found
        return None

    def clip_sources(self, event, summary):
        """(one-play clips, game highlight, nhl.com goal links, loading) for a
        game, from whichever free source covers its league."""
        league = self.league
        loading = False
        plays, game, nhl_links = [], None, {}
        if league == "mlb":
            game_pk = self.mlb_game_pk(event)
            if game_pk:
                result = self.fetcher.get(("mlbclips", game_pk),
                                          Loader("statsapi.mlb.com", mlb_clips, game_pk),
                                          ttl=120 if event["state"] == "in" else 1800)
                loading = result.loading and not result.data
                if result.data:
                    plays, game = result.data["plays"], result.data["game"]
        elif league in YOUTUBE_CHANNELS:
            if self.config.get("youtube_clips", True):
                channel = YOUTUBE_CHANNELS[league]
                result = self.fetcher.get(("ytfeed", channel),
                                          Loader("www.youtube.com", youtube_feed, channel),
                                          ttl=300)
                loading = result.loading and not result.data
                entries = result.data or []
                plays = entries
                game = youtube_game_clip(entries, event)
        else:
            plays, game = espn_clips(summary)
            if league == "nhl" and event["state"] != "pre":
                when = parse_iso(event["date"])
                if when:
                    day = (when.astimezone(timezone.utc) - timedelta(hours=5)).date()
                    result = self.fetcher.get(
                        ("nhlclips", event["id"]),
                        Loader("api-web.nhle.com", nhl_goal_clips, day.isoformat(), event),
                        ttl=120 if event["state"] == "in" else 1800)
                    nhl_links = result.data or {}
        return plays, game, nhl_links, loading

    def match_play_clips(self, event, summary, refs):
        """{play index: clip} and the game's highlight clip. Every play gets
        something to open: its own clip, the NHL's goal page, or a YouTube
        search for it."""
        plays, game, nhl_links, loading = self.clip_sources(event, summary)
        texts = [re.sub(r"^(Even Strength|Power Play|Shorthanded|Short Handed|Empty Net)"
                        r"(, [^G]*)? Goal Scored by ", "",
                        clean(at_bat_text(ref) if "pitches" in ref else (ref.get("text") or "")))
                 for ref in refs]
        matched = assign_clips(texts, plays, team_words(event)) if plays else {}
        out = {}
        youtube = self.config.get("youtube_clips", True)
        for index, ref in enumerate(refs):
            clip = matched.get(index)
            if clip is None and nhl_links:
                number = dig(ref, "period", "number", default=0)
                clock = clean(dig(ref, "clock", "displayValue", default="")).lstrip("0")
                clip = nhl_links.get((_int(number), clock or "0:00"))
            if clip is None and youtube:
                clip = {"title": "a YouTube search for this play",
                        "url": play_search_url(event, self.league, texts[index]),
                        "kind": "search", "source": "YouTube", "seconds": 0}
            if clip is not None:
                out[index] = clip
        if game is None and youtube:
            game = {"title": "a YouTube search for this game's highlights",
                    "url": game_search_url(event, self.league), "kind": "search",
                    "source": "YouTube", "seconds": 0}
        return out, game, loading

    def decorate_plays(self, event, summary, panes, inner):
        """Mark each scoring play's clip (♪ plays here, ↗ opens the browser)
        and highlight the chosen one; keep it on screen. `panes` is a list of
        (title, lines); returns them changed in place."""
        refs, seen = [], set()
        for _, body in panes:
            for line in body:
                ref = getattr(line, "play_ref", None)
                if ref is not None and getattr(line, "play_first", False) \
                        and id(ref) not in seen:
                    seen.add(id(ref))
                    refs.append(ref)
        self._play_event = event["id"]
        self._play_refs = refs
        clips, game, loading = self.match_play_clips(event, summary, refs)
        if not refs:
            self._play_clips, self._game_clip = {}, game
            return panes
        self._play_clips, self._game_clip, self._clips_loading = clips, game, loading
        chosen = self.play_sel.get(event["id"])
        if chosen is not None:
            chosen = clamp(chosen, 0, len(refs) - 1)
            self.play_sel[event["id"]] = chosen
        index_of = {id(ref): i for i, ref in enumerate(refs)}
        playing = self.player and self.player.get("event") == event["id"] and \
            self.player.get("play")
        focus = None
        for pane_index, (_, body) in enumerate(panes):
            for line_index, line in enumerate(body):
                ref = getattr(line, "play_ref", None)
                if ref is None:
                    continue
                index = index_of.get(id(ref))
                selected = index == chosen
                if getattr(line, "play_first", False) and line and line[0][0] == "  ":
                    clip = clips.get(index)
                    mark = ""
                    if playing is not None and playing == index:
                        mark = "▶"
                    elif clip and clip["kind"] == "audio":
                        mark = "♪"
                    elif clip and clip["kind"] == "page":
                        mark = "↗"
                    line[0] = (f"{mark} " if mark else "  ",
                               "live" if mark == "▶" else "accent")
                if selected:
                    if focus is None:
                        focus = (pane_index, line_index)
                    restyled = [(text, _on_cursor(style)) for text, style in line]
                    line[:] = restyled
                    used = sum(len(t) for t, _ in line)
                    if used < inner:
                        line.append((" " * (inner - used), "sel"))
        if focus and self._play_follow:
            self._play_focus = focus
        return panes

    def follow_play(self, panes, height, width):
        """Scroll the Plays panes so the chosen play is in view, once, right
        after j / k picked it (J / K and PgDn still scroll freely)."""
        focus = getattr(self, "_play_focus", None)
        if not (focus and self._play_follow):
            return
        self._play_follow = False
        self._play_focus = None
        pane_index, line_index = focus
        view = height - 2
        if width < self.SPLIT_MIN_WIDTH and len(panes) > 1:
            position = 0
            for index, (_, body) in enumerate(panes):
                if index:
                    position += 1
                position += 1
                if index == pane_index:
                    position += line_index
                    break
                position += len(body)
            line_index = position
        offset = self.scroll["Plays"]
        if line_index < offset + 1:
            offset = max(0, line_index - 2)
        elif line_index >= offset + view - 1:
            offset = line_index - view + 3
        self.scroll["Plays"] = max(0, offset)

    def player_status(self):
        if not self.player:
            return ""
        return f"♪ {self.player['title']} · {self.player['source']} · x stops"

    def stop_clip(self, quiet=False):
        if self.player:
            try:
                self.player["proc"].terminate()
            except (OSError, AttributeError):
                pass
            self.player = None
            if not quiet:
                self.status_message = "Stopped."

    def poll_player(self):
        """Forget a clip once its player has finished."""
        if self.player and self.player["proc"].poll() is not None:
            self.player = None
            self.dirty = True

    def play_clip(self, clip, play_index=None):
        if not clip:
            self.status_message = "No clip for this play."
            return
        choice = str(self.config.get("clip_player", "auto") or "auto")
        if clip["kind"] == "audio" and choice != "browser":
            name, path = find_player(choice)
            if path:
                self.stop_clip(quiet=True)
                try:
                    proc = start_player(path, name, clip["url"],
                                        video=bool(self.config.get("clip_video", False)))
                except OSError as exc:
                    self.status_message = f"⚠ Could not start {name}: {exc}"
                    return
                self.player = {"proc": proc, "title": clip["title"], "source": clip["source"],
                               "event": getattr(self, "_play_event", None),
                               "play": play_index, "url": clip["url"]}
                self.status_message = ""
                return
            hint = " (install mpv to hear it here)" if choice == "auto" else \
                f" ({choice} is not installed)"
        else:
            hint = ""
        if open_in_browser(clip["url"]):
            what = {"search": "Searching YouTube", "page": "Opening"}.get(clip["kind"],
                                                                         "Opening")
            title = "" if clip["kind"] == "search" else f": {clip['title']}"
            self.status_message = f"↗ {what} in your browser{title}{hint}."
        else:
            self.status_message = f"⚠ No browser found to open {clip['url']}"

    def handle_plays_key(self, key):
        """Return True when the Plays tab has used the key: j / k pick a
        scoring play, enter plays its clip, y the game's highlights, x stops."""
        event = self.current_event()
        refs = self._play_refs if event and self._play_event == event["id"] else []
        if key in (ord("j"), curses.KEY_DOWN, ord("k"), curses.KEY_UP) and refs:
            current = self.play_sel.get(event["id"])
            step = 1 if key in (ord("j"), curses.KEY_DOWN) else -1
            if current is None:
                current = 0 if step > 0 else len(refs) - 1
            else:
                current = clamp(current + step, 0, len(refs) - 1)
            self.play_sel[event["id"]] = current
            self._play_follow = True
            clip = self._play_clips.get(current)
            if clip and clip["kind"] != "search":
                self.status_message = f"{'♪' if clip['kind'] == 'audio' else '↗'} " \
                                      f"{clip['title']} · enter " + \
                                      ("plays it" if clip["kind"] == "audio" else "opens it")
            return True
        if key in (ord("n"), ord("N")) and refs:
            have = sorted(i for i, c in self._play_clips.items() if c["kind"] != "search")
            if not have:
                self.status_message = ("Still looking for this game's clips…"
                                       if self._clips_loading else
                                       "No clips found for this game's plays.")
                return True
            current = self.play_sel.get(event["id"])
            if key == ord("n"):
                later = [i for i in have if current is None or i > current]
                target = later[0] if later else have[0]
            else:
                earlier = [i for i in have if current is not None and i < current]
                target = earlier[-1] if earlier else have[-1]
            self.play_sel[event["id"]] = target
            self._play_follow = True
            clip = self._play_clips[target]
            self.status_message = f"{'♪' if clip['kind'] == 'audio' else '↗'} " \
                                  f"{clip['title']} · enter " + \
                                  ("plays it" if clip["kind"] == "audio" else "opens it")
            return True
        if key in (10, 13, curses.KEY_ENTER) and refs:
            chosen = self.play_sel.get(event["id"])
            if chosen is None:
                self.status_message = "j / k pick a scoring play first."
                return True
            if self.player and self.player.get("play") == chosen and \
                    self.player.get("event") == event["id"]:
                self.stop_clip()
                return True
            self.play_clip(self._play_clips.get(chosen), chosen)
            return True
        if key == ord("y") and event:
            if self._play_event != event["id"]:
                self.status_message = "Still loading this game."
                return True
            self.play_clip(self._game_clip, None)
            return True
        if key == ord("x") and self.player:
            self.stop_clip()
            return True
        if key in (ord("J"), ord("K")):
            self.scroll["Plays"] = max(0, self.scroll["Plays"] + (3 if key == ord("J") else -3))
            return True
        return False

    def draw_play_panes(self, top, height, width, panes, event, summary):
        inner = self.pane_width(width)
        self.decorate_plays(event, summary, panes, inner)
        self.follow_play(panes, height, width)
        self.draw_two_panes(top, height, width, "Plays", panes)

