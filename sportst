            primary, spare = self.api.teams("cbase")
            catalog = self.fetcher.get(("teams", "cbase"), primary, ttl=86400,
                                       fallbacks=spare)
            ranks = (poll.data or {}).get("ranks") or {}
            ids = set()
            for node in dig(catalog.data, "sports", 0, "leagues", 0, "teams",
                            default=[]) or []:
                team = team_record(node.get("team") or {})
                if any(norm_name(team.get(k) or "") in ranks
                       for k in ("location", "name", "short")):
                    ids.add(team["id"])
