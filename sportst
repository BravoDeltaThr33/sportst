def open_view(line):
    """The opening numbers shaped like a line, so the same helpers read them."""
    opening = (line or {}).get("open") or {}
    if not opening:
        return None
    view = {
        "spread": opening.get("spread"),
        "total": opening.get("total"),
        "away_ml": opening.get("away_ml"),
        "home_ml": opening.get("home_ml"),
        "favorite": line.get("favorite_open") or _favorite_from_numbers(
            opening.get("spread"), opening.get("away_ml"), opening.get("home_ml")),
    }
    return view


def _stamp(seconds):
    try:
        moment = datetime.fromtimestamp(int(seconds))
    except (TypeError, ValueError, OSError):
        return ""
    return moment.strftime("%a %-I:%M %p")


def _label_cell(line, event, league, width, dim=False):
    """A line label as spans: favourite's abbreviation in its colour."""
    label, team = line_label(line, event, league)
    if not label:
        return [("-".ljust(width), "muted")]
    if team is not None and " " in label:
        abbr, _, rest = label.partition(" ")
        return [(abbr + " ", THEME.style(league, team, bold=not dim, dim=dim)),
                (rest.ljust(max(0, width - len(abbr) - 1)), "dim" if dim else "normal")]
    return [(label.ljust(width), "dim" if dim else "normal")]


def ats_result(event, line, league):
    """How a finished (or running) game stands against the line."""
    live = event.get("state") == "in"
    verb = "covering" if live else "covered"
    favorite = favorite_side(line)
    spread = line.get("spread")
    if not favorite or spread is None or league in MONEYLINE_LEAGUES:
        return None
    fav = event[favorite]
    dog = event["away" if favorite == "home" else "home"]
    if fav["score"] is None or dog["score"] is None:
        return None
    margin = fav["score"] - dog["score"]
    need = abs(spread)
    if margin > need:
        verdict = f"{fav['abbr']} {verb} -{need:g}"
    elif margin == need:
        verdict = f"{'on the number' if live else 'push'} at -{need:g}"
    else:
        verdict = f"{dog['abbr']} {verb} +{need:g}"
    return verdict


def total_result(event, line):
    total = line.get("total")
    away, home = event["away"]["score"], event["home"]["score"]
    if total is None or away is None or home is None:
        return None
    points = away + home
    if points > total:
        verdict = "over"
    elif points < total:
        verdict = "under"
    else:
        verdict = "push"
    return points, verdict


def render_upset_banner(event, width):
    upset = event.get("upset")
    if not upset:
        return []
    if upset["level"] == "live":
        head = Line().add(f" ▲ {upset['tag']} WATCH ", "upsetbar")
        head.add("  " + upset["note"], "upset")
        return [head]
    return [Line().add("▲ Upset  ", "upset").add(upset["note"], "upsetsoft")]


def render_betting(event, league, width, max_moves=8):
    line = event.get("line")
    lines = []
    started = event["state"] != "pre"
    title = "Closing line" if started else "Betting line"
    head = Line().add(title, "title")
    if line:
        head.add("  ·  ", "muted").add(line.get("provider") or "", "dim")
        source = event.get("line_source")
        if source == "saved":
            head.add("  (saved; no longer on the scoreboard)", "muted")
    lines.append(head)
    lines.append(rule(min(width, 48)))

    if not BETTING.enabled:
        lines.append(Line().add("Betting lines are turned off in the config.", "muted"))
        return lines
    if not line:
        if started and event["state"] == "in":
            lines.append(Line().add("Fetching the pre-game line…", "dim"))
        elif started:
            lines.append(Line().add("No saved line for this game.", "muted"))
        else:
            lines.append(Line().add("No line posted yet.", "muted"))
        return lines

    opening = open_view(line)
    col = 12
    cols = Line().add(" " * col, "normal")
    if opening:
        cols.add(f"{'open':<12}", "header")
    cols.add(f"{'closing' if started else 'now':<12}", "header")
    lines.append(cols)

    # spread (or puck line) row
    spread_label = {"nhl": "Puck line", "mlb": "Run line",
                    "cbase": "Run line"}.get(league, "Spread")
    row = Line().add(f"{spread_label:<{col}}", "dim")
    if league in MONEYLINE_LEAGUES:
        def puck(view):
            side = (view or {}).get("favorite")
            if not side or (view or {}).get("spread") is None:
                return [("-".ljust(12), "muted")]
            team = event[side]
            return [(team["abbr"] + " ", THEME.style(league, team, bold=True)),
                    (f"-{abs(view['spread']):g}".ljust(12 - len(team["abbr"]) - 1), "normal")]
        if opening:
            row.extend(puck(opening))
        row.extend(puck(line))
    else:
        spread_only = dict(line)
        if opening:
            row.extend(_label_cell({**opening, "home_ml": None, "away_ml": None}
                                   if opening.get("spread") is not None else opening,
                                   event, "nfl", 12, dim=True))
        row.extend(_label_cell(spread_only, event, "nfl", 12))
    kind = movement(line, league)
    if kind == "flip":
        row.add("◆ favorite flipped", "accent")
    elif kind == "up":
        row.add("▲ toward the favorite", "accent")
    elif kind == "down":
        row.add("▼ toward the underdog", "accent")
    lines.append(row)

    row = Line().add(f"{'Total':<{col}}", "dim")
    if opening:
        row.add(f"{number_text(opening.get('total')):<12}", "dim")
    row.add(f"{number_text(line.get('total')):<12}", "normal")
    if opening and opening.get("total") is not None and line.get("total") is not None \
            and opening["total"] != line["total"]:
        row.add(("▲ up " if line["total"] > opening["total"] else "▼ down ")
                + f"{abs(line['total'] - opening['total']):g}", "accent")
    lines.append(row)

    for index, side in enumerate(("away", "home")):
        team = event[side]
        row = Line().add(f"{'Moneyline' if index == 0 else '':<{col}}", "dim")
        abbr = f"{team['abbr']} "
        if opening:
            row.add(abbr, THEME.style(league, team, dim=True))
            row.add(f"{money_text(opening.get(side + '_ml')):<{12 - len(abbr)}}", "dim")
        row.add(abbr, THEME.style(league, team, bold=True))
        row.add(f"{money_text(line.get(side + '_ml')):<{12 - len(abbr)}}", "normal")
        lines.append(row)

    away_p, home_p = no_vig(line.get("away_ml"), line.get("home_ml"))
    if away_p is not None:
        row = Line().add(f"{'Win odds':<{col}}", "dim")
        row.add(event["away"]["abbr"] + " ", THEME.style(league, event["away"]))
        row.add(f"{away_p * 100:.0f}%   ", "normal")
        row.add(event["home"]["abbr"] + " ", THEME.style(league, event["home"]))
        row.add(f"{home_p * 100:.0f}%", "normal")
        row.add("   implied, vig removed", "muted")
        lines.append(row)

    if started:
        ats = ats_result(event, line, league)
        tot = total_result(event, line)
        label = "Result" if event["state"] == "post" else "Right now"
        if ats or tot:
            row = Line().add(f"{label:<{col}}", "dim")
            if ats:
                row.add(ats, "normal")
            if tot:
                points, verdict = tot
                if ats:
                    row.add("  ·  ", "muted")
                if event["state"] == "post":
                    row.add(f"{points} pts, {verdict} {number_text(line['total'])}", "normal")
                else:
                    row.add(f"{points} pts vs {number_text(line['total'])}", "normal")
            lines.append(row)

    history = event.get("line_history") or []
    lines.append(blank())
    if len(history) > 1 and max_moves > 0:
        lines.append(Line().add("Moves seen by sportst", "title"))
        shown = history[-max_moves:]
        if len(history) > len(shown):
            lines.append(Line().add(f"  … {len(history) - len(shown)} earlier", "muted"))
        for snap in shown:
            row = Line().add(f"  {_stamp(snap.get('t')):<15}", "muted")
            row.extend(_label_cell(snap, event, league, 11))
            row.add(f"{number_text(snap.get('total')):>6}   ", "dim")
            row.add(f"{money_text(snap.get('away_ml'))} / {money_text(snap.get('home_ml'))}",
                    "dim")
            lines.append(row)
    elif len(history) > 1:
        lines.pop()  # no room for the history; drop the spacer too
    elif history and event.get("line_origin") == "core":
        lines.extend(wrap_spans(
            "Line recovered from ESPN after the game started; open vs closing is "
            "ESPN's own record.",
            width, "muted"))
    elif history:
        lines.extend(wrap_spans(
            f"No moves since sportst first saw this line ({_stamp(history[0].get('t'))}).",
            width, "muted"))
    return lines


def render_linescore(event, league):
    away, home = event["away"], event["home"]
    count = max(len(away["linescores"]), len(home["linescores"]),
                LEAGUES[league]["regulation"] if event["state"] != "pre" else 0)
    if is_baseball(league) and event["state"] == "pre":
        count = 0
    if count == 0:
        return []
    labels = period_labels(count, league)

    def cells(side):
        values = []
        for index in range(count):
            value = side["linescores"][index] if index < len(side["linescores"]) else None
            if value is None:
                values.append("-")
            else:
                try:
                    values.append(str(int(float(value))))
                except (TypeError, ValueError):
                    values.append(str(value))
        values.append("" if side["score"] is None else str(side["score"]))
        return values

    tail = ["R", "H", "E"] if is_baseball(league) else ["T"]
    headers = [""] + labels + tail
    rows = [[away["abbr"]] + cells(away), [home["abbr"]] + cells(home)]
    if is_baseball(league):
        for row, side in zip(rows, (away, home)):
            row.append("" if side.get("hits") is None else str(side["hits"]))
            row.append("" if side.get("errors") is None else str(side["errors"]))
    aligns = ["<"] + [">"] * (len(headers) - 1)
    lines = build_table(headers, rows, aligns=aligns, sep=" ")
    # repaint the abbreviation cell of each row in the team's own colour
    for offset, side in ((1, away), (2, home)):
        if offset < len(lines) and lines[offset]:
            text, _ = lines[offset][0]
            lines[offset][0] = (text, THEME.style(league, side, bold=side["winner"]))
    return lines


SKIP_LEADER_CATEGORIES = {"MLB", "RAT", "RATING"}


def render_leaders(league, side_list, width):
    lines = []
    for side in side_list:
        if not side["leaders"]:
            continue
        lines.append(Line().add(side["abbr"], THEME.style(league, side, bold=True,
                                                          fallback="accent")))
        for category in side["leaders"]:
            entries = category.get("leaders") or []
            if not entries:
                continue
            top = entries[0]
            label = clean(category.get("shortDisplayName") or category.get("displayName") or "")
            if label.upper() in SKIP_LEADER_CATEGORIES:
                continue
            athlete = dig(top, "athlete", "shortName", default="") or dig(
                top, "athlete", "displayName", default="")
            position = dig(top, "athlete", "position", "abbreviation", default="")
            value = clean(top.get("displayValue") or "")
            text = f"  {label:<12} {clean(athlete)} {position}".rstrip()
            lines.append(Line().add(f"{text:<34}", "dim").add(value, "normal"))
        lines.append(blank())
    return lines


LOGO_MIN_ROWS = 5
LOGO_PAIRS = 48   # 6 colours + transparent: at most 6 x 7 fg/bg combinations
LOGO_SLOTS = 8
LOGO_MAX_ROWS = 8
LOGO_MAX_COLS = 24

# What to give up, in order, when the pane is short: older line moves first,
# then the stat leaders, then the rest of the move history, then the notes.
PREVIEW_TRIMS = [
    {"moves": 8, "leaders": True, "notes": True},
    {"moves": 4, "leaders": True, "notes": True},
    {"moves": 4, "leaders": False, "notes": True},
    {"moves": 2, "leaders": False, "notes": True},
    {"moves": 0, "leaders": False, "notes": False},
    {"moves": 0, "leaders": False, "notes": False, "compact": True},
]


def game_winner(event):
    if event.get("state") != "post":
        return None
    for side in ("away", "home"):
        if event[side].get("winner"):
            return event[side]
    return None


def render_game_preview(event, league, width, favorites=None, height=None,
                        logo=None, logo_style="sextants"):
    """The right-hand pane. With a height, the content is trimmed until it
    fits without scrolling, leaving room under it for the winner's logo."""
    winner = game_winner(event) if logo_style != "off" else None
    reserve = (LOGO_MIN_ROWS + 1) if winner else 0
    lines = []
    for trims in PREVIEW_TRIMS:
        lines = preview_lines(event, league, width, favorites, **trims)
        if height is None or len(lines) + reserve <= height:
            break
    if winner and logo:
        room = (height - len(lines) - 1) if height else LOGO_MAX_ROWS
        art = render_logo(logo, min(LOGO_MAX_COLS, max(4, width - 2)),
                          min(LOGO_MAX_ROWS, room), logo_style)
        if art and len(art) >= 3:
            lines.append(blank())
            lines.extend(art)  # left-aligned with the text above it
    return lines


def preview_lines(event, league, width, favorites=None, moves=8, leaders=True,
                  notes=True, compact=False):
    favorites = favorites or {}
    away, home = event["away"], event["home"]
    lines = []

    title = Line()
    title.add(team_label(away, 30, league in RANKED_LEAGUES),
              THEME.style(league, away, bold=True))
    title.add("  at  ", "muted")
    title.add(team_label(home, 30, league in RANKED_LEAGUES),
              THEME.style(league, home, bold=True))
    lines.append(title)

    meta = Line().add(event_when(event, with_zone=True), "dim")
    if event["broadcast"]:
        meta.add("  ·  ", "muted").add(event["broadcast"], "dim")
    lines.append(meta)

    where = event["venue"]
    if event["venue_city"]:
        where = f"{where} — {event['venue_city']}" if where else event["venue_city"]
    if event["neutral"]:
        where += " (neutral site)"
    if where and not compact:
        lines.append(Line().add(where, "muted"))
    if not compact:
        lines.append(blank())

    score = Line()
    score.add(f"{status_text(event):<15} ", status_style(event))
    if away["score"] is not None or home["score"] is not None:
        score.add(f"{away['abbr']} ", THEME.style(league, away, bold=True))
        score.add(str(away["score"] if away["score"] is not None else "-"), "bold")
        score.add("  —  ", "muted")
        score.add(f"{home['abbr']} ", THEME.style(league, home, bold=True))
        score.add(str(home["score"] if home["score"] is not None else "-"), "bold")
    lines.append(score)

    if event["state"] == "pre" and (away.get("probable") or home.get("probable")):
        lines.append(blank())
        lines.append(Line().add("Probable pitchers", "title"))
        for side in (away, home):
            if not side.get("probable"):
                continue
            row = Line().add("  ")
            row.add(f"{side['abbr']:<5}", THEME.style(league, side, bold=True))
            row.add(side["probable"], "normal")
            if side.get("probable_record"):
                row.add(f"  {side['probable_record']}", "dim")
            lines.append(row)

    banner = render_upset_banner(event, width)
    if banner:
        lines.extend(banner)

    situation = event["situation"]
    if event["state"] == "in" and situation and is_baseball(league):
        outs = situation.get("outs") or 0
        row = Line().add(f"{situation.get('balls', 0)}-{situation.get('strikes', 0)}",
                         "bold")
        row.add(" count   ", "muted")
        row.add("".join("●" if i < outs else "○" for i in range(3)), "accent")
        row.add(f" {'out' if outs == 1 else 'outs'}", "muted")
        bases = [name for key, name in (("onFirst", "first"), ("onSecond", "second"),
                                        ("onThird", "third")) if situation.get(key)]
        row.add("   " + (", ".join(bases) + " occupied" if bases else "bases empty"),
                "dim")
        lines.append(row)
        for key, label in (("pitcher", "P"), ("batter", "AB")):
            who = clean(dig(situation, key, "athlete", "shortName", default="")
                        or dig(situation, key, "athlete", "displayName", default=""))
            if who:
                lines.append(Line().add(f"{label:<3} ", "muted").add(who, "normal"))
    elif event["state"] == "in" and situation:
        down = clean(situation.get("downDistanceText") or "")
        spot = clean(situation.get("possessionText") or "")
        if down or spot:
            lines.append(Line().add(f"{down}  {spot}".strip(), "accent"))
        last_play = clean(dig(situation, "lastPlay", "text", default=""))
        if last_play:
            lines.extend(wrap_spans(last_play, width, "dim"))

    lines.append(blank())
    linescore = render_linescore(event, league)
    if linescore:
        lines.extend(linescore)
        lines.append(blank())

    if BETTING.enabled and league in BETTING_LEAGUES:
        lines.extend(render_betting(event, league, width, max_moves=moves))
        lines.append(blank())

    for note in (event["notes"] if notes else []):
        if note:
            lines.extend(wrap_spans(note, width, "muted"))

    leaders = render_leaders(league, [away, home], width) if leaders else []
    if leaders:
        lines.append(heading("Leaders", "title"))
        lines.append(rule(min(width, 40)))
        lines.extend(leaders)
    while lines and not lines[-1]:
        lines.pop()

    if compact:
        # the betting block ends in a footnote and a spacer; both can go
        while lines and (not lines[-1] or lines[-1][0][1] == "muted"):
            lines.pop()
    else:
        lines.append(blank())
        lines.append(Line().add(f"event id {event['id']}", "muted"))
    if event["state"] == "pre":
        lines.append(Line().add("enter → scouting report    7 → every team's stats", "muted"))
    else:
        lines.append(Line().add("enter → boxscore    4 → game stats    5 → plays", "muted"))
    return lines


