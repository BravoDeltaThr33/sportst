CLIP_PLAYERS = {
    # name: (program, audio-only arguments, with-video arguments)
    "mpv": ("mpv", ["--no-video", "--really-quiet", "--no-terminal"],
            ["--really-quiet", "--no-terminal", "--force-window=immediate"]),
    "ffplay": ("ffplay", ["-nodisp", "-autoexit", "-loglevel", "quiet"],
               ["-autoexit", "-loglevel", "quiet"]),
    "vlc": ("cvlc", ["--intf", "dummy", "--no-video", "--play-and-exit", "--quiet"],
            ["--play-and-exit", "--quiet"]),
}


def find_player(choice="auto"):
    """(name, path) of the media player to use, or (None, None)."""
    order = ["mpv", "ffplay", "vlc"] if choice in ("auto", "", None) else [choice]
    for name in order:
        spec = CLIP_PLAYERS.get(name)
        if not spec:
            continue
        program = spec[0]
        if name == "vlc" and not shutil.which("cvlc"):
            program = "vlc"
        path = shutil.which(program)
        if path:
            return name, path
    return None, None


def open_in_browser(url):
    """Hand a link to the desktop's browser, quietly, so nothing the browser
    prints lands on the curses screen."""
    import subprocess
    for program in ("xdg-open", "open", "wslview"):
        path = shutil.which(program)
        if path:
            try:
                subprocess.Popen([path, url], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                return True
            except OSError:
                continue
    try:
        import webbrowser
        return webbrowser.open(url)
    except Exception:  # noqa: BLE001
        return False


def start_player(path, name, url, video=False, limit=None):
    """Play a clip; with `limit`, stop after that many seconds."""
    import subprocess
    _, audio_args, video_args = CLIP_PLAYERS[name]
    args = [path] + (video_args if video else audio_args)
    if limit:
        args += {"mpv": [f"--length={int(limit)}"], "ffplay": ["-t", str(int(limit))],
                 "vlc": [f"--run-time={int(limit)}"]}.get(name, [])
    args.append(url)
    if name == "vlc" and video and os.path.basename(path) == "cvlc":
        args[0] = shutil.which("vlc") or path
    return subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)


# -- the whole game's highlights, in a card (the Plays tab: y, then enter) ---------
#
# The game's own highlights - ESPN's "Final Game Highlight" (posted soon
# after the final), MLB's recap and condensed game, the NFL's video on its
# YouTube channel - play inside a pop-up card. sportst decodes no video
# itself. In Kitty, mpv draws the frames into the card through its own Kitty
# output, sound and all. Elsewhere ffmpeg hands sportst the frames to draw -
# pictures in Ghostty (or in Kitty without mpv), coloured half blocks in any
# other terminal - and plays the sound itself from the same stream, so the
# two keep time. A YouTube video needs yt-dlp as well. With neither mpv nor
# ffmpeg the highlights open in the browser.

HIGHLIGHT_IMAGE = CRT_IMAGE_BASE + 20   # the card's picture (the glass has 900-912)
HIGHLIGHT_SEEK = 10                     # seconds ← and → jump
HIGHLIGHT_FPS = (24, 15)                # frames a second sportst draws: pictures, half blocks
HIGHLIGHT_WIDTH = 640                   # the most pixels wide a picture frame is decoded
HIGHLIGHT_PLAYERS = (("auto", "auto"), ("mpv", "mpv, in the card"),
                     ("ffmpeg", "ffmpeg, in the card"), ("window", "a player's window"),
                     ("browser", "the browser"))
TOOLS = {}                              # the programs found, looked up once
SGR_LEVELS = [str(n) for n in range(256)]
CUBE_STEP = [min(5, (n + 25) // 51) for n in range(256)]


def tool(name):
    """A program's path here, looked up once; None when it is not installed."""
    if name not in TOOLS:
        TOOLS[name] = shutil.which(name)
    return TOOLS[name]


def youtube_tool():
    return tool("yt-dlp") or tool("youtube-dl")


def espn_game_highlights(summary):
    """The whole game's highlights from an ESPN summary (its "Final Game
    Highlight"): [] until ESPN posts them, soon after the final."""
    out = []
    for video in (summary or {}).get("videos") or []:
        coverage = str(dig(video, "tracking", "coverageType", default="") or "").lower()
        title = clean(video.get("headline") or "")
        if "final game highlight" not in coverage and \
                not title.lower().endswith("game highlights"):
            continue
        href = dig(video, "links", "source", "HD", "href", default="") or \
            dig(video, "links", "source", "href", default="")
        if href:
            out.append({"title": title, "url": href, "kind": "video", "source": "ESPN",
                        "seconds": _int(video.get("duration")),
                        "page": dig(video, "links", "web", "href", default="") or href})
    return out


def clock_seconds(text):
    """Seconds in "HH:MM:SS" or "MM:SS"; 0 for anything else."""
    try:
        parts = [int(part) for part in str(text or "").split(":")]
    except ValueError:
        return 0
    if not 0 < len(parts) <= 3:
        return 0
    total = 0
    for part in parts:
        total = total * 60 + part
    return total


def clock_text(seconds):
    seconds = max(0, int(seconds or 0))
    if seconds >= 3600:
        return f"{seconds // 3600}:{seconds // 60 % 60:02d}:{seconds % 60:02d}"
    return f"{seconds // 60}:{seconds % 60:02d}"


def youtube_stream(url, timeout=45):
    """A YouTube video's own stream, picture and sound in one, through
    yt-dlp; "" when it gives none."""
    import subprocess
    program = youtube_tool()
    if not program:
        return ""
    try:
        out = subprocess.run([program, "-g", "-f", "18/b[height<=480]/b", "--no-warnings",
                              "--no-playlist", url], capture_output=True, text=True,
                             timeout=timeout, stdin=subprocess.DEVNULL).stdout
    except (OSError, subprocess.SubprocessError, ValueError):
        return ""
    found = [line.strip() for line in out.splitlines() if line.strip().startswith("http")]
    return found[0] if found else ""


def ffmpeg_sound():
    """ffmpeg's arguments for playing the sound itself, straight to the
    sound server ([] where it has no way to)."""
    import subprocess
    if "sound" not in TOOLS:
        names = set()
        try:
            out = subprocess.run([tool("ffmpeg"), "-hide_banner", "-devices"],
                                 capture_output=True, text=True, timeout=10,
                                 stdin=subprocess.DEVNULL).stdout
            for line in out.splitlines():
                parts = line.split()
                if len(parts) > 1 and set(parts[0]) <= set("DE.") and "E" in parts[0]:
                    names.add(parts[1].split(",")[0])
        except (OSError, subprocess.SubprocessError, TypeError, ValueError):
            pass
        if sys.platform == "darwin" and "audiotoolbox" in names:
            TOOLS["sound"] = ["-f", "audiotoolbox", "-audio_device_index", "0", "-"]
        elif "pulse" in names:
            TOOLS["sound"] = ["-f", "pulse", "-name", "sportst", "game highlights"]
        elif "alsa" in names:
            TOOLS["sound"] = ["-f", "alsa", "default"]
        else:
            TOOLS["sound"] = []
    return TOOLS["sound"]


def phosphor_filter(phosphor):
    """An ffmpeg filter that turns a video to a phosphor's colours (CRT mode;
    "" for colour or none)."""
    spec = CRT_PHOSPHORS.get(phosphor or "")
    if not spec or spec[2] is None:
        return ""
    weights = (0.2126, 0.7152, 0.0722)
    parts = []
    for name, level in zip("rgb", spec[2]):
        parts += [f"{name}{source}={weight * level / 255:.4f}"
                  for source, weight in zip("rgb", weights)]
    return "colorchannelmixer=" + ":".join(parts)


def highlight_engine(item, pictures, choice="auto"):
    """How a highlight plays here: "mpv" (mpv draws it into the card),
    "frames" (ffmpeg decodes it, sportst draws it into the card), "window"
    (a player's own window) or "browser"."""
    choice = str(choice or "auto").lower()
    if item.get("kind") == "search" or choice == "browser":
        return "browser"
    youtube = item.get("kind") == "youtube"
    if youtube and not youtube_tool():
        return "browser"
    mpv, ffmpeg = tool("mpv"), tool("ffmpeg")
    if choice == "mpv":
        return "mpv" if mpv and pictures else ("window" if mpv else "browser")
    if choice == "ffmpeg":
        return "frames" if ffmpeg else "browser"
    if choice == "window":
        name, _ = find_player("mpv" if youtube else "auto")
        return "window" if name else "browser"
    if mpv and pictures and (terminal_kind() == "kitty" or not ffmpeg):
        return "mpv"
    if ffmpeg:
        return "frames"
    if find_player("mpv" if youtube else "auto")[0]:
        return "window"
    return "browser"


def kitty_frame(image_id, rgb, width, height, cols, rows, path=None):
    """A highlight's frame as a Kitty picture, shown at the cursor scaled to
    cols x rows cells; it takes the last frame's place. With `path`, the
    frame's raw RGB is in that temporary file, which the terminal reads and
    deletes (a few bytes down the line instead of the whole frame); without,
    it goes down the line itself, compressed."""
    import base64
    if path:
        return (f"\x1b_Ga=T,t=t,f=24,s={width},v={height},i={image_id},p=1,c={cols},"
                f"r={rows},C=1,q=2;").encode() + \
            base64.standard_b64encode(path.encode()) + b"\x1b\\"
    data = base64.standard_b64encode(zlib.compress(rgb, 1))
    chunks = [data[start:start + 4096] for start in range(0, len(data), 4096)] or [b""]
    head = f"a=T,f=24,o=z,s={width},v={height},i={image_id},p=1,c={cols},r={rows}," \
           f"C=1,q=2,".encode()
    out = []
    for n, chunk in enumerate(chunks):
        more = b"m=1" if n < len(chunks) - 1 else b"m=0"
        out.append(b"\x1b_G" + (head if n == 0 else b"") + more + b";" + chunk + b"\x1b\\")
    return b"".join(out)


def half_block_frame(rgb, cols, rows, top, left, true_colour=True):
    """A highlight's frame in coloured half blocks at top, left (screen
    cells): each cell is two pixels, an upper half block in the upper one's
    colour on the lower one's."""
    level, step = SGR_LEVELS, CUBE_STEP
    stride = cols * 3
    out = []
    for row in range(rows):
        upper = rgb[2 * row * stride:(2 * row + 1) * stride]
        lower = rgb[(2 * row + 1) * stride:(2 * row + 2) * stride]
        parts = [f"\x1b[{top + row + 1};{left + 1}H"]
        last = None
        for x in range(0, len(upper) - 2, 3):
            pair = upper[x:x + 3] + lower[x:x + 3]
            if pair != last:
                last = pair
                if true_colour:
                    parts.append(f"\x1b[38;2;{level[pair[0]]};{level[pair[1]]};"
                                 f"{level[pair[2]]};48;2;{level[pair[3]]};"
                                 f"{level[pair[4]]};{level[pair[5]]}m")
                else:
                    parts.append(f"\x1b[38;5;{16 + 36 * step[pair[0]] + 6 * step[pair[1]] + step[pair[2]]};"
                                 f"48;5;{16 + 36 * step[pair[3]] + 6 * step[pair[4]] + step[pair[5]]}m")
            parts.append("▀")
        out.append("".join(parts))
    return ("".join(out) + "\x1b[0m").encode("utf-8")


class HighlightPlayer:
    """One highlight playing in the card's video place, `rect` (top, left,
    rows, cols in screen cells), from `offset` seconds in: by mpv ("mpv"), or
    by ffmpeg with sportst drawing the frames ("frames")."""

    def __init__(self, engine, item, rect, cell, offset=0.0, pictures=False,
                 true_colour=True, tint=""):
        self.engine = engine
        self.item = item
        self.rect = rect
        self.cell = cell
        self.offset = max(0.0, float(offset or 0.0))
        self.pictures = pictures
        self.true_colour = true_colour
        self.tint = tint
        self.youtube = item.get("kind") == "youtube"
        self.proc = None
        self.error = ""
        self.ended = False
        self.stopping = False
        self.silent = False         # ffmpeg could not reach the sound server
        self.lock = threading.Lock()
        self.latest, self.count, self.shown = None, 0, 0
        self.fps = HIGHLIGHT_FPS[0 if pictures else 1]
        self.size = (0, 0)
        self.position = self.offset
        self.ipc, self.sock_path, self.asked, self.heard = None, None, 0.0, b""
        self.began = time.monotonic()
        # a terminal on this machine reads each frame from a temporary file;
        # over ssh the frames go down the line, smaller and fewer
        self.local = not (os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY"))
        self.serial = 0
        if pictures and not self.local:
            self.fps = 12

    def start(self):
        try:
            return self.start_mpv() if self.engine == "mpv" else self.start_frames()
        except OSError as exc:
            self.error, self.ended = str(exc), True
            return False

    def stop(self):
        self.stopping = True
        proc, self.proc = self.proc, None
        if proc is not None and proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except Exception:  # noqa: BLE001 - it goes either way
                try:
                    proc.kill()
                except OSError:
                    pass
        if self.ipc is not None:
            try:
                self.ipc.close()
            except OSError:
                pass
            self.ipc = None
        if self.sock_path:
            try:
                os.unlink(self.sock_path)
            except OSError:
                pass
        if self.engine == "frames" and self.pictures and self.serial:
            self.clean_frames()

    # -- mpv, drawing into the card itself ------------------------------------------

    def start_mpv(self):
        import subprocess
        import tempfile
        top, left, rows, cols = self.rect
        cw, ch = self.cell
        self.sock_path = os.path.join(tempfile.gettempdir(),
                                      f"sportst-mpv-{os.getpid()}-{id(self) % 99991}.sock")
        args = [tool("mpv"), "--vo=kitty",
                "--vo-kitty-use-shm=" + ("yes" if terminal_kind() == "kitty" else "no"),
                "--vo-kitty-alt-screen=no", "--vo-kitty-config-clear=no",
                f"--vo-kitty-left={left + 1}", f"--vo-kitty-top={top + 1}",
                f"--vo-kitty-cols={cols}", f"--vo-kitty-rows={rows}",
                f"--vo-kitty-width={max(16, int(cols * cw))}",
                f"--vo-kitty-height={max(16, int(rows * ch))}",
                "--no-input-terminal", "--input-default-bindings=no", "--really-quiet",
                "--keep-open=no", "--force-window=no", "--idle=no", "--osd-level=1",
                "--sws-scaler=fast-bilinear", f"--input-ipc-server={self.sock_path}"]
        if self.offset > 0.05:
            args.append(f"--start={self.offset:.2f}")
        if self.tint:
            args.append(f"--vf=lavfi=[{self.tint}]")
        if self.youtube:
            args.append("--ytdl-format=b[height<=720]/bv*[height<=720]+ba/b")
        args += ["--", self.item["url"]]
        # its pictures go to the terminal, the screen sportst drew the card on
        self.proc = subprocess.Popen(args, stdin=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
        return True

    def connect(self):
        if self.ipc is None and self.sock_path and os.path.exists(self.sock_path):
            import socket
            try:
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.connect(self.sock_path)
                sock.setblocking(False)
                self.ipc = sock
            except OSError:
                pass
        return self.ipc

    def ask(self, *words):
        """A command to mpv through its socket (False when it is not there)."""
        sock = self.connect()
        if sock is None:
            return False
        try:
            sock.sendall((json.dumps({"command": list(words)}) + "\n").encode())
            return True
        except OSError:
            return False

    def poll(self):
        """Keep up with the player - mpv's place in the video, asked through
        its socket - and say whether it has finished."""
        if self.engine == "mpv":
            now = time.monotonic()
            if now - self.asked >= 0.4 and self.ask("get_property", "time-pos"):
                self.asked = now
            sock = self.ipc
            if sock is not None:
                try:
                    while True:
                        data = sock.recv(65536)
                        if not data:
                            break
                        self.heard += data
                except (BlockingIOError, InterruptedError):
                    pass
                except OSError:
                    pass
                *lines, self.heard = self.heard.split(b"\n")
                for line in lines:
                    try:
                        answer = json.loads(line)
                    except ValueError:
                        continue
                    value = answer.get("data") if isinstance(answer, dict) else None
                    if isinstance(value, (int, float)) and not isinstance(value, bool):
                        self.position = float(value)
            if self.proc is not None and self.proc.poll() is not None:
                self.ended = True
        return self.ended

    # -- ffmpeg's frames, drawn by sportst --------------------------------------------

    def start_frames(self):
        top, left, rows, cols = self.rect
        if self.pictures:
            cw, ch = self.cell
            widest = HIGHLIGHT_WIDTH if self.local else HIGHLIGHT_WIDTH // 2
            width = min(widest, max(64, int(cols * cw)))
            width -= width % 2
            height = max(2, int(round(width * rows * ch / max(1.0, cols * cw))))
            height -= height % 2
        else:
            width, height = cols, rows * 2
        self.size = (width, height)
        threading.Thread(target=self.read_frames, daemon=True).start()
        return True

    def read_frames(self):
        import subprocess
        url = self.item["url"]
        if self.youtube:
            url = youtube_stream(url)
            if not url:
                self.error, self.ended = "yt-dlp found no stream for it", True
                return
        width, height = self.size
        size = width * height * 3
        if self.pictures:
            vf = (f"fps={self.fps},scale={width}:{height}:force_original_aspect_ratio="
                  f"decrease,pad={width}:{height}:(ow-iw)/2:(oh-ih)/2")
        else:
            vf = f"fps={self.fps},scale={width}:{height}"
        if self.tint:
            vf += "," + self.tint
        sound = ffmpeg_sound()
        for with_sound in ((True, False) if sound else (False,)):
            if self.stopping:
                break
            args = [tool("ffmpeg"), "-nostdin", "-hide_banner", "-loglevel", "error", "-re"]
            if self.offset > 0.05:
                args += ["-ss", f"{self.offset:.2f}"]
            args += ["-i", url, "-map", "0:v:0", "-vf", vf, "-pix_fmt", "rgb24",
                     "-f", "rawvideo", "pipe:1"]
            if with_sound:
                args += ["-map", "0:a:0?"] + sound
            try:
                proc = subprocess.Popen(args, stdin=subprocess.DEVNULL,
                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                        start_new_session=True)
            except OSError as exc:
                self.error = str(exc)
                break
            self.proc = proc
            if self.stopping:
                proc.terminate()
            got = 0
            while True:
                try:
                    data = proc.stdout.read(size)
                except (OSError, ValueError):
                    break
                if not data or len(data) < size:
                    break
                with self.lock:
                    self.latest = data
                    self.count += 1
                got += 1
                if got == 1:
                    self.error = ""
            try:
                proc.wait(timeout=5)
            except Exception:  # noqa: BLE001
                pass
            if got or self.stopping:
                break
            try:
                said = proc.stderr.read().decode("utf-8", "replace").strip().splitlines()
            except (OSError, ValueError):
                said = []
            self.error = said[-1][:140] if said else "ffmpeg could not play it"
            if with_sound:
                self.silent = True          # again, without the sound
        self.ended = True

    @staticmethod
    def frame_prefix():
        """The temporary frame files' names begin so (the terminal reads and
        deletes them; the name must say tty-graphics-protocol)."""
        return f"sportst-tty-graphics-protocol-{os.getpid()}-"

    def clean_frames(self):
        """Any frame file the terminal has not taken (a terminal that does not
        read them): deleted."""
        import tempfile
        folder = tempfile.gettempdir()
        try:
            names = [name for name in os.listdir(folder)
                     if name.startswith(self.frame_prefix())]
        except OSError:
            return
        for name in names:
            try:
                os.unlink(os.path.join(folder, name))
            except OSError:
                pass

    def draw(self):
        """The newest frame, as bytes for the terminal; None when there is
        nothing new."""
        with self.lock:
            data, count = self.latest, self.count
        if data is None or count == self.shown:
            return None
        self.shown = count
        self.position = self.offset + count / self.fps
        top, left, rows, cols = self.rect
        if self.pictures:
            width, height = self.size
            path = None
            if self.local:
                import tempfile
                self.serial += 1
                path = os.path.join(tempfile.gettempdir(), f"{self.frame_prefix()}"
                                                           f"{self.serial % 1000}.rgb")
                try:
                    with open(path, "wb") as handle:
                        handle.write(data)
                except OSError:
                    path, self.local = None, False
            return (b"\x1b7" + f"\x1b[{top + 1};{left + 1}H".encode() +
                    kitty_frame(HIGHLIGHT_IMAGE, data, width, height, cols, rows, path) +
                    b"\x1b8")
        return b"\x1b7" + half_block_frame(data, cols, rows, top, left,
                                           self.true_colour) + b"\x1b8"


def gutter(line, ref, first):
    """Give a scoring play's line a two-column gutter for its clip mark and
    remember which play it belongs to."""
    line.insert(0, ("  ", "normal"))
    line.play_ref = ref
    line.play_first = first
    return line


