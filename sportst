    def slate_leagues(self):
        """The leagues the background slate reads: all of them while the
        BottomLine or the Overview's Today list is showing, otherwise only
        those with a favourite team (for score alerts)."""
        if self._slate_all:
            return SLATE_LEAGUES
        if self.config.get("score_alerts", True):
            return tuple(league for league in SLATE_LEAGUES
                         if self.favorites.get(league))
        return ()

    def slate_result(self, league):
        today = Date.today()
        group = self.cfb_group if league == "cfb" else ""
        groups = self.cfb_group if league == "cfb" else LEAGUES[league].get("groups")
        url, spare = self.api.scoreboard(league, day=today, groups=groups)
        live = self._slate_live.get(league, False)
        return self.fetcher.get(("sb", league, "d", today.isoformat(), group), url,
                                ttl=45 if live else 300, fallbacks=spare, background=True)

    def today_slate(self):
        """{league: [event]}: every league's games today worth a look (every
        pro game; ranked and favourite college games), favourites first, then
        live, upcoming and final. Leagues still loading are left out."""
        if time.time() - self.started < 1.5:
            return {}                   # the first screen's own data comes first
        out = {}
        for league in self.slate_leagues():
            try:
                result = self.slate_result(league)
            except Exception:  # noqa: BLE001 - one league never stops the rest
                continue
            if not result.data:
                continue
            cached = self._slate.get(league)
            if cached and cached[0] is result.data:
                out[league] = cached[1]
                continue
            events = [e for e in parse_scoreboard(result.data)
                      if slate_keep(e, league, self.favorites)]
            events = slate_order(events, league, self.favorites)
            self._slate[league] = (result.data, events)
            self._slate_live[league] = any(e["state"] == "in" for e in events)
            self.check_score_alerts(league, events)
            out[league] = events
        return out

    def check_score_alerts(self, league, events):
        """Compare your teams' games with the last look and put what changed on
        the bottom line: under way, a score, final; in basketball, a close
        finish instead of every basket."""
        if not self.config.get("score_alerts", True):
            return
        messages = []
        flash = bool(self.config.get("score_flash", True))
        for event in events:
            sides = [side for side in ("away", "home")
                     if fav_rank(self.favorites, league, event[side]) >= 0]
            if not sides:
                continue
            now = (event["state"], event["away"]["score"], event["home"]["score"])
            before = self._alert_seen.get(event["id"])
            self._alert_seen[event["id"]] = now
            if flash and event["state"] == "in" and sport_of(league) == "basketball":
                self.watch_threes(league, event, sides)
            if before is None or before == now:
                continue
            if flash:
                last = clean(dig(event.get("situation") or {}, "lastPlay", "text",
                                 default="") or "")
                for side, text in score_banners(event, league, before, sides, last):
                    self.queue_banner(league, event[side], text)
            text = score_alert(event, league, before, sides)
            if not text and close_late(event, league) and event["id"] not in self._alert_close:
                self._alert_close.add(event["id"])
                away, home = event["away"], event["home"]
                text = (f"{STAR} CLOSE FINISH: {away['abbr']} {away['score']}, "
                        f"{home['abbr']} {home['score']} · {short_clock(event)}")
            if text:
                messages.append(text)
        if messages:
            self.status_message = self.status_alert = "  ·  ".join(messages)
            self.dirty = True
            if self.config.get("score_bell", False):
                try:
                    curses.beep()
                except curses.error:
                    pass

    def watch_threes(self, league, event, sides):
        """A live basketball game of one of your teams: its play by play (the
        Game Center's own fetch, in the background), looked through for your
        teams' made threes since the last look."""
        url, spare = self.api.summary(league, event["id"])
        result = self.fetcher.get(("sum", league, event["id"]), url, ttl=15,
                                  fallbacks=spare, background=True)
        if not result.data:
            return
        found, newest = basketball_threes(result.data, event, sides,
                                          self._threes_seen.get(event["id"]))
        self._threes_seen[event["id"]] = newest
        for side, text in found[-3:]:
            self.queue_banner(league, event[side], text)

    def queue_banner(self, league, team, text):
        """A score's banner, in its team's colours, after any still waiting."""
        color = team_hex(league, team)
        self.banners.append({"text": text, "color": color, "ink": _ink_on(color)})
        del self.banners[:-6]
        self.next_banner()

    def next_banner(self):
        """The banner flashing now: the current one for its three seconds, then
        the next one waiting; None when there is none."""
        now = time.monotonic()
        if self.banner and now < self.banner["until"]:
            return self.banner
        if self.banner is None and not self.banners:
            return None
        self.banner = self.banners.pop(0) if self.banners else None
        if self.banner:
            self.banner["until"] = now + BANNER_SECONDS
        self.dirty = True
        return self.banner

    def draw_banner(self, row, width):
        """The flashing banner across a row: the team's colours and gold in
        turn, every quarter second."""
        banner = self.banner
        if not banner or row is None or row < 0:
            return
        if int(time.monotonic() / BANNER_BEAT) % 2:
            style = f"@111111:{ESPN_GOLD.lstrip('#')}"
        else:
            style = f"@{banner['ink']}:{banner['color']}"
        text = f"{STAR}  {banner['text']}  {STAR}"
        self.put(row, 0, " " * width, self.palette(style))
        self.put(row, max(0, (width - len(text)) // 2), text[:width],
                 self.palette(style + "~b"))

    def banner_row(self, height, ticker, wire):
        """Where a score's banner flashes: the ticker's row, the live wire's when
        the ticker is not shown, else the bottom line."""
        return height - 2 if ticker or wire else height - 1

    def ticker_shown(self, height, width):
        mode = str(self.config.get("ticker", "auto") or "auto")
        if mode == "off" or height < 16 or width < 60:
            return False
        return mode == "on" or height >= 30

    def draw_ticker(self, row, width):
        """The BottomLine: one league's games at a time behind its bug, a new
        page every few seconds, your teams first."""
        self.put(row, 0, " " * width, self.palette("normal"))
        try:
            slate = self.today_slate()
            pages = ticker_pages(slate, self.favorites, width - 8)
        except Exception:  # noqa: BLE001 - the ticker is a nicety, never a crash
            slate, pages = {}, []
        if not pages:
            text = ("Today's games are on their way…" if time.time() - self.started < 20
                    else "No games on today's slate.")
            self.put_pill(row, 1, " BOTTOMLINE ", "tabsel")
            self.put(row, 14, text, self.palette("muted"))
            return
        index = int(time.time() // TICKER_SECONDS) % len(pages)
        bug, items = pages[index]
        self.put_pill(row, 1, f" {bug} ", "tabsel")
        x = len(bug) + 4
        for number, (chip, league, event) in enumerate(items):
            if number:
                self.put(row, x, " │ ", self.palette("border"))
                x += 3
            start = x
            for text, style in chip:
                whole = x + len(text) < width - 6
                if not whole:
                    text = text[: max(0, width - 6 - x)]
                self.put_span(row, x, text, style, whole=whole)
                x += len(text)
            self.hot(row, start, x, lambda lg=league, ev=event: self.click_ticker(lg, ev))
        if len(pages) > 1:
            tag = f"{index + 1}/{len(pages)}"
            self.put(row, width - len(tag) - 1, tag, self.palette("muted"))

    def click_ticker(self, league, event):
        """A game on the BottomLine opens as it would from Today; from the Game
        Center a live one takes its place."""
        if self.center:
            self.close_center()
        self.open_game_best(league, event)
        return True

    # -- the live wire -----------------------------------------------------

    def wire_reset(self, league=None):
        self.wire = {"league": league, "facts": {}, "news": [], "tape": [], "pos": 0.0,
                     "clock": None, "row": None, "width": 0, "drawn": 0.0, "live": False,
                     "until": 0.0, "parsed": None, "gen": -1, "looked": 0.0,
                     "upsets": set(), "primed": False}

    def wire_games(self, league):
        """Today's games in the league, from the BottomLine's own fetch of
        today's scoreboard, kept fresh while one is on."""
        today = Date.today()
        url, spare = self.api.scoreboard(league, day=today, groups=LEAGUES[league].get("groups"))
        live = self.wire.get("live") and self.wire.get("league") == league
        result = self.fetcher.get(("sb", league, "d", today.isoformat(), ""), url,
                                  ttl=25 if live else 120, fallbacks=spare, background=True)
        if not result.data:
            return []
        cached = self.wire.get("parsed")
        if cached and cached[0] is result.data:
            return cached[1]
        # college slates run to a hundred games: the wire follows the ranked
        # teams and your own, as the BottomLine does
        events = [e for e in parse_scoreboard(result.data)
                  if slate_keep(e, league, self.favorites)]
        self.wire["parsed"] = (result.data, events)
        return events

    def wire_shown(self, height, width):
        """The live wire runs on the NHL and the AHL while the league has a
        game on, and for five minutes after the last one ends."""
        league = self.league if self.league in WIRE_LEAGUES else None
        if not league or not self.config.get("live_wire", True) or height < 14 or width < 60:
            return False
        if self.wire.get("league") != league:
            self.wire_reset(league)
        try:
            events = self.wire_games(league)
            live = any(e["state"] == "in" for e in events)
            self.wire["live"] = live
            if live:
                self.wire["until"] = time.time() + 300
            if events:
                self.wire_update(league, events)
        except Exception:  # noqa: BLE001 - the wire is a nicety, never a crash
            return False
        return self.wire["live"] or time.time() < self.wire["until"]

    def wire_update(self, league, events):
        """Look at every game again and put what is new on the wire: goals,
        power plays, pulled goalies, fights and majors, overtime, upset
        watches, finals."""
        now = time.time()
        if self.fetcher.generation == self.wire["gen"] and now - self.wire["looked"] < 5:
            return
        self.wire["gen"], self.wire["looked"] = self.fetcher.generation, now
        before, after, fresh = self.wire["facts"], {}, []
        live = any(e["state"] == "in" or (before.get(e["id"]) or {}).get("state") == "in"
                   for e in events)
        nhl = self.nhl_day(Date.today(), live=True) if league == "nhl" and live else None
        board = {e["id"]: e for e in self.events} \
            if self.league == league and self.day == Date.today() else {}
        for event in events:
            mine = board.get(event["id"])
            if mine is not None and mine.get("line") is not None:
                event["upset"] = mine.get("upset")      # the Scoreboard's own look
            elif BETTING.enabled and event["state"] != "pre":
                line = (self.book.get(league, event["id"]) or {}).get("line")
                event["upset"] = upset_state(dict(event, line=line), league) if line else None
            facts = {"state": event["state"], "loaded": False, "pens": False,
                     "score": (event["away"].get("score") or 0, event["home"].get("score") or 0),
                     "number": _int(event.get("period")),
                     "kind": "SO" if "SO" in (event.get("detail") or "") else "",
                     "when": "", "pp": None, "pp_left": "", "en": None,
                     "goals": [], "penalties": []}
            was = (before.get(event["id"]) or {}).get("state")
            if league == "nhl" and nhl and event["state"] != "pre":
                game = nhl_match_game(nhl, event)
                if game:
                    facts.update(nhl_wire_facts(game))
                    facts["state"] = event["state"]
                    if game.get("id") and "in" in (event["state"], was):
                        result = self.fetcher.get(
                            ("nhlpen", game["id"]),
                            Loader("api-web.nhle.com", nhl_wire_penalties, game["id"]),
                            ttl=60, background=True)
                        if isinstance(result.data, dict):
                            facts["penalties"], facts["pens"] = result.data["penalties"], True
                            if not (facts["pp"] or facts["en"]) and event["state"] == "in":
                                facts.update(wire_situation(result.data["situation"]))
                                late_pull(facts)
            elif sport_of(league) != "hockey":
                facts.update(espn_wire_facts(event, league))
            elif league == "ahl" and "in" in (event["state"], was):
                result = self.fetcher.get(("ahlwire", event["id"]),
                                          Loader("lscluster.hockeytech.com", ahl_wire_game,
                                                 event["id"]),
                                          ttl=30, background=True)
                if result.data:
                    facts.update(goals=result.data["goals"], penalties=result.data["penalties"],
                                 loaded=True, pens=True)
                    if event["state"] == "in":
                        facts["pp"], facts["pp_left"] = ahl_power_play(
                            result.data, _int(event.get("period")), event.get("clock"))
            after[event["id"]] = facts
            upset = event.get("upset")
            if upset and upset.get("level") == "live":
                key = (event["id"], upset["tag"])
                if key not in self.wire["upsets"]:
                    self.wire["upsets"].add(key)
                    if self.wire["primed"]:
                        fresh.append({"at": now, "id": event["id"], "kind": "upset",
                                      "line": wire_upset_line(league, event, upset, facts)})
            old = before.get(event["id"])
            if old is not None and self.wire["primed"]:
                tv = ""
                if old["state"] == "pre" and event["state"] == "in":
                    tv = channel_text(event_channels(event, league, nhl))
                for kind, line in wire_changes(league, event, old, facts, tv):
                    fresh.append({"at": now, "id": event["id"], "kind": kind, "line": line})
        self.wire["facts"], self.wire["primed"] = after, True
        if fresh:
            keep = [n for n in self.wire["news"] if wire_fresh(n, now)]
            self.wire["news"] = (keep + fresh)[-24:]
            self.wire_breaking(fresh)

    def wire_lap(self, league):
        """One lap of the wire: the news, newest first, then every game on,
        then the night's finals and the games still to come."""
        events = (self.wire.get("parsed") or (None, []))[1]
        now = time.time()
        lap = [(item["line"], item["id"]) for item in reversed(self.wire["news"])
               if wire_fresh(item, now)]
        for event in events:
            if event["state"] == "in":
                lap.append((wire_chip(league, event, self.wire["facts"].get(event["id"]),
                                      event.get("upset")), event["id"]))
        lap.extend((line, None) for line in wire_slate_lines(league, events))
        return lap

    def wire_segment(self, line, ident):
        line = Line(list(line) + [(WIRE_GAP, "border")])
        return {"line": line, "width": len(line.text), "id": ident}

    def wire_breaking(self, items):
        """Fresh news goes on the tape just past the right edge: it is next."""
        tape = self.wire["tape"]
        edge = self.wire["pos"] + max(20, self.wire.get("width") or 80)
        at, x = len(tape), 0
        for index, segment in enumerate(tape):
            if x >= edge:
                at = index
                break
            x += segment["width"]
        for offset, item in enumerate(items):
            tape.insert(at + offset, self.wire_segment(item["line"], item["id"]))

    def draw_wire(self, row, width):
        """The live wire: the league's night as a crawl, right to left, behind
        its bug. Each item is a game: a click opens it."""
        league = self.wire.get("league")
        if not league:
            return
        now = time.monotonic()
        last = self.wire.get("clock")
        bug = f" {LEAGUES[league]['name']} LIVE "
        start = len(bug) + 2
        room = max(0, width - start - 1)
        self.wire.update(clock=now, row=row, width=room, drawn=now)
        tape = self.wire["tape"]
        if last is not None:
            self.wire["pos"] += min(1.0, max(0.0, now - last)) * WIRE_SPEED
        while tape and self.wire["pos"] >= tape[0]["width"]:
            self.wire["pos"] -= tape[0]["width"]
            tape.pop(0)
        for _ in range(3):
            if sum(segment["width"] for segment in tape) - self.wire["pos"] >= room + 60:
                break
            lap = self.wire_lap(league)
            if not lap:
                break
            tape.extend(self.wire_segment(line, ident) for line, ident in lap)
        self.put(row, 0, " " * width, self.palette("normal"))
        self.put_pill(row, 1, bug, "wirebug") if bug.startswith(" ") and bug.endswith(" ") \
            else self.put(row, 1, bug, self.palette("wirebug"))
        self.hotspots = [spot for spot in self.hotspots if spot[0] != row]
        x, skip = start, int(self.wire["pos"])
        for segment in tape:
            if x >= start + room:
                break
            piece = slice_line(segment["line"], skip, start + room - x)
            skip = 0
            self.put_spans(row, x, piece)
            used = len(piece.text)
            if segment["id"]:
                self.hot(row, x, x + used,
                         lambda ident=segment["id"]: self.click_wire(league, ident))
            x += used
        if not tape:
            self.put(row, start, "Waiting for the night's first look…", self.palette("muted"))

    def draw_wire_safely(self, row, width):
        try:
            self.draw_wire(row, width)
        except curses.error:
            pass
        except Exception:  # noqa: BLE001 - the wire is a nicety, never a crash
            self.wire.update(tape=[], pos=0.0, row=None)

    def draw_wire_only(self):
        """One step of the crawl, without drawing the rest of the screen."""
        row = self.wire.get("row")
        if row is None or self.show_help or self.show_info or self.calendar or \
                self.popup or self.kim or self.article or self.crt_card or \
                self.settings_card or self.banner or self.roster:
            return
        height, width = self.stdscr.getmaxyx()
        if row >= height - 1:
            return
        self.draw_wire_safely(row, width - 1)
        self.present(full=False)

    def click_wire(self, league, ident):
        events = (self.wire.get("parsed") or (None, []))[1]
        event = next((e for e in events if e["id"] == ident), None)
        return self.click_ticker(league, event) if event else False

    def open_game(self, league, event, target=None):
        """Go to one game anywhere: switch league, find its day, select it,
        and open `target` (a tab name, 'center' for the Game Center, or the
        Scoreboard)."""
        if not event:
            return
        if league != self.league:
            self.switch_league(league)
