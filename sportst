def group_names(path, league=""):
    """The conference / division names worth filtering on, outermost first."""
    names = [GROUP_ALIASES.get(p, p) for p in path if p not in GROUP_ROOTS]
    if is_olympic(league) or league == "ahl":
        return names[-1:]
    return names[-2:]


def short_group(name):
    if name in GROUP_SHORT:
        return GROUP_SHORT[name]
    for tail in (" Conference", " Division", " League"):
        if name.endswith(tail) and len(name) > len(tail) + 2:
            return name[: -len(tail)]
    return name


def groups_by_school(data, league):
    """{normalised school name: [conference]} from a standings payload, for
    lending basketball's conference list to college baseball, whose team ids
    do not always match basketball's."""
    out = {}
    for _, (team, _, path) in standings_rows(data).items():
        for key in (team.get("location"), team.get("short")):
            if key:
                out.setdefault(norm_name(key), group_names(path, league))
    return out


def standings_rows(data):
    """{team id: (team record, stat table, [group names])} from a standings payload."""
    out = {}
    if not isinstance(data, dict):
        return out
    groups = []
    walk_standings(dig(data, "content", "standings", default=data) or data, [], groups)
    for title, entries in groups:
        path = [p for p in title.split(" — ") if p]
        for entry in entries:
            team = entry_team(entry)
            if team["id"] and team["id"] not in out:
                out[team["id"]] = (team, stat_lookup(entry), path)
    return out


def _st_number(table, *names):
    for name in names:
        value = _num(stat_display(table, [name]))
        if value is not None:
            return value
    return None


def record_extras(table):
    """Per-game scoring numbers out of a standings row."""
    wins = _st_number(table, "wins") or 0
    losses = _st_number(table, "losses") or 0
    ties = _st_number(table, "ties", "otLosses") or 0
    games = _st_number(table, "gamesPlayed") or (wins + losses + ties)
    pf = _st_number(table, "pointsFor", "goalsFor")
    pa = _st_number(table, "pointsAgainst", "goalsAgainst")
    extras = {"pct": _st_number(table, "winPercent")}
    if extras["pct"] is None and games:
        extras["pct"] = wins / games
    if games and pf is not None:
        extras["pf"] = pf / games
    if games and pa is not None:
        extras["pa"] = pa / games
    if games and pf is not None and pa is not None:
        extras["diff"] = (pf - pa) / games
    return extras


