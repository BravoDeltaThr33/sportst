    def toggle_favorite(self, team):
        if not team:
            return
        picked = self.favorites.setdefault(family(self.league), [])
        rank = fav_rank(self.favorites, self.league, team)
        if rank >= 0:
            removed = picked.pop(rank)
            self.status_message = f"Removed {removed['name'] or removed['abbr']}."
        else:
            picked.append({"abbr": team.get("abbr", ""), "name": team.get("name", ""),
                           "id": team.get("id", "")})
            self.status_message = f"Added {team.get('name') or team.get('abbr')}."
        self.persist_favorites()

    def persist_favorites(self):
        self.config["favorites"] = {key: list(value)
                                    for key, value in self.favorites.items()}
        try:
            save_config(self.config, self.args.config)
        except OSError as exc:
