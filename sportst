def milb_team_players(team_id, timeout=15):
    """One team's players' season numbers, batting, pitching and fielding, in
    the form the players view reads (as espn_team_players gives MLB's)."""
    season = milb_season()
    team = milb_catalog(timeout).get(_int(team_id)) or {}
    sport = _int(dig(team, "sport", "id", default=11)) or 11
    athletes, lists = {}, {}
    for group, mine in (("hitting", "batting"), ("pitching", "pitching"),
                        ("fielding", "fielding")):
        data = milb_get(f"/stats?stats=season&group={group}&teamId={team_id}"
                        f"&sportId={sport}&season={season}&playerPool=All&limit=200", timeout)
        order = []
        for block in data.get("stats") or []:
            for split in block.get("splits") or []:
                person = split.get("player") or {}
                ident = str(person.get("id") or "")
                if not ident:
                    continue
                entry = athletes.setdefault(ident, {
                    "name": short_name(clean(person.get("fullName") or "?")),
                    "pos": clean(dig(split, "position", "abbreviation", default="") or ""),
                    "stats": {}})
                stat = split.get("stat") or {}
                for theirs, ours in MILB_PLAYER_KEYS[mine].items():
                    if (mine, ours) not in entry["stats"] and stat.get(theirs) is not None:
                        entry["stats"][(mine, ours)] = clean(str(stat[theirs]))
                if ident not in order:
                    order.append(ident)
        lists[mine] = order
    return {"athletes": athletes, "lists": lists, "season": str(season),
            "source": "MLB Stats API"}


