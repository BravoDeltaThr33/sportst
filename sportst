                    row["sbpg"] = (_num(stat.get("stolenBases")) or 0) / games
                    row["kpg"] = (_num(stat.get("strikeOuts")) or 0) / games
            elif group == "pitching":
                row.update({"era": _num(stat.get("era")), "whip": _num(stat.get("whip")),
