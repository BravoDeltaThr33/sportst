def _clip_words(text):
    return [w.strip(".,'’!?()") for w in re.split(r"[\s/]+", clean(text).lower())
            if w.strip(".,'’!?()")]


def _possessive(word):
    return word[:-2] if word.endswith("'s") or word.endswith("’s") else word


def clip_kinds(text):
    low = " " + clean(text).lower() + " "
    return {kind for kind, needles in CLIP_KINDS
            if any(re.search(r"(?<![\w-])" + re.escape(n.strip()) + r"(?![\w])", low)
                   for n in needles)}


def clip_yards(text):
    return set(re.findall(r"(\d+)[- ]?(?:yd|yard)", clean(text).lower()))


def lead_name_list(text):
    """The words naming who made the play, in order: the run of capitalised
    words at the start of ESPN's text ('Sedrick Alexander 4 Yd Run', 'Mesa
    Jr. homered', 'David Pastrnak Goal')."""
    out = []
    for word in clean(text).split():
        bare = word.strip(".,'’()")
        if not bare or not bare[0].isupper() or bare.lower() in ("goal", "yd", "field"):
            break
        word = _possessive(bare.lower())
        if word not in CLIP_STOP and len(word) > 1:
            out.append(word)
    return out


def lead_names(text):
    return set(lead_name_list(text))


def name_words(text, stop=()):
    return {_possessive(w) for w in _clip_words(text)
            if len(w) > 2 and not w.isdigit() and _possessive(w) not in CLIP_STOP
            and _possessive(w) not in stop}


def match_score(play_text, clip_text, stop=()):
    """How well a clip's title fits a scoring play; 0 is no match. The
    player's surname has to appear (or two other names from the play, for
    a passer or an assist), so a shared first name never pairs them."""
    low_clip = " " + clean(clip_text).lower() + " "
    if any(n in low_clip for n in NON_SCORING):
        return 0
    lead = [w for w in lead_name_list(play_text) if w not in stop]
    words = name_words(play_text, stop)
    clip_words = name_words(clip_text, stop)
    surname = lead[-1] if lead else None
    shared_lead = set(lead) & clip_words
    shared = (words & clip_words) - set(lead)
    if surname and surname in clip_words:
        # the same surname with a different first name is someone else
        before = re.search(r"([A-Za-z][\w'’.-]*)\s+" + re.escape(surname) + r"\b",
                           clean(clip_text), re.I)
        if before and len(lead) > 1 and before.group(1)[0].isupper():
            first = _possessive(before.group(1).lower().strip(".,'’"))
            if first not in lead and first not in CLIP_STOP and first not in stop:
                return 0
        score = 3 + 2 * (len(shared_lead) - 1) + len(shared)
    elif len(shared) >= 2:
        score = len(shared)
    else:
        return 0
    yards = clip_yards(play_text)
    if yards and yards & clip_yards(clip_text):
        score += 3
    elif yards and clip_yards(clip_text):
        score -= 3            # a different distance: a different play
    kinds = clip_kinds(play_text)
    clip_kind = clip_kinds(clip_text)
    if kinds & clip_kind:
        score += 2
    elif kinds and clip_kind:
        score -= 4            # a dunk's clip is not a jumper's
    elif clip_kind - {"powerplay", "emptynet"} and not kinds:
        score -= 2            # a double's clip is not a strikeout's
    return max(0, score)


def assign_clips(play_texts, clips, stop=(), threshold=3):
    """{play index: clip} pairing each clip with at most one play, best
    matches first, ties going to the earlier play."""
    scored = []
    for p_index, text in enumerate(play_texts):
        for c_index, clip in enumerate(clips):
            value = match_score(text, clip["match"], stop)
            if value >= threshold:
                scored.append((-value, p_index, c_index))
    scored.sort()
    used_plays, used_clips, out = set(), set(), {}
    for _, p_index, c_index in scored:
        if p_index in used_plays or c_index in used_clips:
            continue
        used_plays.add(p_index)
        used_clips.add(c_index)
        out[p_index] = clips[c_index]
    return out


