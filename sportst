            "hockey": HOCKEY_PLAYERS, "baseball": BASEBALL_PLAYERS}.get(sport_of(league), [])


def _sort_number(text):
    value = _num(str(text or "").replace(":", "."))
    return value if value is not None else -1e9


def player_section_lines(data, section, league, team, width, row_limit=None):
    """One section's table, its name in the header's first cell."""
    _, title, list_name, columns, limit, options = section
    athletes = data.get("athletes") or {}
    ids = [i for i in (data.get("lists") or {}).get(list_name) or [] if i in athletes]
    if options.get("sort"):
        key = tuple(options["sort"])
        ids.sort(key=lambda i: -_sort_number(athletes[i]["stats"].get(key)))
    rows = []
    for ident in ids:
        entry = athletes[ident]
        values = [entry["stats"].get((group, stat), "") or "-" for group, stat, _ in columns]
        if options.get("nonzero") and not any(_sort_number(v) > 0 for v in values
                                              if not v.endswith("%")):
            continue
        if all(v in ("-", "0", "0.0", ".000", "0.00") for v in values):
            continue
        label = entry["name"] + (f" {entry['pos']}" if entry.get("pos") else "")
        rows.append([label] + values)
    rows = rows[: row_limit or limit]
    if not rows:
        return []
    table = fitted_table([title] + [label for _, _, label in columns], rows, width,
                         ["<"] + [">"] * len(columns), ["normal"] * len(rows))
    if table and len(table[0]):
        text, _ = table[0][0]
        table[0][0] = (text, THEME.style(league, team, bold=True, fallback="accent"))
    return list(table) + [blank()]


def side_by_side(blocks, width, gap=3):
    """Lay tables out left to right while they fit, wrapping to a new band."""
    out = []
    band, band_width = [], 0
    for block in blocks:
        if not block:
            continue
        block_width = max(sum(len(t) for t, _ in line) for line in block)
        if band and band_width + gap + block_width > width:
            out.extend(_join_band(band, gap))
            band, band_width = [], 0
        band.append((block, block_width))
        band_width += block_width + (gap if band_width else 0)
    if band:
        out.extend(_join_band(band, gap))
    return out


def _join_band(band, gap):
    height = max(len(block) for block, _ in band)
    lines = []
    for row in range(height):
        line = Line()
        for index, (block, block_width) in enumerate(band):
            cell = block[row] if row < len(block) else Line()
            used = sum(len(t) for t, _ in cell)
            line.extend_spans(cell)
            if index < len(band) - 1:
                line.add(" " * (block_width - used + gap), "normal")
        lines.append(line)
    return lines


def render_team_players(data, league, team, pane_width, full_width):
    """(left, right, bottom) line lists for one team's players."""
    specs = player_specs(league)
    left, right, bottom_blocks = [], [], []
    for section in specs:
        where = section[0]
        if where == "bottom":
            options = section[5]
            lines = player_section_lines(data, section, league, team, full_width)
            if options.get("split") and len(lines) > 8:
                # a long table goes into two columns side by side
                body = lines[1:-1]
                half = (len(body) + 1) // 2
                first = [lines[0]] + body[:half]
                second = [lines[0]] + body[half:]
                block_width = max(sum(len(t) for t, _ in l) for l in first)
                if block_width * 2 + 3 <= full_width:
                    bottom_blocks.extend([first, second])
                    continue
            bottom_blocks.append([l for l in lines if l])
        else:
            lines = player_section_lines(data, section, league, team, pane_width)
            (left if where == "left" else right).extend(lines)
    bottom = side_by_side(bottom_blocks, full_width)
    return left, right, bottom


# -- a team's last game, player by player -------------------------------------
#
# The Stats tab's player view shows the season by default; g switches it to
# the team's most recent completed game. ESPN's team schedule says which game
# that was (trying the postseason, regular season and preseason in turn, then
# last season), HockeyTech's says it for the AHL; the game's own boxscore
# supplies the numbers, laid out like the season view.

def _schedule_game(event, team_id):
    comp = (event.get("competitions") or [{}])[0]
    status = dig(comp, "status", "type", default={}) or dig(event, "status", "type",
                                                             default={}) or {}
    if not status.get("completed"):
        return None
    us, them = None, None
    for side in comp.get("competitors") or []:
        if str(dig(side, "team", "id", default="")) == str(team_id):
            us = side
        else:
            them = side
    if not us or not them:
        return None

    def score(side):
        value = side.get("score")
        if isinstance(value, dict):
            value = value.get("displayValue", value.get("value"))
        return _int(value) if value not in (None, "") else None

    mine, theirs = score(us), score(them)
    result = ""
    if us.get("winner") is True:
        result = "W"
    elif them.get("winner") is True:
        result = "L"
    elif mine is not None and theirs is not None:
        result = "W" if mine > theirs else "L" if mine < theirs else "T"
    return {"id": str(event.get("id") or comp.get("id") or ""),
            "date": event.get("date") or comp.get("date") or "",
            "home": us.get("homeAway") == "home",
            "opp": clean(dig(them, "team", "abbreviation", default="")
                         or dig(them, "team", "shortDisplayName", default="?")),
            "us": mine, "them": theirs, "result": result,
            "name": clean(event.get("shortName") or event.get("name") or "")}


def espn_last_game(league, team_id, timeout=15):
    """The team's most recent completed game, or None."""
    meta = LEAGUES[league]
    base = (f"apis/site/v2/sports/{meta['sport']}/{meta['path']}/teams/"
            f"{urllib.parse.quote(str(team_id))}/schedule")
    year = Date.today().year
    attempts = ["", "?seasontype=3", "?seasontype=2", "?seasontype=1",
                f"?season={year}", f"?season={year - 1}"]
    failures = []
    for query in attempts:
        try:
            data = fetch_first((f"https://{SITE_HOSTS[0]}/{base}{query}",
                                [f"https://{SITE_HOSTS[1]}/{base}{query}"]), timeout)
        except Exception as exc:  # noqa: BLE001 - try the next season type
            failures.append(exc)
            if len(failures) >= 3:
                raise
            continue
        games = [g for g in (_schedule_game(e, team_id) for e in data.get("events") or [])
                 if g and g["id"]]
        if games:
            games.sort(key=lambda g: g["date"])
            return games[-1]
    return None


def ahl_last_game(team_id, timeout=15):
    data = ht_get({"feed": "modulekit", "view": "schedule", "team_id": str(team_id)},
                  timeout)
    games = [g for g in dig(data, "SiteKit", "Schedule", default=[]) or []
             if str(g.get("final")) == "1"]
    if not games:
        return None
    game = max(games, key=lambda g: g.get("date_time_played") or g.get("date_played") or "")
    home = str(game.get("home_team")) == str(team_id)
    mine = _int(game.get("home_goal_count" if home else "visiting_goal_count"))
    theirs = _int(game.get("visiting_goal_count" if home else "home_goal_count"))
    tail = " SO" if game.get("shootout") == "1" else \
        " OT" if _int(game.get("overtime")) else ""
    return {"id": str(game.get("game_id") or game.get("id")),
            "date": game.get("GameDateISO8601") or game.get("date_time_played") or "",
            "home": home,
            "opp": clean(game.get("visiting_team_code" if home else "home_team_code")),
            "us": mine, "them": theirs,
            "result": ("W" if mine > theirs else "L" if mine < theirs else "T") + tail,
            "name": ""}


def last_game_caption(game):
    when = ""
    try:
        moment = datetime.fromisoformat(str(game["date"]).replace("Z", "+00:00"))
        when = strf(moment.astimezone(), "%a %b %-d")
    except (ValueError, KeyError, TypeError):
        when = str(game.get("date") or "")[:10]
    where = "vs" if game.get("home") else "at"
    score = ""
    if game.get("us") is not None and game.get("them") is not None:
        score = f" {game['us']}-{game['them']}"
    return f"{when} · {game.get('result', '')}{score} {where} {game.get('opp', '?')}".strip()


