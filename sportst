class Api:
    """One front door for every source. ESPN for its leagues and the Olympic
    tournaments it covers, HockeyTech for the AHL, Wikipedia for the rest
    of the Olympics. Methods return (source, [fallbacks]) like Espn's."""

    def __init__(self, host="site.api.espn.com"):
        self.espn = Espn(host)
        self.hockeytech = HockeyTech()
        self.wiki = WikiOlympics()

    def _for(self, league):
        source = LEAGUES.get(league, {}).get("source", "espn")
        if source == "hockeytech":
            return self.hockeytech
        return self.espn

    def scoreboard(self, league, **kwargs):
        return self._for(league).scoreboard(league, **kwargs)

    def summary(self, league, event_id):
        return self._for(league).summary(league, event_id)

    def odds(self, league, event_id):
        return self._for(league).odds(league, event_id)

    def teams(self, league):
        if is_olympic(league):
            return self.wiki.teams(league)
        return self._for(league).teams(league)

    def rankings(self, league):
        return self._for(league).rankings(league)

    def standings(self, league, season=None):
        return self._for(league).standings(league, season)


