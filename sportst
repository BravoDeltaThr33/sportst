    # -- the Game Center (Z) ----------------------------------------------

    def open_center(self, league=None, event=None):
        league = league or self.league
        event = event or self.current_event()
        if not event:
            if is_olympic(league) and self.on_board:
                self.status_message = ("Nothing on file for this sport at these Games yet "
                                       "- h / l step to another Games, E picks a sport.")
            else:
                self.status_message = ("No games on this day - h / l or C finds one, "
                                       "then Z." if self.on_board else
                                       "Pick a game first - the Game Center shows one "
                                       "game.")
            return
        if is_wiki_sport(league):
            # an Olympic event Wikipedia covers: the Event Center, its podium
            events, _ = self.wiki_events() if league == self.league else ([], None)
            self.center = {"league": league, "id": event["id"], "event": event,
                           "wiki": True, "events": events or [event], "flash": None,
                           "scores": (None, None), "state": "post", "day": None,
                           "data": None, "opened": time.time()}
            self.dirty = True
            return
        moment = _local(event.get("date"))
        self.center = {"league": league, "id": event["id"], "event": event,
                       "day": moment.date() if moment else self.day,
                       "scores": (event["away"]["score"], event["home"]["score"]),
                       "state": event["state"], "flash": None, "events": [event],
                       "data": None, "opened": time.time()}
        self.dirty = True

    def close_center(self):
        self.center = None
        self.palette.logo_begin(("free", time.time()))
        self.dirty = True

    def center_data(self):
        """(event, summary) for the game on the Game Center, refreshed every ten
        seconds while it is live; also keeps that day's games for j / k."""
        center = self.center
        league = center["league"]
        live = center["event"]["state"] == "in"
        if is_olympic(league):
            key = ("sb", league)
            url, spare = self.api.scoreboard(league)
        else:
            group = self.cfb_group if league == "cfb" else ""
            groups = self.cfb_group if league == "cfb" else LEAGUES[league].get("groups")
            key = ("sb", league, "d", center["day"].isoformat(), group)
            url, spare = self.api.scoreboard(league, day=center["day"], groups=groups)
        result = self.fetcher.get(key, url, ttl=10 if live else 60, fallbacks=spare)
        if result.data is not None and result.data is not center["data"]:
            events = parse_scoreboard(result.data)
            if BETTING.enabled and league in BETTING_LEAGUES:
                attach_lines(events, league, self.book, None, center["id"])
            center["data"] = result.data
            center["events"] = events or center["events"]
            found = next((e for e in events if e["id"] == center["id"]), None)
            if found:
                center["event"] = found
        url, spare = self.api.summary(league, center["id"])
        summary = self.fetcher.get(("sum", league, center["id"]), url,
                                   ttl=10 if live else 300, fallbacks=spare)
        if summary.data:
            prepare_summary(summary.data, league)
        return center["event"], summary.data

    def center_step(self, delta):
        """The previous or next game of that day on the Game Center."""
        center = self.center
        events = center.get("events") or []
        ids = [e["id"] for e in events]
        if center["id"] not in ids or len(ids) < 2:
            return
        event = events[(ids.index(center["id"]) + delta) % len(events)]
        league = center["league"]
        self.open_center(league, event)
        if league == self.league:
            self.selected_id = event["id"]

    def draw_center(self, height, width):
        try:
            self._draw_center(height, width)
        except curses.error:
            pass
        except Exception as exc:  # noqa: BLE001 - a TUI must not die over a screen
            self.close_center()
            self.status_message = f"⚠ Game Center stopped: {type(exc).__name__}: {exc}"

    def _draw_center(self, height, width):
        center = self.center
        league = center["league"]
        if center.get("wiki"):
            event = center["event"]
            page = self.load_event_page(event)
            meta = LEAGUES[league]
            rows = compose_event_center(event, page.data, league, width, height,
                                        self.favorites, f"{meta['label']} · {meta['games']}",
                                        loading=page.loading and not page.data)
            for y, line in enumerate(rows[:height]):
                self.put_spans(y, 0, line)
            return
        event, summary = self.center_data()
        now = time.time()
        # a score since the last look flashes across the screen
        scores = (event["away"]["score"], event["home"]["score"])
        old = center["scores"]
        if event["state"] == "in" and center["state"] == "in":
            for index, side in enumerate(("away", "home")):
                if scores[index] is not None and old[index] is not None and \
                        scores[index] > old[index]:
                    word = center_score_word(league, scores[index] - old[index])
                    if word:
                        center["flash"] = (side, word, now + 6)
        if event["state"] == "post" and center["state"] == "in":
            winner = "home" if (scores[1] or 0) > (scores[0] or 0) else "away"
            center["flash"] = (winner, "FINAL", now + 6)
        center["scores"], center["state"] = scores, event["state"]
        flash = center["flash"] if center["flash"] and now < center["flash"][2] else None
        meta = LEAGUES[league]
        context = f"{meta['label'] if is_olympic(league) else meta['name']}"
        if not is_olympic(league):
            moment = _local(event.get("date"))
            if moment:
                context += f" · {strf(moment, '%a %b %-d')}"
        if summary is None and event["state"] != "pre":
            context += " · loading the game file…"
        self.palette.logo_begin(("center", league, center["id"]))
        rows = compose_center(event, summary, league, width, height, now, flash,
                              self.favorites, context,
                              art=lambda side, cols, rows_, ev=event:
                              self.team_art(league, ev[side], cols, rows_),
                              corners=self.corners(),
                              face=lambda ref, cols, rows_:
                              self.center_face(league, ref, cols, rows_),
                              ball_art=lambda cols, rows_:
                              self.center_ball(league, cols, rows_),
                              bulb_art=self.center_bulbs,
                              positions=self.center_positions(league, event),
                              pictures=self.graphics.enabled,
                              hockey=self.hockey_live(event))
        for y, line in enumerate(rows[:height]):
            self.put_spans(y, 0, line)
        if flash or (event["state"] == "pre" and countdown_text(event)[1].startswith("MIN")):
            self.dirty = True           # keep the banner flashing, the seconds ticking

    def handle_center_key(self, key):
        if key == curses.KEY_RESIZE:
            self.apply_background()
        elif key in (27, ord("q"), ord("z")):
            self.close_center()
        elif key == ord("?"):
            self.show_help = True
            self.help_scroll = 0
            self._help_fits = False
        elif key == ord("i"):
            self.show_info = True
            self.info_scroll = 0
            self._info_fits = False
        elif key in (ord("j"), ord("l"), curses.KEY_DOWN, curses.KEY_RIGHT):
            self.center_step(1)
        elif key in (ord("k"), ord("h"), curses.KEY_UP, curses.KEY_LEFT):
            self.center_step(-1)
        elif key in (10, 13, curses.KEY_ENTER) and self.center.get("wiki"):
            event = self.center["event"]
            self.close_center()
            self.selected_id = event["id"]
            if "Results" in self.tabs:
                self.tab = self.tabs.index("Results")
                self.scroll["Results"] = 0
        elif key in (10, 13, curses.KEY_ENTER):
            event = self.center["event"]
            league = self.center["league"]
            self.close_center()
            self.open_game(league, event, "Scouting" if event["state"] == "pre"
                           else "Boxscore")
        elif key == ord("r"):
            center = self.center
            if center.get("wiki"):
                ident = center["id"]
                self.fetcher.expire(lambda k: isinstance(k, tuple) and (
                    k == ("wikievent", ident) or k == ("wikisport", center["league"])))
            else:
                self.fetcher.expire(lambda k: isinstance(k, tuple) and len(k) > 1 and
                                    k[0] in ("sb", "sum") and k[1] == center["league"])
            self.status_message = "Refreshing."
        elif key == ord("x") and self.player:
            self.stop_clip()
        return True

    def draw_overview(self, top, height, width):
        inner = width - 4
        entries = overview_entries(self.favorites)
        self.overview_cursor = clamp(self.overview_cursor, 0, max(0, len(entries) - 1))
        if not entries:
            self.overview_side = "today"
        elif self.overview_side not in ("last", "next", "today"):
            self.overview_side = "next"
        room = min(height - (8 if entries else 6), 11)
        logo = self.title_lines(inner, room)
        self.draw_lines(logo, top, 2, len(logo), inner, 0)
        rest_top = top + len(logo)
        rest = height - len(logo)
        if rest < 4:
            return
        today_min = 7
        if not entries:
            hint = wrap_spans("No favourite teams yet. Star yours on the Favorites tab (0) - L "
                              "picks the league - and their latest results, next games and "
                              "live scores will lead this screen, with alerts when they "
                              "score.", inner, "dim")
            hint_h = len(hint) + 2
            if rest >= hint_h + today_min:
                self.draw_lines_box(rest_top, hint_h, width, "Your teams", hint)
                self.draw_today(rest_top + hint_h, rest - hint_h, width)
            else:
                self.draw_lines_box(rest_top, rest, width, "Your teams", hint)
            return
        glances = {(league, team["id"]): self.load_glance(league, team)
                   for league, team in entries}
        key = "Overview"
        narrow = width < self.SPLIT_MIN_WIDTH
        # real logos beside the teams where the terminal shows pictures
        gap = 3 if self.graphics.enabled and self.team_logos != "off" else 0
        spots_both, spots_last, spots_next = {}, {}, {}
        if narrow:
            both, cursor_line = render_overview_rows(self, entries, glances, inner, "both",
                                                     gap, spots_both)
            need = len(both) + 2
        else:
            pane = self.pane_width(width) - 4
            last, cursor_line = render_overview_rows(self, entries, glances, pane, "last",
                                                     gap, spots_last)
            upcoming, _ = render_overview_rows(self, entries, glances, pane, "next", gap,
                                               spots_next)
            need = max(len(last), len(upcoming)) + 2
        fav_h = rest
        if rest - min(need, rest) >= today_min:
            fav_h = min(need, rest)
        elif rest >= 6 + today_min + 4:
            fav_h = rest - today_min - 4   # the favourites scroll; Today still shows
        view = fav_h - 2
        if narrow:
            offset = self.scroll[key]
            if self._mouse_pick:
                pass
            elif cursor_line < offset:
                offset = max(0, cursor_line - 1)
            elif cursor_line + 1 >= offset + view:
                offset = cursor_line + 2 - view
            self.scroll[key] = clamp(offset, 0, max(0, len(both) - view))
            caption = Line().add(" Your teams ", "accent").add(
                "· result: enter for game stats · next: enter for scouting · ← → ", "muted")
            self.draw_box(rest_top, 0, fav_h, width)
            self.draw_lines([caption], rest_top, 2, 1, inner, 0)
            self.draw_lines(both, rest_top + 1, 2, view, inner, self.scroll[key])
            self.draw_scrollbar(rest_top + 1, width - 2, view, len(both), self.scroll[key])
            if gap:
                self.overview_logos(spots_both, rest_top + 1, 3, view, self.scroll[key],
                                    cursor_line if self.overview_side == "last" else -1)
            self.hot_overview(entries, "both", rest_top + 1, view, 1, width - 2,
                              self.scroll[key])
        else:
            offset = self.scroll[key]
            if self._mouse_pick:
                pass
            elif cursor_line < offset:
                offset = max(0, cursor_line - 1)
            elif cursor_line >= offset + view:
                offset = cursor_line - view + 1
            self.scroll[key] = offset
            self.draw_two_panes(rest_top, fav_h, width, key, [
                (Line().add(" Latest results ", "accent").add(
                    "· enter: game stats · ← → other side ", "muted"),
                 last),
                (Line().add(" Up next ", "accent").add("· enter: its scouting report ",
                                                      "muted"), upcoming)])
            half = width // 2
            for which, x0, x1 in (("last", 1, half - 2), ("next", half + 1, width - 2)):
                self.hot_overview(entries, which, rest_top + 1, fav_h - 2, x0, x1,
                                  self.scroll[key])
            if gap:
                for which, spots, x in (("last", spots_last, 3),
                                        ("next", spots_next, half + 3)):
                    self.overview_logos(spots, rest_top + 1, x, view, self.scroll[key],
                                        cursor_line if self.overview_side == which else -1)
        self.wheel(rest_top + 1, rest_top + fav_h - 1, 1, width - 1, WHEEL_TEAMS[0],
                   WHEEL_TEAMS[1], 1)
        if rest - fav_h >= today_min:
            self.draw_today(rest_top + fav_h, rest - fav_h, width)
        else:
            self._today_items = []

    def overview_logos(self, spots, top, x, view, offset, chosen):
        """The favourites' logos down one Overview pane: `spots` maps a line
        of the pane to its (league, team); `chosen` is the highlighted line."""
        rows = [spots.get(offset + row) for row in range(view)]
        self.logo_column(None, rows, top, x,
                         selected=chosen - offset if 0 <= chosen - offset < view else -1)

    def title_lines(self, width, room):
        """The Overview's SPORTS TERMINAL title: a real picture where the
        terminal shows them (Kitty, Ghostty), the block letters elsewhere.
        Either way it takes the same rows, and the tagline stays text."""
        lines = render_logo_lines(width, room)
        if not self.graphics.enabled or len(lines) < 5:
            return lines
        rows = len(lines) - 1
        cols = min(width, 150)
        scheme = CURRENT_SCHEME["name"]
        key = (scheme, cols, rows, self.cell)
        png = self._title_pngs.get(key)
        if png is None:
            try:
                png = title_picture(scheme, int(cols * self.cell[0]), int(rows * self.cell[1]))
            except Exception:  # noqa: BLE001 - the block letters will do
                return lines
            self._title_pngs = {key: png}
        image_id = self.graphics.place(("title", scheme), png, cols, rows)
        if not image_id:
            return lines
        pad = " " * max(0, (width - cols) // 2)
        art = [Line().add(pad, "normal").extend_spans(cells)
               for cells in image_cells(image_id, cols, rows)]
        return art + lines[-1:]

    def draw_today(self, top, height, width):
        """Every league's games today in columns: live now, coming up, final."""
        try:
            slate = self.today_slate()
        except Exception:  # noqa: BLE001 - never a crash over a list
            slate = {}
        sections = today_sections(slate, self.favorites)
        items = [item for _, group in sections for item in group]
        self._today_items = items
        self.today_cursor = clamp(self.today_cursor, 0, max(0, len(items) - 1))
        focus = self.overview_side == "today"
        counts = {name: len(group) for name, group in sections}
        caption = Line().add(" Today across every sport ", "accent")
        caption.add(f"· {counts['LIVE NOW']} live · {counts['COMING UP']} to come · "
                    f"{counts['FINAL']} final ", "muted")
        caption.add("· enter opens " if focus else "· ↓ to pick one ", "muted")
        self.draw_box(top, 0, height, width)
        self.draw_lines([caption], top, 2, 1, width - 4, 0)
        view = max(1, height - 2)
        inner = width - 4
        if not items:
            waiting = time.time() - self.started < 20
            self.put(top + 1, 2, "Today's games are on their way…" if waiting else
                     "No games today in any league.", self.palette("dim"))
            return
        cols = max(1, (inner + 2) // 56) if inner >= 100 else 1
        col_w = (inner - 2 * (cols - 1)) // cols
        cells = []
        index = 0
        for name, group in sections:
            if not group:
                continue
            cells.append(("head", name, len(group)))
            for _ in group:
                cells.append(("game", index))
                index += 1
        # columns the list leaves empty show the picked game instead
        used = max(1, -(-len(cells) // view))
        if cols > used and inner - used * (col_w + 2) >= 48:
            self.draw_today_game(top + 1, 2 + used * (col_w + 2) + 1, view,
                                 inner - used * (col_w + 2) - 1,
                                 items[self.today_cursor] if focus else items[0], focus)
            cols = used
        capacity = view * cols
        cursor_cell = next((n for n, cell in enumerate(cells)
                            if cell[0] == "game" and cell[1] == self.today_cursor), 0)
        page = cursor_cell // capacity if focus else 0
        pages = (len(cells) + capacity - 1) // capacity
        self._today_view = view
        self._today_cells = cells
        self.wheel(top + 1, top + height - 1, 1, width - 1, WHEEL_TODAY[0], WHEEL_TODAY[1], 1)
        for n, cell in enumerate(cells[page * capacity:(page + 1) * capacity]):
            col, row = divmod(n, view)
            x = 2 + col * (col_w + 2)
            y = top + 1 + row
            if cell[0] == "head":
                self.put(y, x, f" {cell[1]} · {cell[2]}"[:col_w], self.palette("header"))
                continue
            league, event = items[cell[1]]
            chosen = focus and cell[1] == self.today_cursor
            line = today_line(league, event, self.favorites, col_w, chosen)
            self.draw_lines([line], y, x, 1, col_w, 0)
            self.hot(y, x, x + col_w, lambda i=cell[1]: self.click_today(i),
                     lambda i=cell[1]: self.click_today(i, True))
        if pages > 1:
            tag = f" page {page + 1}/{pages} · j/k "
            self.put(top + height - 1, max(2, width - len(tag) - 3), tag,
                     self.palette("muted"))

    def draw_today_game(self, top, x, height, width, item, focus):
        """Beside a short Today list: the picked game (the first one until
        you pick) as the Scoreboard shows it - score, line, linescore and,
        once it has started, its recap and leaders."""
        league, event = item
        for row in range(height):
            self.put(top + row, x - 2, "┊", self.palette("border"))
        try:
            ours = league in WIRE_LEAGUES and event["state"] in ("in", "post") \
                and DETAIL_LEADERS.get(sport_of(league))
            lines = [Line().add(f"{LEAGUES[league]['name']} · ", "muted").add(
                event.get("short_name") or "", "accent").add(
                "" if focus else "  ↓ to pick another", "muted"), blank()]
            preview = list(render_game_preview(event, league, width, self.favorites,
                                               height=height - 2, logo_style="off",
                                               leaders=not ours))
            texts = ["".join(t for t, _ in line) for line in preview]
            start = next((i for i, text in enumerate(texts)
                          if text.startswith(("Closing line", "Betting line"))), None)
            if start is not None:
                end = next((i for i in range(start + 1, len(texts)) if not texts[i].strip()),
                           len(texts))
                if any(("Fetching the pre-game line" in t or "No saved line" in t)
                       for t in texts[start:end]):
                    del preview[start:end + 1]     # only the Scoreboard goes and gets it
            lines += preview
            if league in WIRE_LEAGUES:
                extra = game_detail_extras(event, league, width)
                if extra:
                    lines += [blank()] + extra
        except Exception:  # noqa: BLE001 - a sketch of one game never breaks the list
            return
        self.draw_lines(lines, top, x, height, width, 0)

    def hot_overview(self, entries, which, top, view, x0, x1, offset):
        """Clickable rows for your teams on the Overview."""
        for at, spot in enumerate(overview_line_map(entries, which)):
            shown_at = at - offset
            if spot and 0 <= shown_at < view:
                index, side = spot
                self.hot(top + shown_at, x0, x1,
                         lambda i=index, s=side: self.click_overview(i, s),
                         lambda i=index, s=side: self.click_overview(i, s, True))

    def today_beside(self, direction):
        """The game in the next column over (direction 1) or the one before
        (-1), level with the picked one - the columns hold section headings
        too, so this goes by screen position, not by count."""
        cells = getattr(self, "_today_cells", []) or []
        view = max(1, self._today_view)
        games = [n for n, cell in enumerate(cells) if cell[0] == "game"]
        if not games:
            return self.today_cursor
        here = next((n for n in games if cells[n][1] == self.today_cursor), games[0])
        target = clamp(here + direction * view, games[0], games[-1])
        while target < len(cells) and cells[target][0] != "game":
            target += 1
        if target >= len(cells):
            target = games[-1]
        return cells[target][1]

    def click_today(self, index, open_it=False):
        """A click on the Today list picks that game; a second click opens it."""
        items = getattr(self, "_today_items", [])
        game = items[index] if 0 <= index < len(items) else (None, {})
        again = self.clicked_again("today", game[0], game[1].get("id"))
        self.overview_side = "today"
        self.today_cursor = index
        if again or open_it:
            self.open_today(index)
            return True
        return False

    def open_today(self, index=None):
        items = getattr(self, "_today_items", [])
        if not items:
            return
        index = clamp(self.today_cursor if index is None else index, 0, len(items) - 1)
        league, event = items[index]
        self.open_game_best(league, event)

    def open_game_best(self, league, event):
        """A live game opens in the Game Center, one to come in its Scouting
        report, a final in its Game Stats."""
        state = event.get("state")
        if state == "in":
            self.open_game(league, event, "center")
        elif state == "pre":
            self.open_game(league, event, "Scouting")
        else:
            self.open_game(league, event, "Game Stats")

    def peek_center(self, league, game):
        """The Game Center for a game known only from a team's schedule (a
        team page, the Overview): it opens over the screen you are on once
        that day's scoreboard has the game, and esc comes back to it."""
        day = game_day(game.get("date"), bool(game.get("time_tba")))
        if not day and not is_olympic(league):
            self.status_message = "That game has no date yet."
            return
        self.pending_center = (league, str(game["id"]), day)
        self.status_message = "Opening the Game Center…"

    def resolve_pending_center(self):
        """Open the Game Center peek_center asked for, once its day's
        scoreboard is in (it loads in the background)."""
        league, ident, day = self.pending_center
        if is_olympic(league):
            key = ("sb", league)
            url, spare = self.api.scoreboard(league)
        else:
            groups = self.cfb_group if league == "cfb" else LEAGUES[league].get("groups")
            key = ("sb", league, "d", day, self.cfb_group if league == "cfb" else "")
            url, spare = self.api.scoreboard(league, day=Date.fromisoformat(day),
                                              groups=groups)
        result = self.fetcher.get(key, url, ttl=60, fallbacks=spare)
        if result.data is not None:
            found = next((e for e in parse_scoreboard(result.data)
                          if str(e["id"]) == ident), None)
            self.pending_center = None
            if found:
                self.status_message = ""
                self.open_center(league, found)
            else:
                self.status_message = "That game is not on its day's scoreboard yet."
        elif result.error and not result.loading:
            self.pending_center = None
            self.status_message = f"Could not open the Game Center: {result.error}"
        else:
            self.dirty = True          # still loading: look again on the next frame

    def open_overview_game(self, which, center=False):
        entries = overview_entries(self.favorites)
        if not entries:
            self.status_message = "Star some teams on the Favorites tab first (0)."
            return
        league, team = entries[clamp(self.overview_cursor, 0, len(entries) - 1)]
        glance = self.load_glance(league, team).data
        if not glance:
            self.status_message = "Still loading that team's schedule."
            return
        game = (glance.get("live") or glance.get("next")) if which == "next" \
            else glance.get("last")
        live = which == "next" and game is glance.get("live") and game is not None
        if not game:
            self.status_message = ("No game scheduled." if which == "next"
                                   else "No completed game yet.")
            return
        if center:
            # the Game Center over the Overview: esc comes back here
            self.peek_center(league, game)
            return
        moment = _local(game["date"])
        if game.get("time_tba"):
            try:
                moment = datetime.strptime(str(game["date"])[:10], "%Y-%m-%d")
            except ValueError:
                pass
        self.switch_league(league)
        if moment:
            self.day = moment.date()
        self.week_mode = False
        self.week_pinned = False
        self.selected_id = game["id"]
        self.selected_index = 0
        # a result opens its Game Stats; the next game its Scouting report,
        # or its Game Stats once it has started; z asked for the Game Center
        target = "Scouting" if which == "next" and not live else "Game Stats"
        tabs = self.tabs
        self.tab = tabs.index(target) if target in tabs else tabs.index("Scoreboard")
        self.scroll[target] = 0
        self.detail_scroll = 0

    def handle_overview_key(self, key):
        count = len(overview_entries(self.favorites))
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10,
                 curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        today = self._today_items
        if key in WHEEL_TODAY:
            # the wheel over the Today list moves through it, wherever the focus was
            if today:
                self.overview_side = "today"
                self.today_cursor = clamp(self.today_cursor + (1 if key == WHEEL_TODAY[0]
                                                               else -1), 0, len(today) - 1)
            return True
        if key in WHEEL_TEAMS:
            if count:
                if self.overview_side == "today":
                    self.overview_side = "next"
                self.overview_cursor = clamp(self.overview_cursor + (
                    1 if key == WHEEL_TEAMS[0] else -1), 0, count - 1)
            return True
        if self.overview_side == "today":
            if key in moves:
                target = self.today_cursor + moves[key]
                if target < 0 and count and moves[key] == -1:
                    self.overview_side = "next"     # back up into your teams
                    self.overview_cursor = count - 1
                else:
                    self.today_cursor = clamp(target, 0, max(0, len(today) - 1))
            elif key in (ord("h"), curses.KEY_LEFT, ord("l"), curses.KEY_RIGHT):
                self.today_cursor = self.today_beside(
                    1 if key in (ord("l"), curses.KEY_RIGHT) else -1)
            elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
                self.open_today()
            elif key == ord("z") and today:
                league, event = today[clamp(self.today_cursor, 0, len(today) - 1)]
                self.open_center(league, event)       # over the Overview: esc comes back
            else:
                return False
            return True
        if key in moves:
            target = self.overview_cursor + moves[key]
            if target > count - 1 and moves[key] == 1 and today:
                self.overview_side = "today"        # down into today's games
                self.today_cursor = 0
            else:
                self.overview_cursor = clamp(target, 0, max(0, count - 1))
        elif key in (ord("h"), curses.KEY_LEFT):
            self.overview_side = "last"
        elif key in (ord("l"), curses.KEY_RIGHT):
            self.overview_side = "next"
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.open_overview_game(self.overview_side)
        elif key == ord("b"):
            self.open_overview_game("last")
        elif key == ord("z") and count:
            self.open_overview_game(self.overview_side, center=True)
        else:
            return False
        return True

    # -- the Settings tab ------------------------------------------------

    def setting_value(self, spec):
        """What the app is using right now, which for the keys that change it
        for one run (a, + and -, b) can differ from what is saved."""
        key = spec["key"]
        if key == "auto_refresh":
            return self.auto_refresh
        if key == "refresh_seconds":
            return self.interval
        if key == "betting_book":
            return self.bet_book
        value = self.config.get(key, DEFAULT_CONFIG.get(key))
        if key == "betting_top_books":
            return self.top_books()
        return value

    def setting_unsaved(self, spec):
        key = spec["key"]
        if key == "auto_refresh":
            return bool(self.config.get("auto_refresh", True)) != self.auto_refresh
        if key == "refresh_seconds":
            return int(self.config.get("refresh_seconds", 30)) != self.interval
        return False

    def cache_usage(self):
        """Walking the cache folder every frame would be wasteful."""
        stamp, usage = getattr(self, "_cache_usage", (0.0, {}))
        if time.time() - stamp > 10:
            usage = cache_usage()
            self._cache_usage = (time.time(), usage)
        return usage

    def save_settings(self, quiet=False):
        try:
            save_config(self.config, self.args.config)
        except OSError as exc:
            self.status_message = f"⚠ Could not save settings: {exc}"
            return False
        if not quiet:
            self.status_message = f"Saved to {home_path(self.args.config)}."
        return True

    def rebuild_palette(self):
        self.palette = Palette(enabled=not self.args.no_color,
                               floor=float(self.config.get("color_floor", 0.62)),
                               true_color=not self.args.no_true_color,
                               background=self.config.get("background", APP_BG),
                               crt=self.crt_phosphor)
        if not self.palette.image_pair_base:
            self.graphics.clear()
            self.graphics.enabled = False    # no colour pair to name a picture by
        self.crt.bind(self.palette)
        try:
            self.stdscr.bkgd(" ", 0)
        except curses.error:
            pass
        self.apply_background()
        self.stdscr.clearok(True)
        self.crt.lost()

    def apply_setting(self, key):
        """Make a changed value take effect without a restart."""
        config = self.config
        if key == "auto_refresh":
            self.auto_refresh = bool(config["auto_refresh"])
        elif key == "refresh_seconds":
            self.interval = int(config["refresh_seconds"])
        elif key == "timeout_seconds":
            self.fetcher.timeout = int(config["timeout_seconds"])
            self.logos.timeout = int(config["timeout_seconds"])
        elif key == "api_host":
            self.api = Api(config["api_host"])
            self.fetcher.expire()
        elif key in ("team_colors", "team_color_overrides") or key.startswith("upset_") \
                or key in ("betting_lines", "odds_provider", "line_history_days"):
            THEME.configure(config)
            if key == "upset_color":
                self.rebuild_palette()
        elif key in ("color_floor", "background"):
            self.rebuild_palette()
        elif key == "color_scheme":
            apply_scheme(config["color_scheme"])
            self.rebuild_palette()
        elif key == "logo_art":
            self.logo_style = str(config["logo_art"] or "off").lower()
            METER["blocks"] = self.logo_style not in PLAIN_LOGO_STYLES
        elif key == "team_logos":
            self.team_logos = str(config["team_logos"] or "badges").lower()
        elif key == "meter_style":
            METER["style"] = meter_style(config["meter_style"])
        elif key == "pictures" and str(config["pictures"]).lower() == "text":
            self.graphics.clear()            # text art from now on; the rest waits
            self.graphics.enabled = False    # for the next start, which asks again
            if TERMINAL.get("images"):
                TERMINAL.update(images=False, why="text art (Settings, Pictures)")
            if self.crt.on:
                self.set_crt(boot=False)     # the glass goes with the pictures
        elif key in ("crt", "crt_phosphor"):
            was = self.crt.on
            self.set_crt()
            if key == "crt" and self.crt.on and not was:
                self.start_post()
        elif key == "crt_levels":
            self.apply_crt_levels()
        elif key == "mlb_statcast":
            self.statcast = bool(config["mlb_statcast"])
        elif key == "mouse":
            self.apply_mouse()
        elif key == "cfb_group":
            self.cfb_group = str(config["cfb_group"])
            self.selected_id = None
            self.selected_index = 0
        elif key == "betting_book":
            self.bet_book = str(config["betting_book"] or "avg")
            self.bet_index = 0
        elif key in ("extra_stat_sources", "betting_sources"):
            self.fetcher.expire()

    def set_setting(self, spec, value):
        key = spec["key"]
        if key == "color_scheme":
            # a background left at the old scheme's own follows the new one
            before = scheme_background(self.config.get("color_scheme", "espn"))
            if str(self.config.get("background", APP_BG)).upper() == before.upper():
                self.config["background"] = scheme_background(value)
        self.config[key] = value
        self.apply_setting(key)
        if self.save_settings(quiet=True):
            note = " (next start)" if spec.get("apply") == "start" else ""
            self.status_message = f"{spec['label']}: {setting_text(spec, value)}{note}."

    def settings_spec(self):
        self.settings_cursor = clamp(self.settings_cursor, 0, len(SETTING_ROWS) - 1)
        return SETTING_ROWS[self.settings_cursor]

    def edit_setting(self):
        spec = self.settings_spec()
        kind = spec["kind"]
        value = self.setting_value(spec)
        if kind == "action":
            self.run_setting_action(spec["key"])
        elif kind == "bool":
            self.set_setting(spec, not value)
        elif kind == "choice":
            choices = spec_choices(spec)
            items = [{"label": label, "detail": "current" if str(option) == str(value)
                      else ("default" if option == setting_default(spec) else ""),
                      "action": ("choice", option)} for option, label in choices]
            cursor = next((i for i, (option, _) in enumerate(choices)
                           if str(option) == str(value)), 0)
            self.popup = Popup(spec["label"], items,
                               lambda picked, spec=spec: self.set_setting(spec, picked[1]),
                               cursor, "enter picks · esc closes")
        else:
            if kind == "books":
                initial = ", ".join(value)
            elif kind == "float":
                initial = f"{float(value):g}"
            else:
                initial = str(value)
            if kind == "int":
                hint = f"{spec['min']}-{spec['max']}"
            elif kind == "float":
                hint = f"{spec['min']:g}-{spec['max']:g}"
            elif kind == "color":
                hint = "#RRGGBB" + (" or terminal" if spec.get("allow") else "")
            else:
                hint = "up to three, comma separated"
            text = self.prompt(f"{spec['label']} ({hint}): ", initial)
            if text is None or not text.strip():
                return
            try:
                self.set_setting(spec, coerce_setting(spec, text))
            except ValueError as exc:
                self.status_message = f"⚠ {exc}."

    def confirm(self, question):
        answer = self.prompt(f"{question} type yes: ")
        return bool(answer) and answer.strip().lower() in ("y", "yes")

    def run_setting_action(self, action):
        if action == "_crt_card":
            self.open_crt_card()
        elif action == "_font_size":
            if kitty_pid() is None:
                self.status_message = "Only Kitty lets sportst set its font size."
                return
            size, _ = terminal_font_size("kitty")
            low, high = FONT_SIZES
            text = self.prompt(f"Font size in points ({low:g}-{high:g}): ", f"{size:g}")
            if text is None or not text.strip():
                return
            try:
                wanted = float(text.strip().lower().replace("pt", ""))
            except ValueError:
                self.status_message = "⚠ A size in points, such as 14 or 15.5."
                return
            self.font_size_wanted = clamp(round(wanted * 2) / 2, low, high)
            self.apply_font_size(now=True)
        elif action == "_save":
            self.config["auto_refresh"] = self.auto_refresh
            self.config["refresh_seconds"] = self.interval
            self.config["betting_book"] = self.bet_book
            self.save_settings()
        elif action == "_reload":
            try:
                fresh = load_config(self.args.config)
            except Exception as exc:  # noqa: BLE001 - a bad file must not end the app
                self.status_message = f"⚠ Could not read the config: {exc}"
                return
            self.config.clear()
            self.config.update(fresh)
            self.config["crt_levels"] = crt_levels_saved(crt_levels(fresh.get("crt_levels")))
            self.favorites = normalize_favorites(self.config.get("favorites"))
            for spec in SETTING_ROWS:
                if spec["kind"] != "action":
                    self.apply_setting(spec["key"])
            self.apply_setting("crt_levels")
            self.status_message = f"Reloaded {home_path(self.args.config)}."
        elif action == "_refresh":
            self.fetcher.expire()
            self.status_message = "Refreshing everything."
        elif action == "_clear_cache":
            if not self.confirm("Delete the saved logos, pages and college stats?"):
                self.status_message = "Nothing deleted."
                return
            removed = 0
            for name, size in cache_usage().items():
                if name == os.path.basename(LINES_PATH):
                    continue
                path = os.path.join(CACHE_DIR, name)
                try:
                    if os.path.isdir(path):
                        shutil.rmtree(path)
                    else:
                        os.remove(path)
                    removed += size
                except OSError:
                    pass
            self._cache_usage = (0.0, {})
            self.status_message = f"Cleared {human_bytes(removed)} of cached files."
        elif action == "_clear_lines":
            if not self.confirm("Delete the saved line history?"):
                self.status_message = "Nothing deleted."
                return
            try:
                os.remove(LINES_PATH)
            except OSError:
                pass
            self.book = LineBook()
            self._cache_usage = (0.0, {})
            self.status_message = "Line history cleared."
        elif action == "_reset":
            if not self.confirm("Put every setting back to its default?"):
                self.status_message = "Nothing changed."
                return
            for spec in SETTING_ROWS:
                if spec["kind"] == "action":
                    continue
                default = DEFAULT_CONFIG.get(spec["key"])
                self.config[spec["key"]] = list(default) if isinstance(default, list) \
                    else default
                self.apply_setting(spec["key"])
            self.config["crt_levels"] = dict(DEFAULT_CONFIG["crt_levels"])
            self.apply_setting("crt_levels")
            self.save_settings(quiet=True)
            self.status_message = "Settings are back to their defaults."

    def draw_settings(self, top, height, width):
        """The Settings tab: the groups of settings on the left and the parts
        of About sportst on the right (under them on a narrow screen), each a
        title whose card enter opens; the picked one explained at the foot."""
        count = len(SETTINGS_TITLES)
        pick = self.settings_title = clamp(self.settings_title, 0, count - 1)
        side = SETTINGS_TITLES[pick][0]
        wide = width >= self.SPLIT_MIN_WIDTH
        left_width = clamp(width * 46 // 100, 58, 76) if wide else width
        inner = left_width - 4
        caption = Line().add(" Settings ", "accent").add("· saved as you go ", "muted")
        version = Line().add(" sportst", "title").add(f" {VERSION}", "bold").add(
            "  terminal sports scores, stats and lines", "dim")
        groups, group_at = render_settings_titles(self, "group", inner)
        room = max(1, height - 2)
        if wide:
            right_width = width - left_width
            right_inner = right_width - 4
            about, about_at = render_settings_titles(self, "about", right_inner)
            right = [version, blank()] + about
            right_at = {index: line + 2 for index, line in about_at.items()}
            self.draw_box(top, 0, height, left_width)
            self.draw_lines([caption], top, 2, 1, inner, 0)
            self.draw_box(top, left_width, height, right_width)
            self.draw_lines([Line().add(" About sportst ", "accent")], top, left_width + 2, 1,
                            right_inner, 0)
            for lines, at, x, pane_inner, kind in (
                    (groups, group_at, 2, inner, "group"),
                    (right, right_at, left_width + 2, right_inner, "about")):
                detail = render_settings_title_detail(self, pane_inner) \
                    if side == kind else []
                if len(lines) + len(detail) > room:
                    detail = []
                view = room - len(detail)
                offset = 0
                if side == kind and at[pick] >= view:
                    offset = at[pick] - view + 1        # a short screen: keep it in view
                self.draw_lines(lines, top + 1, x, view, pane_inner, offset)
                self.hot_settings_titles(at, top + 1, offset, view, x - 1, x + pane_inner + 1)
                if detail:
                    self.draw_lines(detail, top + 1 + view, x, len(detail), pane_inner, 0)
            return
        # a narrow screen: the groups, then About sportst under them
        about, about_at = render_settings_titles(self, "about", inner)
        lines = groups + [blank(), Line().add(" About sportst", "accent"), version] + about
        at = dict(group_at)
        at.update({index: line + len(groups) + 3 for index, line in about_at.items()})
        full = render_settings_title_detail(self, inner)
        detail = next((d for d in (full, full[:2] + full[-1:], full[1:2] + full[-1:],
                                   full[-1:]) if len(lines) + len(d) <= room), [])
        view = room - len(detail)
        offset = self.scroll["Settings"]
        if self._settings_follow:
            line = at[pick]
            if line < offset + 1:
                offset = max(0, line - 1)
            elif line >= offset + view - 1:
                offset = line - view + 2
            self._settings_follow = False
        offset = clamp(offset, 0, max(0, len(lines) - view))
        self.scroll["Settings"] = offset
        self.draw_box(top, 0, height, width)
        self.draw_lines([caption], top, 2, 1, inner, 0)
        self.draw_lines(lines, top + 1, 2, view, inner, offset)
        self.draw_scrollbar(top + 1, width - 2, view, len(lines), offset)
        self.hot_settings_titles(at, top + 1, offset, view, 1, width - 1)
        if detail:
            self.draw_lines(detail, top + 1 + view, 2, len(detail), inner, 0)

    def hot_settings_titles(self, at, top, offset, view, start, end):
        """Clickable titles: {title index: its line} drawn from row `top`,
        `offset` lines scrolled, `view` rows shown, columns start..end."""
        for index, line in at.items():
            shown = line - offset
            if 0 <= shown < view:
                self.hot(top + shown, start, end,
                         lambda i=index: self.click_settings_title(i),
                         lambda i=index: self.click_settings_title(i, True))

    def click_settings_title(self, index, open_it=False):
        """A title on the Settings tab: the first click picks it, a click on the
        picked one opens its card (enter)."""
        again = self.clicked_again("settings", index)
        self.settings_title = index
        self.settings_side_at[SETTINGS_TITLES[index][0]] = index
        if again or open_it:
            self.open_settings_card(index)
            return True
        return False

    def handle_settings_key(self, key):
        """Return True when the Settings screen has taken the key."""
        count = len(SETTINGS_TITLES)
        pick = self.settings_title = clamp(self.settings_title, 0, count - 1)
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_HOME: -count, ord("g"): -count, curses.KEY_PPAGE: -count,
                 ord("K"): -count, curses.KEY_END: count, ord("G"): count,
                 curses.KEY_NPAGE: count, ord("J"): count}
        if key in moves:
            pick = clamp(pick + moves[key], 0, count - 1)
        elif key in (ord("h"), curses.KEY_LEFT, ord("l"), curses.KEY_RIGHT):
            other = "about" if key in (ord("l"), curses.KEY_RIGHT) else "group"
            if SETTINGS_TITLES[pick][0] != other:
                pick = self.settings_side_at[other]
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.open_settings_card(pick)
            return True
        elif key == ord("c"):
            return True         # nothing here: the CRT effects card is under Display
        else:
            return False
        self.settings_title = pick
        self.settings_side_at[SETTINGS_TITLES[pick][0]] = pick
        self._settings_follow = True
        return True

    # -- the Settings cards: a group's settings, a part of About sportst ---------

    def open_settings_card(self, index):
        """Title `index` of the Settings tab (SETTINGS_TITLES) as a card over
        it: a group with its settings, or a part of About sportst."""
        index = clamp(index, 0, len(SETTINGS_TITLES) - 1)
        kind, number = SETTINGS_TITLES[index]
        self.settings_title = index
        self.settings_side_at[kind] = index
        self._settings_follow = True
        if kind == "group":
            start = SETTING_GROUP_START[number]
            last = start + len(SETTING_GROUPS[number][1]) - 1
            self.settings_cursor = clamp(self.settings_card_rows.get(number, start),
                                         start, last)
        self.settings_card = {"title": index, "offset": 0}

    def close_settings_card(self):
        card = self.settings_card
        if card:
            kind, number = SETTINGS_TITLES[card["title"]]
            if kind == "group":
                self.settings_card_rows[number] = self.settings_cursor
        self.settings_card = None

    def step_settings_card(self, delta):
        """tab / shift-tab in a card: the next / previous title on its side."""
        index = self.settings_card["title"]
        kind = SETTINGS_TITLES[index][0]
        same = [i for i, (k, _) in enumerate(SETTINGS_TITLES) if k == kind]
        self.close_settings_card()
        self.open_settings_card(same[(same.index(index) + delta) % len(same)])

    def handle_settings_card_key(self, key):
        """Every key while a Settings card is open."""
        card = self.settings_card
        kind, number = SETTINGS_TITLES[card["title"]]
        if key in (27, ord("q"), curses.KEY_BACKSPACE, 127, 8):
            self.close_settings_card()
            return True
        if key == curses.KEY_RESIZE:
            self.apply_background()
            return True
        if key in (9, curses.KEY_BTAB, 353):
            self.step_settings_card(1 if key == 9 else -1)
            return True
        if kind == "about":
            page = max(1, card.get("view", 10) - 1)
            steps = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                     ord("J"): page, curses.KEY_NPAGE: page, ord(" "): page,
                     ord("K"): -page, curses.KEY_PPAGE: -page,
                     ord("g"): -10 ** 6, curses.KEY_HOME: -10 ** 6,
                     ord("G"): 10 ** 6, curses.KEY_END: 10 ** 6}
            if key in steps:
                card["offset"] = max(0, card["offset"] + steps[key])
            return True
        start = SETTING_GROUP_START[number]
        last = start + len(SETTING_GROUPS[number][1]) - 1
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 5, curses.KEY_PPAGE: -5, curses.KEY_HOME: -99,
                 ord("g"): -99, curses.KEY_END: 99, ord("G"): 99}
        if key in moves:
            self.settings_cursor = clamp(self.settings_cursor + moves[key], start, last)
            return True
        self.settings_cursor = clamp(self.settings_cursor, start, last)
        spec = self.settings_spec()
        if key in (ord("h"), curses.KEY_LEFT, ord("l"), curses.KEY_RIGHT):
            delta = -1 if key in (ord("h"), curses.KEY_LEFT) else 1
            if spec["key"] == "_font_size":
                self.status_message = self.step_font_size(delta)
            elif spec["kind"] in ("bool", "choice", "int", "float", "color"):
                self.set_setting(spec, step_setting(spec, self.setting_value(spec), delta))
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.edit_setting()
        elif key == ord("R"):
            if spec["key"] == "_crt_card":
                self.set_crt_levels({})
                self.status_message = "CRT effects: every one back to the standard."
            elif spec["key"] == "_font_size":
                self.status_message = self.reset_font_size()
            elif spec["kind"] != "action":
                default = setting_default(spec)
                self.set_setting(spec, list(default) if isinstance(default, list) else default)
        return True

    def settings_card_hints(self):
        """The bottom line's keys while a Settings card is open."""
        if SETTINGS_TITLES[self.settings_card["title"]][0] == "about":
            return [("j/k", "scroll"), ("J/K", "page"), ("tab", "next part"),
                    ("esc", "close")]
        spec = self.settings_spec()
        if spec["key"] == "_font_size":
            hints = [("j/k", "setting")]
            if kitty_pid() is not None:
                hints += [("h/l", "size"), ("enter", "type a size"), ("R", "Kitty's own")]
        else:
            edit = {"bool": "switch", "action": "do it", "choice": "choices"}.get(
                spec["kind"], "type")
            if spec["key"] == "_crt_card":
                edit = "open"
            hints = [("j/k", "setting"), ("enter", edit)]
            if spec["kind"] in ("int", "float", "choice", "color"):
                hints += [("h/l", "step")]
            elif spec["kind"] == "bool":
                hints += [("h/l", "switch")]
            if spec["kind"] != "action" or spec["key"] == "_crt_card":
                hints += [("R", "default")]
        return hints + [("tab", "next group"), ("esc", "close")]

    def draw_settings_card(self, height, width):
        """The open Settings card, over the tab: a group's settings with the
        picked one explained under them, or a part of About sportst."""
        card = self.settings_card
        kind, number = SETTINGS_TITLES[clamp(card["title"], 0, len(SETTINGS_TITLES) - 1)]
        if kind == "about":
            self.draw_about_card(height, width, number)
            return
        name, specs = SETTING_GROUPS[number]
        start = SETTING_GROUP_START[number]
        self.settings_cursor = clamp(self.settings_cursor, start, start + len(specs) - 1)
        box_width = min(76, width - 2)
        inner = box_width - 4
        rows, at = render_setting_rows(self, inner, number)
        head, body, foot = render_setting_detail(self, inner)
        room = height - 1 - 2               # above the bottom line, inside the borders
        # every row first; the picked one's explanation gets the room left over,
        # cut short (…) when there is little
        spare = room - len(rows) - len(head) - len(foot)
        if spare >= len(body):
            tail = head + body + foot
        elif spare >= 1:
            cut = body[:spare]
            cut[-1] = Line().add(cut[-1].text.rstrip()[:max(1, inner - 1)] + "…", "dim")
            tail = head + cut + foot
        else:
            tail = next((t for t in (head + foot[-1:], head[1:] + foot[-1:], foot[-1:])
                         if len(rows) + len(t) <= room), [])
        view = clamp(room - len(tail), 1, len(rows))
        offset = card.get("offset", 0)
        line = at[self.settings_cursor]
        if line < offset:
            offset = line
        elif line >= offset + view:
            offset = line - view + 1
        offset = card["offset"] = clamp(offset, 0, max(0, len(rows) - view))
        box_height = view + len(tail) + 2
        top = max(0, (height - 1 - box_height) // 2)
        left = max(0, (width - box_width) // 2)
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        self.draw_box(top, left, box_height, box_width, name, "title")
        note = " saved as you go "
        if box_width > len(note) + 6:
            self.put(top + box_height - 1, left + box_width - 2 - len(note), note,
                     self.palette("muted"))
        self.draw_lines(rows, top + 1, left + 2, view, inner, offset)
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(rows), offset)
        self.draw_lines(tail, top + 1 + view, left + 2, len(tail), inner, 0)
        card["box"] = (top, left, box_height, box_width)
        for index, line in at.items():
            shown = line - offset
            if 0 <= shown < view:
                self.hot(top + 1 + shown, left + 1, left + box_width - 1,
                         lambda i=index: self.click_setting(i),
                         lambda i=index: self.click_setting(i, True))

    def draw_about_card(self, height, width, number):
        """A part of About sportst on a card of its own, scrolled by j / k."""
        card = self.settings_card
        name = ABOUT_SECTIONS[number][0]
        box_width = min(110, width - 2)
        inner = box_width - 4
        lines = about_lines(self, number, inner)
        room = max(1, height - 1 - 2)
        view = clamp(len(lines), min(3, room), room)
        card["view"] = view
        offset = card["offset"] = clamp(card.get("offset", 0), 0, max(0, len(lines) - view))
        box_height = view + 2
        top = max(0, (height - 1 - box_height) // 2)
        left = max(0, (width - box_width) // 2)
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        self.draw_box(top, left, box_height, box_width, name, "title")
        self.draw_lines(lines, top + 1, left + 2, view, inner, offset)
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(lines), offset)
        if len(lines) > view:
            where = f" {offset + 1}-{offset + view} of {len(lines)} "
            if box_width > len(where) + len(name) + 8:
                self.put(top + box_height - 1, left + box_width - 2 - len(where), where,
                         self.palette("muted"))
        card["box"] = (top, left, box_height, box_width)

    # -- the CRT effects card (Settings, Display) -------------------------------

    # the card's rows: five at the top (CRT mode, its phosphor, the font and
    # its size, the meters' look), then every effect
    CRT_CARD_TOP = 5
    CRT_CARD_ROWS = ("crt", "phosphor", "font", "size", "meters") + \
        tuple(key for key, *_ in CRT_EFFECTS)
    CRT_CARD_TRY = {"power": "replays it", "slips": "slips a row now",
                    "burn": "wipes it", "type": "types the screen again",
                    "post": "runs it now", "blink": "a test alert",
                    "flash": "flashes the numbers now", "hum": "starts it at the top"}
    CRT_CARD_LABELS = {"crt": "CRT effect", "phosphor": "Phosphor", "font": "Font",
                       "size": "Font size", "meters": "Meters"}

    def open_crt_card(self):
        self.crt_card = {"cursor": self.CRT_CARD_TOP if self.crt.on else 0, "offset": 0,
                         "was": {}, "opened": crt_levels(self.config.get("crt_levels")),
                         "note": ""}
        installed_font_families()           # fontconfig is asked meanwhile

    def setting_spec(self, key):
        return next(spec for spec in SETTING_ROWS if spec["key"] == key)

    def set_crt_levels(self, levels, note=""):
        """New levels for the CRT effects (any left out: the standard), used
        at once and saved."""
        self.config["crt_levels"] = crt_levels_saved(levels)
        self.apply_setting("crt_levels")
        saved = self.save_settings(quiet=True)
        if self.crt_card is not None:
            self.crt_card["note"] = note if saved else "⚠ Not saved - see the bottom line."

    def try_crt_effect(self, key):
        """T on the card: an effect that comes and goes, shown now."""
        crt = self.crt
        if not crt.on:
            return "CRT effect is off: switch it on at the top of the card."
        if key == "power":
            return "Powering on again." if crt.power_on() else "Power-on is at 0."
        if key == "slips":
            return "A row slips now." if crt.slip_now() else "Sync slips are at 0."
        if key == "burn":
            crt.wear, crt.burnt, crt.worn_at = {}, {}, None
            return "Burn-in wiped: a fresh tube."
        if key == "hum":
            glass = crt.glass
            if glass and glass.HUM in glass.parts:
                glass.restart_hum()
                return "The hum bar starts again at the top."
            return "The hum bar is at 0." if glass else \
                "The hum bar is on the glass, which needs Kitty or Ghostty."
        if key == "type":
            return "The screen types out again." if crt.type_again() else \
                "The typewriter is at 0."
        if key == "post":
            return "The self test runs now: any key skips it." if self.start_post() else \
                "The POST screen is at 0."
        if key == "blink":
            if not crt_amount("blink"):
                return "Blinking alerts are at 0."
            self.status_message = self.status_alert = \
                f"{STAR} TEST ALERT: a score alert blinks like this until you press a key"
            return "A test alert blinks on the bottom line."
        if key == "flash":
            return "Every number on the screen flashes." if crt.flash_now() else \
                "The update flash is at 0."
        return ""

    def step_crt_font(self, delta):
        """The Font row: the font before / after."""
        keys = [key for key, *_ in CRT_FONTS]
        here = crt_font_key(self.config.get("crt_font"))
        self.config["crt_font"] = keys[(keys.index(here) + delta) % len(keys)]
        saved = self.save_settings(quiet=True)
        return "" if saved else "⚠ Not saved - see the bottom line."

    def kitty_fonts(self, changes):
        """set_kitty_fonts, then sportst's colours to Kitty again once it has
        read kitty.conf (it puts its own palette back): on the resize its new
        font brings, and a few times over the next seconds in case."""
        error = set_kitty_fonts(changes)
        if not error:
            now = time.monotonic()
            self.recolour_at = [now + 0.3, now + 1.0, now + 2.5]
        return error

    def recolour(self):
        """sportst's colours into the terminal's palette again."""
        codes = self.palette.colour_codes() if self.palette else b""
        if codes:
            try:
                write_terminal(codes)
            except OSError:
                pass
        self.dirty = True

    def use_font(self):
        """The Font row's enter: in Kitty sportst switches the terminal to the
        font itself (kitty.conf, read again); elsewhere the line that sets it
        goes onto the clipboard."""
        if kitty_pid() is None:
            return self.copy_font_line()
        key = crt_font_key(self.config.get("crt_font"))
        TERMINAL_FONT["at"] = -60.0
        terminal_font("kitty")
        if key == "own":
            if "font_family" not in (TERMINAL_FONT.get("block") or {}):
                return "Kitty has its own font: sportst set none."
            error = self.kitty_fonts({"font_family": None, "font_features": None})
            return f"⚠ {error}." if error else "Kitty is back to its own font."
        family, _, where = crt_font_family(key, "kitty")
        state = crt_font_installed(key, "kitty")
        if state is False:
            return f"Not installed here - get it first: {where}."
        error = self.kitty_fonts({"font_family": state or family,
                                  "font_features": font_features_line(state or family)})
        return f"⚠ {error}." if error else f"Kitty now draws in {state or family}."

    def step_font_size(self, delta):
        """h / l on Font size: half a point smaller / bigger; Kitty is told a
        moment after the last step (FONT_SIZE_WAIT)."""
        if kitty_pid() is None:
            return "Only Kitty lets sportst set its font size."
        size, _ = terminal_font_size("kitty")
        base = self.font_size_wanted if self.font_size_wanted is not None else size
        low, high = FONT_SIZES
        self.font_size_wanted = clamp(round((base + delta * FONT_SIZE_STEP) * 2) / 2,
                                      low, high)
        self.font_size_due = time.monotonic() + FONT_SIZE_WAIT
        return f"Font size {self.font_size_wanted:g} pt…"

    def apply_font_size(self, now=False):
        """The font size wanted (h / l, or typed) to Kitty, once it is due -
        or at once."""
        wanted = self.font_size_wanted
        if wanted is None or (not now and time.monotonic() < (self.font_size_due or 0)):
            return ""
        self.font_size_wanted = self.font_size_due = None
        error = self.kitty_fonts({"font_size": float(wanted)})
        note = f"⚠ {error}." if error else f"Font size {wanted:g} pt."
        if self.crt_card is not None:
            self.crt_card["note"] = note
        else:
            self.status_message = note
        return note

    def reset_font_size(self):
        """R on Font size: sportst's size back out of kitty.conf."""
        self.font_size_wanted = self.font_size_due = None
        if kitty_pid() is None:
            return "Only Kitty lets sportst set its font size."
        TERMINAL_FONT["at"] = -60.0
        terminal_font("kitty")
        if "font_size" not in (TERMINAL_FONT.get("block") or {}):
            return "Kitty has its own font size: sportst set none."
        error = self.kitty_fonts({"font_size": None})
        return f"⚠ {error}." if error else "Kitty is back to its own font size."

    def copy_font_line(self):
        """The Font row's enter: the line that sets the font, onto the
        clipboard."""
        key = crt_font_key(self.config.get("crt_font"))
        if key == "own":
            return "The terminal's own font: nothing to copy."
        kind = terminal_kind()
        family, _, _ = crt_font_family(key, kind)
        line, _, _ = font_config_line(crt_font_installed(key, kind) or family, kind)
        try:
            copy_to_clipboard(line)
        except Exception:  # noqa: BLE001 - the clipboard is a nicety
            return "⚠ The terminal took no clipboard text."
        return ("Copied: paste it into the terminal's config." if kind else
                "Copied the font's name.")

    def handle_crt_card_key(self, key):
        card = self.crt_card
        rows = self.CRT_CARD_ROWS
        card["note"] = ""
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 9: 1, curses.KEY_BTAB: -1, curses.KEY_NPAGE: 5, curses.KEY_PPAGE: -5,
                 curses.KEY_HOME: -99, ord("g"): -99, curses.KEY_END: 99, ord("G"): 99}
        if key in moves:
            card["cursor"] = clamp(card["cursor"] + moves[key], 0, len(rows) - 1)
            return True
        if key in (27, ord("q"), curses.KEY_BACKSPACE, 127, 8):
            self.crt_card = None
            return True
        if key == curses.KEY_RESIZE:
            self.apply_background()
            return True
        if key == ord("a"):
            self.set_crt_levels({}, "Every effect is back to the standard.")
            return True
        if key == ord("u"):
            self.set_crt_levels(card["opened"], "Back to how they were when the card opened.")
            return True
        row = rows[clamp(card["cursor"], 0, len(rows) - 1)]
        if key == curses.KEY_MOUSE:
            return True
        less = key in (ord("h"), curses.KEY_LEFT, ord("-"))
        more = key in (ord("l"), curses.KEY_RIGHT, ord("+"), ord("="))
        enter = key in (10, 13, curses.KEY_ENTER, ord(" "))
        if row == "crt":
            if less or more or enter:
                self.set_setting(self.setting_spec("crt"), not bool(self.config.get("crt")))
                if self.config.get("crt") and not self.crt.on:
                    card["note"] = "CRT mode needs colour: sportst was started with --no-color."
            return True
        if row == "phosphor":
            if less or more or enter:
                spec = self.setting_spec("crt_phosphor")
                self.set_setting(spec, step_setting(spec, self.setting_value(spec),
                                                    -1 if less else 1))
                if not self.crt.on:
                    card["note"] = "Saved for when CRT effect is on."
            return True
        if row == "font":
            if less or more:
                card["note"] = self.step_crt_font(-1 if less else 1)
            elif enter:
                card["note"] = self.use_font()
            return True
        if row == "size":
            if less or more:
                card["note"] = self.step_font_size(-1 if less else 1)
            elif enter:
                card["note"] = self.apply_font_size(now=True) or \
                    ("Only Kitty lets sportst set its font size." if kitty_pid() is None else
                     "h / l set the size.")
            elif key == ord("r"):
                card["note"] = self.reset_font_size()
            return True
        if row == "meters":
            if less or more or enter:
                spec = self.setting_spec("meter_style")
                self.set_setting(spec, step_setting(spec, self.setting_value(spec),
                                                    -1 if less else 1))
            return True
        levels = crt_levels(self.config.get("crt_levels"))
        level = levels[row]
        if less or more:
            new = clamp(level + (1 if more else -1), 0, CRT_LEVEL_TOP)
        elif ord("0") <= key <= ord("9"):
            new = key - ord("0")
        elif enter:
            if level:
                card["was"][row] = level
                new = 0
            else:
                new = card["was"].get(row) or CRT_STANDARD
        elif key == ord("r"):
            new = CRT_STANDARD
        elif key == ord("t"):
            card["note"] = self.try_crt_effect(row) if row in self.CRT_CARD_TRY else ""
            return True
        else:
            return True
        self.set_crt_level(row, new)
        return True

    def set_crt_level(self, key, level):
        levels = crt_levels(self.config.get("crt_levels"))
        level = clamp(int(level), 0, CRT_LEVEL_TOP)
        if levels[key] == level:
            return
        levels[key] = level
        word = crt_level_word(level)
        self.set_crt_levels(levels, f"{CRT_EFFECT_INFO[key][0]}: {level}"
                                    f"{' (' + word + ')' if word else ''}.")

    def click_crt_card(self, index, open_it=False):
        """A row of the card: the first click picks it; on the CRT effect
        and Phosphor rows a click on the picked one switches it, as enter."""
        card = self.crt_card
        if card is None:
            return False
        again = self.clicked_again("crtcard", index)
        card["cursor"] = index
        card["note"] = ""
        if open_it or (again and index < self.CRT_CARD_TOP):
            self.handle_crt_card_key(10)
            return True
        return False

    def click_crt_level(self, index, level):
        """A click on a meter's segment sets the effect to that level."""
        card = self.crt_card
        if card is None or not self.CRT_CARD_TOP <= index < len(self.CRT_CARD_ROWS):
            return False
        card["cursor"] = index
        card["note"] = ""
        self._mouse_pick = False
        self.set_crt_level(self.CRT_CARD_ROWS[index], level)
        return False

    def crt_card_keys(self, row):
        """The card's keys for the row picked, as (key, what) pairs."""
        if row == "crt":
            pairs = [("enter", "switches it on / off")]
        elif row == "phosphor":
            pairs = [("h l", "the phosphor before / after")]
        elif row == "font":
            pairs = [("h l", "the font before / after"),
                     ("enter", "switches Kitty to it" if kitty_pid() is not None else
                      "copies its line")]
        elif row == "size":
            pairs = [("h l", "smaller / bigger"), ("enter", "now"),
                     ("R", "Kitty's own")] if kitty_pid() is not None else []
        elif row == "meters":
            pairs = [("h l", "the look before / after (every meter)")]
        else:
            pairs = [("h l", "less / more"), ("0-9", "sets it"), ("enter", "off / back")]
            if row in self.CRT_CARD_TRY:
                pairs.append(("T", self.CRT_CARD_TRY[row]))
            pairs.append(("R", "standard"))
        return pairs + [("A", "all standard"), ("U", "undo"), ("esc", "close")]

    def draw_crt_card(self, height, width):
        card = self.crt_card
        rows = self.CRT_CARD_ROWS
        cursor = card["cursor"] = clamp(card["cursor"], 0, len(rows) - 1)
        levels = crt_levels(self.config.get("crt_levels"))
        phosphor = crt_phosphor(self.config.get("crt_phosphor", "green"))
        box_width = min(70, width - 2)
        inner = box_width - 4
        label_w = 16
        crt_on = self.crt.on
        glass_here = bool(self.crt.glass) if crt_on else bool(self.graphics.enabled)
        font = crt_font_key(self.config.get("crt_font"))
        top_rows = self.CRT_CARD_TOP
        size_direct = kitty_pid() is not None
        size_now, size_from = terminal_font_size()
        size_shown = self.font_size_wanted if self.font_size_wanted is not None else size_now
        size_name = f"{size_shown:g} pt" if size_shown else "the terminal's own"

        def value_spans(index, chosen):
            key = rows[index]
            main, note = ("sel", "seldim") if chosen else ("normal", "muted")
            if key == "crt":
                if crt_on:
                    return [("on", main if chosen else "good"),
                            ("   the glass on top" if self.crt.glass else
                             "   no glass: this terminal shows no pictures", note)]
                if self.config.get("crt") and self.args.no_color:
                    return [("off", note), ("   it needs colour (--no-color)", note)]
                return [("off", note), ("   enter switches it on", note)]
            if key == "phosphor":
                return [("◂ ", note), (CRT_PHOSPHORS[phosphor][0], main), (" ▸", note)]
            if key == "font":
                spans = [("◂ ", note), (CRT_FONT_INFO[font][0], main), (" ▸", note)]
                word = crt_font_word(font)
                if word:
                    spans.append(("   " + word, main if word == "in use" else note))
                return spans
            if key == "size":
                if not size_direct:
                    return [(size_name, main), ("   set in the terminal (Kitty: here)", note)]
                word = "in a moment" if self.font_size_wanted is not None else \
                    {"sportst": "set by sportst", "config": "from kitty.conf",
                     "default": "Kitty's own"}.get(size_from, "")
                return [("◂ ", note), (size_name, main), (" ▸", note), ("   " + word, note)]
            if key == "meters":
                return [("◂ ", note), (METER_STYLES[METER["style"]][0], main), (" ▸   ", note)] + \
                    meter_block(6, "accent")
            level = levels[key]
            shown = crt_on and (CRT_EFFECT_INFO[key][1] == "text" or glass_here)
            # the lit segments only; the rest of the scale is left empty
            spans = meter_block(level, "accent" if shown else "dim")
            if level < CRT_LEVEL_TOP:
                spans.append((" " * (CRT_LEVEL_TOP - level), main))
            spans.append((f" {level:>2}", main if level == CRT_STANDARD or chosen else "accent"))
            word = crt_level_word(level)
            if word:
                spans.append((f"  {word}", note))
            return spans

        def build(roomy):
            lines, spots = [], {}
            for index, key in enumerate(rows):
                if index == top_rows or (index > top_rows and CRT_EFFECT_INFO[key][1] !=
                                         CRT_EFFECT_INFO[rows[index - 1]][1]):
                    if roomy:
                        lines.append(blank())
                    if CRT_EFFECT_INFO[key][1] == "text":
                        lines.append(Line().add(" On every screen", "header"))
                    else:
                        head = Line().add(" On the glass", "header")
                        head.add("  Kitty, Ghostty" if glass_here or not crt_on else
                                 "  not in this terminal: it shows no pictures", "muted")
                        lines.append(head)
                chosen = index == cursor
                base = "sel" if chosen else "normal"
                label = self.CRT_CARD_LABELS.get(key) or CRT_EFFECT_INFO[key][0]
                line = Line().add("▌" if chosen else " ", "selbar" if chosen else "normal")
                line.add(f" {label:<{label_w}} ", base)
                line.extend_spans(value_spans(index, chosen))
                line.pad(inner, base)
                spots[index] = len(lines)
                lines.append(line)
            return lines, spots

        # the picked row explained, then the keys
        key = rows[cursor]
        if key in ("crt", "phosphor", "meters"):
            spec = self.setting_spec({"crt": "crt", "phosphor": "crt_phosphor",
                                      "meters": "meter_style"}[key])
            head = Line().add(spec["label"], "bold")
            text = spec["help"]
        elif key == "font":
            head = Line().add("Font", "bold").add(" · ", "muted")
            head.add(CRT_FONT_INFO[font][0], "accent")
            text = CRT_FONT_HELP + " " + crt_font_advice(font)
        elif key == "size":
            head = Line().add("Font size", "bold").add(" · ", "muted")
            head.add(font_size_text(self), "accent")
            text = FONT_SIZE_HELP
        else:
            label, layer, text = CRT_EFFECT_INFO[key]
            head = Line().add(label, "bold").add(" · ", "muted")
            head.add(crt_effect_now(key, levels[key], phosphor), "accent")
            if layer == "glass" and crt_on and not self.crt.glass:
                text += " Not in this terminal: the glass needs pictures (Kitty, Ghostty)."
        about = [head] + wrap_spans(text, inner, "dim")
        keys, line = [], Line()
        for name, what in self.crt_card_keys(key):
            piece = len(name) + 1 + len(what) + (3 if line else 0)
            if line and sum(len(t) for t, _ in line) + piece > inner:
                keys.append(line)
                line = Line()
            if line:
                line.add("   ", "muted")
            line.add(name, "accent").add(" " + what, "muted")
        keys.append(line)
        room = height - 1 - 2               # above the bottom line, inside the borders
        lines, spots = build(True)
        tails = ([rule(inner)] + about + keys, [rule(inner)] + about[:1] + keys,
                 about[:1] + keys, about[:1] + keys[:1], keys[:1], [])
        if len(lines) + len(tails[0]) > room:
            lines, spots = build(False)
        tail = next((t for t in tails if len(lines) + len(t) <= room), [])
        view = clamp(room - len(tail), 1, len(lines))
        offset = card.get("offset", 0)
        at = spots[cursor]
        if at < offset + 1:
            offset = max(0, at - 1)
        elif at >= offset + view - 1:
            offset = at - view + 2
        offset = card["offset"] = clamp(offset, 0, max(0, len(lines) - view))
        box_height = view + len(tail) + 2
        top = max(0, (height - 1 - box_height) // 2)
        left = max(0, (width - box_width) // 2)
        for row in range(box_height):
            self.put(top + row, left, " " * box_width, self.palette("normal"))
        self.draw_box(top, left, box_height, box_width, "CRT effects", "title")
        note = f" {card.get('note') or 'saved as you go'} "[: max(0, box_width - 6)]
        self.put(top + box_height - 1, left + box_width - 2 - len(note), note,
                 self.palette("accent" if card.get("note") else "muted"))
        self.draw_lines(lines, top + 1, left + 2, view, inner, offset)
        self.draw_scrollbar(top + 1, left + box_width - 2, view, len(lines), offset)
        self.draw_lines(tail, top + 1 + view, left + 2, len(tail), inner, 0)
        card["box"] = (top, left, box_height, box_width)
        meter_x = left + 2 + 2 + label_w + 1
        for index, at in spots.items():
            y = top + 1 + at - offset
            if not 0 <= at - offset < view:
                continue
            self.hot(y, left + 1, left + box_width - 1,
                     lambda i=index: self.click_crt_card(i),
                     lambda i=index: self.click_crt_card(i, True))
            if 1 <= index < top_rows:
                name = {1: CRT_PHOSPHORS[phosphor][0], 2: CRT_FONT_INFO[font][0],
                        3: size_name if size_direct else None,
                        4: METER_STYLES[METER["style"]][0]}[index]
                if name is None:
                    continue
                self.hot(y, meter_x, meter_x + 2,
                         lambda i=index: self.click_crt_step(i, -1))
                self.hot(y, meter_x + 2 + len(name), meter_x + 4 + len(name),
                         lambda i=index: self.click_crt_step(i, 1))
            elif index >= top_rows:
                for step in range(CRT_LEVEL_TOP):
                    self.hot(y, meter_x + step, meter_x + step + 1,
                             lambda i=index, lv=step + 1: self.click_crt_level(i, lv))

    def click_crt_step(self, index, delta):
        """A click on a top row's ◂ or ▸: the choice before / after."""
        if self.crt_card is None:
            return False
        self.crt_card["cursor"] = index
        self.handle_crt_card_key(ord("l") if delta > 0 else ord("h"))
        return False

    # -- a team's last game (Stats tab, player view) -----------------------

    def load_team_schedule(self, team):
        if self.league == "ahl":
            source = Loader("lscluster.hockeytech.com", ahl_team_schedule, team["id"])
        elif self.league == "milb":
            source = Loader(MILB_HOST, milb_team_schedule, team["id"])
        else:
            source = Loader(SITE_HOSTS[0], espn_team_schedule, self.league, team["id"])
        return self.fetcher.get(("schedule", self.league, team["id"]), source, ttl=600)

    def draw_team_schedule(self, top, height, width, team, caption,
                           back="g goes on to the season · esc to the team table."):
        """The team's whole season; enter opens the picked game. The Stats tab
        and the Standings tab both show it."""
        def notice(text):
            self.draw_box(top, 0, height, width)
            self.draw_lines([caption], top, 2, 1, width - 4, 0)
            lines = wrap_spans(text, width - 4, "dim") + [Line().add(back, "muted")]
            self.draw_lines(lines, top + 1, 2, max(1, height - 2), width - 4, 0)

        self._sched_games = []
        self._sched_team = team
        if is_olympic(self.league):
            notice("Team schedules are not published for the Olympic tournaments. The "
                   "Scoreboard has every game.")
            return
        if self.league == "cbase":
            notice("ESPN does not publish college baseball team schedules. The Scoreboard "
                   "tab and the calendar (C) have every day's games.")
            return
        result = self.load_team_schedule(team)
        data = result.data
        if not data:
            notice("Loading the schedule…" if result.loading else
                   f"Could not load the schedule: {result.error}")
            return
        games = data.get("games") or []
        self._sched_games = games
        if not team.get("color"):
            # standings rows carry no colour; the schedule's games do
            team["color"] = next((g["color"] for g in games if g.get("color")), "")
        key = (self.league, team["id"])
        if self.sched_cursor.get(key) is None:
            self.sched_cursor[key] = schedule_focus(games)
        cursor = clamp(self.sched_cursor[key], 0, max(0, len(games) - 1))
        self.sched_cursor[key] = cursor
        inner = width - 4
        wide = inner >= TEAM_PAGE_WIDE
        self._team_page_wide = wide
        list_w = clamp(inner * 48 // 100, 70, 92) if wide else inner
        dash_w = inner - list_w - 3 if wide else 0
        title = Line(list(caption))
        bits = [b for b in (data.get("season"), data.get("standing")) if b]
        if bits:
            title.add(" " + " · ".join(bits) + " ", "dim")
        self.draw_box(top, 0, height, width)
        self.draw_lines([title], top, 2, 1, width - 4, 0)
        if team_rosters(self.league):
            label = " M roster "
            x = width - len(label) - 2
            if x > len(title.text) + 4:
                self.put(top, x, label, self.palette("accent"))
                self.hot(top, x, x + len(label), lambda t=team: self.open_roster(t) or True)
        self.palette.logo_begin(("teampage", self.league, team["id"]))
        if not wide and self.sched_view == "season":
            # a narrow screen: the panels on their own, j / k scroll them
            panel = self.team_page_lines(team, data, inner, 10 ** 6)
            view = max(1, height - 2)
            offset = clamp(self.scroll["TeamPage"], 0, max(0, len(panel) - view))
            self.scroll["TeamPage"] = offset
            self.draw_lines(panel, top + 1, 2, view, inner, offset)
            self.draw_scrollbar(top + 1, width - 2, view, len(panel), offset)
            self.wheel(top + 1, top + height - 1, 1, width - 1, ord("j"), ord("k"), 3)
            return
        row_lines = []
        gap = 3 if self.graphics.enabled and self.team_logos != "off" else 0
        lines = render_team_schedule(data, self.league, list_w, cursor, row_lines,
                                     summary=not wide, logo_gap=gap)
        fixed = (2 if wide else 3) if games else 0
        body = lines[fixed:]
        view = max(1, height - 2 - fixed)
        offset = self.scroll["Schedule"]
        if games and not self._mouse_pick:
            line_at = row_lines[cursor] - fixed
            if line_at < offset:
                offset = max(0, line_at - 2)        # the month heading above too
            elif line_at >= offset + view:
                offset = line_at - view + 2
        offset = clamp(offset, 0, max(0, len(body) - view))
        self.scroll["Schedule"] = offset
        if fixed:
            self.draw_lines(lines[:fixed], top + 1, 2, fixed, list_w, 0)
        self.draw_lines(body, top + 1 + fixed, 2, view, list_w, offset)
        self.draw_scrollbar(top + 1 + fixed, 2 + list_w if wide else width - 2, view,
                            len(body), offset)
        column = [None] * view
        for index, at in enumerate(row_lines):
            shown_at = at - fixed - offset
            if 0 <= shown_at < view:
                self.hot(top + 1 + fixed + shown_at, 1, 2 + list_w,
                         lambda i=index: self.click_schedule(i),
                         lambda i=index: self.click_schedule(i, True))
                game = games[index]
                column[shown_at] = {"id": game.get("opp_id"), "abbr": game.get("opp"),
                                    "logo": game.get("opp_logo")}
        if gap:
            self.logo_column(self.league, column, top + 1 + fixed,
                             2 + schedule_logo_x(self.league),
                             selected=(row_lines[cursor] - fixed - offset) if games else -1)
        if wide:
            x = 2 + list_w + 2
            for row in range(height - 2):
                self.put(top + 1 + row, x, "│", self.palette("border"))
            panel = self.team_page_lines(team, data, dash_w - 1, height - 2)
            self.draw_lines(panel, top + 1, x + 2, height - 2, dash_w - 1, 0)

    def team_page_lines(self, team, data, width, height):
        """The team page's panels for a box `width` x `height`: the team card
        and the season chart across the top, then the next game, the
        division, the splits, the season's numbers, the road ahead, the
        report card and the title odds, in one or two columns - leaving out
        whatever does not fit."""
        league = self.league
        games = data.get("games") or []
        numbers = season_numbers(games, league)
        standings = self.load_standings()
        index = standings_index(standings.data) if standings.data else {}
        row = index.get(str(team.get("id")))
        numbers.update(opponent_numbers(numbers, index))
        known = dict((row or {}).get("team") or {})
        known.update({k: v for k, v in team.items() if v})
        art = self.team_art(league, known, 30, 6) if height >= 12 else []
        card = team_card(known, numbers, row, league, width, art, data.get("season") or "",
                         data.get("standing") or "",
                         smaller=lambda: self.team_art(league, known, 24, 6))
        rows = 4 if height >= 40 else 3 if height >= 30 else 2
        chart = chart_panel(numbers, league, width, rows)
        top_part = card + [Line()] + chart
        if len(top_part) > height:
            top_part = card[:height]
        columns = 2 if width >= 84 else 1
        col_w = (width - 2) // 2 if columns == 2 else width
        board, sources = self.championship_rows()[:2]
        panels = [next_up_panel(numbers, index, league, col_w,
                                self.next_game_line(numbers["next"], known)),
                  division_panel(row, league, col_w, self.favorites),
                  splits_panel(numbers, row, league, col_w),
                  numbers_panel(numbers, league, col_w),
                  road_panel(numbers, numbers, league, col_w),
                  report_panel(index, team.get("id"), league, col_w),
                  odds_panel(board, team.get("id"), league, col_w, sources)]
        room = height - len(top_part) - 1
        rest = layout_panels(panels, width, max(0, room), columns) if room > 3 else []
        return top_part + ([Line()] + rest if rest else [])

    def next_game_line(self, game, team):
        """'BUF -3.5 · o/u 47.5' for the team's next game when a sportsbook
        line for it has been seen, or ''."""
        if not game or not BETTING.enabled or self.league not in BETTING_LEAGUES:
            return ""
        entry = self.book.get(self.league, game.get("id")) if self.book else None
        line = (entry or {}).get("line")
        if not line:
            found = next((e for e in self.events or [] if e.get("id") == game.get("id")),
                         None)
            line = (found or {}).get("line")
        if not line:
            return ""
        us = {"abbr": team.get("abbr") or "?"}
        them = {"abbr": game.get("opp") or "?"}
        event = {"home": us, "away": them} if game.get("home") else {"home": them, "away": us}
        text, _ = line_label(line, event, self.league)
        if line.get("total") is not None:
            text += f" · o/u {line['total']:g}" if isinstance(line["total"], (int, float)) \
                else f" · o/u {line['total']}"
        return text.strip(" ·")

    def click_schedule(self, index, open_it=False):
        if not self._sched_team:
            return False
        key = (self.league, self._sched_team["id"])
        again = self.clicked_again("schedule", key, index)
        self.sched_cursor[key] = index
        if again or open_it:
            self.open_schedule_game()
            return True
        return False

    def open_schedule_game(self, center=False):
        """Open the picked game of a team's schedule: its scouting report
        before the start, its box score once under way or played - or, with
        `center`, the Game Center, once that day's scoreboard has it."""
        games = getattr(self, "_sched_games", [])
        if not games or not self._sched_team:
            return
        key = (self.league, self._sched_team["id"])
        game = games[clamp(self.sched_cursor.get(key) or 0, 0, len(games) - 1)]
        if game.get("tbd"):
            self.status_message = "That game is postponed - no date yet."
            return
        if center:
            self.peek_center(self.league, game)      # over the team page: esc comes back
            return
        target = "Scouting" if game["state"] == "pre" else "Boxscore"
        self.open_game(self.league, game, target if target in self.tabs else None)

    def handle_schedule_key(self, key, team):
        """j / k pick a game of a team's schedule, enter opens it, z puts it
        in the Game Center, t goes back to the next game, v switches a narrow
        screen between the games and the season, m opens the roster. True
        when the key was one of those."""
        games = self._sched_games
        team_key = (self.league, team["id"])
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10, ord("J"): 10,
                 ord("K"): -10, curses.KEY_HOME: -10 ** 6,
                 curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key == ord("v") and team_schedules(self.league):
            if self._team_page_wide:
                self.status_message = "The season and the games are both on screen here."
            else:
                self.sched_view = "games" if self.sched_view == "season" else "season"
                self.scroll["TeamPage"] = 0
                self.status_message = ("The season: j / k scroll, V back to the games."
                                       if self.sched_view == "season" else
                                       "The games, one a line; V the season again.")
            return True
        season = self.sched_view == "season" and not self._team_page_wide
        if season and key in moves:
            step = moves[key]
            self.scroll["TeamPage"] = max(0, self.scroll["TeamPage"] + (
                step if abs(step) < 10 ** 5 else (10 ** 5 if step > 0 else -10 ** 5)))
            return True
        if key == ord("z") and games:
            self.open_schedule_game(center=True)
            return True
        if key in moves and games:
            now = self.sched_cursor.get(team_key) or 0
            self.sched_cursor[team_key] = clamp(now + moves[key], 0, len(games) - 1)
            return True
        if key in (10, 13, curses.KEY_ENTER):
            self.open_schedule_game()
            return True
        if key == ord("t") and games:
            self.sched_cursor[team_key] = schedule_focus(games)
            return True
        if key == ord("m") and team_rosters(self.league):
            self.open_roster(team)
            return True
        return False

    def handle_standings_key(self, key):
        """j / k pick a team in the standings and enter opens its whole
        schedule; there, esc or backspace come back."""
        if self.standings_team and self.standings_team[0] == self.league:
            if key in (27, curses.KEY_BACKSPACE, 127, 8):
                self.standings_team = None
                return True
            return self.handle_schedule_key(key, self.standings_team[1])
        spots = self._standings_spots
        order = getattr(self, "_standings_order", None) or []
        if order:
            # the conference list: j / k walk every team, conference by
            # conference; h / l jump a conference
            ids = [str(team.get("id")) for team, _ in order]
            now = str(self.standings_sel.get(self.league))
            index = ids.index(now) if now in ids else 0
            jumps = {ord("h"): -1, curses.KEY_LEFT: -1, ord("l"): 1, curses.KEY_RIGHT: 1}
            if key in jumps:
                group = order[index][1] + jumps[key]
                first = next((team for team, n in order if n == group), None)
                if first is not None:
                    self.standings_sel[self.league] = first["id"]
                    self.scroll["Standings"] = 0
                return True
            moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                     curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10, curses.KEY_HOME: -10 ** 6,
                     curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
            if key in moves:
                self.standings_sel[self.league] = order[clamp(index + moves[key], 0,
                                                              len(ids) - 1)][0]["id"]
                self._standings_follow = True
                return True
            if key in (10, 13, curses.KEY_ENTER):
                self.open_standings_schedule(order[index][0])
                return True
            return False
        if not spots:
            return False
        ids = [s["team"]["id"] for s in spots]
        now = self.standings_sel.get(self.league)
        index = ids.index(now) if now in ids else 0
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10, curses.KEY_HOME: -10 ** 6,
                 curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key in moves:
            self.standings_sel[self.league] = ids[clamp(index + moves[key], 0,
                                                        len(ids) - 1)]
            self._standings_follow = True
            return True
        if key in (10, 13, curses.KEY_ENTER):
            self.open_standings_schedule(spots[index]["team"])
            return True
        return False

    def open_standings_schedule(self, team):
        self.standings_team = (self.league, team)
        self.sched_cursor.pop((self.league, team["id"]), None)
        self.scroll["Schedule"] = 0
        if team_schedules(self.league):
            self.status_message = f"{team.get('name') or team.get('abbr')}: the season, " \
                                  "game by game - enter opens one."

    def click_standing(self, team_id, open_it=False):
        again = self.clicked_again("standing", self.league, team_id)
        self.standings_sel[self.league] = team_id
        if again or open_it:
            team = next((s["team"] for s in self._standings_spots
                         if s["team"]["id"] == team_id), None) or \
                next((t for t, _ in getattr(self, "_standings_order", None) or []
                      if str(t.get("id")) == str(team_id)), None)
            if team:
                self.open_standings_schedule(team)
                return True
        return False

    def step_players_view(self):
        """g on a team: season totals, then the last game, then the schedule."""
        order = ("season", "game", "schedule")
        now = self.players_view if self.players_view in order else "season"
        self.players_view = order[(order.index(now) + 1) % len(order)]
        self.scroll["Players"] = 0
        if self.players_view == "schedule" and self.stats_team:
            self.sched_cursor.pop((self.league, self.stats_team[1]["id"]), None)
            self.scroll["Schedule"] = 0
        self.status_message = {"season": "Season totals.",
                               "game": "Last game, player by player.",
                               "schedule": "The season, game by game - enter opens one."}[
                                   self.players_view]

    def load_last_game(self, team):
        if self.league == "ahl":
            source = Loader("lscluster.hockeytech.com", ahl_last_game, team["id"])
        else:
            source = Loader(SITE_HOSTS[0], espn_last_game, self.league, team["id"])
        return self.fetcher.get(("lastgame", self.league, team["id"]), source, ttl=900)

    # -- the keys worth knowing on this screen, for the footer -------------

    def screen_hints(self):
        tab = self.tab_name
        league = self.league
        college = league in COLLEGE_LEAGUES
        grouped = not is_olympic(league)
        if self.show_help or self.show_info:
            return [("j/k", "scroll"), ("esc", "close")]
        if self.video:
            many = len(self.video["items"]) > 1
            if self.video["engine"] == "window":
                return [("r", "again")] + ([("n/N", "the other one")] if many else []) + \
                    [("esc", "stop")]
            return [("space", "pause"), ("←→", "10 s"), ("r", "from the start")] + \
                ([("n/N", "the other one")] if many else []) + [("esc", "close")]
        if self.article:
            hints = [("j/k", "scroll"), ("space", "page")]
            if self.article.get("_web"):
                hints += [("o", "espn.com")]
            if self.article.get("_video"):
                hints += [("enter", "play the video")]
            if len(self._news_refs) > 1:
                hints += [("n/N", "next headline")]
            if self.player:
                hints += [("x", "stop")]
            return hints + [("esc", "close")]
        if self.calendar:
            return [("←→↑↓", "day / week"), ("[ ]", "month"), ("n/N", "game day"),
                    ("f", "your team"), ("t", "today"), ("enter", "go"), ("esc", "close")]
        if self.popup:
            return [("j/k", "move"), ("enter", "pick"), ("/", "filter"), ("esc", "close")]
        if self.crt_card:
            row = self.CRT_CARD_ROWS[clamp(self.crt_card["cursor"], 0,
                                           len(self.CRT_CARD_ROWS) - 1)]
            if row == "font":
                return [("j/k", "row"), ("h/l", "font"),
                        ("enter", "use it" if kitty_pid() is not None else "copy its line"),
                        ("esc", "close")]
            if row == "size":
                return [("j/k", "row"), ("h/l", "smaller / bigger"), ("enter", "now"),
                        ("r", "Kitty's own"), ("esc", "close")] if kitty_pid() is not None \
                    else [("j/k", "row"), ("esc", "close")]
            if row in ("crt", "phosphor", "meters"):
                return [("j/k", "row"), ("h/l", "choice"), ("enter", "change"),
                        ("esc", "close")]
            return [("j/k", "effect"), ("h/l", "less / more"), ("0-9", "level"),
                    ("enter", "off / back")] + \
                ([("t", "try it")] if row in self.CRT_CARD_TRY else []) + \
                [("r", "standard"), ("u", "undo"), ("esc", "close")]
        if self.settings_card:
            return self.settings_card_hints()
        if self.roster:
            return self.roster_hints()
        if self.kim:
            return [("enter", "skip / close"), ("j/k", "scroll"), ("r", "ask again"),
                    ("esc", "close")]
        if self.center and self.center.get("wiki"):
            return [("j/k", "next / previous event"), ("enter", "every round"),
                    ("esc", "close"), ("i", "info"), ("?", "help")]
        if self.center:
            opens = "scouting" if self.center["event"]["state"] == "pre" else "box score"
            return [("j/k", "next / previous game"), ("enter", opens),
                    ("r", "refresh"), ("esc", "close"), ("i", "info"), ("?", "help")]
        tail = [("i", "info"), ("?", "help")]
        if tab == "Overview":
            one = "events" if is_wiki_sport(league) else "scores"
            if self.overview_side == "today" and self._today_items:
                return [("j/k", "game"), ("h/l", "column"), ("enter", "open"),
                        ("tab", "next tab"), ("1", one), ("0", "favorites"),
                        ("p", "league"), ("O", "settings")] + tail
            if not overview_entries(self.favorites):
                return [("tab", "next tab"), ("0", "favorites"), ("1", one),
                        ("p", "league"), ("O", "settings")] + tail
            side_name = "game stats" if self.overview_side == "last" else "scouting"
            return [("j/k", "team"), ("←/→", "result / next"), ("enter", side_name),
                    ("b", "last result"), ("tab", "next tab"), ("1", one),
                    ("0", "favorites"), ("p", "league"), ("O", "settings")] + tail
        if is_wiki_sport(league):
            if tab == "Events":
                return [("j/k", "event"), ("enter", "results"), ("z", "event center"),
                        ("e", "sport"),
                        ("h/l", "Games"), ("/", "find")] + tail
            if tab == "Settings":
                pass
            elif tab != "Favorites":
                return [("j/k", "scroll"), ("e", "sport"), ("h/l", "Games"),
                        ("tab", "next tab")] + tail
        if tab == "Scoreboard":
            step = "week" if self.week_mode and LEAGUES[league]["week_based"] else "day"
            hints = [("j/k", "game"), ("enter", "open"), ("z", "game center"),
                     ("h/l", step), ("C", "calendar"), ("t", "today")]
            if is_olympic(league):
                hints = [("j/k", "game"), ("enter", "open"), ("z", "game center"),
                         ("e", "sport"), ("h/l", "Games")]
            hints += [("/", "find")]
            if not is_wiki_sport(league):
                hints += [("o", "every game" if self.live_only else "live only")]
            if grouped:
                hints += [("c", "conference" if college else "division")]
            elif is_olympic(league) and not is_wiki_sport(league):
                hints += [("c", "group")]
            hints += [("p", "league")]
            if BETTING.enabled and league in BETTING_LEAGUES:
                hints += [("u", "upset")]
            return hints + [("r", "refresh")] + tail
        if tab == "Scouting":
            if is_olympic(league):
                step = "Games"
            else:
                step = "week" if self.week_mode and LEAGUES[league]["week_based"] else "day"
            event = self.current_event()
            news = []
            if self._news_refs and event and self._news_event == event["id"]:
                picked = self.news_sel.get(event["id"]) is not None
                news = [("n/N", "headline"), ("enter", "read it" if picked else "pick one")]
            return [("j/k", "scroll")] + news + [("z", "game center"), ("1", "games"),
                                                 ("h/l", step), ("tab", "next tab"),
                                                 ("p", "league")] + tail
        if tab == "Boxscore" and league in CARD_LEAGUES:
            event = self.current_event()
            if self._box_refs and event and self._box_event == event["id"]:
