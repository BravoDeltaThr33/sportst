    def close_kim(self):
        self.kim = None
        self.kim_next = None
        self.crt.hold_glow = False
        self.stdscr.timeout(200)
        # hand the exact-colour block back to logos and the Overview title
        self.palette.logo_begin(("free", time.time()))
