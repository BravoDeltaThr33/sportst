def crt_font_key(name):
    name = str(name or "own").lower()
    return name if name in CRT_FONT_INFO else "own"


def installed_font_families():
    """{family in lower case: as fontconfig spells it} for the fonts
    installed, asked once in the background; None while it is still being
    asked, False where there is no fc-list to ask."""
    if not FONT_FAMILIES["asked"]:
        FONT_FAMILIES["asked"] = True

        def ask():
            import subprocess
            try:
                out = subprocess.run(["fc-list", ":", "family"], capture_output=True,
                                     text=True, timeout=10).stdout
            except (OSError, subprocess.SubprocessError, ValueError):
                FONT_FAMILIES["names"] = False
                return
            names = {}
            for line in out.splitlines():
                for part in line.split(","):
                    part = part.strip().replace("\\-", "-")
                    if part:
                        names.setdefault(part.lower(), part)
            FONT_FAMILIES["names"] = names or False

        try:
            threading.Thread(target=ask, daemon=True).start()
        except RuntimeError:
            FONT_FAMILIES["names"] = False
    return FONT_FAMILIES["names"]


def terminal_kind():
    """"kitty", "ghostty" or "" (another terminal): from what the terminal
    answered when sportst started, and its environment."""
    name = str(TERMINAL.get("name") or "").lower()
    term = os.environ.get("TERM", "")
    if "ghostty" in name or "ghostty" in term or \
            os.environ.get("TERM_PROGRAM", "").lower() == "ghostty":
        return "ghostty"
    if "kitty" in name or term == "xterm-kitty" or os.environ.get("KITTY_WINDOW_ID"):
        return "kitty"
    return ""


def crt_font_family(key, kind=None):
    """(the family to set, the names it may be installed under, where to get
    it) for one of CRT_FONTS in this terminal."""
    key = crt_font_key(key)
    _, family, names, where = CRT_FONT_INFO[key]
    kind = terminal_kind() if kind is None else kind
    if kind == "kitty" and key in CRT_FONT_KITTY:
        family, names, where = CRT_FONT_KITTY[key]
    return family, names, where


def crt_font_installed(key, kind=None):
    """The family as installed (fontconfig's spelling) when the font is,
    False when it is not, None when nobody can say (fontconfig still being
    asked, or not here; or the terminal's own font)."""
    family, names, _ = crt_font_family(key, kind)
    if not family:
        return None
    found = installed_font_families()
    if not found:
        return None
    matches = sorted((name for name in found if any(name.startswith(w) for w in names)),
                     key=lambda name: (len(name), name))
    return found[matches[0]] if matches else False


def terminal_config_path(kind):
    """The terminal's config file: the first that exists, else where it
    would go; None for a terminal sportst does not know."""
    home = os.path.expanduser("~")
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    if kind == "kitty":
        folder = os.environ.get("KITTY_CONFIG_DIRECTORY") or os.path.join(base, "kitty")
        return os.path.join(folder, "kitty.conf")
    if kind == "ghostty":
        places = [os.path.join(base, "ghostty", "config.ghostty"),
                  os.path.join(base, "ghostty", "config")]
        if sys.platform == "darwin":
            mac = os.path.join(home, "Library", "Application Support", "com.mitchellh.ghostty")
            places += [os.path.join(mac, "config.ghostty"), os.path.join(mac, "config")]
        return next((path for path in places if os.path.isfile(path)), places[1])
    return None


def terminal_font(kind=None):
    """(the font family the terminal's config file sets, or None; that file,
    or None): the file is read again at most every few seconds. It notes
    the font size the file sets too (terminal_font_size) and, in Kitty,
    what sportst's own block sets (KITTY_MARK)."""
    kind = terminal_kind() if kind is None else kind
    now = time.monotonic()
    if TERMINAL_FONT["kind"] == kind and now - TERMINAL_FONT["at"] < 5:
        return TERMINAL_FONT["found"]
    path, family, size = terminal_config_path(kind), None, None
    text = ""
    if path:
        try:
            with open(path, encoding="utf-8", errors="replace") as handle:
                text = handle.read(500_000)
        except OSError:
            text = ""
    lines = text.splitlines()
    for raw in lines:
        line = raw.strip()
        if kind == "kitty":
            part = line.split(None, 1)
            if len(part) == 2 and part[0] == "font_family":
                value = part[1].strip()
                named = re.search(r"""family=(?:"([^"]+)"|'([^']+)'|(\S+))""", value)
                family = (named.group(1) or named.group(2) or named.group(3)) \
                    if named else value
            elif len(part) == 2 and part[0] == "font_size":
                try:
                    size = float(part[1].split()[0])
                except ValueError:
                    pass
        else:
            sized = re.match(r"font-size\s*=\s*([0-9]+(?:\.[0-9]+)?)", line)
            if sized:
                size = float(sized.group(1))
            found = re.match(r"font-family\s*=\s*(.*)$", line)
            if found:
                value = found.group(1).strip()
                if len(value) >= 2 and value[0] == value[-1] == '"':
                    value = value[1:-1]
                if not value:
                    family = None           # an empty one starts the list again
                elif family is None:
                    family = value          # the first is the font; the rest fall back
    TERMINAL_FONT.update(at=now, kind=kind, found=(family, path), size=size,
                         block=kitty_block(lines)[2] if kind == "kitty" else {})
    return family, path


def terminal_font_size(kind=None):
    """(the font size in points the terminal's config file leaves it at, or
    None where sportst cannot tell; where it comes from: "sportst", "config"
    or "default" - Kitty's own 11 where kitty.conf sets none)."""
    kind = terminal_kind() if kind is None else kind
    terminal_font(kind)
    size = TERMINAL_FONT.get("size")
    if "font_size" in (TERMINAL_FONT.get("block") or {}):
        return size, "sportst"
    if size is not None:
        return size, "config"
    return (KITTY_FONT_SIZE, "default") if kind == "kitty" else (None, None)


def kitty_pid():
    """Kitty's process id where sportst can have Kitty read kitty.conf again:
    sportst running in Kitty on this machine (KITTY_PID), not over ssh."""
    if terminal_kind() != "kitty" or any(os.environ.get(name) for name in
                                         ("SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY")):
        return None
    try:
        pid = int(os.environ.get("KITTY_PID", ""))
        os.kill(pid, 0)
    except (ValueError, OSError):
        return None
    return pid


def kitty_block(lines):
    """(where sportst's block starts and ends among kitty.conf's lines, what
    it sets) - (None, None, {}) when the file has none."""
    for start, line in enumerate(lines):
        if line.strip() == KITTY_MARK:
            end, found = start + 1, {}
            while end < len(lines):
                part = lines[end].strip().split(None, 1)
                if len(part) != 2 or part[0] not in KITTY_KEYS:
                    break
                found[part[0]] = part[1].strip()
                end += 1
            return start, end, found
    return None, None, {}


def set_kitty_fonts(changes, path=None, pid=None):
    """Put `changes` ({"font_family": a family, "font_features": its
    features, "font_size": points; None takes sportst's line back out}) in
    sportst's block at the end of
    kitty.conf, and have Kitty read the file again. The rest of the file
    stays as it was; before sportst first adds its block, a copy of the file
    is kept beside it. Returns what went wrong, or ""."""
    import signal
    pid = kitty_pid() if pid is None else pid
    if pid is None:
        return "only Kitty, on this machine, lets sportst set its font"
    path = path or terminal_config_path("kitty")
    try:
        with open(path, encoding="utf-8", errors="replace", newline="") as handle:
            text = handle.read()
        there = True
    except FileNotFoundError:
        text, there = "", False
    except OSError as exc:
        return f"cannot read {home_path(path)} ({exc.strerror or exc})"
    newline = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines()
    start, end, found = kitty_block(lines)
    if start is not None:
        # the block out, with the blank line sportst put before it
        del lines[start - 1 if start and not lines[start - 1].strip() else start:end]
    for key, value in changes.items():
        if value is None:
            found.pop(key, None)
        else:
            found[key] = f"{value:g}" if isinstance(value, float) else str(value)
    while lines and not lines[-1].strip():
        lines.pop()
    if found:
        lines += ([""] if lines else []) + [KITTY_MARK] + \
            [f"{key} {found[key]}" for key in KITTY_KEYS if key in found]
    new = newline.join(lines) + (newline if lines else "")
    if new != text:
        try:
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            backup = path + ".sportst-backup"
            if there and start is None and not os.path.exists(backup):
                shutil.copy2(path, backup)
            if os.path.islink(path):
                # a link into someone's dotfiles: write through it, keep the link
                with open(path, "w", encoding="utf-8", newline="") as handle:
                    handle.write(new)
            else:
                temp = f"{path}.sportst-{os.getpid()}"
                with open(temp, "w", encoding="utf-8", newline="") as handle:
                    handle.write(new)
                if there:
                    shutil.copymode(path, temp)
                os.replace(temp, path)
        except OSError as exc:
            return f"cannot write {home_path(path)} ({exc.strerror or exc})"
    TERMINAL_FONT["at"] = -60.0             # read the file again next time
    try:
        os.kill(pid, signal.SIGUSR1)        # Kitty reads kitty.conf again
    except OSError as exc:
        return f"Kitty could not be told ({exc.strerror or exc})"
    return ""


def font_features_line(family):
    """Kitty's font_features for a family: its regular face's PostScript name
    (fontconfig's fc-match) with the ligatures off - or None where fontconfig
    cannot say."""
    import subprocess
    tool = shutil.which("fc-match")
    if not tool:
        return None
    try:
        answer = subprocess.run([tool, "-f", "%{family}|%{postscriptname}",
                                 f"{family}:style=Regular"], capture_output=True,
                                text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    families, _, name = answer.partition("|")
    # fc-match always names some font: only this family's will do
    if family.lower() not in families.lower() or \
            not re.fullmatch(r"[A-Za-z0-9_.+-]+", name.strip()):
        return None
    return f"{name.strip()} -liga"


def font_size_text(app=None):
    """The Font size row's value, in a few words."""
    wanted = getattr(app, "font_size_wanted", None)
    if wanted is not None:
        return f"{wanted:g} pt in a moment"
    size, source = terminal_font_size()
    if size is None:
        return "the terminal's own"
    return f"{size:g} pt · " + {"sportst": "set by sportst", "config": "from its config",
                                "default": "Kitty's own"}.get(source, "")


def font_config_line(family, kind=None):
    """(the line that sets the font, the file it goes in, how to load it)
    for this terminal."""
    kind = terminal_kind() if kind is None else kind
    path = terminal_config_path(kind)
    where = home_path(path) if path else "your terminal's font setting"
    mac = sys.platform == "darwin"
    if kind == "ghostty":
        return (f'font-family = "{family}"', where,
                ("cmd+shift+," if mac else "ctrl+shift+,") + " reloads it")
    if kind == "kitty":
        return (f"font_family {family}", where,
                ("ctrl+cmd+," if mac else "ctrl+shift+F5") + " reloads it")
    return family, where, ""


def crt_font_word(key, kind=None):
    """A few words on a font here: installed, not installed, in use..."""
    key = crt_font_key(key)
    current, _ = terminal_font(kind)
    if key == "own":
        return current or ""
    family, names, _ = crt_font_family(key, kind)
    if current and any(current.lower().startswith(want) for want in names):
        return "in use"
    state = crt_font_installed(key, kind)
    if state:
        return "installed"
    if state is False:
        return "not installed"
    return "looking…" if installed_font_families() is None else "not checked here"


def crt_font_advice(key, kind=None):
    """What the CRT effects card says about a font, for this terminal."""
    kind = terminal_kind() if kind is None else kind
    key = crt_font_key(key)
    current, path = terminal_font(kind)
    name = os.path.basename(path) if path else "the terminal's config"
    direct = kind == "kitty" and kitty_pid() is not None
    ours = "font_family" in (TERMINAL_FONT.get("block") or {})
    if key == "own":
        if direct and ours:
            return f"enter takes sportst's font back out of {name}: Kitty's own again."
        return (f"sportst leaves the font alone: {name} sets {current}." if current else
                "sportst leaves the terminal's font alone.")
    family, names, where = crt_font_family(key, kind)
    state = crt_font_installed(key, kind)
    line, place, reload = font_config_line(state or family, kind)
    parts = []
    if current and any(current.lower().startswith(want) for want in names):
        parts.append(f"In use: {name} sets {current}.")
    elif state is False:
        parts.append(f"Not installed here - get it: {where}.")
    elif state is None and installed_font_families() is False:
        parts.append(f"sportst cannot see the installed fonts here; it comes from {where}.")
    if direct:
        parts.append(f"enter puts   {line}   at the end of {name} and Kitty reads it "
                     "again: the font changes at once.")
    elif kind:
        parts.append(f"enter copies   {line}   for {place}" +
                     (f" ({reload})." if reload else "."))
    else:
        parts.append(f"enter copies its name, {state or family}, for your terminal's font "
                     "setting.")
    return " ".join(parts)


def copy_to_clipboard(text):
    """Text onto the clipboard through the terminal (OSC 52: Kitty, Ghostty
    and most others; nothing happens where it is turned off)."""
    import base64
    write_terminal(b"\x1b]52;c;" + base64.b64encode(text.encode("utf-8")) + b"\x07")


def crt_effect_now(key, level, phosphor="green"):
    """What an effect's level comes to, in a few words."""
    amount = level / CRT_STANDARD
    if not level:
        return {"blacks": "true black", "power": "no sweep: the picture is simply there",
                "trails": "no trails", "burn": "nothing burns in (and what had is wiped)",
                "slips": "rows never slip", "type": "text appears at once",
                "post": "no self test: straight to the first screen",
                "blink": "alerts hold still", "flash": "numbers change quietly",
                "curve": "a flat face", "glare": "no glare: the glass is clear",
                "bezel": "no frame: the picture to the edges"
                }.get(key, "off")
    if key == "type":
        return f"a full screen in about {CRT_TYPE * amount:.1f} s"
    if key == "post":
        return f"about {CRT_POST * amount * (CRT_POST_LINES + 4):.1f} s; any key skips it"
    if key == "blink":
        return f"{1 / (2 * CRT_BLINK / amount):.2g} blinks a second"
    if key == "flash":
        return f"{sum(CRT_FLASH) * amount:.2f} s of light"
    if key == "blacks":
        spec = CRT_PHOSPHORS.get(phosphor) or CRT_PHOSPHORS["green"]
        return "a black of #%02X%02X%02X" % crt_black(spec, amount)
    if key == "power":
        return f"takes {CRT_BOOT[2] * amount:.2f} s; any key skips it"
    if key == "trails":
        return f"a trail lasts {sum(CRT_TRAIL) * amount:.2f} s"
    if key == "burn":
        wait = CRT_BURN / amount
        return "burns in after " + (f"{round(wait)} s" if wait < 120 else
                                    f"{wait / 60:.1f} minutes") + " on screen"
    if key == "slips":
        return f"about every {round(sum(CRT_SLIP) / 2 / amount)} s"
    strength = "the standard" if level == CRT_STANDARD else f"{amount:g}× the standard"
    if key == "hum":
        return f"every {CRT_HUM:g} s, {strength}"
    return strength


def crt_phosphor(name):
    name = str(name or "green").lower()
    return name if name in CRT_PHOSPHORS else "green"


def crt_tint(rgb, phosphor, role=None):
    """A colour as the phosphor shows it: its brightness on the phosphor's
    ramp, from the raised black up to the phosphor's colour and, at the very
    top, towards white. Text (`role` "text") is never so dark the beam
    barely lights it, and a background that is not black (`role` "back":
    the cursor bar, a highlighted row) is never so dim it vanishes. In
    colour: the colour itself, with no black darker than the raised one."""
    spec = CRT_PHOSPHORS.get(phosphor) or CRT_PHOSPHORS["green"]
    black, peak, white = crt_black(spec), spec[2], spec[3]
    if peak is None:
        return tuple(max(c, k) for c, k in zip(rgb, black))
    lum = (0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]) / 255.0
    if role == "text":
        lum = 0.5 + 0.5 * lum
    elif role == "back" and lum > 0.02:
        lum = 0.18 + 0.82 * lum
    if lum < 0.8:
        t = lum / 0.8
        return tuple(round(k + (p - k) * t) for k, p in zip(black, peak))
    t = min(1.0, (lum - 0.8) / 0.2)
    return tuple(round(p + (w - p) * t) for p, w in zip(peak, white))


def crt_shade(phosphor, level):
    """The phosphor at a brightness from 0 to 1, as #RRGGBB."""
    value = max(0, min(255, round(level * 255)))
    return "#%02X%02X%02X" % crt_tint((value, value, value), phosphor)


def crt_png(png, phosphor):
    """A picture in the phosphor's colours (unchanged in colour)."""
    spec = CRT_PHOSPHORS.get(phosphor)
    if not png or not spec or spec[2] is None:
        return png
    key = (phosphor, crt_black(spec), len(png), hash(png))
    hit = CRT_PNGS.get(key)
    if hit is not None:
        return hit
    decoded = png_decode(png)
    if not decoded:
        return png
    width, height, rgba = decoded
    ramp = [bytes(crt_tint((v, v, v), phosphor)) for v in range(256)]
    out = bytearray(rgba)
    for i in range(0, len(out), 4):
        out[i:i + 3] = ramp[(54 * out[i] + 183 * out[i + 1] + 19 * out[i + 2]) >> 8]
    result = png_encode(width, height, out)
    if len(CRT_PNGS) > 40:
        CRT_PNGS.clear()
    CRT_PNGS[key] = result
    return result


def kitty_raw(image_id, rgba, width, height):
    """Escape codes that store width x height RGBA pixels, deflated, as
    picture `image_id` without showing it (q=2: no replies)."""
    import base64
    data = base64.b64encode(zlib.compress(bytes(rgba), 6))
    return _kitty_chunks(f"a=t,f=32,t=d,o=z,q=2,i={image_id},s={width},v={height}", data)


def _kitty_chunks(head, data):
    parts = []
    for start in range(0, max(1, len(data)), 4096):
        more = 1 if start + 4096 < len(data) else 0
        keys = f"{head},m={more}" if start == 0 else f"m={more}"
        parts.append(b"\x1b_G" + keys.encode() + b";" + data[start:start + 4096] + b"\x1b\\")
    return b"".join(parts)


def kitty_frames(image_id, frames, width, height):
    """Frames of RGBA as one picture, the first showing: sportst picks the
    frame itself (a=a with c=, CrtGlass.step), so everything that moves on
    the glass changes in the same write and the terminal draws it once. The
    terminal's own animation stays stopped. A terminal without frames keeps
    showing the first."""
    import base64
    parts = [kitty_raw(image_id, frames[0], width, height)]
    for frame in frames[1:]:
        data = base64.b64encode(zlib.compress(bytes(frame), 6))
        parts.append(_kitty_chunks(f"a=f,f=32,t=d,o=z,q=2,X=1,i={image_id},s={width},"
                                   f"v={height}", data))
    parts.append(f"\x1b_Ga=a,i={image_id},s=1,c=1,q=2\x1b\\".encode())
    return b"".join(parts)


def crt_scaled_size(width, height, most=400):
    """The smallest picture size with exactly the screen's shape, so the
    terminal can stretch it over the screen without a gap (a stretched
    picture keeps its shape); None when there is none under `most`."""
    g = math.gcd(width, height)
    w, h = width // g, height // g
    return (w, h) if w <= most and h <= most else None


def crt_raster(width, height, mono, scan=1.0, stripes=1.0):
    """Scanlines and the aperture grille over the whole screen: every third
    pixel row a dark gap and the row before it a third as dark, the pixel
    columns tinted red, green and blue in turn, faintly. `scan` and
    `stripes` are their strengths (1 the standard). Straight even with
    Curvature: rows this fine bowed on the screen's pixel grid broke their
    rhythm along curves across the screen - wavy creases (6.9.0-6.10.1) -
    so the rim and the bezel show the bulge."""
    grille = (0.018 if mono else 0.032) * stripes
    units = []
    for dark in (0.0, min(0.3, 0.12 * scan), min(0.85, 0.38 * scan)):
        unit = b""
        for colour in ((255, 70, 70), (70, 255, 70), (70, 70, 255)):
            alpha = dark + grille * (1 - dark)
            if alpha <= 0:
                unit += bytes(colour) + b"\x00"
                continue
            rgb = bytes(round(c * grille * (1 - dark) / alpha) for c in colour)
            unit += rgb + bytes([round(alpha * 255)])
        units.append(unit)
    rows = [(unit * (width // 3 + 1))[:width * 4] for unit in units]
    return b"".join(rows[y % 3] for y in range(height))

def crt_barrel(u, v, k):
    """Where a point of the screen (u, v from -1 to 1) shows the picture
    from, on a tube bulging by k: further out toward the edges."""
    shift = 1 - k * (u * u + v * v)
    return (u / shift, v / shift) if shift > 0 else (9.0, 9.0)


def crt_sheen(width, height, curve, framed, glare=1.0):
    """The glass's own picture, stretched over the screen: with `curve`
    (Curvature) the picture falling away round a curved rim - darker beyond
    it, a little darker just inside it - and with `glare` (Glare) a soft
    oval of light high on the left of the glass, curved or flat. Beyond the
    rim is only part dark where there is no bezel's margin, so nothing the
    app drew there is lost."""
    k = CRT_CURVE * curve
    beyond = 0.92 if framed else 0.5
    bright = 0.035 * min(2.0, max(0.0, glare))
    rows = []
    for py in range(height):
        v = (py + 0.5) / height * 2 - 1
        row = bytearray()
        for px in range(width):
            u = (px + 0.5) / width * 2 - 1
            rim = 0.0
            if k:
                su, sv = crt_barrel(u, v, k)
                edge = max(abs(su), abs(sv)) - 1
                rim = min(1.0, max(0.0, (edge + 0.025) / 0.05)) * beyond
            du, dv = (u + 0.42) / 0.55, (v + 0.58) / 0.30
            gleam = max(0.0, 1 - (du * du + dv * dv)) ** 3 * bright
            if rim >= gleam:
                row += bytes((0, 0, 0, round(rim * 255)))
            else:
                row += bytes((255, 255, 255, round(gleam * 255)))
        rows.append(bytes(row))
    return b"".join(rows)


def crt_bezel(width, height, ring_x, ring_y, round_by, curve):
    """The bezel: a dark frame over the outer ring of cells the app left
    for it (ring_x, ring_y pixels), its opening's corners rounded by
    `round_by` (1 the standard) and its edges bowing out with `curve`, the
    tube set back behind it - a soft shadow inside the opening's edge."""
    inset_x, inset_y = ring_x * 0.62, ring_y * 0.62
    radius = max(4.0, min(ring_x, ring_y) * 1.8 * round_by)
    bulge_x, bulge_y = ring_x * 0.3 * min(2.0, curve), ring_y * 0.3 * min(2.0, curve)
    shadow = max(3.0, min(ring_x, ring_y) * 0.55 * min(2.0, 0.5 + round_by / 2))
    left, top, bottom = inset_x, inset_y, height - inset_y
    cx, cy = width / 2, height / 2

    def edge_x(y):
        """The opening's left bound in a row (its right bound mirrors it)."""
        t = (y - cy) / max(1.0, cy - top)
        bound = left - bulge_x * max(0.0, 1 - t * t)
        if y < top + radius:
            d = top + radius - y
            bound = max(bound, left + radius - math.sqrt(max(0.0, radius * radius - d * d)))
        elif y > bottom - radius:
            d = y - (bottom - radius)
            bound = max(bound, left + radius - math.sqrt(max(0.0, radius * radius - d * d)))
        return bound

    def edge_y(x):
        """The opening's top bound in a column (its bottom mirrors it)."""
        t = (x - cx) / max(1.0, cx - left)
        return top - bulge_y * max(0.0, 1 - t * t)

    frame = []
    for y in range(height):
        shade = 34 - round(14 * y / max(1, height - 1))
        frame.append(bytes((shade, shade, shade + 2, 255)))
    clear = b"\x10\x10\x12\x00"
    tops = [edge_y(x + 0.5) for x in range(width)]
    rows = []
    for y in range(height):
        fill = frame[y]
        yc = y + 0.5
        near = min(yc, height - yc)
        bound = edge_x(yc)
        if near < top + shadow + 2 or near < radius + top:
            # the bands along the top and bottom: worked out pixel by pixel
            row = bytearray()
            for x in range(width):
                xc = x + 0.5
                inside_x = min(xc - bound, width - bound - xc)
                inside_y = near - tops[x]
                inside = min(inside_x, inside_y)
                if inside <= -0.5:
                    row += fill
                elif inside < 0.5:
                    row += fill[:3] + bytes([round(255 * (0.5 - inside))])
                elif inside < shadow:
                    row += bytes((0, 0, 0, round(150 * (1 - inside / shadow) ** 2)))
                else:
                    row += clear
            rows.append(bytes(row))
            continue
        solid = max(0, int(bound - 0.5))
        part = bound - solid                    # how far the edge pixel is in
        edge = fill[:3] + bytes([round(255 * max(0.0, min(1.0, 1 - part)))])
        ramp = [bytes((0, 0, 0, round(150 * (1 - (i + 0.5) / shadow) ** 2)))
                for i in range(int(shadow))]
        middle = width - 2 * (solid + 1 + len(ramp))
        if middle <= 0:
            rows.append(fill * width)
            continue
        rows.append(fill * solid + edge + b"".join(ramp) + clear * middle +
                    b"".join(reversed(ramp)) + edge + fill * solid)
    return b"".join(rows)


def crt_vignette(width, height, strength=1.0):
    """The darker edges and corners: black, clear over the middle and about
    half covering the corners (at the standard `strength`, 1), by distance
    from the centre."""
    cx, cy = max(1.0, (width - 1) / 2), max(1.0, (height - 1) / 2)
    across = bytes(min(255, round(((x - cx) / cx) ** 2 * 255)) for x in range(width))
    tables = {}
    rows = [b""] * height
    for y in range((height + 1) // 2):
        ny2 = ((y - cy) / cy) ** 2
        key = round(ny2 * 500)
        table = tables.get(key)
        if table is None:
            table = bytes(_vignette_alpha(v / 255 + ny2, strength) for v in range(256))
            tables[key] = table
        line = bytearray(width * 4)
        line[3::4] = across.translate(table)
        rows[y] = rows[height - 1 - y] = bytes(line)
    return b"".join(rows)


def _vignette_alpha(d2, strength=1.0):
    t = max(0.0, min(1.0, (math.sqrt(d2) - 0.55) / 0.86))
    return round(255 * min(0.9, 0.5 * strength * t ** 1.8))


def crt_flat(width, height, rgb, alpha):
    return bytes(list(rgb) + [alpha]) * (width * height)


def crt_band(width, height, rgb, peak=0.05):
    """The hum bar: a soft band of light, brightest across its middle."""
    rows = []
    for y in range(height):
        alpha = round(255 * peak * math.sin(math.pi * (y + 0.5) / height) ** 2)
        rows.append(bytes(list(rgb) + [alpha]) * width)
    return b"".join(rows)


def crt_grain(width, height, strength=1.0):
    """A frame of grain: faint specks, light and dark, on a third of the
    pixels (`strength` 1: the standard)."""
    count = width * height
    table = bytes(min(255, round(a * CRT_GRAIN_STANDARD * strength)) for a in CRT_GRAIN_ALPHA)
    alpha = os.urandom(count).translate(table)
    shade = os.urandom(count).translate(CRT_GRAIN_SHADE)
    out = bytearray(count * 4)
    out[0::4] = shade
    out[1::4] = shade
    out[2::4] = shade
    out[3::4] = alpha
    return bytes(out)


# how much of a cell the meters' segments and other partial blocks light
# (a raised meter block lights its whole cell through its background)
GLYPH_WEIGHTS = {"\U0001FB13": 0.4, "\U0001FB03": 0.2, "\U0001FB7F": 0.15, "▕": 0.15,
                 "▁": 0.15, "▔": 0.15, "▏": 0.15, "▖": 0.25, "▌": 0.5, "▆": 0.75,
                 "▓": 0.7, "▒": 0.45, "░": 0.25}


def crt_glyph_weight(ch):
    """How much of a cell a character lights."""
    code = ord(ch)
    weight = GLYPH_WEIGHTS.get(ch)
    if weight is not None:
        return weight
    if 0x2580 <= code <= 0x259F or 0x1FB00 <= code <= 0x1FBFF or ch in "■◼●":
        return 0.9                      # blocks, meters, logos drawn in blocks
    if 0x2500 <= code <= 0x257F:
        return 0.35                     # box drawing: thin lines
    if 0x2800 <= code <= 0x28FF:
        return 0.3                      # braille
    return 0.55


class CrtGlass:
    """CRT mode's glass, where the terminal shows pictures: see-through
    pictures placed over the text (z above 0) - the scanlines and grille,
    the vignette, the flicker veil and the grain (frames sportst steps
    through itself), the hum bar (moved a few pixels at a time, in the same
    write as those frames), the curve's rim and the glare (one picture), the
    bezel, and the glow, its fringes and the soft focus (sent again when
    the screen changes). Each is
    left out while its effect is at 0. Placed again after every frame, since
    clearing the screen takes pictures with it."""

    RASTER, VIGNETTE, VEIL, HUM, GRAIN = (CRT_IMAGE_BASE + n for n in range(5))
    SHEEN, BEZEL = CRT_IMAGE_BASE + 11, CRT_IMAGE_BASE + 12
    # the glow pictures, two sets to swap between: the bloom, its fringes
    # (+2) and the soft focus (+4)
    GLOWS = (CRT_IMAGE_BASE + 5, CRT_IMAGE_BASE + 6)
    LAYERS = (0, 2, 4)
    PARTS = {"raster": RASTER, "vignette": VIGNETTE, "veil": VEIL, "hum": HUM,
             "grain": GRAIN, "sheen": SHEEN, "bezel": BEZEL}
    MOVING = frozenset((VEIL, HUM, GRAIN))      # stepped together (step)

    def __init__(self, write):
        self.write = write
        self.geometry = None
        self.margin = (0, 0, 0, 0)
        self.sheen_size = None
        self.parts = set()          # the pictures sent for this screen
        self.glow = None            # the glow pictures on screen now (the first id)
        self.glow_layers = ()
        self.small = None
        self.scaled = False
        self.hum_h = 1
        self.tile = (1, 1)
        self.hum_top = 0.0
        self.hum_at = 0.0
        self.step_at = 0.0
        self.frames = {}            # the frame each stepped picture shows
        self.veil_frames = {}       # the flicker's darkness -> its frame

    def setup(self, cols, rows, cw, ch, phosphor, margin=(0, 0, 0, 0)):
        """Send the pictures that do not change for this screen size (and the
        ring of cells the app left for the bezel, `margin`)."""
        self.clear()
        self.geometry = (cols, rows, cw, ch, phosphor)
        self.margin = margin
        width, height = cols * cw, rows * ch
        self.small = crt_scaled_size(width, height)
        self.scaled = bool(self.small)
        self.hum_h = max(ch * 8, height // 5)
        self.tile = (min(cols, 24), min(rows, 8))
        self.write(b"".join(self.build(part) for part in self.PARTS))
        self.hum_top = -self.hum_h
        self.hum_at = time.monotonic()

    def build(self, part):
        """One of the glass's pictures as the escape codes that send it, at
        its effect's level; nothing while that is 0."""
        cols, rows, cw, ch, phosphor = self.geometry
        width, height = cols * cw, rows * ch
        spec = CRT_PHOSPHORS.get(phosphor) or CRT_PHOSPHORS["green"]
        image = self.PARTS[part]
        self.parts.discard(image)
        self.frames.pop(image, None)            # sent again, it shows its first
        framed = any(self.margin)
        if part == "raster":
            scan, stripes = crt_amount("scanlines"), crt_amount("grille")
            if not (scan or stripes):
                return b""
            data = kitty_raw(image, crt_raster(width, height, spec[2] is not None, scan,
                                               stripes), width, height)
        elif part == "sheen":
            curve, glare = crt_amount("curve"), crt_amount("glare")
            if not (curve or glare):
                return b""
            size = self.small or (192, max(1, round(192 * height / width)))
            if size[0] > 192:
                size = (192, max(1, round(192 * height / width)))
            data = kitty_raw(image, crt_sheen(*size, curve, framed, glare), *size)
            self.sheen_size = size
        elif part == "bezel":
            if not (framed and crt_amount("bezel")):
                return b""
            top, left, bottom, right = self.margin
            data = kitty_raw(image, crt_bezel(width, height, min(left, right + 1) * cw,
                                              min(top, bottom) * ch, crt_amount("bezel"),
                                              crt_amount("curve")), width, height)
        elif part == "vignette":
            strength = crt_amount("vignette")
            if not strength:
                return b""
            size = (width, height)
            if self.small:
                times = max(1, min(400 // self.small[0], 400 // self.small[1], 4))
                size = (self.small[0] * times, self.small[1] * times)
            data = kitty_raw(image, crt_vignette(*size, strength), *size)
        elif part == "veil":
            strength = crt_amount("flicker")
            if not strength:
                return b""
            veil = self.small or (96, max(1, round(96 * height / width)))
            shades = sorted(set(CRT_VEIL))
            self.veil_frames = {alpha: n + 1 for n, alpha in enumerate(shades)}
            data = kitty_frames(image, [crt_flat(*veil, (0, 0, 0),
                                                 min(255, round(alpha * strength)))
                                        for alpha in shades], *veil)
        elif part == "hum":
            strength = crt_amount("hum")
            if not strength:
                return b""
            data = kitty_raw(image, crt_band(width, self.hum_h, spec[3] or (255, 255, 255),
                                             0.01 * strength), width, self.hum_h)
        else:
            strength = crt_amount("grain")
            if not strength:
                return b""
            tile_w, tile_h = self.tile[0] * cw, self.tile[1] * ch
            data = kitty_frames(image, [crt_grain(tile_w, tile_h, strength)
                                        for _ in range(CRT_GRAIN_FRAMES)], tile_w, tile_h)
        self.parts.add(image)
        return data

    def redo(self, part):
        """Send one picture again at its effect's level now (or take it
        away, at 0); the next frame places it."""
        if not self.geometry:
            return
        self.write(f"\x1b_Ga=d,d=I,i={self.PARTS[part]},q=2\x1b\\".encode() +
                   self.build(part))
        if part == "hum":
            self.restart_hum()

    def restart_hum(self):
        self.hum_top = -self.hum_h
        self.hum_at = time.monotonic()

    @staticmethod
    def _put(row, col, image_id, z, extra="", pid=1):
        return (f"\x1b[{row + 1};{col + 1}H\x1b_Ga=p,i={image_id},p={pid},z={z},C=1,q=2"
                f"{extra}\x1b\\")

    def _hum(self):
        cols, rows, cw, ch, _ = self.geometry
        height = rows * ch
        top = int(self.hum_top)
        skip = max(0, -top)
        shown = min(self.hum_h - skip, height - max(0, top))
        if shown <= 0:
            return f"\x1b_Ga=d,d=i,i={self.HUM},q=2\x1b\\"
        at = max(0, top)
        return self._put(at // ch, 0, self.HUM, 13, f",y={skip},h={shown},Y={at % ch}")

    def place_all(self):
        if not self.geometry:
            return
        cols, rows, cw, ch, _ = self.geometry
        parts = self.parts
        out = ["\x1b7"]
        if self.RASTER in parts:
            out.append(self._put(0, 0, self.RASTER, 11))
        if self.VIGNETTE in parts:
            out.append(self._put(0, 0, self.VIGNETTE, 15,
                                 f",c={cols},r={rows}" if self.scaled else ""))
        if self.VEIL in parts:
            out.append(self._put(0, 0, self.VEIL, 14, f",c={cols},r={rows}"))
        if self.GRAIN in parts:
            tc, tr = self.tile
            pid = 1
            for ty in range(0, rows, tr):
                for tx in range(0, cols, tc):
                    out.append(self._put(ty, tx, self.GRAIN, 12, f",w={min(tc, cols - tx) * cw},"
                                         f"h={min(tr, rows - ty) * ch}", pid))
                    pid += 1
        if self.HUM in parts:
            out.append(self._hum())
        if self.SHEEN in parts:
            out.append(self._put(0, 0, self.SHEEN, 16, f",c={cols},r={rows}"))
        if self.BEZEL in parts:
            out.append(self._put(0, 0, self.BEZEL, 17))
        if self.glow:
            for layer in self.glow_layers:
                out.append(self._put(0, 0, self.glow + layer, 10, f",c={cols},r={rows}"))
        out.append("\x1b8")
        self.write("".join(out).encode())

    def step(self, now):
        """The glass's moving parts on by a step - the hum bar down the
        screen (round again from the top), the grain's and the flicker's
        next frames - in one write, so the terminal draws them together,
        ten times a second at most, not each on a clock of its own."""
        parts = self.parts
        if not self.geometry or not parts & self.MOVING or \
                now - self.step_at < CRT_GLASS_STEP:
            return
        self.step_at = now
        out = []
        if self.HUM in parts:
            _, rows, _, ch, _ = self.geometry
            travel = rows * ch + self.hum_h
            self.hum_top += travel * (now - self.hum_at) / CRT_HUM
            self.hum_at = now
            if self.hum_top >= rows * ch:
                self.hum_top = -self.hum_h
            out.append(self._hum())
        beat = int(now / CRT_GLASS_STEP)
        for image, frame in ((self.GRAIN, beat % CRT_GRAIN_FRAMES + 1),
                             (self.VEIL, self.veil_frames.get(CRT_VEIL[beat % len(CRT_VEIL)],
                                                              1))):
            if image in parts and self.frames.get(image, 1) != frame:
                out.append(f"\x1b_Ga=a,i={image},c={frame},q=2\x1b\\")
                self.frames[image] = frame
        if out:
            self.write(("\x1b7" + "".join(out) + "\x1b8").encode())

    def show_glow(self, layers):
        """Send the glow's layers, {0 bloom, 2 fringes, 4 soft focus:
        (rgba, width, height)} - the ones whose effects are on - and swap
        them in for those on screen."""
        if not self.geometry:
            return
        cols, rows = self.geometry[0], self.geometry[1]
        new = self.GLOWS[1] if self.glow == self.GLOWS[0] else self.GLOWS[0]
        order = sorted(layers)
        parts = [kitty_raw(new + layer, *layers[layer]) for layer in order]
        if order:
            parts.append(("\x1b7" + "".join(self._put(0, 0, new + layer, 10,
                                                       f",c={cols},r={rows}")
                                            for layer in order) + "\x1b8").encode())
        if self.glow:
            parts.extend(f"\x1b_Ga=d,d=I,i={self.glow + layer},q=2\x1b\\".encode()
                         for layer in self.LAYERS)
        self.glow = new if order else None
        self.glow_layers = tuple(order)
        self.write(b"".join(parts))

    def clear(self):
        """Take every picture of the glass away."""
        if self.geometry or self.glow:
            self.write(b"".join(f"\x1b_Ga=d,d=I,i={CRT_IMAGE_BASE + n},q=2\x1b\\".encode()
                                for n in range(13)))
        self.geometry = None
        self.parts = set()
        self.frames = {}
        self.glow = None
        self.glow_layers = ()


class CrtScreen:
    """CRT mode for the App: what is on the screen cell by cell, as put()
    wrote it, so the effects a screen of text can show are drawn over each
    frame - trails, burn-in, the power-on sweep, rows slipping - and the
    glow can be worked out; and the glass, where the terminal shows
    pictures. Off, it does nothing."""

    def __init__(self):
        self.on = False
        self.phosphor = "green"
        self.grid = []
        self.prev = None
        self.trails = []
        self.trail_step = 0
        self.trail_at = 0.0
        self.wear = {}
        self.burnt = {}             # row -> {column: the character burnt in}
        self.worn_at = None
        self.boot = None
        self.slip = None
        self.slip_at = 0.0
        self.glass = None
        self.glow_due = False
        self.glow_at = 0.0
        self.glow_grid = None
        self.palette = None
        self.looks = {}
        self.attrs = {}
        self.blank_attr = 0
        self.joins = frozenset(PLACEHOLDER_MARKS)
        self.typing = self.flashes = None
        self.blinks, self.blink_phase, self.blink_epoch = [], 0, None
        self.fresh = self.flash_all = False
        # an animation that redraws a pop-up every few dozen milliseconds (Ask
        # Kim's mouth and bubble) holds the glow back: working it out for the
        # whole screen takes long enough to make the animation stutter, so it
        # catches up once the animation stops. Not the glow a whole new frame
        # needs ("stale": the pop-up opening), or the old screen's would show
        # through it
        self.hold_glow = False
        self.glow_stale = False
        # the glow's pixels for a row of cells already worked out, by the row's
        # cells (the same row anywhere on the screen glows the same), for the
        # levels and colours in glow_sig
        self.glow_rows = {}
        self.glow_sig = None

    # -- on and off ----------------------------------------------------------

    def start(self, app, phosphor, boot=True):
        now = time.monotonic()
        self.on = True
        self.phosphor = crt_phosphor(phosphor)
        self.prev, self.trails, self.wear, self.burnt = None, [], {}, {}
        self.worn_at = None
        self.boot = now if boot and crt_amount("power") else None
        self.slip = None
        self.slip_at = now + self.slip_gap()
        self.glass = CrtGlass(write_terminal) if app.graphics.enabled else None
        self.glow_due, self.glow_grid = False, None
        self.typing = self.flashes = None
        self.blinks, self.blink_phase, self.blink_epoch = [], 0, None
        self.fresh = self.flash_all = False
        self.bind(app.palette)

    def stop(self):
        if self.glass:
            try:
                self.glass.clear()
            except Exception:  # noqa: BLE001 - on the way out
                pass
        self.glass = None
        self.on = False
        self.grid, self.prev, self.trails = [], None, []
        self.boot = self.slip = None
        self.typing = self.flashes = None
        self.blinks = []

    @staticmethod
    def slip_gap():
        """Seconds until the next sync slip, at the Sync slips level."""
        amount = crt_amount("slips")
        return random.uniform(*CRT_SLIP) / amount if amount else float("inf")

    @staticmethod
    def glowing():
        """Whether any of the glow's layers is on."""
        return any(crt_amount(key) for key in ("bloom", "fringes", "focus"))

    def retune(self, keys):
        """Effects whose levels have just changed (`keys`): put right what
        each touches - the glass's pictures, the glow, the timings."""
        now = time.monotonic()
        if "trails" in keys and not crt_amount("trails"):
            self.trails = []
        if "burn" in keys and not crt_amount("burn"):
            self.wear, self.burnt, self.worn_at = {}, {}, None
        if "slips" in keys:
            self.slip_at = now + self.slip_gap()
        if "power" in keys and not crt_amount("power"):
            self.boot = None
        glass = self.glass
        if glass and glass.geometry:
            for part, effects in (("raster", ("scanlines", "grille")),
                                  ("vignette", ("vignette",)), ("veil", ("flicker",)),
                                  ("hum", ("hum",)), ("grain", ("grain",)),
                                  ("sheen", ("curve", "glare", "bezel")),
                                  ("bezel", ("bezel", "curve"))):
                if any(key in keys for key in effects):
                    glass.redo(part)
        if any(key in keys for key in ("bloom", "fringes", "focus")):
            self.glow_grid = None
            if self.glowing():
                self.glow_due = True
            elif glass:
                glass.show_glow({})

    def power_on(self):
        """Play the power-on sweep again (False while Power-on is at 0)."""
        if not (self.on and crt_amount("power")):
            return False
        self.boot = time.monotonic()
        return True

    def slip_now(self):
        if not (self.on and crt_amount("slips")):
            return False
        self.slip = None
        self.slip_at = time.monotonic()
        return True

    def burn_now(self, spare=None):
        """Burn in, at once, the borders and the tab bar on the screen now -
        except inside `spare` (top, left, height, width), the card asking."""
        if not (self.on and crt_amount("burn")):
            return False
        for y, row in enumerate(self.grid):
            top = y < 3
            for x, cell in enumerate(row):
                if cell is None:
                    continue
                if spare and spare[0] <= y < spare[0] + spare[2] and \
                        spare[1] <= x < spare[1] + spare[3]:
                    continue
                ch = cell[0][:1]
                if ch != " " and (top or "─" <= ch <= "╿"):
                    self.burnt.setdefault(y, {})[x] = ch
        return True

    def bind(self, palette):
        """Use a (new) palette: its attributes for the CRT's own styles."""
        self.palette = palette
        self.looks = {}
        self.glow_rows = {}
        if palette is None:
            return
        self.blank_attr = palette("normal")
        self.attrs = {name: palette(name) for name in
                      ("crtghost", "crtfaint", "crtghostbg", "crtburn", "crtbeam",
                       "crtflash", "crtflash2")}

    # -- what is on the screen -------------------------------------------------

    def blank(self, height, width):
        self.grid = [[None] * width for _ in range(height)]
        self.blinks = []

    def mark_blink(self, y, x, width):
        """Cells of an alert (the bottom line's) to blink while it shows. A row
        marked again (every frame that draws the bottom line, Ask Kim's partial
        ones too) replaces what it had."""
        self.blinks = [cell for cell in self.blinks if cell[0] != y] + \
            [(y, x + i) for i in range(max(0, width))]

    def record(self, y, x, text, attr):
        grid = self.grid
        if y >= len(grid):
            return
        row = grid[y]
        width = len(row)
        joins = self.joins
        if joins.isdisjoint(text):
            # one character a cell (nearly always): the cells at once
            start, end = max(0, x), min(width, x + len(text))
            if start < end:
                row[start:end] = [(ch, attr) for ch in text[start - x:end - x]]
            return
        i = x - 1
        for ch in text:
            if ch in joins:
                if 0 <= i < width and row[i] is not None:
                    row[i] = (row[i][0] + ch, row[i][1])
                continue
            i += 1
            if i >= width:
                break
            if i >= 0:
                row[i] = (ch, attr)

    def look(self, attr):
        """(fg rgb, bg rgb, fg light, bg light) for an attribute: how bright
        its text and its background glow."""
        hit = self.looks.get(attr)
        if hit is not None:
            return hit
        palette = self.palette
        fg = bg = None
        try:
            pair = curses.pair_number(attr & curses.A_COLOR)
            if pair:
                f, b = curses.pair_content(pair)
                fg, bg = palette.rgb_of(f), palette.rgb_of(b)
        except (curses.error, ValueError, AttributeError):
            pass
        base = (palette.crt_bg or palette.bg_rgb if palette else None) or (0, 0, 0)
        fg = fg or (200, 200, 200)
        bg = bg or base
        if attr & curses.A_REVERSE:
            fg, bg = bg, fg

        def lum(rgb):
            return (0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]) / 255.0

        light = lum(fg) ** 1.5 * (1.2 if attr & curses.A_BOLD else 1.0) * \
            (0.55 if attr & curses.A_DIM else 1.0)
        glow = lum(bg) ** 1.5 * 0.7 if lum(bg) > lum(base) + 0.04 else 0.0
        hit = (fg, bg, light, glow)
        self.looks[attr] = hit
        return hit

    def lit(self, cell):
        """0 for a dark cell, 1 for one with a character, 2 for a lit background."""
        if cell is None:
            return 0
        text, attr = cell
        if text[:1] not in (" ", PLACEHOLDER, ""):
            return 1
        return 2 if self.look(attr)[3] else 0

    def dark(self, cell):
        return cell is None or (cell[0] == " " and not self.look(cell[1])[3])

    def paint(self, scr, y, x, cell):
        """A cell as it really is (a burnt-in ghost where it is dark)."""
        text, attr = cell if cell is not None else (" ", self.blank_attr)
        burnt = self.burnt.get(y)
        if burnt and x in burnt and self.dark(cell):
            text, attr = burnt[x], self.attrs["crtburn"]
        try:
            scr.addstr(y, x, text, attr)
        except curses.error:
            pass

    def paint_burnt(self, scr, y):
        row = self.grid[y] if y < len(self.grid) else []
        for x, ch in (self.burnt.get(y) or {}).items():
            if x < len(row) and self.dark(row[x]):
                try:
                    scr.addstr(y, x, ch, self.attrs["crtburn"])
                except curses.error:
                    pass

    def paint_row(self, scr, y):
        """A whole row as it really is, in runs of one attribute."""
        if y >= len(self.grid):
            return
        row = self.grid[y]
        x, width = 0, len(row)
        while x < width:
            cell = row[x]
            attr = cell[1] if cell is not None else self.blank_attr
            start, texts = x, []
            while x < width:
                cell = row[x]
                here = cell[1] if cell is not None else self.blank_attr
                if here != attr:
                    break
                texts.append(cell[0] if cell is not None else " ")
                x += 1
            try:
                scr.addstr(y, start, "".join(texts), attr)
            except curses.error:
                pass
        self.paint_burnt(scr, y)

    def fits(self, scr):
        height, width = scr.getmaxyx()
        return len(self.grid) == height and bool(self.grid) and len(self.grid[0]) == width

    # -- each frame ------------------------------------------------------------

    def decorate(self, app, full):
        """Before the frame goes out: the sweep while powering on, else the
        burn-in and the trails over it."""
        scr = app.term
        if not self.fits(scr):
            return
        now = time.monotonic()
        if self.boot is not None:
            self.sweep(scr, now)
            return
        self.slip = None                    # a fresh frame puts slipped rows back
        if full:
            self.burn(now)
            self.start_typing(scr, now)
            self.start_flash(scr, now, every=self.flash_all)
            self.flash_all = False
        else:
            # a pop-up's own frame (Ask Kim's): fresh data under it is no news
            # to flash when the whole screen comes back
            self.fresh = False
        for y in self.burnt:
            self.paint_burnt(scr, y)
        self.find_trails(now)
        self.draw_trails(scr, 0)
        if self.blinks and self.blink_phase:
            self.hide(scr, self.blinks)      # an alert in its dark half-beat
        self.prev = [row[:] for row in self.grid]

    def after(self, app, full):
        """After the frame has gone out: the glass over it."""
        if not self.glass:
            return
        scr = app.term
        height, width = scr.getmaxyx()
        cw, ch = cell_pixels()
        geometry = (width, height, max(1, round(cw)), max(1, round(ch)), self.phosphor)
        margin = app.stdscr.margin
        if self.glass.geometry != geometry or self.glass.margin != margin:
            self.glass.setup(*geometry, margin=margin)
            self.glow_grid = None
        self.glass.place_all()
        if full:
            self.glow_stale = True
        if self.boot is None and self.typing is None and self.fits(scr) and \
                self.grid != self.glow_grid and self.glowing():
            self.glow_due = True
            if time.monotonic() - self.glow_at >= CRT_GLOW_EVERY and \
                    (self.glow_stale or not self.hold_glow):
                self.send_glow(app)

    def tick(self, app):
        """Between frames: the sweep, the trails fading, a row slipping and
        coming back, the hum bar, a glow that was held back."""
        scr = app.term
        now = time.monotonic()
        wrote = False
        if self.boot is not None:
            if self.fits(scr):
                self.sweep(scr, now)
                wrote = True
            if self.boot is None:
                app.dirty = True
        elif self.fits(scr):
            if self.trails and now - self.trail_at >= \
                    CRT_TRAIL[self.trail_step] * crt_amount("trails"):
                if self.trail_step == 0:
                    self.trail_step = 1
                    self.draw_trails(scr, 1)
                else:
                    for y, x, _, _ in self.trails:
                        self.paint(scr, y, x, self.grid[y][x])
                    self.trails = []
                wrote = True
            if self.slip and now >= self.slip[1]:
                for y in self.slip[0]:
                    self.paint_row(scr, y)
                self.slip = None
                wrote = True
            elif not self.slip and now >= self.slip_at and self.typing is None:
                wrote = self.start_slip(scr, now) or wrote
            if self.typing:
                wrote = self.type_more(scr, now) or wrote
            if self.flashes:
                wrote = self.flash_more(scr, now) or wrote
            if self.blinks:
                wrote = self.blink(scr, now) or wrote
            elif self.blink_epoch is not None:
                self.blink_epoch, self.blink_phase = None, 0
        if wrote:
            scr.noutrefresh()
            curses.doupdate()
        if self.glass:
            self.glass.step(now)
            if self.glow_due and self.boot is None and \
                    (self.glow_stale or not self.hold_glow) and \
                    now - self.glow_at >= CRT_GLOW_EVERY \
                    and self.fits(scr):
                self.send_glow(app)

    def wait_ms(self):
        """How soon tick() has something to do, in milliseconds."""
        if not self.on:
            return None
        now = time.monotonic()
        waits = [60.0, self.slip[1] - now if self.slip else self.slip_at - now]
        if self.boot is not None:
            waits.append(0.03)
        if self.trails:
            waits.append(CRT_TRAIL[self.trail_step] * crt_amount("trails") -
                         (now - self.trail_at))
        if self.typing or self.flashes:
            waits.append(0.016)
        if self.blinks and crt_amount("blink"):
            half = CRT_BLINK / crt_amount("blink")
            since = now - (self.blink_epoch or now)
            waits.append(half - since % half)
        if self.glass:
            if self.glass.parts & self.glass.MOVING:
                waits.append(CRT_GLASS_STEP - (now - self.glass.step_at))
            if self.glow_due and (self.glow_stale or not self.hold_glow):
                waits.append(CRT_GLOW_EVERY - (now - self.glow_at))
        return max(15, int(min(waits) * 1000))

    def skip_boot(self):
        if self.boot is not None:
            self.boot = None
            return True
        return False

    def lost(self):
        """The screen was cleared, and the glass with it: send it again."""
        if self.glass:
            self.glass.geometry = None
            self.glass.glow = None

    # -- the effects -------------------------------------------------------------

    def sweep(self, scr, now):
        """Power-on: a dot, a line across the middle, then the picture opening
        out from it to the full screen."""
        height, width = len(self.grid), len(self.grid[0])
        t = now - self.boot
        dot, line, opened = (part * crt_amount("power") for part in CRT_BOOT)
        mid = height // 2
        blank = " " * width

        def dark(y):
            try:
                scr.addstr(y, 0, blank[: width - 1 if y == height - 1 else width],
                           self.blank_attr)
            except curses.error:
                pass

        if t >= opened:
            self.boot = None
            if crt_amount("type"):
                self.prev = None            # the typewriter brings the picture in
                return
            for y in range(height):
                self.paint_row(scr, y)
            return
        if t < line:
            for y in range(height):
                dark(y)
            if t < dot:
                text, x0 = "•", width // 2
            else:
                half = int((t - dot) / (line - dot) * width / 2) + 1
                x0 = max(0, width // 2 - half)
                text = "━" * (min(width - 1, width // 2 + half) - x0)
            try:
                scr.addstr(mid, x0, text, self.attrs["crtbeam"])
            except curses.error:
                pass
            return
        frac = (t - line) / (opened - line)
        reach = int((1 - (1 - frac) ** 2) * (height / 2 + 1))
        for y in range(height):
            if abs(y - mid) <= reach:
                self.paint_row(scr, y)
            else:
                dark(y)
        for y in (mid - reach - 1, mid + reach + 1):
            if 0 <= y < height:
                try:
                    scr.addstr(y, 0, "─" * (width - 1), self.attrs["crtbeam"])
                except curses.error:
                    pass

    def burn(self, now):
        """Wear: every second a border or the tab bar is on screen counts
        towards burning it in."""
        last = self.worn_at
        if last is not None and now - last < 1.0:
            return                          # counted once a second is plenty
        self.worn_at = now
        amount = crt_amount("burn")
        if last is None or not amount:
            return
        spent = min(2.0, now - last)
        needed = CRT_BURN / amount
        wear, burnt = self.wear, self.burnt
        for y, row in enumerate(self.grid):
            top = y < 3
            for x, cell in enumerate(row):
                if cell is None:
                    continue
                ch = cell[0][:1]
                if ch == " " or not (top or "─" <= ch <= "╿"):
                    continue
                seen = wear.get((y, x))
                if seen is None:
                    seen = wear[(y, x)] = {}
                seen[ch] = seen.get(ch, 0.0) + spent
                if seen[ch] >= needed:
                    burnt.setdefault(y, {})[x] = max(seen, key=seen.get)

    def paint_cells(self, scr, cells):
        """Cells (y, x) in reading order as they really are, in runs."""
        run, last = [], None
        for y, x in cells:
            if run and (y != last[0] or x != last[1] + 1):
                self.paint_run(scr, run)
                run = []
            run.append((y, x))
            last = (y, x)
        if run:
            self.paint_run(scr, run)

    def paint_run(self, scr, run):
        """A run of neighbouring cells in one row, in runs of one attribute."""
        y = run[0][0]
        row = self.grid[y] if y < len(self.grid) else []
        start = 0
        while start < len(run):
            x0 = run[start][1]
            cell = row[x0] if x0 < len(row) else None
            attr = cell[1] if cell is not None else self.blank_attr
            end, texts = start, []
            while end < len(run):
                x = run[end][1]
                here = row[x] if x < len(row) else None
                if (here[1] if here is not None else self.blank_attr) != attr:
                    break
                texts.append(here[0] if here is not None else " ")
                end += 1
            try:
                scr.addstr(y, x0, "".join(texts), attr)
            except curses.error:
                pass
            start = end

    def hide(self, scr, cells):
        """Cells' characters gone, their backgrounds kept."""
        grid = self.grid
        for y, x in cells:
            if y < len(grid) and x < len(grid[y]):
                cell = grid[y][x]
                try:
                    scr.addstr(y, x, " ", cell[1] if cell is not None else self.blank_attr)
                except curses.error:
                    pass

    def start_typing(self, scr, now):
        """Typewriter: what changed since the last frame (and what was still
        to come) blanked, to be typed in again in reading order."""
        amount = crt_amount("type")
        if not amount:
            self.typing = None
            return
        grid, prev = self.grid, self.prev
        if not grid:
            return
        same = prev is not None and len(prev) == len(grid) and len(prev[0]) == len(grid[0])
        waiting, clock = set(), None
        if self.typing:
            # still typing: what was to come waits on, and the line keeps its pace
            waiting = set(self.typing["cells"][self.typing["done"]:])
            clock = self.typing["clock"]
        cells = []
        waiting_rows = {y for y, _ in waiting}
        for y, row in enumerate(grid):
            old = prev[y] if same else None
            if old == row and y not in waiting_rows:
                continue                    # nothing new in this row
            for x, cell in enumerate(row):
                if cell is None or cell[0][:1] in (" ", ""):
                    continue
                if old is None or old[x] != cell or (y, x) in waiting:
                    cells.append((y, x))
        if not cells:
            self.typing = None
            return
        self.hide(scr, cells)
        rate = max(120.0, len(grid) * len(grid[0]) * 0.45 / (CRT_TYPE * amount))
        # "clock": when the next character is due, so frames drawn while it
        # types (a clock ticking, the POST screen) never hold it back
        self.typing = {"cells": cells, "done": 0, "rate": rate,
                       "clock": now - 1.0 / rate if clock is None else clock}

    def type_more(self, scr, now):
        typing = self.typing
        cells = typing["cells"]
        count = int((now - typing["clock"]) * typing["rate"])
        if count <= 0:
            return False
        target = min(len(cells), typing["done"] + count)
        self.paint_cells(scr, cells[typing["done"]:target])
        typing["clock"] += (target - typing["done"]) / typing["rate"]
        typing["done"] = target
        if target >= len(cells):
            self.typing = None
            self.glow_due = self.glowing()
        return True

    def type_again(self):
        """T on the card: the whole screen typed out again."""
        if not (self.on and crt_amount("type")):
            return False
        self.prev = None
        return True

    def start_flash(self, scr, now, every=False):
        """Update flash: the digits that changed with fresh data (or, `every`,
        all of them on the screen) lit bright for a moment."""
        fresh, self.fresh = self.fresh, False
        amount = crt_amount("flash")
        grid, prev = self.grid, self.prev
        if not amount or not grid or not (fresh or every):
            return False
        same = prev is not None and len(prev) == len(grid) and len(prev[0]) == len(grid[0])
        if not same and not every:
            return False
        limit = max(24, len(grid) * len(grid[0]) // 50)
        waiting = set(self.typing["cells"][self.typing["done"]:]) if self.typing else set()
        cells = []
        for y, row in enumerate(grid):
            old = prev[y] if same else None
            if not every and old == row:
                continue                    # no number changed in this row
            for x, cell in enumerate(row):
                if cell is None or not cell[0][:1].isdigit() or (y, x) in waiting:
                    continue
                if every or (old[x] is not None and old[x][0][:1] != cell[0][:1]):
                    cells.append((y, x))
            if len(cells) > limit and not every:
                return False                # a new layout, not a value changing
        if not cells:
            return False
        self.flashes = {"cells": cells, "at": now, "step": 0}
        self.paint_flash(scr, "crtflash")
        return True

    def paint_flash(self, scr, style):
        attr = self.attrs.get(style, self.blank_attr)
        grid = self.grid
        for y, x in self.flashes["cells"]:
            if y < len(grid) and x < len(grid[y]) and grid[y][x] is not None:
                try:
                    scr.addstr(y, x, grid[y][x][0], attr)
                except curses.error:
                    pass

    def flash_more(self, scr, now):
        flashes = self.flashes
        amount = crt_amount("flash") or 1.0
        if flashes["step"] == 0 and now - flashes["at"] >= CRT_FLASH[0] * amount:
            flashes["step"] = 1
            self.paint_flash(scr, "crtflash2")
            return True
        if flashes["step"] == 1 and now - flashes["at"] >= sum(CRT_FLASH) * amount:
            self.paint_cells(scr, sorted(flashes["cells"]))
            self.flashes = None
            return True
        return False

    def hand_over(self, scr):
        """A player is taking part of the screen and nothing more will be drawn
        until it is done: finish what is being typed, flashing, fading or
        slipping, put every cell as it really is, and take the glow away
        (it would lie over the video)."""
        if not self.on or not self.fits(scr):
            return
        if self.typing:
            self.paint_cells(scr, self.typing["cells"][self.typing["done"]:])
            self.typing = None
        if self.flashes:
            self.paint_cells(scr, sorted(self.flashes["cells"]))
            self.flashes = None
        for y, x, _, _ in self.trails:
            self.paint(scr, y, x, self.grid[y][x])
        self.trails = []
        if self.slip:
            for y in self.slip[0]:
                self.paint_row(scr, y)
            self.slip = None
        if self.blinks and self.blink_phase:
            self.paint_cells(scr, sorted(self.blinks))
            self.blink_phase = 0
        scr.noutrefresh()
        curses.doupdate()
        self.prev = [row[:] for row in self.grid]
        if self.glass:
            self.glass.show_glow({})
            self.glow_grid = self.grid and [row[:] for row in self.grid]
            self.glow_due = False

    def flash_now(self):
        """T on the card: every number on the screen flashes, from the next
        frame."""
        if not (self.on and crt_amount("flash")):
            return False
        self.flash_all = True
        return True

    def blink(self, scr, now):
        """An alert's cells off and on, CRT_BLINK each way at the standard."""
        amount = crt_amount("blink")
        if not amount:
            return False
        if self.blink_epoch is None:
            self.blink_epoch, self.blink_phase = now, 0
        phase = int((now - self.blink_epoch) / (CRT_BLINK / amount)) % 2
        if phase == self.blink_phase:
            return False
        self.blink_phase = phase
        if phase:
            self.hide(scr, self.blinks)
        else:
            self.paint_cells(scr, sorted(self.blinks))
        return True

    def find_trails(self, now):
        prev, grid = self.prev, self.grid
        if prev is None or len(prev) != len(grid) or (grid and len(prev[0]) != len(grid[0])) \
                or not crt_amount("trails"):
            return
        found = []
        for y, (old_row, new_row) in enumerate(zip(prev, grid)):
            if old_row == new_row:
                continue
            for x, (old, new) in enumerate(zip(old_row, new_row)):
                if old is None or old == new:
                    continue
                was = self.lit(old)
                if was and not self.lit(new):
                    found.append((y, x, old[0] if was == 1 else " ", was))
                    if len(found) >= CRT_TRAIL_MAX:
                        break
        if found:
            self.trails, self.trail_step, self.trail_at = found, 0, now

    def draw_trails(self, scr, step):
        if not self.trails:
            return
        glyph = self.attrs["crtghost" if step == 0 else "crtfaint"]
        lit_bg = self.attrs["crtghostbg"] if step == 0 else self.attrs["crtburn"]
        for y, x, text, kind in self.trails:
            try:
                if kind == 1:
                    scr.addstr(y, x, text, glyph)
                else:
                    scr.addstr(y, x, " ", lit_bg)
            except curses.error:
                pass

    def start_slip(self, scr, now):
        """A row or a few slipping a cell or two to the right, out of sync."""
        self.slip_at = now + self.slip_gap()
        height = len(self.grid)
        if height < 8:
            return False
        first = random.randint(3, height - 3)
        rows = list(range(first, min(height - 2, first + random.choice((1, 1, 1, 2, 2, 3)))))
        shift = " " * random.choice((1, 1, 2))
        for y in rows:
            try:
                scr.insstr(y, 0, shift, self.blank_attr)
            except curses.error:
                pass
        self.slip = (rows, now + random.uniform(0.05, 0.11))
        return True

    def send_glow(self, app):
        """Work out the glow from what is on the screen and send it: the
        bloom, the colour fringes and the soft focus, each at its level."""
        self.glow_due = self.glow_stale = False
        self.glow_at = time.monotonic()
        geometry = self.glass.geometry if self.glass else None
        if not geometry:
            return
        cols, rows, cw, ch, _ = geometry
        if len(self.grid) != rows or not self.grid or len(self.grid[0]) != cols:
            return
        bloom_on, fringe_on, focus_on = (crt_amount(key) for key in
                                         ("bloom", "fringes", "focus"))
        self.glow_grid = [row[:] for row in self.grid]
        if not (bloom_on or fringe_on or focus_on):
            self.glass.show_glow({})
            return
        width, height = cols * cw, rows * ch
        bloom_w = (cols + 1) // 2
        bloom_h = max(1, round(bloom_w * height / width))
        fringe_w = cols * 3
        fringe_h = max(1, round(fringe_w * height / width))
        focus_w = cols * 2
        focus_h = max(1, round(focus_w * height / width))
        spec = CRT_PHOSPHORS.get(self.phosphor) or CRT_PHOSPHORS["green"]
        tone = bytes(spec[2] or (180, 180, 180))
        clear = tone + b"\x00"
        bloom_top = min(255, round(24 * bloom_on))
        focus_top = min(255, round(12.8 * focus_on))
        sig = (bloom_on, fringe_on, focus_on, clear, bloom_w, fringe_w, bloom_top, focus_top)
        cache = self.glow_rows
        if self.glow_sig != sig or len(cache) > 8 * rows:
            cache.clear()
            self.glow_sig = sig
        bloom_rows, fringe_rows, focus_rows = [], [], []
        for row in self.glow_grid:
            key = tuple(row)
            done = cache.get(key)
            if done is None:
                done = cache[key] = self.glow_row(row, sig)
            bloom_rows.append(done[0])
            focus_rows.append(done[1])
            fringe_rows.append(done[2])
        layers = {}
        if bloom_on:
            layers[0] = (b"".join(bloom_rows[min(rows - 1, py * rows // bloom_h)]
                                  for py in range(bloom_h)), bloom_w, bloom_h)
        if fringe_on:
            blank = clear * fringe_w
            lines = []
            for py in range(fringe_h):
                place = (py + 0.5) * rows / fringe_h
                ty = min(rows - 1, int(place))
                # glyphs fill the middle of a row, so their fringes do
                lines.append(fringe_rows[ty] if 0.22 <= place - ty <= 0.82 else blank)
            layers[2] = (b"".join(lines), fringe_w, fringe_h)
        if focus_on:
            blank = clear * focus_w
            lines = []
            for py in range(focus_h):
                place = (py + 0.5) * rows / focus_h
                ty = min(rows - 1, int(place))
                # over the body of a row's letters, not the gap between rows
                lines.append(focus_rows[ty] if 0.18 <= place - ty <= 0.86 else blank)
            layers[4] = (b"".join(lines), focus_w, focus_h)
        self.glass.show_glow(layers)


    def glow_row(self, row, sig):
        """One row of cells' glow: (its bloom, its soft focus, its fringes),
        each a row of pixels, or None while that layer is off."""
        bloom_on, fringe_on, focus_on, clear, bloom_w, fringe_w, bloom_top, focus_top = sig
        bloom = focus = fringe = None
        light_row, bright = [], []
        for cell in row:
            if cell is None:
                light_row.append((0.0, 0.0, 0.0, 0.0))
                bright.append(0.0)
                continue
            text, attr = cell
            fg, bg, light, glow = self.look(attr)
            first = text[:1]
            lit = first not in (" ", PLACEHOLDER, "")
            strength = crt_glyph_weight(first) * light if lit else 0.0
            light_row.append((strength + glow,
                              *((c1 * strength + c2 * glow) for c1, c2 in zip(fg, bg))))
            bright.append(min(1.0, light) if lit else 0.0)
        if bloom_on:
            # two cells a pixel: the terminal's own smoothing spreads it wider
            pixels, last = [], clear
            for x in range(0, len(light_row), 2):
                pair = light_row[x:x + 2]
                total = sum(p[0] for p in pair)
                if total <= 0.03:
                    pixels.append(last[:3] + b"\x00")
                    continue
                rgb = bytes(min(255, round(sum(p[k] for p in pair) / total))
                            for k in (1, 2, 3))
                # the brightest things bloom; ordinary text only just
                last = rgb + bytes([min(bloom_top, round((total / len(pair)) ** 1.6 *
                                                         20 * bloom_on))])
                pixels.append(last)
            while len(pixels) < bloom_w:
                pixels.append(clear)
            bloom = b"".join(pixels)
        if focus_on:
            # two pixels a cell: a haze over the text itself, reaching
            # half a cell past it
            pixels, last = [], clear
            for total, red, green, blue in light_row:
                if total <= 0.03:
                    pixels.append((last[:3] + b"\x00") * 2)
                    continue
                last = bytes((min(255, round(red / total)), min(255, round(green / total)),
                              min(255, round(blue / total)),
                              min(focus_top, round(total ** 1.2 * 10.4 * focus_on))))
                pixels.append(last * 2)
            focus = b"".join(pixels)
        if fringe_on:
            # the colour beams a pixel out of line: red off the left edge
            # of each lit run, blue off its right
            edges = bytearray(clear * fringe_w)
            for x, light in enumerate(bright):
                if light < 0.2:
                    continue
                alpha = min(255, round(light * 20 * fringe_on))
                if x == 0 or bright[x - 1] < 0.2:
                    edges[12 * x:12 * x + 4] = bytes([255, 40, 40, alpha])
                if x == len(bright) - 1 or bright[x + 1] < 0.2:
                    edges[12 * x + 8:12 * x + 12] = bytes([50, 80, 255, alpha])
            fringe = bytes(edges)
        return bloom, focus, fringe


def _is_strong(line, league):
    side = favorite_side(line)
    if not side:
        return False
    ml = line.get(f"{side}_ml")
    if ml is not None and ml <= BETTING.min_moneyline:
        return True
    if league not in MONEYLINE_LEAGUES and line.get("spread") is not None:
        return abs(line["spread"]) >= BETTING.min_spread
    return False


def upset_state(event, league):
    """None, or a dict describing why this game deserves a look."""
    if not (BETTING.enabled and BETTING.alerts):
        return None
    line = event.get("line")
    if not line or event.get("state") not in ("in", "post"):
        return None
    side = favorite_side(line)
    if not side or not _is_strong(line, league):
        return None
    favorite = event[side]
    underdog = event["away" if side == "home" else "home"]
    if favorite.get("score") is None or underdog.get("score") is None:
        return None

    margin = favorite["score"] - underdog["score"]
    number = favorite_number(line, league) or 0
    if league in MONEYLINE_LEAGUES:
        size = money_text(number)
        dog_ml = line.get(("away" if side == "home" else "home") + "_ml")
        dog_size = money_text(dog_ml) if dog_ml is not None else "an"
    else:
        size = dog_size = f"{abs(number):g}-point"

    if event["state"] == "post":
        if margin < 0:
            return {"level": "final", "tag": "UPSET",
                    "note": f"{underdog['abbr']} won as a {dog_size} underdog",
                    "favorite": favorite, "underdog": underdog, "margin": margin}
        return None

    # a "late" period and a "safe" lead differ by sport
    low_scoring = league in MONEYLINE_LEAGUES
    period = event.get("period") or 0
    regulation = LEAGUES.get(league, {}).get("regulation", 4)
    late = period >= regulation
    big_lead = (3 if is_baseball(league) else 2) if low_scoring else (
        12 if sport_of(league) == "basketball" else 8)

    if margin < 0:
        lead = -margin
        if period >= 2 or lead >= big_lead:
            return {"level": "live", "tag": "UPSET",
                    "note": f"{underdog['abbr']} leads by {lead} as a {dog_size} underdog",
                    "favorite": favorite, "underdog": underdog, "margin": margin}
        return None
    if margin == 0 and late:
        return {"level": "live", "tag": "TIED",
                "note": f"tied late; {favorite['abbr']} was a {size} favorite",
                "favorite": favorite, "underdog": underdog, "margin": margin}
    if (not low_scoring and late and 0 < margin <= 3 and line.get("spread") is not None
            and abs(line["spread"]) >= BETTING.close_spread):
        return {"level": "live", "tag": "CLOSE",
                "note": f"{favorite['abbr']} up only {margin} as a {size} favorite",
                "favorite": favorite, "underdog": underdog, "margin": margin}
    return None


