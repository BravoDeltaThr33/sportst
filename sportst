    def handle_favorites_key(self, key):
        """Return True when the Favorites screen has taken the key for itself."""
        rows = self.fav_rows
        if key in (ord("j"), curses.KEY_DOWN):
            self.fav_cursor = clamp(self.fav_cursor + 1, 0, max(0, len(rows) - 1))
        elif key in (ord("k"), curses.KEY_UP):
            self.fav_cursor = clamp(self.fav_cursor - 1, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_NPAGE:
            self.fav_cursor = clamp(self.fav_cursor + 12, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_PPAGE:
            self.fav_cursor = clamp(self.fav_cursor - 12, 0, max(0, len(rows) - 1))
        elif key == curses.KEY_HOME:
            self.fav_cursor = 0
        elif key in (curses.KEY_END, ord("G")):
            self.fav_cursor = max(0, len(rows) - 1)
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            if rows:
                self.toggle_favorite(rows[clamp(self.fav_cursor, 0, len(rows) - 1)])
        elif key == ord("/"):
            text = self.prompt("search teams: ", self.fav_filter)
            if text is not None:
                self.fav_filter = text.strip()
                self.fav_cursor = 0
                self.scroll["Favorites"] = 0
        elif key == ord("x"):
            self.fav_filter = ""
            self.fav_cursor = 0
            self.scroll["Favorites"] = 0
        else:
            return False
        return True

    def handle_key(self, key):
        if key == -1:
            return True
        self.dirty = True
        self.status_message = ""

        if self.show_help:
            self.show_help = False
            return True
        if self.show_info:
            steps = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                     curses.KEY_NPAGE: 10, ord(" "): 10, curses.KEY_PPAGE: -10,
                     curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6,
                     ord("J"): 10, ord("K"): -10}
            if key in steps:
                self.info_scroll = max(0, self.info_scroll + steps[key])
            elif key == curses.KEY_RESIZE:
                self.apply_background()
            else:
                self.show_info = False
            return True
        if self.calendar:
            return self.handle_calendar_key(key)
        if self.popup:
            if key == curses.KEY_RESIZE:
                self.apply_background()
                return True
            return self.handle_popup_key(key)

        if key in (ord("q"), ord("Q")):
            return False
        if key == curses.KEY_RESIZE:
            self.apply_background()
            return True
        if key == 12:  # ctrl-l, repaint a garbled terminal
            self.stdscr.clearok(True)
            return True
        if self.tab_name == "Favorites" and self.handle_favorites_key(key):
            return True
        if self.tab_name == "Betting" and self.handle_betting_key(key):
            return True
        if self.tab_name == "Stats" and self.handle_stats_key(key):
            return True
        if self.tab_name == "Settings" and self.handle_settings_key(key):
            return True
        if self.tab_name == "Overview" and self.handle_overview_key(key):
            return True
        if self.tab_name == "Plays" and self.handle_plays_key(key):
            return True
        if key == ord("x") and self.player and self.tab_name != "Favorites":
            self.stop_clip()
            return True
        tabs = self.tabs
        olympic = is_olympic(self.league)
        if key == ord("?"):
            self.show_help = True
        elif key == ord("i"):
            self.show_info = True
            self.info_scroll = 0
        elif key == ord("p"):
            self.open_league_picker()
        elif key == ord("e"):
            self.open_event_picker()
        elif ord("0") <= key <= ord("9"):
            # 1 … 9, 0 are the tabs after Overview: Scoreboard … Favorites
            index = 10 if key == ord("0") else key - ord("0")
            if index < len(tabs) and tabs[index] != "Settings":
                self.tab = index
        elif key == ord("O"):
            self.tab = tabs.index("Settings")
        elif key == ord("C"):
            self.open_calendar()
        elif key == ord("H"):
            self.tab = tabs.index("Overview")
        elif key == 9:
            self.tab = (self.tab + 1) % len(tabs)
        elif key in (curses.KEY_BTAB, 353):
            self.tab = (self.tab - 1) % len(tabs)
        elif key in (10, 13, curses.KEY_ENTER):
            event = self.current_event()
            if event and self.on_board:
                target = tabs[self.tab + 1]
                if "Scouting" in tabs:
                    target = "Scouting" if event["state"] == "pre" else "Boxscore"
                self.tab = tabs.index(target)
                self.scroll[target] = 0
                self.detail_scroll = 0
        elif key == ord("J"):
            self.detail_scroll += 1 if self.on_board else 0
            if not self.on_board:
                self.scroll_active(1, page=True)
        elif key == ord("K"):
            if self.on_board:
                self.detail_scroll = max(0, self.detail_scroll - 1)
            else:
                self.scroll_active(-1, page=True)
        elif key in (ord("j"), curses.KEY_DOWN):
            if self.on_board:
                self.move_selection(1)
            else:
                self.scroll_active(1)
        elif key in (ord("k"), curses.KEY_UP):
            if self.on_board:
                self.move_selection(-1)
            else:
                self.scroll_active(-1)
        elif key == curses.KEY_NPAGE:
            if self.on_board:
                self.move_selection(10)
            else:
                self.scroll_active(1, page=True)
        elif key == curses.KEY_PPAGE:
            if self.on_board:
                self.move_selection(-10)
            else:
                self.scroll_active(-1, page=True)
        elif key == curses.KEY_HOME:
            if self.on_board:
                self.move_selection(-10**6)
            else:
                self.scroll[self.tab_name] = 0
        elif key in (curses.KEY_END, ord("G")):
            if self.on_board:
                self.move_selection(10**6)
            else:
                self.scroll[self.tab_name] = 10**6
        elif key in (ord("h"), curses.KEY_LEFT, ord("[")):
            if olympic:
                self.shift_games(-1)
            else:
                self.shift_period(-1)
        elif key in (ord("l"), curses.KEY_RIGHT, ord("]")):
            if olympic:
                self.shift_games(1)
            else:
                self.shift_period(1)
        elif key == ord("t"):
            if olympic:
                self.switch_league(olympic_default(family(self.league),
                                                   LEAGUES[self.league]["slug"]))
            else:
                self.goto_today()
        elif key == ord("d"):
            if olympic:
                self.status_message = "An Olympic sport shows its whole schedule at once."
            else:
                text = self.prompt("date: ")
                if text is not None:
                    parsed = self.parse_date_input(text)
                    if parsed:
                        self.day = parsed
                        self.week_mode = False
                        self.selected_id = None
                        self.selected_index = 0
                    else:
                        self.status_message = "Could not read that date."
        elif key == ord("w"):
            if LEAGUES[self.league]["week_based"]:
                self.week_mode = not self.week_mode
                self.week_pinned = False
                self.selected_id = None
                self.selected_index = 0
            else:
                self.status_message = f"The {LEAGUE_SHORT.get(family(self.league))} " \
                                      "scoreboard is day by day."
        elif key == ord("L"):
            self.cycle_league(1)
        elif key == ord("/"):
            text = self.prompt("find team (empty clears): ", self.filter_text)
            if text is not None:
                self.filter_text = text.strip()
                self.selected_id = None
                self.selected_index = 0
                self.stats_sel[self.league] = 0
                self.bet_index = 0
                for key_name in ("Scoreboard", "Stats", "Standings", "Betting", "BettingList"):
                    self.scroll[key_name] = 0
                self.status_message = (f"Showing teams matching '{self.filter_text}'."
                                       if self.filter_text else "Search cleared.")
        elif key == ord("f"):
            self.toggle_top25()
        elif key == ord("c"):
            self.open_group_picker()
        elif key == ord("g"):
            self.cycle_stats_view(1)
        elif key == ord("s"):
            self.open_sort_picker()
        elif key == ord("S"):
            self.step_sort(1)
        elif key in (ord(","), ord(".")) and is_baseball(self.league):
            at_bats = self.at_bat_count()
            if at_bats:
                current = self.at_bat if self.at_bat is not None else at_bats - 1
                step = -1 if key == ord(",") else 1
                self.at_bat = clamp(current + step, 0, at_bats - 1)
                if self.at_bat == at_bats - 1:
                    self.at_bat = None
        elif key == ord("v") and sport_of(self.league) == "basketball":
            order = ["both", "away", "home"]
            self.shot_view = order[(order.index(self.shot_view) + 1) % 3]
            event = self.current_event()
            if event:
                who = {"both": "both teams", "away": event["away"]["abbr"],
                       "home": event["home"]["abbr"]}[self.shot_view]
                self.status_message = f"Shot chart: {who}."
        elif key == ord("u"):
            self.jump_to_upset()
        elif key == ord("o"):
            BETTING.columns = not BETTING.columns
            self.status_message = ("Showing betting lines." if BETTING.columns
                                   else "Hiding betting-line columns.")
        elif key == ord("r"):
            self.fetcher.expire()
            self.status_message = "Refreshing."
        elif key == ord("a"):
            self.auto_refresh = not self.auto_refresh
        elif key in (ord("+"), ord("=")):
            self.interval = clamp(self.interval + 5, 5, 600)
        elif key == ord("-"):
            self.interval = clamp(self.interval - 5, 5, 600)
        return True

    def run(self):
        cursor(False)
        self.stdscr.timeout(200)
        self.palette = Palette(enabled=not self.args.no_color,
                               floor=float(self.config.get("color_floor", 0.62)),
                               true_color=not self.args.no_true_color,
                               background=self.config.get("background", APP_BG))
        self.apply_background()
        running = True
        while running:
            now = time.time()
            if self.auto_refresh and now - self.last_auto > self.interval:
                self.last_auto = now
                self.dirty = True
            generation = self.fetcher.generation
            if self.dirty or generation != self.last_generation or now - self.last_draw > 1.0:
                self.last_generation = generation
                self.last_draw = now
                self.dirty = False
                try:
                    self.draw()
                except curses.error:
                    pass
            running = self.handle_key(self.stdscr.getch())
            self.poll_player()
            self.save_book()
        self.stop_clip(quiet=True)
        self.save_book(force=True)


