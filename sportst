def card_label(label):
    text = clean(str(label or "")).upper()
    return CARD_LABELS.get(text, text)


def card_day(value):
    """'11/2' for a game's date: ESPN's start times are UTC, so the evening
    before here; a plain date stays as it is."""
    text = str(value or "")
    when = parse_iso(text) if "T" in text else None
    if when:
        local = when.astimezone()
        return f"{local.month}/{local.day}"
    try:
        day = Date.fromisoformat(text[:10])
    except ValueError:
        return ""
    return f"{day.month}/{day.day}"


def birth_day(text):
    """'Apr 6, 2001' from ESPN's day/month/year or an ISO date."""
    months = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov",
              "Dec")
    text = clean(text or "")
    found = re.fullmatch(r"(\d{4})-(\d{2})-(\d{2})", text[:10])
    if found:
        year, month, day = (int(x) for x in found.groups())
    else:
        found = re.fullmatch(r"(\d{1,2})/(\d{1,2})/(\d{4})", text)
        if not found:
            return text
        day, month, year = (int(x) for x in found.groups())
    if not 1 <= month <= 12:
        return text
    return f"{months[month - 1]} {day}, {year}"


def years_since(day_iso):
    try:
        born = Date.fromisoformat(str(day_iso)[:10])
    except ValueError:
        return None
    today = Date.today()
    return today.year - born.year - ((today.month, today.day) < (born.month, born.day))


def espn_hockey_profile(player_id, timeout=15):
    """An NHL player's card from ESPN: who he is, his season so far and his
    games this season, newest first."""
    base = ESPN_HOCKEY_ATHLETE.format(urllib.parse.quote(str(player_id)))
    athlete = http_json(base, timeout).get("athlete") or {}
    try:
        log = http_json(base + "/gamelog", timeout)
    except Exception:  # noqa: BLE001 - the card shows what it has
        log = {}
    position = athlete.get("position") or {}
    goalie = clean(position.get("abbreviation") or "") == "G"
    hand = clean(dig(athlete, "hand", "abbreviation", default="") or "")
    profile = {
        "id": str(player_id), "goalie": goalie,
        "name": clean(athlete.get("displayName") or ""),
        "jersey": clean(athlete.get("jersey") or ""),
        "position": clean(position.get("displayName") or ""),
        "age": athlete.get("age") if isinstance(athlete.get("age"), int) else None,
        "height": clean(athlete.get("displayHeight") or ""),
        "weight": clean(athlete.get("displayWeight") or ""),
        "hand": (("catches " if goalie else "shoots ") + hand) if hand else "",
        "born": birth_day(athlete.get("displayDOB")),
        "birthplace": clean(athlete.get("displayBirthPlace") or ""),
        "draft": clean(athlete.get("displayDraft") or ""),
        "experience": clean(athlete.get("displayExperience") or ""),
        "photo": clean(dig(athlete, "headshot", "href", default="") or ""),
        "url": next((clean(link.get("href") or "") for link in athlete.get("links") or []
                     if "playercard" in (link.get("rel") or [])), ""),
        "season_label": clean(dig(athlete, "statsSummary", "displayName", default="") or ""),
        "ranks": [], "totals": {}, "games": [],
    }
    for stat in dig(athlete, "statsSummary", "statistics", default=[]) or []:
        rank = stat.get("rank")
        if isinstance(rank, int) and 0 < rank <= 25:
            label = card_label(stat.get("abbreviation"))
            if label == "WINS-L-OTL":
                label = "W"
            text = clean(stat.get("rankDisplayValue") or "").replace("Tied-", "T-")
            profile["ranks"].append((label, text))
    labels = [card_label(label) for label in log.get("labels") or []]
    seasons = log.get("seasonTypes") or []
    if labels and seasons:
        current, events = seasons[0], log.get("events") or {}
        for month in current.get("categories") or []:
            for entry in month.get("events") or []:
                game = events.get(str(entry.get("eventId"))) or {}
                stats = dict(zip(labels, [clean(s) for s in entry.get("stats") or []]))
                where = clean(game.get("atVs") or "")
                opponent = clean(dig(game, "opponent", "abbreviation", default="") or "")
                result = " ".join(part for part in (clean(game.get("gameResult") or ""),
                                                    clean(game.get("score") or "")) if part)
                profile["games"].append({"date": card_day(game.get("gameDate")),
                                         "opp": f"{where} {opponent}".strip(),
                                         "result": result, "stats": stats})
        totals = dig(current, "summary", "stats", 0, "stats", default=[]) or []
        profile["totals"] = dict(zip(labels, [clean(t) for t in totals]))
        if profile["totals"]:
            profile["totals"]["GP"] = str(len(profile["games"]))
        if not profile["season_label"]:
            profile["season_label"] = clean(current.get("displayName") or "")
    if goalie and profile["totals"]:
        t = profile["totals"]
        t["W-L-OT"] = f"{t.get('W', '0')}-{t.get('L', '0')}-{t.get('OTL', '0')}"
    return profile


def _ht_rows(block):
    """(labels by key, rows) of one of HockeyTech's player tables."""
    section = dig(block, 0, "sections", 0, default={}) or {}
    labels = {key: card_label(dig(head, "properties", "label", default=key))
              for key, head in (section.get("headers") or {}).items()}
    rows = [entry.get("row") or {} for entry in section.get("data") or []
            if isinstance(entry, dict)]
    return labels, rows


def ahl_player_profile(player_id, team_code="", timeout=15):
    """An AHL player's card from HockeyTech: who he is, his season and his
    games this season, newest first."""
    data = ht_get({"feed": "statviewfeed", "view": "player", "player_id": player_id,
                   "season_id": (ht_season("regular", timeout) or {}).get("season_id", ""),
                   "site_id": 3,
                   "league_id": 4, "statsType": "standard"}, timeout)
    if isinstance(data, list):
        data = data[0] if data else {}
    info = data.get("info") or {}
    goalie = clean(info.get("position") or "") == "G" or \
        str(info.get("playerType") or "").lower() == "goalie"
    hand = clean((info.get("catches") if goalie else info.get("shoots")) or "")
    height = clean(info.get("height") or "")
    if re.fullmatch(r"\d-\d{1,2}", height):
        feet, inches = height.split("-")
        height = f"{feet}' {inches}\""
    weight = clean(info.get("weight") or "")
    born = clean(info.get("birthDate") or "")
    draft = ""
    for pick in info.get("drafts") or []:
        if isinstance(pick, dict) and pick.get("draft_year"):
            draft = f"{pick['draft_year']}: Rd {pick.get('draft_round') or '?'}, " \
                    f"Pk {pick.get('draft_rank') or '?'} ({clean(pick.get('draft_team') or '')})"
            break
    images = [image for image in dig(data, "media", "images", default=[]) or []
              if isinstance(image, dict) and str(image.get("url") or "").endswith(".png")]
    images.sort(key=lambda image: str(image.get("is_primary")) != "1")
    profile = {
        "id": str(player_id), "goalie": goalie,
        "name": _person({"first_name": info.get("firstName"), "last_name": info.get("lastName")}),
        "jersey": clean(info.get("jerseyNumber") or ""),
        "position": {"C": "Center", "LW": "Left Wing", "RW": "Right Wing", "D": "Defense",
                     "G": "Goalie", "F": "Forward"}.get(clean(info.get("position") or ""),
                                                       clean(info.get("position") or "")),
        "age": years_since(born),
        "height": height, "weight": f"{weight} lbs" if weight.isdigit() else weight,
        "hand": (("catches " if goalie else "shoots ") + hand) if hand else "",
        "born": birth_day(born),
        "birthplace": clean(info.get("birthPlace") or ""),
        "draft": draft, "experience": "",
        "photo": clean(images[0].get("url")) if images else "",
        "url": AHL_PLAYER_PAGE.format(player_id),
        "season_label": "", "ranks": [], "totals": {}, "games": [],
    }
    labels, rows = _ht_rows(data.get("currentSeasonStats"))
    if rows:
        row = rows[0]
        profile["season_label"] = clean(row.get("season_name") or "")
        profile["totals"] = {labels.get(key, card_label(key)): clean(str(value))
                             for key, value in row.items() if key != "season_name"}
        if re.fullmatch(r"0\.\d{3}", profile["totals"].get("SV%", "")):
            profile["totals"]["SV%"] = profile["totals"]["SV%"][1:]
    labels, rows = _ht_rows(data.get("gameByGame"))
    mine = clean(team_code).upper()
    for row in reversed(rows):
        game = clean(row.get("game") or "")
        away, _, home = game.partition(" @ ")
        opp = f"@ {home}" if away.upper() == mine else (f"vs {away}" if home.upper() == mine
                                                         else game)
        result = ""
        if goalie:
            result = "W" if str(row.get("win")) == "1" else \
                ("OTL" if str(row.get("ot_loss")) == "1" else
                 ("L" if str(row.get("loss")) == "1" else ""))
        stats = {labels.get(key, card_label(key)): clean(str(value))
                 for key, value in row.items() if key not in ("game", "date_played")}
        if re.fullmatch(r"0\.\d{3}", stats.get("SV%", "")):
            stats["SV%"] = stats["SV%"][1:]
        profile["games"].append({"date": card_day(row.get("date_played")), "opp": opp,
                                 "result": result, "stats": stats})
    if profile["games"] and "GP" not in profile["totals"]:
        profile["totals"]["GP"] = str(len(profile["games"]))
    t = profile["totals"]
    if goalie and t:
        t["W-L-OT"] = f"{t.get('W', '0')}-{t.get('L', '0')}-{t.get('OTL', '0')}"
    return profile


