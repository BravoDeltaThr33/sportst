def roster_card_layout(card, player, league, team, width, height, photo=None,
                       corners=None, note=""):
    """The roster card's right side as Lines `width` wide: who he is beside
    his photo, the latest note, his numbers a category at a time, his last
    games, his awards and his teams - each in a box of its own, packed side by
    side where they fit. It trims, a step at a time, until it fits `height`:
    a shorter story, the lists run together, the headline alone, fewer rows of
    numbers and games, the lists cut short; past that it runs long and J / K
    scroll it. (rows, fits)."""
    card = card or {}
    photo = photo or []
    photo_w = max((len(line.text) for line in photo), default=0)
    team_style = THEME.style(league, team, bold=True, fallback="accent")
    name = (card.get("name") or player.get("name") or "?").upper()
    jersey = card.get("jersey") or player.get("jersey") or ""
    title = ([(f"#{jersey} ", team_style)] if jersey else []) + [(name, team_style)]
    tags = " · ".join(part for part in (card.get("position") or player.get("position") or "",
                                        card.get("team") or team.get("name") or "") if part)
    pairs = roster_pairs(card, player, league)
    stats, games, seasons = card.get("stats"), card.get("games"), card.get("seasons")
    awards, teams = card.get("awards") or [], card.get("teams") or []
    W = max(20, width)

    def profile_lines(inner):
        text_w = max(10, inner - (photo_w + 2 if photo_w else 0))
        text = [Line().add(cut_text(tags, text_w), "dim")] if tags else []
        text += pair_grid(pairs, text_w)
        if note:
            text += wrap_spans(note, text_w, "dim")
        out = []
        for row in range(max(len(photo), len(text))):
            line = Line()
            if photo_w:
                if row < len(photo):
                    line.extend_spans(photo[row])
                line.pad(photo_w).add("  ", "normal")
            if row < len(text):
                line.extend_spans(text[row])
            out.append(line)
        return out

    profile_natural = (photo_w + 2 if photo_w else 0) + max(
        len(tags), pair_grid_width(pairs), 30) + 4

    def latest_lines(inner, cap):
        if not card.get("note"):
            return []
        lines = wrap_spans(card["note"], inner, "bold")
        if card.get("story"):
            lines += wrap_spans(card["story"], inner, "dim")
        if len(lines) > cap:
            lines = lines[:max(1, cap)]
            last = lines[-1]
            style = last[-1][1] if last else "dim"
            lines[-1] = Line().add(last.text[:max(0, inner - 1)].rstrip() + "…", style)
        return lines

    def stats_title():
        found = re.match(r"\d{4}(-\d{2})?", (stats or {}).get("title") or "")
        return [("STATS", "title")] + ([(f"  {found.group(0)}", "dim")] if found else [])

    def stats_lines(inner, level):
        rows = list(stats["rows"])
        if level["rows"]:
            rows = rows[:level["rows"]]
        label_w = max(len(name) for name, _ in rows) + 2
        return number_table(stats.get("groups"), stats["labels"],
                            [(Line().add(name, "muted"), values) for name, values in rows],
                            inner, label_w)

    def game_rows(level):
        out = []
        for game in games["rows"][:level["rows"] or 5]:
            label = Line().add(game.get("date") or "", "muted")
            if game.get("opp"):
                label.add(" " + game["opp"], "normal")
            result = game.get("result") or ""
            if result:
                label.add(" " + result, "good" if result.startswith("W") else
                          "bad" if result.startswith(("L", "OTL")) else "normal")
            out.append((label, game.get("stats") or []))
        return out

    def games_lines(inner, level):
        rows = game_rows(level)
        label_w = min(24, max(len(label.text) for label, _ in rows) + 2)
        return number_table(games.get("groups"), games["labels"], rows, inner, label_w,
                            cut=level["cut"], first_bold=False)

    def seasons_title():
        return [("BY SEASON", "title")] + ([(f"  {seasons['title']}", "dim")]
                                           if seasons.get("title") else [])

    def season_lines(inner, level):
        keep = level["seasons"]
        rows = [row for row in seasons["rows"] if row[0] != "Career"][:keep]
        rows += [row for row in seasons["rows"] if row[0] == "Career"]
        label_w = min(16, max(len(name) for name, _ in rows) + 2)
        return number_table(seasons.get("groups"), seasons["labels"],
                            [(Line().add(name, "muted"), values) for name, values in rows],
                            inner, label_w, first_bold=False)

    def award_box(inner, level):
        step = level
        return ([("AWARDS", "title")], award_lines(awards, inner, step["compact"], step["most"]))

    def team_box(inner, level):
        step = level
        return ([("TEAMS", "title")], team_lines(teams, inner, step["compact"], step["most"]))

    def side_column(inner, level):
        return ([award_box(inner, level)] if awards else []) +             ([team_box(inner, level)] if teams else [])

    def side_natural():
        widest = 0
        for name_, count, seasons in awards:
            widest = max(widest, len(name_) + len(count or "") + len(seasons or "") + 4)
        for name_, seasons in teams:
            widest = max(widest, len(name_) + len(seasons or "") + 2)
        return min(56, widest + 4)

    def height_of(rows):
        return sum(max(sum(len(lines) + 2 for _, lines in column) for _, column in row)
                   for row in rows)

    def compose(level):
        story_cap = level["story"]
        has_latest = bool(card.get("note"))
        top = []
        if has_latest and W >= 96:
            profile_w = min(max(profile_natural, 52), W - 41)
            latest_w = W - profile_w - 1
            prof = profile_lines(profile_w - 4)
            top.append([(profile_w, [(title, prof)]),
                        (latest_w, [([("LATEST", "title")],
                                     latest_lines(latest_w - 4, max(story_cap, len(prof))))])])
        else:
            top.append([(W, [(title, profile_lines(W - 4))])])
            if has_latest:
                top.append([(W, [([("LATEST", "title")], latest_lines(W - 4, story_cap))])])
        tables = []
        if stats:
            tables.append((stats_title(), lambda inner: stats_lines(inner, level)))
        if games:
            tables.append(([("LAST GAMES", "title")], lambda inner: games_lines(inner, level)))
        if seasons and seasons.get("rows") and level["seasons"]:
            tables.append((seasons_title(), lambda inner: season_lines(inner, level)))
        full = [[(W, [(head, make(W - 4)[0])])] for head, make in tables]
        options = []
        if awards or teams:
            if W >= 96:
                # the awards and teams beside one of the tables
                for at, (head, make) in enumerate(tables):
                    want = make(10 ** 4)[1] + 4
                    beside = max(ROSTER_SIDE, min(side_natural(), W - want - 1))
                    if W - beside - 1 < 40:
                        continue
                    body = list(full)
                    body[at] = [(W - beside - 1, [(head, make(W - beside - 5)[0])]),
                                (beside, side_column(beside - 4, level))]
                    options.append(top + body)
                # or beside him, when there is no note to go there
                if not has_latest and W - max(profile_natural, 52) - 1 >= ROSTER_SIDE:
                    beside = W - max(profile_natural, 52) - 1
                    options.append([[(W - beside - 1, [(title, profile_lines(W - beside - 5))]),
                                     (beside, side_column(beside - 4, level))]] + full)
            # or under everything: side by side, or one over the other
            if awards and teams and W >= 64:
                half = (W - 1) // 2
                options.append(top + full + [[(half, [award_box(half - 4, level)]),
                                              (W - half - 1,
                                               [team_box(W - half - 5, level)])]])
            else:
                options.append(top + full + [[(W, [box])] for box in side_column(W - 4, level)])
        else:
            options.append(top + full)
        return min(options, key=height_of)

    chosen, fits, step = None, False, None
    for number, step in enumerate(ROSTER_STEPS):
        chosen = compose(step)
        if height_of(chosen) <= height:
            fits = True
            break
    if fits and number:
        # give back what the last step took - seasons, then the story's
        # lines - one at a time, while it still fits
        before = ROSTER_STEPS[number - 1]
        for knob in ("seasons", "story"):
            for _ in range(24):
                if step[knob] >= before[knob]:
                    break
                trial = dict(step, **{knob: step[knob] + 1})
                layout = compose(trial)
                if height_of(layout) > height:
                    break
                grown = height_of(layout) > height_of(chosen)
                step, chosen = trial, layout
                if not grown and knob == "story":
                    break                  # the whole story is in already
    total = height_of(chosen)
    canvas = Canvas(W, max(height, total))
    y = 0
    for number, row in enumerate(chosen):
        row_h = max(sum(len(lines) + 2 for _, lines in column) for _, column in row)
        if fits and number == len(chosen) - 1:
            row_h += height - total            # the last row takes what is left
        x = 0
        for col_w, column in row:
            yy = y
            for index, (head, lines) in enumerate(column):
                box_h = len(lines) + 2 if index < len(column) - 1 else y + row_h - yy
                canvas.card(yy, x, box_h, col_w, head, lines, corners, border="subborder")
                yy += box_h
            x += col_w + 1
        y += row_h
    return canvas.rows(), fits


def player_profile_source(league, ref):
    """(cache key, Loader) for a Boxscore player's card."""
    if league == "ahl":
        return (("player", league, ref["id"]),
                Loader("lscluster.hockeytech.com", ahl_player_profile, ref["id"],
                       (ref.get("team") or {}).get("abbr") or ""))
    if sport_of(league) == "basketball":
        return (("player", league, ref["id"]),
                Loader("site.web.api.espn.com", espn_basketball_profile, ref["id"], league))
    if sport_of(league) == "football":
        return (("player", league, ref["id"]),
                Loader("site.web.api.espn.com", espn_football_profile, ref["id"], league))
    if sport_of(league) == "baseball":
        return (("player", league, ref["id"]),
                Loader("site.web.api.espn.com", espn_baseball_profile, ref["id"], league))
    return (("player", league, ref["id"]),
            Loader("site.web.api.espn.com", espn_hockey_profile, ref["id"]))


def spark(values, width=None):
    """▁▃▅█ bars for a run of numbers, lowest to highest."""
    numbers = [v for v in values if isinstance(v, (int, float))]
    if not numbers:
        return ""
    low, high = min(numbers + [0]), max(numbers)
    out = []
    for value in values:
        if not isinstance(value, (int, float)):
            out.append(" ")
            continue
        level = 0 if high == low else int(round((value - low) / (high - low) * 7))
        out.append(SPARK_BARS[clamp(level, 0, 7)])
    return "".join(out[-width:] if width else out)


def _number(text):
    try:
        return float(str(text).replace("+", ""))
    except (TypeError, ValueError):
        return None


def stat_items(pairs, width, label_style="dim", value_style="bold"):
    """'G 0  A 2  +/- +1 …' cut at the last pair that fits."""
    line = Line()
    used = 0
    for label, value in pairs:
        if value in (None, ""):
            continue
        piece = len(label) + 1 + len(str(value)) + 2
        if used + piece - 2 > width:
            break
        line.add(f"{label} ", label_style).add(str(value), value_style).add("  ", "normal")
        used += piece
    while line and line[-1][0] == "  ":
        line.pop()
    return line


def stat_rows(label, pairs, width, label_w=9):
    """Stat pairs under a label, wrapped onto as many lines as they need."""
    lines, current, used = [], Line().add(f"{label:<{label_w}}", "accent"), label_w
    for name, value in pairs:
        if value in (None, ""):
            continue
        piece = len(name) + 1 + len(str(value))
        if used > label_w and used + 2 + piece > width:
            lines.append(current)
            current, used = Line().add(" " * label_w, "normal"), label_w
        if used > label_w:
            current.add("  ", "normal")
            used += 2
        current.add(f"{name} ", "dim").add(str(value), "bold")
        used += piece
    lines.append(current)
    return lines


def tonight_pairs(ref):
    """What a player did in this game, from his box score row."""
    stats = ref.get("stats") or {}
    if ref.get("sport") == "football":
        return football_tonight_pairs(ref)
    if ref.get("sport") == "baseball":
        return baseball_tonight_pairs(ref)
    if ref.get("sport") == "basketball":
        plus = stats.get("+/-")
        if plus not in (None, "") and _int(plus) > 0 and not str(plus).startswith("+"):
            plus = f"+{plus}"
        pairs = [(label, stats.get(label)) for label in ("PTS", "REB", "AST", "FG", "3PT",
                                                          "FT", "STL", "BLK", "TO")]
        pairs += [("+/-", plus), ("MIN", stats.get("MIN")), ("PF", stats.get("PF"))]
        if stats.get("OREB") not in (None, "") and stats.get("DREB") not in (None, ""):
            pairs.append(("O/D reb", f"{stats['OREB']}/{stats['DREB']}"))
        return pairs
    if ref.get("pos") == "G" or ref.get("group") == "goalies":
        pairs = [(label, stats.get(label)) for label in ("SA", "GA", "SV", "SV%", "TOI")]
        strengths = [stats.get(k) for k in ("ESSV", "PPSV", "SHSV")]
        if all(s not in (None, "") for s in strengths):
            pairs.append(("saves ES/PK/PP", "/".join(strengths)))
        return pairs
    points = stats.get("PTS")
    if points in (None, "") and stats.get("G", "") != "" and stats.get("A", "") != "":
        points = str(_int(stats.get("G")) + _int(stats.get("A")))
    # ESPN's S is shots on goal (its SOG column reads 0); the AHL's is SOG
    shots = stats.get("S") if stats.get("S") not in (None, "") else stats.get("SOG")
    plus = stats.get("+/-")
    if plus not in (None, "") and _int(plus) > 0 and not str(plus).startswith("+"):
        plus = f"+{plus}"
    pairs = [("G", stats.get("G")), ("A", stats.get("A")), ("PTS", points),
             ("+/-", plus), ("S", shots)]
    won, lost = stats.get("FW"), stats.get("FL")
    if won not in (None, "") and lost not in (None, "") and _int(won) + _int(lost):
        pairs.append(("FO", f"{won}-{lost}"))
    pairs += [("HT", stats.get("HT")), ("BS", stats.get("BS")), ("TK", stats.get("TK")),
              ("GV", stats.get("GV")), ("PIM", stats.get("PIM")), ("TOI", stats.get("TOI"))]
    if stats.get("PPTOI") not in (None, "", "0:00"):
        pairs.append(("PP TOI", stats.get("PPTOI")))
    if stats.get("SHFT") not in (None, ""):
        pairs.append(("shifts", stats.get("SHFT")))
    return pairs


def season_pairs(profile):
    if (profile or {}).get("sport") == "football":
        return football_season_pairs(profile)
    if (profile or {}).get("sport") == "baseball":
        return baseball_season_pairs(profile)
    t = (profile or {}).get("totals") or {}
    if (profile or {}).get("sport") == "basketball":
        return [(name, t.get(name)) for name in ("GP", "PPG", "RPG", "APG", "FG%", "3P%",
                                                  "FT%", "SPG", "BPG", "MPG")]
    if (profile or {}).get("goalie"):
        names = ["GP", "W-L-OT", "GAA", "SV%", "SO", "SA", "TOI"]
    else:
        names = ["GP", "G", "A", "PTS", "+/-", "S", "PPG", "GWG", "PIM", "TOI"]
    pairs = []
    for name in names:
        value = t.get(name)
        if name == "+/-" and value not in (None, "") and _int(value) > 0 \
                and not str(value).startswith("+"):
            value = f"+{value}"
        pairs.append(("TOI/G" if name == "TOI" else name, value))
    return pairs


def card_games_table(profile, width, rows):
    """His last games as a small table, newest first."""
    if (profile or {}).get("sport") == "football":
        return football_games_table(profile, width, rows)
    games = (profile or {}).get("games") or []
    if not games or rows < 2:
        return []
    if profile.get("sport") == "baseball":
        wanted = BASEBALL_PITCH_GAME if profile.get("pitcher") else BASEBALL_HIT_GAME
    else:
        wanted = CARD_GOALIE_GAME if profile.get("goalie") else (
            CARD_HOOPS_GAME if profile.get("sport") == "basketball" else CARD_SKATER_GAME)
    have = [label for label in wanted if any(g["stats"].get(label) not in (None, "")
                                             for g in games)]
    show_result = any(g.get("result") for g in games)
    headers = ["", ""] + (["result"] if show_result else []) + have
    table_rows = []
    for game in games[: rows - 1]:
        cells = [game["date"], game["opp"]] + ([game["result"]] if show_result else [])
        for label in have:
            value = game["stats"].get(label, "")
            if label == "+/-" and _int(value) > 0 and not str(value).startswith("+"):
                value = f"+{value}"
            cells.append(value)
        table_rows.append(cells)
    aligns = ["<", "<"] + (["<"] if show_result else []) + [">"] * len(have)
    lines = build_table(headers, table_rows, aligns=aligns, header_style="muted", sep="  ")
    while lines and max(len(line.text) for line in lines) > width and len(headers) > 3:
        headers, aligns = headers[:-1], aligns[:-1]
        table_rows = [row[:-1] for row in table_rows]
        lines = build_table(headers, table_rows, aligns=aligns, header_style="muted",
                            sep="  ")
    return [fit_line(line, width) for line in lines]


def season_caption(profile):
    """'Season', or the season's own years ('2025-26') when the numbers are
    from one already over - a college player's card before his first game."""
    found = re.search(r"(20\d\d)-(\d\d)", (profile or {}).get("season_label") or "")
    if found:
        now = datetime.now()
        if int(found.group(1)) < (now.year if now.month >= 9 else now.year - 1):
            return f"{found.group(1)}-{found.group(2)}"
    return "Season"


def player_card_text(ref, profile, league, width, rows, loading=False, error=None):
    """The words beside a Boxscore player's photo: who he is, his line in this
    game, his season, his last ten games and, with room, the games
    themselves - in two columns when the card is wide."""
    profile = profile or {}
    team = ref.get("team") or {}
    team_style = THEME.style(league, team, bold=True, fallback="accent")
    two = width >= 96
    bio_width = min(44, width // 3) if two else width
    stat_width = width - bio_width - 3 if two else width

    bio = [Line().add(profile.get("name") or ref.get("name") or "?", team_style)]
    jersey = profile.get("jersey") or ref.get("jersey")
    who = [f"#{jersey}" if jersey else "", profile.get("position") or ref.get("pos") or "",
           team.get("name") or team.get("abbr") or ""]
    bio.append(Line().add(" · ".join(part for part in who if part)[:bio_width], "muted"))
    body = [profile.get("height"), profile.get("weight"),
            f"age {profile['age']}" if profile.get("age") else "", profile.get("hand")]
    body = " · ".join(part for part in body if part)
    if body:
        bio.extend(wrap_spans(body, bio_width, "normal"))
    if profile.get("born") or profile.get("birthplace"):
        place = profile.get("birthplace") or ""
        text = f"born {profile.get('born') or ''}{' in ' + place if place and profile.get('born') else place}"
        bio.extend(wrap_spans(text.strip(), bio_width, "dim"))
    if profile.get("draft"):
        bio.extend(wrap_spans(f"draft {profile['draft']}", bio_width, "dim"))
    if profile.get("experience"):
        bio.append(Line().add(profile["experience"].lower(), "dim"))
    if loading and not profile.get("name"):
        bio.append(Line().add(f"Loading {their(league)} profile…", "dim"))
    elif error and not profile.get("name"):
        bio.extend(wrap_spans(f"No profile: {error}", bio_width, "dim"))

    label_w = 9
    stats = []
    line = Line().add(f"{'Tonight':<{label_w}}", "accent")
    line.extend_spans(stat_items(tonight_pairs(ref), stat_width - label_w))
    stats.append(line)
    season = season_pairs(profile)
    if any(value not in (None, "") for _, value in season):
        line = Line().add(f"{season_caption(profile):<{label_w}}", "accent")
        line.extend_spans(stat_items(season, stat_width - label_w))
        stats.append(line)
    post = baseball_post_pairs(profile) if profile.get("sport") == "baseball" else []
    if post:
        line = Line().add(f"{'Playoffs':<{label_w}}", "accent")
        line.extend_spans(stat_items(post, stat_width - label_w))
        stats.append(line)
    if profile.get("ranks"):
        text = " · ".join(f"{label} {rank}" for label, rank in profile["ranks"][:4])
        stats.append(Line().add(" " * label_w, "normal").add(
            f"league rank: {text}"[: stat_width - label_w], "muted"))
    games = profile.get("games") or []
    if games:
        last = list(reversed(games[:10]))
        spark_key = (profile.get("spark") or ("", "", ""))
        if profile.get("sport") == "football":
            values = [_number(str(g["stats"].get(spark_key[0]) or "").replace(",", ""))
                      for g in last]
            what = f"{spark_key[1]} a game"
        elif profile.get("sport") == "baseball":
            key = "K" if profile.get("pitcher") else "H"
            values = [_number(g["stats"].get(key)) for g in last]
            what = "strikeouts a game" if profile.get("pitcher") else "hits a game"
        elif profile.get("goalie"):
            values = [_number(g["stats"].get("SV%")) for g in last]
            what = "save % a game"
        else:
            values = [_number(g["stats"].get("PTS")) for g in last]
            what = "points a game"
        bars = spark(values)
        if bars.strip():
            line = Line().add(f"{'Last ' + str(len(last)):<{label_w}}", "accent")
            line.add(bars, THEME.style(league, team, bold=True, fallback="accent"))
            if profile.get("sport") == "basketball" or (
                    profile.get("sport") == "football" and spark_key[2] == "avg"):
                have = [v for v in values if v is not None]
                line.add(f"  {sum(have) / len(have):.1f} a game" if have else "", "bold")
            elif profile.get("sport") in ("football", "baseball"):
                total = sum(v for v in values if v is not None)
                line.add(f"  {total:,g} in all", "bold")
            elif not profile.get("goalie"):
                total = sum(v for v in values if v is not None)
                line.add(f"  {total:g} pts", "bold")
            note = f"  {what}, oldest to newest"
            if len(line.text) + len(note) <= stat_width:
                line.add(note, "muted")
            stats.append(line)
    elif loading:
        stats.append(Line().add(" " * label_w, "normal").add(
            f"Loading {their(league)} season…", "dim"))
    room = rows - len(stats) - 1
    table = card_games_table(profile, stat_width, room) if room >= 3 else []
    if table:
        stats.append(blank())
        stats.extend(table)

    if not two:
        out = bio + [blank()] + stats
        return [fit_line(line, width) for line in out[:rows]]
    out = []
    for index in range(min(rows, max(len(bio), len(stats)))):
        left = bio[index] if index < len(bio) else Line()
        right = stats[index] if index < len(stats) else Line()
        out.append(Line(list(fit_line(left, bio_width)) + [("   ", "normal")] +
                        list(fit_line(right, stat_width))))
    return out


def star_lines(stars, league, width, event=None):
    """The three stars, a line each: ★★★ J. Faulk D · DET  1 G 1 A."""
    lines = []
    for star in stars:
        team = star.get("team") or {}
        rank = star.get("star") or (len(lines) + 1)
        line = Line().add(f"{STAR * rank:<4}", "star")
        line.add(f"{star.get('name') or '?'}", THEME.style(league, team, bold=True,
                                                         fallback="accent"))
        tags = [f"#{star['jersey']}" if star.get("jersey") else "", star.get("pos") or "",
                team.get("abbr") or ""]
        line.add("  " + " · ".join(tag for tag in tags if tag), "muted")
        if star.get("line"):
            line.add(f"  {star['line']}", "normal")
        lines.append(fit_line(line, width))
    return lines


def star_line_text(star):
    """'1 G, 1 A' or '.950 save %' for a star."""
    if star.get("pos") == "G":
        if star.get("save_pct"):
            return f"{star['save_pct']} save %"
        return ""
    goals, assists = star.get("goals"), star.get("assists")
    parts = []
    if goals:
        parts.append(f"{goals} G")
    if assists:
        parts.append(f"{assists} A")
    return ", ".join(parts)


def nhl_match_game(data, event):
    """The NHL's own game for an ESPN event, from its /score day: by the home
    and away teams, or the start time and the home team."""
    start = str(event.get("date") or "")[:16]
    home = NHL_ABBR.get(event["home"]["abbr"], event["home"]["abbr"])
    away = NHL_ABBR.get(event["away"]["abbr"], event["away"]["abbr"])
    for game in data.get("games") or []:
        same_time = str(game.get("startTimeUTC") or "")[:16] == start
        teams = (dig(game, "homeTeam", "abbrev", default=""),
                 dig(game, "awayTeam", "abbrev", default=""))
        if teams == (home, away) or (same_time and home in teams):
            return game
    return None


def nhl_game_extras(day_iso, event, timeout=15):
    """What the NHL publishes for a game beyond ESPN's: the three stars, the
    head coaches, the scratches and the officials (api-web.nhle.com)."""
    game = nhl_match_game(http_json(f"{NHL_API}/score/{day_iso}", timeout), event)
    if not game or not game.get("id"):
        return {}
    ident = game["id"]
    landing = http_json(f"{NHL_API}/gamecenter/{ident}/landing", timeout)
    try:
        rail = http_json(f"{NHL_API}/gamecenter/{ident}/right-rail", timeout)
    except Exception:  # noqa: BLE001 - the stars are worth having alone
        rail = {}
    by_abbr = {}
    for side in ("away", "home"):
        team = event[side]
        by_abbr[NHL_ABBR.get(team["abbr"], team["abbr"])] = team
    stars = []
    for star in dig(landing, "summary", "threeStars", default=[]) or []:
        if not isinstance(star, dict):
            continue
        pos = clean(star.get("position") or "")
        entry = {"star": _int(star.get("star")) or len(stars) + 1,
                 "name": clean(dig(star, "name", "default", default="") or ""),
                 "jersey": clean(str(star.get("sweaterNo") or "")),
                 "pos": {"R": "RW", "L": "LW"}.get(pos, pos),
                 "team": by_abbr.get(clean(star.get("teamAbbrev") or "")) or
                 {"abbr": clean(star.get("teamAbbrev") or "")},
                 "photo": clean(star.get("headshot") or ""),
                 "player_id": str(star.get("playerId") or ""),
                 "goals": _int(star.get("goals")), "assists": _int(star.get("assists"))}
        pct = star.get("savePctg")
        if isinstance(pct, (int, float)):
            entry["save_pct"] = f"{pct:.3f}".lstrip("0")
        entry["line"] = star_line_text(entry)
        stars.append(entry)
    stars.sort(key=lambda s: s["star"])
    info = rail.get("gameInfo") or {}
    out = {"id": ident, "stars": stars, "coaches": {}, "scratches": {}}
    for side, key in (("away", "awayTeam"), ("home", "homeTeam")):
        coach = clean(dig(info, key, "headCoach", "default", default="") or "")
        if coach:
            out["coaches"][side] = coach
        out["scratches"][side] = [
            clean(f"{dig(p, 'firstName', 'default', default='')} "
                  f"{dig(p, 'lastName', 'default', default='')}")
            for p in dig(info, key, "scratches", default=[]) or [] if isinstance(p, dict)]
    out["referees"] = [clean(dig(o, "fullName", "default", default="") or "")
                       for o in info.get("referees") or [] if isinstance(o, dict)]
    out["linesmen"] = [clean(dig(o, "fullName", "default", default="") or "")
                       for o in info.get("linesmen") or [] if isinstance(o, dict)]
    return out


def teams_clash(league, away, home):
    """True when two teams' colours are too close to tell apart (two red
    teams, say): then the away team is drawn hatched or dashed."""
    away_rgb = hex_to_rgb(THEME.color(league, away) or "") or (0, 0, 0)
    home_rgb = hex_to_rgb(THEME.color(league, home) or "") or (255, 255, 255)
    return color_distance(away_rgb, home_rgb) < 9000


def hockey_clock_seconds(play, league="nhl"):
    """Seconds into the game when a play happened: the period's start plus
    its clock, which counts up in hockey."""
    number = _int(dig(play, "period", "number", default=0))
    clock = clean(dig(play, "clock", "displayValue", default="") or "")
    found = re.fullmatch(r"(\d+):(\d{2})", clock)
    if not number or not found:
        return None
    return (number - 1) * 1200 + int(found.group(1)) * 60 + int(found.group(2))


def hockey_shot_plays(summary):
    """ESPN's plays, or for the AHL the shots and goals HockeyTech's play by
    play has (in the summary's extras), each with a type, team and time."""
    extra = summary.get("sportst") or {}
    return (dig(summary, "plays", default=[]) or []) + (extra.get("shot_plays") or [])


def hockey_attempts(summary, event):
    """Shot attempts for each side from the plays: on goal, missed and
    blocked (a blocked shot names the team that blocked it). None when the
    plays have no shots in them."""
    counts = {side: {"goals": 0, "sog": 0, "missed": 0, "blocked": 0}
              for side in ("away", "home")}
    found = False
    for play in hockey_shot_plays(summary):
        kind = clean(dig(play, "type", "text", default="")).lower()
        side = side_of(event, dig(play, "team", "id"))
        if not side or kind not in ("goal", "shot", "missed", "blocked"):
            continue
        if _int(dig(play, "period", "number", default=0)) >= 5 and \
                "shootout" in clean(dig(play, "period", "displayValue", default="")).lower():
            continue
        found = found or kind != "goal"
        if kind == "goal":
            counts[side]["goals"] += 1
            counts[side]["sog"] += 1
        elif kind == "shot":
            counts[side]["sog"] += 1
        elif kind == "missed":
            counts[side]["missed"] += 1
        else:
            counts["home" if side == "away" else "away"]["blocked"] += 1
    return counts if found else None


def hockey_period_table(summary, event, league, width):
    """Goals and shots on goal in each period for both teams."""
    away, home = summary_teams(summary)
    if not away or not home:
        return []
    extra = summary.get("sportst") or {}
    shots = {"away": {}, "home": {}}
    if extra.get("shots"):
        for side in ("away", "home"):
            shots[side] = {_int(k): _int(v) for k, v in (extra["shots"].get(side) or {}).items()}
    else:
        for play in hockey_shot_plays(summary):
            kind = clean(dig(play, "type", "text", default="")).lower()
            side = side_of(event, dig(play, "team", "id"))
            if side and kind in ("shot", "goal"):
                number = _int(dig(play, "period", "number", default=0))
                shots[side][number] = shots[side].get(number, 0) + 1
    goals = {"away": [_int(v) for v in away.get("linescores") or []],
             "home": [_int(v) for v in home.get("linescores") or []]}
    periods = max(len(goals["away"]), len(goals["home"]),
                  max([p for side in shots.values() for p in side] + [0]))
    if not periods:
        return []
    periods = min(periods, 8)
    headers = ["", ""] + [period_tag(league, n) for n in range(1, periods + 1)] + ["T"]
    rows, styles = [], []
    for what, table in (("Goals", goals), ("Shots", shots)):
        have = any(table[side] for side in ("away", "home"))
        if not have:
            continue
        for index, side in enumerate(("away", "home")):
            values = table[side]
            if isinstance(values, list):
                cells = [str(values[n]) if n < len(values) else "" for n in range(periods)]
                total = sum(values)
            else:
                cells = [str(values.get(n, 0)) if n <= max(values or {0: 0}) else ""
                         for n in range(1, periods + 1)]
                total = sum(values.values())
            rows.append([what if not index else "", event[side]["abbr"]] + cells + [str(total)])
            styles.append("normal")
    if not rows:
        return []
    lines = [heading("By period")]
    table = build_table(headers, rows, aligns=["<", "<"] + [">"] * (periods + 1),
                        header_style="muted", sep="  ")
    for line in table[1:]:
        # the team's abbreviation in its colour
        abbr = line[2][0].strip() if len(line) > 2 else ""
        for side in ("away", "home"):
            if abbr == event[side]["abbr"]:
                line[2] = (line[2][0], THEME.style(league, event[side], bold=True,
                                                   fallback="accent"))
    lines.extend(fit_line(line, width) for line in table)
    return lines


def hockey_attempt_lines(summary, event, league, width):
    """Shot attempts both ways, and what came of them: on goal, missed,
    blocked, the share of all attempts, shooting and save percentages."""
    counts = hockey_attempts(summary, event)
    if not counts:
        return []
    a, h = counts["away"], counts["home"]
    for side in (a, h):
        side["all"] = side["sog"] + side["missed"] + side["blocked"]
        side["unblocked"] = side["sog"] + side["missed"]
    away, home = event["away"], event["home"]
    attempts = any(side["missed"] or side["blocked"] for side in (a, h))
    lines = [heading("Shot attempts" if attempts else "Shooting")]
    label_w = 18
    head = Line().add(" " * label_w, "normal")
    head.add(f"{away['abbr']:>6}", THEME.style(league, away, bold=True, fallback="accent"))
    head.add(f"{home['abbr']:>6}", THEME.style(league, home, bold=True, fallback="accent"))
    lines.append(head)

    def row(label, left, right, note=""):
        line = Line().add(f"{label:<{label_w}}", "muted")
        line.add(f"{left:>6}", "bold").add(f"{right:>6}", "bold")
        if note:
            line.add(f"   {note}", "dim")
        lines.append(fit_line(line, width))

    row("On goal", a["sog"], h["sog"])
    if a["missed"] or h["missed"]:
        row("Missed the net", a["missed"], h["missed"])
    if a["blocked"] or h["blocked"]:
        row("Blocked", a["blocked"], h["blocked"])
    total = a["all"] + h["all"]
    if a["missed"] or a["blocked"] or h["missed"] or h["blocked"]:
        row("All attempts", a["all"], h["all"])
        if total:
            share = round(a["all"] / total * 100)
            row("Share", f"{share}%", f"{100 - share}%")
    if a["sog"] and h["sog"]:
        row("Shooting %", f"{a['goals'] / a['sog'] * 100:.1f}",
            f"{h['goals'] / h['sog'] * 100:.1f}")
        row("Save %", f"{1 - h['goals'] / h['sog']:.3f}".lstrip("0"),
            f"{1 - a['goals'] / a['sog']:.3f}".lstrip("0"))
    return lines


def flow_png(spec, cw, ch):
    """The game's flow as a picture under its plot's cells (7.0.0): a soft
    panel with dashed quarter lines, each period's start a dashed rule, each
    team's running count a smooth line in its colour (lifted to read on the
    dark) over a fill that fades to the floor, the away line dashed when the
    colours clash, every goal a ringed disc on its team's line, a picked one
    ringed in gold."""
    cw, ch = max(4, int(cw)), max(8, int(ch))
    W, H = spec["cols"] * cw, spec["rows"] * ch
    buf = bytearray(W * H * 4)
    stride = W * 4
    X0, X1 = 2.0, W - 3.0
    Y0, Y1 = ch * 0.35, H - 2.0
    raster_shape(buf, W, 0, 0, W, H, (255, 255, 255), alpha=0.035, radius=5, replace=True)
    for quarter in (0.25, 0.5, 0.75, 1.0):
        y = int(Y1 - quarter * (Y1 - Y0))
        for x in range(int(X0), int(X1)):
            if (x // 3) % 2 == 0:
                _blend(buf, y * stride + x * 4, (255, 255, 255), 0.10)
    for at in spec["periods"]:
        x = int(X0 + at * (X1 - X0))
        for y in range(int(Y0), int(Y1)):
            if (y // 3) % 2 == 0:
                _blend(buf, y * stride + x * 4, (255, 255, 255), 0.22)
    for x in range(int(X0), int(X1)):
        _blend(buf, int(Y1) * stride + x * 4, (255, 255, 255), 0.30)
    top = max(1, spec["top"])
    colours = [lift(hex_to_rgb("#" + spec[side]) or (150, 150, 150), 0.66)
               for side in ("away", "home")]
    paths = []
    for index, times in enumerate(spec["times"]):
        # the running count as a line through each attempt (its n-th at its
        # moment), level after the last: smooth where a step chart is jagged
        knots = [(0.0, 0.0)] + [(at, n + 1.0) for n, at in enumerate(times)] + \
            [(1.0, float(len(times)))]
        points, k = [], 0
        for x in range(int(X0), int(X1) + 1):
            at = (x - X0) / max(1.0, X1 - X0)
            while k < len(knots) - 2 and knots[k + 1][0] <= at:
                k += 1
            (ta, va), (tb, vb) = knots[k], knots[k + 1]
            value = va if tb <= ta else va + (vb - va) * min(1.0, max(0.0, (at - ta) / (tb - ta)))
            points.append((float(x), Y1 - value / top * (Y1 - Y0)))
        paths.append((index, points))
        rgb = colours[index]
        # the fill: strongest under the line, fading to the floor
        for x, yv in points:
            if not X0 <= x < X1:
                continue
            span = max(1.0, Y1 - yv)
            for y in range(int(yv), int(Y1)):
                _blend(buf, y * stride + int(x) * 4, rgb, 0.20 * (1 - (y - yv) / span) + 0.03)
    for index, points in paths:
        rgb = colours[index]
        dashed = spec.get("clash") and index == 0
        walked = 0.0
        # the line drawn a few pixels a stroke, so a dash can skip whole ones
        for i in range(0, len(points) - 1, 3):
            (xa, ya), (xb, yb) = points[i], points[min(len(points) - 1, i + 3)]
            step = ((xb - xa) ** 2 + (yb - ya) ** 2) ** 0.5
            if not dashed or int(walked // 8) % 2 == 0:
                _aa_segment(buf, W, H, xa, ya, xb, yb, 2.4, rgb)
            walked += step
    for at, side, value, picked in spec["goals"]:
        x = X0 + at * (X1 - X0)
        y = Y1 - value / top * (Y1 - Y0)
        if picked:
            _aa_ring(buf, W, H, x, y, 8.5, 2.2, (255, 176, 40))
        _aa_disc(buf, W, H, x, y, 5.6, (24, 28, 34), alpha=0.9)
        _aa_disc(buf, W, H, x, y, 4.8, (255, 255, 255))
        _aa_disc(buf, W, H, x, y, 3.6, colours[side])
    return png_encode(W, H, buf)


def hockey_flow(summary, event, league, width, rows=6, mark=None):
    """The game's flow: each team's running count of shot attempts (or of
    shots on goal, when that is all the play by play has) across the game in
    braille, each team in its colour, with the goals marked beneath. `mark`
    is a moment (seconds into the game) to ring there - a picked goal.
    Returns (what is counted, lines), or (None, []) without enough shots."""
    events = []
    counts = hockey_attempts(summary, event)
    attempts = bool(counts and any(counts[s]["missed"] + counts[s]["blocked"]
                                   for s in ("away", "home")))
    kinds = ("goal", "shot", "missed", "blocked") if attempts else ("goal", "shot")
    for play in hockey_shot_plays(summary):
        kind = clean(dig(play, "type", "text", default="")).lower()
        side = side_of(event, dig(play, "team", "id"))
        at = hockey_clock_seconds(play, league)
        if not side or kind not in kinds or at is None:
            continue
        if kind == "blocked":
            side = "home" if side == "away" else "away"
        events.append((at, side, kind == "goal"))
    # the AHL's goals come from its own list when its play by play has none
    if not any(goal for _, _, goal in events):
        for play in dig(summary, "plays", default=[]) or []:
            side = side_of(event, dig(play, "team", "id"))
            at = hockey_clock_seconds(play, league)
            if play.get("scoringPlay") and side and at is not None:
                events.append((at, side, True))
    shots = [e for e in events if not e[2]]
    if len(shots) < 6:
        return None, []
    events.sort()
    cols = max(20, width - 4)
    last = max(at for at, _, _ in events)
    end = 3600
    if last >= 3600:            # overtime: five minutes, or a playoff's twenty
        end = 3900 if last < 3900 else 3600 + 1200 * -(-(last - 3599) // 1200)
    totals = {"away": 0, "home": 0}
    series = {"away": [0] * (cols * 2), "home": [0] * (cols * 2)}
    marks = {}
    goals_at = []                  # (seconds, side, its count then): 7.0.0
    index = 0
    for px in range(cols * 2):
        limit = (px + 1) * end / (cols * 2)
        while index < len(events) and events[index][0] < limit:
            at, side, goal = events[index]
            totals[side] += 1
            if goal:
                marks[min(cols - 1, int(at / end * cols))] = side
                goals_at.append((at, side, totals[side]))
            index += 1
        for side in ("away", "home"):
            series[side][px] = totals[side]
    top = max(1, totals["away"], totals["home"])
    height_px = rows * 4
    cells = {}
    dashed = teams_clash(league, event["away"], event["home"])
    starts = [p * 1200 for p in range(1, 99) if p * 1200 < end]
    if UNDER["on"]:
        # 7.0.0: a picture under blank cells, the labels and legend in text
        ring_at = mark if isinstance(mark, (int, float)) else None
        spec = {"cols": cols, "rows": rows, "top": top,
                "away": team_hex(league, event["away"]), "home": team_hex(league, event["home"]),
                "clash": dashed,
                "times": tuple(tuple(round(at / end, 4) for at, side_, _ in events
                                     if side_ == side) for side in ("away", "home")),
                "periods": tuple(round(at / end, 4) for at in starts),
                "goals": tuple((round(at / end, 4), 0 if side == "away" else 1, count,
                                int(ring_at is not None and abs(at - ring_at) < 1))
                               for at, side, count in goals_at)}
        number = underlay_number(("flow", repr(spec)),
                                 lambda cw, ch, sp=spec: flow_png(sp, cw, ch), cols, rows)
        plot = [Line().add(" " * cols, "normal") for _ in range(rows)]
        plot = underlay_lines(plot, number)
        lines = []
        for row in range(rows):
            label = top if row == 0 else (0 if row == rows - 1 else "")
            lines.append(Line([(f"{label:>3} ", "muted")] + list(plot[row])))
    if not UNDER["on"]:
        # the text chart: the goals sit on their team's line (7.0.0)
        on_line = {}
        for at, side, count in goals_at:
            col = min(cols - 1, int(at / end * cols))
            row = min(rows - 1, (height_px - 1 - int(round(count / top * (height_px - 1)))) // 4)
            on_line[(row, col)] = side
    for side in ("away", "home"):
        previous = None
        for px, value in enumerate(series[side]):
            py = height_px - 1 - int(round(value / top * (height_px - 1)))
            span = [py] if previous is None else range(min(previous, py), max(previous, py) + 1)
            if dashed and side == "away" and px % 4 >= 2:
                previous = py            # the away line dashed when the colours clash
                continue
            for y in span:
                key = (y // 4, px // 2)
                bits, owners = cells.get(key, (0, {}))
                owners = dict(owners)
                owners[side] = owners.get(side, 0) + 1
                cells[key] = (bits | BRAILLE_BITS[y % 4][px % 2], owners)
            previous = py
    if not UNDER["on"]:
        # 7.0.0: a dotted rule at half the top count and each period's start
        # ruled through the plot, under the lines
        half_row = rows // 2 if rows >= 4 else None
        divider = {min(cols - 1, int(at / end * cols)) for at in starts}
        lines = []
        for row in range(rows):
            line = Line().add(f"{(top if row == 0 else (0 if row == rows - 1 else '')):>3} ",
                              "muted")
            for col in range(cols):
                if (row, col) in on_line:
                    line.add("●", THEME.style(league, event[on_line[(row, col)]], bold=True,
                                              fallback="accent"))
                elif (row, col) in cells:
                    bits, owners = cells[(row, col)]
                    side = max(owners, key=lambda s: (owners[s], s == "home"))
                    line.add(chr(0x2800 + bits), THEME.style(league, event[side], bold=True,
                                                             fallback="accent"))
                elif col in divider:
                    line.add("┊", "border")
                elif row == half_row:
                    line.add("┈", "border")
                else:
                    line.add(" ", "normal")
            lines.append(merge_spans(line))
    # the axis, each period named where it starts, and the goals under it
    axis = ["─"] * cols
    names = {}
    period = 0
    while period * 1200 < end:
        x = min(cols - 1, int(period * 1200 / end * cols))
        if period:
            axis[x] = "┴"
        for i, ch in enumerate(period_tag(league, period + 1)):
            if x + 1 + i < cols:
                names[x + 1 + i] = ch
        period += 1
    axis_line = Line().add("    ", "normal")
    for col in range(cols):
        if col in names:
            axis_line.add(names[col], "muted")
        else:
            axis_line.add(axis[col], "border")
    lines.append(merge_spans(axis_line))
    ring = min(cols - 1, int(mark / end * cols)) if isinstance(mark, (int, float)) else None
    goal_line = Line().add("    ", "normal")
    for col in range(cols):
        if col == ring:
            goal_line.add("◉", "warn")
        elif col in marks:
            goal_line.add("●", THEME.style(league, event[marks[col]], bold=True,
                                           fallback="accent"))
        else:
            goal_line.add(" ", "normal")
    lines.append(merge_spans(goal_line))
    legend = Line().add("    ", "normal")
    for side in ("away", "home"):
        legend.add("╍ " if dashed and side == "away" else "━ ",
                   THEME.style(league, event[side], bold=True, fallback="accent"))
        legend.add(f"{event[side]['abbr']} {totals[side]}", "bold").add("   ", "normal")
    legend.add("● goal", "muted")
    if ring is not None:
        legend.add("  ◉ this goal", "warn")
    lines.append(fit_line(legend, width))
    return ("shot attempts" if attempts else "shots on goal"), lines


def hockey_flow_lines(summary, event, league, width, rows=6, mark=None):
    """hockey_flow with its heading: 'Game flow  shot attempts'."""
    what, lines = hockey_flow(summary, event, league, width, rows, mark)
    return [heading(f"Game flow  {what}")] + lines if lines else []


def hockey_goal_strengths(summary, event, league, width):
    """How each team's goals came: at even strength, on the power play,
    short-handed, into an empty net."""
    tally = {"away": {}, "home": {}}
    for play in dig(summary, "plays", default=[]) or []:
        if not play.get("scoringPlay"):
            continue
        side = side_of(event, dig(play, "team", "id"))
        if not side:
            continue
        strength = clean(dig(play, "strength", "abbreviation", default="")).lower()
        text = clean(play.get("text") or "").lower()
        tags = strength.split("/")
        if "empty" in strength or "empty net" in text or "eng" in tags:
            kind = "empty net"
        elif strength.startswith("power") or "ppg" in tags:
            kind = "power play"
        elif strength.startswith("short") or "shg" in tags:
            kind = "short-handed"
        else:
            kind = "even"
        tally[side][kind] = tally[side].get(kind, 0) + 1
    if not tally["away"] and not tally["home"]:
        return []
    lines = [heading("How the goals came")]
    for side in ("away", "home"):
        team = event[side]
        line = Line().add(f"{team['abbr']:<5}", THEME.style(league, team, bold=True,
                                                          fallback="accent"))
        parts = [f"{n} {kind}" for kind, n in sorted(tally[side].items(),
                                                     key=lambda kv: ("even", "power play",
                                                                     "short-handed",
                                                                     "empty net").index(kv[0]))]
        line.add(", ".join(parts) if parts else "none", "normal")
        lines.append(fit_line(line, width))
    return lines


def hockey_goalie_table(summary, event, league, width):
    """Each goalie who played: shots, saves, save %, time and, where ESPN
    splits them, his saves at even strength, on the penalty kill and while
    his team was on the power play."""
    rows, styles, sides = [], [], []
    split = False
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = side_of(event, dig(block, "team", "id"))
        if not side:
            continue
        for group in block.get("statistics") or []:
            if group.get("name") != "goalies":
                continue
            keys = [clean(k) for k in group.get("labels") or group.get("keys") or []]
            for athlete in group.get("athletes") or []:
                stats = dict(zip(keys, [clean(s) for s in athlete.get("stats") or []]))
                if _int(stats.get("SA")) == 0 and stats.get("TOI", "0:00") in ("0:00", ""):
                    continue
                name = clean(dig(athlete, "athlete", "shortName", default="") or
                             dig(athlete, "athlete", "displayName", default="") or "?")
                strengths = [stats.get(k, "") for k in ("ESSV", "PPSV", "SHSV")]
                split = split or all(strengths)
                rows.append([event[side]["abbr"], name, stats.get("SA", ""),
                             stats.get("SV", ""), stats.get("SV%", ""),
                             stats.get("TOI", "")] + strengths)
                sides.append(side)
    if not rows:
        return []
    headers = ["", "", "SA", "SV", "SV%", "TOI"] + (["ES", "PK", "PP"] if split else [])
    rows = [row[:len(headers)] for row in rows]
    table = build_table(headers, rows, aligns=["<", "<"] + [">"] * (len(headers) - 2),
                        header_style="muted", sep="  ")
    for line, side in zip(table[1:], sides):
        line[0] = (line[0][0], THEME.style(league, event[side], bold=True, fallback="accent"))
    lines = [heading("Goaltending")] + [fit_line(line, width) for line in table]
    if split:
        lines.append(Line().add("ES PK PP: saves at even strength, killing a penalty, "
                                "on the power play"[:width], "muted"))
    return lines


def hockey_bench_lines(summary, event, league, width, extras=None):
    """The head coaches, the scratches and the officials."""
    extras = extras or {}
    lines = []
    coaches = extras.get("coaches") or {}
    scratches = extras.get("scratches") or {}
    for side in ("away", "home"):
        team = event[side]
        coach = coaches.get(side)
        out = scratches.get(side) or []
        if not coach and not out:
            continue
        line = Line().add(f"{team['abbr']:<5}", THEME.style(league, team, bold=True,
                                                          fallback="accent"))
        if coach:
            line.add("coach ", "muted").add(coach, "normal")
        lines.append(fit_line(line, width))
        if out:
            for chunk in wrap_spans("scratched: " + ", ".join(out), width - 5, "dim"):
                lines.append(Line().add("     ", "normal").extend_spans(chunk))
    referees = extras.get("referees") or []
    linesmen = extras.get("linesmen") or []
    if referees or linesmen:
        text = ""
        if referees:
            text += "referees " + ", ".join(referees)
        if linesmen:
            text += ("  ·  " if text else "") + "linesmen " + ", ".join(linesmen)
        lines.extend(wrap_spans(text, width, "muted"))
    else:
        officials = officials_text(summary)
        if officials:
            lines.extend(wrap_spans("officials " + officials, width, "muted"))
    return ([heading("Behind the benches")] + lines) if lines else []


def series_count_text(series):
    """'MIL wins series 4-1' / 'TB leads series 2-1' / 'Series tied 1-1' from a
    series' own games ('' without a finished one)."""
    wins, played = {}, 0
    for game in series.get("events") or []:
        if not isinstance(game, dict) or \
                clean(dig(game, "statusType", "state", default="") or "") != "post":
            continue
        scores = []
        for node in game.get("competitors") or []:
            abbr = clean(dig(node, "team", "abbreviation", default="") or "")
            scores.append((_number(node.get("score")), abbr))
            wins.setdefault(abbr, 0)
        if len(scores) == 2 and None not in (scores[0][0], scores[1][0]) and \
                scores[0][0] != scores[1][0]:
            wins[max(scores)[1]] += 1
            played += 1
    if not played or len(wins) != 2:
        return ""
    (first, a), (second, b) = sorted(wins.items(), key=lambda item: -item[1])
    if a == b:
        return f"Series tied {a}-{b}"
    verb = "wins" if series.get("completed") else "leads"
    return f"{first} {verb} series {a}-{b}"


def hockey_series_lines(summary, league, width):
    """The season series so far (a playoff series ahead of it), from ESPN's
    summary, its record counted from its own games where ESPN's words
    disagree with them."""
    found = [s for s in dig(summary, "seasonseries", default=[]) or [] if isinstance(s, dict)]
    found.sort(key=lambda s: s.get("type") != "playoff")
    for series in found:
        text = clean(series.get("summary") or series.get("shortSummary") or "")
        if not text:
            continue
        counted = series_count_text(series)
        numbers = re.findall(r"\d+-\d+", text)
        if counted and numbers and numbers[-1] not in counted:
            text = counted
        playoff = series.get("type") == "playoff" or "playoff" in \
            clean(series.get("title") or "").lower()
        lines = [heading("Playoff series" if playoff else "Season series")]
        total = series.get("totalCompetitions")
        lines.append(Line().add(text, "bold").add(
            (f"  (best of {total})" if playoff else f"  ({total} meetings)")
            if isinstance(total, int) and total > 1 else "", "dim"))
        for game in series.get("events") or []:
            if not isinstance(game, dict):
                continue
            teams = game.get("competitors") or []
            when = card_day(game.get("date"))
            parts = []
            for node in teams:
                abbr = clean(dig(node, "team", "abbreviation", default="") or "")
                score = clean(str(node.get("score") if node.get("score") is not None else ""))
                parts.append((node.get("homeAway"), abbr, score))
            parts.sort(key=lambda p: p[0] != "away")
            state = clean(dig(game, "statusType", "state", default="") or "")
            if len(parts) == 2:
                (_, a, sa), (_, h, sh) = parts
                result = f"{a} {sa} @ {h} {sh}" if state == "post" else f"{a} @ {h}"
                lines.append(Line().add(f"  {when:<6}", "muted").add(
                    result, "normal" if state == "post" else "dim"))
        return [fit_line(line, width) for line in lines]
    return []


def hockey_shot_map(summary, event, league, width, focus=None):
    """The rink with every shot on goal and goal, the away team shooting at
    the left net, and a legend; `focus` is a goal to ring."""
    shots = hockey_shots(summary, event)
    if len([s for s in shots if not s["goal"]]) < 3 and not focus:
        return []
    cols = max(30, min(width, 76))
    lines = [heading("Shot map")]
    lines.extend(rink_lines(shots + ([focus] if focus else []), event, league, cols))
    lines.extend(rink_key(event, league, width, bool(focus), split=False))
    return lines


def rink_key(event, league, width, focus=False, split=True):
    """The key under a rink: which way each team shoots, then • shot ● goal
    (and ◉ this goal); on two rows where one is too narrow and `split`."""
    away, home = event["away"], event["home"]

    def sides_line(left, right, gap):
        line = Line().add("← ", "muted").add(away["abbr"], THEME.style(
            league, away, bold=True, fallback="accent"))
        line.add(f"{left}{gap}", "muted")
        line.add(home["abbr"], THEME.style(league, home, bold=True, fallback="accent"))
        return line.add(f"{right} →", "muted")

    def marks_line(gap):
        line = Line().add(f"• shot{gap}● goal", "dim")
        return line.add(f"{gap}◉ this goal", "warn") if focus else line
    sides, marks = sides_line(" shoots left", " shoots right", "   "), marks_line("  ")
    if not split or len(sides.text) + 3 + len(marks.text) <= width:
        return [fit_line(Line(sides).add("   ", "normal").extend_spans(marks), width)]
    # two rows, each in the shortest words that still fit
    for short in (sides_line(" shoots", " shoots", "   "), sides_line("", "", "   ")):
        if len(sides.text) <= width:
            break
        sides = short
    if len(marks.text) > width:
        marks = marks_line(" ")
    return [fit_line(sides, width), fit_line(marks, width)]


def hockey_stats_left(summary, event, league, width):
    """The Game Stats tab's extra hockey sections under the team stats."""
    out = []
    for block in (hockey_period_table(summary, event, league, width),
                  hockey_attempt_lines(summary, event, league, width),
                  hockey_goal_strengths(summary, event, league, width)):
        if block:
            out += [blank()] + block
    return out


def hockey_stats_right(summary, event, league, width, extras=None):
    """…and under the game leaders: the stars, the goalies, the benches and
    the season series (the shot map and the game's flow are on Plays)."""
    out = []
    stars = (extras or {}).get("stars") or []
    blocks = [([heading("Three stars")] + star_lines(stars, league, width)) if stars else [],
              hockey_goalie_table(summary, event, league, width),
              hockey_bench_lines(summary, event, league, width, extras),
              hockey_series_lines(summary, league, width)]
    for block in blocks:
        if block:
            out += [blank()] + block
    return out


def ordinal_word(number):
    """1st, 2nd, 3rd, 4th … 11th, 12th, 13th, 21st."""
    n = _int(number)
    suffix = "th" if 10 <= n % 100 <= 20 else {1: "st", 2: "nd", 3: "rd"}.get(n % 10, "th")
    return f"{n}{suffix}"


def goal_attack_sign(play, summary, event):
    """+1 or -1: which net (x = +89 ft or -89 ft) a goal's team was shooting
    at in its period, by where most of its shots that period came from."""
    side = side_of(event, dig(play, "team", "id"))
    number = _int(dig(play, "period", "number", default=0))
    votes = 0
    for other in hockey_shot_plays(summary):
        kind = clean(dig(other, "type", "text", default="")).lower()
        if kind not in ("shot", "goal", "missed") or other is play:
            continue
        if side_of(event, dig(other, "team", "id")) != side or \
                _int(dig(other, "period", "number", default=0)) != number:
            continue
        x = dig(other, "coordinate", "x")
        if isinstance(x, (int, float)) and abs(x) <= 100:
            votes += 1 if x > 0 else -1 if x < 0 else 0
    x = dig(play, "coordinate", "x")
    if votes == 0 and isinstance(x, (int, float)):
        return 1 if x >= 0 else -1
    return 1 if votes >= 0 else -1


def goal_details(play, summary, event):
    """What the Plays tab's card says about one goal: scorer and assists
    with their season totals, shot type, distance, strength, the goalie it
    beat, the score after it and what it meant."""
    side = side_of(event, dig(play, "team", "id"))
    other = "home" if side == "away" else "away"
    scorer, helpers = None, []
    for part in play.get("participants") or []:
        if not isinstance(part, dict):
            continue
        kind = clean(part.get("type") or "")
        athlete = part.get("athlete") or {}
        name = clean(athlete.get("displayName") or "")
        if not name:
            continue
        if kind == "scorer" and scorer is None:
            scorer = {"name": name, "id": str(athlete.get("id") or ""),
                      "count": part.get("ytdGoals"),
                      "photo": clean(dig(athlete, "headshot", "href", default="") or "")}
        elif kind == "assister":
            helpers.append({"name": name, "count": part.get("ytdAssists")})
    text = clean(play.get("text") or "")
    if scorer is None:
        found = re.match(r"(.+?) (?:Goal )?\((\d+)\)", text)
        if found:
            scorer = {"name": found.group(1), "id": "", "count": found.group(2), "photo": ""}
    if not helpers:
        found = re.search(r"assists?: (.+)$", text)
        if found:
            for name in found.group(1).split(", "):
                bits = re.match(r"(.+?)(?: \((\d+)\))?$", name.strip())
                if bits:
                    helpers.append({"name": bits.group(1), "count": bits.group(2)})
    shot = ""
    found = re.search(r"\(\d+\) ([A-Z][A-Za-z -]+?)(?:,|$)", text)
    if found and found.group(1).lower() not in ("assists", "unassisted"):
        shot = found.group(1).strip()
    strength = clean(dig(play, "strength", "abbreviation", default="")).lower()
    tags = strength.split("/")
    if "empty" in strength or "eng" in tags or "empty net" in text.lower():
        how = "empty net"
    elif strength.startswith("power") or "ppg" in tags:
        how = "power play"
    elif strength.startswith("short") or "shg" in tags:
        how = "short-handed"
    elif "ps" in tags:
        how = "penalty shot"
    else:
        how = "even strength"
    distance = None
    x, y = dig(play, "coordinate", "x"), dig(play, "coordinate", "y")
    if isinstance(x, (int, float)) and isinstance(y, (int, float)) and abs(x) <= 100:
        net = 89 * goal_attack_sign(play, summary, event)
        distance = int(round(((net - x) ** 2 + y ** 2) ** 0.5))
    goalie = ""
    if how != "empty net" and side:
        at = hockey_clock_seconds(play)
        best = None
        for shot_play in hockey_shot_plays(summary):
            if clean(dig(shot_play, "type", "text", default="")).lower() != "shot" or \
                    side_of(event, dig(shot_play, "team", "id")) != side:
                continue
            when = hockey_clock_seconds(shot_play)
            if when is None or at is None or when > at:
                continue
            for part in shot_play.get("participants") or []:
                if isinstance(part, dict) and part.get("type") in ("saver", "goalie"):
                    name = clean(dig(part, "athlete", "displayName", default="") or "")
                    if name and (best is None or when >= best[0]):
                        best = (when, name)
        goalie = best[1] if best else ""
    away_score, home_score = _int(play.get("awayScore")), _int(play.get("homeScore"))
    mine = away_score if side == "away" else home_score
    theirs = home_score if side == "away" else away_score
    meaning = ""
    if side and mine == 1 and theirs == 0:
        meaning = "opened the scoring"
    elif side and mine == theirs:
        meaning = "tied the game"
    elif side and mine == theirs + 1:
        meaning = "put them ahead"
    elif side and mine == theirs - 1:
        meaning = "made it a one-goal game"
    # the winner's goal that left the loser behind for good (a shootout's
    # extra goal is not one of the plays)
    if side and event.get("state") == "post" and "SO" not in str(event.get("detail") or ""):
        final_mine = _int(event[side].get("score"))
        final_theirs = _int(event[other].get("score"))
        if final_mine > final_theirs and mine == final_theirs + 1:
            meaning = "opened the scoring, the game-winner" if mine == 1 else "the game-winner"
    return {"side": side, "scorer": scorer, "helpers": helpers, "shot": shot, "how": how,
            "distance": distance, "goalie": goalie, "meaning": meaning,
            "score": (away_score, home_score)}


GOAL_LABEL_W = 9        # the goal card's labels: WHEN, SCORE, SCORER, ASSISTS ...


def goal_card_keys(clip=None):
    """The keys of the Plays tab's goal card, as one line of text."""
    keys = "j / k the next goal · esc lets go"
    if clip:
        keys = ("enter plays its clip" if clip.get("kind") == "audio" else
                "enter opens its clip") + " · " + keys
    return keys


def goal_card_text(play, summary, event, league, width, rows, clip=None, hints=True):
    """The words of the Plays tab's card for a goal, a label a row (since
    7.1.0): WHEN, SCORE (and what it did), SCORER (and his goals this
    season), ASSISTS, SHOT (type, distance, strength) and GOALIE; with
    `hints` the keys under them."""
    info = goal_details(play, summary, event)
    side = info["side"]
    team = event[side] if side else {}
    team_style = THEME.style(league, team, bold=True, fallback="accent") if side else "accent"
    label_w = GOAL_LABEL_W if width >= GOAL_LABEL_W + 16 else 0
    lines = []

    def row(label, spans, *more):
        """The label, then `spans`; each of `more` (spans) after them where it
        fits, else on a row of its own under the value."""
        line = Line().add(f"{label:<{label_w}}" if label_w else "", "muted")
        lines.append(line.extend_spans(spans))
        for extra in more:
            if len(lines[-1].text) + sum(len(t) for t, _ in extra) <= width:
                lines[-1].extend_spans(extra)
            else:
                lines.append(Line().add(" " * label_w, "normal").extend_spans(
                    [(t.lstrip(), s) if i == 0 else (t, s) for i, (t, s) in enumerate(extra)]))

    def wrapped(label, text, style):
        """A long value word-wrapped under itself."""
        for index, piece in enumerate(wrap_spans(text, max(8, width - label_w), style)):
            lead = f"{label:<{label_w}}" if index == 0 else " " * label_w
            lines.append(Line().add(lead if label_w else "", "muted").extend_spans(piece))

    number = dig(play, "period", "number", default=0)
    clock = clean(dig(play, "clock", "displayValue", default="") or "")
    row("WHEN", [(f"{hockey_period_name(number, league)}  {clock}".strip(), "normal")])
    when = lines.pop()          # first to go on a short card: the title has it too
    away, home = event["away"], event["home"]
    score = [(away["abbr"], THEME.style(league, away, bold=True, fallback="accent")),
             (f" {info['score'][0]}-{info['score'][1]} ", "bold"),
             (home["abbr"], THEME.style(league, home, bold=True, fallback="accent"))]
    row("SCORE", score, *([[(f"   {info['meaning']}", "warn")]] if info["meaning"] else []))
    scorer = info["scorer"] or {"name": "?", "count": None}
    name = [(scorer["name"], team_style)]
    if scorer.get("count") in (None, "", 0, "0"):
        row("SCORER", name)
    else:
        note = f"  his {ordinal_word(scorer['count'])} goal of the season"
        if label_w + len(scorer["name"]) + len(note) <= width:
            row("SCORER", name + [(note, "muted")])
        else:       # on a narrow card his goals in brackets, as the assists have theirs
            row("SCORER", name, [(f" ({scorer['count']})", "muted")])
    if info["helpers"]:
        names = ", ".join(f"{h['name']}" + (f" ({h['count']})" if h.get("count") not in
                                            (None, "") else "") for h in info["helpers"])
        wrapped("ASSISTS", names, "normal")
    else:
        row("ASSISTS", [("unassisted", "dim")])
    how = []
    if info["shot"]:
        how.append(info["shot"].lower())
    if info["distance"] is not None:
        how.append(f"from {info['distance']} ft")
    how.append(info["how"])
    wrapped("SHOT", " · ".join(how), "bold")
    if info["how"] == "empty net":
        row("GOALIE", [("none - into an empty net", "dim")])
    elif info["goalie"]:
        row("GOALIE", [(info["goalie"], "normal")])
    if len(lines) < rows:
        lines.insert(0, when)
    if hints:
        lines.append(blank())
        lines.extend(wrap_spans(goal_card_keys(clip), width, "muted"))
    return [fit_line(line, width) for line in lines[:rows]]


def goal_focus(play, summary, event):
    """The goal as a mark for rink_lines: turned like hockey_shots turns
    them, ringed."""
    side = side_of(event, dig(play, "team", "id"))
    x, y = dig(play, "coordinate", "x"), dig(play, "coordinate", "y")
    if not side or not isinstance(x, (int, float)) or not isinstance(y, (int, float)) \
            or abs(x) > 100 or abs(y) > 43:
        return None
    if (side == "away" and x > 0) or (side == "home" and x < 0):
        x, y = -x, -y
    return {"side": side, "x": float(x) + 100.0, "y": float(y) + 42.5, "goal": True,
            "focus": True}


# -- hockey: the Standings, Playoffs, Betting and Scoreboard tabs' spare room

def stat_summary(table, names):
    """A standings stat's short form: '7-2-1' rather than '7-2-1, 0 PTS'."""
    for name in names:
        stat = table.get(name)
        if isinstance(stat, dict):
            text = clean(stat.get("summary") or stat.get("displayValue") or "")
            if text:
                return text.split(",")[0].strip()
    return ""


def record_points(text):
    """Points from a 'W-L-OTL(-SOL)' record: two a win, one a loss past
    regulation."""
    parts = [_int(p) for p in re.findall(r"\d+", text or "")]
    if len(parts) < 2:
        return None
    return 2 * parts[0] + sum(parts[2:])


def hockey_table(data, league):
    """Every team in a hockey standings payload with the numbers the extra
    sections use: games, points, points %, goals, last ten, streak, home and
    road, and its conference and division."""
    teams = []
    for ident, (team, table, path) in standings_rows(data).items():
        games = _num(stat_display(table, ["gamesPlayed"])) or 0
        points = _num(stat_display(table, ["points"])) or 0
        if not games:
            continue
        goals_for = _num(stat_display(table, ["pointsFor", "goalsFor"]))
        goals_against = _num(stat_display(table, ["pointsAgainst", "goalsAgainst"]))
        last_ten = stat_summary(table, ["Last Ten Games", "lastTen", "L10"])
        teams.append({
            "team": team, "gp": int(games), "pts": int(points),
            "pct": points / (2 * games),
            "w": _int(stat_display(table, ["wins"])),
            "rw": _int(stat_display(table, ["regWins", "RW"]), -1),
            "row": _int(stat_display(table, ["rotWins", "ROW"]), -1),
            "gf": goals_for, "ga": goals_against,
            "l10": last_ten, "l10_pts": record_points(last_ten),
            "streak": clean(stat_display(table, ["streak"])),
            "home": stat_summary(table, ["Home", "home"]),
            "road": stat_summary(table, ["Road", "road"]),
            "seed": _int(stat_display(table, ["playoffSeed"]), 0),
            "conference": path[-2] if len(path) >= 2 else "",
            "division": path[-1] if path else "",
        })
    return teams


def hockey_rank_key(entry):
    """Points, then points % (games in hand), regulation wins, wins."""
    return (-entry["pts"], -entry["pct"], -max(entry["rw"], 0), -max(entry["row"], 0),
            -entry["w"])


def pace_ladder(teams, league, width, favorites=None):
    """Every team by points percentage, as bars, with its full-season pace."""
    season = 72 if league == "ahl" else 82
    ranked = sorted(teams, key=lambda t: (-t["pct"], -t["pts"]))
    lines = [heading("Points pace"),
             Line().add(f"by points % · pace over {season} games"[:width], "muted")]
    low = min(t["pct"] for t in ranked)
    high = max(t["pct"] for t in ranked)
    bar_w = max(6, width - 22)
    for index, entry in enumerate(ranked, 1):
        team = entry["team"]
        star = fav_rank(favorites or {}, league, team) >= 0
        line = Line().add(f"{index:>2} ", "muted").add("★" if star else " ", "star")
        line.add(f"{(team.get('abbr') or '?')[:4]:<5}", THEME.style(league, team, bold=True,
                                                                    fallback="accent"))
        share = 0.08 + 0.92 * ((entry["pct"] - low) / (high - low) if high > low else 1)
        line.extend_spans(meter_spans(share, bar_w, THEME.style(league, team,
                                                                fallback="accent")))
        line.add(f" {entry['pct']:.3f}".replace("0.", ".", 1), "normal")
        line.add(f" {round(entry['pct'] * 2 * season):>4}", "bold")
        lines.append(fit_line(line, width))
    return lines


def framed(title, lines, width, corners=("╭", "╮", "╰", "╯")):
    """Lines in a box of their own, `width` wide, the title on its top edge -
    a pane inside a scrolling screen."""
    tl, tr, bl, br = corners
    inner = max(1, width - 4)
    title = title[: max(0, width - 6)]
    out = [Line().add(f"{tl}─ ", "subborder").add(title, "accent")
           .add(" " + "─" * max(0, width - len(title) - 5) + tr, "subborder")]
    for line in lines:
        out.append(Line().add("│ ", "subborder").extend_spans(fit_line(line, inner))
                   .add(" │", "subborder"))
    out.append(Line().add(bl + "─" * max(0, width - 2) + br, "subborder"))
    return out


def hot_cold_rows(entries, label, value, extra=None, width=32, league="nhl"):
    """One group of a Hot and cold block: a sub-heading, then a team a row
    (abbreviation in its colours, its record, its number)."""
    good = label.lower().startswith("hot")
    lines = [Line().add(label, "good" if good else "bad")]
    for entry in entries:
        team = entry["team"]
        line = Line().add("  ", "normal")
        line.add(f"{(team.get('abbr') or '?')[:4]:<5}", THEME.style(league, team, bold=True,
                                                                    fallback="accent"))
        line.extend_spans(value(entry))
        if extra:
            line.extend_spans(extra(entry))
        lines.append(fit_line(line, width))
    return lines


def form_lines(teams, league, width=32):
    """The five hottest and five coldest teams over their last ten games."""
    have = [t for t in teams if t["l10_pts"] is not None]
    if len(have) < 10:
        return []
    ranked = sorted(have, key=lambda t: (-t["l10_pts"], -t["pct"]))

    def value(entry):
        return [(f"{entry['l10']:<9}", "normal"), (f"{entry['l10_pts']:>2} pts", "bold")]

    def streak(entry):
        text = entry["streak"] if re.fullmatch(r"[A-Z]{1,3}\d+", entry["streak"] or "") else ""
        return [(f"  {text}", "dim")] if text else []

    return ([heading("Last ten games")]
            + hot_cold_rows(ranked[:5], "Hot", value, streak, width, league)
            + hot_cold_rows(list(reversed(ranked[-5:])), "Cold", value, streak, width, league))


def differential_lines(teams, league, width=32):
    """Goal differential: the five best and the five worst, as bars either
    side of zero."""
    have = [t for t in teams if t["gf"] is not None and t["ga"] is not None]
    if len(have) < 10:
        return []
    ranked = sorted(have, key=lambda t: -(t["gf"] - t["ga"]))
    top = max(abs(t["gf"] - t["ga"]) for t in ranked[:5] + ranked[-5:]) or 1
    bar_w = max(4, width - 14)

    def value(entry):
        diff = int(entry["gf"] - entry["ga"])
        return [(f"{diff:+4d} ", "bold")] + meter_spans(abs(diff) / top, bar_w,
                                                        "good" if diff >= 0 else "bad")

    return ([heading("Goal differential")]
            + hot_cold_rows(ranked[:5], "Hot", value, None, width, league)
            + hot_cold_rows(list(reversed(ranked[-5:])), "Cold", value, None, width, league))


def split_pct(text):
    """Points % of a 'W-L-OTL' record, or None."""
    points = record_points(text)
    games = sum(_int(p) for p in re.findall(r"\d+", text or ""))
    return (points / (2 * games)) if points is not None and games else None


def venue_lines(teams, league, key, where, width=32):
    """The five best and five worst records at home (or on the road)."""
    have = [(split_pct(t[key]), t) for t in teams if split_pct(t[key]) is not None]
    if len(have) < 10:
        return []
    have.sort(key=lambda pair: (-pair[0], -pair[1]["pct"]))
    ranked = [t for _, t in have]

    def value(entry):
        pct = split_pct(entry[key])
        return [(f"{entry[key]:<9}", "normal"),
                (f"{pct:.3f}".replace("0.", ".", 1), "bold")]

    title = "At home" if key == "home" else "On the road"
    return ([heading(title)]
            + hot_cold_rows(ranked[:5], f"Hot {where}", value, None, width, league)
            + hot_cold_rows(list(reversed(ranked[-5:])), f"Cold {where}", value, None, width,
                            league))


def hockey_standings_extras(lines, data, league, width, favorites=None,
                            corners=("╭", "╮", "╰", "╯")):
    """The hockey standings' panes beside and under the division tables:
    Points pace (every team by points %, with its season pace) and Hot and
    cold (the five hottest and coldest over the last ten, by goal
    differential, at home and on the road)."""
    teams = hockey_table(data, league)
    if len(teams) < 10:
        return lines
    used = max([len(line.text) for line in lines] + [0])

    def hot_cold(pane_w):
        # four blocks across when they fit at 30 columns each, else 32 wide
        block_w = 30 if pane_w - 4 >= 4 * 30 + 3 * 2 else 32
        blocks = [b for b in (form_lines(teams, league, block_w),
                              differential_lines(teams, league, block_w),
                              venue_lines(teams, league, "home", "at home", block_w),
                              venue_lines(teams, league, "road", "on the road", block_w))
                  if b]
        if not blocks:
            return []
        return framed("Hot and cold", side_by_side(blocks, pane_w - 4, gap=2), pane_w,
                      corners)

    free = width - used - 2
    if free >= 40:
        pace_w = min(free, 60)
        right = framed("Points pace", pace_ladder(teams, league, pace_w - 4, favorites)[1:],
                       pace_w, corners)
        below = hot_cold(used)
        left = list(lines) + ([blank()] + below if below else [])
        out = []
        for index in range(max(len(left), len(right))):
            line = Line(list(fit_line(left[index] if index < len(left) else Line(), used)))
            if index < len(right):
                line.add("  ", "normal").extend_spans(right[index])
            out.append(line)
        return out
    pace_w = min(width, 60)
    pace = framed("Points pace", pace_ladder(teams, league, pace_w - 4, favorites)[1:],
                  pace_w, corners)
    return list(lines) + [blank()] + hot_cold(width) + [blank()] + pace


def regressed_pct(entry, mean=0.555, games=25):
    """A team's points % pulled toward the league's usual mark, the more so
    the fewer games it has played (early-season tables run hot and cold)."""
    played = entry.get("gp") or 0
    return mean + (entry["pct"] - mean) * played / (played + games)


def series_chance(top, bottom, wins_needed=4, home_edge=0.02):
    """The top seed's chance to win a series: one game from the gap between
    the two teams' regressed points %, a little home ice, then best-of-n."""
    import math
    game = 0.5 + 0.5 * (regressed_pct(top) - regressed_pct(bottom)) + home_edge
    game = clamp(game, 0.05, 0.95)
    total = 0.0
    for losses in range(wins_needed):
        total += math.comb(wins_needed - 1 + losses, losses) * game ** wins_needed * \
            (1 - game) ** losses
    return total


def projected_series(round_name, conference, top, bottom, wins_needed=4, chance=None):
    """A series of the projection: each side with its seed and its chance
    (the top side's given, or from the two points %), the favourite marked
    to go through (projected, so not a winner)."""
    chance = series_chance(top, bottom, wins_needed) if chance is None else chance
    favourite = top if chance >= 0.5 else bottom
    sides = []
    for entry, share in ((top, chance), (bottom, 1 - chance)):
        spot = side(entry["team"], entry.get("seed"), f"{round(share * 100):.0f}%",
                    entry is favourite)
        spot["projected"] = True
        sides.append(spot)
    found = series(round_name, conference, sides[0], sides[1])
    found["projected"] = True
    return found, favourite


def nhl_projection(data):
    """The bracket if the playoffs began today, in the NHL's format: in each
    conference the top three of each division and two wild cards, the
    better division winner meeting the second wild card. The later rounds
    send each series' favourite through."""
    by_conference = {}
    for entry in hockey_table(data, "nhl"):
        if entry["conference"] and entry["division"]:
            by_conference.setdefault(entry["conference"], {}).setdefault(
                entry["division"], []).append(entry)
    if len(by_conference) != 2:
        return []
    rounds = {name: [] for name in NHL_ROUNDS}
    finalists = []
    for conference in sorted(by_conference, key=lambda c: "west" in c.lower()):
        divisions = by_conference[conference]
        names = sorted(divisions)
        if len(names) != 2:
            return []
        ranked = {d: sorted(divisions[d], key=hockey_rank_key) for d in names}
        if any(len(ranked[d]) < 4 for d in names):
            return []
        for d in names:
            for place, entry in enumerate(ranked[d][:3], 1):
                entry["seed"] = f"{d[:1]}{place}"
        rest = sorted([t for d in names for t in ranked[d][3:]], key=hockey_rank_key)
        rest[0]["seed"], rest[1]["seed"] = "WC1", "WC2"
        best = min((ranked[d][0] for d in names), key=hockey_rank_key)["division"]
        short = "East" if "east" in conference.lower() else (
            "West" if "west" in conference.lower() else conference)
        through = []
        for d in names:
            first, second, third = ranked[d][:3]
            wild = rest[1] if d == best else rest[0]
            one, fav_one = projected_series("1st Round", short, first, wild)
            two, fav_two = projected_series("1st Round", short, second, third)
            rounds["1st Round"] += [one, two]
            final, fav = projected_series("2nd Round", short, fav_one, fav_two)
            rounds["2nd Round"].append(final)
            through.append(fav)
        conf_final, champion = projected_series("Conf Finals", short, *through)
        rounds["Conf Finals"].append(conf_final)
        finalists.append(champion)
    cup, _ = projected_series("Stanley Cup Final", "", *finalists)
    rounds["Stanley Cup Final"].append(cup)
    return [(name, rounds[name]) for name in NHL_ROUNDS]


