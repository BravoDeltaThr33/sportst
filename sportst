def http_text(url, timeout=15, user_agent=USER_AGENT):
    """GET a URL as text, gzip-aware (Wikipedia pages are ten times smaller
    compressed)."""
    import gzip
    request = urllib.request.Request(url, headers={
        "User-Agent": user_agent,
        "Accept": "application/json, text/html;q=0.9, */*;q=0.5",
        "Accept-Encoding": "gzip",
        "Accept-Language": "en-US,en;q=0.9",
    })
    raw, headers = net_read(request, timeout)
    if headers.get("Content-Encoding", "") == "gzip" or raw[:2] == b"\x1f\x8b":
        raw = gzip.decompress(raw)
    return raw.decode("utf-8", "replace")


def iso_utc(moment):
    return moment.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%MZ")


def _int(value, default=0):
    try:
        return int(float(str(value).strip()))
    except (TypeError, ValueError):
        return default


# -- the AHL, through HockeyTech ------------------------------------------

HT_FEED = "https://lscluster.hockeytech.com/feed/index.php"
HT_KEY = "50c2cd9b5e18e390"          # the public key theahl.com itself uses
HT_LOGO = "https://assets.leaguestat.com/ahl/logos/{}.png"
AHL_PLAYOFF_SPOTS = {"Atlantic": 6, "North": 5, "Central": 5, "Pacific": 7}
_HT_SEASONS = {"at": 0.0, "list": []}


def ht_get(params, timeout=15):
    query = dict(params)
    query.update({"key": HT_KEY, "client_code": "ahl", "lang": "en", "lang_code": "en"})
    if query.get("feed") != "statviewfeed":
        query["fmt"] = "json"
    text = http_text(f"{HT_FEED}?{urllib.parse.urlencode(query)}", timeout).strip()
    if text.startswith("(") and text.endswith(")"):
        text = text[1:-1]      # statviewfeed answers in JSONP
    data = json.loads(text)
    if isinstance(data, dict) and data.get("error"):
        raise ValueError(f"HockeyTech: {data['error']}")
    return data


def ht_seasons(timeout=15):
    if time.time() - _HT_SEASONS["at"] > 6 * 3600 or not _HT_SEASONS["list"]:
        data = ht_get({"feed": "modulekit", "view": "seasons"}, timeout)
        _HT_SEASONS["list"] = dig(data, "SiteKit", "Seasons", default=[]) or []
        _HT_SEASONS["at"] = time.time()
    return _HT_SEASONS["list"]


def ht_season(kind, timeout=15, day=None):
    """The season id to show: 'regular' or 'playoff'. The one under way, or
    else the latest one that has started."""
    day = (day or Date.today()).isoformat()
    want = "1" if kind == "playoff" else "0"
    rows = [s for s in ht_seasons(timeout)
            if s.get("playoff") == want and s.get("career") == "1"]
    for season in rows:
        if (season.get("start_date") or "") <= day <= (season.get("end_date") or ""):
            return season
    started = [s for s in rows if (s.get("start_date") or "9") <= day]
    started.sort(key=lambda s: s.get("start_date") or "")
    return started[-1] if started else (rows[0] if rows else None)


def ht_team(ident, code, name, nickname, city):
    return {"id": str(ident), "abbreviation": clean(code), "displayName": clean(name),
            "shortDisplayName": clean(nickname), "name": clean(nickname),
            "location": clean(city), "logo": HT_LOGO.format(ident)}


def ht_start(game):
    """Local puck drop -> UTC ISO, from the date, time and arena time zone."""
    stamp = game.get("GameDateISO8601") or game.get("game_date_iso_8601")
    if stamp:
        parsed = parse_iso(stamp)
        if parsed:
            return iso_utc(parsed)
    day = game.get("date_played") or game.get("Date") or ""
    clock = game.get("schedule_time") or game.get("ScheduledTime") or "19:00:00"
    try:
        from zoneinfo import ZoneInfo
        zone = ZoneInfo(game.get("timezone") or game.get("Timezone") or "America/New_York")
        local = datetime.fromisoformat(f"{day}T{clock}").replace(tzinfo=zone)
        return iso_utc(local)
    except Exception:  # noqa: BLE001 - a bad zone name still leaves a date
        return f"{day}T00:00Z" if day else ""


def ht_status(final, started, status, period, clock, intermission, shootout, text=""):
    """ESPN's status block from HockeyTech's flags."""
    period = _int(period)
    if final or status in ("3", "4"):
        tail = ""
        if shootout:
            tail = "/SO"
        elif period == 4:
            tail = "/OT"
        elif period > 4:
            tail = f"/{period - 3}OT"
        detail = f"Final{tail}"
        return {"period": period, "displayClock": "0:00",
                "type": {"state": "post", "completed": True, "shortDetail": detail,
                         "detail": detail}}
    if started:
        label = {4: "OT", 5: "SO"}.get(period, ordinal(period) if period else "")
        if intermission or (str(clock or "") in ("00:00:00", "0:00", "00:00") and period):
            detail = f"End of {label}" if period <= 3 else f"End {label}"
        else:
            shown = str(clock or "").lstrip("0:") or "0:00"
            if clock and re.fullmatch(r"\d\d:\d\d:\d\d", str(clock)):
                minutes, seconds = int(clock[3:5]), int(clock[6:8])
                shown = f"{minutes}:{seconds:02d}"
            detail = f"{shown} - {label}" if label else (text or "In Progress")
        return {"period": period, "displayClock": str(clock or ""),
                "type": {"state": "in", "completed": False, "shortDetail": detail,
                         "detail": detail}}
    return {"period": 0, "displayClock": "",
            "type": {"state": "pre", "completed": False,
                     "shortDetail": text or "Scheduled", "detail": text or "Scheduled"}}


def ht_record(stats):
    if not isinstance(stats, dict) or "wins" not in stats:
        return []
    otl = _int(stats.get("ot_losses")) + _int(stats.get("shootout_losses"))
    return [{"type": "total", "summary":
             f"{_int(stats.get('wins'))}-{_int(stats.get('losses'))}-{otl}"}]


def ht_event(game, live=None):
    """One gamesbydate row as an ESPN scoreboard event."""
    live = live or {}
    ident = str(game.get("id") or game.get("game_id"))
    state = ht_status(game.get("final") == "1", game.get("started") == "1",
                      str(game.get("status") or ""),
                      live.get("Period") or game.get("period"),
                      live.get("GameClock") or game.get("game_clock"),
                      (live.get("Intermission") or game.get("intermission")) == "1",
                      game.get("shootout") == "1", game.get("game_status") or "")
    if state["type"]["state"] == "in" and live.get("GameStatusStringLong"):
        state["type"]["shortDetail"] = clean(live.get("GameStatusString")
                                             or live["GameStatusStringLong"])
    periods = max(3, _int(game.get("period"))) if state["type"]["state"] != "pre" else 0
    if game.get("shootout") == "1":
        periods = max(periods, 5)
    competitors = []
    for side, prefix, goals_key in (("home", "home", "home_goal_count"),
                                    ("away", "visiting", "visiting_goal_count")):
        by_period = game.get(f"{prefix}_team_goals_by_period") or {}
        if not isinstance(by_period, dict):
            by_period = {}
        played = state["period"] if state["type"]["state"] == "in" else periods
        lines = [{"value": _int(by_period.get(str(n)))} for n in range(1, played + 1)]
        ident_team = game.get("home_team" if side == "home" else "visiting_team")
        competitors.append({
            "homeAway": side,
            "team": ht_team(ident_team, game.get(f"{prefix}_team_code"),
                            game.get(f"{prefix}_team_name"),
                            game.get(f"{prefix}_team_nickname"),
                            game.get(f"{prefix}_team_city")),
            "score": str(_int(live.get("HomeGoals" if side == "home" else "VisitorGoals",
                                       game.get(goals_key)))),
            "linescores": lines,
            "records": ht_record(game.get(f"{prefix}_stats")),
        })
    home, away = competitors
    if state["type"]["state"] == "post":
        if _int(home["score"]) > _int(away["score"]):
            home["winner"] = True
        elif _int(away["score"]) > _int(home["score"]):
            away["winner"] = True
    notes = []
    if game.get("playoff") == "1":
        notes.append({"headline": "Calder Cup Playoffs"})
    if clean(game.get("schedule_notes")):
        notes.append({"headline": clean(game.get("schedule_notes"))})
    city = clean(game.get("venue_location") or "")
    return {
        "id": ident,
        "name": f"{away['team']['displayName']} at {home['team']['displayName']}",
        "shortName": f"{away['team']['abbreviation']} @ {home['team']['abbreviation']}",
        "date": ht_start(game),
        "status": state,
        "competitions": [{"competitors": competitors, "status": state,
                          "venue": {"fullName": clean(game.get("venue") or ""),
                                    "address": {"city": city}},
                          "notes": notes, "broadcasts": []}],
    }


def ahl_scoreboard(day_iso, timeout=15):
    data = ht_get({"feed": "modulekit", "view": "gamesbydate", "fetch_date": day_iso},
                  timeout)
    games = dig(data, "SiteKit", "Gamesbydate", default=[]) or []
    live = {}
    if day_iso == Date.today().isoformat() and any(
            g.get("started") == "1" and g.get("final") != "1" for g in games):
        bar = ht_get({"feed": "modulekit", "view": "scorebar", "numberofdaysback": "0",
                      "numberofdaysahead": "0"}, timeout)
        live = {str(g.get("ID")): g for g in dig(bar, "SiteKit", "Scorebar", default=[]) or []}
    events = [ht_event(g, live.get(str(g.get("id")))) for g in games]
    season = ht_season("regular", timeout)
    return {"events": events, "day": {"date": day_iso},
            "leagues": [{"season": {"year": _int((season or {}).get("start_date", "0")[:4])
                                    or Date.today().year}}]}


def _person(node):
    if not isinstance(node, dict):
        return ""
    return clean(f"{node.get('first_name') or ''} {node.get('last_name') or ''}".strip())


def _short(node):
    first = clean(node.get("first_name") or "")
    last = clean(node.get("last_name") or "")
    return f"{first[:1]}. {last}".strip(". ") if first else last


def ahl_summary(game_id, timeout=15):
    data = ht_get({"feed": "gc", "tab": "gamesummary", "game_id": str(game_id)}, timeout)
    g = dig(data, "GC", "Gamesummary", default={}) or {}
    meta = g.get("meta") or {}
    if not meta:
        raise ValueError("HockeyTech has no summary for that game")
    sides = {"home": g.get("home") or {}, "away": g.get("visitor") or {}}
    keys = {"home": "home", "away": "visitor"}
    teams = {side: ht_team(t.get("id"), t.get("code"), t.get("name"), t.get("nickname"),
                           t.get("city")) for side, t in sides.items()}
    state = ht_status(meta.get("final") == "1", meta.get("started") == "1",
                      str(meta.get("status") or ""), meta.get("period"),
                      meta.get("game_clock"), False, meta.get("shootout") == "1",
                      clean(g.get("status_value") or ""))
    by_period = g.get("goalsByPeriod") or {}
    competitors = []
    for side in ("home", "away"):
        goals = by_period.get(keys[side]) or {}
        lines = [{"value": _int(goals[k])} for k in sorted(goals, key=_int)]
        competitors.append({"homeAway": side, "team": teams[side],
                            "score": str(_int(meta.get("home_goal_count" if side == "home"
                                                       else "visiting_goal_count"))),
                            "linescores": lines})
    if state["type"]["state"] == "post":
        home, away = competitors
        if _int(home["score"]) != _int(away["score"]):
            (home if _int(home["score"]) > _int(away["score"]) else away)["winner"] = True
    start = ht_start({"GameDateISO8601": g.get("game_date_iso_8601"), **meta})
    header = {"id": str(game_id), "competitions": [{"date": start, "status": state,
                                                    "competitors": competitors}],
              "shortName": f"{teams['away']['abbreviation']} @ "
                           f"{teams['home']['abbreviation']}"}

    # box score
    players, team_stats, leaders = [], [], []
    lineups = {"home": g.get("home_team_lineup") or {},
               "away": g.get("visitor_team_lineup") or {}}
    tracked = {k: any(_int(p.get(k)) for side in lineups.values()
                      for p in side.get("players") or [])
               for k in ("faceoff_attempts", "hits")}
    for side in ("home", "away"):
        lineup = lineups[side]
        labels = ["G", "A", "PTS", "+/-", "SOG", "PIM", "PPG", "SHG"]
        if tracked["faceoff_attempts"]:
            labels += ["FW", "FL"]
        if tracked["hits"]:
            labels += ["HT"]
        rows, totals = [], [0] * len(labels)
        skaters = sorted(lineup.get("players") or [],
                         key=lambda p: (-(_int(p.get("goals")) + _int(p.get("assists"))),
                                        -_int(p.get("goals")), p.get("last_name") or ""))
        for p in skaters:
            values = {"G": _int(p.get("goals")), "A": _int(p.get("assists")),
                      "+/-": clean(p.get("plusminus") or "0"),
                      "SOG": _int(p.get("shots")), "PIM": _int(p.get("pim")),
                      "PPG": _int(p.get("power_play_goals")),
                      "SHG": _int(p.get("short_handed_goals")),
                      "FW": _int(p.get("faceoff_wins")),
                      "FL": _int(p.get("faceoff_attempts")) - _int(p.get("faceoff_wins")),
                      "HT": _int(p.get("hits"))}
            values["PTS"] = values["G"] + values["A"]
            stats = [str(values[label]) for label in labels]
            for index, label in enumerate(labels):
                if label != "+/-":
                    totals[index] += _int(values[label])
            rows.append({"athlete": {"displayName": _person(p), "shortName": _short(p),
                                     "position": {"abbreviation": clean(
                                         p.get("position_str") or "")}},
                         "stats": stats, "starter": True})
        goalie_rows = []
        for p in lineup.get("goalies") or []:
            seconds = _int(p.get("seconds"))
            if not seconds and not _int(p.get("shots_against")):
                continue
            shots, against = _int(p.get("shots_against")), _int(p.get("goals_against"))
            saves = _int(p.get("saves"), shots - against)
            pct = f"{saves / shots:.3f}".lstrip("0") if shots else "-"
            goalie_rows.append({"athlete": {"displayName": _person(p), "shortName": _short(p),
                                            "position": {"abbreviation": "G"}},
                                "stats": [str(shots), str(against), str(saves), pct,
                                          f"{seconds // 60}:{seconds % 60:02d}"],
                                "starter": True})
        totals_text = [("" if label == "+/-" else str(value))
                       for label, value in zip(labels, totals)]
        players.append({"team": teams[side], "homeAway": side, "statistics": [
            {"name": "skaters", "text": "Skaters", "labels": labels, "athletes": rows,
             "totals": totals_text},
            {"name": "goalies", "text": "Goalies", "labels": ["SA", "GA", "SV", "SV%", "TOI"],
             "athletes": goalie_rows}]})

        key = keys[side]
        ppg = _int((g.get("powerPlayGoals") or {}).get(key))
        ppo = _int((g.get("powerPlayCount") or {}).get(key))
        stats = [
            {"name": "shotsTotal", "label": "Shots", "displayValue":
             str(_int((g.get("totalShots") or {}).get(key)))},
            {"name": "powerPlayGoals", "label": "Power Play", "displayValue": f"{ppg}/{ppo}"},
            {"name": "penaltyMinutes", "label": "PIM", "displayValue":
             str(_int((g.get("pimTotal") or {}).get(key)))},
            {"name": "penalties", "label": "Penalties", "displayValue":
             str(_int((g.get("infCount") or {}).get(key)))},
            {"name": "shortHandedGoals", "label": "Short-handed goals",
             "displayValue": str(sum(_int(p.get("short_handed_goals"))
                                     for p in lineup.get("players") or []))},
        ]
        faceoffs = (g.get("totalFaceoffs") or {}).get(key) or {}
        if _int(faceoffs.get("att")):
            stats.append({"name": "faceoffsWon", "label": "Faceoffs Won",
                          "displayValue": str(_int(faceoffs.get("won")))})
        if _int((g.get("totalHits") or {}).get(key)):
            stats.append({"name": "hits", "label": "Hits",
                          "displayValue": str(_int((g.get("totalHits") or {}).get(key)))})
        team_stats.append({"team": teams[side], "homeAway": side, "statistics": stats})

        categories = []
        for name, title, label, score in (
                ("goals", "Goals", "G", lambda p: _int(p.get("goals"))),
                ("assists", "Assists", "A", lambda p: _int(p.get("assists"))),
                ("points", "Points", "PTS",
                 lambda p: _int(p.get("goals")) + _int(p.get("assists")))):
            best = max(lineup.get("players") or [], key=score, default=None)
            if best and score(best) > 0:
                categories.append({"name": name, "displayName": title, "leaders": [{
                    "athlete": {"shortName": _short(best), "displayName": _person(best),
                                "position": {"abbreviation": clean(best.get("position_str")
                                                                   or "")}},
                    "mainStat": {"value": str(score(best)), "label": label}}]})
        goalies = [p for p in lineup.get("goalies") or [] if _int(p.get("seconds"))]
        if goalies:
            best = max(goalies, key=lambda p: _int(p.get("saves")))
            categories.append({"name": "saves", "displayName": "Saves", "leaders": [{
                "athlete": {"shortName": _short(best), "displayName": _person(best),
                            "position": {"abbreviation": "G"}},
                "mainStat": {"value": str(_int(best.get("saves"))), "label": "SV"},
                "summary": f"{_int(best.get('shots_against'))} shots, "
                           f"{_int(best.get('goals_against'))} GA"}]})
        leaders.append({"team": teams[side], "leaders": categories})

    # plays: goals and penalties, in the order they happened
    plays = []
    home_id = str(teams["home"]["id"])
    running = {"home": 0, "away": 0}
    for goal in sorted(g.get("goals") or [], key=lambda x: (_int(x.get("period_id")),
                                                            _int(x.get("s")))):
        side = "home" if str(goal.get("team_id")) == home_id else "away"
        running[side] += 1
        scorer = goal.get("goal_scorer") or {}
        helpers = [_person(goal.get(k)) for k in ("assist1_player", "assist2_player")
                   if _person(goal.get(k))]
        tags = [tag for flag, tag in (("power_play", "PPG"), ("short_handed", "SHG"),
                                      ("empty_net", "ENG"), ("penalty_shot", "PS"))
                if goal.get(flag) == "1"]
        text = f"{_person(scorer)} ({goal.get('scorer_goal_num') or '?'})"
        text += f", assists: {', '.join(helpers)}" if helpers else ", unassisted"
        plays.append({"type": {"text": "Goal"}, "scoringPlay": True, "text": text,
                      "period": {"number": _int(goal.get("period_id"))},
                      "clock": {"displayValue": clean(goal.get("time") or "")},
                      "team": {"id": str(goal.get("team_id"))},
                      "strength": {"abbreviation": "/".join(tags)},
                      "homeScore": running["home"], "awayScore": running["away"]})
    for pen in g.get("penalties") or []:
        who = _person(pen.get("player_penalized_info")) or "Bench"
        minutes = clean(pen.get("minutes_formatted") or str(pen.get("minutes") or ""))
        plays.append({"type": {"text": "Penalty"}, "penalty": True,
                      "text": f"{who} - {clean(pen.get('lang_penalty_description') or '')}",
                      "minutes": minutes.split(":")[0] if ":" in minutes else minutes,
                      "period": {"number": _int(pen.get("period_id"))},
                      "clock": {"displayValue": clean(pen.get("time_off_formatted") or "")},
                      "team": {"id": str(pen.get("team_id"))}})
    officials = [{"displayName": clean(re.sub(r"\s*\(\d+\)$", "", g.get(k) or ""))}
                 for k in ("referee1", "referee2", "linesman1", "linesman2") if g.get(k)]
    stars = []
    for mvp in g.get("mvps") or []:
        if not isinstance(mvp, dict) or not _person(mvp):
            continue
        side = "home" if mvp.get("home") in (1, "1") else "away"
        stars.append({"name": _person(mvp), "team": teams[side]})
    shots = g.get("shotsByPeriod") or {}
    return {
        "header": header,
        "boxscore": {"players": players, "teams": team_stats},
        "leaders": leaders,
        "plays": plays,
        "gameInfo": {"venue": {"fullName": clean(g.get("venue") or "")},
                     "attendance": _int(meta.get("attendance")) or None,
                     "officials": officials},
        "sportst": {"stars": stars,
                    "shots": {"home": shots.get("home") or {}, "away": shots.get("visitor") or {}}},
    }


def ahl_teams_by_id(timeout=15):
    season = ht_season("regular", timeout)
    data = ht_get({"feed": "modulekit", "view": "teamsbyseason",
                   "season_id": (season or {}).get("season_id", "")}, timeout)
    return {str(t.get("id")): t for t in dig(data, "SiteKit", "Teamsbyseason",
                                              default=[]) or []}


def ahl_teams(timeout=15):
    teams = []
    for row in ahl_teams_by_id(timeout).values():
        teams.append({"team": ht_team(row.get("id"), row.get("code"), row.get("name"),
                                      row.get("nickname"), row.get("city"))})
    return {"sports": [{"leagues": [{"teams": teams}]}]}


def ahl_standings(timeout=15):
    season = ht_season("regular", timeout)
    by_id = ahl_teams_by_id(timeout)
    data = ht_get({"feed": "statviewfeed", "view": "teams", "groupTeamsBy": "division",
                   "context": "overall", "site_id": "0",
                   "season": (season or {}).get("season_id", ""), "special": "false",
                   "league_id": "4", "division": "-1", "sort": "points"}, timeout)
    sections = dig(data, 0, "sections", default=[]) or []
    groups = {}
    order = []
    for section in sections:
        for index, item in enumerate(section.get("data") or []):
            row = item.get("row") or {}
            ident = str(dig(item, "prop", "name", "teamLink", default="") or "")
            info = by_id.get(ident, {})
            division = clean(info.get("division_long_name") or section.get("title")
                             or "AHL")
            clinch = ""
            match = re.match(r"^([a-z*]+)\s*-\s*", clean(row.get("name") or ""))
            if match:
                clinch = match.group(1)
            gf, ga = _int(row.get("goals_for")), _int(row.get("goals_against"))
            stat = [("gamesPlayed", row.get("games_played")), ("wins", row.get("wins")),
                    ("losses", row.get("losses")), ("otLosses", row.get("ot_losses")),
                    ("shootoutLosses", row.get("shootout_losses")),
                    ("points", row.get("points")), ("winPercent", row.get("percentage")),
                    ("regulationWins", row.get("regulation_wins")),
                    ("goalsFor", gf), ("goalsAgainst", ga),
                    ("differential", f"{gf - ga:+d}"), ("streak", row.get("streak")),
                    ("lastTen", row.get("past_10")), ("clincher", clinch),
                    ("penaltyMinutes", row.get("penalty_minutes")),
                    ("playoffSeed", row.get("rank") or index + 1)]
            if division not in groups:
                groups[division] = []
                order.append(division)
            groups[division].append({
                "team": ht_team(ident, info.get("code") or row.get("team_code"),
                                info.get("name") or row.get("name"),
                                info.get("nickname") or "", info.get("city") or ""),
                "stats": [{"name": k, "displayValue": clean(str(v if v is not None else ""))}
                          for k, v in stat]})
    for division in order:
        groups[division].sort(key=lambda e: _int(stat_display(stat_lookup(e),
                                                              ["playoffSeed"]), 99))
    return {"season": {"displayName": (season or {}).get("season_name", "")},
            "children": [{"name": d, "standings": {"entries": groups[d]}} for d in order]}


AHL_ROUNDS = ["1st Round", "Div Semifinals", "Div Finals", "Conf Finals",
              "Calder Cup Final"]


def ahl_bracket(timeout=15):
    season = ht_season("playoff", timeout)
    if not season:
        return {"rounds": []}
    data = ht_get({"feed": "modulekit", "view": "brackets",
                   "season_id": season.get("season_id")}, timeout)
