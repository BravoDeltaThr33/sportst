# -- a curses of sportst's own, for Windows (7.0.0) -------------------------
#
# Python on Windows comes without the curses module, and sportst uses nothing
# outside the standard library. So where `import curses` fails, this stands
# in for it: the part of curses sportst uses and no more - a screen of cells
# with attributes and 256 colour pairs (true colour where init_color sets a
# colour), keys, the mouse and resizes - written to the terminal in VT
# escape codes, which Windows 10's console and Windows Terminal read (as does
# every terminal elsewhere; SPORTST_CURSES=vt tries it on Linux or macOS).
# Keys and the mouse come from the console's own input records on Windows,
# from the terminal's escape codes elsewhere.

def _vt_curses_module():
    import types
    import unicodedata

    mod = types.ModuleType("curses")
    mod.__doc__ = "sportst's VT stand-in for curses (7.0.0)"

    class error(Exception):
        pass

    mod.error = error
    mod.A_NORMAL, mod.A_ATTRIBUTES, mod.A_CHARTEXT = 0, ~0xFF, 0xFF
    mod.A_COLOR = 0xFF00
    mod.A_STANDOUT, mod.A_UNDERLINE, mod.A_REVERSE = 1 << 16, 1 << 17, 1 << 18
    mod.A_BLINK, mod.A_DIM, mod.A_BOLD = 1 << 19, 1 << 20, 1 << 21
    mod.A_INVIS, mod.A_PROTECT, mod.A_ITALIC = 1 << 23, 1 << 24, 1 << 31
    for number, name in enumerate(("BLACK", "RED", "GREEN", "YELLOW", "BLUE", "MAGENTA",
                                   "CYAN", "WHITE")):
        setattr(mod, "COLOR_" + name, number)
    keys = {"KEY_DOWN": 258, "KEY_UP": 259, "KEY_LEFT": 260, "KEY_RIGHT": 261,
            "KEY_HOME": 262, "KEY_BACKSPACE": 263, "KEY_F0": 264, "KEY_DC": 330,
            "KEY_IC": 331, "KEY_NPAGE": 338, "KEY_PPAGE": 339, "KEY_ENTER": 343,
            "KEY_BTAB": 353, "KEY_END": 360, "KEY_MOUSE": 409, "KEY_RESIZE": 410}
    for name, code in keys.items():
        setattr(mod, name, code)
    for n in range(1, 13):
        setattr(mod, f"KEY_F{n}", 264 + n)
    for button in range(1, 6):
        shift = (button - 1) * 5
        for offset, event in enumerate(("RELEASED", "PRESSED", "CLICKED", "DOUBLE_CLICKED",
                                        "TRIPLE_CLICKED")):
            setattr(mod, f"BUTTON{button}_{event}", 1 << (shift + offset))
    mod.REPORT_MOUSE_POSITION = 1 << 27
    mod.ALL_MOUSE_EVENTS = mod.REPORT_MOUSE_POSITION - 1
    mod.COLORS, mod.COLOR_PAIRS = 8, 64
    mod.LINES, mod.COLS = 24, 80
    windows = os.name == "nt"
    state = {"colours": {}, "pairs": {}, "mouse": 0, "interval": 0.2, "events": [],
             "term": None}

    def width_of(ch):
        if unicodedata.combining(ch) or ch in "​‍️":
            return 0
        return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1

    def colour_code(index, base):
        """SGR parameters for colour `index` as foreground (base 30) or
        background (40): the default, a colour init_color set (true colour),
        the 16 ANSI colours, the 256-colour palette."""
        if index is None or index < 0:
            return str(base + 9)
        rgb = state["colours"].get(index)
        if rgb is not None:
            r, g, b = (max(0, min(255, round(c * 255 / 1000))) for c in rgb)
            return f"{base + 8};2;{r};{g};{b}"
        if index < 8:
            return str(base + index)
        if index < 16:
            return str(base + 60 + index - 8)
        return f"{base + 8};5;{index}"

    sgr_cache = {}

    def sgr(attr):
        found = sgr_cache.get(attr)
        if found is not None:
            return found
        fg, bg = state["pairs"].get((attr & mod.A_COLOR) >> 8, (-1, -1))
        parts = ["0", colour_code(fg, 30), colour_code(bg, 40)]
        for flag, code in ((mod.A_BOLD, "1"), (mod.A_DIM, "2"), (mod.A_ITALIC, "3"),
                           (mod.A_UNDERLINE, "4"), (mod.A_BLINK, "5"),
                           (mod.A_REVERSE | mod.A_STANDOUT, "7"), (mod.A_INVIS, "8")):
            if attr & flag:
                parts.append(code)
        found = sgr_cache[attr] = "\x1b[" + ";".join(parts) + "m"
        return found

    class Console:
        """The terminal: its cells as the program drew them, as last sent,
        and its keyboard and mouse."""

        def __init__(self):
            self.fd_out = sys.stdout.fileno()
            self.rows, self.cols = self.size()
            self.cells = self.blank_grid()
            self.shown = None
            self.queue = []
            self.press = None
            self.last_click = (0.0, -1, -1)
            self.saved = None
            self.buffer = ""
            self.escdelay = max(0.0, int(os.environ.get("ESCDELAY", "25") or 25) / 1000)
            self.winch = False

        def size(self):
            try:
                cols, rows = os.get_terminal_size(self.fd_out)
            except OSError:
                cols, rows = 80, 24
            return max(1, rows), max(1, cols)

        def blank_grid(self, attr=0):
            return [[" ", attr] for _ in range(self.cols * self.rows)]

        def write(self, text):
            data = text.encode("utf-8", "replace")
            while data:
                try:
                    done = os.write(self.fd_out, data)
                except InterruptedError:
                    continue
                except BlockingIOError:
                    time.sleep(0.005)
                    continue
                data = data[done:]

        # -- the screen --------------------------------------------------

        def put(self, y, x, text, attr):
            if not (0 <= y < self.rows and 0 <= x < self.cols):
                raise error("addstr out of the window")
            row = y * self.cols
            col = x
            for ch in str(text):
                wide = width_of(ch)
                if wide == 0:
                    if col > x:
                        self.cells[row + col - 1][0] += ch
                    continue
                if ch in "\n\r":
                    break
                if col + wide > self.cols:
                    raise error("addstr past the right edge")
                cell = self.cells[row + col]
                cell[0], cell[1] = ch, attr
                if wide == 2:
                    cell = self.cells[row + col + 1]
                    cell[0], cell[1] = "", attr
                col += wide

        def insert(self, y, x, text, attr):
            if not (0 <= y < self.rows and 0 <= x < self.cols):
                raise error("insstr out of the window")
            row = y * self.cols
            line = self.cells[row:row + self.cols]
            shift = len(text)
            new = [[ch, attr] for ch in text] + line[x:]
            self.cells[row + x:row + self.cols] = new[:self.cols - x]

        def erase(self, attr):
            for cell in self.cells:
                cell[0], cell[1] = " ", attr

        def flush(self):
            out = []
            if self.shown is None or len(self.shown) != len(self.cells):
                out.append("\x1b[0m\x1b[H\x1b[2J")
                self.shown = [[None, None] for _ in self.cells]
            current = None
            cols = self.cols
            for y in range(self.rows):
                base = y * cols
                first = last = None
                for x in range(cols):
                    a, b = self.cells[base + x], self.shown[base + x]
                    if a[0] != b[0] or a[1] != b[1]:
                        if first is None:
                            first = x
                        last = x
                if first is None:
                    continue
                while first > 0 and self.cells[base + first][0] == "":
                    first -= 1
                out.append(f"\x1b[{y + 1};{first + 1}H")
                for x in range(first, last + 1):
                    ch, attr = self.cells[base + x]
                    shown = self.shown[base + x]
                    shown[0], shown[1] = ch, attr
                    if ch == "":
                        continue
                    if attr != current:
                        out.append(sgr(attr))
                        current = attr
                    out.append(ch)
            if out:
                out.append("\x1b[0m")
                self.write("".join(out))

        # -- keys and the mouse ----------------------------------------------

        def resized(self):
            rows, cols = self.size()
            if (rows, cols) == (self.rows, self.cols):
                return False
            self.rows, self.cols = rows, cols
            mod.LINES, mod.COLS = rows, cols
            self.cells = self.blank_grid()
            self.shown = None
            return True

        def mouse_event(self, x, y, bstate):
            state["events"].append((0, x, y, 0, bstate))
            del state["events"][:-32]
            self.queue.append(mod.KEY_MOUSE)

        def click(self, x, y):
            """A left button let go where it was pressed: a click, or the second
            of a double click."""
            now = time.monotonic()
            then, cx, cy = self.last_click
            wanted = state["mouse"]
            if now - then <= max(0.3, state["interval"]) and (cx, cy) == (x, y) and \
                    wanted & mod.BUTTON1_DOUBLE_CLICKED:
                self.last_click = (0.0, -1, -1)
                self.mouse_event(x, y, mod.BUTTON1_DOUBLE_CLICKED)
            elif wanted & mod.BUTTON1_CLICKED:
                self.last_click = (now, x, y)
                self.mouse_event(x, y, mod.BUTTON1_CLICKED)

        def getch(self, timeout_ms):
            if self.winch or self.resized():
                self.winch = False
                return mod.KEY_RESIZE
            if self.queue:
                return self.queue.pop(0)
            deadline = None if timeout_ms is None or timeout_ms < 0 else \
                time.monotonic() + timeout_ms / 1000
            while True:
                wait = None if deadline is None else max(0.0, deadline - time.monotonic())
                if deadline is None:
                    wait = 0.25          # a resize is noticed within a quarter second
                self.read_input(wait)
                if self.queue:
                    return self.queue.pop(0)
                if self.resized():
                    return mod.KEY_RESIZE
                if deadline is not None and time.monotonic() >= deadline:
                    return -1

        def parse(self, final=False):
            """Turn the escape codes and characters read into keys."""
            buf = self.buffer
            while buf:
                ch = buf[0]
                if ch != "\x1b":
                    buf = buf[1:]
                    if ch == "\r":
                        self.queue.append(10)
                    elif ch == "\x7f":
                        self.queue.append(mod.KEY_BACKSPACE)
                    else:
                        self.queue.append(ord(ch))
                    continue
                if len(buf) == 1:
                    if final:
                        self.queue.append(27)
                        buf = ""
                    break
                if buf[1] == "[":
                    end = 2
                    while end < len(buf) and not ("\x40" <= buf[end] <= "\x7e"):
                        end += 1
                    if end >= len(buf):
                        if final:
                            self.queue.append(27)
                            buf = buf[1:]
                            continue
                        break
                    params, last = buf[2:end], buf[end]
                    buf = buf[end + 1:]
                    self.csi(params, last)
                    continue
                if buf[1] == "O":
                    if len(buf) < 3:
                        if final:
                            self.queue.append(27)
                            buf = buf[1:]
                            continue
                        break
                    code = {"A": mod.KEY_UP, "B": mod.KEY_DOWN, "C": mod.KEY_RIGHT,
                            "D": mod.KEY_LEFT, "H": mod.KEY_HOME, "F": mod.KEY_END,
                            "M": 10}.get(buf[2])
                    buf = buf[3:]
                    if code is not None:
                        self.queue.append(code)
                    continue
                self.queue.append(27)        # escape, then the key after it
                buf = buf[1:]
            self.buffer = buf

        def csi(self, params, last):
            if params.startswith("<") and last in "Mm":
                try:
                    button, x, y = (int(p) for p in params[1:].split(";")[:3])
                except ValueError:
                    return
                x, y = x - 1, y - 1
                if button & 64:
                    wheel = mod.BUTTON5_PRESSED if button & 1 else mod.BUTTON4_PRESSED
                    if last == "M" and state["mouse"] & wheel:
                        self.mouse_event(x, y, wheel)
                elif button & 3 == 0 and not button & 32:
                    if last == "M":
                        self.press = (x, y)
                    elif self.press is not None:
                        self.press = None
                        self.click(x, y)
                return
            number = params.split(";")[0] if params else ""
            if last == "~":
                code = {"1": mod.KEY_HOME, "7": mod.KEY_HOME, "4": mod.KEY_END,
                        "8": mod.KEY_END, "5": mod.KEY_PPAGE, "6": mod.KEY_NPAGE,
                        "3": mod.KEY_DC, "2": mod.KEY_IC}.get(number)
            else:
                code = {"A": mod.KEY_UP, "B": mod.KEY_DOWN, "C": mod.KEY_RIGHT,
                        "D": mod.KEY_LEFT, "H": mod.KEY_HOME, "F": mod.KEY_END,
                        "Z": mod.KEY_BTAB}.get(last)
            if code is not None:
                self.queue.append(code)

    class PosixConsole(Console):
        """The keyboard as the terminal's bytes, the mouse as SGR reports."""

        def start(self):
            import signal
            import termios
            self.fd_in = sys.stdin.fileno()
            self.saved = termios.tcgetattr(self.fd_in)
            mode = termios.tcgetattr(self.fd_in)
            mode[0] &= ~(termios.ICRNL | termios.IXON)
            mode[3] &= ~(termios.ICANON | termios.ECHO)
            mode[6][termios.VMIN], mode[6][termios.VTIME] = 1, 0
            termios.tcsetattr(self.fd_in, termios.TCSANOW, mode)
            self.decoder = __import__("codecs").getincrementaldecoder("utf-8")("replace")
            try:
                signal.signal(signal.SIGWINCH, lambda *_: setattr(self, "winch", True))
            except (AttributeError, ValueError):
                pass

        def stop(self):
            import termios
            if self.saved is not None:
                termios.tcsetattr(self.fd_in, termios.TCSANOW, self.saved)

        def read_input(self, wait):
            import select
            try:
                ready, _, _ = select.select([self.fd_in], [], [], wait)
            except InterruptedError:
                return
            if not ready:
                if self.buffer:
                    self.parse(final=True)
                return
            data = os.read(self.fd_in, 4096)
            self.buffer += self.decoder.decode(data)
            self.parse()
            if self.buffer.startswith("\x1b") and not self.queue:
                ready, _, _ = select.select([self.fd_in], [], [], self.escdelay)
                if ready:
                    self.buffer += self.decoder.decode(os.read(self.fd_in, 4096))
                    self.parse()
                self.parse(final=True)

        def mouse(self, on):
            self.write("\x1b[?1000h\x1b[?1006h" if on else "\x1b[?1000l\x1b[?1006l")

    class WindowsConsole(Console):
        """The keyboard and mouse as the console's input records (no escape
        codes to take apart); the screen in VT codes, switched on here."""

        VK = {0x26: "KEY_UP", 0x28: "KEY_DOWN", 0x25: "KEY_LEFT", 0x27: "KEY_RIGHT",
              0x24: "KEY_HOME", 0x23: "KEY_END", 0x21: "KEY_PPAGE", 0x22: "KEY_NPAGE",
              0x2E: "KEY_DC", 0x2D: "KEY_IC"}

        def start(self):
            import ctypes
            from ctypes import wintypes
            self.ctypes, self.wintypes = ctypes, wintypes
            k32 = self.k32 = ctypes.WinDLL("kernel32", use_last_error=True)
            self.h_in, self.h_out = k32.GetStdHandle(-10), k32.GetStdHandle(-11)
            self.modes = []
            for handle in (self.h_in, self.h_out):
                mode = wintypes.DWORD()
                k32.GetConsoleMode(handle, ctypes.byref(mode))
                self.modes.append(mode.value)
            # output: VT codes on (4), no auto return (8); input: window size
            # (8) and mouse (0x10) records, quick edit off (0x80 alone)
            k32.SetConsoleMode(self.h_out, self.modes[1] | 0x0001 | 0x0004 | 0x0008)
            k32.SetConsoleMode(self.h_in, 0x0008 | 0x0010 | 0x0080)
            self.code_pages = (k32.GetConsoleCP(), k32.GetConsoleOutputCP())
            k32.SetConsoleCP(65001)
            k32.SetConsoleOutputCP(65001)

            class COORD(ctypes.Structure):
                _fields_ = [("X", ctypes.c_short), ("Y", ctypes.c_short)]

            class KEY(ctypes.Structure):
                _fields_ = [("down", wintypes.BOOL), ("repeat", wintypes.WORD),
                            ("vk", wintypes.WORD), ("scan", wintypes.WORD),
                            ("char", wintypes.WCHAR), ("control", wintypes.DWORD)]

            class MOUSE(ctypes.Structure):
                _fields_ = [("pos", COORD), ("buttons", wintypes.DWORD),
                            ("control", wintypes.DWORD), ("flags", wintypes.DWORD)]

            class EVENT(ctypes.Union):
                _fields_ = [("key", KEY), ("mouse", MOUSE), ("size", COORD)]

            class RECORD(ctypes.Structure):
                _fields_ = [("type", wintypes.WORD), ("event", EVENT)]

            self.RECORD = RECORD
            self.records = (RECORD * 64)()
            self.buttons = 0

        def stop(self):
            if getattr(self, "k32", None):
                self.k32.SetConsoleMode(self.h_in, self.modes[0])
                self.k32.SetConsoleMode(self.h_out, self.modes[1])
                self.k32.SetConsoleCP(self.code_pages[0])
                self.k32.SetConsoleOutputCP(self.code_pages[1])

        def read_input(self, wait):
            ctypes, wintypes = self.ctypes, self.wintypes
            millis = 0xFFFFFFFF if wait is None else int(wait * 1000)
            if self.k32.WaitForSingleObject(self.h_in, millis) != 0:
                return
            count = wintypes.DWORD()
            if not self.k32.ReadConsoleInputW(self.h_in, self.records, 64,
                                              ctypes.byref(count)):
                return
            for record in self.records[:count.value]:
                if record.type == 0x0001:
                    self.key(record.event.key)
                elif record.type == 0x0002:
                    self.mouse_record(record.event.mouse)
                elif record.type == 0x0004:
                    self.winch = True

        def key(self, event):
            if not event.down:
                return
            shift = event.control & 0x0010
            name = self.VK.get(event.vk)
            for _ in range(max(1, event.repeat)):
                if name:
                    self.queue.append(getattr(mod, name))
                elif event.vk == 0x09 and shift:
                    self.queue.append(mod.KEY_BTAB)
                elif event.vk == 0x0D:
                    self.queue.append(10)
                elif event.vk == 0x08:
                    self.queue.append(mod.KEY_BACKSPACE)
                elif 0x70 <= event.vk <= 0x7B:
                    self.queue.append(getattr(mod, f"KEY_F{event.vk - 0x6F}"))
                elif event.char and event.char != "\x00":
                    self.queue.append(ord(event.char))

        def mouse_record(self, event):
            x, y, flags = event.pos.X, event.pos.Y, event.flags
            if flags & 0x0004:                           # the wheel
                notch = (event.buttons >> 16) & 0xFFFF
                wheel = mod.BUTTON5_PRESSED if notch & 0x8000 else mod.BUTTON4_PRESSED
                if state["mouse"] & wheel:
                    self.mouse_event(x, y, wheel)
                return
            if flags & 0x0001:                           # moved
                return
            left = event.buttons & 0x0001
            if left and not self.buttons & 0x0001:
                self.press = (x, y)
            elif not left and self.buttons & 0x0001 and self.press is not None:
                self.press = None
                self.click(x, y)
            self.buttons = event.buttons

        def mouse(self, on):
            pass                     # the input records carry it, mode set in start()

    class Window:
        def __init__(self, console):
            self.console = console
            self.delay = -1
            self.background = 0

        def getmaxyx(self):
            return self.console.rows, self.console.cols

        def getyx(self):
            return 0, 0

        def _args(self, args):
            if len(args) >= 3 and isinstance(args[0], int):
                y, x, text = args[:3]
                attr = args[3] if len(args) > 3 else 0
            else:
                raise error("sportst's curses wants y, x, text")
            if not attr & mod.A_COLOR:
                attr |= self.background & mod.A_COLOR
            return y, x, text, attr

        def addstr(self, *args):
            y, x, text, attr = self._args(args)
            self.console.put(y, x, text, attr)

        addnstr = addstr

        def insstr(self, *args):
            y, x, text, attr = self._args(args)
            self.console.insert(y, x, text, attr)

        def move(self, y, x):
            if not (0 <= y < self.console.rows and 0 <= x < self.console.cols):
                raise error("move out of the window")

        def erase(self):
            self.console.erase(self.background)

        def clear(self):
            self.erase()
            self.console.shown = None

        def clearok(self, flag):
            if flag:
                self.console.shown = None

        def bkgd(self, ch, attr=0):
            if isinstance(ch, int) and not attr:
                attr = ch & ~0xFF
            self.background = attr
            self.console.erase(attr)

        def timeout(self, delay):
            self.delay = delay

        def nodelay(self, flag):
            self.delay = 0 if flag else -1

        def getch(self, *args):
            return self.console.getch(self.delay)

        def noutrefresh(self):
            pass

        def refresh(self):
            self.console.flush()

        def keypad(self, *args):
            pass

        leaveok = scrollok = idlok = immedok = keypad

    def start_terminal():
        console = (WindowsConsole if windows else PosixConsole)()
        console.start()
        state["term"] = console
        mod.LINES, mod.COLS = console.rows, console.cols
        # the other screen, no cursor, no wrapping at the right edge
        console.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[H\x1b[2J")
        return Window(console)

    def stop_terminal():
        console = state.get("term")
        if console is None:
            return
        try:
            console.mouse(False)
            console.write("\x1b[0m\x1b[?7h\x1b[?25h\x1b[?1049l")
        finally:
            console.stop()
            state["term"] = None

    def initscr():
        return start_terminal()

    def endwin():
        stop_terminal()

    def wrapper(func, *args, **kwds):
        stdscr = None
        try:
            stdscr = start_terminal()
            return func(stdscr, *args, **kwds)
        finally:
            if stdscr is not None:
                stop_terminal()

    def start_color():
        mod.COLORS, mod.COLOR_PAIRS = 256, 256

    def has_colors():
        return True

    def can_change_color():
        return True

    def init_color(index, r, g, b):
        state["colours"][index] = (r, g, b)
        sgr_cache.clear()

    def color_content(index):
        return state["colours"].get(index, (0, 0, 0))

    def init_pair(number, fg, bg):
        if not 0 < number < mod.COLOR_PAIRS:
            raise error("pair number out of range")
        state["pairs"][number] = (fg, bg)
        sgr_cache.clear()

    def pair_content(number):
        return state["pairs"].get(number, (-1, -1))

    def pair_number(attr):
        return (attr & mod.A_COLOR) >> 8

    def color_pair(number):
        return (number << 8) & mod.A_COLOR

    def curs_set(visible):
        console = state.get("term")
        if console is not None:
            console.write("\x1b[?25h" if visible else "\x1b[?25l")
        return 0

    def beep():
        console = state.get("term")
        if console is not None:
            console.write("\a")

    def doupdate():
        console = state.get("term")
        if console is not None:
            console.flush()

    def mousemask(mask):
        state["mouse"] = mask
        console = state.get("term")
        if console is not None:
            console.mouse(bool(mask))
        return mask, 0

    def mouseinterval(millis):
        state["interval"] = max(0, millis) / 1000

    def getmouse():
        if not state["events"]:
            raise error("no mouse event")
        return state["events"].pop(0)

    def napms(millis):
        time.sleep(millis / 1000)

    def noop(*args, **kwds):
        return None

    for function in (initscr, endwin, wrapper, start_color, has_colors, can_change_color,
                     init_color, color_content, init_pair, pair_content, pair_number,
                     color_pair, curs_set, beep, doupdate, mousemask, mouseinterval,
                     getmouse, napms):
        setattr(mod, function.__name__, function)
    for name in ("use_default_colors", "noecho", "echo", "cbreak", "nocbreak", "raw",
                 "noraw", "nonl", "nl", "flushinp", "set_escdelay"):
        setattr(mod, name, noop)
    mod.consoles = (PosixConsole, WindowsConsole)     # for the tests
    return mod


