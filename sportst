def kim_original(frame="open"):
    """The original portrait's rows for one mouth: 'closed' brings the lips
    together, 'mid' shows only the teeth."""
    import base64
    import zlib
    rows = [list(r) for r in zlib.decompress(base64.b64decode("".join(KIM_ORIGINAL)))
            .decode("ascii").split("\n")]
    if frame != "open":
        for y in range(84, 91):
            for x in range(31, 62):
                if rows[y][x] not in "kwg":
                    continue
                if frame == "closed":
                    rows[y][x] = {84: "r", 85: "r", 86: "b", 87: "b", 88: "r", 89: "p",
                                  90: "p"}[y]
                elif y in (84, 85):
                    rows[y][x] = "r"
                elif y in (89, 90):
                    rows[y][x] = "p" if y == 90 else "r"
    return ["".join(r) for r in rows]
