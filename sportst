def college_group_order(entries, league):
    """A conference's teams in standing order, as render_standings draws
    them: ESPN's own for football; by conference record, then overall, for
    basketball, which ESPN sends in no useful order."""
    if like(league) != "cbb":
        return list(entries)

    def pct(text):
        found = re.match(r"(\d+)-(\d+)", text or "")
        if not found:
            return 0.0
        wins, losses = int(found.group(1)), int(found.group(2))
        return wins / (wins + losses) if wins + losses else 0.0

    def key(entry):
        table = stat_lookup(entry)
        try:
            overall = float(stat_display(table, ["winPercent"]))
        except ValueError:
            overall = 0.0
        return (-pct(stat_display(table, ["vs. Conf.", "vsconf"])), -overall)
    return sorted(entries, key=key)


def standings_game_line(event, league, width):
    """One game in the college standings' conference box (6.22.0): the two
    teams in their colours (the winner bold), the score, and the kickoff,
    the clock or Final."""
    state = event.get("state")
    line = Line()
    for index, team in enumerate((event["away"], event["home"])):
        if index:
            line.add(" @ ", "dim")
        won = state == "post" and bool(team.get("winner"))
        line.add(f"{(team.get('abbr') or '?')[:5]:<5}",
                 THEME.style(league, team, bold=won, fallback="normal"))
        score = team.get("score")
        line.add(f"{score if state in ('in', 'post') and score is not None else '':>3}",
                 "bold" if won else "normal")
    line.add("  ", "normal")
    if state == "pre":
        when = parse_iso(event.get("date") or "")
        if event.get("time_tba") or not when:
            line.add("TBA", "muted")
        else:
            local = when.astimezone()
            line.add(f"{local:%a} {strf(local, '%-I:%M')}"
                     f"{'a' if local.hour < 12 else 'p'}", "muted")
    elif state == "in":
        line.add(clean(event.get("detail") or "live"), "live")
    else:
        line.add(clean(event.get("detail") or "Final"), "dim")
    return fit_line(line, width)


def college_table_box(data, league, full, favorites, chosen, logo_gap, ranks, by_id,
                      inner):
    """The college standings' table for the conference `full` in a box
    `inner` wide (6.22.0): as many of COLLEGE_TABLE_COLUMNS as fit, the
    poll's ranks, a bar of each team's margin a game in the room left.
    (body lines, spots, title); the spots' rows count the box's top edge."""
    columns = list(COLLEGE_TABLE_COLUMNS.get(league) or standings_columns(league))

    def table(cols, room):
        spots_ = []
        out = render_standings(data, league, room, favorites, GROUP_ALIASES.get(full, full),
                               "", selected=chosen, spots=spots_, logo_gap=logo_gap,
                               columns=cols, poll_ranks=ranks)
        return out, spots_
    lines_t, spots = table(columns, 999)
    while True:
        natural = max((len(line.text) for line in lines_t[1:]), default=0)
        drop = next((name for name in COLLEGE_TABLE_DROP
                     if any(label == name for label, _ in columns)), None)
        if natural <= inner or drop is None:
            break
        columns = [c for c in columns if c[0] != drop]
        lines_t, spots = table(columns, 999)
    lines_t, spots = table(columns, inner)
    body = [Line(list(line)) for line in lines_t[1:]]
    natural = max((len(line.text) for line in body), default=0)
    bar_w = min(24, inner - natural - 3)
    diffs = {str(s["team"]["id"]): (by_id.get(str(s["team"]["id"])) or {}).get("diff")
             for s in spots}
    top = max([abs(d) for d in diffs.values() if d is not None] or [0.0])
    if bar_w >= 8 and top and body:
        body[0] = body[0].pad(natural).add("   ").add("margin"[:bar_w], "header")
        for spot in spots:
            at = spot["row"] - 1
            diff = diffs.get(str(spot["team"]["id"]))
            if 0 <= at < len(body) and diff is not None:
                line = body[at].pad(natural, "normal").add("   ")
                line.extend_spans(meter_spans(abs(diff) / top, bar_w,
                                              "good" if diff >= 0 else "bad"))
                body[at] = line
    title = f"{full} · {len(spots)} teams" if spots else full
    return body, spots, title


def college_game_lines(games, league, width, room, title, full):
    """The scoreboard's games for a conference's teams in `room` rows (a
    blank line and a heading first), as many columns across `width` as fit
    (6.22.0); [] when there are none or no room."""
    if not games or room < 3:
        return []
    cell_w, gap = 32, 3
    per_row = max(1, (width + gap) // (cell_w + gap))
    fit = per_row * (room - 2)
    shown = games if len(games) <= fit else games[:max(0, fit - 1)]
    cells = [standings_game_line(e, league, cell_w) for e in shown]
    if len(shown) < len(games):
        cells.append(Line().add(f"+ {len(games) - len(shown)} more on the Scoreboard",
                                "muted"))
    depth = -(-len(cells) // per_row)
    blocks = [cells[at:at + depth] for at in range(0, len(cells), depth)]
    head = Line().add(title or "Games", "accent").add(
        f"  {len(games)} game{'s' if len(games) != 1 else ''} with "
        f"{short_group(full)} teams", "muted")
    return [blank(), head] + side_by_side(blocks, width, gap=gap)


def college_standings_view(data, league, width, favorites, chosen, poll=None,
                           corners=("╭", "╮", "╰", "╯"), logo_gap=0, rows=None,
                           games=None, games_title=""):
    """College standings on one screen, a grid of boxes (6.22.0; 6.21.0 had the
    first cut): on the left every conference - the picked one lit, its
    leader, the conference's average margin a game - over the poll (or the
    poll in a column of its own on the right when the two do not fit one
    over the other in `rows`); beside them the picked conference's table in
    a box of its own (the poll's ranks, home and away, vs. ranked teams,
    a margin bar; the scoreboard's `games` for its teams in the spare rows,
    under `games_title`) over Hot and cold. Every column the same height.
    The picked team decides the conference. (lines, spots, picks, order):
    spots the table's team rows, picks each conference's row in the list
    (row, x, width, its first team's id), order every team as j / k walk
    them, conference by conference, with its conference's number. None when
    there are too few conferences to need it."""
    if not isinstance(data, dict):
        return None
    root = dig(data, "content", "standings", default=data) if "content" in data else data
    groups = []
    walk_standings(root, [], groups)
    if len(groups) < 9:
        return None
    teams = basketball_table(data, league)
    by_id = {str(t["team"].get("id")): t for t in teams}
    records = {ident: f"{t['w']}-{t['l']}" for ident, t in by_id.items()}
    order, firsts, leaders, members_of = [], [], [], []
    for number, (title, entries) in enumerate(groups):
        members = [m for m in (entry_team(e) for e in college_group_order(entries, league))
                   if m.get("id")]
        firsts.append(str(members[0]["id"]) if members else "")
        leaders.append(members[0] if members else {})
        members_of.append({str(m["id"]) for m in members})
        order.extend((m, number) for m in members)
    picked = next((n for m, n in order if str(m.get("id")) == str(chosen)), 0)
    full_names = [title.split(" — ")[-1] for title, _ in groups]
    names = [short_group(name) for name in full_names]
    division = groups[0][0].split(" — ")[0] if " — " in groups[0][0] else ""

    # each conference's average margin a game: how strong it has been (by its
    # members, so a conference split in two divisions gets each its own)
    margins = []
    for ids in members_of:
        total = played = 0
        for ident in ids:
            entry = by_id.get(ident)
            if entry and entry["diff"] is not None and entry["gp"]:
                total += entry["diff"] * entry["gp"]
                played += entry["gp"]
        margins.append(total / played if played else None)
    top_margin = max([abs(m) for m in margins if m is not None] or [1.0]) or 1.0

    # the conference list
    name_w = min(16, max(len(n) for n in names))
    list_inner = 1 + name_w + 1 + 5 + 1 + 5 + 2 + 5 + 1 + 4
    list_w = list_inner + 4
    listing_body = []
    for number, name in enumerate(names):
        mine = number == picked
        base = "sel" if mine else "normal"
        lead = leaders[number]
        line = Line().add("▌" if mine else " ", "selbar" if mine else "normal")
        line.add(f"{name[:name_w]:<{name_w}} ", base)
        line.add(f"{(lead.get('abbr') or '')[:5]:<5} ",
                 base if mine else THEME.style(league, lead, fallback="dim"))
        line.add(f"{records.get(str(lead.get('id')), ''):>5}", base if mine else "dim")
        margin = margins[number]
        if margin is not None:
            tone = "good" if margin >= 0 else "bad"
            line.add(f"  {margin:+5.1f} ", base if mine else tone)
            line.extend_spans(meter_spans(abs(margin) / top_margin, 4,
                                          "sel" if mine else tone))
        listing_body.append(line.pad(list_inner, base))
    listing_title = f"Conferences · {len(groups)} · leader · margin"
    if len(listing_title) > list_w - 6:
        listing_title = f"Conferences · {len(groups)}"

    # the poll: its box, and the ranks for the table
    poll_title, poll_body, ranks = "", [], {}
    if poll:
        poll_name, poll_when, ranked = poll_rows(poll)
        if ranked:
            ranks = {str(row[2].get("id")): row[0] for row in ranked}
            poll_body = poll_pane_lines(poll, league, COLLEGE_POLL_W - 4, favorites, records)
            if poll_when and poll_body and poll_body[0].text.strip() == \
                    poll_when[:COLLEGE_POLL_W - 4].strip():
                poll_body = poll_body[1:]
                poll_title = f"{poll_name} · {poll_when}"
            if not poll_title or len(poll_title) > COLLEGE_POLL_W - 6:
                poll_title = poll_name

    full = full_names[picked]

    # the ranked teams by conference, under the poll
    ranked_rows = []
    if ranks:
        counted = []
        for number, ids in enumerate(members_of):
            here = sorted((ranks[i], i) for i in ids if i in ranks)
            if here:
                counted.append((len(here), here[0][0], number, here[0][1]))
        counted.sort(key=lambda row: (-row[0], row[1]))
        most = max((row[0] for row in counted), default=1)
        for count, best, number, ident in counted:
            team = next((m for m, n in order if str(m.get("id")) == ident), {})
            line = Line().add(f"{names[number][:16]:<17}", "normal")
            line.add(f"{count:>2} ", "bold")
            line.extend_spans(meter_spans(count / most, 8, "accent"))
            line.add(f"  #{best} ", "dim").add((team.get("abbr") or "")[:5],
                                              THEME.style(league, team, fallback="dim"))
            ranked_rows.append(line)

    # the layout: the poll (and the ranked teams) in a column on the right
    # when there is room; the list and the table side by side, Hot and cold
    # under both (a short list, football's) or under the table only (a long
    # one, basketball's); every column as tall as the tallest, the table's
    # box taking the slack for its games
    poll_col = bool(poll_body) and \
        width >= list_w + 2 + COLLEGE_MAIN_MIN + 2 + COLLEGE_POLL_W
    ab_w = width - (COLLEGE_POLL_W + 2 if poll_col else 0)
    stacked = ab_w - list_w - 2 < COLLEGE_MAIN_MIN
    b_w = ab_w if stacked else ab_w - list_w - 2
    table_inner = b_w - 4
    table_body, spots, table_title = college_table_box(
        data, league, full, favorites, chosen, logo_gap, ranks, by_id, table_inner)
    ours = sorted((e for e in games or [] if isinstance(e, dict) and e.get("away") and
                   e.get("home") and (str(e["away"].get("id")) in members_of[picked] or
                                      str(e["home"].get("id")) in members_of[picked])),
                  key=lambda e: e.get("date") or "")

    def game_lines(room):
        return college_game_lines(ours, league, table_inner, room, games_title, full)

    def hot(inner):
        if len(teams) < 10:
            return []
        for count in (3, 2, 1):
            block_w = min(46, (inner - 2 * (count - 1)) // count)
            if block_w >= 26:
                blocks = bball_hot_cold_blocks(teams, league, block_w)[:count]
                return side_by_side(blocks, inner, gap=2) if blocks else []
        return []
    hot_title = f"Hot and cold · all of {division}" if division else "Hot and cold"
    note = wrap_spans("margin: how many points a game the conference's teams win or "
                      "lose by, on average", list_inner, "muted")
    list_h, table_h = len(listing_body) + 2, len(table_body) + 2
    games_h = len(game_lines(10 ** 6))
    big = rows or 10 ** 6
    short = list_h + 16 <= (rows or 40)

    def list_box(height):
        body = list(listing_body)
        if height - 2 - len(body) >= len(note) + 1:
            body += [blank()] + note
        return framed(listing_title, body + [Line()] * max(0, height - 2 - len(body)),
                      list_w, corners)

    def table_box(height):
        room = height - 2 - len(table_body)
        body = table_body + game_lines(room)
        body += [Line()] * max(0, height - 2 - len(body))
        return framed(table_title, body, b_w, corners)

    def poll_column(height):
        out = framed(poll_title, poll_body, COLLEGE_POLL_W, corners)
        spare = height - len(out) - 1 - 2
        if ranked_rows and spare >= 3:
            shown = ranked_rows[:spare]
            out += [blank()] + framed("Ranked teams by conference",
                                      shown + [Line()] * (spare - len(shown)),
                                      COLLEGE_POLL_W, corners)
        elif height > len(out):
            out = framed(poll_title, poll_body + [Line()] * (height - len(out)),
                         COLLEGE_POLL_W, corners)
        return out

    poll_h = len(poll_body) + 2 if poll_body else 0
    if stacked:
        hot_body = hot(b_w - 4)
        lines = list_box(list_h) + [blank()]
        table_top = len(lines)
        lines += table_box(table_h + games_h)
        if hot_body:
            lines += [blank()] + framed(hot_title, hot_body, b_w, corners)
        if poll_body:
            lines += [blank()] + poll_column(poll_h)
        for spot in spots:
            spot["row"] += table_top
            spot["x"] += 2
        picks = [(1 + n, 0, list_w, firsts[n]) for n in range(len(groups))]
        return lines, spots, picks, order

    if short:
        hot_body = hot(ab_w - 4)
        hot_h = len(hot_body) + 2 if hot_body else 0
        under = 1 + hot_h if hot_h else 0
        target = max(max(list_h, table_h) + under, poll_h if poll_col else 0)
        target = max(target, min(big, max(list_h, table_h + games_h) + under))
        top_h = target - under
        lines = side_by_side([list_box(top_h), table_box(top_h)], ab_w, gap=2)
        if hot_body:
            lines += [blank()] + framed(hot_title, hot_body, ab_w, corners)
    else:
        hot_body = hot(b_w - 4)
        hot_h = len(hot_body) + 2 if hot_body else 0
        under = 1 + hot_h if hot_h else 0
        target = max(list_h, table_h + under, poll_h if poll_col else 0)
        target = max(target, min(big, table_h + games_h + under))
        column_b = table_box(target - under)
        if hot_body:
            column_b += [blank()] + framed(hot_title, hot_body, b_w, corners)
        lines = side_by_side([list_box(target), column_b], ab_w, gap=2)
    if poll_col:
        lines = side_by_side([[line.pad(ab_w) for line in lines], poll_column(len(lines))],
                             width, gap=2)
    elif poll_body:
        lines += [blank()] + poll_column(poll_h)
    for spot in spots:
        spot["x"] += list_w + 2 + 2
    picks = [(1 + n, 0, list_w, firsts[n]) for n in range(len(groups))]
    return lines, spots, picks, order


def basketball_standings_extras(lines, spots, data, league, width, favorites=None,
                                corners=("╭", "╮", "╰", "╯"), poll=None):
    """Basketball's standings panes. The NBA: Hot and cold (the five hottest
    and coldest over the last ten, by point differential, at home and on the
    road) and Win pace under the tables. College basketball, with thirty-one
    conferences to scroll: the Top 25 and Hot and cold first, at the top
    (the picked team's spots move down with the tables)."""
    teams = basketball_table(data, league)
    if len(teams) < 10:
        return lines

    def hot_cold(pane_w, max_rows=None):
        block_w = 30 if pane_w - 4 >= 4 * 30 + 3 * 2 else 32
        blocks = bball_hot_cold_blocks(teams, league, block_w)
        body = side_by_side(blocks, pane_w - 4, gap=2)
        while max_rows and len(blocks) > 1 and len(body) + 2 > max_rows:
            blocks = blocks[:-1]        # a narrow screen keeps what fits
            body = side_by_side(blocks, pane_w - 4, gap=2)
        return framed("Hot and cold", body, pane_w, corners) if blocks else []

    if league in COLLEGE_LEAGUES:
        panes = []
        if poll:
            name, _, rows = poll_rows(poll)
            records = {str(t["team"].get("id")): f"{t['w']}-{t['l']}" for t in teams}
            if rows:
                panes.append(framed(name, poll_pane_lines(poll, league, 40, favorites,
                                                          records), 44, corners))
        rest = width - (46 if panes else 0)
        block = hot_cold(rest, len(panes[0]) if panes else 15) if rest >= 40 else []
        room = (len(panes[0]) if panes else 15) - len(block) - 1 - 3
        if block and room >= 4:
            # under Hot and cold, beside the poll: the conferences by margin
            power = conference_power_lines(teams, league, rest - 4, room)
            if power:
                block = block + [blank()] + framed(
                    "Conference strength", [Line().add(
                        "each conference's average margin a game so far, and its record",
                        "muted")] + power, rest, corners)
        top = side_by_side([p for p in panes + [block] if p], width, gap=2)
        if not top:
            return lines
        top = top + [blank()]
        for spot in spots:
            spot["row"] += len(top)
        return top + list(lines)
    hot_w = 4 * 30 + 3 * 2 + 4
    if width >= hot_w + 2 + 44:
        pace_w = min(60, width - hot_w - 2)
        pace = framed("Win pace", win_pace_ladder(teams, league, pace_w - 4, favorites,
                                                  SEASON_GAMES.get(league, 82)),
                      pace_w, corners)
        left = hot_cold(hot_w)
        room = len(pace) - len(left) - 1
        if room >= 8:
            # under Hot and cold, beside the ladder: who scores, who stops
            chart = scoring_map_lines(teams, league, hot_w - 4, room - 2)
            if chart:
                left = left + [blank()] + framed("Offence and defence", chart, hot_w,
                                                  corners)
        below = side_by_side([left, pace], width, gap=2)
    else:
        pace_w = min(width, 60)
        pace = framed("Win pace", win_pace_ladder(teams, league, pace_w - 4, favorites,
                                                  SEASON_GAMES.get(league, 82)),
                      pace_w, corners)
        map_w = width - pace_w - 2
        chart = scoring_map_lines(teams, league, map_w - 4, len(pace) - 2) \
            if map_w >= 54 else []
        if chart:
            pace = side_by_side([pace, framed("Offence and defence", chart, map_w, corners)],
                                width, gap=2)
        below = hot_cold(width) + [blank()] + pace
    return list(lines) + [blank()] + below


def conference_power_lines(teams, league, width, rows):
    """College conferences by their teams' average margin a game so far, in
    as many columns as `rows` needs, each with its record and a meter."""
    groups = {}
    for entry in teams:
        if entry["diff"] is not None and entry["conference"]:
            groups.setdefault(entry["conference"], []).append(entry)
    ranked = []
    for name, members in groups.items():
        played = sum(e["gp"] for e in members)
        if played:
            ranked.append((sum(e["diff"] * e["gp"] for e in members) / played, name,
                           sum(e["w"] for e in members), sum(e["l"] for e in members)))
    if len(ranked) < 4 or rows < 3:
        return []
    ranked.sort(key=lambda r: -r[0])
    columns = -(-len(ranked) // rows)
    while columns > 1 and (width - 2 * (columns - 1)) // columns < 30:
        columns -= 1
    ranked = ranked[:columns * rows]
    col_w = (width - 2 * (columns - 1)) // columns
    top = max(abs(r[0]) for r in ranked) or 1
    blocks = []
    for column in range(columns):
        block = []
        for place, (margin, name, wins, losses) in enumerate(
                ranked[column * rows:(column + 1) * rows], column * rows + 1):
            line = Line().add(f"{place:>2} ", "muted").add(f"{short_group(name)[:11]:<12}", "normal")
            line.add(f"{wins}-{losses}".ljust(7), "dim").add(f"{margin:+5.1f} ", "bold")
            bar_w = col_w - sum(len(t) for t, _ in line)
            if bar_w >= 4:
                line.extend_spans(meter_spans(abs(margin) / top, bar_w,
                                              "good" if margin >= 0 else "bad"))
            block.append(fit_line(line, col_w))
        blocks.append(block)
    return side_by_side(blocks, width, gap=2)


def record_game_chance(home, away, games, home_edge):
    """One game's chance for `home`: the two teams' win % (log5), each pulled
    toward .500 by `games` games' worth (a record is part luck), and a
    little more for home field."""
    def regressed(entry):
        played = entry.get("gp") or (entry.get("w", 0) + entry.get("l", 0)) or 0
        return 0.5 + (entry.get("pct", 0.5) - 0.5) * played / (played + games)
    a, b = regressed(home), regressed(away)
    game = a * (1 - b) / (a * (1 - b) + b * (1 - a)) if 0 < a < 1 and 0 < b < 1 else 0.5
    return clamp(game + home_edge, 0.05, 0.95)


def best_of_chance(game, wins_needed):
    """A series' chance from one game's: the first to `wins_needed`."""
    total = 0.0
    for losses in range(wins_needed):
        total += math.comb(wins_needed - 1 + losses, losses) * game ** wins_needed * \
            (1 - game) ** losses
    return total


def seeded_by_conference(data, league, seeds):
    """{conference: {seed: entry}} from the standings' own playoff seeds, or
    {} unless both conferences have all `seeds`."""
    found = {}
    for entry in basketball_table(data, league):
        seed = entry.get("seed") or 0
        if entry["conference"] and isinstance(seed, int) and 1 <= seed <= seeds:
            found.setdefault(entry["conference"], {})[seed] = dict(entry, seed=str(seed))
    if len(found) != 2 or any(len(table) < seeds for table in found.values()):
        return {}
    return found


def nfl_projection(data):
    """The bracket if the playoffs began today, in the NFL's format: in each
    conference the four division winners seeded one to four and three wild
    cards five to seven (the standings' own seeds); the top seed sits out the
    wild-card round (2 v 7, 3 v 6, 4 v 5); the field is reseeded after it,
    the top seed meeting the lowest left; the higher seed is at home until
    the Super Bowl, on a neutral field. Each game's favourite goes through,
    its chance from the two records (each pulled toward .500 by 11 games)
    and home field (5 points)."""
    found = seeded_by_conference(data, "nfl", 7)
    if not found:
        return []
    rounds = {name: [] for name in NFL_ROUNDS}

    def game(round_name, short, high, low, neutral=False):
        chance = record_game_chance(high, low, 11, 0.0 if neutral else 0.05)
        entry, winner = projected_series(round_name, short, high, low, 1, chance)
        rounds[round_name].append(entry)
        return winner

    champions = []
    for conference in sorted(found, key=lambda c: "national" in c.lower() or "nfc" in c.lower()):
        low = conference.lower()
        short = "AFC" if "american" in low or "afc" in low else \
            "NFC" if "national" in low or "nfc" in low else conference
        seeds = found[conference]
        alive = [seeds[1]] + [game("Wild Card", short, seeds[a], seeds[b])
                              for a, b in ((2, 7), (3, 6), (4, 5))]
        alive.sort(key=lambda entry: int(entry["seed"]))
        through = sorted((game("Divisional", short, alive[0], alive[3]),
                          game("Divisional", short, alive[1], alive[2])),
                         key=lambda entry: int(entry["seed"]))
        champions.append(game("Championship", short, *through))
    game("Super Bowl", "", champions[0], champions[1], neutral=True)
    return [(name, rounds[name]) for name in NFL_ROUNDS]


def mlb_projection(data):
    """The bracket if the playoffs began today, in MLB's format: in each
    league the three division winners seeded one to three and three wild
    cards four to six (the standings' own seeds); the top two sit out the
    best-of-three wild-card series (3 v 6, 4 v 5, every game at the higher
    seed's park); the winners meet them without reseeding (1 v 4-5, 2 v 3-6)
    over five games, then seven for the pennant and the World Series (the
    better record at home). Each series' favourite goes through, its chance
    from the two records (each pulled toward .500 by 70 games) and home
    field."""
    found = seeded_by_conference(data, "mlb", 6)
    if not found:
        return []
    rounds = {name: [] for name in MLB_ROUNDS}

    def series_of(round_name, short, high, low, wins, edge):
        chance = best_of_chance(record_game_chance(high, low, 70, edge), wins)
        entry, winner = projected_series(round_name, short, high, low, wins, chance)
        entry["status"] = f"best of {wins * 2 - 1}"
        rounds[round_name].append(entry)
        return winner

    pennants = []
    for league_name in sorted(found, key=lambda c: "national" in c.lower()):
        low = league_name.lower()
        short = "AL" if "american" in low else "NL" if "national" in low else league_name
        seeds = found[league_name]
        through = []
        for high, low_seed, waiting in ((4, 5, 1), (3, 6, 2)):
            winner = series_of("Wild Card", short, seeds[high], seeds[low_seed], 2, 0.04)
            through.append(series_of("Division Series", short, seeds[waiting], winner, 3,
                                     0.02))
        through.sort(key=lambda entry: int(entry["seed"]))
        pennants.append(series_of("Championship Series", short, through[0], through[1], 4,
                                  0.02))
    pennants.sort(key=lambda entry: (-entry.get("pct", 0), -entry.get("w", 0)))
    series_of("World Series", "", pennants[0], pennants[1], 4, 0.02)
    return [(name, rounds[name]) for name in MLB_ROUNDS]


NBA_ROUNDS = ["1st Round", "Conf Semis", "Conf Finals", "NBA Finals"]


def nba_projection(data):
    """The bracket if the playoffs began today: in each conference seeds one
    to six straight in, seven and eight from the play-in (the favourite of
    seven against eight, then its loser against the favourite of nine
    against ten), 1-8, 4-5, 3-6 and 2-7, and each series' favourite through.
    Returns (rounds for bracket_layout, the play-ins)."""
    by_conf = {}
    for entry in basketball_table(data, "nba"):
        if entry["conference"]:
            by_conf.setdefault(entry["conference"], []).append(entry)
    if len(by_conf) != 2:
        return [], []
    rounds = {name: [] for name in NBA_ROUNDS}
    play_ins, finalists = [], []
    for conference in sorted(by_conf, key=lambda c: "west" in c.lower()):
        seeded = all(0 < t["seed"] <= 15 for t in by_conf[conference])
        ranked = sorted(by_conf[conference], key=lambda t: (t["seed"] if seeded else 0,
                                                            -t["pct"], -t["w"]))
        if len(ranked) < 10:
            return [], []
        short = "East" if "east" in conference.lower() else (
            "West" if "west" in conference.lower() else conference)
        seven, eight, nine, ten = ranked[6:10]
        first = series_chance(seven, eight, 1)
        won, lost = (seven, eight) if first >= 0.5 else (eight, seven)
        second = series_chance(nine, ten, 1)
        nine_ten = nine if second >= 0.5 else ten
        last = series_chance(lost, nine_ten, 1)
        eighth = lost if last >= 0.5 else nine_ten
        play_ins.append((short, [(seven, eight, first, 7, 8), (nine, ten, second, 9, 10),
                                 (lost, nine_ten, last, None, None)]))
        field = [dict(entry, seed=str(place)) for place, entry in
                 enumerate(ranked[:6] + [won, eighth], 1)]
        through = []
        for i, j in ((0, 7), (3, 4), (2, 5), (1, 6)):
            entry, favourite = projected_series("1st Round", short, field[i], field[j])
            rounds["1st Round"].append(entry)
            through.append(favourite)
        semis = []
        for k in (0, 2):
            entry, favourite = projected_series("Conf Semis", short, through[k],
                                                through[k + 1])
            rounds["Conf Semis"].append(entry)
            semis.append(favourite)
        entry, champion = projected_series("Conf Finals", short, *semis)
        rounds["Conf Finals"].append(entry)
        finalists.append(champion)
    final, _ = projected_series("NBA Finals", "", *finalists)
    rounds["NBA Finals"].append(final)
    return [(name, rounds[name]) for name in NBA_ROUNDS], play_ins


def play_in_lines(play_ins, league, width):
    """'East play-in  ORL 58% v NYK  ·  CHA 61% v MIA  ·  for 8th: NYK 55% v CHA'"""
    lines = []
    for short, games in play_ins:
        head = f"{short} play-in  "
        line = Line().add(head, "accent")
        for index, (top, bottom, chance, seed_a, seed_b) in enumerate(games):
            game = Line()
            if seed_a is None:
                game.add("for 8th: ", "muted")
            for entry, share, seed in ((top, chance, seed_a), (bottom, 1 - chance, seed_b)):
                team = entry["team"]
                if seed:
                    game.add(f"{seed} ", "muted")
                game.add(team.get("abbr") or "?", THEME.style(league, team, bold=share >= 0.5,
                                                              fallback="accent"))
                game.add(f" {share * 100:.0f}%", "bold" if share >= 0.5 else "dim")
                if entry is top:
                    game.add(" v ", "muted")
            used = sum(len(t) for t, _ in line)
            if index and used + 5 + len(game.text) > width:
                # a game that would run off the edge starts a line of its own
                lines.append(line)
                line = Line().add(" " * len(head))
            elif index:
                line.add("  ·  ", "muted")
            line.extend_spans(game)
        lines.append(fit_line(line, width))
    return lines


def cbb_seed_lines(poll, standings, league, width, favorites=None):
    """College basketball's picture: the poll's top 24 as the tournament's
    top six seed lines, and how many ranked teams each conference has."""
    name, _, rows = poll_rows(poll)
    if len(rows) < 8:
        return []
    lines = [heading("If the season ended today"),
             Line().add(f"the {name}'s top 24 as the top six seed lines · a picture, not a "
                        "bracketology"[:width], "muted")]
    # today's records from the standings, not the poll's (as old as the poll)
    records = {str(t["team"].get("id")): f"{t['w']}-{t['l']}"
               for t in basketball_table(standings or {}, league)}
    rows = [(rank, previous, team, records.get(team["id"]) or record, votes)
            for rank, previous, team, record, votes in rows]
    for seed in range(1, 7):
        chunk = rows[(seed - 1) * 4: seed * 4]
        if not chunk:
            break
        line = Line().add(f"{seed} seeds  ", "accent")
        for index, (_, _, team, record, _) in enumerate(chunk):
            if index:
                line.add("  ·  ", "muted")
            star = fav_rank(favorites or {}, league, team) >= 0
            line.add(("★ " if star else "") + standings_name(league, team),
                     THEME.style(league, team, bold=True, fallback="accent"))
            line.add(f" {record}", "dim")
        lines.append(fit_line(line, width))
    conference_of = {ident: path[-1] for ident, (_, _, path) in
                     standings_rows(standings or {}).items() if path}
    counts = {}
    for _, _, team, _, _ in rows[:25]:
        found = conference_of.get(team["id"])
        if found:
            counts[found] = counts.get(found, 0) + 1
    if counts:
        lines += [blank(), heading("Ranked teams by conference")]
        top = max(counts.values())
        name_w = 18
        bar_w = clamp(width - name_w - 6, 6, 40)
        for conference, count in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):
            line = Line().add(f"{short_group(conference)[:name_w - 1]:<{name_w}}", "normal")
            line.extend_spans(meter_spans(count / top, bar_w, "accent"))
            lines.append(line.add(f" {count}", "bold"))
    return lines


def bball_form_lines(data, team, league, width, count=5, before=None):
    """A team's last few results for the Scouting tab, newest first: each
    with its score, and the run and average margin they add up to; `before`
    (an ISO time) leaves out the games from then on - a past game's scouting
    shows the form it was played in (7.0.0)."""
    games = [g for g in (data or {}).get("games") or []
             if g.get("state") == "post" and g.get("result") in ("W", "L")
             and g.get("us") is not None and g.get("them") is not None
             and (not before or str(g.get("date") or "") < before)]
    if not games:
        return []
    last = games[-count:]
    wins = sum(1 for g in last if g["result"] == "W")
    margin = sum(g["us"] - g["them"] for g in last) / len(last)
    lines = [Line().add("  Form     ", "muted").add(
        f"last {len(last)}: {wins}-{len(last) - wins} · {margin:+.1f} a game", "normal")]
    for game in reversed(last):
        won = game["result"] == "W"
        line = Line().add(f"    {card_day(game['date']):<6}", "muted")
        line.add(f"{'vs' if game['home'] else '@':<3}{game['opp']:<6}", "normal")
        line.add(f"{game['result']} ", "good" if won else "bad")
        line.add(f"{game['us']}-{game['them']}".ljust(8), "bold")
        detail = game.get("detail") or ""
        extra = re.search(r"/(\d+)", detail) if is_baseball(league) else None
        if is_baseball(league):             # 7.0.0: a short or extra-inning game
            line.add((f"{extra.group(1)} inn" if extra else "").ljust(8), "muted")
        else:
            line.add("OT  " if "OT" in detail else "    ", "muted")
        diff = game["us"] - game["them"]
        line.add(f"{diff:+d}".rjust(4), "good" if won else "bad")
        lines.append(fit_line(line, width))
    return lines


def schedule_facts(schedule, before=None):
    """What baseball_tape reads from the standings, worked out from a team's
    schedule instead (7.0.0, for the college teams ESPN's standings leave
    out): the record, runs for and against, home and road, last ten and the
    streak, from the games finished before `before`."""
    games = [g for g in (schedule or {}).get("games") or []
             if g.get("state") == "post" and g.get("result") in ("W", "L")
             and g.get("us") is not None and g.get("them") is not None
             and (not before or str(g.get("date") or "") < before)]
    if not games:
        return None

    def record(subset):
        wins = sum(1 for g in subset if g["result"] == "W")
        return f"{wins}-{len(subset) - wins}"
    streak = ""
    if games:
        last = games[-1]["result"]
        run = 0
        for game in reversed(games):
            if game["result"] != last:
                break
            run += 1
        streak = f"{last}{run}"
    home = [g for g in games if g.get("home") and not g.get("neutral")]
    road = [g for g in games if not g.get("home") and not g.get("neutral")]
    wins = sum(1 for g in games if g["result"] == "W")
    return {"w": wins, "l": len(games) - wins, "gp": len(games),
            "rs": float(sum(g["us"] for g in games)), "ra": float(sum(g["them"] for g in games)),
            "home": record(home) if home else "", "road": record(road) if road else "",
            "l10": record(games[-10:]) if len(games) >= 10 else "", "streak": streak,
            "div": "", "conf": None}


def baseball_tape(event, data, league, width, schedules=None):
    """TALE OF THE TAPE for baseball's Scouting tab (7.0.0), from the
    standings, none of it in the season numbers above it: the record, the run
    differential and the record it points to (Pythagorean), at home and on
    the road, the last ten and the streak (where ESPN keeps them), and the
    conference or division record."""
    rows = standings_rows(data) if data else {}
    found = {}
    for _, (team, table, path) in rows.items():
        ident = str(team.get("id"))
        if ident in (str(event["away"].get("id")), str(event["home"].get("id"))):
            found[ident] = (team, table, path)
    a = found.get(str(event["away"].get("id")))
    h = found.get(str(event["home"].get("id")))
    sources = "ESPN standings"
    if not a or not h:
        # 7.0.0: from the two schedules, where the standings leave a team out
        pair = [schedule_facts((schedules or {}).get(side), event.get("date"))
                for side in ("away", "home")]
        if not pair[0] or not pair[1]:
            return []
        sources = "the teams' schedules, to this game"

    def facts(entry):
        _, table, _ = entry
        wins = _int(stat_display(table, ["wins"]))
        losses = _int(stat_display(table, ["losses"]))
        played = wins + losses + _int(stat_display(table, ["ties"]))
        scored = _num(stat_display(table, ["pointsFor"]))
        allowed = _num(stat_display(table, ["pointsAgainst"]))
        out = {"w": wins, "l": losses, "gp": played, "rs": scored, "ra": allowed,
               "home": stat_summary(table, ["Home", "home"]),
               "road": stat_summary(table, ["Road", "road", "Away", "away"]),
               "l10": stat_summary(table, ["Last Ten Games", "lastTen", "L10"]),
               "streak": clean(stat_display(table, ["streak"])),
               "div": stat_summary(table, ["Intradivision", "vs. Div.", "Division"]),
               "conf": _num(stat_display(table, ["leagueWinPercent"]))}
        if not out["home"]:
            hw, hl = stat_display(table, ["homeWins"]), stat_display(table, ["homeLosses"])
            if str(hw).isdigit() and str(hl).isdigit():
                out["home"] = f"{hw}-{hl}"
        if not out["road"]:
            rw, rl = stat_display(table, ["roadWins"]), stat_display(table, ["roadLosses"])
            if str(rw).isdigit() and str(rl).isdigit():
                out["road"] = f"{rw}-{rl}"
        return out
    x, y = (facts(a), facts(h)) if a and h else pair
    if not x["gp"] or not y["gp"]:
        return []
    away, home = event["away"], event["home"]
    label_w = 17
    lines = [heading("Tale of the tape")]
    head = Line().add(" " * label_w, "normal")
    head.add(f"{away['abbr']:>10}", THEME.style(league, away, bold=True, fallback="accent"))
    head.add(f"{home['abbr']:>10}", THEME.style(league, home, bold=True, fallback="accent"))
    lines.append(head)

    def row(label, left, right, better=0, note=""):
        line = Line().add(f"{label:<{label_w}}", "muted")
        line.add(f"{left:>10}", "good" if better > 0 else "normal")
        line.add(f"{right:>10}", "good" if better < 0 else "normal")
        if note:
            line.add(f"   {note}", "dim")
        lines.append(fit_line(line, width))

    def cmp(p, q):
        return (p > q) - (p < q)
    row("Record", f"{x['w']}-{x['l']}", f"{y['w']}-{y['l']}",
        cmp(x["w"] / max(1, x["gp"]), y["w"] / max(1, y["gp"])))
    if None not in (x["rs"], x["ra"], y["rs"], y["ra"]) and x["rs"] and y["rs"]:
        dx, dy = int(x["rs"] - x["ra"]), int(y["rs"] - y["ra"])
        row("Run differential", f"{dx:+d}", f"{dy:+d}", cmp(dx, dy))

        def pythag(entry):
            share = entry["rs"] ** 1.83 / (entry["rs"] ** 1.83 + entry["ra"] ** 1.83)
            wins = round(share * (entry["w"] + entry["l"]))
            return f"{wins}-{entry['w'] + entry['l'] - wins}", wins - entry["w"]
        (px, gx), (py, gy) = pythag(x), pythag(y)
        row("Runs say", px, py, 0, "the record its runs point to")
    if x["road"] and y["home"]:
        row("Road · home", x["road"], y["home"], 0, f"{away['abbr']} away, "
            f"{home['abbr']} at home")
    if x["l10"] and y["l10"]:
        row("Last ten", x["l10"], y["l10"])
    if all(re.fullmatch(r"[WL]\d+", t["streak"] or "") for t in (x, y)):
        row("Streak", x["streak"], y["streak"])
    if x["div"] and y["div"]:
        row("In the division", x["div"], y["div"])
    elif x["conf"] is not None and y["conf"] is not None and (x["conf"] or y["conf"]):
        row("Conference win %", f"{x['conf']:.3f}".replace("0.", ".", 1),
            f"{y['conf']:.3f}".replace("0.", ".", 1), cmp(x["conf"], y["conf"]))
    lines.append(Line().add(f"from {sources}", "dim"))
    return lines


def head_to_head_lines(schedule, team, other, league, width, before=None):
    """This season's meetings so far, from one side's schedule (7.0.0): who
    leads, then each game's day and score; `before` (an ISO time) leaves out
    the games from then on."""
    games = [g for g in (schedule or {}).get("games") or []
             if g.get("state") == "post" and str(g.get("opp_id")) == str(other.get("id"))
             and g.get("us") is not None and g.get("them") is not None
             and (not before or str(g.get("date") or "") < before)]
    if not games:
        return []
    wins = sum(1 for g in games if g.get("result") == "W")
    losses = sum(1 for g in games if g.get("result") == "L")
    if wins > losses:
        lead = f"{team['abbr']} leads {wins}-{losses}"
    elif losses > wins:
        lead = f"{other['abbr']} leads {losses}-{wins}"
    else:
        lead = f"tied {wins}-{losses}"
    line = Line().add("  Meetings ", "muted").add(f"this season: {lead}", "normal")
    lines = [fit_line(line, width)]
    row = Line().add("           ", "normal")
    for index, game in enumerate(games[-6:]):
        if index:
            row.add(" · ", "muted")
        won = game.get("result") == "W"
        row.add(f"{card_day(game['date'])} ", "muted")
        row.add(f"{team['abbr']} {game['us']}-{game['them']}", "good" if won else "bad")
    lines.append(fit_line(row, width))
    return lines


def bball_tape(event, teams, league, width):
    """The two teams side by side from the standings: record, win %, points
    for and against a game, the differential, last ten, streak, and the home
    team at home against the visitor on the road."""
    by_id = {str(t["team"].get("id")): t for t in teams}
    a, h = by_id.get(str(event["away"].get("id"))), by_id.get(str(event["home"].get("id")))
    if not a or not h:
        return []
    away, home = event["away"], event["home"]
    label_w = 16
    lines = [heading("Tale of the tape")]
    head = Line().add(" " * label_w, "normal")
    head.add(f"{away['abbr']:>9}", THEME.style(league, away, bold=True, fallback="accent"))
    head.add(f"{home['abbr']:>9}", THEME.style(league, home, bold=True, fallback="accent"))
    lines.append(head)

    def row(label, left, right, better=0):
        line = Line().add(f"{label:<{label_w}}", "muted")
        line.add(f"{left:>9}", "good" if better > 0 else "normal")
        line.add(f"{right:>9}", "good" if better < 0 else "normal")
        lines.append(fit_line(line, width))

    def cmp(x, y):
        return (x > y) - (x < y)

    row("Record", f"{a['w']}-{a['l']}", f"{h['w']}-{h['l']}", cmp(a["pct"], h["pct"]))
    for label, key, higher in (("Points / gm", "ppg", True), ("Allowed / gm", "opp", False),
                               ("Differential", "diff", True)):
        if a[key] is None or h[key] is None:
            continue
        better = cmp(a[key], h[key])
        text = "{:+.1f}" if key == "diff" else "{:.1f}"
        row(label, text.format(a[key]), text.format(h[key]), better if higher else -better)
    if a["l10"] and h["l10"]:
        row("Last ten", a["l10"], h["l10"], cmp(a["l10_w"] or 0, h["l10_w"] or 0))
    if all(re.fullmatch(r"[WL]\d+", t["streak"] or "") for t in (a, h)):
        row("Streak", a["streak"], h["streak"])
    if a["road"] and h["home"]:
        row("Road · home", a["road"], h["home"])
    return lines


def margin_png(spec, cw, ch):
    """The margin odds as a picture under their labels: the projected margin's
    normal curve, smooth, shaded from the baseline in the visitor's colours
    left of even and the home side's right of it, a crisp line over it, even
    dashed and the spread's line to cover dashed in gold."""
    import math as _math
    cw, ch = max(4, int(cw)), max(8, int(ch))
    width, height = spec["cols"] * cw, spec["rows"] * ch
    buf = bytearray(width * height * 4)
    stride = width * 4
    x0, x1 = spec["x0"] * cw, spec["x1"] * cw
    y0, y1 = 3, height - 2
    reach, margin, sigma = spec["reach"], spec["margin"], spec["sigma"]
    away = hex_to_rgb("#" + spec["away"]) or (120, 120, 120)
    home = hex_to_rgb("#" + spec["home"]) or (200, 200, 200)

    def at(value):
        return x0 + (value + reach) / (2.0 * reach) * (x1 - x0)

    previous = None
    for x in range(x0, x1):
        value = -reach + (x + 0.5 - x0) / (x1 - x0) * 2 * reach
        curve = _math.exp(-0.5 * ((value - margin) / sigma) ** 2)
        top = y1 - curve * (y1 - y0)
        color = home if value >= 0 else away
        for y in range(max(0, int(top)), y1):
            cover = min(1.0, y + 1 - top) if y < top + 1 else 1.0
            _blend(buf, y * stride + x * 4, color,
                   cover * (0.25 + 0.45 * (y1 - y) / max(1.0, y1 - y0)))
        a, b = (top, top) if previous is None else sorted((previous, top))
        for y in range(max(0, int(a - 1)), min(height, int(b + 1) + 1)):
            cover = min(1.0, max(0.0, min(y + 1, b + 1.0) - max(y, a - 1.0)))
            if cover > 0:
                _blend(buf, y * stride + x * 4, (238, 242, 246), 0.95 * cover)
        previous = top
    for value, rgb, alpha in ((0, (255, 255, 255), 0.35),
                              (spec.get("cover"), (255, 210, 64), 0.9)):
        if value is None or not -reach <= value <= reach:
            continue
        x = int(at(value))
        for y in range(y0 - 2, y1):
            if (y // 3) % 2 == 0 and 0 <= x < width:
                _blend(buf, y * stride + x * 4, rgb, alpha)
                if x + 1 < width:
                    _blend(buf, y * stride + (x + 1) * 4, rgb, alpha * 0.6)
    for x in range(x0, x1):
        _blend(buf, (y1 - 1) * stride + x * 4, (255, 255, 255), 0.25)
    return png_encode(width, height, buf)


def margin_odds_lines(model, event, league, width, spread=None, total=None):
    """sportst's projected margin as a normal curve: where the game might
    finish (the spread marked), each side's chance to win by so much, and the
    posted total's chances. A picture; the bets' chances come from the model."""
    if not model or model.get("margin") is None or not model.get("proj"):
        return []
    cfg = MODEL.get(league, MODEL["nfl"])
    sigma, tsigma = cfg["sigma"], cfg["tsigma"]
    margin = model["margin"]
    away, home = event["away"], event["home"]

    def chance(lo, hi):
        return norm_cdf((hi - margin) / sigma) - norm_cdf((lo - margin) / sigma)

    leader, by = (home, margin) if margin >= 0 else (away, -margin)
    lines = [heading("Margin odds").add(
        f"  {leader['abbr']} by {by:.1f} as a normal curve (σ {sigma:g}): "
        "a picture, not the bets' chances"[:max(0, width - 13)], "muted")]
    # the curve spans the pane: a point a column where it fits, three rows high
    reach = max(20, 5 * math.ceil((abs(margin) + 2.5 * sigma) / 5))
    room = max(16, width - 15)
    step = max(1, -(-2 * reach // room))
    edges = list(range(-reach, reach + 1, step))
    values = [chance(lo, lo + step) for lo in edges[:-1]]
    peak = max(values) or 1
    cover = -spread if spread is not None else None        # the home margin it takes
    tall = 4 if UNDER["on"] else 3
    first_bar = len(lines)
    for row in range(tall - 1, -1, -1):
        bars = Line()
        if row == 0:
            bars.add(f"  {away['abbr']:>4} ", THEME.style(league, away, bold=True,
                                                        fallback="accent"))
        else:
            bars.add(" " * 7)
        marked = False
        for lo, value in zip(edges[:-1], values):
            if cover is not None and not marked and lo + step > cover:
                bars.add(" " if UNDER["on"] else "┊", "border")
                marked = True
            level = value / peak * tall * 8 - row * 8
            style = THEME.style(league, home if lo >= 0 else away, fallback="accent")
            if UNDER["on"]:
                bars.add(" ", "normal")      # the picture draws the curve
            elif level <= 0.5:
                bars.add("▁" if row == 0 else " ", style if row == 0 else "normal")
            else:
                bars.add(SPARK_BARS[clamp(int(round(level)) - 1, 0, 7)], style)
        if row == 0:
            bars.add(f" {home['abbr']}", THEME.style(league, home, bold=True,
                                                     fallback="accent"))
        lines.append(merge_spans(bars))
    span = len(values) + (1 if cover is not None and -reach < cover <= reach else 0)
    axis = [" "] * span
    ends = f"by {reach}+"
    for at, text in ((0, ends), (span // 2 - 2, "even"), (span - len(ends), ends)):
        for i, ch in enumerate(text):
            if 0 <= at + i < span:
                axis[at + i] = ch
    if UNDER["on"]:
        bar_lines = lines[first_bar:first_bar + tall]
        spec = {"cols": max(len(l.text) for l in bar_lines), "rows": tall, "x0": 7,
                "x1": 7 + len(values), "reach": reach,
                "margin": round(margin, 2), "sigma": sigma,
                "cover": cover if cover is not None else None,
                "away": team_hex(league, away), "home": team_hex(league, home)}
        spec["x1"] = 7 + len(values) + (1 if cover is not None and -reach < cover <= reach
                                        else 0)
        number = underlay_number(("margin", repr(spec)),
                                 lambda cw, ch, s=spec: margin_png(s, cw, ch),
                                 spec["cols"], tall)
        lines[first_bar:first_bar + tall] = underlay_lines(bar_lines, number)
    lines.append(Line().add(" " * 7 + "".join(axis), "muted"))
    for side, sign in (("home", 1), ("away", -1)):
        team = event[side]
        line = Line().add(f"  {team['abbr']:<5}", THEME.style(league, team, bold=True,
                                                             fallback="accent"))
        line.add(f"wins {norm_cdf(sign * margin / sigma) * 100:.0f}%", "bold")
        bands = ((0.5, 3.5, "1-3"), (3.5, 7.5, "4-7"), (7.5, 1e9, "8+")) \
            if sport_of(league) == "football" else \
            ((0.5, 5.5, "1-5"), (5.5, 10.5, "6-10"), (10.5, 1e9, "11+"))
        for lo, hi, label in bands:
            part = chance(lo, hi) if sign > 0 else chance(-hi, -lo)
            line.add(f"  by {label} {part * 100:.0f}%", "dim")
        lines.append(fit_line(line, width))
    if spread is not None:
        covers = 1 - norm_cdf((cover - margin) / sigma)
        side = "home" if spread <= 0 else "away"
        number = spread if side == "home" else -spread
        team = event[side]
        lines.append(Line().add(f"  {team['abbr']} {number:+g} covers ", "normal")
                     .add(f"{(covers if side == 'home' else 1 - covers) * 100:.0f}%", "bold"))
    projected = sum(model["proj"])
    if total is not None:
        line = Line().add(f"  total {projected:.1f}  ", "normal")
        step = 3 if sport_of(league) == "football" else 5
        for mark in (total - step, total, total + step):
            over = 1 - norm_cdf((mark - projected) / tsigma)
            line.add(f"over {mark:g} ", "muted").add(f"{over * 100:.0f}%  ", "bold" if
                                                     mark == total else "dim")
        # beside the cover line when both fit (6.21.0)
        if spread is not None and len(lines[-1].text) + 2 + len(line.text.rstrip()) <= width:
            joined = Line()
            joined.extend_spans(lines[-1])
            joined.extend_spans(line)
            lines[-1] = joined
        else:
            lines.append(fit_line(line, width))
    return [fit_line(line, width) for line in lines]


def bball_team_stats(summary):
    """{'away'/'home': {stat name: display value}} from a summary's box score."""
    out = {}
    for team in dig(summary, "boxscore", "teams", default=[]) or []:
        side = team.get("homeAway")
        if side in ("away", "home"):
            out[side] = {clean(s.get("name") or ""): clean(s.get("displayValue") or "")
                         for s in team.get("statistics") or []}
    return out


def bball_period_length(league, number):
    """Seconds in a period: NBA quarters of twelve minutes, college halves of
    twenty, five-minute overtimes; football's quarters of fifteen, the NFL's
    ten-minute overtime and college's untimed ones counted as five."""
    if sport_of(league) == "football":
        return 900 if number <= 4 else (600 if league == "nfl" else 300)
    if league == "nba":
        return 720 if number <= 4 else 300
    if quarters(league):                       # the WNBA's, women's college (7.0.0)
        return 600 if number <= 4 else 300
    return 1200 if number <= 2 else 300


def bball_period_name(league, number):
    if sport_of(league) == "football":
        return period_tag(league, number)
    regulation = 4 if quarters(league) else 2
    if number > regulation:
        extra = number - regulation
        return "OT" if extra == 1 else f"{extra}OT"
    return f"Q{number}" if quarters(league) else f"H{number}"


def bball_timeline(summary, league):
    """[(seconds into the game, away, home, play)] for the start and every
    play that changed the score."""
    out = [(0, 0, 0, None)]
    for play in game_plays(summary):
        number = _int(dig(play, "period", "number", default=0))
        if not number:
            continue
        left = wire_seconds(dig(play, "clock", "displayValue", default=""))
        start = sum(bball_period_length(league, n) for n in range(1, number))
        at = start + bball_period_length(league, number) - (left if left is not None else 0)
        a, h = _int(play.get("awayScore")), _int(play.get("homeScore"))
        last = out[-1]
        if (a, h) == (last[1], last[2]) or a < last[1] or h < last[2]:
            continue
        out.append((max(at, last[0]), a, h, play))
    return out


def bball_runs(timeline):
    """Every run of points by one side unanswered: dicts of side, points,
    start and end (seconds into the game)."""
    runs, current = [], None
    for (_, a0, h0, _), (t1, a1, h1, _) in zip(timeline, timeline[1:]):
        da, dh = a1 - a0, h1 - h0
        side = "away" if da > 0 and dh == 0 else "home" if dh > 0 and da == 0 else None
        if side and current and current["side"] == side:
            current["pts"] += da + dh
            current["end"] = t1
            continue
        if current:
            runs.append(current)
        current = {"side": side, "pts": da + dh, "start": t1, "end": t1} if side else None
    if current:
        runs.append(current)
    return runs


def bball_lead_facts(timeline):
    """Lead changes, ties after the start, and each side's biggest lead."""
    changes = ties = 0
    leader = None
    biggest = {"away": 0, "home": 0}
    for _, a, h, _ in timeline[1:]:
        margin = h - a
        now = "home" if margin > 0 else "away" if margin < 0 else None
        if now is None:
            ties += 1
            continue
        if leader and now != leader:
            changes += 1
        leader = now
        biggest[now] = max(biggest[now], abs(margin))
    return changes, ties, biggest


def bball_flow(summary, event, league, width, rows=7):
    """The game's flow: the score margin across the game in braille, the
    home side's lead above the line in its colour and the visitor's below.
    Returns lines (the chart, its periods and a legend), or [] too early."""
    timeline = bball_timeline(summary, league)
    football = sport_of(league) == "football"
    if len(timeline) < (3 if football else 6):
        return []
    regulation = 4 if quarters(league) or football else 2
    periods = max([regulation] + [_int(dig(p, "period", "number", default=0))
                                  for _, _, _, p in timeline[1:]])
    end = sum(bball_period_length(league, n) for n in range(1, periods + 1))
    if event.get("state") == "in":
        end = max(timeline[-1][0], 1)
    label_w = 6
    cols = max(20, width - label_w)
    px_w, px_h = cols * 2, rows * 4
    # the zero line sits where each side's biggest lead leaves it: a game one
    # side led all night spends its room above the line, not below it
    up = max(0, max(h - a for _, a, h, _ in timeline))
    down = max(0, max(a - h for _, a, h, _ in timeline))
    span = (up + down) or 1
    zero = clamp(int(round((px_h - 1) * up / span)), 2, px_h - 3)
    cells = {}
    owners = {}
    at = 0
    for x in range(px_w):
        moment = (x + 0.5) / px_w * end
        while at + 1 < len(timeline) and timeline[at + 1][0] <= moment:
            at += 1
        _, a, h, _ = timeline[at]
        margin = h - a
        if margin >= 0:
            y = zero - int(round(margin / (up or 1) * zero))
        else:
            y = zero + int(round(-margin / (down or 1) * (px_h - 1 - zero)))
        lo, hi = sorted((y, zero))
        for py in range(lo, hi + 1):
            key = (py // 4, x // 2)
            cells[key] = cells.get(key, 0) | BRAILLE_BITS[py % 4][x % 2]
            if margin:
                owners.setdefault(key, {})
                side = "home" if margin > 0 else "away"
                owners[key][side] = owners[key].get(side, 0) + 1
    away, home = event["away"], event["home"]
    styles = {"away": THEME.style(league, away, fallback="accent"),
              "home": THEME.style(league, home, fallback="accent")}
    lines = []
    for row in range(rows):
        if row == zero // 4:
            label = Line().add(f"{'0':<{label_w - 1}}", "muted")
        elif row == 0 and up:
            label = Line().add(f"+{up:<{label_w - 2}}"[:label_w - 1], styles["home"])
        elif row == rows - 1 and down:
            label = Line().add(f"+{down:<{label_w - 2}}"[:label_w - 1], styles["away"])
        else:
            label = Line().add(" " * (label_w - 1), "normal")
        line = Line(list(label)).add(" ", "normal")
        for col in range(cols):
            bits = cells.get((row, col), 0)
            who = owners.get((row, col))
            if not bits:
                line.add("─" if row == zero // 4 else " ", "border")
            else:
                line.add(chr(0x2800 + bits),
                         styles[max(who, key=who.get)] if who else "border")
        lines.append(merge_spans(line))
    axis = [" "] * cols
    names = Line().add(" " * label_w, "normal")
    marks = [" "] * cols
    for number in range(1, periods + 1):
        start = sum(bball_period_length(league, n) for n in range(1, number))
        col = int(start / end * cols) if end else 0
        if col < cols:
            axis[col] = "┴"
            for i, ch in enumerate(bball_period_name(league, number)):
                if col + 1 + i < cols:
                    marks[col + 1 + i] = ch
    lines.append(Line().add(" " * label_w, "normal").add("".join(axis), "border"))
    lines.append(names.add("".join(marks), "muted"))
    changes, ties, biggest = bball_lead_facts(timeline)
    legend = Line().add(" " * label_w, "normal")
    legend.add(home["abbr"], THEME.style(league, home, bold=True, fallback="accent"))
    legend.add(" ahead above · ", "muted")
    legend.add(away["abbr"], THEME.style(league, away, bold=True, fallback="accent"))
    legend.add(" below · ", "muted")
    legend.add(f"{changes} lead change{'s' if changes != 1 else ''}, tied {ties} "
               f"time{'s' if ties != 1 else ''}", "dim")
    lines.append(fit_line(legend, width))
    return lines


def bball_clock_text(league, seconds):
    """Seconds into the game as '7:12 Q2' (time left in the period)."""
    number, elapsed = 1, seconds
    while elapsed > bball_period_length(league, number):
        elapsed -= bball_period_length(league, number)
        number += 1
    left = int(bball_period_length(league, number) - elapsed)
    return f"{left // 60}:{left % 60:02d} {bball_period_name(league, number)}"


def bball_run_lines(summary, event, league, width, count=4):
    """The game's biggest runs (eight points or more), with when they came."""
    runs = [r for r in bball_runs(bball_timeline(summary, league)) if r["pts"] >= 8]
    if not runs:
        return []
    runs.sort(key=lambda r: (-r["pts"], r["start"]))
    lines = [heading("Biggest runs")]
    for run in runs[:count]:
        team = event[run["side"]]
        line = Line().add("  ", "normal").add(f"{team['abbr']:<5}", THEME.style(
            league, team, bold=True, fallback="accent"))
        line.add(f"{run['pts']}-0", "bold").add(
            f"   {bball_clock_text(league, run['start'])} to "
            f"{bball_clock_text(league, run['end'])}", "dim")
        lines.append(fit_line(line, width))
    return lines


def flowcol_png(spec, cw, ch):
    """Game flow as a picture under its labels: a column for each stretch of
    the game, from the zero line up in the home side's colours while it led
    and down in the visitor's, each outlined in a light shade of them and set
    apart from the next; the zero line and the periods' starts dashed."""
    cw, ch = max(4, int(cw)), max(8, int(ch))
    width, height = spec["cols"] * cw, spec["rows"] * ch
    buf = bytearray(width * height * 4)
    white = (255, 255, 255)
    x0, x1 = spec["x0"] * cw, spec["cols"] * cw
    y0, y1 = 2, height - 2
    zero = int(round(y0 + (y1 - y0) * spec["zero"]))
    colors = {1: hex_to_rgb("#" + spec["home"]) or (200, 200, 200),
              -1: hex_to_rgb("#" + spec["away"]) or (120, 120, 120)}
    count = len(spec["margins"]) or 1
    step = (x1 - x0) / count
    gap = max(1.0, step * 0.18)
    stride = width * 4
    for at in spec["periods"]:
        x = int(x0 + at * step)
        for y in range(y0, y1):
            if (y // 3) % 2 == 0 and 0 <= x < width:
                _blend(buf, y * stride + x * 4, white, 0.22)
    for index, margin in enumerate(spec["margins"]):
        if not margin:
            continue
        sign = 1 if margin > 0 else -1
        reach = spec["up"] if sign > 0 else spec["down"]
        length = abs(margin) / (reach or 1) * ((zero - y0) if sign > 0 else (y1 - zero))
        top, bottom = (int(round(zero - length)), zero) if sign > 0 else \
            (zero, int(round(zero + length)))
        if bottom - top < 2:
            top, bottom = (bottom - 2, bottom) if sign > 0 else (top, top + 2)
        left = x0 + index * step + gap / 2
        right = x0 + (index + 1) * step - gap / 2
        color = colors[sign]
        raster_shape(buf, width, left, top, right, bottom, _mix(color, white, 0.55),
                     radius=1.5)
        if right - left > 3 and bottom - top > 2:
            raster_shape(buf, width, left + 1, top + 1, right - 1, bottom - 1,
                         (_mix(color, white, 0.15), _mix(color, (0, 0, 0), 0.2)),
                         replace=True)
    for x in range(x0, x1):
        if (x // 4) % 2 == 0:
            _blend(buf, zero * stride + x * 4, white, 0.55)
    return png_encode(width, height, buf)


def flow_column_lines(summary, event, league, width, rows=6):
    """The game's flow as a column chart (6.21.0): the margin at the end of
    each stretch of the game, a column each, up in the home side's colours
    while it led and down in the visitor's - outlined and set apart where the
    terminal shows pictures, half-cell blocks with a gap between them
    elsewhere; the periods marked under it and a legend. [] too early."""
    timeline = bball_timeline(summary, league)
    football = sport_of(league) == "football"
    if len(timeline) < (3 if football else 6):
        return []
    regulation = 4 if quarters(league) or football else 2
    periods = max([regulation] + [_int(dig(p, "period", "number", default=0))
                                  for _, _, _, p in timeline[1:]])
    end = sum(bball_period_length(league, n) for n in range(1, periods + 1))
    if event.get("state") == "in":
        end = max(timeline[-1][0], 1)
    label_w = 6
    cols = max(20, width - label_w)
    pictures = UNDER["on"]
    count = cols if pictures else max(10, cols // 2)
    up = max(0, max(h - a for _, a, h, _ in timeline))
    down = max(0, max(a - h for _, a, h, _ in timeline))
    span = (up + down) or 1
    units = rows * 2
    zero = clamp(int(round(units * up / span)), 1, units - 1)
    margins, at = [], 0
    for index in range(count):
        moment = (index + 1) / count * end
        while at + 1 < len(timeline) and timeline[at + 1][0] <= moment:
            at += 1
        _, a, h, _ = timeline[at]
        margins.append(h - a)
    away, home = event["away"], event["home"]
    styles = {1: THEME.style(league, home, fallback="accent"),
              -1: THEME.style(league, away, fallback="accent")}
    grid = [[(" ", "normal") for _ in range(cols)] for _ in range(rows)]
    if not pictures:
        for index, margin in enumerate(margins):
            x = index * 2
            if not margin or x >= cols:
                continue
            sign = 1 if margin > 0 else -1
            reach = up if sign > 0 else down
            size = max(1, int(round(abs(margin) / (reach or 1) * (zero if sign > 0
                                                                  else units - zero))))
            low, high = (zero - size, zero) if sign > 0 else (zero, zero + size)
            for row in range(rows):
                top_half = low <= 2 * row < high
                bottom_half = low <= 2 * row + 1 < high
                if top_half and bottom_half:
                    grid[row][x] = ("█", styles[sign])
                elif top_half:
                    grid[row][x] = ("▀", styles[sign])
                elif bottom_half:
                    grid[row][x] = ("▄", styles[sign])
    lines = []
    for row in range(rows):
        if row == min(rows - 1, zero // 2):
            label = Line().add(f"{'0':<{label_w - 1}}", "muted")
        elif row == 0 and up:
            label = Line().add(f"+{up:<{label_w - 2}}"[:label_w - 1], styles[1])
        elif row == rows - 1 and down:
            label = Line().add(f"+{down:<{label_w - 2}}"[:label_w - 1], styles[-1])
        else:
            label = Line().add(" " * (label_w - 1), "normal")
        line = Line(list(label)).add(" ", "normal")
        for text, style in grid[row]:
            line.add(text, style)
        lines.append(merge_spans(line))
    starts = []
    axis, marks = [" "] * cols, [" "] * cols
    for number in range(1, periods + 1):
        start = sum(bball_period_length(league, n) for n in range(1, number))
        col = int(start / end * cols) if end else 0
        if number > 1:
            starts.append(start / end * count if end else 0)
        if col < cols:
            axis[col] = "┴"
            for i, ch in enumerate(bball_period_name(league, number)):
                if col + 1 + i < cols:
                    marks[col + 1 + i] = ch
    if pictures:
        spec = {"cols": label_w + cols, "rows": rows, "x0": label_w,
                "margins": tuple(margins), "up": up, "down": down, "zero": zero / units,
                "home": team_hex(league, home), "away": team_hex(league, away),
                "periods": tuple(round(s, 2) for s in starts)}
        number = underlay_number(("flowcols", repr(spec)),
                                 lambda cw, ch, s=spec: flowcol_png(s, cw, ch),
                                 label_w + cols, rows)
        lines = underlay_lines(lines, number)
    lines.append(Line().add(" " * label_w, "normal").add("".join(axis), "border"))
    lines.append(Line().add(" " * label_w, "normal").add("".join(marks), "muted"))
    changes, ties, biggest = bball_lead_facts(timeline)
    legend = Line().add(" " * label_w, "normal")
    legend.add(home["abbr"], THEME.style(league, home, bold=True, fallback="accent"))
    legend.add(" ahead above · ", "muted")
    legend.add(away["abbr"], THEME.style(league, away, bold=True, fallback="accent"))
    legend.add(" below · ", "muted")
    legend.add(f"{changes} lead change{'s' if changes != 1 else ''}, tied {ties} "
               f"time{'s' if ties != 1 else ''}", "dim")
    lines.append(fit_line(legend, width))
    return lines


def bball_flow_lines(summary, event, league, width):
    """The flow with its heading, for the top of the Plays tab: a column
    chart since 6.21.0."""
    try:
        lines = flow_column_lines(summary, event, league, width)
    except Exception:  # noqa: BLE001 - the braille chart as before
        lines = bball_flow(summary, event, league, width)
    if not lines:
