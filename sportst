def _clock_seconds(text):
    """'24:31' -> 1471 seconds; None for anything else."""
    found = re.fullmatch(r"\s*(\d+):(\d{2})\s*", str(text or ""))
    return int(found.group(1)) * 60 + int(found.group(2)) if found else None


def _clock_text(seconds):
    return f"{int(seconds) // 60}:{int(seconds) % 60:02d}"


def hockey_more_leaders(summary, event, league, width, players=None):
    """MORE LEADERS for hockey (7.0.0), a team a row: each side's leader in
    shots, hits, blocked shots, faceoffs, ice time, plus-minus and takeaways
    - whichever the box score carries - as many as fit."""
    players = players if players is not None else hockey_box_players(summary)
    if not players["away"] and not players["home"]:
        return []

    def best(side, value):
        top, score = None, None
        for player in players[side]:
            number = value(player["stats"])
            if number is not None and number > 0 and (score is None or number > score):
                top, score = player, number
        return top, score

    def faceoffs(stats):
        won, lost = _num(stats.get("FW")), _num(stats.get("FL"))
        if won is None or lost is None or won + lost < 5:
            return None
        return won + (won - lost) / 100.0        # most won, the better record first
    columns = []
    for header, value, show in (
            # ESPN's NHL box has shots on goal under S (its SOG stays 0), the AHL's
            # under SOG
            ("Shots", lambda st: _num(st.get("S") if "S" in st else st.get("SOG")),
             lambda st: st.get("S") if "S" in st else st.get("SOG", "")),
            ("Ice time", lambda st: _clock_seconds(st.get("TOI")), lambda st: st.get("TOI", "")),
            ("Faceoffs", faceoffs, lambda st: f"{st.get('FW', '')}-{st.get('FL', '')}"),
            ("Hits", lambda st: _num(st.get("HT")), lambda st: st.get("HT", "")),
            ("Blocks", lambda st: _num(st.get("BS")), lambda st: st.get("BS", "")),
            ("Plus-minus", lambda st: _num(st.get("+/-")),
             lambda st: ("+" if not str(st.get("+/-", "")).startswith(("+", "-")) else "")
             + str(st.get("+/-", ""))),
            ("Takeaways", lambda st: _num(st.get("TK")), lambda st: st.get("TK", "")),
            ("Penalty min", lambda st: _num(st.get("PIM")), lambda st: st.get("PIM", ""))):
        cells, found = [], False
        for side in ("away", "home"):
            top, _ = best(side, value)
            found = found or top is not None
            cells.append(f"{cut_text(top['short'], 15)} {show(top['stats'])}" if top else "—")
        if found:
            columns.append((header, cells[0], cells[1], None))
    return team_columns_table("More leaders", columns, event, league, width, align="<")


# the kinds of shot ESPN's play text names, in the order the box shows them
HOCKEY_SHOT_KINDS = [("Wrist", r"wrist"), ("Snap", r"snap"), ("Slap", r"slap"),
                     ("Backhand", r"backhand"), ("Tip / deflection", r"tip|deflect|batted"),
                     ("Wraparound", r"wrap")]


def hockey_on_goal_plays(summary, event):
    """Each side's shots on goal from the play by play: [(play, side, is a
    goal)] - shots and goals only (7.0.0)."""
    out = []
    ids = {str(event["away"].get("id")): "away", str(event["home"].get("id")): "home"}
    for play in hockey_shot_plays(summary):           # the AHL's shots ride beside
        kind = clean(dig(play, "type", "text", default="") or "")
        if kind not in ("Shot", "Goal"):
            continue
        side = ids.get(str(dig(play, "team", "id", default="") or ""))
        if side:
            out.append((play, side, kind == "Goal"))
    return out


def hockey_shot_types(summary, event, league, width):
    """SHOT TYPES (7.0.0), a team a row: its shots on goal by kind - wrist,
    snap, slap, backhand, tips and deflections, wraparounds - with the goals
    each brought in brackets."""
    shots = hockey_on_goal_plays(summary, event)
    if len(shots) < 4:
        return []
    columns = []
    for header, pattern in HOCKEY_SHOT_KINDS:
        counts = {"away": [0, 0], "home": [0, 0]}
        for play, side, goal in shots:
            if re.search(pattern, play.get("text") or "", re.I):
                counts[side][0] += 1
                counts[side][1] += 1 if goal else 0
        if counts["away"][0] or counts["home"][0]:
            cells = [f"{c[0]}" + (f" ({c[1]})" if c[1] else "") for c in
                     (counts["away"], counts["home"])]
            columns.append((header, cells[0], cells[1],
                            _better(counts["away"][0], counts["home"][0])))
    return team_columns_table("Shot types", columns, event, league, width) if columns else []


def hockey_shot_distance(summary, event, league, width):
    """WHERE THE SHOTS CAME FROM (7.0.0), a team a row: its shots on goal by
    distance from the net (from the play by play's spots: inside 20 feet, 20
    to 40, beyond 40), the average, and the goals' average."""
    shots = [(p, side, goal) for p, side, goal in hockey_on_goal_plays(summary, event)
             if isinstance(dig(p, "coordinate", "x"), (int, float)) and
             isinstance(dig(p, "coordinate", "y"), (int, float))]
    if len(shots) < 4:
        return []
    data = {"away": [], "home": []}
    for play, side, goal in shots:
        x, y = float(play["coordinate"]["x"]), float(play["coordinate"]["y"])
        data[side].append((((89 - abs(x)) ** 2 + y ** 2) ** 0.5, goal))
    columns = []

    def avg(values):
        return sum(values) / len(values) if values else None
    rows = [("Inside 20 ft", lambda d: sum(1 for v, _ in d if v < 20), True, "{:.0f}"),
            ("20 to 40 ft", lambda d: sum(1 for v, _ in d if 20 <= v < 40), None, "{:.0f}"),
            ("Beyond 40 ft", lambda d: sum(1 for v, _ in d if v >= 40), None, "{:.0f}"),
            ("Average", lambda d: avg([v for v, _ in d]), False, "{:.0f} ft"),
            ("Goals' average", lambda d: avg([v for v, g in d if g]), None, "{:.0f} ft")]
    for header, value, higher, fmt in rows:
        a, h = value(data["away"]), value(data["home"])
        if a is None and h is None:
            continue
        columns.append((header, fmt.format(a) if a is not None else "—",
                        fmt.format(h) if h is not None else "—",
                        _better(a, h, higher) if higher is not None else None))
    return team_columns_table("Where the shots came from", columns, event, league, width)


def hockey_ice_time(summary, event, league, width, players=None):
    """SPECIAL TEAMS TIME (7.0.0), a team a row, from the skaters' ice time:
    time on the power play (its skaters' minutes over five - the other side
    killed it as long), shifts and the average shift."""
    players = players if players is not None else hockey_box_players(summary)
    columns = []
    sums = {}
    for side in ("away", "home"):
        totals = {"PPTOI": 0, "SHTOI": 0, "TOI": 0, "SHFT": 0, "seen": False}
        for player in players[side]:
            for column in ("PPTOI", "SHTOI", "TOI"):
                seconds = _clock_seconds(player["stats"].get(column))
                if seconds is not None:
                    totals[column] += seconds
                    totals["seen"] = True
            totals["SHFT"] += _num(player["stats"].get("SHFT")) or 0
        sums[side] = totals
    if not (sums["away"]["seen"] and sums["home"]["seen"]):
        return []
    a, h = sums["away"], sums["home"]
    columns.append(("Power play time", _clock_text(a["PPTOI"] / 5),
                    _clock_text(h["PPTOI"] / 5), _better(a["PPTOI"], h["PPTOI"])))
    if a["SHFT"] and h["SHFT"]:
        columns.append(("Shifts", f"{a['SHFT']:.0f}", f"{h['SHFT']:.0f}", None))
        columns.append(("Average shift", f"{a['TOI'] / a['SHFT']:.0f} s",
                        f"{h['TOI'] / h['SHFT']:.0f} s", None))
    return team_columns_table("Special teams time", columns, event, league, width)


def hockey_penalty_table(summary, event, league, width):
    """PENALTIES (7.0.0), a team a row: its minors, majors, misconducts and
    fights, who took the most and who drew the most (when someone had two),
    and what it was called for - the team stats only count them."""
    ids = {str(event["away"].get("id")): "away", str(event["home"].get("id")): "home"}
    data = {side: {"minor": 0, "major": 0, "misconduct": 0, "fight": 0,
                   "took": {}, "drew": {}, "calls": {}} for side in ("away", "home")}
    seen = False
    for play in dig(summary, "plays", default=[]) or []:
        if not _is_penalty(play):
            continue
        side = ids.get(str(dig(play, "team", "id", default="") or ""))
        if not side:
            continue
        seen = True
        row = data[side]
        call = clean(dig(play, "type", "text", default="") or "")
        text = clean(play.get("text") or "")
        if call.lower() == "penalty" and " - " in text:          # the AHL's
            call = text.split(" - ", 1)[1]
        kind = clean(dig(play, "type", "penaltyType", default="") or "").lower()
        minutes = _int(play.get("minutes") or dig(play, "type", "penaltyMinutes",
                                                  default=0) or 0)
        if "fight" in (call + " " + text).lower():
            row["fight"] += 1
        elif "misconduct" in (kind + " " + call).lower() or minutes == 10:
            row["misconduct"] += 1
        elif kind.startswith("major") or kind.startswith("match") or minutes >= 5:
            row["major"] += 1
        else:
            row["minor"] += 1
        call = re.sub(r"\s*\((?:maj|min|minor|major)\)$", "", call, flags=re.I)
        if call:
            row["calls"][call] = row["calls"].get(call, 0) + 1
        found = re.match(r"(.+?) (?:Fighting|%s) against (.+?)(?: served by .*)?$"
                         % re.escape(call), text) if call else None
        taker = found.group(1) if found else (text.split(" - ", 1)[0] if " - " in text
                                               else "")
        if taker and len(taker) < 40:
            short = short_name(taker)
            row["took"][short] = row["took"].get(short, 0) + 1
        if found and "fight" not in call.lower():
            short = short_name(found.group(2))
            row["drew"][short] = row["drew"].get(short, 0) + 1
    if not seen:
        return []

    def most(counts):
        if not counts:
            return "—"
        name, number = max(counts.items(), key=lambda item: item[1])
        return f"{cut_text(name, 15)} {number}" if number >= 2 else "—"
    a, h = data["away"], data["home"]
    columns = [("Minors", str(a["minor"]), str(h["minor"]), None)]
    for key, header in (("major", "Majors"), ("misconduct", "Misconducts"),
                        ("fight", "Fights")):
        if a[key] or h[key]:
            columns.append((header, str(a[key]), str(h[key]), None))
    for key, header in (("took", "Took most"), ("drew", "Drew most")):
        cells = [most(a[key]), most(h[key])]
        if cells != ["—", "—"]:
            columns.append((header, cells[0], cells[1], None))
    calls = []
    for row in (a, h):
        names = sorted(row["calls"], key=lambda c: (-row["calls"][c], c))
        calls.append(", ".join(f"{c}" + (f" ×{row['calls'][c]}" if row["calls"][c] > 1 else "")
                               for c in names) or "—")
    used = max(len(event["away"]["abbr"]), len(event["home"]["abbr"])) + 2 + \
        sum(max(len(c[0]), len(c[1]), len(c[2])) + 3 for c in columns)
    room = width - used
    if room >= 14:
        columns.append(("Called for", cut_text(calls[0], room), cut_text(calls[1], room), None))
    return team_columns_table("Penalties", columns, event, league, width, align="<")


# 7.0.0: a baseball play's text, read for the batter's result - the first that
# matches, in this order, so a sacrifice fly is not just a fly out and a
# strikeout the catcher dropped is still a strikeout
BASEBALL_RESULTS = [
    ("HR", r"\bhomered\b|\bhome run\b"),
    ("3B", r"\btripled\b"),
    ("2B", r"\bdoubled\b|\bground-rule double\b"),
    ("1B", r"\bsingled\b|\bbunt single\b|\binfield single\b"),
    ("IBB", r"\bintentionally walked\b"),
    ("BB", r"\bwalked\b"),
    ("HBP", r"\bhit by (?:a )?pitch\b"),
    ("SF", r"\bsacrifice fly\b|, SF\b"),
    ("SAC", r"\bsacrifice bunt\b|\bsacrificed\b|, SAC\b"),
    ("K", r"\bstruck out\b"),
    ("DP", r"\bdouble play\b|\bgrounded into\b|\blined into\b|\btriple play\b"),
    ("FC", r"\bfielder'?s choice\b"),
    ("E", r"\breached\b[^;]*\berror\b|\bsafe at first on\b[^;]*\berror\b"),
    ("CI", r"\bcatcher'?s? interference\b"),
    ("GO", r"\bgrounded out\b|\bbunt(?:ed)? (?:ground ?)?out\b|\bground(?:ed)? out\b"),
    ("FO", r"\bflied out\b|\bfly out\b|\bflied into\b"),
    ("LO", r"\blined out\b"),
    ("PO", r"\bpopped (?:up|out)\b|\bfouled out\b|\binfield fly\b"),
]
BASEBALL_HITS = {"1B", "2B", "3B", "HR"}
BASEBALL_REACHED = BASEBALL_HITS | {"BB", "IBB", "HBP", "E", "CI"}
BASEBALL_NOT_AB = {"BB", "IBB", "HBP", "SF", "SAC", "CI"}
BASEBALL_NOT_IN_PLAY = {"K", "BB", "IBB", "HBP", "CI"}


def baseball_result_kind(text):
    """The batter's result in a play's text - 'HR', '1B', 'BB', 'K', 'GO' and
    so on (BASEBALL_RESULTS) - or None for a runner's play or a change. The
    batter's own clause is read (up to the first comma, so a runner 'doubled
    off first' is not a double), and college's ', SF' after it."""
    head = re.split(r"[;(]", text or "", maxsplit=1)[0]
    first = head.split(",", 1)[0]
    for kind, pattern in BASEBALL_RESULTS:
        if re.search(pattern, head if kind in ("SF", "SAC") else first, re.I):
            return kind
    return None


def _pitch_code(play):
    """One pitch of ESPN's MLB play by play as a letter: B ball, K called
    strike, S swinging strike, F foul, H hit by pitch, X put in play."""
    text = clean(play.get("text") or "")
    kind = clean(dig(play, "type", "text", default="") or "").lower()
    if "in play" in text.lower():
        return "X"
    if "hit by pitch" in kind or "hit by pitch" in text.lower():
        return "H"
    if "foul tip" in kind or "swinging" in kind or "swinging" in text.lower():
        return "S"
    if "foul" in kind or "foul" in text.lower():
        return "F"
    if "looking" in kind or "looking" in text.lower() or "called" in kind:
        return "K"
    if "ball" in kind or re.search(r"\bBall \d", text):
        return "B"
    return "X" if kind not in ("", "pitch") else "B"


def baseball_trail(summary):
    """Every plate appearance in a baseball game's play by play, in order
    (7.0.0): dicts of side (who batted), inning, top (bool), outs (before it),
    risp (a runner on second or third), kind (baseball_result_kind), runs
    (that scored on it), text, pitches (letters as _pitch_code's: from MLB's
    pitch by pitch, or the count college's text carries, as '(3-2 BKFBS)'),
    path (G, F, L or P where known), mph and types (the pitches', MLB).
    Plays that are not a batter's - a steal, a wild pitch - come as kind None
    with their runs, so the runs add up."""
    plays = dig(summary, "plays", default=[]) or []
    after = any(p.get("outs") == 3 for p in plays if isinstance(p, dict))
    out = []
    bases, outs_now, half_key = set(), 0, None
    pitches, speeds, types = [], [], []
    last_text = None
    for play in plays:
        if not isinstance(play, dict):
            continue
        period = play.get("period") or {}
        top = str(period.get("type") or "").lower().startswith("top")
        bottom = str(period.get("type") or "").lower().startswith("bot")
        if not (top or bottom):
            continue
        key = (_int(period.get("number")), top)
        if key != half_key:
            half_key, outs_now, bases = key, 0, set()
            pitches, speeds, types = [], [], []
        kind_text = clean(dig(play, "type", "text", default="") or "")
        text = clean(play.get("text") or "")
        if kind_text.startswith("Start Batter"):
            bases = {n for n, flag in ((1, "onFirst"), (2, "onSecond"), (3, "onThird"))
                     if play.get(flag)}
            pitches, speeds, types = [], [], []
            continue
        if text.startswith("Pitch ") or play.get("summaryType") == "P":
            pitches.append(_pitch_code(play))
            if isinstance(play.get("pitchVelocity"), (int, float)):
                speeds.append(float(play["pitchVelocity"]))
                types.append(clean(dig(play, "pitchType", "text", default="") or ""))
            continue
        if kind_text != "Play Result" or not text or text == last_text:
            continue
        last_text = text
        kind = play.get("resultKind") or baseball_result_kind(text)
        runs = len(re.findall(r"\bscor(?:ed|es)\b", text))
        if kind == "HR":
            runs += 1
        elif kind is None and re.search(r"\bstole home\b", text) and not runs:
            runs = 1
        before = outs_now if after else _int(play.get("outs"))
        entry = {"side": "away" if top else "home", "inning": key[0], "top": top,
                 "outs": before, "risp": bool(bases & {2, 3}), "kind": kind, "runs": runs,
                 "text": text, "pitches": [], "path": None, "mph": [], "types": []}
        if kind:
            counted = re.search(r"\((\d)-(\d)\s*([A-Z]*)\)", text)
            if pitches:
                entry["pitches"] = list(pitches)
            elif counted:
                seq = [c for c in counted.group(3) if c in "BKSFHI"]
                seq = ["B" if c == "I" else c for c in seq]
                if kind not in BASEBALL_NOT_IN_PLAY:
                    seq.append("X")
                elif kind == "HBP" and "H" not in seq:
                    seq.append("H")
                entry["pitches"] = seq
            entry["mph"], entry["types"] = list(speeds), list(types)
            path = clean(str(play.get("trajectory") or "")).upper()[:1]
            entry["path"] = {"B": "G"}.get(path, path) if path in "GFLPB" and path else None
            if entry["path"] is None and kind not in BASEBALL_NOT_IN_PLAY:
                head = re.split(r"[;(,]", text, maxsplit=1)[0].lower()
                if re.search(r"ground|bunt|through the (?:left|right) side|up the middle|"
                             r"double play", head):
                    entry["path"] = "G"
                elif re.search(r"\blined\b|line drive", head):
                    entry["path"] = "L"
                elif re.search(r"popped|pop up|fouled out|infield fly", head):
                    entry["path"] = "P"
                elif re.search(r"flied|fly|homered", head):
                    entry["path"] = "F"
            pitches, speeds, types = [], [], []
        out.append(entry)
        if after and kind:
            outs_now = max(outs_now, _int(play.get("outs")))
    return out


def _hit_direction(text):
    """Where a hit went, from the batter's clause of its text: left, center,
    right or infield."""
    head = re.split(r"[;(,]", text or "", maxsplit=1)[0].lower()
    if re.search(r"\bbunt\b|\bto (?:3b|ss|2b|1b|p|c|pitcher|catcher|third(?: base)?|"
                 r"shortstop|second(?: base)?|first(?: base)?)\b|\binfield single\b", head):
        return "infield"
    if re.search(r"\bleft\b|\blf\b", head):
        return "left"
    if re.search(r"\bright\b|\brf\b", head):
        return "right"
    if re.search(r"\bcenter\b|\bcf\b|up the middle", head):
        return "center"
    return None


def baseball_situational(summary, event, league, width, trail=None):
    """SITUATIONAL HITTING (7.0.0), a team a row: hits in at-bats with runners
    in scoring position, runs scored with two out, how many innings its
    leadoff man reached, its scoring innings and biggest, and the innings it
    went down in order."""
    trail = trail if trail is not None else baseball_trail(summary)
    batters = [t for t in trail if t["kind"]]
    if len(batters) < 12:
        return []
    details = {}
    for team in dig(summary, "boxscore", "teams", default=[]) or []:
        side = team.get("homeAway") or side_of(event, dig(team, "team", "id"))
        for group in team.get("details") or []:
            for stat in group.get("stats") or []:
                if stat.get("abbreviation") == "Team RISP" and side in ("away", "home"):
                    found = re.match(r"\s*(\d+)-(\d+)", stat.get("displayValue") or "")
                    if found:
                        details[side] = (int(found.group(1)), int(found.group(2)))
    data = {}
    for side in ("away", "home"):
        mine = [t for t in batters if t["side"] == side]
        risp = [t for t in mine if t["risp"] and t["kind"] not in BASEBALL_NOT_AB]
        hits, at_bats = details.get(side) or (sum(1 for t in risp if t["kind"] in BASEBALL_HITS),
                                              len(risp))
        halves = {}
        for t in trail:
            if t["side"] == side:
                halves.setdefault((t["inning"], t["top"]), []).append(t)
        leadoff = [h for h in halves.values() if any(t["kind"] for t in h)]
        reached = sum(1 for h in leadoff
                      if next(t for t in h if t["kind"])["kind"] in BASEBALL_REACHED)
        in_order = sum(1 for h in halves.values()
                       if len([t for t in h if t["kind"]]) == 3 and
                       not any(t["kind"] in BASEBALL_REACHED for t in h))
        two_out = sum(t["runs"] for t in trail if t["side"] == side and t["outs"] == 2)
        by_half = {k: sum(t["runs"] for t in h) for k, h in halves.items()}
        data[side] = {"risp": (hits, at_bats), "two": two_out,
                      "lead": (reached, len(leadoff)), "order": in_order, "halves": by_half}
    # the inning runs from the line score where there is one
    comps = {c.get("homeAway"): c for c in
             dig(summary, "header", "competitions", 0, "competitors", default=[]) or []}
    for side in ("away", "home"):
        scores = [_num(s.get("value") if s.get("value") is not None else s.get("displayValue"))
                  for s in (comps.get(side) or {}).get("linescores") or [] if isinstance(s, dict)]
        if scores and all(v is not None for v in scores):
            data[side]["innings"] = {n + 1: int(v) for n, v in enumerate(scores)}
        else:
            data[side]["innings"] = {k[0]: v for k, v in data[side]["halves"].items()}
    a, h = data["away"], data["home"]

    def big(side):
        innings = data[side]["innings"]
        if not innings or max(innings.values()) <= 0:
            return "—"
        top = max(innings.values())
        number = min(n for n, v in innings.items() if v == top)
        return f"{top} in the {ordinal_word(number)}"
    columns = []
    if a["risp"][1] or h["risp"][1]:
        columns.append(("With RISP", f"{a['risp'][0]}-for-{a['risp'][1]}",
                        f"{h['risp'][0]}-for-{h['risp'][1]}",
                        _better(a["risp"][0] / max(1, a["risp"][1]),
                                h["risp"][0] / max(1, h["risp"][1]))))
    columns.append(("Two-out runs", str(a["two"]), str(h["two"]), _better(a["two"], h["two"])))
    columns.append(("Leadoff on", f"{a['lead'][0]} of {a['lead'][1]}",
                    f"{h['lead'][0]} of {h['lead'][1]}",
                    _better(a["lead"][0], h["lead"][0])))
    scoring = [sum(1 for v in data[s]["innings"].values() if v > 0) for s in ("away", "home")]
    columns.append(("Scoring innings", str(scoring[0]), str(scoring[1]),
                    _better(scoring[0], scoring[1])))
    columns.append(("Biggest inning", big("away"), big("home"), None))
    columns.append(("Down in order", str(a["order"]), str(h["order"]),
                    _better(a["order"], h["order"], False)))
    return team_columns_table("Situational hitting", columns, event, league, width)


def baseball_run_sources(summary, event, league, width, trail=None):
    """HOW THE RUNS SCORED (7.0.0), a team a row: its runs by the play that
    brought them in - homers, other hits, outs (sacrifice flies, ground outs,
    fielder's choices), walks and hit batters, errors, and wild pitches,
    passed balls, balks and steals of home."""
    trail = trail if trail is not None else baseball_trail(summary)
    counts = {side: {} for side in ("away", "home")}
    for t in trail:
        if not t["runs"]:
            continue
        kind, text = t["kind"], t["text"].lower()
        if kind == "HR":
            bucket = "Homers"
        elif kind in BASEBALL_HITS:
            bucket = "Other hits"
        elif kind in ("BB", "IBB", "HBP", "CI"):
            bucket = "Walks / HBP"
        elif kind == "E" or (kind is None and "error" in text):
            bucket = "Errors"
        elif kind:
            bucket = "Outs"
        elif re.search(r"wild pitch|passed ball|balk|stole home", text):
            bucket = "WP / PB / balk"
        else:
            bucket = "Other"
        counts[t["side"]][bucket] = counts[t["side"]].get(bucket, 0) + t["runs"]
    if not counts["away"] and not counts["home"]:
        return []
    columns = []
    for bucket in ("Homers", "Other hits", "Outs", "Walks / HBP", "Errors", "WP / PB / balk",
                   "Other"):
        a, h = counts["away"].get(bucket, 0), counts["home"].get(bucket, 0)
        if a or h:
            columns.append((bucket, str(a), str(h), None))
    return team_columns_table("How the runs scored", columns, event, league, width)


def baseball_balls_in_play(summary, event, league, width, trail=None):
    """BALLS IN PLAY (7.0.0), a team a row, its batters': ground balls, fly
    balls, line drives and pop-ups (MLB's by the tracking, college's by the
    play's words), ground outs to air outs, and where its hits went."""
    trail = trail if trail is not None else baseball_trail(summary)
    batters = [t for t in trail if t["kind"]]
    if len(batters) < 12:
        return []
    data = {}
    for side in ("away", "home"):
        mine = [t for t in batters if t["side"] == side]
        paths = {key: sum(1 for t in mine if t["path"] == key) for key in "GFLP"}
        ground_outs = sum(1 for t in mine if t["kind"] in ("GO", "DP", "SAC") and
                          t["path"] in (None, "G"))
        air_outs = sum(1 for t in mine if t["kind"] in ("FO", "LO", "PO", "SF") or
                       (t["kind"] in ("DP",) and t["path"] in ("L", "F", "P")))
        where = {}
        for t in mine:
            if t["kind"] in BASEBALL_HITS:
                spot = _hit_direction(t["text"])
                if spot:
                    where[spot] = where.get(spot, 0) + 1
        data[side] = {"paths": paths, "go": ground_outs, "ao": air_outs, "where": where}
    a, h = data["away"], data["home"]
    if not any(a["paths"].values()) and not any(h["paths"].values()):
        return []
    columns = []
    for key, header in (("G", "Grounders"), ("F", "Fly balls"), ("L", "Liners"),
                        ("P", "Pop-ups")):
        columns.append((header, str(a["paths"][key]), str(h["paths"][key]), None))
    columns.append(("GO-AO", f"{a['go']}-{a['ao']}", f"{h['go']}-{h['ao']}", None))
    for key, header in (("left", "Hits to left"), ("center", "center"), ("right", "right"),
                        ("infield", "infield")):
        x, y = a["where"].get(key, 0), h["where"].get(key, 0)
        if x or y or key != "infield":
            columns.append((header, str(x), str(y), None))
    return team_columns_table("Balls in play", columns, event, league, width)


def baseball_pitch_counts(summary, event, league, width, trail=None):
    """PITCH BY PITCH (7.0.0), a team a row, its pitchers': first-pitch
    strikes, called and swinging strikes, fouls, the batters taken to three
    balls, and pitches a batter."""
    trail = trail if trail is not None else baseball_trail(summary)
    batters = [t for t in trail if t["kind"] and t["pitches"]]
    if len(batters) < 12:
        return []
    data = {}
    for side, other in (("away", "home"), ("home", "away")):
        faced = [t for t in batters if t["side"] == other]       # this side pitched
        if not faced:
            return []
        codes = [c for t in faced for c in t["pitches"]]
        first = sum(1 for t in faced if t["pitches"][0] in "KSFX")
        data[side] = {"first": first, "faced": len(faced),
                      "K": codes.count("K"), "S": codes.count("S"), "F": codes.count("F"),
                      "three": sum(1 for t in faced if t["pitches"].count("B") >= 3),
                      "per": len(codes) / len(faced)}
    a, h = data["away"], data["home"]
    pct = [round(100 * d["first"] / d["faced"]) for d in (a, h)]
    columns = [("First-pitch strikes", f"{pct[0]}%", f"{pct[1]}%", _better(pct[0], pct[1])),
               ("Swinging strikes", str(a["S"]), str(h["S"]), _better(a["S"], h["S"])),
               ("Called strikes", str(a["K"]), str(h["K"]), None),
               ("Fouls", str(a["F"]), str(h["F"]), None),
               ("Three-ball counts", str(a["three"]), str(h["three"]),
                _better(a["three"], h["three"], False)),
               ("Pitches a batter", f"{a['per']:.1f}", f"{h['per']:.1f}", None)]
    return team_columns_table("Pitch by pitch", columns, event, league, width,
                              note="each side's pitchers")


def baseball_pitch_mix(summary, event, league, width, trail=None):
    """PITCH MIX (7.0.0, where the play by play has the pitches - MLB), a team
    a row, its pitchers': the share of each kind of pitch with its average
    speed, the most used first, and the fastest pitch."""
    trail = trail if trail is not None else baseball_trail(summary)
    seen = {"away": {}, "home": {}}
    fastest = {"away": 0.0, "home": 0.0}
    for t in trail:
        pitcher = "home" if t["side"] == "away" else "away"
        for kind, mph in zip(t["types"], t["mph"]):
            if not kind:
                continue
            row = seen[pitcher].setdefault(kind, [0, 0.0])
            row[0] += 1
            row[1] += mph
            fastest[pitcher] = max(fastest[pitcher], mph)
    totals = {side: sum(n for n, _ in seen[side].values()) for side in seen}
    if totals["away"] < 30 or totals["home"] < 30:
        return []
    names = sorted(set(seen["away"]) | set(seen["home"]),
                   key=lambda k: -(seen["away"].get(k, [0])[0] / totals["away"] +
                                   seen["home"].get(k, [0])[0] / totals["home"]))
    short = {"Four-seam FB": "Four-seam", "Two-seam FB": "Two-seam", "Changeup": "Change",
             "Knuckle Curve": "Knuckle curve", "Split-Finger": "Splitter"}
    columns = []
    for name in names[:6]:
        cells = []
        for side in ("away", "home"):
            row = seen[side].get(name)
            cells.append(f"{100 * row[0] / totals[side]:.0f}% {row[1] / row[0]:.0f}"
                         if row else "—")
        columns.append((short.get(name, name), cells[0], cells[1], None))
    columns.append(("Fastest", f"{fastest['away']:.0f} mph", f"{fastest['home']:.0f} mph",
                    _better(fastest["away"], fastest["home"])))
    return team_columns_table("Pitch mix", columns, event, league, width,
                              note="each side's pitchers: share · average mph")


def game_stats_blocks(summary, event, league, extras=None):
    """The Game Stats tab's parts: (left, right). Left: the team stats (bars),
    the team's other numbers and the sport's own extras; right: the game
    leaders and the sport's others."""
    left = [stat_block(lambda w: team_stat_sections(summary, league, w)[0],
                       [("TEAM STATS", "title")], wide=True, move=False),
            stat_block(lambda w: more_stats_lines(summary, league, w),
                       [("MORE TEAM STATS", "title")], move=False)]
    right = [stat_block(lambda w: leader_table(summary, league, w) or [Line().add(
        "ESPN has not published game leaders for this game yet.", "dim")],
        [("GAME LEADERS", "title")], move=False)]
    if league in ("nhl", "ahl") and event:
        skaters = hockey_box_players(summary)
        left += [stat_block(lambda w: hockey_period_table(summary, event, league, w)),
                 stat_block(lambda w: hockey_attempt_lines(summary, event, league, w)),
                 stat_block(lambda w: hockey_goal_strengths(summary, event, league, w)),
                 # 7.0.0: what the box score and the play by play add
                 stat_block(lambda w: hockey_more_leaders(summary, event, league, w,
                                                          skaters), wide=True),
                 stat_block(lambda w: hockey_shot_types(summary, event, league, w)),
                 stat_block(lambda w: hockey_shot_distance(summary, event, league, w)),
                 stat_block(lambda w: hockey_penalty_table(summary, event, league, w),
                            wide=True),
                 stat_block(lambda w: hockey_ice_time(summary, event, league, w, skaters),
                            optional=True)]
        stars = (extras or {}).get("stars") or []
        if stars:
            right.append(stat_block(lambda w: [heading("Three stars")] +
                                    star_lines(stars, league, w)))
        right += [stat_block(lambda w: hockey_goalie_table(summary, event, league, w)),
                  stat_block(lambda w: hockey_bench_lines(summary, event, league, w, extras),
                             flex=True),
                  stat_block(lambda w: hockey_series_lines(summary, league, w))]
    elif sport_of(league) == "basketball" and event and not is_olympic(league):
        players = bball_box_players(summary)
        # 6.22.0: who else played (beside the periods' table, where it fits),
        # and the leaders GAME LEADERS leaves out
        left += [stat_block(lambda w: bball_period_table(summary, event, league, w)),
                 stat_block(lambda w: bball_depth_lines(summary, event, league, w, players)),
                 stat_block(lambda w: bball_four_factors(summary, event, league, w)),
                 stat_block(lambda w: bball_more_leaders(summary, event, league, w,
                                                         players), wide=True),
                 stat_block(lambda w: bball_points_from(summary, event, league, w))]
        right += [stat_block(lambda w: bball_top_lines(summary, event, league, w)),
                  stat_block(lambda w: bball_lead_lines(summary, event, league, w)),
                  stat_block(lambda w: bball_win_prob_lines(summary, event, league, w)),
                  stat_block(lambda w: bball_officials(summary, w), flex=True),
                  stat_block(lambda w: hockey_series_lines(summary, league, w))]
    elif sport_of(league) == "football" and event:
        facts = football_drive_facts(summary, event)
        totals = football_box_totals(summary)
        # 6.22.0: under By quarter and Efficiency, the defenses and the kicking
        # game; Longest last, so it is the first to cross to the other side
        left += [stat_block(lambda w: football_period_table(summary, event, league, w)),
                 stat_block(lambda w: football_efficiency(summary, event, league, w, facts)),
                 stat_block(lambda w: football_defense(summary, event, league, w, totals)),
                 stat_block(lambda w: football_special_teams(summary, event, league, w,
                                                             totals)),
                 stat_block(lambda w: football_field_position(event, league, w, facts)),
                 stat_block(lambda w: football_drive_results(event, league, w, facts)),
                 stat_block(lambda w: football_longest(summary, event, league, w, totals),
                            wide=True, optional=True)]
        right += [stat_block(lambda w: football_top_lines(summary, event, league, w)),
                  stat_block(lambda w: bball_win_prob_lines(summary, event, league, w)),
                  stat_block(lambda w: bball_officials(summary, w), flex=True)]
    elif is_baseball(league) and event:
        trail = baseball_trail(summary)
        left += [stat_block(lambda w: baseball_inning_table(summary, event, league, w),
                            move=False),
                 stat_block(lambda w: baseball_batting_compare(summary, event, league, w),
                            move=False),
                 stat_block(lambda w: baseball_mound_lines(summary, event, league, w),
                            move=False),
                 # 7.0.0: what the play by play adds
                 stat_block(lambda w: baseball_situational(summary, event, league, w, trail),
                            wide=True),
                 stat_block(lambda w: baseball_pitch_counts(summary, event, league, w, trail),
                            wide=True, optional=2)]
        right += [stat_block(lambda w: baseball_top_lines(summary, event, league, w)),
                  stat_block(lambda w: baseball_run_sources(summary, event, league, w, trail)),
                  stat_block(lambda w: bball_win_prob_lines(summary, event, league, w)),
                  stat_block(lambda w: bball_officials(summary, w), flex=True),
                  stat_block(lambda w: hockey_series_lines(summary, league, w)),
                  stat_block(lambda w: baseball_balls_in_play(summary, event, league, w,
                                                              trail), wide=True,
                             optional=3),
                  stat_block(lambda w: baseball_pitch_mix(summary, event, league, w, trail),
                             wide=True, optional=1)]
    return left, right


# -- football: the Game Stats tab's extras ------------------------------------

# a run or a completed pass (a 20-yard one is a big play)
FOOTBALL_RUN_PASS = re.compile(r"^(rush|rushing touchdown|pass reception|passing touchdown|"
                               r"pass completion)", re.I)
# plays that are not a snap of the offense
FOOTBALL_NOT_SNAP = re.compile(r"kickoff|extra point|two-point|2pt|timeout|end of|"
                               r"end period|two-minute|coin toss", re.I)


def game_plays(summary):
    """Every play of a game: the summary's own list, or football's drive by
    drive (the drive under way last)."""
    plays = dig(summary, "plays", default=None)
    if isinstance(plays, list) and plays:
        return plays
    out = []
    for drive in football_drives(summary):
        out.extend(play for play in drive.get("plays") or [] if isinstance(play, dict))
    return out


def football_drives(summary):
    """The game's drives in order, the one under way last (once, marked
    live)."""
    drives = [d for d in dig(summary, "drives", "previous", default=[]) or []
              if isinstance(d, dict)]
    current = dig(summary, "drives", "current", default=None)
    if isinstance(current, dict) and current.get("id") and \
            all(str(d.get("id")) != str(current.get("id")) for d in drives):
        drives.append(dict(current, live=True))
    return drives


def football_side(drive, event):
    """'away' or 'home': whose drive (or play) it is; None if neither."""
    ident = str(dig(drive, "team", "id", default="") or "")
    abbr = clean(dig(drive, "team", "abbreviation", default="") or "")
    for side in ("away", "home"):
        if (ident and ident == str(event[side].get("id"))) or \
                (abbr and abbr == event[side].get("abbr")):
            return side
    return None


def football_play_text(text):
    """A play as ESPN writes it, without the clock in front, the formation
    (Shotgun, No Huddle), jersey numbers, the holder and long snapper, the
    clock after a score or '1ST DOWN'."""
    text = clean(text or "")
    text = re.sub(r"^\(\d{1,2}:\d{2}\)\s*", "", text)
    text = re.sub(r"^(\(?(no huddle|shotgun|pistol|under center)[-, ]*\)?\s*)+", "", text,
                  flags=re.I)
    text = re.sub(r"\s*\((H|LS):[^)]*\)", "", text)
    text = re.sub(r"#\d{1,2}\s+(?=[A-Z][\w'-]*\.)", "", text)    # #4 D.Dampier
    text = re.sub(r",?\s*clock \d{1,2}:\d{2}", "", text, flags=re.I)
    text = re.sub(r",?\s*1ST DOWN\b", "", text)
    return re.sub(r"\s{2,}", " ", text).strip(" ,")


def football_result_kind(drive):
    """How a drive ended, as the Game Stats tab counts it: TD, FG, Punt,
    Turnover, Downs, Missed FG, Safety, End of half; '' for one under way."""
    if drive.get("live"):
        return ""
    text = clean(drive.get("shortDisplayResult") or drive.get("displayResult")
                 or drive.get("result") or "").upper()
    if not text:
        return ""
    if "SAFETY" in text:
        return "Safety"
    if "INT" in text or "FUMBLE" in text:
        return "Turnover"
    if "TD" in text or "TOUCHDOWN" in text:
        return "TD"
    if ("FG" in text or "FIELD GOAL" in text) and any(
            word in text for word in ("MISS", "BLOCK", "NO GOOD")):
        return "Missed FG"
    if "FG" in text or "FIELD GOAL" in text:
        return "FG"
    if "PUNT" in text:
        return "Punt"
    if "DOWNS" in text:
        return "Downs"
    if "END OF" in text or "HALF" in text or "GAME" in text:
        return "End of half"
    return "Other"


def football_drive_facts(summary, event):
    """Each drive with what the Game Stats extras need: whose ('away' /
    'home'), where it began in yards from its own goal line, the points each
    side scored during it (from the scoring plays, the try after a touchdown
    with it), how it ended, its plays and yards, how close it got (yards to
    the end zone) and its 20-yard runs and catches."""
    scored, last = {}, (0, 0)
    for play in dig(summary, "scoringPlays", default=[]) or []:
        a, h = play.get("awayScore"), play.get("homeScore")
        if isinstance(a, int) and isinstance(h, int):
            scored[str(play.get("id"))] = (max(0, a - last[0]), max(0, h - last[1]))
            last = (a, h)
    out = []
    for drive in football_drives(summary):
        points, closest, big = [0, 0], None, 0
        offense = str(dig(drive, "team", "id", default="") or "")
        for play in drive.get("plays") or []:
            got = scored.get(str(play.get("id")))
            if got:
                points = [points[0] + got[0], points[1] + got[1]]
            kind = clean(dig(play, "type", "text", default="") or "")
            if str(dig(play, "start", "team", "id", default="") or "") != offense or \
                    FOOTBALL_NOT_SNAP.search(kind):
                continue
            togo = dig(play, "start", "yardsToEndzone")
            if isinstance(togo, (int, float)) and 0 < togo <= 100:
                closest = togo if closest is None else min(closest, togo)
            gained = play.get("statYardage")
            if FOOTBALL_RUN_PASS.match(kind) and isinstance(gained, (int, float)) and \
                    gained >= 20:
                big += 1
        side = football_side(drive, event)
        spot = drive_spot(drive.get("start"), event["away"], event["home"])
        own = None if spot is None or side is None else (spot if side == "away"
                                                         else 100 - spot)
        plays, yards = drive.get("offensivePlays"), drive.get("yards")
        out.append({"side": side, "own": own, "points": points,
                    "kind": football_result_kind(drive), "live": bool(drive.get("live")),
                    "plays": plays if isinstance(plays, (int, float)) else None,
                    "yards": yards if isinstance(yards, (int, float)) else None,
                    "closest": closest, "big": big})
    return out


def football_team_stats(summary):
    """{'away': {name: text}, 'home': {...}} from the box score's team stats."""
    out, home_id = {}, ""
    for comp in dig(summary, "header", "competitions", 0, "competitors", default=[]) or []:
        if comp.get("homeAway") == "home":
            home_id = str(comp.get("id") or dig(comp, "team", "id", default="") or "")
    for block in dig(summary, "boxscore", "teams", default=[]) or []:
        side = block.get("homeAway")
        if side not in ("home", "away"):
            side = "home" if str(dig(block, "team", "id", default="")) == home_id else "away"
        stats = {}
        for stat in block.get("statistics") or []:
            name = stat.get("name")
            if name and name not in stats:
                stats[name] = clean(str(stat.get("displayValue") or ""))
        out[side] = stats
    return out


def football_compare(title, note, rows, event, league, width):
    """A Game Stats part comparing the teams row by row: the label, the away
    team's number, a ◀ or ▶ (in the winner's colours) toward the side that
    won the row, the home team's. rows: (label, away text, home text,
    'away' / 'home' / None)."""
    rows = [row for row in rows if row[1] or row[2]]
    if not rows:
        return []
    away, home = event["away"], event["home"]
    label_w = max(len(row[0]) for row in rows) + 2
    a_w = max([len(row[1]) for row in rows] + [len(away["abbr"])])
    h_w = max([len(row[2]) for row in rows] + [len(home["abbr"])])
    lines = [cut_line(heading(title).add(f"  {note}" if note else "", "muted"), width)]
    head = Line().add(" " * label_w, "normal")
    head.add(f"{away['abbr']:>{a_w}}", THEME.style(league, away, bold=True, fallback="away"))
    head.add("   ", "normal").add(home["abbr"], THEME.style(league, home, bold=True,
                                                            fallback="home"))
    lines.append(cut_line(head, width))
    for label, a, h, better in rows:
        line = Line().add(f"{label:<{label_w}}", "muted")
        line.add(f"{a:>{a_w}}", "bold" if better == "away" else "normal")
        if better in ("away", "home"):
            team = event[better]
            line.add(" ◀ " if better == "away" else " ▶ ",
                     THEME.style(league, team, bold=True, fallback=better))
        else:
            line.add(" · ", "dim")
        line.add(f"{h:<{h_w}}", "bold" if better == "home" else "normal")
        lines.append(fit_line(line, width))
    return lines


def cut_line(line, width):
    """The line as it is, or cut to `width` when it is longer (never padded)."""
    return line if len(line.text) <= width else fit_line(line, max(0, width))


def _better(a, b, higher=True):
    """Which side's number wins a row: 'away', 'home' or None (a tie, or a
    number missing)."""
    if a is None or b is None or a == b:
        return None
    return "away" if (a > b) == higher else "home"


def football_period_table(summary, event, league, width):
    """Points in each quarter (and overtime) and the total, both teams."""
    scores = {}
    for comp in dig(summary, "header", "competitions", 0, "competitors", default=[]) or []:
        scores[comp.get("homeAway")] = [_int(s.get("displayValue") or s.get("value"))
                                        for s in comp.get("linescores") or []]
    if not scores.get("away") or not scores.get("home"):
        return []
    periods = max(len(scores["away"]), len(scores["home"]))
    heads = [""] + [period_tag(league, n) for n in range(1, periods + 1)] + ["T"]
    rows = []
    for side in ("away", "home"):
        values = scores[side] + [0] * (periods - len(scores[side]))
        rows.append([event[side]["abbr"]] + [str(v) for v in values] + [str(sum(values))])
    table = build_table(heads, rows, aligns=["<"] + [">"] * (periods + 1),
                        header_style="header", row_styles=["normal", "normal"], sep="  ")
    return [heading("By quarter")] + [fit_line(line, width) for line in table]


def football_efficiency(summary, event, league, width, facts=None):
    """Who won the game's efficiency battles: third and fourth downs, the red
    zone, turnovers and the points off them, 20-yard plays, yards a play and
    time of possession."""
    stats = football_team_stats(summary)
    if not stats.get("away") or not stats.get("home"):
        return []
    facts = facts if facts is not None else football_drive_facts(summary, event)
    rows = []

    def downs(name, label):
        a = made_attempted(stats["away"].get(name))
        h = made_attempted(stats["home"].get(name))
        if a[0] is None or h[0] is None or not (a[1] or h[1]):
            return
        rate = [m / t if t else None for m, t in (a, h)]
        text = [f"{m}/{t}" + (f" {m / t * 100:.0f}%" if t else "") for m, t in (a, h)]
        rows.append((label, text[0], text[1], _better(*rate)))
    downs("thirdDownEff", "3rd down")
    downs("fourthDownEff", "4th down")
    # the red zone (inside the opponent's 20): ESPN's TDs and trips where it
    # publishes them (the NFL), else counted from the drives
    trips = {}
    for side in ("away", "home"):
        made, tried = made_attempted(stats[side].get("redZoneAttempts"))
        if made is None:
            mine = [f for f in facts if f["side"] == side and f["closest"] is not None
                    and f["closest"] <= 20]
            made = sum(1 for f in mine if f["kind"] == "TD")
            tried = len(mine)
        trips[side] = (made, tried)
    if trips["away"][1] or trips["home"][1]:
        rate = [m / t if t else 0.0 for m, t in (trips["away"], trips["home"])]
        rows.append(("Red zone TDs", f"{trips['away'][0]}/{trips['away'][1]}",
                     f"{trips['home'][0]}/{trips['home'][1]}", _better(*rate)))
    turnovers = [stats[side].get("turnovers") for side in ("away", "home")]
    if all(t not in (None, "") for t in turnovers):
        rows.append(("Turnovers", turnovers[0], turnovers[1],
                     _better(_int(turnovers[0]), _int(turnovers[1]), higher=False)))
    points = {"away": 0, "home": 0}
    for index, fact in enumerate(facts):
        if fact["kind"] != "Turnover" or fact["side"] not in ("away", "home"):
            continue
        # the other side's points on the turnover itself (a return) and on
        # the drive it gave them
        other = "home" if fact["side"] == "away" else "away"
        at = 0 if other == "away" else 1
        after = facts[index + 1] if index + 1 < len(facts) else None
        points[other] += fact["points"][at] + (after["points"][at] if after and
                                               after["side"] == other else 0)
    if any(f["kind"] == "Turnover" for f in facts):
        rows.append(("Points off TOs", str(points["away"]), str(points["home"]),
                     _better(points["away"], points["home"])))
    big = {side: sum(f["big"] for f in facts if f["side"] == side) for side in ("away", "home")}
    if facts:
        rows.append(("20-yard plays", str(big["away"]), str(big["home"]),
                     _better(big["away"], big["home"])))
    per_play = []
    for side in ("away", "home"):
        value = football_count(stats[side].get("yardsPerPlay"))
        if not value:
            yards = football_count(stats[side].get("totalYards"))
            tries = football_made(stats[side].get("completionAttempts"))[1] + \
                football_count(stats[side].get("rushingAttempts")) + \
                (made_attempted(stats[side].get("sacksYardsLost"))[0] or 0)
            value = yards / tries if tries else None
        per_play.append(value)
    if all(v is not None for v in per_play):
        rows.append(("Yards a play", f"{per_play[0]:.1f}", f"{per_play[1]:.1f}",
                     _better(round(per_play[0], 1), round(per_play[1], 1))))
    held = [stats[side].get("possessionTime") or "" for side in ("away", "home")]
    if all(held):
        seconds = [clock_seconds(t) for t in held]
        rows.append(("Possession", held[0], held[1], _better(*seconds)))
    return football_compare("Efficiency", "◀ ▶ who won each", rows, event, league, width)


def football_field_position(event, league, width, facts):
    """Where each side's drives began and what they made of them: the average
    start, starts at midfield or better, plays, yards and points a drive,
    three-and-outs."""
    rows = []
    done = {side: [f for f in facts if f["side"] == side and not f["live"]]
            for side in ("away", "home")}
    if not done["away"] or not done["home"]:
        return []

    def mean(values):
        values = [v for v in values if v is not None]
        return sum(values) / len(values) if values else None

    starts = [mean([f["own"] for f in done[side]]) for side in ("away", "home")]
    if None not in starts:
        rows.append(("Average start", *[f"own {s:.0f}" if s <= 50 else f"opp {100 - s:.0f}"
                                        for s in starts], _better(*[round(s) for s in starts])))
    short = [sum(1 for f in done[side] if f["own"] is not None and f["own"] >= 50)
             for side in ("away", "home")]
    rows.append(("Started at 50+", str(short[0]), str(short[1]), _better(*short)))
    for label, key, digits in (("Plays a drive", "plays", 1), ("Yards a drive", "yards", 1)):
        values = [mean([f[key] for f in done[side]]) for side in ("away", "home")]
        if None not in values:
            rows.append((label, f"{values[0]:.{digits}f}", f"{values[1]:.{digits}f}",
                         _better(round(values[0], digits), round(values[1], digits))))
    scored = []
    for side in ("away", "home"):
        at = 0 if side == "away" else 1
        scored.append(sum(f["points"][at] for f in done[side]) / len(done[side]))
    rows.append(("Points a drive", f"{scored[0]:.2f}", f"{scored[1]:.2f}",
                 _better(round(scored[0], 2), round(scored[1], 2))))
    quick = [sum(1 for f in done[side] if f["kind"] == "Punt" and f["plays"] is not None
                 and f["plays"] <= 3) for side in ("away", "home")]
    rows.append(("Three and outs", str(quick[0]), str(quick[1]),
                 _better(*quick, higher=False)))
    return football_compare("Field position", "drives over", rows, event, league, width)


def football_drive_results(event, league, width, facts):
    """How each side's drives ended: touchdowns, field goals, punts,
    turnovers, on downs, missed field goals, safeties, the ends of halves."""
    done = [f for f in facts if f["side"] in ("away", "home") and f["kind"]]
    if not done:
        return []
    counts = {side: {} for side in ("away", "home")}
    for fact in done:
        counts[fact["side"]][fact["kind"]] = counts[fact["side"]].get(fact["kind"], 0) + 1
    rows = []
    for kind, label, higher in (("TD", "Touchdowns", True), ("FG", "Field goals", True),
                                ("Punt", "Punts", False), ("Turnover", "Turnovers", False),
                                ("Downs", "On downs", False), ("Missed FG", "Missed FGs", False),
                                ("Safety", "Safeties", False), ("End of half", "End of half", None),
                                ("Other", "Other", None)):
        a, h = counts["away"].get(kind, 0), counts["home"].get(kind, 0)
        if a or h:
            rows.append((label, str(a), str(h), _better(a, h, higher) if higher is not None
                         else None))
    totals = [sum(counts[side].values()) for side in ("away", "home")]
    rows.append(("Drives", str(totals[0]), str(totals[1]), None))
    return football_compare("Drive results", "how they ended", rows, event, league, width)


def football_top_lines(summary, event, league, width, count=5):
    """The game's best by fantasy points, for the Game Stats tab: each with
    every line he put up."""
    players = []
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        side = "home" if str(dig(block, "team", "id", default="")) == \
            str(event["home"].get("id")) else "away"
        found = {}
        for section in block.get("statistics") or []:
            labels = [clean(l) for l in section.get("labels") or []]
            for entry in section.get("athletes") or []:
                ident = str(dig(entry, "athlete", "id", default="") or "")
                name = clean(dig(entry, "athlete", "shortName", default="")
                             or dig(entry, "athlete", "displayName", default=""))
                if not ident or not name:
                    continue
                found.setdefault(ident, {"name": name, "team": event[side], "lines": []})
                found[ident]["lines"].append(
                    (clean(section.get("name") or ""),
                     dict(zip(labels, [clean(s) for s in entry.get("stats") or []]))))
        players.extend(found.values())
    ranked = sorted(((football_points(p["lines"]), p) for p in players),
                    key=lambda item: -item[0])
    ranked = [(value, p) for value, p in ranked if value > 0][:count]
    if not ranked:
        return []
    lines = [heading("Top performers").add("  by fantasy points", "muted")]
    name_w = min(22, max(len(p["name"]) for _, p in ranked))
    for place, (value, player) in enumerate(ranked, 1):
        team = player["team"]
        line = Line().add(f"{place:>2} ", "muted").add(f"{team['abbr']:<5}", THEME.style(
            league, team, bold=True, fallback="accent"))
        line.add(f"{player['name'][:name_w]:<{name_w + 1}}", "normal").add(f"{value:5.1f}  ",
                                                                          "bold")
        parts = []
        for group, stats in sorted(player["lines"], key=lambda item: -football_points([item])):
            text = football_compact(group, stats)
            kind = football_group(group)
            if text:
                parts.append(f"{FOOTBALL_TAGS.get(kind, kind)} {text}")
        lines.append(fit_line(line.add(" · ".join(parts), "dim"), width))
    return lines


def render_game_leaders(summary, league, width, heading=True):
    """ESPN's Game Leaders card: each category, away leader then home."""
    if is_baseball(league):
        return render_baseball_leaders(summary, league, width, heading)
    blocks = dig(summary, "leaders", default=[]) or []
    if not blocks:
        return []
    home_block, away_block = split_by_side(blocks, summary)
    ordered = [b for b in (away_block, home_block) if b is not None]
    if not ordered:
        return []
    categories = []
    for block in ordered:
        for category in block.get("leaders") or []:
            name = category.get("name") or category.get("displayName")
            if name and name not in categories:
                categories.append(name)

    # the leaders payload carries a thin team object; the game header has the
    # full one, which is what the colour lookup needs
    known = {t["id"]: t for t in summary_teams(summary) if t}
    name_width = clamp(width - 30, 14, 26)
    lines = [Line().add("Game leaders", "title"), rule(clamp(width, 20, 72))] if heading else []
    for name in categories:
        rows = []
        title = ""
        for block in ordered:
            team = known.get(block_team(block)["id"]) or block_team(block)
            entry = next((c for c in block.get("leaders") or []
                          if (c.get("name") or c.get("displayName")) == name), None)
            if not entry:
                continue
            title = title or clean(entry.get("displayName") or name)
            top = (entry.get("leaders") or [None])[0]
            if not top:
                continue
            athlete = clean(dig(top, "athlete", "shortName", default="")
                            or dig(top, "athlete", "displayName", default="?"))
            position = clean(dig(top, "athlete", "position", "abbreviation", default=""))
            main = top.get("mainStat") or {}
            value = clean(str(main.get("value") or "")) or clean(top.get("displayValue") or "")
            unit = clean(main.get("label") or "") if main else ""
            detail = clean(top.get("summary") or "")
            if not main and "," in value:  # older shape: '20/27, 212 YDS, 1 TD'
                detail, value = value, ""
            rows.append((team, athlete, position, value, unit, detail))
        if not rows:
            continue
        lines.append(Line().add(title, "accent"))
        for team, athlete, position, value, unit, detail in rows:
            who = f"{athlete} {position}".strip()
            row = Line().add("  ")
            row.add(f"{team['abbr']:<5}", THEME.style(league, team, bold=True, fallback="accent"))
            row.add(f"{who[:name_width]:<{name_width}}", "normal")
            row.add(f"{value:>5}", "bold")
            row.add(f" {unit:<6}" if unit else " " * 7, "muted")
            if detail:
                row.add(detail, "dim")
            lines.append(row)
        lines.append(blank())
    if lines and not lines[-1]:
        lines.pop()
    return lines


def winprob_chart(summary, away, home, league, width, height=9):
    points = []
    for node in dig(summary, "winprobability", default=[]) or []:
        value = node.get("homeWinPercentage")
        if isinstance(value, (int, float)):
            points.append(float(value))
    if len(points) < 4 or width < 24:
        return []

    plot_width = clamp(width - 8, 10, 160)
    grid = [[" "] * plot_width for _ in range(height)]
    total = len(points)
    for column in range(plot_width):
        low = int(column * total / plot_width)
        high = max(low + 1, int((column + 1) * total / plot_width))
        chunk = points[low:high] or [points[min(low, total - 1)]]
        average = sum(chunk) / len(chunk)
        row = int(round(average * (height - 1)))
        grid[clamp(row, 0, height - 1)][column] = "•"

    away_style = THEME.style(league, away, fallback="away")
    home_style = THEME.style(league, home, fallback="home")
    lines = [Line().add("Win probability", "title")]
    middle = height // 2
    for index, row in enumerate(grid):
        if index == 0:
            label = f"{away['abbr']:>5} "
        elif index == height - 1:
            label = f"{home['abbr']:>5} "
        elif index == middle:
            label = "  50% "
        else:
            label = "      "
        label_style = away_style if index == 0 else (
            home_style if index == height - 1 else "muted")
        style = away_style if index < middle else (home_style if index > middle else "muted")
        lines.append(Line().add(label, label_style).add("".join(row), style))
    lines.append(blank())
    return lines


