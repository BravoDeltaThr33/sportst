# the letters football's DOWN & DISTANCE spells (1ST & GOAL), kept apart so
# that no other big text changes
GOAL_FONT = dict(BIG_FONT, G=("###", "#  ", "# #", "# #", "###"),
                 O=("###", "# #", "# #", "# #", "###"),
                 A=("###", "# #", "###", "# #", "# #"),
                 L=("#  ", "#  ", "#  ", "#  ", "###"))


def big_text(text, mode="big", font=None):
    """A string in the dot font: 'big' is two columns a dot and five rows,
    'small' one column a dot in half blocks, three rows. `font` adds glyphs
    (GOAL_FONT)."""
    font = font or BIG_FONT
    glyphs = [font.get(ch, BIG_FONT[" "]) for ch in str(text)]
    if not glyphs:
        return []
    if mode == "big":
        rows = []
        for r in range(5):
            parts = ["".join("██" if px == "#" else "  " for px in g[r]) for g in glyphs]
            rows.append("  ".join(parts))
        return rows
    rows = []
    for top in (0, 2, 4):
        parts = []
        for g in glyphs:
            cells = ""
            for col in range(len(g[0])):
                upper = g[top][col] == "#"
                lower = top + 1 < 5 and g[top + 1][col] == "#"
                cells += "█" if upper and lower else "▀" if upper else "▄" if lower else " "
            parts.append(cells)
        rows.append(" ".join(parts))
    return rows


def big_width(text, mode="big"):
    rows = big_text(text, mode)
    return len(rows[0]) if rows else 0


# -- the score band's numbers in light bulbs (6.18.0) ---------------------------
#
# An old stadium scoreboard: every digit an 8 of light bulbs lit segment by
# segment, the bulbs a digit does not use left dark in their sockets, and a
# single-figure score showing its empty tens the same way ('~' in the text).
# In text a bulb is ● two columns from the next on the dot font's own 3 x 5
# grid, so nothing moves; in Kitty or Ghostty the number is a picture of real
# bulbs on a 4 x 7 grid, each lit one glowing, drawn here at the cells' size.

BULB = "●"
# the segments each digit lights: a top, b upper right, c lower right,
# d bottom, e lower left, f upper left, g middle
BULB_SEGMENTS = {"0": "abcdef", "1": "bc", "2": "abdeg", "3": "abcdg", "4": "bcfg",
                 "5": "acdfg", "6": "acdefg", "7": "abc", "8": "abcdefg", "9": "abcdfg",
                 "~": ""}
BULB_TEXT = {"lit": "FFC94A", "hot": "FFFFFF", "low": "9A7840"}  # a lit bulb, by tone
BULB_DARK = "3A342C"                                              # an unlit one
# a lit bulb in a picture, by tone: (its middle, its edge, its glow, how far
# the glow carries)
BULB_GLASS = {"lit": ((255, 250, 232), (255, 184, 66), (255, 160, 48), 0.55),
              "hot": ((255, 255, 255), (255, 238, 186), (255, 214, 130), 0.80),
              "low": ((206, 166, 106), (140, 98, 46), (130, 90, 30), 0.18)}
# the other characters' bulbs on the picture's 7-row grid: (row, columns
# from the middle), always lit
BULB_MARKS = {":": ((2, 0), (4, 0)), ".": ((6, 0),), "'": ((0, 0), (1, 0)),
              "-": ((3, -1.5), (3, -0.5), (3, 0.5), (3, 1.5)),
              "+": ((2, 0), (3, -1), (3, 0), (3, 1), (4, 0))}
_BULB_PATCHES = {}
_BULB_PICTURES = {}


def bulb_cells(char, width, height):
    """{(row, column): lit} of a digit's bulbs on a width x height grid (an 8:
    the top, middle and bottom rows and both sides); None for any other
    character."""
    segments = BULB_SEGMENTS.get(char)
    if segments is None:
        return None
    middle = height // 2
    spots = {"a": [(0, x) for x in range(width)],
             "g": [(middle, x) for x in range(width)],
             "d": [(height - 1, x) for x in range(width)],
             "f": [(y, 0) for y in range(middle + 1)],
             "e": [(y, 0) for y in range(middle, height)],
             "b": [(y, width - 1) for y in range(middle + 1)],
             "c": [(y, width - 1) for y in range(middle, height)]}
    cells = {}
    for segment, places in spots.items():
        for place in places:
            cells[place] = cells.get(place, False) or segment in segments
    return cells


def bulb_layout(text, mode):
    """[(character, first column, columns)] of the band's number and its
    width in cells: big_text's own columns ('~', an unlit digit, as wide as
    a digit)."""
    step, gap = (2, 2) if mode == "big" else (1, 1)
    out, x = [], 0
    for index, char in enumerate(str(text)):
        if index:
            x += gap
        glyph = BIG_FONT.get("8" if char == "~" else char, BIG_FONT[" "])
        out.append((char, x, len(glyph[0]) * step))
        x += len(glyph[0]) * step
    return out, x


def bulb_lines(text, tone="lit", unlit=BULB):
    """The band's number in text as an old scoreboard's bulbs, five rows:
    each digit an 8 of bulbs two columns apart, ● lit in the tone's colour
    and the rest `unlit` in the dark; exactly as wide as big_text(text)."""
    lit = f"@{BULB_TEXT.get(tone, BULB_TEXT['lit'])}~b"
    dark = f"@{BULB_DARK}"
    rows = [Line() for _ in range(5)]
    for index, char in enumerate(str(text)):
        if index:
            for row in rows:
                row.add("  ", "normal")
        cells = bulb_cells(char, 3, 5)
        if cells is None:
            glyph = BIG_FONT.get(char, BIG_FONT[" "])
            for r, row in enumerate(rows):
                for px in glyph[r]:
                    row.add(BULB + " " if px == "#" else "  ", lit if px == "#" else "normal")
            continue
        for r, row in enumerate(rows):
            for c in range(3):
                if (r, c) in cells:
                    row.add(BULB if cells[(r, c)] else unlit, lit if cells[(r, c)] else dark)
                    row.add(" ", "normal")
                else:
                    row.add("  ", "normal")
    return [merge_spans(row) for row in rows]


def bulb_spots(char, box_x, box_w, height, pitch):
    """[(x, y, lit)] of a character's bulbs in pixels: a digit's on a 4 x 7
    grid in the middle of its box, the rest as BULB_MARKS has them."""
    top = (height - 7 * pitch) / 2 + pitch / 2
    cells = bulb_cells(char, 4, 7)
    if cells is not None:
        left = box_x + (box_w - 4 * pitch) / 2 + pitch / 2
        return [(left + c * pitch, top + r * pitch, lit) for (r, c), lit in cells.items()]
    middle = box_x + box_w / 2
    return [(middle + dx * pitch, top + r * pitch, True) for r, dx in BULB_MARKS.get(char, ())]


def bulb_patch(char, tone, width, height, box_x, box_w, pitch):
    """A character of the band's number as rows of RGBA bytes: its box with
    the half gaps either side, where a lit bulb's glow fades out, so the
    patches of a number sit side by side with no seam. A lit bulb is warm
    white in the middle, amber at its edge, with a shine on the glass and a
    glow around it; an unlit one is dark glass in its socket. Kept once
    drawn."""
    key = (char, tone, width, height, box_x, box_w, round(pitch, 2))
    rows = _BULB_PATCHES.get(key)
    if rows is not None:
        return rows
    import math
    exp, sqrt = math.exp, math.sqrt
    core, edge, halo, strength = BULB_GLASS.get(tone, BULB_GLASS["lit"])
    radius = pitch * 0.40
    sigma = radius * 1.25
    reach = sigma * 2.4
    glow = [0.0] * (width * height)
    disk = {}
    shine_x, shine_y, shine_r = -0.32 * radius, -0.34 * radius, max(0.6, radius * 0.42)
    for bx, by, lit in bulb_spots(char, box_x, box_w, height, pitch):
        if lit:
            for py in range(max(0, int(by - reach)), min(height, int(by + reach) + 1)):
                dy = py + 0.5 - by
                row = py * width
                for px in range(max(0, int(bx - reach)), min(width, int(bx + reach) + 1)):
                    dx = px + 0.5 - bx
                    glow[row + px] += strength * exp(-(dx * dx + dy * dy) / (sigma * sigma))
        for py in range(max(0, int(by - radius - 1)), min(height, int(by + radius) + 2)):
            dy = py + 0.5 - by
            for px in range(max(0, int(bx - radius - 1)), min(width, int(bx + radius) + 2)):
                dx = px + 0.5 - bx
                d = sqrt(dx * dx + dy * dy)
                cover = min(1.0, radius - d + 0.5)
                if cover <= 0:
                    continue
                t = min(1.0, d / radius)
                spark = max(0.0, 1.0 - sqrt((dx - shine_x) ** 2 + (dy - shine_y) ** 2) / shine_r)
                if lit:
                    k = t ** 1.6
                    colour = [core[i] + (edge[i] - core[i]) * k for i in range(3)]
                    colour = [c + (255 - c) * spark * 0.5 for c in colour]
                else:
                    colour = [46 - 20 * t, 41 - 18 * t, 36 - 15 * t]
                    if t > 0.8:                         # the socket's rim
                        colour = [c + 16 for c in colour]
                    colour = [c + (150 - c) * spark * 0.35 for c in colour]
                disk[py * width + px] = (colour, cover)
    rows = []
    for py in range(height):
        out = bytearray(width * 4)
        for px in range(width):
            index = py * width + px
            alpha = min(1.0, glow[index])
            red, green, blue = halo[0] * alpha, halo[1] * alpha, halo[2] * alpha
            spot = disk.get(index)
            if spot:
                colour, cover = spot
                red = colour[0] * cover + red * (1 - cover)
                green = colour[1] * cover + green * (1 - cover)
                blue = colour[2] * cover + blue * (1 - cover)
                alpha = cover + alpha * (1 - cover)
            if alpha > 0.002:
                at = px * 4
                out[at] = max(0, min(255, int(red / alpha + 0.5)))
                out[at + 1] = max(0, min(255, int(green / alpha + 0.5)))
                out[at + 2] = max(0, min(255, int(blue / alpha + 0.5)))
                out[at + 3] = max(0, min(255, int(alpha * 255 + 0.5)))
        rows.append(bytes(out))
    if len(_BULB_PATCHES) > 200:
        _BULB_PATCHES.clear()
    _BULB_PATCHES[key] = rows
    return rows


def bulb_picture(text, mode, tone, width, height):
    """The band's number as a picture of an old scoreboard's light bulbs, a
    PNG of width x height pixels laid out cell for cell as bulb_layout has
    it (each character from a kept patch); b'' when it is too small for
    bulbs."""
    key = (str(text), mode, tone, width, height)
    if key in _BULB_PICTURES:
        return _BULB_PICTURES[key]
    layout, cols = bulb_layout(text, mode)
    if not layout or not cols or width < cols or height < 6:
        return b""
    scale = width / cols                       # pixels a cell
    pitch = min((6 if mode == "big" else 3) * scale / 4.5, height / 7.3)
    if pitch < 3:
        return b""
    gap = 2 if mode == "big" else 1
    patches = []
    for index, (char, x0, w) in enumerate(layout):
        left = 0 if index == 0 else x0 - gap / 2
        right = cols if index == len(layout) - 1 else x0 + w + gap / 2
        left_px, right_px = round(left * scale), round(right * scale)
        patches.append(bulb_patch(char, tone, right_px - left_px, height,
                                  round(x0 * scale) - left_px,
                                  round((x0 + w) * scale) - round(x0 * scale), pitch))
    rgba = b"".join(b"".join(patch[y] for patch in patches) for y in range(height))
    png = png_encode(width, height, rgba)
    if len(_BULB_PICTURES) > 24:
        _BULB_PICTURES.clear()
    _BULB_PICTURES[key] = png
    return png


def band_number(text, mode, tone, style, bulb_art=None):
    """The score band's number as [Line]: an old scoreboard's light bulbs -
    `bulb_art(text, mode, tone, cols, rows)` where it gives them (a picture,
    or bulbs in text), else ● bulbs in text on a big screen and the dot
    font in `style` on a small one."""
    if not text:
        return []
    if bulb_art:
        _, cols = bulb_layout(text, mode)
        try:
            shown = bulb_art(text, mode, tone, cols, 5 if mode == "big" else 3)
        except Exception:  # noqa: BLE001 - the bulbs in text will do
            shown = None
        if shown:
            return shown
    if mode == "big":
        return bulb_lines(text, tone)
    return [Line().add(row, style) for row in big_text(text.replace("~", ""), "small")]


ROUND_CORNERS = ("╭", "╮", "╰", "╯")


class Canvas:
    """A screen-sized grid of (character, style) cells to compose a layout
    with overlapping blocks, read back as Lines."""

    def __init__(self, width, height):
        self.width, self.height = max(1, width), max(1, height)
        self.cells = [[(" ", "normal") for _ in range(self.width)]
                      for _ in range(self.height)]

    def put(self, y, x, text, style="normal"):
        if not 0 <= y < self.height:
            return
        for index, ch in enumerate(str(text)):
            col = x + index
            if 0 <= col < self.width:
                self.cells[y][col] = (ch, style)

    def line(self, y, x, line, width=None):
        col = x
        limit = self.width if width is None else min(self.width, x + width)
        for text, style in line:
            for ch in text:
                if col >= limit:
                    return
                if 0 <= y < self.height and col >= 0:
                    self.cells[y][col] = (ch, style)
                col += 1

    def lines(self, y, x, lines, width=None, height=None):
        for index, line in enumerate(lines):
            if height is not None and index >= height:
                break
            self.line(y + index, x, line, width)

    def fill(self, y, x, width, height, ch=" ", style="normal"):
        for row in range(y, y + height):
            self.put(row, x, ch * max(0, width), style)

    def card(self, y, x, height, width, title, lines, corners=None, border="border"):
        """A bordered card: `title` (text, or (text, style) spans) in its top
        border and `lines` inside, a column in from each side; `border` the
        outline's style ("subborder" for a box inside a section)."""
        if height < 2 or width < 6:
            return
        tl, tr, bl, br = corners or ROUND_CORNERS
        self.put(y, x, tl + "─" * (width - 2) + tr, border)
        self.put(y + height - 1, x, bl + "─" * (width - 2) + br, border)
        for row in range(y + 1, y + height - 1):
            self.put(row, x, "│", border)
            self.put(row, x + 1, " " * (width - 2), "normal")
            self.put(row, x + width - 1, "│", border)
        spans = [(title, "title")] if isinstance(title, str) else list(title)
        if spans and spans[0][0]:
            head = Line().add(" ", spans[0][1]).extend_spans(spans).add(" ", spans[-1][1])
            self.line(y, x + 2, head, width - 4)
        self.lines(y + 1, x + 2, lines, width - 4, height - 2)

    def rows(self):
        out = []
        for row in self.cells:
            line = Line()
            for ch, style in row:
                if line and line[-1][1] == style:
                    line[-1] = (line[-1][0] + ch, style)
                else:
                    line.append((ch, style))
            out.append(line)
        return out


def _ink_on(hex_color):
    """Black or white text, whichever reads on a background colour."""
    rgb = hex_to_rgb("#" + hex_color.lstrip("#")) or (0, 0, 0)
    luma = 0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]
    return "111111" if luma > 150 else "FFFFFF"


def team_hex(league, team):
    """A team's banner colour as RRGGBB (its own colour, unlifted)."""
    color = THEME.color(league, team) or team.get("color") or ""
    color = str(color).lstrip("#")
    return color.upper() if re.fullmatch(r"[0-9A-Fa-f]{6}", color) else "5A5A5A"


def braille_curve(points, width, height):
    """Rows of braille for a line through `points` (0..1, top is 0): two dots
    a column, four a row."""
    width, height = max(2, width), max(1, height)
    dots_w, dots_h = width * 2, height * 4
    grid = [[0] * width for _ in range(height)]
    bits = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))
    if not points:
        return ["" for _ in range(height)]
    total = len(points)
    previous = None
    for col in range(dots_w):
        low = int(col * total / dots_w)
        high = max(low + 1, int((col + 1) * total / dots_w))
        chunk = points[low:high] or [points[min(low, total - 1)]]
        value = sum(chunk) / len(chunk)
        y = int(round(clamp(value, 0.0, 1.0) * (dots_h - 1)))
        span = [y] if previous is None else list(range(min(previous, y), max(previous, y) + 1))
        for yy in span:
            grid[yy // 4][col // 2] |= bits[yy % 4][col % 2]
        previous = y
    return ["".join(chr(0x2800 + cell) if cell else " " for cell in row) for row in grid]


def center_score_word(league, delta):
    sport = sport_of(league)
    word = SCORE_WORDS.get(sport, {}).get(delta)
    if word:
        return word
    if sport == "baseball":
        return f"{delta} RUNS SCORE"
    if sport == "hockey":
        return f"{delta} GOALS"
    if sport == "soccer":
        return "GOAL"
    return ""


def _yard_from_text(text, away, home):
    """Where the ball is, 0 (the away goal line, on the left) to 100 (the
    home goal line), from ESPN's 'NEV 27' or '50'."""
    text = clean(text or "").strip()
    match = re.match(r"^([A-Za-z&.' ]+?)\s*(\d{1,2})$", text)
    if text == "50" or text.endswith(" 50"):
        return 50
    if not match:
        return None
    side, number = match.group(1).strip().upper(), int(match.group(2))
    if side == str(home.get("abbr") or "").upper():
        return 100 - number
    if side == str(away.get("abbr") or "").upper():
        return number
    return None


def render_field(event, league, width, offense_hint=""):
    """A football field across `width` columns: end zones in team colours,
    the ball, the blue line of scrimmage and the yellow first-down line, then
    the down and distance."""
    away, home = event["away"], event["home"]
    situation = event.get("situation") or {}
    zone = 4
    field = max(40, width - 2 * zone - 2)
    left = zone + 1
    green = FIELD_GREEN

    def col(yard):
        return left + int(round(clamp(yard, 0, 100) * (field - 1) / 100))

    canvas = Canvas(width, 6)
    # yard numbers
    for yard in range(10, 100, 10):
        label = str(yard if yard <= 50 else 100 - yard)
        canvas.put(0, col(yard) - len(label) // 2, label, "dim")
    # the grass, the yard lines and the hash marks
    for row in (1, 2, 3):
        canvas.fill(row, left, field, 1, " ", f"@{FIELD_LINE}:{green}")
        for yard in range(0, 101, 5):
            ch = "│" if yard % 10 == 0 else "╎"
            canvas.put(row, col(yard), ch, f"@{FIELD_LINE}:{green}")
    # end zones
    for team, x in ((away, 0), (home, left + field)):
        color = team_hex(league, team)
        ink = _ink_on(color)
        canvas.fill(1, x, zone, 3, " ", f"@{ink}:{color}")
        label = (team.get("abbr") or "")[:zone]
        canvas.put(2, x + max(0, (zone - len(label)) // 2), label, f"@{ink}:{color}~b")
    ball = _yard_from_text(situation.get("possessionText"), away, home)
    possession = str(situation.get("possession") or "")
    offense = "home" if possession and possession == str(home.get("id")) else \
        "away" if possession and possession == str(away.get("id")) else offense_hint
    down_text = clean(situation.get("downDistanceText") or "")
    if ball is not None and event["state"] == "in":
        distance = situation.get("distance")
        if offense and isinstance(distance, (int, float)) and distance > 0:
            step = distance if offense == "away" else -distance
            target = 100 if "goal" in down_text.lower() and offense == "away" else \
                0 if "goal" in down_text.lower() else ball + step
            for row in (1, 2, 3):
                canvas.put(row, col(target), "┃", f"@{FIRST_DOWN}:{green}~b")
        for row in (1, 2, 3):
            canvas.put(row, col(ball), "┃", f"@{SCRIMMAGE}:{green}~b")
        arrow = "▶" if offense == "away" else "◀" if offense == "home" else ""
        canvas.put(2, col(ball), "●", f"@{BALL}:{green}~b")
        if arrow:
            canvas.put(2, col(ball) + (1 if offense == "away" else -1), arrow,
                       f"@FFFFFF:{green}~b")
    # under the field: down and distance, who has it, timeouts, red zone
    info = Line()
    if event["state"] == "in" and down_text:
        info.add(down_text, "bold")
        if offense:
            info.add(f"  ·  {event[offense]['abbr']} ball", "accent")
        if situation.get("isRedZone"):
            info.add("  ·  RED ZONE", "err")
    elif event["state"] == "in":
        last = clean(dig(situation, "lastPlay", "text", default=""))
        info.add(last[: width - 2] if last else event.get("detail") or "", "dim")
    timeouts = []
    for side in ("away", "home"):
        left_count = situation.get(f"{side}Timeouts")
        if isinstance(left_count, int) and left_count >= 0 and event["state"] == "in":
            timeouts.append((event[side]["abbr"], left_count))
    if timeouts:
        if info:
            info.add("     ", "normal")
        info.add("timeouts ", "muted")
        for index, (abbr, count) in enumerate(timeouts):
            info.add(("  " if index else "") + f"{abbr} ", "muted")
            info.add("●" * min(3, count) + "○" * max(0, 3 - count), "accent")
    canvas.line(5, 1, info, width - 2)
    return canvas.rows()


def drive_spot(mark, away, home):
    """Where a drive starts or ends, 0 (the away goal line, on the left) to
    100: ESPN's yardLine counts from the home goal line; its text ('SEA 32')
    when that is missing."""
    mark = mark or {}
    line = mark.get("yardLine")
    if isinstance(line, (int, float)) and 0 <= line <= 100:
        return 100 - float(line)
    return _yard_from_text(mark.get("text"), away, home)


def drive_result(drive):
    """(the result as the chart says it, its style): TD and FG in the
    team's favour, turnovers red, punts and the ends of halves dim; a score by
    the other side on the drive (DEFENSE_SCORES: a pick six, a fumble or a
    kick returned for a touchdown, a safety) as INT TD, FUM TD, RET TD,
    SAFETY."""
    text = clean(drive.get("shortDisplayResult") or drive.get("displayResult")
                 or drive.get("result") or "").upper()
    if not text:
        return "", "dim"
    if "TD" in text or "TOUCHDOWN" in text:
        if "INT" in text:
            return "INT TD", "bad"
        if "FUMBLE" in text:
            return "FUM TD", "bad"
        if any(word in text for word in ("PUNT", "BLOCK", "RETURN", "KICK")):
            return "RET TD", "bad"
        return "TD", "good"
    if ("FG" in text or "FIELD GOAL" in text) and not any(
            word in text for word in ("MISS", "BLOCK", "NO GOOD")):
        return "FG", "good"
    if "SAFETY" in text:
        return "SAFETY", "bad"
    if any(word in text for word in ("INT", "FUMBLE", "DOWNS", "MISS", "BLOCK", "NO GOOD")):
        short = {"INTERCEPTION": "INT", "FUMBLE": "FUMBLE", "DOWNS": "DOWNS"}
        for word, label in short.items():
            if word in text:
                return label, "bad"
        return text.replace("FIELD GOAL", "FG")[:12], "bad"
    if "END OF" in text:
        return text.replace("END OF ", "END ")[:12], "dim"
    return text[:12], "dim"


DRIVE_ZONE = 2            # the end zones' columns at either end of a drive's row
# a drive's results that the other side scored
DEFENSE_SCORES = ("INT TD", "FUM TD", "RET TD", "SAFETY")


def _mix(a, b, t):
    return tuple(int(round(a[i] + (b[i] - a[i]) * t)) for i in range(3))


def _blend(buf, i, rgb, alpha):
    """Lay rgb at alpha (0-1) over the pixel at byte i."""
    if alpha <= 0:
        return
    if alpha >= 1:
        buf[i], buf[i + 1], buf[i + 2], buf[i + 3] = rgb[0], rgb[1], rgb[2], 255
        return
    under = buf[i + 3] / 255.0
    out = alpha + under * (1 - alpha)
    if out <= 0:
        return
    for k in range(3):
        buf[i + k] = int((rgb[k] * alpha + buf[i + k] * under * (1 - alpha)) / out + 0.5)
    buf[i + 3] = int(out * 255 + 0.5)


def raster_shape(buf, width, x0, y0, x1, y1, color, alpha=1.0, radius=0.0, point=None,
                 replace=False):
    """Fill a shape in an RGBA buffer `width` pixels wide: the box x0-x1 by
    y0-y1 (rows whole) with corners round by `radius`, or with one end
    ("left" / "right") an arrow's point instead; `color` an rgb or (top rgb,
    bottom rgb) to shade the rows. Its sides are smoothed; `replace` sets the
    pixels it covers whole instead of laying over them."""
    import math
    height = len(buf) // (width * 4)
    h = y1 - y0
    if h <= 0 or x1 - x0 <= 0:
        return
    radius = max(0.0, min(radius, h / 2.0, (x1 - x0) / 2.0))
    middle = (y0 + y1) / 2.0
    tip = min(h * 0.55, (x1 - x0) * 0.5)
    for y in range(max(0, y0), min(height, y1)):
        yc = y + 0.5
        rgb = color if isinstance(color[0], int) else \
            _mix(color[0], color[1], (y - y0) / max(1.0, h - 1.0))
        reach = max((y0 + radius) - yc, yc - (y1 - radius), 0.0)
        inset = radius - math.sqrt(max(0.0, radius * radius - reach * reach)) if reach else 0.0
        lx, rx = x0 + inset, x1 - inset
        slope = tip * abs(yc - middle) / (h / 2.0)
        if point == "right":
            rx = x1 - slope
        elif point == "left":
            lx = x0 + slope
        if rx <= lx:
            continue
        row = y * width * 4
        first, last = int(lx), int(math.ceil(rx)) - 1
        inner_a, inner_b = int(math.ceil(lx)), int(rx)
        if inner_b > inner_a:
            a, b = max(0, inner_a), min(width, inner_b)
            if b > a:
                if alpha >= 1 or replace:
                    buf[row + a * 4:row + b * 4] = bytes((rgb[0], rgb[1], rgb[2],
                                                          int(alpha * 255 + 0.5))) * (b - a)
                else:
                    for x in range(a, b):
                        _blend(buf, row + x * 4, rgb, alpha)
        for x, cover in ((first, min(1.0, inner_a - lx) if first < inner_a else 0.0),
                         (last, min(1.0, rx - inner_b) if last >= inner_b else 0.0)):
            if 0 <= x < width and cover > 0:
                _blend(buf, row + x * 4, rgb, alpha * cover)


def drive_chart_png(spec, cw, ch):
    """The drive chart's picture, laid under its text where the terminal shows
    pictures: the grass in ten-yard stripes with its yard and goal lines, the
    end zones in the teams' colours, each drive a bar in its offense's colours
    outlined in a light shade of them with a point where it ended, a strip of
    grass between it and the next, the ball and the line to gain on a live
    drive; and on the right each drive's result on a card of its own,
    outlined, its chip in the colours of who it was for. The yards and the
    results are the text drawn over it."""
    cw, ch = max(4, int(cw)), max(8, int(ch))
    cols, rows = spec["width"], 1 + len(spec["rows"])
    width, height = cols * cw, rows * ch
    buf = bytearray(width * height * 4)
    white = (255, 255, 255)
    grass = hex_to_rgb("#" + FIELD_GREEN) or (35, 107, 38)
    stripes = (_mix(grass, white, 0.07), _mix(grass, (0, 0, 0), 0.08))
    left, field_w, zone, tag = spec["left"], spec["field"], spec["zone"], spec["tag"]
    fx0, fx1 = left * cw, (left + field_w) * cw
    away = hex_to_rgb("#" + spec["zones"][0]) or (90, 90, 90)
    home = hex_to_rgb("#" + spec["zones"][1]) or (90, 90, 90)
    line = bytearray(width * 4)
    for x0, x1, rgb in ((tag * cw, fx0, _mix(away, (0, 0, 0), 0.12)),
                        (fx1, min(width, fx1 + zone * cw), _mix(home, (0, 0, 0), 0.12))):
        if x1 > x0:
            line[x0 * 4:x1 * 4] = bytes((rgb[0], rgb[1], rgb[2], 255)) * (x1 - x0)
    for x in range(fx0, fx1):
        yard = (x - fx0) * 100.0 / max(1, fx1 - fx0)
        rgb = stripes[int(yard // 10) % 2]
        line[x * 4:x * 4 + 4] = bytes((rgb[0], rgb[1], rgb[2], 255))
    for n, at in enumerate(spec["yards"]):
        x = at * cw + cw // 2
        if 0 <= x < width:
            _blend(line, x * 4, white, 0.62 if n == 4 else 0.32)
    for x in (fx0, fx0 + 1, fx1 - 2, fx1 - 1):
        if 0 <= x < width:
            _blend(line, x * 4, white, 0.85)
    stride = width * 4
    for y in range(ch, height):
        buf[y * stride:(y + 1) * stride] = line
    # the end zones' diagonal stripes
    for x0, x1 in ((tag * cw, fx0), (fx1, min(width, fx1 + zone * cw))):
        for y in range(ch, height):
            for x in range(x0, x1):
                if (x + y) % 7 == 0:
                    _blend(buf, y * stride + x * 4, white, 0.12)
    gap = max(1, int(round(ch * 0.14)))
    edge = 2 if ch >= 20 else 1
    for r, info in enumerate(spec["rows"], 1):
        y0, y1 = r * ch + gap, (r + 1) * ch - gap
        x0, x1 = info["lo"] * cw + 1, (info["hi"] + 1) * cw - 1
        if x1 - x0 < (y1 - y0):
            if info["forward"]:
                x1 = x0 + (y1 - y0)
            else:
                x0 = x1 - (y1 - y0)
        color = hex_to_rgb("#" + info["color"]) or (120, 120, 120)
        point = "right" if info["forward"] else "left"
        outline = _mix(color, white, 0.62)
        raster_shape(buf, width, x0, y0, x1, y1, outline, radius=4, point=point)
        raster_shape(buf, width, x0 + edge, y0 + edge, x1 - edge * 1.6, y1 - edge,
                     (_mix(color, white, 0.16), _mix(color, (0, 0, 0), 0.2)), radius=3,
                     point=point, replace=True) if point == "right" else \
            raster_shape(buf, width, x0 + edge * 1.6, y0 + edge, x1 - edge, y1 - edge,
                         (_mix(color, white, 0.16), _mix(color, (0, 0, 0), 0.2)),
                         radius=3, point=point, replace=True)
        if info.get("target") is not None:
            x = info["target"] * cw + cw // 2 - 1
            raster_shape(buf, width, x, r * ch + 1, x + 2, (r + 1) * ch - 1,
                         hex_to_rgb("#" + FIRST_DOWN) or (255, 225, 53))
        if info.get("ball") is not None:
            bx, by = info["ball"] * cw + cw / 2.0, (y0 + y1) / 2.0
            rx, ry = max(3.0, cw * 0.62), max(2.0, (y1 - y0) * 0.36)
            leather = (139, 74, 34)
            for y in range(int(by - ry - 1), int(by + ry + 2)):
                for x in range(int(bx - rx - 1), int(bx + rx + 2)):
                    if 0 <= x < width and 0 <= y < height:
                        d = ((x + 0.5 - bx) / rx) ** 2 + ((y + 0.5 - by) / ry) ** 2
                        if d < 1.15:
                            shade = _mix(leather, white, 0.25) if y + 0.5 < by - ry * 0.3 \
                                else leather
                            if abs(y + 0.5 - by) < 0.75 and abs(x + 0.5 - bx) < rx * 0.45:
                                shade = (245, 240, 230)
                            _blend(buf, y * stride + x * 4, shade, min(1.0, (1.15 - d) * 4))
    # the results, a card each
    tx0 = spec["tail"] * cw
    tx1 = min(width, (spec["tail"] + spec["tail_w"]) * cw) - 1
    for r, info in enumerate(spec["rows"], 1):
        y0, y1 = r * ch + gap, (r + 1) * ch - gap
        chip = info.get("chip")
        tone = hex_to_rgb("#" + chip[1]) if chip else None
        rim = _mix(tone, white, 0.35) if tone else \
            ((255, 210, 80) if info.get("live") else (96, 108, 124))
        raster_shape(buf, width, tx0, y0, tx1, y1, rim, alpha=0.9, radius=4)
        raster_shape(buf, width, tx0 + 1, y0 + 1, tx1 - 1, y1 - 1, white, alpha=0.06,
                     radius=3, replace=True)
        if chip and tone:
            raster_shape(buf, width, tx0 + 1, y0 + 1, tx0 + chip[0] * cw, y1 - 1, tone,
                         radius=3, replace=True)
    return png_encode(width, height, buf)


def football_drive_chart(summary, event, league, width, rows, info_line=True, pictures=False):
    """Every drive of the game on the field, a row each, oldest at the top:
    the offense's abbreviation, its run from where it began to where it ended
    in its colours (an arrow at the end, the yards inside when they fit), the
    end zones in the teams' colours, then how it ended on a chip in the
    offense's colours (TD and FG with the score after it), the plays, yards
    and time. A live drive runs to the ball (●) with the line to gain (┃)
    ahead of it, and under the chart (with `info_line`) the down and distance
    as on the field. As many of the latest drives as `rows` holds; [] without
    drives or room. With `pictures` (Kitty, Ghostty) a picture laid under the
    text draws the field, the bars outlined and apart, and the results on
    cards (drive_chart_png); the text keeps the yards and the words."""
    drives = list(dig(summary, "drives", "previous", default=[]) or [])
    current = dig(summary, "drives", "current", default=None)
    live = event["state"] == "in"
    if live and isinstance(current, dict) and current.get("team") and \
            all(str(d.get("id")) != str(current.get("id")) for d in drives):
        drives.append(dict(current, live=True))
    elif live and drives:
        drives[-1] = dict(drives[-1], live=not drives[-1].get("result"))
    if not drives or width < 60 or rows < 3:
        return []
    away, home = event["away"], event["home"]
    sides = {str(away.get("id")): "away", str(home.get("id")): "home"}
    tag_w = 5
    tail_w = clamp(width // 4 + 4, 20, 36)
    field_w = width - tag_w - 2 * DRIVE_ZONE - 1 - tail_w
    if field_w < 30:
        return []
    left = tag_w + DRIVE_ZONE
    green = f"@{FIELD_LINE}:{FIELD_GREEN}"
    grass = hex_to_rgb("#" + FIELD_GREEN) or (35, 107, 38)

    def bar_color(team):
        """The team's colour for its drives - lightened when it is a green
        the grass would swallow (Oregon, Michigan State, the Jets …)."""
        color = team_hex(league, team)
        rgb = hex_to_rgb("#" + color) or (90, 90, 90)
        if color_distance(rgb, grass) < 15000:
            color = "%02X%02X%02X" % tuple(int(round(c + (255 - c) * 0.45)) for c in rgb)
        return color

    def col(yard):
        return left + int(round(clamp(yard, 0, 100) * (field_w - 1) / 100))

    # two teams in the same colours (Clemson and Syracuse): the chips say who
    alike = color_distance(hex_to_rgb("#" + team_hex(league, away)) or (0, 0, 0),
                           hex_to_rgb("#" + team_hex(league, home)) or (255, 255, 255)) < 12000

    def zones(canvas, row):
        for team, x in ((away, tag_w), (home, left + field_w)):
            color = team_hex(league, team)
            canvas.put(row, x, " " * DRIVE_ZONE, f"@{_ink_on(color)}:{color}")

    head = Canvas(width, 1)
    zones(head, 0)
    for yard in range(10, 100, 10):
        label = str(yard if yard <= 50 else 100 - yard)
        head.put(0, col(yard) - len(label) // 2, label, "dim")
    head.put(0, 0, f"{away.get('abbr', '')[:4]:<4}", THEME.style(league, away, bold=True))
    head.put(0, left + field_w + DRIVE_ZONE + 1, (home.get("abbr") or "")[:tail_w],
             THEME.style(league, home, bold=True))
    out, shapes = [], []
    situation = event.get("situation") or {}
    for drive in drives:
        side = sides.get(str(dig(drive, "team", "id", default="")))
        if side is None:
            continue
        team = event[side]
        start = drive_spot(drive.get("start"), away, home)
        end = drive_spot(drive.get("end"), away, home)
        result, result_style = drive_result(drive)
        if drive.get("live"):
            ball = _yard_from_text(situation.get("possessionText"), away, home)
            end = ball if ball is not None else end
        if start is None:
            continue
        if end is None:
            end = start
        if result == "TD":
            end = 100.0 if side == "away" else 0.0
        canvas = Canvas(width, 1)
        canvas.put(0, 0, f"{team.get('abbr', '')[:4]:<4}",
                   THEME.style(league, team, bold=True, fallback="accent"))
        zones(canvas, 0)
        canvas.put(0, left, " " * field_w, green)
        for yard in range(10, 100, 10):
            if not pictures:
                canvas.put(0, col(yard), "·" if yard != 50 else "│", green)
        color = bar_color(team)
        ink = _ink_on(color)
        low, high = sorted((col(start), col(end)))
        canvas.put(0, low, " " * (high - low + 1), f"@{ink}:{color}")
        gained = drive.get("yards")
        yards = int(gained) if isinstance(gained, (int, float)) else round(
            (end - start) if side == "away" else (start - end))
        label = f"{yards}" if yards else ""
        if label and high - low + 1 >= len(label) + 3:
            canvas.put(0, low + (high - low + 1 - len(label)) // 2, label,
                       f"@{ink}:{color}~b")
        forward = side == "away"
        shape = {"lo": low, "hi": high, "color": color, "forward": forward,
                 "live": bool(drive.get("live")), "ball": None, "target": None,
                 "chip": None}
        if not pictures:
            canvas.put(0, col(end), "▶" if forward else "◀", f"@{ink}:{color}~b")
        tail = Line()
        if drive.get("live"):
            distance = situation.get("distance")
            down_text = clean(situation.get("downDistanceText") or "")
            if isinstance(distance, (int, float)) and distance > 0 and \
                    "goal" not in down_text.lower():
                target = end + (distance if forward else -distance)
                if 0 < target < 100:
                    shape["target"] = col(target)
                    if not pictures:
                        canvas.put(0, col(target), "┃", f"@{FIRST_DOWN}:{FIELD_GREEN}~b")
            shape["ball"] = col(end)
            if not pictures:
                canvas.put(0, col(end), "●", f"@{BALL}:{color}~b")
            tail.add("NOW", "warn")
        else:
            if result:
                # who did it, at a glance: the result on a chip in the
                # offense's colours - the defense's when it scored - with the
                # team's name on it where colours alone could not tell
                scorer = event["home" if side == "away" else "away"] \
                    if result in DEFENSE_SCORES else team
                chip = team_hex(league, scorer)
                named = alike or result in DEFENSE_SCORES
                word = f" {scorer.get('abbr', '')} {result} " if named else f" {result} "
                tail.add(word, f"@{_ink_on(chip)}:{chip}~b" if pictures
                         else f"(@{_ink_on(chip)}:{chip}~b")
                shape["chip"] = (len(word), chip)
            if result in ("TD", "FG") + DEFENSE_SCORES:
                scored = [play for play in drive.get("plays") or [] if play.get("scoringPlay")]
                last = scored[-1] if scored else None
                a, h = (last or {}).get("awayScore"), (last or {}).get("homeScore")
                if isinstance(a, int) and isinstance(h, int):
                    tail.add(f" {a}-{h}", "bold")
        plays, gained = drive.get("offensivePlays"), drive.get("yards")
        elapsed = clean(dig(drive, "timeElapsed", "displayValue", default="") or "")
        parts = []
        if isinstance(plays, int):
            parts.append(f"{plays} play" + ("" if plays == 1 else "s"))
        if isinstance(gained, (int, float)):
            parts.append(f"{int(gained)} yd" + ("" if abs(gained) == 1 else "s"))
        for count in (3, 2, 1):
            words = ", ".join((parts + ([elapsed] if elapsed else []))[:count])
            if words and len(tail.text) + 2 + len(words) <= tail_w:
                tail.add(("  " if tail.text else "") + words, "normal" if pictures else "dim")
                break
        canvas.line(0, left + field_w + DRIVE_ZONE + 1, tail, tail_w)
        out.append(canvas.rows()[0])
        shapes.append(shape)
    if not out:
        return []
    info = []
    if live and info_line:
        offense = sides.get(str(situation.get("possession") or ""), "")
        field = render_field(event, league, max(40, width), offense)
        if field and field[-1].text.strip():
            info = [field[-1]]
    keep = max(1, rows - 1 - len(info))
    if pictures:
        spec = {"width": width, "tag": tag_w, "left": left, "field": field_w,
                "zone": DRIVE_ZONE, "zones": (team_hex(league, away), team_hex(league, home)),
                "tail": left + field_w + DRIVE_ZONE + 1, "tail_w": tail_w,
                "yards": [col(yard) for yard in range(10, 100, 10)],
                "rows": shapes[-keep:]}
        number = underlay_number(("drives", repr(spec)),
                                 lambda cw, ch, s=spec: drive_chart_png(s, cw, ch),
                                 width, 1 + len(out[-keep:]))
        return underlay_lines([head.rows()[0]] + out[-keep:], number) + info
    return [head.rows()[0]] + out[-keep:] + info


def center_diamond(event, league, width):
    """A baseball diamond: the runners in the batting team's colour, the count,
    the outs, who is pitching to whom and how each is doing today, and the
    last pitch."""
    situation = event.get("situation") or {}
    detail = (event.get("detail") or "").strip().lower()
    batting = event["home"] if detail.startswith(("bot", "bottom")) else event["away"]
    runner_style = THEME.style(league, batting, bold=True, fallback="star")
    on = {number: situation.get(key) for number, key in
          ((1, "onFirst"), (2, "onSecond"), (3, "onThird"))}

    # 7.0.0: a real diamond from above, the runners' bases lit (a picture where
    # the terminal shows them, half blocks elsewhere)
    lit = tuple(number for number in (1, 2, 3) if on[number])
    team = team_hex(league, batting)
    if UNDER["on"]:
        spec = {"cols": 23, "rows": 7, "on": lit, "team": team}
        number = underlay_number(("diamond", repr(spec)),
                                 lambda cw, ch, sp=spec: diamond_png(sp, cw, ch), 23, 7)
        art = underlay_lines([Line().add(" " * 23, "normal") for _ in range(7)], number)
    else:
        art = diamond_text(23, 7, set(lit), team)
    balls, strikes, outs = (situation.get("balls") or 0, situation.get("strikes") or 0,
                            situation.get("outs") or 0)
    right = [Line().add("COUNT ", "muted").add(f"{balls}-{strikes}", "bold")
             .add("    B ", "muted").add("●" * min(3, balls), "good")
             .add("○" * max(0, 3 - balls), "muted")
             .add("  S ", "muted").add("●" * min(2, strikes), "warn")
             .add("○" * max(0, 2 - strikes), "muted")
             .add("  OUTS ", "muted").add("●" * min(2, outs), "err")
             .add("○" * max(0, 2 - outs), "muted"), blank()]
    for key, label in (("pitcher", "P  "), ("batter", "AB ")):
        person = situation.get(key) or {}
        name = clean(dig(person, "athlete", "shortName", default="")
                     or dig(person, "athlete", "displayName", default=""))
        if not name:
            continue
        row = Line().add(label, "muted").add(name, "bold")
        today = clean(person.get("summary") or "")
        if today:
            row.add(f"  {today}", "dim")
        right.append(row)
    runners = []
    for number, word in ((3, "3rd"), (2, "2nd"), (1, "1st")):
        runner = on[number]
        if runner:
            name = clean(dig(runner, "athlete", "shortName", default="")) \
                if isinstance(runner, dict) else ""
            runners.append((word, name))
    if runners:
        right.append(blank())
        row = Line().add("ON ", "muted")
        for index, (word, name) in enumerate(runners):
            if index:
                row.add("  ·  ", "muted")
            row.add(word, runner_style)
            if name:
                row.add(f" {name}", "normal")
        right.append(row)
    out = []
    top = max(0, (len(art) - len(right)) // 2)
    for index in range(max(len(art), len(right) + top)):
        row = Line()
        left_part = art[index] if index < len(art) else Line()
        row.extend(left_part)
        row.add(" " * max(1, 26 - len(left_part.text)), "normal")
        if 0 <= index - top < len(right):
            row.extend(right[index - top])
        out.append(row)
    last = clean(dig(situation, "lastPlay", "text", default=""))
    if last:
        out.append(blank())
        out.extend(wrap_spans("Last: " + last, max(20, width - 2), "dim"))
    return out


def winprob_points(summary):
    points = []
    for node in dig(summary, "winprobability", default=[]) or []:
        value = node.get("homeWinPercentage")
        if isinstance(value, (int, float)):
            points.append(float(value))
    return points


UNDER = {"on": False}    # pictures go under the text here (the App sets it)


def _sample(points, count=360):
    """At most `count` of the points, evenly through them, rounded."""
    if len(points) > count:
        points = [points[int(i * len(points) / count)] for i in range(count)]
    return tuple(round(float(p), 3) for p in points)


def winprob_png(spec, cw, ch):
    """A win probability as a picture under its labels: the meter as a
    rounded bar in the two teams' colours, split where their chances meet;
    the game's swing as a smooth line over the share of whoever led,
    shaded in that team's colours from the dashed 50% line out."""
    cw, ch = max(4, int(cw)), max(8, int(ch))
    width, height = spec["cols"] * cw, spec["rows"] * ch
    buf = bytearray(width * height * 4)
    stride = width * 4
    white = (255, 255, 255)
    bar = spec.get("bar")
    if bar:
        row, c0, c1, left_share, left_hex, right_hex = bar
        left_rgb = hex_to_rgb("#" + left_hex) or (90, 90, 90)
        right_rgb = hex_to_rgb("#" + right_hex) or (160, 160, 160)
        gap = max(2, int(round(ch * 0.2)))
        y0, y1 = row * ch + gap, (row + 1) * ch - gap
        x0, x1 = c0 * cw, c1 * cw
        raster_shape(buf, width, x0, y0, x1, y1, (170, 180, 192), alpha=0.75,
                     radius=(y1 - y0) / 2.0)
        split = x0 + 1 + (x1 - x0 - 2) * left_share
        for half, color in (((x0 + 1, split), left_rgb), ((split, x1 - 1), right_rgb)):
            if half[1] - half[0] < 1:
                continue
            shade_ = (_mix(color, white, 0.18), _mix(color, (0, 0, 0), 0.18))
            # the round ends only where the bar ends
            raster_shape(buf, width, half[0], y0 + 1, half[1], y1 - 1, shade_,
                         radius=(y1 - y0 - 2) / 2.0 if (half[0] == x0 + 1 or half[1] == x1 - 1)
                         else 0, replace=True)
        if x0 + 2 < split < x1 - 2:
            raster_shape(buf, width, split - 1, y0 - 1, split + 1, y1 + 1, white)
    area = spec.get("area")
    points = spec.get("points") or ()
    if area and len(points) >= 2:
        r0, r1, c0, c1, top_home, top_hex, bottom_hex = area
        top_rgb = hex_to_rgb("#" + top_hex) or (200, 200, 200)
        bottom_rgb = hex_to_rgb("#" + bottom_hex) or (120, 120, 120)
        X0, X1 = c0 * cw, c1 * cw
        Y0, Y1 = r0 * ch + 2, r1 * ch - 2
        if X1 - X0 > 4 and Y1 - Y0 > 4:
            raster_shape(buf, width, X0, Y0 - 1, X1, Y1 + 1, white, alpha=0.035, radius=4,
                         replace=True)
            mid = (Y0 + Y1) / 2.0
            half = (Y1 - Y0) / 2.0
            last = len(points) - 1
            previous = None
            for x in range(X0, X1):
                t = (x - X0 + 0.5) / (X1 - X0) * last
                i = min(last - 1, int(t))
                share = points[i] + (points[i + 1] - points[i]) * (t - i)
                share = share if top_home else 1.0 - share
                yv = Y0 + (1.0 - share) * (Y1 - Y0)
                color = top_rgb if share >= 0.5 else bottom_rgb
                low, high = (yv, mid) if share >= 0.5 else (mid, yv)
                for y in range(max(0, int(low)), min(height, int(high) + 1)):
                    cover = min(1.0, max(0.0, min(y + 1, high) - max(y, low)))
                    if cover > 0:
                        _blend(buf, y * stride + x * 4, color,
                               cover * (0.22 + 0.5 * abs(y + 0.5 - mid) / half))
                if (x // 4) % 2 == 0:
                    _blend(buf, int(mid) * stride + x * 4, white, 0.3)
                a, b = (yv, yv) if previous is None else sorted((previous, yv))
                for y in range(max(0, int(a - 1)), min(height, int(b + 1) + 1)):
                    cover = min(1.0, max(0.0, min(y + 1, b + 1.0) - max(y, a - 1.0)))
                    if cover > 0:
                        _blend(buf, y * stride + x * 4, (238, 242, 246), 0.95 * cover)
                previous = yv
    return png_encode(width, height, buf)


def render_winbar(summary, event, league, width, rows=3):
    """Who is winning on ESPN's model: a meter in the two teams' colours (the
    meter look chosen in Settings, LED segments by default) - the away team's
    share lit from the left, the home team's from the right, a │ where they
    meet - the two chances, and the whole game's swing as a braille line
    `rows` rows tall underneath."""
    points = winprob_points(summary)
    if not points:
        return []
    away, home = event["away"], event["home"]
    p_home = points[-1]
    label_a = f"{away['abbr']} {100 * (1 - p_home):.0f}%"
    label_h = f"{100 * p_home:.0f}% {home['abbr']}"
    bar_w = max(10, width - len(label_a) - len(label_h) - 4)
    away_w = int(round((1 - p_home) * (bar_w - 1)))
    home_w = bar_w - 1 - away_w
    line = Line().add(label_a + " ", THEME.style(league, away, bold=True, fallback="away"))
    if UNDER["on"]:
        line.add(" " * bar_w, "normal")
    else:
        line.extend_spans(meter_block(away_w, THEME.style(league, away, fallback="away")))
        line.add("│", "muted")
        line.extend_spans(meter_block(home_w, THEME.style(league, home, fallback="home")))
    line.add(" " + label_h, THEME.style(league, home, bold=True, fallback="home"))
    out = [Line().add("WIN PROBABILITY", "title").add("  ESPN's model, the whole game "
                                                     "below", "muted"), line]
    curve = braille_curve(points, max(10, width - 8), max(1, rows))
    for index, row in enumerate(curve):
        tag = f"{away['abbr']:>5} " if index == 0 else f"{home['abbr']:>5} " if \
            index == len(curve) - 1 else "      "
        style = THEME.style(league, away, fallback="away") if index == 0 else \
            THEME.style(league, home, fallback="home") if index == len(curve) - 1 else "dim"
        out.append(Line().add(tag, style).add(" " * len(row) if UNDER["on"] else row,
                                              "accent"))
    if UNDER["on"] and curve:
        start = len(label_a) + 1
        spec = {"cols": width, "rows": 1 + len(curve),
                "bar": (0, start, start + bar_w, 1 - p_home, team_hex(league, away),
                        team_hex(league, home)),
                "area": (1, 1 + len(curve), 6, 6 + len(curve[0]), False,
                         team_hex(league, away), team_hex(league, home)),
                "points": _sample(points)}
        number = underlay_number(("winbar", repr(spec)),
                                 lambda cw, ch, s=spec: winprob_png(s, cw, ch),
                                 width, 1 + len(curve))
        out = out[:1] + underlay_lines(out[1:], number)
    return out


def recent_plays(summary, event, league, width, count=8):
    """The last plays, newest first: football's current drive, every other
    sport's play-by-play."""
    out = []
    if sport_of(league) == "football":
        drives = dig(summary, "drives", default={}) or {}
        drive = drives.get("current") or (drives.get("previous") or [None])[-1]
        if drive:
            team = clean(dig(drive, "team", "abbreviation", default=""))
            title = clean(drive.get("description") or "")
            result = clean(drive.get("displayResult") or "")
            head = Line().add("DRIVE ", "title")
            if team:
                head.add(team + " ", "accent")
            head.add(title, "dim")
            if result and not drives.get("current"):
                head.add(f" · {result}", "dim")
            out.append(head)
            for play in reversed((drive.get("plays") or [])[-count:]):
                text = clean(play.get("text") or "")
                if not text:
                    continue
                style = "live" if play.get("scoringPlay") else "normal"
                out.extend(wrap_spans(text, max(20, width - 2), style)[:2])
        return out
    plays = dig(summary, "plays", default=[]) or []
    if sport_of(league) == "soccer" and not plays:
        notes = [c for c in dig(summary, "commentary", default=[]) or []
                 if clean(c.get("text") or "")]
        if notes:
            out.append(Line().add("COMMENTARY", "title"))
        for note in reversed(notes[-count:]):
            minute = clean(dig(note, "time", "displayValue", default="") or "")
            line = Line().add(f"{minute:>7}  ", "muted")
            text = clean(note.get("text") or "")
            style = "live" if text.lower().startswith("goal") else "normal"
            chunks = wrap_spans(text, max(20, width - 9), style)
            line.extend(chunks[0])
            out.append(line)
            for chunk in chunks[1:2]:
                out.append(Line().add(" " * 9, "normal").extend_spans(chunk))
        return out
    if sport_of(league) == "hockey":
        quiet = ("face off", "faceoff", "stoppage", "hit", "giveaway", "takeaway",
                 "period start", "blocked")
        plays = [p for p in plays if clean(dig(p, "type", "text", default="")).lower()
                 not in quiet] or plays
    if is_baseball(league):
        plays = [p for p in plays if p.get("type", {}).get("type") in
                 ("play-result", "start-inning", "end-inning")
                 or p.get("scoringPlay") or dig(p, "type", "text", default="")
                 in ("Play Result", "Start Inning", "End Inning")] or plays
    if not plays:
        return out
    out.append(Line().add("LAST PLAYS", "title"))
    for play in reversed(plays[-count:]):
        text = clean(play.get("text") or "")
        if not text:
            continue
        number = dig(play, "period", "number", default=0) or 0
        if is_baseball(league):
            half = "B" if "bottom" in str(dig(play, "period", "type", default="")).lower() \
                or str(play.get("homeAway") or "") == "home" else "T"
            period = f"{half}{number}" if number else ""
        else:
            regulation = LEAGUES[league].get("regulation") or 4
            letter = {"hockey": "P", "soccer": "H"}.get(sport_of(league), "Q")
            if sport_of(league) == "basketball" and not quarters(league):
                letter = "H"
            period = (f"{letter}{number}" if number <= regulation else
                      "OT" if number == regulation + 1 else f"{number - regulation}OT") \
                if number else ""
        clock = dig(play, "clock", "displayValue", default="")
        tag = f"{period} {clock}".strip()
        line = Line().add(f"{tag:<9} ", "muted")
        style = "live" if play.get("scoringPlay") else "normal"
        chunks = wrap_spans(text, max(20, width - 11), style)
        if chunks:
            line.extend(chunks[0])
            out.append(line)
            for chunk in chunks[1:2]:
                out.append(Line().add(" " * 10, "normal").extend_spans(chunk))
    return out


def center_pregame(event, summary, league, width):
    """Before the game: the line, ESPN's predictor, the weather, the form."""
    out = [Line().add("THE MATCHUP", "title")]
    away, home = event["away"], event["home"]
    line = event.get("line") or event.get("line_raw")
    if line:
        text = line.get("details") or ""
        total = line.get("over_under") or line.get("total")
        row = Line().add("Line     ", "muted").add(text or "-", "bold")
        if total:
            row.add(f"   o/u {total}", "normal")
        out.append(row)
    projection = _num(dig(summary, "predictor", "homeTeam", "gameProjection", default=None))
    if projection is not None:
        out.append(Line().add("Predictor", "muted").add(
            f" {home['abbr']} {projection:.0f}%  ·  {away['abbr']} {100 - projection:.0f}%",
            "normal").add("   ESPN's matchup predictor", "dim"))
    weather = dig(summary, "gameInfo", "weather", default=None) or {}
    if weather and not event.get("indoor"):
        bits = []
        if weather.get("temperature") is not None:
            bits.append(f"{weather.get('temperature')}°F")
        if weather.get("displayValue"):
            bits.append(clean(weather["displayValue"]))
        if weather.get("windSpeed"):
            bits.append(f"wind {weather['windSpeed']} mph")
        if bits:
            out.append(Line().add("Weather  ", "muted").add(", ".join(bits), "normal"))
    for side in (away, home):
        if side.get("probable"):
            row = Line().add(f"{side['abbr']:<9}", "muted").add(side["probable"], "bold")
            if side.get("probable_record"):
                row.add(f"  {side['probable_record']}", "dim")
            out.append(row)
    for side in (away, home):
        form = recent_margin(summary, side) if summary else None
        games = _last_games(summary, side.get("id")) if summary else []
        results = []
        for game in games[-5:]:
            result = clean(game.get("gameResult") or "")
            if result:
                results.append(result[:1])
        if results:
            row = Line().add(f"{side['abbr']:<9}", "muted").add("last 5  ", "dim")
            for letter in results:
                row.add(letter + " ", "good" if letter == "W" else "bad" if letter == "L"
                        else "dim")
            if form is not None:
                row.add(f"  margin {form:+.1f}", "dim")
            out.append(row)
    if event.get("venue"):
        where = event["venue"] + (f" — {event['venue_city']}" if event.get("venue_city")
                                  else "")
        out.append(Line().add("Venue    ", "muted").add(where[: max(10, width - 10)], "dim"))
    if event.get("broadcast"):
        out.append(Line().add("TV       ", "muted").add(event["broadcast"], "normal"))
    return out


START_WORDS = {"football": "KICKOFF", "basketball": "TIP-OFF", "hockey": "PUCK DROP",
               "baseball": "FIRST PITCH"}


def countdown_text(event, now=None, league=None):
    """'2:13' hours and minutes to the start (or '0:00'), and the unit:
    'HRS  MIN TO KICKOFF'."""
    start = parse_iso(event.get("date"))
    if not start or event.get("time_tba"):
        return None, ""
    seconds = (start - datetime.now(timezone.utc)).total_seconds()
    if seconds <= 0:
        return "0:00", "STARTING"
    hours, minutes = int(seconds // 3600), int(seconds % 3600 // 60)
    if hours >= 100:
        return None, ""
    word = START_WORDS.get(sport_of(league), "GO") if league else "GO"
    if hours:
        return f"{hours}:{minutes:02d}", f"HRS  MIN TO {word}"
    secs = int(seconds % 60)
    return f"{minutes}:{secs:02d}", f"MIN  SEC TO {word}"


