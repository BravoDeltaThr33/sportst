BASEBALL_HIT_GAME = ["AB", "R", "H", "HR", "RBI", "BB", "SO", "2B", "3B", "SB", "AVG",
                     "OPS"]
BASEBALL_PITCH_GAME = ["Dec", "IP", "H", "R", "ER", "BB", "K", "HR", "P", "ERA"]


def inning_half(play):
    """'top 7th' / 'bot 9th' for a baseball play ('' without its inning)."""
    number = _int(dig(play, "period", "number", default=0))
    if not number:
        return ""
    half = clean(dig(play, "period", "type", default="") or "").lower()
    side = "top" if half.startswith("top") else "bot" if half.startswith("bot") else ""
    return f"{side} {ordinal(number)}".strip()


def baseball_outs(innings):
    """Outs from innings as baseball writes them (5.2 is five and two
    thirds); None without a number."""
    text = str(innings or "").strip()
    whole, _, part = text.partition(".")
    if not whole.isdigit() or (part and not part[:1].isdigit()):
        return None
    return int(whole) * 3 + int(part[:1] or 0)


def is_pitching(group):
    return str(group or "").lower().startswith("pitch")


def baseball_compact(group, stats):
    """A box score row short: '2-4, HR, 3 RBI, R' for a hitter, '6.0 IP, 4 H,
    1 ER, 2 BB, 7 K, W' for a pitcher."""
    stats = stats or {}
    if is_pitching(group):
        parts = [f"{stats['IP']} IP"] if stats.get("IP") not in (None, "") else []
        parts += [f"{stats[label]} {label}" for label in ("H", "ER", "BB", "K")
                  if stats.get(label) not in (None, "")]
        if stats.get("Dec"):
            parts.append(stats["Dec"].split(",")[0].strip())
        return ", ".join(parts)
    hits = stats.get("H-AB") or (f"{stats.get('H')}-{stats.get('AB')}"
                                 if stats.get("AB") not in (None, "") else "")
    parts = [hits] if hits else []
    for label in ("HR", "RBI", "R", "BB", "SB"):
        count = _int(stats.get(label))
        if count:
            parts.append(label if count == 1 and label != "RBI" else f"{count} {label}")
    return ", ".join(parts)


def baseball_points(lines):
    """Fantasy points for a player's rows in a box score, the usual daily-game
    scoring: a hitter's single 3, home run 10, RBI, run and walk 2 each; a
    pitcher's out 0.75, strikeout 2, win 4, earned run -2, hit and walk
    -0.6 (the box score has no doubles or triples a player: they count as
    singles)."""
    total = 0.0
    for group, stats in lines or []:
        stats = stats or {}
        if is_pitching(group):
            total += 0.75 * (baseball_outs(stats.get("IP")) or 0) + 2 * _int(stats.get("K")) \
                - 2 * _int(stats.get("ER")) - 0.6 * (_int(stats.get("H")) +
                                                    _int(stats.get("BB")))
            if str(stats.get("Dec") or "").upper().startswith("W"):
                total += 4
        else:
            hits, homers = _int(stats.get("H")), _int(stats.get("HR"))
            total += 3 * max(0, hits - homers) + 10 * homers + 2 * (
                _int(stats.get("RBI")) + _int(stats.get("R")) + _int(stats.get("BB")))
    return round(total, 2)


def baseball_performers(refs):
    """[(fantasy points, index of his row)] best first, a player once - at
    his pitching row if he pitched and hit."""
    best = {}
    for index, ref in enumerate(refs or []):
        ident = ref.get("id") or ref.get("name")
        if not ident:
            continue
        own = baseball_points([(ref.get("group"), ref.get("stats") or {})])
        if ident not in best:
            lines = ref.get("lines") or [(ref.get("group"), ref.get("stats") or {})]
            best[ident] = [baseball_points(lines), index, own]
        elif own > best[ident][2]:
            best[ident][1:] = [index, own]
    ranked = [(value, index) for value, index, _ in best.values() if value > 0]
    ranked.sort(key=lambda item: (-item[0], item[1]))
    return ranked


def baseball_tonight_pairs(ref):
    """His line in this game, label by label as its table has it (a pitcher's
    decision first; H-AB standing for a hitter's at-bats and hits), then
    his other table short (a two-way player's)."""
    stats = ref.get("stats") or {}
    skip = {"AB", "H"} if "H-AB" in stats else set()
    if "PC-ST" in stats:
        skip.add("PC")
    pairs = [("Dec", stats["Dec"])] if stats.get("Dec") else []
    pairs += [(label, value) for label, value in stats.items()
              if label not in skip and label != "Dec" and value not in (None, "")]
    mine = is_pitching(ref.get("group"))
    for group, other in ref.get("lines") or []:
        if is_pitching(group) == mine:
            continue
        text = baseball_compact(group, other)
        if text:
            pairs.append(("pitching" if is_pitching(group) else "batting", text))
    return pairs


def baseball_whip(totals):
    outs = baseball_outs(totals.get("IP"))
    if not outs:
        return ""
    return f"{(_int(totals.get('BB')) + _int(totals.get('H'))) * 3 / outs:.2f}"


def baseball_season_pairs(profile):
    """His season for a card: games, then a hitter's average, homers, RBIs,
    runs, hits, steals, walks, strikeouts and slash line, or a pitcher's
    record, ERA, innings, strikeouts, walks, hits and WHIP; his postseason
    short at the end."""
    totals = profile.get("totals") or {}
    if not totals:
        return []
    summary = profile.get("summary") or {}
    pairs = [("GP", str(profile["played"]))] if profile.get("played") else []
    if profile.get("pitcher"):
        pairs.append(("W-L", summary.get("W-L") or ""))
        pairs += [(label, totals.get(label)) for label in ("ERA", "IP", "K", "BB", "H",
                                                           "HR")]
        pairs.append(("WHIP", summary.get("WHIP") or baseball_whip(totals)))
    else:
        pairs += [(label, totals.get(label)) for label in ("AVG", "HR", "RBI", "OPS", "R",
                                                           "H", "SB", "BB", "SO", "OBP",
                                                           "SLG", "2B", "3B")]
    return [(label, value) for label, value in pairs if value not in (None, "", "-")]


def espn_baseball_profile(player_id, league, timeout=15):
    """A baseball player's card from ESPN: who he is, his season (the regular
    season's totals, the postseason's short) and his games newest first, a
    hitter's or a pitcher's columns as his game log has them."""
    base = ESPN_ATHLETE.format("baseball", LEAGUES[league]["path"],
                               urllib.parse.quote(str(player_id)))
    athlete = http_json(base, timeout).get("athlete") or {}
    try:
        log = http_json(base + "/gamelog", timeout)
    except Exception:  # noqa: BLE001 - the card shows what it has
        log = {}
    position = athlete.get("position") or {}
    labels = [clean(str(label)).strip() for label in log.get("labels") or []]
    pitcher = "IP" in labels if labels else \
        clean(position.get("abbreviation") or "") in ("P", "SP", "RP")
    bats, _, throws = clean(athlete.get("displayBatsThrows") or "").partition("/")
    profile = {
        "id": str(player_id), "sport": "baseball", "goalie": False, "pitcher": pitcher,
        "name": clean(athlete.get("displayName") or ""),
        "jersey": clean(athlete.get("jersey") or ""),
        "position": clean(position.get("displayName") or ""),
        "age": athlete.get("age") if isinstance(athlete.get("age"), int) else None,
        "height": clean(athlete.get("displayHeight") or ""),
        "weight": clean(athlete.get("displayWeight") or ""),
        "hand": f"B/T {bats.strip()[:1]}/{throws.strip()[:1]}" if bats and throws else "",
        "born": birth_day(athlete.get("displayDOB")),
        "birthplace": clean(athlete.get("displayBirthPlace") or ""),
        "draft": clean(athlete.get("displayDraft") or ""),
        "experience": clean(athlete.get("displayExperience") or ""),
        "college": clean(dig(athlete, "college", "name", default="") or ""),
        "photo": clean(dig(athlete, "headshot", "href", default="") or ""),
        "url": next((clean(link.get("href") or "") for link in athlete.get("links") or []
                     if "playercard" in (link.get("rel") or [])), ""),
        "season_label": "", "ranks": [], "summary": {}, "totals": {}, "post": {},
        "played": 0, "games": [], "labels": labels, "spark": None,
    }
    for stat in dig(athlete, "statsSummary", "statistics", default=[]) or []:
        label = clean(stat.get("abbreviation") or stat.get("shortDisplayName") or "")
        if label:
            profile["summary"][label] = clean(str(stat.get("displayValue") or ""))
        rank = stat.get("rank")
        if isinstance(rank, int) and 0 < rank <= 25:
            text = clean(stat.get("rankDisplayValue") or "").replace("Tied-", "T-")
            profile["ranks"].append((label, text))
    events = log.get("events") or {}
    for season in log.get("seasonTypes") or []:
        if not isinstance(season, dict) or not labels:
            continue
        name = clean(season.get("displayName") or "")
        post = "post" in name.lower()
        count = 0
        for month in season.get("categories") or []:
            for entry in month.get("events") or []:
                game = events.get(str(entry.get("eventId"))) or {}
                values = [clean(str(s)).strip() for s in entry.get("stats") or []]
                values = (values + [""] * len(labels))[:len(labels)]
                where = clean(game.get("atVs") or "")
                opponent = clean(dig(game, "opponent", "abbreviation", default="") or "")
                result = " ".join(part for part in (clean(game.get("gameResult") or ""),
                                                    clean(game.get("score") or "")) if part)
                profile["games"].append({"date": card_day(game.get("gameDate")),
                                         "when": str(game.get("gameDate") or ""),
                                         "opp": f"{where} {opponent}".strip(),
                                         "result": result, "values": values, "post": post,
                                         "stats": dict(zip(labels, values))})
                count += 1
        rows = [row for row in dig(season, "summary", "stats", default=[]) or []
                if isinstance(row, dict)]
        rows.sort(key=lambda row: row.get("type") != "total")
        totals = next((row.get("stats") for row in rows
                       if any(str(v).strip() not in ("", "-") for v in row.get("stats") or [])),
                      None)
        if not totals:
            continue
        mapped = dict(zip(labels, [clean(str(t)).strip() for t in totals]))
        if post:
            profile["post"] = profile["post"] or mapped
        elif not profile["totals"]:
            profile["totals"], profile["played"] = mapped, count
            profile["season_label"] = name
    profile["games"].sort(key=lambda g: g["when"], reverse=True)
    return profile


def baseball_swing_lines(summary, event, league, width, count=4):
