def fav_entry(item):
    if isinstance(item, str):
        return {"abbr": item.strip().upper(), "name": item.strip(), "id": ""}
    if isinstance(item, dict):
        return {
            "abbr": str(item.get("abbr") or "").strip().upper(),
            "name": clean(item.get("name") or ""),
            "id": str(item.get("id") or "").strip(),
        }
    return {"abbr": "", "name": "", "id": ""}


def normalize_favorites(raw):
    """Accept the v2 per-league dict, or a v1 flat list, and return the dict."""
    out = {key: [] for key in LEAGUE_ORDER}
    if isinstance(raw, dict):
        for league in LEAGUE_ORDER:
            for item in raw.get(league) or []:
                entry = fav_entry(item)
                if entry["abbr"] or entry["name"]:
                    out[league].append(entry)
    elif isinstance(raw, list):
        # v1 stored one flat list with no league, so try it against all three
        for item in raw:
            entry = fav_entry(item)
            if entry["abbr"] or entry["name"]:
                for league in LEAGUE_ORDER:
                    out[league].append(dict(entry))
    return out


def fav_rank(favorites, league, team):
    """Position of a team in the favourites list, or -1. Lower sorts first."""
    if not team:
        return -1
    abbr = str(team.get("abbr") or "").upper()
    name = norm_name(team.get("name") or "")
    ident = str(team.get("id") or "")
    if is_olympic(league):
        # a country is a country, whichever sport and whichever source:
        # ESPN's 'Czechia' and Wikipedia's 'Czech Republic' are both CZE
        code = noc_code(team)
        for index, entry in enumerate(favorites.get(family(league)) or []):
            if code and entry["abbr"] == code:
                return index
        return -1
    for index, entry in enumerate(favorites.get(family(league)) or []):
        if entry["id"] and ident and entry["id"] == ident:
            return index
        if entry["abbr"] and abbr and entry["abbr"] == abbr:
            return index
        if entry["name"] and name and norm_name(entry["name"]) == name:
            return index
    return -1


def event_fav_rank(favorites, league, event):
    ranks = [r for r in (fav_rank(favorites, league, event["away"]),
                         fav_rank(favorites, league, event["home"])) if r >= 0]
    return min(ranks) if ranks else -1


def sort_by_favorites(favorites, league, events):
    """Favourites to the top, in the order they were added; the rest untouched."""
    decorated = []
    for position, event in enumerate(events):
        rank = event_fav_rank(favorites, league, event)
        decorated.append(((0, rank) if rank >= 0 else (1, 0), position, event))
    decorated.sort(key=lambda row: (row[0], row[1]))
    return [row[2] for row in decorated]


# --------------------------------------------------------------------------
# betting lines
#
# What ESPN actually does, verified against live payloads:
#
#   * The scoreboard carries competition.odds[] only while a game is "pre".
#     The moment it kicks off the array comes back empty, and it stays empty
#     through the final.
#   * Scoreboard lines keep moneylines as strings under
#     moneyline.{away,home}.{close,open}.odds ("+130"), spreads under
#     pointSpread.{away,home}.{close,open}.line ("+2.5"), totals under
#     total.over.{close,open}.line ("o43.5"). "close" is the current number
#     until the game starts.
#   * The core API (sports.core.api.espn.com .../competitions/{id}/odds) keeps
#     the line after kickoff and after the final, with numeric moneyLine and
#     open/current blocks holding "american" strings.
#   * spread is home-relative everywhere: negative means the home team lays
#     points. "CAR -2.5" at ATL arrives as spread 2.5.
#   * The core movement-history endpoint exists but returns nothing, so line
#     movement is recorded here, one snapshot per change, in a small cache
#     file that survives restarts.
# --------------------------------------------------------------------------

