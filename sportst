            if playback.get("name") == "mp4Avc":
                url = playback.get("url") or ""
        if not url:
            continue
        tags = set()
        for k in item.get("keywordsAll") or []:
            if k.get("type") in ("taxonomy", "subject"):
                for field in ("displayName", "value"):
                    tags.add(clean(k.get(field) or "").lower().replace("-", " ")
                             .replace("_", " "))
        people = [clean(k.get("displayName") or k.get("value") or "")
                  for k in item.get("keywordsAll") or [] if k.get("type") == "player"]
        title = clean(item.get("headline") or item.get("title") or "")
        clip = {"title": title, "url": url, "kind": "audio", "source": "MLB",
                "seconds": 0, "match": f"{title} {' '.join(people)}",
