def _paeth(a, b, c):
    p = a + b - c
    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
    if pa <= pb and pa <= pc:
        return a
    return b if pb <= pc else c


def png_decode(blob):
    """Decode a non-interlaced PNG into (width, height, rgba bytearray).

    Standard library only: zlib does the inflating, this does the rest. Covers
    every colour type ESPN's logos come in (RGBA, RGB, palette, grey) at
    8-bit, plus low-bit palettes. Returns None for anything else.
    """
    import struct
    import zlib
    if not blob or blob[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    pos = 8
    width = height = depth = ctype = interlace = None
    palette, trns, chunks = None, None, []
    while pos + 8 <= len(blob):
        length, kind = struct.unpack(">I4s", blob[pos:pos + 8])
        body = blob[pos + 8:pos + 8 + length]
        pos += 12 + length
        if kind == b"IHDR":
            width, height, depth, ctype, _, _, interlace = struct.unpack(">IIBBBBB", body)
        elif kind == b"PLTE":
            palette = [tuple(body[i:i + 3]) for i in range(0, len(body) - 2, 3)]
        elif kind == b"tRNS":
            trns = body
        elif kind == b"IDAT":
            chunks.append(body)
        elif kind == b"IEND":
            break
    if not width or interlace or width * height > 4_000_000:
        return None
    channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(ctype)
    if channels is None or (depth != 8 and ctype != 3 and ctype != 0) or depth == 16:
        return None
    try:
        raw = zlib.decompress(b"".join(chunks))
    except zlib.error:
        return None

    bits = channels * depth
    stride = (width * bits + 7) // 8
    bpp = max(1, bits // 8)
    out = bytearray(width * height * 4)
    prev = bytearray(stride)
    pos = 0
    for y in range(height):
        kind = raw[pos]
        line = bytearray(raw[pos + 1:pos + 1 + stride])
        pos += 1 + stride
        if kind == 1:
            for i in range(bpp, stride):
                line[i] = (line[i] + line[i - bpp]) & 255
        elif kind == 2:
            for i in range(stride):
                line[i] = (line[i] + prev[i]) & 255
        elif kind == 3:
            for i in range(stride):
                left = line[i - bpp] if i >= bpp else 0
                line[i] = (line[i] + ((left + prev[i]) >> 1)) & 255
        elif kind == 4:
            for i in range(stride):
                left = line[i - bpp] if i >= bpp else 0
                up_left = prev[i - bpp] if i >= bpp else 0
                line[i] = (line[i] + _paeth(left, prev[i], up_left)) & 255
        prev = line
        base = y * width * 4
        if ctype == 6:
            out[base:base + width * 4] = line
            continue
        for x in range(width):
            if ctype == 2:
                r, g, b = line[x * 3:x * 3 + 3]
                a = 255
                if trns and len(trns) >= 6 and (r, g, b) == (trns[1], trns[3], trns[5]):
                    a = 0
            elif ctype == 4:
                r = g = b = line[x * 2]
                a = line[x * 2 + 1]
            else:
                if depth == 8:
                    value = line[x]
                else:
                    per = 8 // depth
                    value = (line[x // per] >> (8 - depth * (x % per + 1))) & ((1 << depth) - 1)
                if ctype == 3:
                    if not palette or value >= len(palette):
                        r = g = b = 0
                    else:
                        r, g, b = palette[value]
                    a = trns[value] if trns and value < len(trns) else 255
                else:
                    r = g = b = value * 255 // ((1 << depth) - 1)
                    a = 255
            out[base + x * 4:base + x * 4 + 4] = bytes((r, g, b, a))
    return width, height, out


def opaque_box(image, threshold=110):
    """Bounding box (x0, y0, x1, y1) of the visible part of the image, so a
    wide logo on a square canvas can use the whole width of the pane."""
    width, height, data = image
    xs, ys = [], []
    for y in range(height):
        base = y * width * 4
        hits = [x for x in range(width) if data[base + x * 4 + 3] >= threshold]
        if hits:
            ys.append(y)
            xs.append(hits[0])
            xs.append(hits[-1])
    if not ys:
        return None
    return min(xs), ys[0], max(xs) + 1, ys[-1] + 1


def logo_cells(image, cols, rows, box=None, sub_x=1, sub_y=2):
    """Average the image into a cols x (rows*2) grid of pixels.

    Each terminal cell is roughly twice as tall as it is wide, so one cell
    holds two stacked pixels and the picture keeps its proportions. A pixel
    is None where the logo is mostly transparent.
    """
    width, height, data = image
    bx0, by0, bx1, by1 = box or (0, 0, width, height)
    span_x, span_y = bx1 - bx0, by1 - by0
    px_rows = rows * sub_y
    px_cols = cols * sub_x
    grid = []
    for py in range(px_rows):
        y0 = by0 + py * span_y // px_rows
        y1 = max(y0 + 1, by0 + (py + 1) * span_y // px_rows)
        row = []
        for px in range(px_cols):
            x0 = bx0 + px * span_x // px_cols
            x1 = max(x0 + 1, bx0 + (px + 1) * span_x // px_cols)
            r = g = b = a = 0
            count = 0
            for y in range(y0, y1):
                base = y * width * 4
                for x in range(x0, x1):
                    i = base + x * 4
                    alpha = data[i + 3]
                    r += data[i] * alpha
                    g += data[i + 1] * alpha
                    b += data[i + 2] * alpha
                    a += alpha
                    count += 1
            if not count or a < count * 110:
                row.append(None)
            else:
                row.append(unblack((r // a, g // a, b // a)))
        grid.append(row)
    return grid


def unblack(rgb, floor=46):
    """Black parts of a logo would vanish into the black background, so they
    are raised to a charcoal that keeps their hue."""
    top = max(rgb)
    if top >= floor:
        return rgb
    if top == 0:
        return (floor, floor, floor)
    return tuple(min(255, int(c * floor / top) if c else floor // 2) for c in rgb)


def quantize(grid, limit=8):
    """Snap the logo onto a handful of colours.

    Logos are flat artwork, so a few colours lose nothing visible, and every
    distinct fg/bg combination costs a curses colour pair.
    """
    counts = {}
    for row in grid:
        for pixel in row:
            if pixel is not None:
                bucket = tuple(c >> 4 for c in pixel)
                total = counts.setdefault(bucket, [0, 0, 0, 0])
                total[0] += 1
                total[1] += pixel[0]
                total[2] += pixel[1]
                total[3] += pixel[2]
    ranked = sorted(counts.values(), key=lambda t: -t[0])
    opaque = sum(t[0] for t in ranked) or 1
    chosen = []
    # Main colours first. The soft edges of the artwork average into dozens
    # of in-between shades; each is rare, so they are left to snap onto the
    # nearest main colour instead of speckling the outline.
    for count, r, g, b in ranked:
        colour = (r // count, g // count, b // count)
        if count / opaque >= 0.02 and all(color_distance(colour, c) > 14000 for c in chosen):
            chosen.append(colour)
        if len(chosen) >= limit:
            break
    # then small details that are plainly their own colour (a white letter)
    for count, r, g, b in ranked:
        if len(chosen) >= limit:
            break
        colour = (r // count, g // count, b // count)
        if count / opaque >= 0.006 and all(color_distance(colour, c) > 45000 for c in chosen):
            chosen.append(colour)
    if not chosen:
        return grid
    cache = {}

    def snap(pixel):
        if pixel is None:
            return None
        hit = cache.get(pixel)
        if hit is None:
            hit = min(chosen, key=lambda c: color_distance(pixel, c))
            cache[pixel] = hit
        return hit
    return [[snap(p) for p in row] for row in grid]


def _hex(rgb):
    return "%02X%02X%02X" % rgb


def trim_grid(grid, sub_x=1, sub_y=2):
    """Drop fully transparent cells around the art, keeping whole cells."""
    rows = [i for i, row in enumerate(grid) if any(p is not None for p in row)]
    if not rows:
        return []
    cols = [x for x in range(len(grid[0])) if any(row[x] is not None for row in grid)]
    top = rows[0] - rows[0] % sub_y
    bottom = rows[-1] + 1 + (-(rows[-1] + 1) % sub_y)
    left = cols[0] - cols[0] % sub_x
    right = cols[-1] + 1 + (-(cols[-1] + 1) % sub_x)
    out = [row[left:right] for row in grid[top:bottom]]
    width = right - left
    while len(out) < bottom - top:
        out.append([None] * width)
    return [row + [None] * (width - len(row)) for row in out]


