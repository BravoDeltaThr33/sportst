# what main() learnt about the terminal before curses started
TERMINAL = {"name": "", "graphics": False, "images": False, "why": "not checked"}


def probe_terminal(timeout=1.0):
    """(name, graphics) as the terminal reports them: its name from XTVERSION
    when it answers, and whether it accepts a Kitty graphics query. Sent
    before curses starts; the reply to the device-attributes request that
    follows (which nearly every terminal answers, at once) ends the wait, so
    the timeout only matters for a terminal that stays silent, or a slow
    link."""
    try:
        import select
        import termios
    except ImportError:
        return "", False
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return "", False
    fd = sys.stdin.fileno()
    try:
        saved = termios.tcgetattr(fd)
    except termios.error:
        return "", False
    data = b""
    try:
        quiet = termios.tcgetattr(fd)
        quiet[3] &= ~(termios.ICANON | termios.ECHO)
        quiet[6][termios.VMIN] = 0
        quiet[6][termios.VTIME] = 0
        termios.tcsetattr(fd, termios.TCSANOW, quiet)
        os.write(sys.stdout.fileno(),
                 b"\x1b[>0q\x1b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\x1b\\\x1b[c")
        end = time.time() + timeout
        while time.time() < end:
            ready, _, _ = select.select([fd], [], [], max(0.0, end - time.time()))
            if not ready:
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            data += chunk
            if re.search(rb"\x1b\[\?[\d;]*c", data):
                break
    except OSError:
        pass
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSAFLUSH, saved)
        except termios.error:
            pass
    named = re.search(rb"\x1bP>\|([^\x1b]*)\x1b\\", data)
    name = named.group(1).decode("utf-8", "replace") if named else ""
    return name, b"\x1b_Gi=31;OK" in data


def choose_pictures(config, probe=probe_terminal):
    """Decide once, before curses starts, whether this run shows real
    images, and remember why (the Settings tab shows it)."""
    want = str(config.get("pictures", "auto") or "auto").lower()
    term = os.environ.get("TERM", "")
    program = os.environ.get("TERM_PROGRAM", "")
    if want == "text":
        TERMINAL.update(images=False, why="text art (Settings, Pictures)")
        return TERMINAL
    name, graphics = probe()
    lower = name.lower()
    kind = ("kitty" if "kitty" in lower or term == "xterm-kitty" or
            os.environ.get("KITTY_WINDOW_ID") else
            "ghostty" if "ghostty" in lower or term == "xterm-ghostty" or
            program.lower() == "ghostty" else "")
    TERMINAL.update(name=name or kind or term, graphics=graphics)
    if want == "images":
        TERMINAL.update(images=True, why="real images (Settings, Pictures)")
    elif graphics and kind:
        TERMINAL.update(images=True, why=f"real images ({kind} answered)")
    elif graphics:
        TERMINAL.update(images=False, why="text art (this terminal's images are untested)")
    else:
        TERMINAL.update(images=False, why="text art (no image support found)")
    return TERMINAL


def cell_pixels():
    """A terminal cell's size in pixels, (width, height); 10 x 20 when the
    terminal does not say."""
    try:
        import fcntl
        import struct
        import termios
        raw = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, xpix, ypix = struct.unpack("HHHH", raw)
        if rows and cols and xpix and ypix:
            return xpix / cols, ypix / rows
    except Exception:  # noqa: BLE001 - a guess is fine
        pass
    return 10.0, 20.0


def kitty_transmit(image_id, png, cols, rows):
    """Escape codes that store a PNG as picture `image_id` and make it show
    in placeholder cells, `cols` x `rows` of them (q=2: no replies)."""
    import base64
    data = base64.b64encode(png)
    parts = [f"\x1b_Ga=d,d=I,i={image_id},q=2\x1b\\".encode()]
    for start in range(0, len(data), 4096):
        more = 1 if start + 4096 < len(data) else 0
        head = (f"a=T,U=1,f=100,t=d,q=2,i={image_id},c={cols},r={rows},m={more}"
                if start == 0 else f"m={more}")
        parts.append(b"\x1b_G" + head.encode() + b";" + data[start:start + 4096] + b"\x1b\\")
    return b"".join(parts)


def image_cells(image_id, cols, rows):
    """Lines of placeholder cells for picture `image_id`: one span a cell, its
    style naming the picture, the row and the column (cell_text spells the
    cell out when it is drawn)."""
    return [Line([(PLACEHOLDER, f"!img:{image_id}:{row}:{col}") for col in range(cols)])
            for row in range(rows)]


def cell_text(text, style):
    """What to write for a span: a placeholder span becomes U+10EEEE with
    its row and column marks; everything else is itself."""
    if style and style.startswith("!img:"):
        try:
            parts = style.split(":")
            row, col = int(parts[2]), int(parts[3])
            mark = PLACEHOLDER_MARKS[row]
            # past the last column mark the terminal takes the column from the
            # cell on the left, one more
            return PLACEHOLDER + mark + (PLACEHOLDER_MARKS[col] if col < len(PLACEHOLDER_MARKS)
                                         else "")
        except (ValueError, IndexError):
            return " "
    return text


def fit_cells(size, cols, rows, cell=(10.0, 20.0)):
    """(cols, rows) of the largest box no bigger than cols x rows that has
    the picture's shape, given the cell's shape."""
    width, height = size
    cw, ch = cell
    if cols < 1 or rows < 1 or not width or not height:
        return 0, 0
    if cols * cw / (rows * ch) > width / height:
        rows_used = rows
        cols_used = max(1, min(cols, round(rows * ch * width / height / cw)))
    else:
        cols_used = cols
        rows_used = max(1, min(rows, round(cols * cw * height / width / ch)))
    return min(cols_used, IMAGE_MAX_COLS), min(rows_used, IMAGE_MAX)


class Graphics:
    """Pictures for a terminal that shows them: each sent once, into one of
    IMAGE_SLOTS numbered slots, then shown wherever placeholder cells name
    its number. Off, it does nothing."""

    def __init__(self, enabled, write=None):
        self.enabled = bool(enabled)
        self.write = write
        self.slots = {}          # (key, cols, rows) -> slot
        self.last = {}           # slot -> the frame it was last shown in
        self.frame = 0
        self.pending = []

    def place(self, key, png, cols, rows):
        """The number to name this picture by at cols x rows cells, sending
        it first if the terminal does not have it yet; None when off or when
        every slot is on screen already."""
        if not self.enabled or not png or not 0 < cols <= IMAGE_MAX_COLS or \
                not 0 < rows <= IMAGE_MAX:
            return None
        ident = (key, cols, rows)
        slot = self.slots.get(ident)
        if slot is None:
            taken = set(self.slots.values())
            free = [s for s in range(IMAGE_SLOTS) if s not in taken]
            if free:
                slot = free[0]
            else:
                idle = [s for s in range(IMAGE_SLOTS) if self.last.get(s, -1) != self.frame]
                if not idle:
                    return None
                slot = min(idle, key=lambda s: self.last.get(s, -1))
                self.slots = {k: v for k, v in self.slots.items() if v != slot}
            self.slots[ident] = slot
            self.pending.append(kitty_transmit(IMAGE_BASE + slot, png, cols, rows))
        self.last[slot] = self.frame
        return IMAGE_BASE + slot

    def flush(self):
        """After curses has drawn a frame: send the pictures it named."""
        self.frame += 1
        if self.pending and self.write:
            data, self.pending = b"".join(self.pending), []
            self.write(data)

    def clear(self):
        """Forget every picture (on the way out, or when turned off)."""
        if self.slots and self.write:
            self.write(b"".join(f"\x1b_Ga=d,d=I,i={IMAGE_BASE + s},q=2\x1b\\".encode()
                                for s in sorted(set(self.slots.values()))))
        self.slots, self.last, self.pending = {}, {}, []


def write_terminal(data):
    """Bytes straight to the terminal, past curses (it has flushed its own)."""
    fd = sys.stdout.fileno()
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except InterruptedError:
            continue
        except OSError:
            return
        view = view[written:]


def _is_strong(line, league):
    side = favorite_side(line)
    if not side:
        return False
    ml = line.get(f"{side}_ml")
    if ml is not None and ml <= BETTING.min_moneyline:
        return True
    if league not in MONEYLINE_LEAGUES and line.get("spread") is not None:
        return abs(line["spread"]) >= BETTING.min_spread
    return False


def upset_state(event, league):
    """None, or a dict describing why this game deserves a look."""
    if not (BETTING.enabled and BETTING.alerts):
        return None
    line = event.get("line")
    if not line or event.get("state") not in ("in", "post"):
        return None
    side = favorite_side(line)
    if not side or not _is_strong(line, league):
        return None
    favorite = event[side]
    underdog = event["away" if side == "home" else "home"]
    if favorite.get("score") is None or underdog.get("score") is None:
        return None

    margin = favorite["score"] - underdog["score"]
    number = favorite_number(line, league) or 0
    if league in MONEYLINE_LEAGUES:
        size = money_text(number)
        dog_ml = line.get(("away" if side == "home" else "home") + "_ml")
        dog_size = money_text(dog_ml) if dog_ml is not None else "an"
    else:
        size = dog_size = f"{abs(number):g}-point"

    if event["state"] == "post":
        if margin < 0:
            return {"level": "final", "tag": "UPSET",
                    "note": f"{underdog['abbr']} won as a {dog_size} underdog",
                    "favorite": favorite, "underdog": underdog, "margin": margin}
        return None

    # a "late" period and a "safe" lead differ by sport
    low_scoring = league in MONEYLINE_LEAGUES
    period = event.get("period") or 0
    regulation = LEAGUES.get(league, {}).get("regulation", 4)
    late = period >= regulation
    big_lead = (3 if is_baseball(league) else 2) if low_scoring else (
        12 if sport_of(league) == "basketball" else 8)

    if margin < 0:
        lead = -margin
        if period >= 2 or lead >= big_lead:
            return {"level": "live", "tag": "UPSET",
                    "note": f"{underdog['abbr']} leads by {lead} as a {dog_size} underdog",
                    "favorite": favorite, "underdog": underdog, "margin": margin}
        return None
    if margin == 0 and late:
        return {"level": "live", "tag": "TIED",
                "note": f"tied late; {favorite['abbr']} was a {size} favorite",
                "favorite": favorite, "underdog": underdog, "margin": margin}
    if (not low_scoring and late and 0 < margin <= 3 and line.get("spread") is not None
            and abs(line["spread"]) >= BETTING.close_spread):
        return {"level": "live", "tag": "CLOSE",
                "note": f"{favorite['abbr']} up only {margin} as a {size} favorite",
                "favorite": favorite, "underdog": underdog, "margin": margin}
    return None


