                                         "result": result, "values": values,
                                         "stats": football_stats(groups, labels, values)})
        totals = dig(current, "summary", "stats", 0, "stats", default=[]) or []
        profile["season"] = [clean(str(t)).strip() for t in totals]
        if not profile["season_label"]:
            profile["season_label"] = clean(current.get("displayName") or "")
    profile["games"].sort(key=lambda g: g["when"], reverse=True)
    profile["labels"], profile["groups"] = labels, groups
    profile["spark"] = FOOTBALL_SPARK.get(groups[0][3]) if groups else None
    if profile["season"]:
        profile["totals"] = football_stats(groups, labels, profile["season"])
    return profile


def sport_panel(summary, event, league, width, height):
    """The sport's own picture for a game under way or over: [] when there is
    nothing to draw yet."""
    if not summary or event["state"] == "pre" or height < 6:
        return []
    sport = sport_of(league)
    try:
        if sport == "basketball":
            return basketball_panel(summary, event, league, width, height)
        if sport == "hockey":
            return hockey_panel(summary, event, league, width, height)
        if sport == "soccer":
            return soccer_panel(summary, event, league, width, height)
        if sport == "football" and event["state"] == "post":
            return football_panel(summary, event, league, width, height)
        if sport == "baseball" and event["state"] == "post":
            return baseball_panel(summary, event, league, width, height)
    except (KeyError, TypeError, ValueError, ZeroDivisionError):
        return []
    return []


# -- the Olympic events Wikipedia covers: the podium --------------------------

MEDAL_HEX = {"gold": "FFD24A", "silver": "C9CED6", "bronze": "D9925B"}


def event_medallists(event, page):
    """{'gold': [(who, code)], ...} from the event page's medal box, else the
    sport page's medal table."""
    podium = wiki_podium(page) if page else []
    if podium:
        medals = {}
        for medal, who, code in podium:
            medals.setdefault(medal, []).append((who, code))
        return medals
    return event.get("medals") or {}


def compose_event_center(event, page, league, width, height, favorites=None,
                         context="", loading=False):
    """The Event Center for an Olympic sport Wikipedia covers: the event's
    name, the podium in medal colours with each medallist and nation, the
    final's table and the event's facts."""
    canvas = Canvas(width, height)
    mode = "big" if width >= 110 and height >= 30 else "small"
    head = Line().add(" ★ EVENT CENTER ", "(tabsel").add(f"  {context}", "accent")
    canvas.line(0, 0, head)
    facts = wiki_infobox_facts(page) if page else []
    when = next((value for label, value in facts if label.lower() in ("dates", "date")), "")
    parts = re.split(r"\s*/\s*", re.sub(r"\s*\([^)]*\)", "", when))
    when = " – ".join(p.strip() for p in parts if p.strip())
    if len(when) > width - len(head.text) - 3:
        when = ""
    if when:
        canvas.put(0, max(len(head.text) + 2, width - len(when) - 1), when[: width - 2], "dim")
    name = event["name"].upper()
    canvas.fill(2, 1, width - 2, 1, " ", "@111111:FFD24A")
    canvas.put(2, max(1, (width - len(name)) // 2), name[: width - 2], "@111111:FFD24A~b")
    medals = event_medallists(event, page)
    y = 4
    if medals:
        block_w = clamp(width // 4, 16, 30)
        heights = {"gold": 6 if mode == "big" else 4, "silver": 4 if mode == "big" else 3,
                   "bronze": 3 if mode == "big" else 2}
        names_h = 4
        base = y + names_h + heights["gold"]
        centre = width // 2
        slots = {"silver": centre - block_w - block_w // 2, "gold": centre - block_w // 2,
                 "bronze": centre + block_w // 2}
        for medal, number in (("gold", "1"), ("silver", "2"), ("bronze", "3")):
            x = slots[medal]
            h = heights[medal]
            color = MEDAL_HEX[medal]
            canvas.fill(base - h, x, block_w, h, " ", f"@111111:{color}")
            digits = big_text(number, "small")
            for index, row in enumerate(digits[:h]):
                canvas.put(base - h + index, x + (block_w - len(row)) // 2, row,
                           f"@111111:{color}~b")
            people = medals.get(medal) or []
            top = base - h - 1
            def fit(text):
                return text if len(text) <= block_w else text[: block_w - 1] + "…"
            for who, code in reversed(people[:2]):
                nation = NOCS.get(code, (code,))[0] if code else ""
                star = STAR + " " if code and fav_rank(favorites or {}, league,
                                                       {"abbr": code}) >= 0 else ""
                label = fit(f"{star}{code}  {nation}".strip()) if code else ""
                if label:
                    canvas.put(top, x + max(0, (block_w - len(label)) // 2), label,
                               THEME.style(league, {"abbr": code}, bold=True,
                                           fallback="accent"))
                    top -= 1
                # a team's medal names the nation; a person's, the person too
                team = "/" in (who or "") or "," in (who or "")
                text = fit(who or "") if who and not team else ""
                if text and text != nation:
                    canvas.put(top, x + max(0, (block_w - len(text)) // 2), text, "bold")
                    top -= 1
            if not people:
                canvas.put(base - h - 1, x + (block_w - 3) // 2, "-", "dim")
        y = base + 2
    else:
        word = "LOADING THE EVENT…" if loading else "NOT DECIDED YET"
        for index, row in enumerate([(" ".join(word), "bold")]):
            canvas.put(y + 2 + index, max(0, (width - len(row[0])) // 2), row[0], row[1])
        y += 5
    # under the podium: the final's table, the event's facts beside it
    rest = height - y
    if rest >= 4:
        facts_w = 38 if width >= 110 and facts else 0
        table_w = width - 4 - (facts_w + 3 if facts_w else 0)
        final = final_table(page) if page else None
        if final:
            title, table = final
            lines = [Line().add(title[: table_w], "title")]
            lines.extend(render_wiki_table(table, table_w, league, favorites,
                                           limit=max(3, rest - 2)))
            canvas.lines(y, 2, lines, table_w, rest)
        elif page and page.get("missing"):
            canvas.put(y, 2, "Wikipedia has no page for this event yet.", "dim")
        elif loading:
            canvas.put(y, 2, "Loading the event page…", "dim")
        if facts_w:
            fact_lines = [Line().add("THE EVENT", "title")]
            for label, value in facts:
                for index, chunk in enumerate(textwrap.wrap(value, facts_w - 13) or [""]):
                    fact_lines.append(Line().add(f"{label if not index else '':<13}",
                                                 "muted").add(chunk, "normal"))
            canvas.lines(y, width - facts_w - 1, fact_lines, facts_w, rest)
        elif facts and not final:
            fact_lines = [Line().add(f"{label:<13}", "muted").add(value[: width - 18],
                                                                  "normal")
                          for label, value in facts]
            canvas.lines(y, 2, fact_lines, width - 4, rest)
    return canvas.rows()


# -- a basketball scorebug (6.19.0) ----------------------------------------------
#
# What a broadcast shows beside each team while a basketball game is played:
# who has the ball (P), the team's fouls, the bonus and the timeouts left.
# ESPN's scoreboard carries none of it for basketball, so it is worked out
# from the play-by-play, rule book in hand (see basketball_scorebug).

BASKETBALL_TIMEOUTS = {"nba": 7, "cbb": 4}     # a team's timeouts in regulation


def basketball_scorebug(summary, event, league):
    """{side: {"fouls", "bonus", "timeouts", "total", "ball"}} for an NBA or
    college basketball game being played: the team's fouls in this quarter
    (in this half in college; overtime counts on from the second half),
    "BONUS" ("2X BONUS" too in college) when its opponent's fouls send it
    to the line, its timeouts left of `total`, and `ball` for the team with
    the ball. ESPN's live situation first where it has them, else the
    play-by-play - the NBA: the penalty from the fifth team foul (the fourth
    in overtime) or the second in a period's last two minutes, offensive and
    technical fouls not counted; seven timeouts, no more than four in the
    fourth quarter and two after its 3:00 mark, two each overtime. College:
    the bonus from the seventh team foul and the double bonus from the
    tenth; four timeouts, three at most carried into the second half and one
    more each overtime. {} when the game is not on or has no plays."""
    if league not in BASKETBALL_TIMEOUTS or event.get("state") != "in":
        return {}
    plays = (summary or {}).get("plays") or []
    if not plays:
        return {}
    college = league in COLLEGE_LEAGUES
    # 7.0.0: the WNBA fouls as the NBA does, women's college a quarter at a time
    by_quarter = quarters(league)
    sides = {str(event["away"].get("id")): "away", str(event["home"].get("id")): "home"}
    other = {"away": "home", "home": "away"}
    period = _int(dig(plays[-1], "period", "number", default=1)) or 1
    fouls, late = {"away": 0, "home": 0}, {"away": 0, "home": 0}
    used = {"away": {}, "home": {}}
    after3 = {"away": 0, "home": 0}
    ball = None

    def counts(number):
        """Whether a foul in period `number` is in this period's count."""
        if by_quarter:
            # women's college: overtime's fouls count on from the fourth quarter
            if college and period > 4:
                return number >= 4
            return number == period
        return number == period if period == 1 else number >= 2

    for play in plays:
        kind = clean(dig(play, "type", "text", default="") or "").lower()
        squeezed = kind.replace(" ", "").replace("-", "")
        side = sides.get(str(dig(play, "team", "id", default="") or ""))
        number = _int(dig(play, "period", "number", default=0))
        left = wire_seconds(dig(play, "clock", "displayValue", default=""))
        text = clean(play.get("text") or "").lower()
        if "timeout" in squeezed:
            if side and "official" not in squeezed and "tv" not in squeezed:
                used[side][number] = used[side].get(number, 0) + 1
                if not college and number == 4 and left is not None and left <= 180:
                    after3[side] += 1
            continue
        if "foul" in squeezed and "turnover" not in squeezed:
            technical = "technical" in squeezed or "double" in squeezed
            if side and not technical and counts(number) and \
                    not (not college and "offensive" in squeezed):
                fouls[side] += 1
                if not college and left is not None and left <= 120:
                    late[side] += 1
            if side and not technical:
                ball = other[side]          # the other side shoots, or takes it in
            continue
        if not side:
            if "endperiod" in squeezed or "endgame" in squeezed:
                ball = None
            continue
        if "jump" in squeezed and "ball" in squeezed:
            ball = other[side] if "lost" in text else side
        elif "rebound" in squeezed or "steal" in squeezed:
            ball = side
        elif "block" in squeezed:
            ball = None
        elif "freethrow" in squeezed:
            if "technical" in squeezed or "technical" in text:
                continue
            shot = re.search(r"(\d) of (\d)", text) or re.search(r"(\d) of (\d)", kind)
            final = not shot or shot.group(1) == shot.group(2)
            if not final:
                ball = side
            else:
                ball = other[side] if play.get("scoringPlay") else None
        elif play.get("shootingPlay"):
            ball = other[side] if play.get("scoringPlay") else None
        elif "goaltending" in squeezed:
            ball = side if "defensive" in squeezed else other[side]
        elif "turnover" in squeezed or "violation" in squeezed or "traveling" in squeezed:
            ball = other[side]
    now = wire_seconds(dig(plays[-1], "clock", "displayValue", default=""))
    situation = event.get("situation") or {}
    holder = sides.get(str(situation.get("possession") or ""))
    out = {}
    for side in ("away", "home"):
        mine = used[side]
        if college and by_quarter:
            # women's college: four for the game, three at most into the third
            # quarter, one more each overtime (7.0.0)
            extra = max(0, period - 4)
            total = BASKETBALL_TIMEOUTS.get(league, 4) + extra
            first = mine.get(1, 0) + mine.get(2, 0)
            if period <= 2:
                left = 4 - first
            else:
                left = min(4 - first, 3) - mine.get(3, 0) - mine.get(4, 0) + extra - \
                    sum(count for at, count in mine.items() if at >= 5)
        elif college:
            total = BASKETBALL_TIMEOUTS["cbb"] + max(0, period - 2)
            first = mine.get(1, 0)
            if period == 1:
                left = 4 - first
            else:
                left = min(4 - first, 3) - mine.get(2, 0) + max(0, period - 2) - \
                    sum(count for at, count in mine.items() if at >= 3)
        elif league != "nba" and period <= 4:
            # the WNBA: its timeouts for the game, no more than two after its
            # last two minutes (7.0.0)
            total = BASKETBALL_TIMEOUTS.get(league, 4)
            left = total - sum(count for at, count in mine.items() if at <= 4)
        elif period <= 4:
            total = BASKETBALL_TIMEOUTS["nba"]
            left = 7 - sum(count for at, count in mine.items() if at <= 4)
            if period == 4:
                left = min(left, 4 - mine.get(4, 0))
                if now is not None and now <= 180:
                    left = min(left, 2 - after3[side])
        else:
            total, left = 2, 2 - mine.get(period, 0)
        live = situation.get(f"{side}Timeouts")
        if isinstance(live, int) and 0 <= live <= 9:
            left = live
        opponent = fouls[other[side]]
        if college and by_quarter:
            bonus = "BONUS" if opponent >= 5 else ""       # two shots from the fifth
        elif college:
            bonus = "2X BONUS" if opponent >= 10 else "BONUS" if opponent >= 7 else ""
        else:
            bonus = "BONUS" if opponent >= (5 if period <= 4 else 4) or \
                late[other[side]] >= 2 else ""
        out[side] = {"fouls": fouls[side], "bonus": bonus, "timeouts": max(0, left),
                     "total": total, "ball": (holder or ball) == side}
    return out


def hockey_scorebug(summary, event, league, live=None):
    """{side: {"sog", "pp", "pp_left", "sh", "en", "timeouts", "total"}} for a
    hockey game being played (7.0.0), for under its logos in the Game Center:
    its shots on goal, a power play with the time left on it (or the other
    side killing one), an empty net - from `live`, the NHL's own situation
    or the AHL's penalties at the clock ({pp, pp_left, en}) - and its one
    timeout, kept or used, where the play by play shows the stoppages (the
    NHL's). {} when the game is not on."""
    if sport_of(league) != "hockey" or event.get("state") != "in":
        return {}
    sides = {str(event["away"].get("id")): "away", str(event["home"].get("id")): "home"}
    sog = {}
    for team in dig(summary, "boxscore", "teams", default=[]) or []:
        side = sides.get(str(dig(team, "team", "id", default="") or ""))
        for stat in team.get("statistics") or []:
            if side and stat.get("name") == "shotsTotal":
                number = _num(stat.get("displayValue"))
                if number is not None:
                    sog[side] = int(number)
    used, stoppages = {"away": 0, "home": 0}, False
    for play in dig(summary, "plays", default=[]) or []:
        kind = clean(dig(play, "type", "text", default="") or "").lower()
        text = clean(play.get("text") or "").lower()
        if kind == "stoppage":
            stoppages = True
        if "timeout" in text and "tv" not in text and "official" not in text:
            if "visitor" in text or "away" in text:
                used["away"] += 1
            elif "home" in text:
                used["home"] += 1
    live = live or {}
    out = {}
    for side, other in (("away", "home"), ("home", "away")):
        out[side] = {"sog": sog.get(side), "pp": live.get("pp") == side,
                     "pp_left": live.get("pp_left") or "" if live.get("pp") == side else "",
                     "sh": live.get("pp") == other, "en": live.get("en") == side,
                     "timeouts": max(0, 1 - used[side]) if stoppages else None, "total": 1}
    return out


def hockey_bug_line(info, league, width):
    """One team's hockey scorebug line under its score (7.0.0): its shots on
    goal, then POWER PLAY and the time left lit while it has one (PP when
    the room is short), EMPTY NET while its goalie is out - in a slot of its
    own, so nothing moves when a penalty starts or ends."""
    lit = f"@{BULB_TEXT['lit']}~b"
    for label, power, empty in (("SOG ", "POWER PLAY ", "EMPTY NET"), ("SOG ", "PP ", "EN"),
                                ("S ", "PP ", "EN")):
        status = ""
        if info.get("en"):
            status = empty
        elif info.get("pp"):
            status = (power + (info.get("pp_left") or "")).strip()
        slot = max(len(power) + 5, len(empty))
        sog = "" if info.get("sog") is None else str(info["sog"])
        size = len(label) + len(sog) + 2 + slot
        if size <= width:
            break
    line = Line()
    if sog:
        line.add(label, "muted").add(sog, "bold").add("  ", "normal")
    if status:
        line.add(f"{status:<{slot}}"[:slot], "warn" if info.get("en") else lit)
    elif info.get("sh"):
        line.add(f"{'SHORT-HANDED' if slot >= 12 else 'SH':<{slot}}"[:slot], "dim")
    else:
        line.add(" " * slot, "normal")
    return line if len(line.text) <= width else fit_line(line, max(0, width))


def scorebug_line(info, league, width):
    """One team's scorebug line under its score: P lit when it has the ball,
    its team fouls, BONUS (2X BONUS in college) when it is in the bonus -
    the lamps that are off left blank in their places, so nothing moves;
    shorter words when the room is short."""
    lit = f"@{BULB_TEXT['lit']}~b"
    slot = 8 if league == "cbb" else 5
    for foul_word, bonus_word, gap in (("FOULS ", None, "  "), ("FOULS ", None, " "),
                                       ("F", None, " "), ("F", "BNS", " ")):
        bonus = info["bonus"]
        if bonus_word and bonus:
            bonus = bonus.replace("BONUS", bonus_word)
        size = 1 + len(gap) + len(foul_word) + len(str(info["fouls"])) + len(gap) + \
            (slot if bonus_word is None else 6)
        if size <= width:
            break
    line = Line().add("P" if info["ball"] else " ", lit)
    line.add(gap + foul_word, "muted").add(str(info["fouls"]), "bold").add(gap, "normal")
    width_left = slot if bonus_word is None else 6
    line.add(f"{bonus:<{width_left}}"[:width_left], lit)
    return line if len(line.text) <= width else fit_line(line, max(0, width))


def compose_center(event, summary, league, width, height, now=None, flash=None,
                   favorites=None, context="", art=None, corners=None, face=None,
                   ball_art=None, bulb_art=None, positions=None, pictures=False,
                   hockey=None):
    """The whole Game Center as [Line], `height` rows of `width` columns.
    `art(side, cols, rows)`, when given, is each team's badge or logo, set
    beside its score when the screen is big enough; basketball's parts are
    on cards with `corners`, and `face(ref, cols, rows)` gives a player's
    photo where the terminal shows pictures. `ball_art(cols, rows)` is
    football's ball as a picture there ([] elsewhere: it is drawn in half
    blocks), `bulb_art(text, mode, tone, cols, rows)` the scores' and the
    clock's light bulbs (band_number), and `positions` {athlete id:
    (abbreviation, name)} what football's LEADERS play. `hockey` is a hockey
    game's live {pp, pp_left, en} for its scorebug (7.0.0)."""
    now = now or time.time()
    canvas = Canvas(width, height)
    away, home = event["away"], event["home"]
    mode = "big" if width >= 120 and height >= 34 else "small"
    # header: what this is, the game state, where to watch
    head = Line().add(" ★ GAME CENTER ", "(tabsel").add(f"  {context}", "accent")
    canvas.line(0, 0, head)
    right = event.get("long_detail") or status_text(event)
    if event.get("broadcast"):
        right += f"  ·  {event['broadcast']}"
    canvas.put(0, max(len(head.text) + 2, width - len(right) - 1), right[: width - 2],
               "live" if event["state"] == "in" else "dim")
    # the score band
    third = width // 3
    band_top = 2
    digits_h = 5 if mode == "big" else 3
    # football, while it is played: a ball between the logo and the score of
    # the team that has it (both sides keep its room, so nothing moves when it
    # changes hands) and the timeouts left under each logo
    ball, ball_side, timeouts = [], None, {}
    if sport_of(league) == "football" and event["state"] == "in":
        ball = football_ball(3 if mode == "big" else 2, league)
        ball_side = football_possession(event, summary)
        situation = event.get("situation") or {}
        for side in ("away", "home"):
            count = situation.get(f"{side}Timeouts")
            if isinstance(count, int) and 0 <= count <= 3:
                timeouts[side] = count
    ball_w = max((len(line.text) for line in ball), default=0)
    # basketball, while it is played: a broadcast scorebug's possession,
    # fouls, bonus (under the score) and timeouts (under the logo); hockey's
    # shots, power play and empty net, and its timeout (7.0.0)
    scorebug = basketball_scorebug(summary, event, league) or \
        hockey_scorebug(summary, event, league, hockey)
    bug_line = hockey_bug_line if sport_of(league) == "hockey" else scorebug_line
    for side, x0, align in (("away", 0, "left"), ("home", width - third, "right")):
        team = event[side]
        color = team_hex(league, team)
        ink = _ink_on(color)
        name = (team.get("name") or team.get("abbr") or "").upper()
        rank = f"#{team['rank']} " if league in RANKED_LEAGUES and team.get("rank") else ""
        star = f"{STAR} " if favorites and fav_rank(favorites, league, team) >= 0 else ""
        label = f" {star}{rank}{name} "
        canvas.fill(band_top, x0 + 1, third - 2, 1, " ", f"@{ink}:{color}")
        canvas.put(band_top, x0 + 1 + max(0, (third - 2 - len(label)) // 2),
                   label[: third - 2], f"@{ink}:{color}~b")
        record = team.get("record") or ""
        if side == "home" and event.get("neutral"):
            record += "  neutral site"
        score = team.get("score")
        style = THEME.style(league, team, bold=True)
        tone = "lit"
        if event["state"] == "pre":
            # no score yet: the records, scoreboard-style
            shown = re.sub(r"[^0-9-]", "", record.split(",")[0].split("  ")[0])
            number = shown if shown and len(shown) <= 8 else ""
            style = THEME.style(league, team)
            record = "RECORD" if number else record
        else:
            number = "" if score is None else str(score)
            if re.fullmatch(r"\d", number):
                number = "~" + number           # the tens, unlit, as a scoreboard has them
        if event["state"] == "post" and not team.get("winner") and score is not None:
            style, tone = "dim", "low"
        if flash and flash[0] == side and int(now * 4) % 2 == 0:
            style, tone = "live", "hot"         # a score's bulbs flash
        digits = band_number(number, mode, tone, style, bulb_art)
        logo = []
        if digits and art and mode == "big":
            # two-column gaps either side (and the ball's room, in football)
            room = third - len(digits[0].text) - 6 - (ball_w + 2 if ball_w else 0)
            if room >= 12:
                logo = [line for line in (art(side, room, digits_h + 2) or [])]
        mid_x = x0 + third // 2
        lx = lw = None
        if digits:
            dw = len(digits[0].text)
            dx = x0 + (third - dw) // 2
            bx = None
            if logo:
                # the badge or logo on the outer side, the score inside it, and
                # football's ball between them
                lw = max(len(line.text) for line in logo)
                if ball_w:
                    gap = max(1, (third - 2 - lw - dw - ball_w) // 4)
                    if side == "away":
                        lx = x0 + 1 + gap
                        bx = lx + lw + gap
                        dx = bx + ball_w + gap
                    else:
                        dx = x0 + third - 1 - gap - lw - gap - ball_w - gap - dw
                        bx = dx + dw + gap
                        lx = bx + ball_w + gap
                else:
                    gap = max(2, (third - 2 - lw - dw) // 3)
                    if side == "away":
                        lx, dx = x0 + 1 + gap, x0 + 1 + gap + lw + gap
                    else:
                        dx = x0 + third - 1 - gap - lw - gap - dw
                        lx = dx + dw + gap
                ly = band_top + 1 + max(0, (digits_h + 2 - len(logo)) // 2)
                canvas.lines(ly, lx, logo, lw)
                mid_x = dx + dw // 2
            elif ball_w:
                # no logo: the ball on the outer side of the score
                start = x0 + max(1, (third - dw - ball_w - 2) // 2)
                if side == "away":
                    bx, dx = start, start + ball_w + 2
                else:
                    dx, bx = start, start + dw + 2
                mid_x = dx + dw // 2
            if ball_w and side == ball_side and bx is not None:
                # a picture of a real football where the terminal shows them,
                # in the middle of the ball's room
                shown = (ball_art(ball_w, len(ball)) if ball_art else None) or ball
                shown_w = max(len(line.text) for line in shown)
                canvas.lines(band_top + 2 + max(0, (digits_h - len(shown)) // 2),
                             bx + max(0, (ball_w - shown_w) // 2), shown, shown_w)
            canvas.lines(band_top + 2, dx, digits, dw)
        under = band_top + 2 + digits_h + 1
        if side in scorebug:
            # under the score in place of the record; on a small screen, with
            # the timeouts at the outer edge, a row lower
            bug = bug_line(scorebug[side], league, third - 4)
            span = len(bug.text)
            bug_x = mid_x - span // 2 if logo else x0 + (third - span) // 2
            if logo and lx is not None:
                bug_x = max(bug_x, lx + lw + 1) if side == "away" else \
                    min(bug_x, lx - 1 - span)
            canvas.line(under if logo else under + 1,
                        clamp(bug_x, x0 + 1, x0 + third - 1 - span), bug, span)
        else:
            record_x = mid_x - len(record) // 2 if logo else x0 + (third - len(record)) // 2
            canvas.put(under, max(x0 + 1, record_x), record[: third - 2], "dim")
        if side in scorebug and scorebug[side].get("timeouts") is not None:
            count, total = scorebug[side]["timeouts"], scorebug[side]["total"]
            plain = 2 * max(total, count) - 1
            marks = football_timeout_marks(count, league, event[side],
                                           label=(bool(lw) and lw + 6 >= plain + 10) or
                                           total == 1,
                                           total=total,
                                           word="timeout" if total == 1 else "timeouts")
            span = len(marks.text)
            if lx is not None and lw:
                tx = lx + max(0, (lw - span) // 2)
            elif side == "away":
                tx = x0 + 2
            else:
                tx = x0 + third - 2 - span
            canvas.line(under, max(x0 + 1, tx), marks, min(span, third - 2))
        if side in timeouts:
            # the timeouts left: under the logo, else at the outer edge
            marks = football_timeout_marks(timeouts[side], league, event[side],
                                           label=bool(lw) and lw >= 9)
            span = len(marks.text)
            if lx is not None and lw:
                tx = lx + max(0, (lw - span) // 2)
            elif side == "away":
                tx = x0 + 2
            else:
                tx = x0 + third - 2 - span
            canvas.line(under, max(x0 + 1, tx), marks, min(span, third - 2))
    # the middle: clock and period, the final, or the countdown
    mid = third
    middle = []
    if event["state"] == "in":
        clock = (event.get("clock") or "").strip()
        sport = sport_of(league)
        detail = event.get("detail") or ""
        if sport == "baseball":
            # the inning in bulbs, the half under it
            match = re.search(r"(\d+)", detail)
            if match:
                middle = [(row, None) for row in band_number(match.group(1), mode, "lit",
                                                             "live", bulb_art)]
            middle.append(("", "normal"))
            middle.append((detail.upper(), "bold"))
        elif sport == "soccer":
            minute = re.match(r"(\d{1,3})'?(?:\+(\d{1,2}))?", clock or detail or "")
            if minute:
                shown = minute.group(1) + (f"+{minute.group(2)}" if minute.group(2) else "")
                middle = [(row, None) for row in band_number(shown + "'", mode, "lit", "live",
                                                             bulb_art)]
            middle.append(("", "normal"))
            middle.append(((detail or "").upper(), "bold"))
        else:
            period = short_clock(event).replace(clock, "").strip() if clock else detail
            if clock and re.fullmatch(r"\d{1,2}(:\d{2})?(\.\d)?", clock):
                # a scoreboard's clock: its tens of minutes unlit under ten
                shown = "~" + clock if re.fullmatch(r"\d:\d\d", clock) else clock
                middle = [(row, None) for row in band_number(shown, mode, "lit", "live",
                                                             bulb_art)]
            middle.append(("", "normal"))
            middle.append((period.upper(), "bold"))
    elif event["state"] == "post":
        word = (event.get("detail") or "Final").upper()
        middle = [("", "normal"), (" ".join(word), "bold"), ("", "normal"),
                  (event_when(event), "dim")]
    else:
        value, unit = countdown_text(event, now, league)
        if value:
            shown = "~" + value if re.fullmatch(r"\d:\d\d", value) else value
            middle = [(row, None) for row in band_number(shown, mode, "lit", "accent",
                                                         bulb_art)]
            middle.append((unit, "dim"))
        middle.append((event_when(event, with_zone=True), "bold"))
    for index, (text, style) in enumerate(middle):
        if style is None:               # a row of the clock's bulbs
            canvas.line(band_top + 1 + index, mid + max(0, (third - len(text.text)) // 2),
                        text, third)
            continue
        canvas.put(band_top + 1 + index, mid + max(0, (third - len(text)) // 2),
                   text[: third], style)
    y = band_top + 2 + digits_h + 3     # banner, gap, digits, gap, record, gap
    # a score flashes across the screen
    if flash and now < flash[2]:
        team = event[flash[0]]
        color = team_hex(league, team)
        ink = _ink_on(color)
        text = f"{STAR}  {'  '.join(flash[1])}  ·  {team.get('abbr', '')}  {STAR}"
        bg, fg = (color, ink) if int(now * 3) % 2 == 0 else (ESPN_GOLD.lstrip("#"), "111111")
        canvas.fill(y, 0, width, 1, " ", f"@{fg}:{bg}")
        canvas.put(y, max(0, (width - len(text)) // 2), text[:width], f"@{fg}:{bg}~b")
        y += 2
    if sport_of(league) == "basketball":
        compose_basketball(canvas, y, event, summary, league, width, height, corners, face)
        return canvas.rows()
    if sport_of(league) in ("football", "hockey", "baseball", "soccer"):
        compose_cards(canvas, y, event, summary, league, width, height, corners, face,
                      positions, pictures)
        return canvas.rows()
    # the situation
    sport = sport_of(league)
    if event["state"] == "in" and sport == "football" and height - y > 16:
        # between plays ESPN sometimes drops who has the ball; the drive knows
        driving = str(dig(summary, "drives", "current", "team", "id", default="") or "")
        hint = "away" if driving and driving == str(away.get("id")) else \
            "home" if driving and driving == str(home.get("id")) else ""
        field = render_field(event, league, min(width - 2, 132), hint)
        canvas.lines(y, max(1, (width - min(width - 2, 132)) // 2), field)
        y += len(field) + 1
    elif event["state"] == "in" and sport == "baseball" and height - y > 14:
        diamond = center_diamond(event, league, min(width - 4, 84))
        canvas.lines(y, max(2, (width - 84) // 2), diamond, width - 2)
        y += len(diamond) + 1
    elif summary and height - y > 14 and (
            (sport in ("basketball", "hockey", "soccer") and event["state"] != "pre")
            or (sport in ("football", "baseball") and event["state"] == "post")):
        # the court with each side's shots, the rink with every shot on goal,
        # the match timeline - and the numbers a broadcast puts beside them
        panel = sport_panel(summary, event, league, width - 4, clamp(height - y - 9, 6, 18))
        if panel:
            canvas.lines(y, 2, panel, width - 4)
            y += len(panel) + 1
    elif event["state"] == "in" and not dig(summary, "plays", default=None):
        last = clean(dig(event.get("situation") or {}, "lastPlay", "text", default=""))
        if last:
            for line in wrap_spans("Last: " + last, width - 4, "dim")[:2]:
                canvas.line(y, 2, line)
                y += 1
            y += 1
    # win probability
    if summary and height - y > 10:
        win = render_winbar(summary, event, league, min(width - 4, 140))
        if win:
            canvas.lines(y, 2, win)
            y += len(win) + 1
    # below: line score and team stats | plays (or the matchup before it starts)
    rest = height - y
    if rest < 3:
        return canvas.rows()
    left_w = width // 2 - 2
    right_w = width - left_w - 6
    left = []
    linescore = render_linescore(event, league)
    if sport == "soccer" and not (away.get("linescores") or home.get("linescores")):
        linescore = []          # ESPN keeps no half-by-half score for these
    if linescore:
        left.extend(linescore)
        left.append(blank())
    if summary and event["state"] != "pre":
        graph, _ = team_stat_sections(summary, league, left_w)
        left.extend(graph[: max(0, rest - len(left))])
    elif event["state"] == "pre":
        left.extend(center_pregame(event, summary, league, left_w))
    right = []
    if summary and event["state"] != "pre":
        right = recent_plays(summary, event, league, right_w, count=max(4, rest // 2))
        if event["state"] == "post" and not right:
            right = render_game_leaders(summary, league, right_w)
    elif summary:
        leaders = render_leaders(league, [away, home], right_w) if \
            (away.get("leaders") or home.get("leaders")) else []
        if leaders:
            right = [Line().add("SEASON LEADERS", "title")] + leaders
    canvas.lines(y, 2, left, left_w, rest)
    canvas.lines(y, left_w + 5, right, right_w, rest)
    return canvas.rows()


def today_sections(slate, favorites):
    """[(heading, [(league, event)])] for the Overview's Today list: live now,
    coming up, final - your teams first in each, then the leagues in order."""
    live, coming, done = [], [], []
    for league in SLATE_LEAGUES:
        for event in slate.get(league) or []:
            {"in": live, "pre": coming}.get(event["state"], done).append((league, event))

    def mine(item):
        return 0 if slate_is_fav(item[1], item[0], favorites) else 1

    def margin(item):
        event = item[1]
        return abs((event["away"]["score"] or 0) - (event["home"]["score"] or 0))
    live.sort(key=lambda it: (mine(it), SLATE_LEAGUES.index(it[0]), margin(it)))
    coming.sort(key=lambda it: (mine(it), it[1].get("date") or "",
                                SLATE_LEAGUES.index(it[0])))
    done.sort(key=lambda it: (mine(it), SLATE_LEAGUES.index(it[0]),
                              it[1].get("date") or ""))
    return [("LIVE NOW", live), ("COMING UP", coming), ("FINAL", done)]


def today_line(league, event, favorites, width, chosen=False):
    """One game on the Today list, `width` columns: star, league, time or
    clock, the two teams (and scores), the network."""
    line = Line()
    fav = slate_is_fav(event, league, favorites)
    line.add("▌" if chosen else " ", "selbar" if chosen else "normal")
    line.add(STAR if fav else " ", "seldim" if chosen else "star")
    line.add(f" {LEAGUE_SHORT.get(league, league.upper()):<6}", "seldim" if chosen else "muted")
    state = event["state"]
    clock = short_clock(event)
    if state == "pre":
        line.add(f"{clock:>6}  ", "sel" if chosen else "accent")
    college = league in RANKED_LEAGUES
    for index, side in enumerate(("away", "home")):
        team = event[side]
        name = team.get("abbr") or "?"
        if college and team.get("rank"):
            name = f"{team['rank']} {name}"
        if index:
            line.add(" @ " if state == "pre" else "  ", "seldim" if chosen else "muted")
        loser = state == "post" and not team.get("winner")
        line.add(name, THEME.style(league, team, selected=chosen, bold=not loser, dim=loser))
        if team["score"] is not None and state != "pre":
            line.add(f" {team['score']}", "sel" if chosen else "dim" if loser else "bold")
    if state != "pre":
        line.add(f"  {clock}", "sel" if chosen else "live" if state == "in" else "dim")
    tv = (event.get("broadcast") or "").split(",")[0].strip()
    used = sum(len(t) for t, _ in line)
    if tv and used + len(tv) + 3 <= width:
        line.add(" " * max(2, width - used - len(tv)), "sel" if chosen else "normal")
        line.add(tv, "seldim" if chosen else "dim")
    used = sum(len(t) for t, _ in line)
    if used > width:
        trimmed, room = Line(), width
        for text, style in line:
            if room <= 0:
                break
            trimmed.append((text[:room], style))
            room -= len(text)
        line = trimmed
    elif chosen and used < width:
        line.append((" " * (width - used), "sel"))
    return line


def overview_entries(favorites):
    """[(league, team)] for every favourite outside the Olympics, in the
    usual league order."""
    out = []
    for fam in LEAGUE_ORDER:
        if fam in ("owg", "osg"):
            continue
        for team in favorites.get(fam) or []:
            if team.get("id"):
                out.append((fam, team))
    return out


def overview_line_map(entries, which):
    """(team index, side) for each line render_overview_rows draws, None for
    the league headings and the blank lines between them."""
    out, previous = [], None
    for index, (league, _) in enumerate(entries):
        if league != previous:
            if out:
                out.append(None)
            out.append(None)
            previous = league
        if which == "both":
            out.extend([(index, "last"), (index, "next")])
        else:
            out.append((index, which))
    return out


def render_overview_rows(app, entries, glances, width, which, logo_gap=0, spots=None):
    """Favourites grouped under league headings: each team's latest result
    ('last'), its next game ('next'), or both, the next game on a second
    line underneath ('both', for a narrow screen). `logo_gap` leaves that
    many columns after the cursor bar for a logo, and `spots` (a dict) learns
    which line holds which (league, team)."""
    lines, cursor_line = [], 0
    name_width = clamp(max([len(t.get("name") or t.get("abbr") or "")
                            for _, t in entries] + [8]) + 1, 10, 26)
    previous = None

    rest = max(20, width - 3 - logo_gap - name_width)   # what is left beside the name

    def describe(glance, result, league, kind, chosen):
        base = "sel" if chosen else "normal"
        out = Line()
        if glance is None:
            text = "loading…" if result is None or result.loading else \
                f"unavailable: {result.error}" if result.error else "-"
            return out.add(text, "seldim" if chosen else "dim")
        if kind == "last":
            game = glance.get("last")
            if not game:
                return out.add("no results yet", "seldim" if chosen else "dim")
            mark = game["result"] or "-"
            style = "good" if mark.startswith("W") else "bad" if mark.startswith("L") \
                else "accent"
            out.add(f"{mark:<5}", "sel" if chosen else style)
            score = f"{game['us']}-{game['them']}" if game.get("us") is not None else ""
            out.add(f"{score:<8}", base if chosen else "bold")
            when = glance_when(game, with_time=False)
            opp_w = clamp(rest - 13 - len(when) - 1, 6, 23)
            out.add(f"{glance_opponent(game, league)[:opp_w - 1]:<{opp_w}}", base)
            return out.add(when, "seldim" if chosen else "dim")
        live = glance.get("live")
        game = live or glance.get("next")
        if not game:
            return out.add("nothing scheduled", "seldim" if chosen else "dim")
        if live:
            out.add("LIVE ", "sel" if chosen else "live")
            score = f"{live['us']}-{live['them']}" if live.get("us") is not None else ""
            out.add(f"{score:<8}", base if chosen else "bold")
            opp_w = clamp(rest - 13 - 12, 6, 23)
            out.add(f"{glance_opponent(live, league)[:opp_w - 1]:<{opp_w}}", base)
            return out.add(live.get("detail") or "", "seldim" if chosen else "accent")
        when = glance_when(game)
        opp_w = clamp(rest - max(17, len(when) + 1) - (6 if game.get("tv") else 0), 6, 25)
        out.add(f"{glance_opponent(game, league)[:opp_w - 1]:<{opp_w}}", base)
        out.add(f"{when:<17}", base if chosen else "accent")
        if game.get("tv"):
            out.add(game["tv"][:10], "seldim" if chosen else "dim")
        return out

    def finish(line, chosen):
        used = sum(len(t) for t, _ in line)
        if used > width:
            trimmed, room = Line(), width
            for text, style in line:
                if room <= 0:
                    break
                trimmed.append((text[:room], style))
                room -= len(text)
            line = trimmed
        elif chosen and used < width:
            line.append((" " * (width - used), "sel"))
        return line

    for index, (league, team) in enumerate(entries):
        if league != previous:
            if lines:
                lines.append(blank())
            lines.append(Line().add(f" {LEAGUE_SHORT.get(league, league)}", "header"))
            previous = league
        row_chosen = index == app.overview_cursor
        side = getattr(app, "overview_side", "next")
        if row_chosen:
            cursor_line = len(lines)
        result = glances.get((league, team["id"]))
        glance = result.data if result else None
        shown = dict(team)
        if glance and glance.get("color") and not shown.get("color"):
            shown["color"] = glance["color"]
        first = "last" if which == "both" else which
        # the highlight sits on the game enter will open: the result or the
        # next game; the team's other game keeps a faint marker
        chosen = row_chosen and side == first
        line = Line().add("▌" if row_chosen else " ",
                          "selbar" if chosen else "muted" if row_chosen else "normal")
        if logo_gap:
            line.add(" " * logo_gap, "sel" if chosen else "normal")
            if spots is not None:
                spots[len(lines)] = (league, shown)
        name = (team.get("name") or team.get("abbr") or "?")[:name_width - 1]
        line.add(STAR + " ", "seldim" if chosen else "star")
        line.add(f"{name:<{name_width}}", THEME.style(league, shown, selected=chosen,
                                                       bold=True, fallback="sel" if chosen
                                                       else "normal"))
        line.extend_spans(describe(glance, result, league, first, chosen))
        lines.append(finish(line, chosen))
        if which == "both":
            chosen = row_chosen and side == "next"
            second = Line().add("▌" if row_chosen else " ",
                                "selbar" if chosen else "muted" if row_chosen else "normal")
            second.add(" " * (2 + logo_gap) + f"{'next':>{name_width - 1}} ",
                       "seldim" if chosen else "muted")
            second.extend_spans(describe(glance, result, league, "next", chosen))
            lines.append(finish(second, chosen))
    return lines, cursor_line


