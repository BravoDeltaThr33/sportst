def info_boxscore(summary, league):
    sections = [("This screen", [
        _p("Every player who appeared, team by team (home on the left). Each table's "
           "name sits in its header row's first cell; the Totals row is the team. "
           "Dimmed players came off the bench."),
    ])]
    seen = {}
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        for section in block.get("statistics") or []:
            title = stat_section_title(section)
            for prefix in (dig(block, "team", "displayName", default=""),
                           dig(block, "team", "location", default="")):
                if prefix and title.lower().startswith(prefix.lower() + " "):
                    title = title[len(prefix) + 1:]
            labels = section.get("labels") or []
            descriptions = section.get("descriptions") or []
            for index, label in enumerate(labels):
                text = descriptions[index] if index < len(descriptions) else ""
                text = clean(text).rstrip("./")
                key = (title, label)
                if key not in seen:
                    seen[key] = text or BOX_GLOSSARY.get(label, "")
    grouped = {}
    for (title, label), text in seen.items():
        grouped.setdefault(title or "Players", []).append((label, text.lower() if text
                                                           and text.isupper() else text))
    for title, entries in grouped.items():
        sections.append((title, entries))
    if len(sections) == 1:
        sections.append(("", [_p("The box score has not been published yet.")]))
    if league in CARD_LEAGUES:
        sections.insert(1, info_player_card(league))
    if sport_of(league) == "basketball" and not is_olympic(league):
        sections.insert(1, ("Under each team", [
            ("Starters / Bench", "what the five who started and everyone off the bench "
                                 "put up: points (and their share of the team's), FG, "
                                 "3PT and FT made-attempted, rebounds, assists"),
            ("Shooting", "the team's FG%, 3PT% and FT%, then eFG% (effective field goal "
                         "%: a three counts one and a half) and TS% (true shooting: "
                         "points per two shots, free throws included)"),
            ("Double-double", "anyone with ten or more in two of points, rebounds, "
                              "assists, steals and blocks (a triple-double in three)"),
        ]))
    if is_baseball(league) and not is_olympic(league):
        # 7.0.0
        sections.insert(1, ("Under each team (baseball)", [
            ("Totals", "added up from the players where ESPN sends only dashes "
                       "(college); a position ESPN does not know is left off"),
            ("Batting", "the box score's notes as ESPN sends them: doubles, triples and "
                        "homers (the season's total and off whom), RBI, two-out RBI, "
                        "sacrifice flies and bunts, into DP, left on base, With RISP "
                        "(hits-at bats with a runner on second or third, by batter), "
                        "Stranded, 2 out (runners in scoring position left with two "
                        "out)"),
            ("Baserunning / Fielding", "steals and caught stealing (base, off whom); "
                                       "errors, double plays, outfield assists"),
            ("Pitching", "hit by pitch, first-pitch strikes of the batters faced, "
                         "Strikes as called-swinging-foul-in play, ground balls-fly "
                         "balls, the starter's game score (Bill James's: 50 average, "
                         "the 90s great), notes"),
            ("Game (home side)", "the decisions (W, L, S), the umpires at each base, the "
                                 "time of the game, the crowd and the ballpark"),
            ("Line score / Scoring plays (visitors)", "runs by inning with R H E LOB, then "
                                                      "every play that scored: the "
                                                      "half-inning (T top, B bottom), "
                                                      "the side, the play and the score "
