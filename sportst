MEDAL_STYLES = {"gold": "medalgold", "silver": "medalsilver", "bronze": "medalbronze"}
MEDAL_ORDER = ["gold", "silver", "bronze"]
SKIP_EVENT = re.compile(r"qualification|rosters|statistics|squads|^talk:|^special:|"
                        r"venues|schedule|draw", re.I)
GENDER_WORDS = re.compile(r"\b(men'?s?|women'?s?|mixed|open|b-boys|b-girls)\b", re.I)


def event_gender(text):
    low = (text or "").lower()
    if "women" in low or "b-girls" in low:
        return "women"
    if re.search(r"\bmen\b|\bmen's|b-boys", low):
        return "men"
    if "mixed" in low:
        return "mixed"
    return ""


def event_key(text):
    """'Men's 50-metre freestyle' and '50 m freestyle' both -> '50 m freestyle'."""
    low = clean(text).lower().replace("’", "'").replace("×", "x")
    low = GENDER_WORDS.sub(" ", low)
    low = re.sub(r"(\d)\s*-?\s*(kilometres?|km)\b", r"\1 km", low)
    low = re.sub(r"(\d)\s*-?\s*(metres?|m)\b", r"\1 m", low)
    low = re.sub(r"\b(tournament|event|competition|details|artistic|rhythmic|exercise)\b",
                 " ", low)
    low = re.sub(r"[^a-z0-9 ]+", " ", low)
    return re.sub(r"\s+", " ", low).strip()


def cell_noc(cell):
    if not cell or not cell.get("noc"):
        return ""
    return noc_code({"name": cell["noc"]}) or ""


def split_entrant(cell):
    """(athlete or team text, IOC code) for a medallist or results cell."""
    text = clean(cell.get("text") or "")
    code = cell_noc(cell)
    country = clean(cell.get("noc") or "")
    parts = [p.strip() for p in text.split(" / ") if p.strip()]
    if country and parts:
        rest = [p for p in parts if norm_name(p) != norm_name(country)]
        if len(rest) < len(parts):
            return ", ".join(rest), code
    if country and norm_name(text) == norm_name(country):
        return "", code
    return ", ".join(parts), code


def sport_events(league, page):
    """The medal events of one sport: [{title, name, gender, medals}], medals
    as {'gold': [(athlete, code)], ...} when the sport page lists them."""
    meta = LEAGUES[league]
    _, prefix, include = WIKI_SPORT_PAGES.get(meta["slug"], (None, meta["title"], None))
    events, seen = [], set()
    for title in (page or {}).get("links") or []:
        match = OLYMPIC_LINK.match(title)
        if not match or not match.group(4):
            continue
        if match.group(1) != prefix or int(match.group(2)) != meta["year"]:
            continue
        name = match.group(4)
        if SKIP_EVENT.search(name) or (include and not re.search(include, name, re.I)):
            continue
        variant = (event_gender(name), event_key(name))
        if title in seen or variant in seen:
            continue
        seen.add(title)
        seen.add(variant)
        events.append({"id": title, "title": title, "name": name,
                       "gender": event_gender(name), "key": event_key(name),
                       "medals": {}})

    # medallist tables: an 'Event' column, then Gold / Silver / Bronze
    rows = []
    for section in (page or {}).get("sections") or []:
        heading_gender = event_gender(section["title"])
        tables = [t for t in section["tables"] if t["rows"]
                  and any("gold" in c["text"].lower() for c in t["rows"][0])
                  and not any(c["text"].lower() in ("rank", "nation", "noc")
                              for c in t["rows"][0])]
        for position, table in enumerate(tables):
            gender = heading_gender or (["men", "women", "mixed"][position]
                                        if len(tables) > 1 and position < 3 else "")
            head = [c["text"].lower() for c in table["rows"][0]]
            columns = {}
            for medal in MEDAL_ORDER:
                for index, label in enumerate(head):
                    if label.startswith(medal):
                        columns[medal] = index
                        break
            for row in table["rows"][1:]:
                if not row or row[0].get("th") is False and not row[0]["text"]:
                    continue
                label = row[0]["text"]
                medals = {}
                for medal, index in columns.items():
                    if index < len(row) and row[index]["text"]:
                        medals[medal] = [split_entrant(row[index])]
                        # a tie puts two medallists in the next row's cells
                rows.append({"key": event_key(label), "gender": event_gender(label) or gender,
                             "link": row[0].get("link") or "", "medals": medals,
                             "used": False})
    for event in events:
        pick = next((r for r in rows if not r["used"] and r["link"] == event["title"]), None)
        if pick is None:
            pick = next((r for r in rows if not r["used"] and r["key"] == event["key"]
                         and (r["gender"] == event["gender"] or not r["gender"]
                              or not event["gender"])), None)
        if pick is None:
            pick = next((r for r in rows if not r["used"] and r["key"] == event["key"]), None)
        if pick:
            pick["used"] = True
            event["medals"] = pick["medals"]
    return events


def wiki_infobox_facts(page):
    """(label, value) pairs from an event article's infobox."""
    facts = []
    for box in (page or {}).get("infobox") or []:
        for row in box["rows"]:
            if len(row) >= 2 and row[0]["th"] and row[0]["text"] and row[-1]["text"] \
                    and row[0]["text"] != row[-1]["text"]:
                label = row[0]["text"]
                if label.lower() in ("venue", "venues", "dates", "date", "competitors",
                                     "teams", "nations", "no. of events", "winning time",
                                     "winning score", "winning total", "winning points",
                                     "winning distance", "winning height", "winning mark"):
                    facts.append((label, row[-1]["text"]))
    return facts[:7]


def wiki_podium(page):
    """[(medal, athlete, code)] from an event article's medal infobox."""
    out = []
    for box in (page or {}).get("infobox") or []:
        for row in box["rows"]:
            medal = next((c["medal"] for c in row if c.get("medal")), "")
            nation = next((c for c in reversed(row) if c.get("noc")), None)
            if medal and nation:
                texts = [c["text"] for c in row if c["text"] and c is not nation
                         and not c.get("medal")]
                who = texts[-1] if texts else ""
                out.append((medal, who, cell_noc(nation) or nation["text"]))
        if out:
            break
    return out


RANK_HEADERS = {"rank", "pl.", "pl", "pos.", "pos", "place", "position", "rk", "#"}


def result_tables(page):
    """[(section path, table)] for every table that ranks entrants."""
    out = []
    path = []
    for section in (page or {}).get("sections") or []:
        level = section["level"]
        path = [p for p in path if p[0] < level] + [(level, section["title"])]
        title = " — ".join(t for _, t in path[1:] if t and t.lower() != "results")
        if section["title"].lower() in ("references", "see also", "external links",
                                        "background", "qualification", "records"):
            continue
        for table in section["tables"]:
            rows = table["rows"]
            if len(rows) < 2:
                continue
            head = {c["text"].lower() for c in rows[0]}
            nocs = sum(1 for row in rows[1:] if any(c.get("noc") for c in row))
            if head & RANK_HEADERS or nocs >= 3:
                out.append((table.get("caption") or title or "Results", table))
    return out


def final_table(page):
    tables = result_tables(page)
    if not tables:
        return None
    for name, table in reversed(tables):
        if re.search(r"final|overall|standings|ranking|summary|classification", name, re.I) \
                and not re.search(r"semi|quarter|repechage|b final|heat", name, re.I):
            return name, table
    return tables[-1]


def entrant_text(cell, code):
    who, found = split_entrant(cell)
    code = code or found
    return who, code


def render_wiki_table(table, width, league, favorites, limit=None):
    """A Wikipedia table as a terminal table: nations as IOC codes in their
    colours, medal places in medal colours, favourites starred."""
    rows = table["rows"]
    head_count = 0
    while head_count < len(rows) - 1 and all(c["th"] for c in rows[head_count]):
        head_count += 1
    head_count = max(1, head_count)
    header = [c["text"] for c in rows[head_count - 1]]
    top = [c["text"] for c in rows[0]]
    if head_count > 1:
        header = [(t if t and t != h else "") + (" " if t and h and t != h else "") +
                  (h if h != t else "") for t, h in zip(top, header)]
    for index in range(len(header) - 1, 0, -1):
        if header[index] and header[index] == header[index - 1]:
            header[index] = ""
    body = rows[head_count:]
    if limit:
        body = body[:limit]
    width_cols = len(header)
    cells, styles = [], []
    for row in body:
        texts, row_styles = [], []
        row_codes = [cell_noc(c) if not c.get("spill") else "" for c in row]
        medal = next((c["medal"] for c in row[:2] if c.get("medal")), "")
        for index in range(width_cols):
            cell = row[index] if index < len(row) else {"text": "", "noc": "", "medal": "",
                                                         "th": False, "link": ""}
            code = row_codes[index] if index < len(row_codes) else ""
            text = clean(cell["text"])
            style = "normal"
            if cell.get("spill"):
                code, text = "", ""
            if code:
                who, code = entrant_text(cell, code)
                text = f"{who} ({code})" if who else code
                style = THEME.style(league, {"abbr": code, "name": cell["noc"]}, bold=True,
                                    fallback="accent")
            elif index == 0 and cell.get("medal"):
                text = text or str(MEDAL_ORDER.index(cell["medal"]) + 1)
                style = MEDAL_STYLES[cell["medal"]]
            elif re.fullmatch(r"(WR|OR|NR|PB|SB|Q|q|DNF|DNS|DSQ|DQ)(, ?\w+)*", text):
                style = "accent" if text.startswith(("WR", "OR")) else "dim"
            texts.append(text.replace(" / ", ", "))
            row_styles.append(style)
        starred = any(fav_rank(favorites or {}, league, {"abbr": c}) >= 0
                      for c in row_codes if c)
        if medal and not texts[0]:
            texts[0] = str(MEDAL_ORDER.index(medal) + 1)
        if medal:
            row_styles[0] = MEDAL_STYLES[medal]
        texts[0] = (STAR + " " if starred else "  ") + texts[0]
        if starred:
            row_styles = [s if s != "normal" else "bold" for s in row_styles]
        cells.append(texts)
        styles.append(row_styles)
    keep = [i for i in range(width_cols)
            if header[i].strip() or any(r[i].strip() for r in cells)]
    keep = [i for i in keep if header[i].strip().lower() not in ("ref.", "ref", "refs")]
    header = [header[i] for i in keep]
    cells = [[r[i] for i in keep] for r in cells]
    styles = [[r[i] for i in keep] for r in styles]
    if not header:
        return []
    widths = [max([len(header[i])] + [len(r[i]) for r in cells]) for i in range(len(header))]
    gap = 2
    while sum(widths) + gap * (len(widths) - 1) > width and max(widths) > 8:
        widest = widths.index(max(widths))
        widths[widest] -= 1
        if sum(widths) + gap * (len(widths) - 1) > width + 40 and gap == 2:
            gap = 1
    numeric = [all(re.fullmatch(r"[\d.:+\-−%,() ]*", r[i] or "") for r in cells)
               for i in range(len(header))]

    def fit(text, size, right):
        if len(text) > size:
            text = text[: max(1, size - 1)] + "…"
        return f"{text:>{size}}" if right else f"{text:<{size}}"

    lines = []
    head = Line()
    for i, label in enumerate(header):
        head.add(fit(label, widths[i], numeric[i] and i > 0), "header")
        if i < len(header) - 1:
            head.add(" " * gap, "normal")
    lines.append(head)
    for texts, row_styles in zip(cells, styles):
        line = Line()
        for i, text in enumerate(texts):
            line.add(fit(text, widths[i], numeric[i] and i > 0), row_styles[i])
            if i < len(texts) - 1:
                line.add(" " * gap, "normal")
        lines.append(line)
    return lines


def podium_lines(medals, league, favorites, width):
    lines = []
    for medal in MEDAL_ORDER:
        for who, code in medals.get(medal) or []:
            line = Line().add(f"{medal.title():<7}", MEDAL_STYLES[medal])
            star = fav_rank(favorites or {}, league, {"abbr": code}) >= 0 if code else False
            line.add(STAR + " " if star else "  ", "star")
            if code:
                line.add(f"{code:<4}", THEME.style(league, {"abbr": code}, bold=True,
                                                   fallback="accent"))
            line.add((who or NOCS.get(code, ("",))[0])[: max(8, width - 14)], "normal")
            lines.append(line)
    return lines


def render_event_list(events, width, selected_index, favorites, league):
    """The left pane for a Wikipedia sport: one row per medal event, with the
    podium's nations."""
    header = Line().add("    ", "header")
    name_width = clamp(width - 26, 12, 44)
    header.add(f"{'event':<{name_width}} ", "header")
    header.add(f"{'gold':<7}{'silver':<7}{'bronze':<7}", "header").pad(width, "header")
    if not events:
        return header, [blank(), Line().add("  No events listed on this sport's page yet.",
                                            "dim")]
    rows = []
    for index, event in enumerate(events):
        chosen = index == selected_index
        base = "sel" if chosen else "normal"
        codes = {m: (event["medals"].get(m) or [("", "")])[0][1] for m in MEDAL_ORDER}
        starred = any(c and fav_rank(favorites, league, {"abbr": c}) >= 0
                      for c in codes.values())
        line = Line()
        line.add("▌" if chosen else " ", "selbar" if chosen else base)
        line.add(STAR if starred else " ", "star" if starred else base)
        line.add("  ", base)
        name = event["name"]
        if len(name) > name_width:
            name = name[: name_width - 1] + "…"
        line.add(f"{name:<{name_width}} ", base)
        if not any(codes.values()):
            line.add("not decided yet" if games_live(league) else "", "seldim" if chosen
                     else "muted")
        for medal in MEDAL_ORDER:
            code = codes[medal]
            if not code:
                continue
            line.add("●", MEDAL_STYLES[medal])
            line.add(f"{code:<6}", THEME.style(league, {"abbr": code}, selected=chosen,
                                               bold=True, fallback=base))
        rows.append(line.pad(width, base))
    return header, rows


def render_event_preview(event, page, league, width, favorites, loading=False):
    meta = LEAGUES[league]
    lines = [Line().add(event["name"], "title"),
             Line().add(f"{meta['label']} · {meta['games']}", "dim"), blank()]
    facts = wiki_infobox_facts(page)
    for label, value in facts:
        lines.append(Line().add(f"{label:<14}", "muted").add(value[: max(10, width - 15)],
                                                            "normal"))
    if facts:
        lines.append(blank())
    podium = wiki_podium(page)
    if podium:
        medals = {}
        for medal, who, code in podium:
            medals.setdefault(medal, []).append((who, code))
    else:
        medals = event.get("medals") or {}
    if medals:
        lines.append(heading("Medallists"))
        lines.extend(podium_lines(medals, league, favorites, width))
        lines.append(blank())
    final = final_table(page)
    if final:
        name, table = final
        lines.append(heading(name[:width]))
        lines.extend(render_wiki_table(table, width, league, favorites, limit=12))
        lines.append(blank())
    elif loading:
        lines.append(Line().add("Loading the event page…", "dim"))
    elif page and page.get("missing"):
        lines.append(Line().add("Wikipedia has no page for this event yet.", "dim"))
    elif page:
        lines.append(Line().add("No results table on the event page yet.", "dim"))
    lead = ""
    for section in (page or {}).get("sections") or []:
        if section["lead"]:
            lead = section["lead"]
            break
    if lead and len(lines) < 30:
        lines.extend(wrap_spans(re.sub(r"\[\d+\]", "", lead)[:600], width, "muted"))
        lines.append(blank())
    lines.append(Line().add("enter → every round's results    3 → medallists    "
                            "4 → medal table", "muted"))
    return lines


def render_event_results(event, page, league, width, favorites):
    lines = [Line().add(event["name"], "title"),
             Line().add(f"{LEAGUES[league]['label']} · {LEAGUES[league]['games']}", "dim"),
             blank()]
    tables = result_tables(page)
    if not tables:
        lines.append(Line().add("No results published for this event yet.", "dim"))
        return lines
    for name, table in tables:
        head = Line().add("── ", "border").add(f"{name} ", "title")
        head.add("─" * max(0, min(width, 72) - len(name) - 4), "border")
        lines.append(head)
        lines.extend(render_wiki_table(table, width, league, favorites))
        lines.append(blank())
    return lines


def render_sport_medallists(page, league, width, favorites):
    """Every table on the sport page that names medallists, and its schedule."""
    lines = []
    for section in (page or {}).get("sections") or []:
        if section["title"].lower() in ("references", "external links", "see also",
                                        "qualification", "venues", "map of hosts"):
            continue
        for table in section["tables"]:
            if len(table["rows"]) < 2:
                continue
            head = " ".join(c["text"].lower() for c in table["rows"][0])
            if "gold" not in head and not re.search(r"schedule|medal", section["title"],
                                                    re.I):
                continue      # entry lists, qualification, venues
            title = table.get("caption") or section["title"] or "Table"
            head = Line().add("── ", "border").add(f"{title} ", "title")
            head.add("─" * max(0, min(width, 72) - len(title) - 4), "border")
            lines.append(head)
            lines.extend(render_wiki_table(table, width, league, favorites))
            lines.append(blank())
    return lines or [Line().add("Nothing published for this sport yet.", "dim")]


def medal_rows(page):
    """[(rank, code, name, gold, silver, bronze, total)] from a medal table."""
    for section in (page or {}).get("sections") or []:
        for table in section["tables"]:
            head = [c["text"].lower() for c in table["rows"][0]]
            if "gold" not in head or "total" not in head:
                continue
            index = {name: head.index(name) for name in ("gold", "silver", "bronze", "total")}
            out, rank = [], 0
            for row in table["rows"][1:]:
                nation = next((c for c in row if c.get("noc")), None)
                if nation is None:
                    continue
                first = row[0]["text"].strip()
                if first.isdigit():
                    rank = int(first)
                code = cell_noc(nation) or nation["noc"][:3].upper()

                def number(key):
                    return _int(row[index[key]]["text"]) if index[key] < len(row) else 0
                out.append((rank, code, clean(nation["noc"]), number("gold"),
                            number("silver"), number("bronze"), number("total")))
            if out:
                return out
    return []


def render_medal_table(page, league, width, favorites, loading=False, error=None):
    meta = LEAGUES[league]
    lines = [Line().add(f"{meta['games']} medal table", "title")]
    rows = medal_rows(page)
    if not rows:
        if loading:
            lines.append(Line().add("Loading the medal table…", "dim"))
        elif error:
            lines.extend(wrap_spans(f"Medal table unavailable: {error}", width, "err"))
        else:
            lines.append(Line().add("No medals awarded yet.", "dim"))
        return lines
    lines.append(Line().add(f"{len(rows)} teams on the table", "muted"))
    lines.append(blank())
    name_width = clamp(width - 34, 12, 30)
    head = Line().add(f"{'':>4}   {'':<5}{'':<{name_width}}", "header")
    head.add(f"{'G':>4}", "medalgold").add(f"{'S':>4}", "medalsilver")
    head.add(f"{'B':>4}", "medalbronze").add(f"{'Tot':>5}", "header")
    lines.append(head)
    starred_rows = []
    for rank, code, name, gold, silver, bronze, total in rows:
        star = fav_rank(favorites, league, {"abbr": code}) >= 0
        line = Line().add(f"{rank:>4} ", "muted")
        line.add(STAR + " " if star else "  ", "star")
        line.add(f"{code:<5}", THEME.style(league, {"abbr": code}, bold=True,
                                           fallback="accent"))
        line.add(f"{name[:name_width - 1]:<{name_width}}", "bold" if star else "normal")
        line.add(f"{gold:>4}", "medalgold").add(f"{silver:>4}", "medalsilver")
        line.add(f"{bronze:>4}", "medalbronze").add(f"{total:>5}", "bold")
        lines.append(line)
        if star:
            starred_rows.append(line)
    if starred_rows:
        lines[2:2] = [Line().add("Your nations", "accent")] + \
            [Line(list(r)) for r in starred_rows] + [blank()]
    return lines


