def bball_period_table(summary, event, league, width):
    """Points in each quarter (half) and the total, both teams."""
    comps = dig(summary, "header", "competitions", 0, "competitors", default=[]) or []
    scores = {}
    for comp in comps:
        side = comp.get("homeAway")
        scores[side] = [_int(s.get("displayValue") or s.get("value"))
                        for s in comp.get("linescores") or []]
    if not scores.get("away") or not scores.get("home"):
        return []
    periods = max(len(scores["away"]), len(scores["home"]))
    heads = [""] + [bball_period_name(league, n) for n in range(1, periods + 1)] + ["T"]
    rows, styles = [], []
    for side in ("away", "home"):
        values = scores[side] + [0] * (periods - len(scores[side]))
        rows.append([event[side]["abbr"]] + [str(v) for v in values] + [str(sum(values))])
        styles.append("normal")
    table = build_table(heads, rows, aligns=["<"] + [">"] * (periods + 1),
                        header_style="header", row_styles=styles, sep="  ")
    title = "By quarter" if quarters(league) else "By half"
    return [heading(title)] + [fit_line(line, width) for line in table]


def bball_four_factors(summary, event, league, width):
    """Dean Oliver's four factors for each side: shooting (effective FG %),
    turnovers (a share of possessions), offensive rebounds (a share of the
    misses) and getting to the line (FTM per FGA), each as a meter."""
    stats = bball_team_stats(summary)
    if not stats.get("away") or not stats.get("home"):
        return []

    def factors(me, them):
        fgm, fga = made_attempted(me.get("fieldGoalsMade-fieldGoalsAttempted"))
        tpm, _ = made_attempted(me.get("threePointFieldGoalsMade-threePointFieldGoalsAttempted"))
        ftm, fta = made_attempted(me.get("freeThrowsMade-freeThrowsAttempted"))
        tov = _num(me.get("totalTurnovers") or me.get("turnovers"))
        orb, drb = _num(me.get("offensiveRebounds")), _num(them.get("defensiveRebounds"))
        if None in (fgm, fga, tpm, ftm, fta, tov) or not fga:
            return None
        return {"efg": (fgm + 0.5 * tpm) / fga,
                "tov": tov / (fga + 0.44 * fta + tov) if fga + 0.44 * fta + tov else 0.0,
                "orb": orb / (orb + drb) if orb is not None and drb is not None and orb + drb
                else None,
                "ftr": ftm / fga}
    a, h = factors(stats["away"], stats["home"]), factors(stats["home"], stats["away"])
    if not a or not h:
        return []
    away, home = event["away"], event["home"]
    label_w = 14
    seg = clamp((width - label_w - 16) // 2, 4, 24)
    lines = [heading("Four factors").add("  who won each, the way the game is won", "muted")]
    for label, key, scale, higher in (("Shooting eFG%", "efg", 0.75, True),
                                      ("Turnovers", "tov", 0.30, False),
                                      ("Off. rebounds", "orb", 0.50, True),
                                      ("FT per FGA", "ftr", 0.50, True)):
        left, right = a[key], h[key]
        if left is None or right is None:
            continue
        better = (left > right) - (left < right)
        better = better if higher else -better
        line = Line().add(f"{label:<{label_w}}", "muted")
        line.add(f"{left * 100:5.1f}% ", "good" if better > 0 else "normal")
        line.extend_spans(meter_spans(left / scale, seg, THEME.style(league, away,
                                                                    fallback="accent"),
                                      reverse=True))
        line.add("│", "border")
        line.extend_spans(meter_spans(right / scale, seg, THEME.style(league, home,
                                                                     fallback="accent")))
        line.add(f" {right * 100:5.1f}%", "good" if better < 0 else "normal")
        lines.append(fit_line(line, width))
    head = Line().add(" " * label_w, "normal")
    head.add(f"{away['abbr']:>6} ", THEME.style(league, away, bold=True, fallback="accent"))
    head.add(" " * (2 * seg - len(home["abbr"]) + 1), "normal")
    head.add(home["abbr"], THEME.style(league, home, bold=True, fallback="accent"))
    lines.insert(1, fit_line(head, width))
    return lines


def bball_points_from(summary, event, league, width):
    """Where each side's points came from - the paint, the fast break, off
    turnovers, from three, from the line, the bench - as split meters."""
    stats = bball_team_stats(summary)
    a, h = stats.get("away"), stats.get("home")
    if not a or not h:
        return []

    def threes(s):
        made, _ = made_attempted(s.get("threePointFieldGoalsMade-threePointFieldGoalsAttempted"))
        return None if made is None else 3 * made

    def free(s):
        made, _ = made_attempted(s.get("freeThrowsMade-freeThrowsAttempted"))
        return made

    rows = [("In the paint", _num(a.get("pointsInPaint")), _num(h.get("pointsInPaint"))),
            ("Fast break", _num(a.get("fastBreakPoints")), _num(h.get("fastBreakPoints"))),
            ("Off turnovers", _num(a.get("turnoverPoints")), _num(h.get("turnoverPoints"))),
            ("From three", threes(a), threes(h)),
            ("At the line", free(a), free(h)),
            ("Bench", _num(a.get("benchPoints")), _num(h.get("benchPoints")))]
    rows = [r for r in rows if r[1] is not None and r[2] is not None and r[1] + r[2] > 0]
    if not rows:
        return []
    away, home = event["away"], event["home"]
    label_w = 14
    seg = clamp(width - label_w - 10, 10, 48)
    lines = [heading("How the points came")]
    for label, left, right in rows:
        lit = int(round(left / (left + right) * seg))
        line = Line().add(f"{label:<{label_w}}", "muted").add(f"{left:>4g} ", "bold")
        line.extend_spans(meter_block(lit, THEME.style(league, away, fallback="accent")))
        line.extend_spans(meter_block(seg - lit, THEME.style(league, home, fallback="accent")))
        lines.append(fit_line(line.add(f" {right:g}", "bold"), width))
    return lines


def bball_win_prob_lines(summary, event, league, width, rows=6):
    """ESPN's win probability for the home side through the game, in
    braille, with the play that swung it most."""
    probs = [p for p in dig(summary, "winprobability", default=[]) or []
             if isinstance(p.get("homeWinPercentage"), (int, float))]
    if len(probs) < 10:
        return []
    away, home = event["away"], event["home"]
    label_w = 6
    cols = max(20, width - label_w)
    px_w, px_h = cols * 2, rows * 4
    cells = {}
    previous = None
    half = (px_h - 1) / 2.0
    for x in range(px_w):
        share = probs[min(len(probs) - 1, int(x / px_w * len(probs)))]["homeWinPercentage"]
        y = int(round((1 - share) * (px_h - 1)))
        # the line, and under it the area out to the 50% line (6.21.0)
        line_lo, line_hi = sorted((y, previous if previous is not None else y))
        area_lo, area_hi = sorted((y, int(round(half))))
        for py in set(range(line_lo, line_hi + 1)) | set(range(area_lo, area_hi + 1)):
            key = (py // 4, x // 2)
            cells[key] = cells.get(key, 0) | BRAILLE_BITS[py % 4][x % 2]
        previous = y
    lines = [heading("Win probability").add("  ESPN's, play by play", "muted")]
    middle = (px_h // 2) // 4
    for row in range(rows):
        if row == 0:
            label = Line().add(f"{home['abbr'][:5]:<{label_w}}", THEME.style(
                league, home, bold=True, fallback="accent"))
        elif row == rows - 1:
            label = Line().add(f"{away['abbr'][:5]:<{label_w}}", THEME.style(
                league, away, bold=True, fallback="accent"))
        elif row == middle:
            label = Line().add(f"{'50%':<{label_w}}", "muted")
        else:
            label = Line().add(" " * label_w, "normal")
        line = Line(list(label))
        for col in range(cols):
            bits = cells.get((row, col), 0)
            if UNDER["on"]:
                line.add(" ", "normal")
            elif bits:
                line.add(chr(0x2800 + bits), THEME.style(
                    league, home if row < middle or (row == middle and rows % 2) else away,
                    fallback="accent"))
            else:
                line.add("┄" if row == middle else " ", "border")
        lines.append(merge_spans(line))
    if UNDER["on"]:
        spec = {"cols": label_w + cols, "rows": rows,
                "area": (0, rows, label_w, label_w + cols, True, team_hex(league, home),
                         team_hex(league, away)),
                "points": _sample([p["homeWinPercentage"] for p in probs])}
        number = underlay_number(("winlines", repr(spec)),
                                 lambda cw, ch, s=spec: winprob_png(s, cw, ch),
                                 label_w + cols, rows)
        lines = lines[:1] + underlay_lines(lines[1:], number)
    plays = {str(p.get("id")): p for p in game_plays(summary)}
    swing, turn, base = 0.0, None, probs[0]["homeWinPercentage"]
    for entry in probs[1:]:
        play = plays.get(str(entry.get("playId")))
        if play is None or BBALL_QUIET.search(clean(play.get("text") or "")):
            continue        # a substitution or a timeout swings nothing itself
        change = entry["homeWinPercentage"] - base
        base = entry["homeWinPercentage"]
        if abs(change) > abs(swing):
            swing, turn = change, play
    if turn and abs(swing) >= 0.08:
        side = home if swing > 0 else away
        text = football_play_text(turn.get("text")) if sport_of(league) == "football" \
            else clean(turn.get("text") or "")
        number = _int(dig(turn, "period", "number", default=0))
        clock = bball_play_clock(turn) if sport_of(league) != "baseball" else ""
        quarter = (bball_period_name(league, number) if sport_of(league) == "basketball"
                   else inning_half(turn) if sport_of(league) == "baseball"
                   else period_tag(league, number)) if number else ""
        line = Line().add("  biggest swing  ", "muted").add(
            side["abbr"], THEME.style(league, side, bold=True, fallback="accent")).add(
            f" +{abs(swing) * 100:.0f}%", "bold")
        line.add(f"  {clock} {quarter}  {text}".replace("   ", "  ", 1) if not clock
                 else f"  {clock} {quarter}  {text}", "dim")
        lines.append(fit_line(line, width))
    return lines


BBALL_QUIET = re.compile(r"enters the game|timeout|^end of|^start of|official|"
                         r"challenge|review", re.I)


def bball_play_clock(play):
    """A play's clock as '7:12', and '0:16.8' inside the last minute."""
    clock = clean(dig(play, "clock", "displayValue", default="") or "")
    return clock if ":" in clock or not clock else f"0:{clock}"


def game_score(stats):
    """John Hollinger's game score from a box score row ('FG' as '7-11')."""
    fgm, fga = made_attempted(stats.get("FG"))
    ftm, fta = made_attempted(stats.get("FT"))
    if fgm is None or ftm is None:
        return None
    n = lambda key: _int(stats.get(key))   # noqa: E731
    return (n("PTS") + 0.4 * fgm - 0.7 * fga - 0.4 * (fta - ftm) + 0.7 * n("OREB")
            + 0.3 * n("DREB") + n("STL") + 0.7 * n("AST") + 0.7 * n("BLK") - 0.4 * n("PF")
            - n("TO"))


def bball_line_text(stats):
    """'31 PTS · 9 REB · 7 AST · 11-20 FG' from a box score row."""
    parts = [f"{stats.get('PTS', '0')} PTS"]
    for key in ("REB", "AST", "STL", "BLK"):
        if _int(stats.get(key)) >= (2 if key in ("STL", "BLK") else 1):
            parts.append(f"{stats[key]} {key}")
    if stats.get("FG"):
        parts.append(f"{stats['FG']} FG")
    return " · ".join(parts)


def bball_performers(refs):
    """The box score's players by game score, best first: [(score, index)]."""
    scored = []
    for index, ref in enumerate(refs):
        value = game_score(ref.get("stats") or {})
        if value is not None and _int((ref.get("stats") or {}).get("MIN")) > 0:
            scored.append((value, index))
    scored.sort(key=lambda pair: -pair[0])
    return scored


def bball_top_lines(summary, event, league, width, count=5):
    """The game's best by game score, for the Game Stats tab."""
    refs = []
    for block in dig(summary, "boxscore", "players", default=[]) or []:
        ident = str(dig(block, "team", "id", default=""))
        side = "home" if ident == str(event["home"].get("id")) else "away"
        for section in block.get("statistics") or []:
            labels = [clean(l) for l in section.get("labels") or []]
            for entry in section.get("athletes") or []:
                stats = dict(zip(labels, [clean(s) for s in entry.get("stats") or []]))
                refs.append({"name": clean(dig(entry, "athlete", "shortName", default="")
                                           or dig(entry, "athlete", "displayName", default="")),
                             "team": event[side], "stats": stats})
    ranked = bball_performers(refs)
    if not ranked:
        return []
    lines = [heading("Top performers").add("  by game score", "muted")]
    name_w = min(24, max(len(refs[index]["name"]) for _, index in ranked[:count]))
    for place, (value, index) in enumerate(ranked[:count], 1):
        ref = refs[index]
        team = ref["team"]
        line = Line().add(f"{place:>2} ", "muted").add(f"{team['abbr']:<5}", THEME.style(
            league, team, bold=True, fallback="accent"))
        line.add(f"{ref['name'][:name_w]:<{name_w + 1}}", "normal").add(f"{value:5.1f}  ", "bold")
        lines.append(fit_line(line.add(bball_line_text(ref["stats"]), "dim"), width))
    return lines


def player_night_lines(summary, league, ref, width, height, court=True):
    """Under a basketball player's card, when it has the room: where his shots
    came from tonight (a small court) and his night play by play - his points
    by period, then each basket and assist with the clock and the score (his
    team's first)."""
    pid = str(ref.get("id") or "")
    if not pid or height < 4:
        return []
    want_court = court
    court = court_for(league)
    # the court's height follows its width; pick the widest that fits
    cols = int((height - 3) * 100 / (SHOT_DEPTH + court["baseline"]))
    chart = []
    if cols >= 24 and want_court:
        chart = render_shot_chart(summary, league, min(cols, 48, width // 2) + 1,
                                  heading=False, player=pid, zones=False, min_cols=24)
        chart = [heading("His shots")] + chart
    away, home = summary_teams(summary)
    mine_home = bool(home) and str((ref.get("team") or {}).get("id") or "") == str(home["id"])
    name = (ref.get("name") or "").strip()
    by_period, moments = {}, []
    for play in dig(summary, "plays", default=[]) or []:
        people = [str(dig(p, "athlete", "id", default="")) for p in play.get("participants") or []]
        if pid not in people:
            continue
        number = _int(dig(play, "period", "number", default=0))
        text = clean(play.get("text") or "")
        scored = bool(play.get("scoringPlay")) and people and people[0] == pid
        assisted = bool(play.get("scoringPlay")) and len(people) > 1 and people[1] == pid
        if scored:
            by_period[number] = by_period.get(number, 0) + _int(play.get("scoreValue"))
        if not (scored or assisted):
            continue
        if name and text.startswith(name + " "):
            text = text[len(name) + 1:]
        clock = bball_play_clock(play)
        ours, theirs = (play.get("homeScore"), play.get("awayScore")) if mine_home else \
            (play.get("awayScore"), play.get("homeScore"))
        if assisted:
            text = re.sub(r"\s*\([^()]*assists\)\s*$", "", text)
        if moments and scored and re.search(r"free throw 1 of 1", text, re.I):
            last = moments[-1]
            if last[0] == number and last[1] == clock and "free throw" not in last[4].lower():
                text = "and-one free throw"
        if moments and scored and "free throw" in text.lower() and "and-one" not in text:
            last = moments[-1]
            if last[0] == number and last[1] == clock and "free throw" in last[4].lower():
                # two or three from the line at one stop of the clock, one row
                made = (_int(re.findall(r"(\d+) free throws", last[4])[0])
                        if re.search(r"\d+ free throws", last[4]) else 1) + 1
                moments[-1] = (number, clock, ours, theirs, f"makes {made} free throws",
                               False)
                continue
        moments.append((number, clock, ours, theirs, text, assisted))
    right_w = width - (max((sum(len(t) for t, _ in l) for l in chart), default=0) + 4
                       if chart else 0)
    right = []
    if moments or by_period:
        right.append(heading("His night"))
        line = Line()
        for number in sorted(by_period):
            line.add(f"{bball_period_name(league, number)} ", "muted").add(
                str(by_period[number]), "bold").add("   ")
        if by_period:
            right.append(fit_line(Line().add("points  ", "muted").extend_spans(line), right_w))
        room = height - len(right)
        shown = moments
        if len(moments) > room:
            shown = moments[-(room - 1):] if room > 1 else []
            right.append(Line().add(f"… {len(moments) - len(shown)} earlier", "muted"))
        for number, clock, ours, theirs, text, assisted in shown:
            line = Line().add(f"{bball_period_name(league, number):<4}", "muted")
            line.add(f"{clock:>6}  ", "muted")
            if ours is not None and theirs is not None:
                line.add(f"{ours}-{theirs}".ljust(8), "bold")
            line.add("assist  " if assisted else "", "accent").add(text, "dim" if assisted
                                                                     else "normal")
            right.append(fit_line(line, right_w))
    if not chart and not right:
        return []
    return side_by_side([chart[:height], right[:height]], width, gap=4)


