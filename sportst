def scouting_team_lines(team, side, summary, injuries, news, league, width, favorites,
                        preview=None, news_count=4):
    """One team's half of the scouting report, packed tight."""
    lines = []
    star = fav_rank(favorites, league, team) >= 0
    head = Line().add("── ", "border")
    if star:
        head.add(STAR + " ", "star")
    head.add(team.get("name") or team.get("abbr") or "?",
             THEME.style(league, team, bold=True, fallback="title"))
    if team.get("record"):
        head.add(f"  {team['record']}", "bold")
    head.add(f"  {side} ", "muted")
    head.add("─" * max(0, width - len(head.text)), "border")
    lines.append(head)

    # form: the last five results
    form = []
    for block in (summary or {}).get("lastFiveGames") or []:
        if str(dig(block, "team", "id", default="")) != str(team.get("id")):
            continue
        for game in block.get("events") or []:
            result = clean(game.get("gameResult") or "")
            opponent = clean(dig(game, "opponent", "abbreviation", default=""))
            form.append((result, f"{result} {clean(game.get('score') or '')} "
                                 f"{clean(game.get('atVs') or '')}{opponent}"))
    if form:
        row = Line().add("  Form     ", "muted")
        for index, (result, text) in enumerate(form):
            if index:
                row.add(" · ", "muted")
            row.add(text, "good" if result == "W" else ("bad" if result == "L" else "dim"))
        lines.append(row)

    if preview:
        for label, text in preview:
            lines.append(Line().add(f"  {label:<9}", "muted").add(text[: width - 11], "normal"))

    # season leaders
    for block in (summary or {}).get("leaders") or []:
        if str(dig(block, "team", "id", default="")) != str(team.get("id")):
            continue
        for category in block.get("leaders") or []:
            top = (category.get("leaders") or [None])[0]
            if not top:
                continue
            who = clean(dig(top, "athlete", "shortName", default="")
                        or dig(top, "athlete", "displayName", default=""))
            label = clean(category.get("shortDisplayName") or category.get("displayName")
                          or category.get("name") or "")
            if label.upper() in SKIP_LEADER_CATEGORIES:
                continue
            value = clean(top.get("displayValue") or "")
            row = Line().add(f"  {label[:8]:<9}", "muted").add(f"{who} ", "normal")
            row.add(value[: max(0, width - 10 - len(who))], "dim")
            lines.append(row)

    # injuries
    if injuries is not None:
        if not injuries:
            if league in COLLEGE_LEAGUES:
                lines.append(Line().add("  No injuries listed (most schools do not "
                                        "publish an injury report).", "dim"))
            else:
                lines.append(Line().add("  Injury report clear.", "good"))
        else:
            groups = {}
            for status, name, position in injuries:
                groups.setdefault(status or "Listed", []).append(
                    f"{name} {position}".strip())
            lines.append(Line().add(f"  Injuries ({len(injuries)})", "accent"))
            short = {"injured reserve": "IR", "injured reserve - designated to return":
                     "IR-return", "physically unable to perform": "PUP",
                     "day-to-day": "Day-to-day", "questionable": "Quest.",
                     "suspension": "Susp.", "non-football injury": "NFI"}
            labels = {st: short.get(st.lower(), st)[:11] for st in groups}
            pad = max(len(v) for v in labels.values()) if labels else 4
            for status in sorted(groups, key=injury_order):
                style = "bad" if injury_order(status) <= 2 else (
                    "warn" if injury_order(status) <= 5 else "dim")
                prefix = f"    {labels[status] + ':':<{pad + 1}} "
                chunks = flow_text(groups[status], width - len(prefix), prefix)
                for index, chunk in enumerate(chunks):
                    row = Line().add(prefix if index == 0 else " " * len(prefix), style)
                    row.add(chunk, "normal")
                    lines.append(row)
    # news
    articles = [a for a in (news or {}).get("articles") or [] if a.get("headline")]
    if articles and news_count:
        lines.append(Line().add("  News", "accent"))
        for article in articles[:news_count]:
            age = _age(article.get("published") or article.get("lastModified"))
            row = Line().add(f"    {age:>3} ", "muted")
            row.add(clean(article["headline"])[: max(10, width - 9)], "normal")
            lines.append(row)
    return lines


def scouting_header(event, summary, league, width):
    """Who, when, where, the line, the predictor and the weather."""
    away, home = event["away"], event["home"]
    lines = []
    title = Line()
    title.add(team_label(away, 30, league in RANKED_LEAGUES),
              THEME.style(league, away, bold=True))
    if away.get("record"):
        title.add(f" ({away['record']})", "dim")
    title.add("  at  ", "muted")
    title.add(team_label(home, 30, league in RANKED_LEAGUES),
              THEME.style(league, home, bold=True))
    if home.get("record"):
        title.add(f" ({home['record']})", "dim")
    lines.append(title)
    meta = Line().add(event_when(event), "dim")
    place = event["venue"] + (f", {event['venue_city']}" if event["venue_city"] else "")
    if place:
        meta.add("  ·  ", "muted").add(place, "dim")
    if event["broadcast"]:
        meta.add("  ·  ", "muted").add(event["broadcast"], "dim")
    lines.append(meta)

    facts = []
    line = event.get("line") or event.get("line_raw")
    if not line and summary and league in BETTING_LEAGUES:
        line = pick_line(summary.get("pickcenter") or [], away, home, BETTING.provider)
    if line:
        label, _ = line_label(line, event, league)
        if label:
            facts.append(("Line", f"{label}" + (f" · O/U {number_text(line['total'])}"
                                              if line.get("total") is not None else "")
                          + (f" · ML {away['abbr']} {money_text(line['away_ml'])} / "
                             f"{home['abbr']} {money_text(line['home_ml'])}"
                             if line.get("away_ml") is not None
                             and line.get("home_ml") is not None else "")))
    predictor = (summary or {}).get("predictor") or {}
    if predictor:
        chances = {}
        for key in ("awayTeam", "homeTeam"):
            node = predictor.get(key) or {}
            chances[str(node.get("id"))] = _num(node.get("gameProjection"))
        a, h = chances.get(away["id"]), chances.get(home["id"])
        if a is not None and h is not None:
            facts.append(("Predict", f"ESPN matchup predictor {away['abbr']} {a:.0f}% · "
                                     f"{home['abbr']} {h:.0f}%"))
    weather = dig(summary, "gameInfo", "weather", default={}) or {}
    if weather.get("temperature") is not None:
        bits = [f"{weather['temperature']}°F"]
        if weather.get("displayValue"):
            bits.insert(0, clean(weather["displayValue"]))
        if weather.get("gust"):
            bits.append(f"gusts {weather['gust']} mph")
        if weather.get("precipitation"):
            bits.append(f"{weather['precipitation']}% rain")
        facts.append(("Weather", ", ".join(bits)))
    series = (summary or {}).get("seasonseries") or []
    if series and isinstance(series, list):
        text = clean(series[0].get("summary") or series[0].get("description") or "")
        if text:
            facts.append(("Series", text))
    for label, text in facts:
        lines.append(Line().add(f"{label:<9}", "muted").add(text[: width - 9], "normal"))
    return lines


def render_scouting_matchup(event, summary, table, league, width, loading=False,
                            ranks=None):
    """The left pane: the game, the edges, and the side-by-side numbers."""
    away, home = event["away"], event["home"]
    lines = scouting_header(event, summary, league, width)
    lines.append(blank())
    away_row = find_team_row(table, away)
    home_row = find_team_row(table, home)
    if not table or not away_row or not home_row:
        if loading:
            lines.append(Line().add("Loading season statistics…", "dim"))
        else:
            lines.append(Line().add("No season statistics for one of these teams yet.",
                                    "dim"))
        return lines
    ranks = ranks or stat_ranks(table)
    edges = matchup_edges(table, ranks, away_row, home_row, away, home)
    blocks, counts = comparison_blocks(table, ranks, away_row, home_row, away, home,
                                       league, width)
    tally = Line().add("Stat edges  ", "title")
    tally.add(away["abbr"], THEME.style(league, away, bold=True, fallback="accent"))
    tally.add(f" {counts['away']}", "bold").add(f" ({counts['big_away']} big)", "dim")
    tally.add("  ·  ", "muted")
    tally.add(home["abbr"], THEME.style(league, home, bold=True, fallback="accent"))
    tally.add(f" {counts['home']}", "bold").add(f" ({counts['big_home']} big)", "dim")
    total = len([s for s in table["stats"]])
    tally.add(f"   of {total} stats · ranks are league-wide", "muted")
    lines.append(tally)
    if edges:
        lines.append(Line().add("Matchup advantages to watch", "accent"))
        for side_name, size, text in edges[:8]:
            team = away if side_name == "away" else home
            row = Line().add("  ▲ " if size >= 0.6 else "  △ ", "upset")
            row.add(text[: width - 4], THEME.style(league, team, bold=size >= 0.6,
                                                   fallback="normal"))
            lines.append(row)
    else:
        lines.append(Line().add("No big statistical edge either way.", "dim"))
    lines.append(blank())
    head = Line().add(f"{away['abbr']:>12}", THEME.style(league, away, bold=True,
                                                          fallback="accent"))
    head.add(" " * 20).add(f"{home['abbr']}", THEME.style(league, home, bold=True,
                                                          fallback="accent"))
    lines.append(head)
    lines.extend(flow_columns(blocks, width, gap=3))
    lines.append(blank())
    lines.append(Line().add("◀ ▶ a big edge (a third of the league or more apart) · "
                            "brighter number = better", "muted"))
    sources = ", ".join(table.get("sources") or [])
    if sources:
        lines.append(Line().add(f"Season numbers: {sources}", "muted"))
    return lines



