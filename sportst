NFL_ROUNDS = ["Wild Card", "Divisional", "Championship", "Super Bowl"]
CFB_ROUNDS = ["First Round", "Quarterfinal", "Semifinal", "National Championship"]
MLB_ROUNDS = ["Wild Card", "Division Series", "Championship Series", "World Series"]
NHL_ROUNDS = ["1st Round", "2nd Round", "Conf Finals", "Stanley Cup Final"]
CBASE_ROUNDS = ["Regionals", "Super Regionals", "College World Series", "Finals"]

NHL_API = "https://api-web.nhle.com/v1"


PLACEHOLDER_NAMES = {"TBD", "TBA", "", "?"}


def real_team(team):
    """A named team, not a bracket placeholder like 'TBD' or 'AL 4/5 Winner'."""
    if not isinstance(team, dict):
        return False
    abbr = clean(team.get("abbr") or "").upper()
    if abbr and abbr not in PLACEHOLDER_NAMES:
        return bool(team.get("id")) or len(abbr) <= 5
    return False


def count_real_teams(rounds):
    seen = set()
    for _, entries in rounds:
        for entry in entries:
            for which in ("top", "bottom"):
                team = entry[which].get("team") or {}
                if real_team(team):
                    seen.add(team.get("id") or team.get("abbr"))
    return len(seen)


def side(team, seed=None, score=None, winner=False):
    return {"team": team or {}, "seed": seed, "score": score, "winner": bool(winner)}


def series(round_name, conference, top, bottom, status="", note="", best_of=None):
    return {"round": round_name, "conference": conference or "", "top": top,
            "bottom": bottom, "status": status, "note": note, "best_of": best_of}


def team_key(team):
    """Whatever identifies this team in the data at hand."""
    if not isinstance(team, dict):
        return ""
    return (str(team.get("id") or "") or clean(team.get("abbr") or "")
            or clean(team.get("name") or ""))


def series_winner(entry):
    for which in ("top", "bottom"):
        if entry[which].get("winner"):
            return team_key(entry[which].get("team"))
    return ""


def series_teams(entry):
    return [key for key in (team_key(entry[which].get("team"))
                            for which in ("top", "bottom")) if key]


def conference_of(text):
    text = (text or "").upper()
    for tag in ("AFC", "NFC", "AL", "NL", "EAST", "WEST"):
        if tag in text:
            return {"EAST": "East", "WEST": "West"}.get(tag, tag)
    return ""


def note_tail(headline):
    """The part of a bowl or tournament note worth showing under a series."""
    text = clean(headline or "")
    for marker in (" - ", " at the "):
        if marker in text:
            return text.split(marker, 1)[1][:24]
    if "Elimination" in text or "advances" in text:
        return text[:24]
    return ""


def cbase_round(headline):
    low = (headline or "").lower()
    if "championship final" in low or "finals" in low:
        return "Finals"
    if "world series" in low:
        return "College World Series"
    if "super regional" in low:
        return "Super Regionals"
    return "Regionals"


def bracket_from_events(events, league, rounds, seeds=None, keep=None, namer=None,
                        notes=True):
    """Single-elimination rounds built from ESPN postseason games."""
    seeds = seeds or {}
    grouped = {}
    for event in events:
        headline = ""
        for note in event.get("notes") or []:
            headline = headline or clean(note)
        if keep and not keep(headline):
            continue
        if namer:
            name = namer(headline)
        else:
            name = next((r for r in rounds
                         if r.lower().split()[0] in headline.lower()), "")
        if not name:
            name = headline or rounds[0]
        away, home = event["away"], event["home"]
        top = side(home, seeds.get(home["id"]) or home.get("rank"), home["score"],
                   home.get("winner"))
        bottom = side(away, seeds.get(away["id"]) or away.get("rank"), away["score"],
                      away.get("winner"))
        status = "" if event["state"] == "post" else status_text(event)
        if not status and notes and note_tail(headline):
            status = note_tail(headline)
        grouped.setdefault(name, []).append(
            series(name, conference_of(headline), top, bottom, status, headline))
    order = [r for r in rounds if r in grouped] + [k for k in grouped if k not in rounds]
    return [(name, grouped[name]) for name in order]


NBA_ROUNDS = ["1st Round", "Conf Semifinals", "Conf Finals", "NBA Finals"]
CBB_ROUNDS = ["First Four", "1st Round", "2nd Round", "Sweet 16", "Elite 8", "Final Four",
              "Championship"]
# where each seed's pod sits in a region, top to bottom
BRACKET_SEEDS = [1, 16, 8, 9, 5, 12, 4, 13, 6, 11, 3, 14, 7, 10, 2, 15]


def nba_round(headline):
    low = (headline or "").lower()
    if "play-in" in low:
        return ""
    if "nba finals" in low:
        return "NBA Finals"
    if "first round" in low or "1st round" in low:
        return "1st Round"
    if "semifinal" in low:
        return "Conf Semifinals"
    if "final" in low:
        return "Conf Finals"
    return ""


def bracket_nba(events):
    """ESPN lists playoff games one at a time; fold them into series. The
    team at home in game one is the higher seed."""
    found = {}
    for event in sorted(events, key=lambda e: e["date"] or ""):
        headline = next((n for n in event.get("notes") or [] if n), "")
        name = nba_round(headline)
        if not name:
            continue
        away, home = event["away"], event["home"]
        key = (name, frozenset((away["id"], home["id"])))
        entry = found.get(key)
        if entry is None:
            conference = "East" if headline.lower().startswith("east") else (
                "West" if headline.lower().startswith("west") else "")
            entry = found[key] = {"name": name, "conference": conference,
                                  "top": home, "bottom": away, "wins": {}, "status": "",
                                  "done": False}
        info = dig(event, "raw", "competitions", 0, "series", default={}) or {}
        for team in info.get("competitors") or []:
            entry["wins"][str(team.get("id"))] = team.get("wins") or 0
        entry["done"] = bool(info.get("completed"))
        entry["status"] = clean(info.get("summary") or "")
    rounds = {}
    for entry in found.values():
        top, bottom = entry["top"], entry["bottom"]
        wins_top = entry["wins"].get(top["id"], 0)
        wins_bottom = entry["wins"].get(bottom["id"], 0)
        spots = [side(top, None, wins_top, entry["done"] and wins_top > wins_bottom),
                 side(bottom, None, wins_bottom, entry["done"] and wins_bottom > wins_top)]
        status = "" if entry["done"] else entry["status"]
        rounds.setdefault(entry["name"], []).append(
            series(entry["name"], entry["conference"], spots[0], spots[1], status,
                   best_of=7))
    for name in rounds:
        rounds[name].sort(key=lambda s: (s["conference"] != "East", s["conference"]))
    return [(name, rounds[name]) for name in NBA_ROUNDS if name in rounds]


def cbb_round(headline):
    tail = (headline or "").split(" - ")[-1].strip().lower()
    for name, keys in (("First Four", ("first four",)), ("1st Round", ("1st round",
                                                                        "first round")),
                       ("2nd Round", ("2nd round", "second round")),
                       ("Sweet 16", ("sweet 16", "regional semifinal")),
                       ("Elite 8", ("elite 8", "elite eight", "regional final")),
                       ("Final Four", ("final four", "national semifinal")),
                       ("Championship", ("championship",))):
        if any(k in tail for k in keys):
            return name
    return ""


def bracket_cbb(events):
    """The NCAA tournament, each region's games in bracket order so the
    wiring runs straight."""
    rounds = bracket_from_events(
        events, "cbb", CBB_ROUNDS,
        keep=lambda h: "men's basketball championship" in h.lower() and bool(cbb_round(h)),
        namer=cbb_round, notes=False)
    regions = []
    for _, entries in rounds:
        for entry in entries:
            match = re.search(r" - (\w+) Region", entry.get("note") or "")
            entry["conference"] = match.group(1) if match else ""
            if entry["conference"] and entry["conference"] not in regions:
                regions.append(entry["conference"])

    def position(entry):
        seeds = []
        for which in ("top", "bottom"):
            try:
                seeds.append(int(entry[which].get("seed")))
            except (TypeError, ValueError):
                pass
        low = min(seeds) if seeds else 99
        region = regions.index(entry["conference"]) if entry["conference"] in regions else 9
        return (region, BRACKET_SEEDS.index(low) if low in BRACKET_SEEDS else 99)
    # the First Four feeds only four of the 32 first-round games; wiring it in
    # would push the whole bracket out of seed order, so the field starts at 64
    return [(name, sorted(entries, key=position)) for name, entries in rounds
            if name != "First Four"]


def basketball_postseason_urls(api, league, season):
    """Where ESPN keeps a basketball postseason: the NBA by month, the NCAA
    tournament as one group."""
    if league == "nba":
        return [(month, api.espn._site(
            f"basketball/nba/scoreboard?dates={season}{month:02d}&limit=300"))
            for month in (4, 5, 6)]
    return [(0, api.espn._site(
        f"basketball/mens-college-basketball/scoreboard?dates={season}"
        f"&seasontype=3&groups=100&limit=300"))]


def bracket_nhl(data):
    """NHL publishes its own bracket, seeds and series scores included."""
    rounds = {}
    for entry in dig(data, "series", default=[]) or []:
        title = clean(entry.get("seriesTitle") or "")
        name = {1: "1st Round", 2: "2nd Round", 3: "Conf Finals",
                4: "Stanley Cup Final"}.get(entry.get("playoffRound"), title)

        def team_of(node):
            if not node:
                return {}
            return {"id": str(node.get("id", "")), "abbr": clean(node.get("abbrev") or ""),
                    "name": clean(dig(node, "name", "default", default="")),
                    "short": clean(dig(node, "commonName", "default", default="")),
                    "location": clean(dig(node, "placeNameWithPreposition", "default",
                                          default="")),
                    "color": ""}

        top_team, bottom_team = team_of(entry.get("topSeedTeam")), \
            team_of(entry.get("bottomSeedTeam"))
        winner = str(entry.get("winningTeamId") or "")
        top = side(top_team, entry.get("topSeedRankAbbrev") or entry.get("topSeedRank"),
                   entry.get("topSeedWins"), winner and winner == top_team.get("id"))
        bottom = side(bottom_team,
                      entry.get("bottomSeedRankAbbrev") or entry.get("bottomSeedRank"),
                      entry.get("bottomSeedWins"),
                      winner and winner == bottom_team.get("id"))
        conference = clean(entry.get("conferenceAbbrev") or "")
        if not conference and entry.get("seriesLetter"):
            conference = "East" if entry["seriesLetter"] <= "D" else "West"
        status = ""
        if entry.get("neededToWin"):
            status = f"best of {2 * entry['neededToWin'] - 1}"
        rounds.setdefault(name, []).append(
            series(name, conference, top, bottom, status))
    order = [r for r in NHL_ROUNDS if r in rounds] + \
        [k for k in rounds if k not in NHL_ROUNDS]
    return [(name, rounds[name]) for name in order]


def bracket_mlb(schedule, teams_by_name=None):
    """MLB's postseason schedule, folded back into series."""
    teams_by_name = teams_by_name or {}
    found = {}
    for day in dig(schedule, "dates", default=[]) or []:
        for game in day.get("games") or []:
            description = clean(game.get("seriesDescription") or "")
            name = next((r for r in MLB_ROUNDS if r.lower() in description.lower()), "")
            if not name:
                name = description or "Postseason"
            pair = {}
            for which in ("away", "home"):
                node = dig(game, "teams", which, default={}) or {}
                team_name = clean(dig(node, "team", "name", default=""))
                pair[which] = (team_name, bool(node.get("isWinner")))
            key = (name, tuple(sorted(x[0] for x in pair.values())),
                   clean(game.get("description") or "").split("Game")[0].strip())
            entry = found.setdefault(key, {"name": name, "conference":
                                           conference_of(description),
                                           "wins": {}, "played": 0,
                                           "of": game.get("gamesInSeries")})
            state = dig(game, "status", "abstractGameState", default="")
            if state == "Final":
                entry["played"] += 1
                for team_name, won in pair.values():
                    entry["wins"].setdefault(team_name, 0)
                    if won:
                        entry["wins"][team_name] += 1
            else:
                for team_name, _ in pair.values():
                    entry["wins"].setdefault(team_name, 0)

    rounds = {}
    for (name, pair, _), entry in found.items():
        wins = entry["wins"]
        needed = ((entry["of"] or 3) + 1) // 2
        sides = []
        for team_name in sorted(pair, key=lambda n: -wins.get(n, 0)):
            team = teams_by_name.get(team_name.lower()) or {"id": "", "abbr": "",
                                                            "name": team_name}
            sides.append(side(team, None, wins.get(team_name, 0),
                              wins.get(team_name, 0) >= needed))
        while len(sides) < 2:
            sides.append(side({}))
        status = f"best of {entry['of']}" if entry.get("of") else ""
        rounds.setdefault(name, []).append(
            series(name, entry["conference"], sides[0], sides[1], status))
    order = [r for r in MLB_ROUNDS if r in rounds] + \
        [k for k in rounds if k not in MLB_ROUNDS]
    return [(name, rounds[name]) for name in order]


def bracket_layout(rounds, width, league, favorites=None, connect=True):
    """Draw the rounds as columns, each series wired to the one it feeds.

    A series sits level with the two it came from, so a team's run reads
    left to right across the page.
    """
    if not rounds:
        return []
    favorites = favorites or {}
    columns = len(rounds)
    gap = 4
    box = clamp((width - 2) // columns - gap, 15, 26)
    step = box + gap

    rows = {}
    for index in range(len(rounds[0][1])):
        rows[(0, index)] = index * 3
    for column in range(1, columns):
        previous = rounds[column - 1][1]
        used = []
        for index, entry in enumerate(rounds[column][1]):
            teams = set(series_teams(entry))
            feeders = [rows[(column - 1, j)] for j, earlier in enumerate(previous)
                       if series_winner(earlier) and series_winner(earlier) in teams]
            position = (sum(feeders) / len(feeders)) if feeders else index * 3 * (column + 1)
            while any(abs(position - other) < 3 for other in used):
                position += 3
            used.append(position)
            rows[(column, index)] = position

    height = int(max(rows.values(), default=0)) + 4
    canvas = [[(" ", "normal") for _ in range(width)] for _ in range(height)]

    joints = set("─│┌┐└┘├┤┬┴┼")

    def put(row, col, text, style):
        if not 0 <= row < height:
            return
        for offset, char in enumerate(text):
            if not 0 <= col + offset < width:
                continue
            old = canvas[row][col + offset][0]
            if {old, char} == {"─", "│"}:
                char = "┼"
            canvas[row][col + offset] = (char, style)

    for column, (name, entries) in enumerate(rounds):
        x = column * step
        put(0, x, name[:box].center(box), "header")
        for index, entry in enumerate(entries):
            row = int(rows[(column, index)]) + 2
            decided = bool(series_winner(entry))
            for which, offset in (("top", 0), ("bottom", 1)):
                spot = entry[which]
                team = spot.get("team") or {}
                if not team:
                    continue
                seed = spot.get("seed")
                label = f"({seed}) " if seed not in (None, "") else ""
                known = real_team(team)
                abbr = (team.get("abbr") if known else "") or team.get("short") \
                    or team.get("name") or "?"
                score = spot.get("score")
                text = f"{label}{abbr}"[: box - 4]
                style = THEME.style(league, team, bold=spot.get("winner"),
                                    dim=decided and not spot.get("winner"),
                                    fallback="normal") if known else "muted"
                star = fav_rank(favorites, league, team) >= 0
                put(row + offset, x, ("★" if star else " ") + text,
                    "star" if star else style)
                put(row + offset, x + 1 + len(text), "", style)
                put(row + offset, x + box - 4,
                    f"{'' if score is None else score:>3}",
                    "bold" if spot.get("winner") else style)
                if spot.get("winner"):
                    put(row + offset, x + box - 1, "✓", "good")
            if entry.get("status") and row + 2 < height:
                put(row + 2, x, entry["status"][: box], "muted")

        if column + 1 >= columns or not connect:
            continue
        # wire each series in the next round back to the ones that fed it
        mid = x + box + gap // 2
        for child, later in enumerate(rounds[column + 1][1]):
            teams = set(series_teams(later))
            feeders = [int(rows[(column, j)]) + 2 for j, entry in enumerate(entries)
                       if series_winner(entry) and series_winner(entry) in teams]
            if not feeders:
                continue
            end = int(rows[(column + 1, child)]) + 2
            for row in range(min(feeders + [end]), max(feeders + [end]) + 1):
                put(row, mid, "│", "border")
            for feeder in feeders:
                for col in range(x + box, mid):
                    put(feeder, col, "─", "border")
                put(feeder, mid, "┐" if feeder < end else
                    ("┘" if feeder > end else "─"), "border")
            for col in range(mid + 1, x + step):
                put(end, col, "─", "border")
            above = [f for f in feeders if f < end]
            below = [f for f in feeders if f > end]
            put(end, mid, "├" if above and below else
                ("└" if above else ("┌" if below else "─")), "border")

    lines = []
    for row in canvas:
        line = Line()
        for char, style in row:
            line.add(char, style)
        lines.append(merge_spans(line))
    while lines and not lines[-1].text.strip():
        lines.pop()
    return lines


def champion_line(rounds, league):
    if not rounds:
        return None
    name, entries = rounds[-1]
    for entry in entries:
        for which in ("top", "bottom"):
            if entry[which].get("winner"):
                team = entry[which]["team"]
                line = Line().add("★ ", "star")
                line.add(team.get("name") or team.get("abbr") or "?",
                         THEME.style(league, team, bold=True, fallback="accent"))
                line.add(f"  {name} winner", "dim")
