        if str(block_team(candidate).get("id")) == str(team.get("id")):
            block = candidate
    if block is None:
        abbr = str(team.get("abbr") or "").upper()
        block = next((b for b in blocks if str(block_team(b).get("abbr")).upper() == abbr),
                     None)
    if block is None:
        return [], [], []
    layout = LAST_GAME_LAYOUT.get("ahl" if league == "ahl" else sport_of(league), [])
    left, right, bottom_blocks = [], [], []
    for entry in layout:
        where, options = entry[0], entry[4]
        title, labels, rows, styles = last_game_sections(block, entry)
        if not rows:
            continue
        width = full_width if where == "bottom" else pane_width
        table = fitted_table([title] + labels, rows, width, ["<"] + [">"] * len(labels),
                             styles)
        if table and len(table[0]):
            text, _ = table[0][0]
            table[0][0] = (text, THEME.style(league, team, bold=True, fallback="accent"))
        table = list(table)
        if where == "bottom":
            if options.get("split") and len(table) > 7:
                body = table[1:]
                half = (len(body) + 1) // 2
                first, second = [table[0]] + body[:half], [table[0]] + body[half:]
                block_width = max(sum(len(t) for t, _ in l) for l in first)
                if block_width * 2 + 3 <= full_width:
                    bottom_blocks.extend([first, second])
                    continue
            bottom_blocks.append(table)
        else:
            (left if where == "left" else right).extend(table + [blank()])
    return left, right, side_by_side(bottom_blocks, full_width)


