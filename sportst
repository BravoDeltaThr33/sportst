def football_swing_lines(summary, event, league, width, count=4):
    """The plays that swung ESPN's win probability most, biggest first: who
    gained, by how much, when, and the play."""
    swings = football_swings(summary)
    if not swings:
        return []
    lines = [fit_line(heading("Biggest swings").add(
        "  ESPN's win probability, play by play", "muted"), width)]
    for change, play in swings[:count]:
        team = event["home"] if change > 0 else event["away"]
        number = _int(dig(play, "period", "number", default=0))
        when = f"{period_tag(league, number)} {bball_play_clock(play)}" if number else ""
        line = Line().add("  ", "normal").add(f"{team['abbr']:<5}", THEME.style(
            league, team, bold=True, fallback="accent"))
        line.add(f"+{abs(change) * 100:.0f}%".ljust(6), "bold").add(f"{when:<10}", "muted")
        line.add(football_play_text(play.get("text")), "normal")
        lines.extend(wrap_line(line, width, indent=23)[:2])
    return lines


def wrap_line(line, width, indent=0):
    """A Line cut into lines of `width`, the later ones indented."""
    out, current = [], Line()
    used = 0
    for text, style in line:
        while text:
            room = width - used
            if room <= 0:
                out.append(current)
                current, used = Line().add(" " * indent, "normal"), indent
                room = width - used
                text = text.lstrip()
                if not text:
                    break
            piece = text[:room]
            if len(text) > room and " " in piece:
                piece = piece[:piece.rfind(" ") + 1]
            current.add(piece, style)
            used += len(piece)
            text = text[len(piece):]
            if text:
                used = width
    if current:
        out.append(current)
    return out


def football_drive_of(summary, play):
    """The drive a scoring play came on, by its play's id (else its clock)."""
    ident = str((play or {}).get("id") or "")
    for drive in football_drives(summary):
        if any(str(item.get("id")) == ident for item in drive.get("plays") or []):
            return drive
    return None


def football_drive_snaps(drive):
    """A drive's plays as its card shows them: no timeouts, ends of quarters
    or two-minute warnings."""
    return [play for play in (drive or {}).get("plays") or []
            if isinstance(play, dict) and not re.search(
                r"timeout|end of|end period|two-minute|coin toss",
                clean(dig(play, "type", "text", default="") or ""), re.I)]


def football_drive_title(drive, play, event, league):
    """'Touchdown drive · UTAH · Q1 13:45 · 0-7 · 3 plays, 75 yards, 1:15'."""
    kind = clean(dig(play, "type", "text", default="") or "")
    result = clean((drive or {}).get("displayResult") or "") or kind or "Score"
    side = football_side(drive or play, event)
    number = _int(dig(play, "period", "number", default=0))
    clock = clean(dig(play, "clock", "displayValue", default="") or "")
    parts = [f"{result} drive" if drive else result]
    if side:
        parts.append(event[side]["abbr"])
    if number:
        parts.append(f"{period_tag(league, number)} {clock}".strip())
    a, h = (play or {}).get("awayScore"), (play or {}).get("homeScore")
    if isinstance(a, int) and isinstance(h, int):
        parts.append(f"{a}-{h}")
    if drive and drive.get("description"):
        parts.append(clean(drive["description"]))
    return " · ".join(parts)


def football_drive_plays(drive, event, league, width, rows, focus=""):
    """A drive play by play on the field, a row each: the down and distance,
    the run from where the play began to where it ended in the offense's
    colours (a loss in grey, an incompletion or a kick a dot where it began),
    the yards and what happened. The latest plays that fit `rows` (the scoring
    one among them); without room for the field, the plays as text."""
    away, home = event["away"], event["home"]
    side = football_side(drive, event)
    plays = football_drive_snaps(drive)
    if not plays:
        return [Line().add("No plays published for this drive yet.", "dim")]
    tag_w = 9
    tail_w = clamp(width * 2 // 5, 30, 90)
    field_w = width - tag_w - 2 * DRIVE_ZONE - 1 - tail_w
    text_only = field_w < 30 or side is None or rows < 2
    keep = max(1, rows - (0 if text_only else 1))
    if len(plays) > keep:
        at = next((i for i, play in enumerate(plays) if str(play.get("id")) == focus),
                  len(plays) - 1)
        start = clamp(at - keep + 1, 0, max(0, len(plays) - keep))
        plays = plays[start:start + keep]
    team = event[side] if side else None
    out = []

    def label(play):
        text = clean(dig(play, "start", "shortDownDistanceText", default="") or "")
        found = re.match(r"(\d)\w*\s*&\s*(\w+)", text)
        if found:
            return f"{found.group(1)}&{found.group(2)}"
        return clean(dig(play, "type", "abbreviation", default="") or "")[:tag_w - 1]

    def gained(play):
        """Yards gained; None for a kick (a field goal's 27 is its length)."""
        if re.search(r"field goal|punt|kickoff|extra point|two-point",
                     clean(dig(play, "type", "text", default="") or ""), re.I):
            return None
        value = play.get("statYardage")
        return int(value) if isinstance(value, (int, float)) else None

    if text_only:
        for play in plays:
            line = Line().add(f"{label(play):<{tag_w}}", "muted")
            yards = gained(play)
            if yards:
                line.add(f"{yards:+d} ".rjust(5), "good" if yards > 0 else "bad")
            line.add(football_play_text(play.get("text")),
                     "bold" if str(play.get("id")) == focus else "normal")
            out.append(fit_line(line, width))
        return out
    left = tag_w + DRIVE_ZONE
    green = f"@{FIELD_LINE}:{FIELD_GREEN}"
    color = team_hex(league, team)
    rgb = hex_to_rgb("#" + color) or (90, 90, 90)
    if color_distance(rgb, hex_to_rgb("#" + FIELD_GREEN) or (35, 107, 38)) < 15000:
        color = "%02X%02X%02X" % tuple(int(round(c + (255 - c) * 0.45)) for c in rgb)

    def col(yard):
        return left + int(round(clamp(yard, 0, 100) * (field_w - 1) / 100))

    def zones(canvas):
        for owner, x in ((away, tag_w), (home, left + field_w)):
            shade = team_hex(league, owner)
            canvas.put(0, x, " " * DRIVE_ZONE, f"@{_ink_on(shade)}:{shade}")

    head = Canvas(width, 1)
    zones(head)
    for yard in range(10, 100, 10):
        mark = str(yard if yard <= 50 else 100 - yard)
        head.put(0, col(yard) - len(mark) // 2, mark, "dim")
    head.put(0, 0, f"{away.get('abbr', '')[:4]:<4}", THEME.style(league, away, bold=True))
    head.put(0, left + field_w + DRIVE_ZONE + 1, (home.get("abbr") or "")[:tail_w],
             THEME.style(league, home, bold=True))
    out.append(head.rows()[0])
    forward = side == "away"
    for play in plays:
        canvas = Canvas(width, 1)
        canvas.put(0, 0, f"{label(play):<{tag_w}}", "muted")
        zones(canvas)
        canvas.put(0, left, " " * field_w, green)
        for yard in range(10, 100, 10):
            canvas.put(0, col(yard), "·" if yard != 50 else "│", green)
        begin = drive_spot(play.get("start"), away, home)
        end = drive_spot(play.get("end"), away, home)
        yards = gained(play)
        kind = clean(dig(play, "type", "text", default="") or "")
        if yards is None:
            end = begin                          # a kick: where it was kicked from
        elif begin is not None and (end is None or abs(
                (end - begin) * (1 if forward else -1) - yards) > 2):
            # the end spot can be the next play's (after a penalty): the yards win
            end = begin + (yards if forward else -yards)
        if begin is not None:
            if end is None or end == begin or not yards:
                canvas.put(0, col(begin), "•", f"@{color}:{FIELD_GREEN}~b")
            else:
                low, high = sorted((col(begin), col(end)))
                lost = yards < 0
                shade = "6E6E6E" if lost else color       # grey: a red team's gains are red
                canvas.put(0, low, " " * (high - low + 1), f"@{_ink_on(shade)}:{shade}")
                canvas.put(0, col(end), "▶" if end > begin else "◀",
                           f"@{_ink_on(shade)}:{shade}~b")
        tail = Line()
        if yards:
            tail.add(f"{yards:+d}".rjust(4) + " ", "good" if yards > 0 else "bad")
        elif yards is None:
            tail.add(clean(dig(play, "type", "abbreviation", default="") or "")[:4]
                     .rjust(4) + " ", "accent")
        elif FOOTBALL_RUN_PASS.match(kind) or "incompletion" in kind.lower():
            tail.add("   0 ", "dim")
        else:
            tail.add("     ", "normal")
        tail.add(football_play_text(play.get("text")),
                 "bold" if str(play.get("id")) == focus else "normal")
        canvas.line(0, left + field_w + DRIVE_ZONE + 1, tail, tail_w)
        out.append(canvas.rows()[0])
    return out


# -- football's Game Center: the ball, the timeouts, the row over the chart -----

FOOTBALL_LEATHER = "9A4E24"
FOOTBALL_LACES = "F4F1EA"
# a football two pixels a cell in half blocks: B the leather, W the laces, .
# nothing; three rows beside big digits, two beside small ones
FOOTBALL_PIXELS = {
    3: ("....BBBBB....",
        "..BBWBWBWBB..",
        "BBBWWWWWWWBBB",
        "BBBBWBWBWBBBB",
        "..BBBBBBBBB..",
        "....BBBBB...."),
    2: ("..BBBBB..",
        "BBWWWWWBB",
        "BBBWBWBBB",
        "..BBBBB.."),
}


def half_block_art(pixels, colors):
    """Lines from rows of pixels, two a cell (▀ ▄ █): each pixel a key of
    `colors` (hex) or anything else for nothing."""
    out = []
    for top in range(0, len(pixels), 2):
        upper = pixels[top]
        lower = pixels[top + 1] if top + 1 < len(pixels) else "." * len(upper)
        line = Line()
        for a, b in zip(upper, lower):
            fa, fb = colors.get(a), colors.get(b)
            if fa and fb:
                line.add("█", f"@{fa}") if fa == fb else line.add("▀", f"@{fa}:{fb}")
            elif fa:
                line.add("▀", f"@{fa}")
            elif fb:
                line.add("▄", f"@{fb}")
            else:
                line.add(" ", "normal")
        out.append(merge_spans(line))
    return out


def football_ball(rows, league):
    """The Game Center's football, `rows` (2 or 3) tall: brown, its laces
    white, and a college ball's white stripes near each end."""
    pixels = [list(row) for row in FOOTBALL_PIXELS[3 if rows >= 3 else 2]]
    if league in COLLEGE_LEAGUES:
        last = len(pixels[0]) - 1
        for row in pixels[1:-1]:
            for x in (2, last - 2):
                if row[x] == "B":
                    row[x] = "W"
    return half_block_art(["".join(row) for row in pixels],
                          {"B": FOOTBALL_LEATHER, "W": FOOTBALL_LACES})


FOOTBALL_SHAPE = 1.72          # a football side on: its length over its height
_FOOTBALL_PICTURES = {}        # (width, height, college) -> PNG, once drawn


def football_picture(width, height, college=False):
    """The Game Center's football as a picture for a terminal that shows
    pictures: a PNG of width x height pixels, drawn here rather than
    downloaded, so it is sharp at the terminal's own size and needs no
    network. A real ball's look, tipped a little as if it sat on a tee: its
    four leather panels with a pebbled grain, lit from the upper left with a
    soft sheen and a small hot spot, a warm rim light behind, the seams
    pressed in tip to tip, the laces raised over the top seam - the long one
    under eight crossing stitches, each rounded and shaded, their ends in
    the holes they go through - and, on a college ball, a painted stripe
    round each end; a soft shadow under it, see-through round it. Drawn at
    twice the size and shrunk, so its edges are smooth. b'' when too small
    to draw."""
    key = (int(width), int(height), bool(college))
    if key in _FOOTBALL_PICTURES:
        return _FOOTBALL_PICTURES[key]
    width, height = key[0], key[1]
    if width < 8 or height < 5:
        return b""
    import math
    sqrt, atan2, exp = math.sqrt, math.atan2, math.exp
    # drawn twice the size and shrunk where its pixels are few; a big ball has
    # enough of its own (and would take a second)
    scale = 2 if width * height <= 160 * 100 else 1
    big_w, big_h = width * scale, height * scale
    tilt = 0.14                                     # the right tip up, radians
    cos_t, sin_t = math.cos(tilt), math.sin(tilt)
    # the ball's half height b and half length a, room left for the shadow
    b = max(1.0, min((big_w - 3.0) / (2.0 * 1.709 * FOOTBALL_SHAPE / 1.72),
                     (big_h - 3.0) / 2.36))
    a = b * FOOTBALL_SHAPE
    cx = big_w / 2.0
    cy = max(1.5, (big_h - 2.36 * b) / 2.0) + 1.02 * b     # the ball and its shadow centred

    def unit(x, y, z):
        size = sqrt(x * x + y * y + z * z)
        return x / size, y / size, z / size

    def to_ball(x, y, z):
        """A direction on the screen (y up) into the ball's own frame."""
        return x * cos_t + y * sin_t, -x * sin_t + y * cos_t, z

    lx, ly, lz = to_ball(*unit(-0.45, 0.70, 0.56))   # the light: upper left, in front
    hx, hy, hz = unit(lx, ly, lz + 1.0)              # half way to the eye
    rx_, ry_, rz_ = to_ball(*unit(0.75, 0.35, -0.55))  # the rim light, behind on the right
    leather = (122, 56, 27)
    lace = (247, 243, 234)
    paint = (240, 237, 229)
    lace_at = 0.50                                   # the laces' seam, up from the front
    seams = (lace_at, lace_at - math.pi / 2)
    lace_x = 0.34 * a                                # the laces run this far each way
    count = 8 if a >= 34 else 6 if a >= 18 else 4    # a real ball has eight
    step = 2 * lace_x / count
    cross_w = max(0.9, 0.30 * step)                  # half a stitch's width
    span = 0.29                                      # a stitch's reach either side of the seam
    long_w = max(0.8, 0.040 * b)                     # half the long lace's width
    seam_w = max(0.6, 0.016 * b)
    stripe_x, stripe_w = 0.585 * a, max(1.0, 0.055 * a)
    panel_tint = (1.00, 0.965, 1.025, 0.985)

    def profile(x):
        """The ball's radius at x along it, and its slope."""
        u = x / a
        base = 1.0 - u * u
        if base <= 0:
            return 0.0, 0.0
        return b * base ** 0.80, b * 0.80 * base ** -0.20 * (-2.0 * u / a)

    def lace_cover(x, y):
        """How much of the point (x, y) the laces cover (0-1), and their
        light there (the rounded stitch's shading)."""
        if abs(x) > lace_x + cross_w + 1.5:
            return 0.0, 0.0
        r = profile(x)[0]
        if r <= 0 or abs(y) >= r or y < 0.08 * r:
            return 0.0, 0.0
        theta = atan2(y, sqrt(r * r - y * y))
        off = (theta - lace_at) * r                  # along the surface, from the seam
        cover, light = 0.0, 0.0
        if abs(x) <= lace_x + 0.5:
            k = min(1.0, max(0.0, long_w - abs(off) + 0.5)) * \
                min(1.0, max(0.0, lace_x - abs(x) + 0.5))
            if k > 0:
                across = min(1.0, abs(off) / long_w)
                cover, light = k, 0.70 + 0.32 * sqrt(max(0.0, 1.0 - across * across))
        near = int((x + lace_x) // step)
        reach = span * r
        for j in (near - 1, near, near + 1):
            if 0 <= j < count:
                at = -lace_x + (j + 0.5) * step
                across = abs(x - at)
                along = abs(off)
                if along > reach:                    # a rounded end
                    over = along - reach
                    dist = sqrt(over * over + across * across)
                else:
                    dist = across
                k = min(1.0, max(0.0, cross_w - dist + 0.5))
                if k > cover:
                    t = min(1.0, across / cross_w)
                    cover, light = k, 0.64 + 0.40 * sqrt(max(0.0, 1.0 - t * t)) - \
                        0.10 * (along / max(1.0, reach))
        return cover, light

    def hole(x, y):
        """How dark the lace holes make the point (x, y): 0-1."""
        if abs(x) > lace_x + 1.5:
            return 0.0
        r = profile(x)[0]
        if r <= 0 or abs(y) >= r or y < 0.04 * r:
            return 0.0
        theta = atan2(y, sqrt(r * r - y * y))
        dark = 0.0
        near = int((x + lace_x) // step)
        for j in (near - 1, near, near + 1):
            if 0 <= j < count:
                at = -lace_x + (j + 0.5) * step
                for side in (-1, 1):
                    end = lace_at + side * (span + 0.075)
                    d = sqrt((x - at) ** 2 + ((theta - end) * r) ** 2)
                    dark = max(dark, min(1.0, max(0.0, cross_w * 0.75 - d + 0.5)))
        return dark

    # the shadow first, the ball laid over it
    out = [0.0] * (big_w * big_h * 4)
    sx, sy = cx + 0.04 * a, cy + 1.06 * b
    srx, sry = 0.82 * a, 0.17 * b
    for py in range(max(0, int(sy - 3 * sry)), min(big_h, int(sy + 3 * sry) + 1)):
        for px in range(max(0, int(sx - 1.4 * srx)), min(big_w, int(sx + 1.4 * srx) + 1)):
            d = ((px + 0.5 - sx) / srx) ** 2 + ((py + 0.5 - sy) / sry) ** 2
            alpha = 0.40 * exp(-2.4 * d)
            if alpha > 0.004:
                out[(py * big_w + px) * 4 + 3] = alpha
    sdx, sdy, _ = to_ball(1.1, -1.1, 0.0)           # the laces' shadow, down and right
    half_w, half_h = sqrt((a * cos_t) ** 2 + (b * sin_t) ** 2) + 2, \
        sqrt((a * sin_t) ** 2 + (b * cos_t) ** 2) + 2
    for py in range(max(0, int(cy - half_h)), min(big_h, int(cy + half_h) + 1)):
        Y = cy - (py + 0.5)
        for px in range(max(0, int(cx - half_w)), min(big_w, int(cx + half_w) + 1)):
            X = px + 0.5 - cx
            x, y = X * cos_t + Y * sin_t, -X * sin_t + Y * cos_t
            r, dr = profile(x)
            edge = (r - abs(y)) / sqrt(1.0 + dr * dr) + 0.5
            if edge <= 0:
                continue
            yy = max(-r, min(r, y))
            z = sqrt(max(0.0, r * r - yy * yy))
            nx, ny, nz = unit(-r * dr, yy, z) if r > 0 else (0.0, 0.0, 1.0)
            theta = atan2(yy, z)
            # the grain: little rounded pebbles, a cell each
            gu, gv = x / 1.9, theta * b / 1.9
            iu, iv = math.floor(gu), math.floor(gv)
            seed = (iu * 73856093) ^ (iv * 19349663)
            seed = (seed ^ (seed >> 13)) * 1274126177 & 0xFFFFFFFF
            fu, fv = gu - iu - 0.5, gv - iv - 0.5
            bump = (1.0 - min(1.0, (fu * fu + fv * fv) * 3.2)) * (0.55 + 0.45 * (seed & 255) / 255)
            nx, ny = nx - 0.10 * fu * bump, ny - 0.10 * fv * bump
            size = sqrt(nx * nx + ny * ny + nz * nz)
            nx, ny, nz = nx / size, ny / size, nz / size
            diffuse = max(0.0, (nx * lx + ny * ly + nz * lz + 0.22) / 1.22)
            spec_dot = max(0.0, nx * hx + ny * hy + nz * hz)
            sheen = spec_dot ** 10 * 0.20 + spec_dot ** 64 * 0.32
            rim = max(0.0, nx * rx_ + ny * ry_ + nz * rz_) * (1.0 - nz) ** 2 * 0.55
            occlusion = 1.0 - 0.32 * (1.0 - nz) ** 3
            panel = int(((theta - lace_at) % (2 * math.pi)) // (math.pi / 2)) % 4
            shade = (0.26 + 0.86 * diffuse) * occlusion * panel_tint[panel] * \
                (0.94 + 0.12 * bump)
            red, green, blue = leather[0] * shade, leather[1] * shade, leather[2] * shade
            for s in seams:                          # pressed in, lit on one lip
                d = abs(theta - s) * r
                k = min(1.0, max(0.0, seam_w - d + 0.5))
                if k:
                    red, green, blue = red * (1 - 0.62 * k), green * (1 - 0.62 * k), \
                        blue * (1 - 0.62 * k)
                lip = abs(theta - s - 2.2 * seam_w / max(1.0, r)) * r
                k = min(1.0, max(0.0, 0.7 * seam_w - lip + 0.5)) * 0.18
                if k:
                    red, green, blue = red + (255 - red) * k, green + (220 - green) * k, \
                        blue + (190 - blue) * k
            if college:
                k = min(1.0, max(0.0, stripe_w - abs(abs(x) - stripe_x) + 0.5))
                if k:
                    w = (0.34 + 0.78 * diffuse) * occlusion
                    red = red * (1 - k) + paint[0] * w * k
                    green = green * (1 - k) + paint[1] * w * k
                    blue = blue * (1 - k) + paint[2] * w * k
            k = hole(x, y)
            if k:
                red, green, blue = red * (1 - 0.7 * k), green * (1 - 0.7 * k), \
                    blue * (1 - 0.7 * k)
            k = 0.5 * lace_cover(x - sdx, y - sdy)[0]       # the laces' shadow
            if k:
                red, green, blue = red * (1 - k), green * (1 - k), blue * (1 - k)
            k, light = lace_cover(x, y)
            if k:
                w = light * (0.42 + 0.66 * diffuse) * (0.8 + 0.2 * nz)
                red = red * (1 - k) + lace[0] * w * k
                green = green * (1 - k) + lace[1] * w * k
                blue = blue * (1 - k) + lace[2] * w * k
            glow = sheen * (0.55 if k else 1.0)
            red += (255 - red) * glow + rim * 210
            green += (236 - green) * glow + rim * 120
            blue += (210 - blue) * glow + rim * 70
            alpha = min(1.0, edge)
            i = (py * big_w + px) * 4
            under = out[i + 3]
            total = alpha + under * (1 - alpha)
            out[i] = (red * alpha) / total if total else 0.0
            out[i + 1] = (green * alpha) / total if total else 0.0
            out[i + 2] = (blue * alpha) / total if total else 0.0
            out[i + 3] = total
    # shrink: each pixel the mean of the scale x scale it was drawn as, weighted by
    # how much each covers
    small = bytearray(width * height * 4)
    steps = range(scale)
    for py in range(height):
        for px in range(width):
            red = green = blue = cover = 0.0
            for dy in steps:
                base = ((py * scale + dy) * big_w + px * scale) * 4
                for i in [base + 4 * dx for dx in steps]:
                    w = out[i + 3]
                    if w:
                        red += out[i] * w
                        green += out[i + 1] * w
                        blue += out[i + 2] * w
                        cover += w
            if cover:
                i = (py * width + px) * 4
                small[i] = max(0, min(255, int(red / cover + 0.5)))
                small[i + 1] = max(0, min(255, int(green / cover + 0.5)))
                small[i + 2] = max(0, min(255, int(blue / cover + 0.5)))
                small[i + 3] = max(0, min(255, int(cover / (scale * scale) * 255 + 0.5)))
    png = png_encode(width, height, small)
    if len(_FOOTBALL_PICTURES) >= 8:
        _FOOTBALL_PICTURES.clear()
    _FOOTBALL_PICTURES[key] = png
    return png


def football_possession(event, summary=None):
    """'away' or 'home': who has the ball in a game being played - ESPN's
    situation, or between plays the drive under way; None at a kickoff, at
    the half, or whenever nobody can tell."""
    if event.get("state") != "in":
        return None
    situation = event.get("situation") or {}
    holder = str(situation.get("possession") or "")
    if not holder:
        current = dig(summary, "drives", "current", default=None) or {}
        if isinstance(current, dict) and current.get("team") and not (
                current.get("result") or current.get("displayResult")):
            holder = str(dig(current, "team", "id", default="") or "")
    for side in ("away", "home"):
        if holder and holder == str(event[side].get("id")):
            return side
    return None


def football_timeout_marks(count, league, team, label=True, total=3, word="timeouts"):
    """A team's timeouts: ● each one left (in its colours), ○ each one used
    of `total` (football's three a half, basketball's for the game, hockey's
    one), then `word` when `label`."""
    style = THEME.style(league, team, bold=True, fallback="accent")
    line = Line()
    for index in range(max(total, count)):
        if index:
            line.add(" ", "normal")
        line.add("●" if index < count else "○", style if index < count else "dim")
    if label:
        line.add(f"  {word}", "muted")
    return line


def football_down_lines(event, league, summary=None):
    """DOWN & DISTANCE while a football game is on, three lines: the down and
    the distance in the dot font (GOAL spelled out), who has the ball and
    where, RED ZONE; between plays without a down (a kickoff, the half), what
    is happening and the last play."""
    situation = event.get("situation") or {}
    down, distance = situation.get("down"), situation.get("distance")
    text = clean(situation.get("downDistanceText") or "")
    side = football_possession(event, summary)
    team = event[side] if side else None
    style = THEME.style(league, team, bold=True, fallback="accent") if team else "bold"
    info = []
    if team:
        info.append(Line().add(f"{team.get('abbr', '')} ball", style))
    if isinstance(down, int) and 1 <= down <= 4 and text:
        goal = "goal" in text.lower()
        if not goal and not (isinstance(distance, int) and distance > 0):
            return []
        left = big_text(str(down), "small")
        right = big_text("GOAL" if goal else str(distance), "small", font=GOAL_FONT)
        middle = [{1: "ST", 2: "ND", 3: "RD", 4: "TH"}[down], "&", ""]
        spot = clean(situation.get("possessionText") or "")
        if spot:
            info.append(Line().add(f"on {spot}", "normal"))
        if situation.get("isRedZone"):
            info.append(Line().add("RED ZONE", "err"))
        rows = [Line().add(left[index], style).add(f" {middle[index]:<2} ", "bold")
                .add(right[index], style) for index in range(3)]
        wide = max(len(row.text) for row in rows)
        out = []
        for index, row in enumerate(rows):
            line = Line(list(row)).pad(wide)
            if index < len(info):
                line.add("   ", "normal").extend_spans(info[index])
            out.append(line)
        return out
    # no down: a kickoff, a try after a touchdown, the half
    detail = clean(event.get("detail") or "")
    out = [Line().add((detail or "Between plays").upper(), "bold")]
    out.extend(info[:1])
    last = clean(dig(situation, "lastPlay", "text", default=""))
    if last:
        out.extend(wrap_spans(football_play_text(last), 30, "dim")[:3 - len(out)])
    return out[:3]


def football_pace(event, points):
    """Where a football game's points are headed: the total so far over the
    minutes played, times sixty; None early (under eight minutes) or in
    overtime."""
    period = _int(event.get("period"))
    left = clock_seconds(event.get("clock") or "")
    if not 1 <= period <= 4 or left is None:
        return None
    played = (period - 1) * 15 + (15 - left / 60)
    if played < 8:
        return None
    return int(round(points * 60 / played))


def football_line_box(summary, event, league):
    """THE LINE: (title, lines) - the spread and the total from the book ESPN
    shows first (the one Settings picks, where it has it), and how the score
    stands against them: who is covering and where the points are headed
    while the game is on, who covered and whether it went over once it is
    over; the moneylines under them. (None, []) without a line."""
    if not (BETTING.enabled and league in BETTING_LEAGUES and summary):
        return None, []
    away, home = event["away"], event["home"]
    line = pick_line(summary.get("pickcenter") or [], away, home, BETTING.provider)
    if not line:
        return None, []
    done = event["state"] == "post"
    a, h = away.get("score"), home.get("score")
    scored = isinstance(a, int) and isinstance(h, int) and event["state"] != "pre"
    out = []
    label, favourite = line_label(line, event, league)
    if label:
        row = Line().add(label, THEME.style(league, favourite, bold=True, fallback="bold")
                         if favourite else "bold")
        spread = line.get("spread")
        if spread is not None and scored:
            edge = (h - a) + spread
            if edge == 0:
                row.add("  push", "dim")
            else:
                team = home if edge > 0 else away
                row.add("  ", "normal").add(team.get("abbr", ""), THEME.style(
                    league, team, bold=True, fallback="accent"))
                row.add(" covered" if done else " covering", "normal")
        out.append(row)
    total = line.get("total")
    if total is not None:
        row = Line().add(f"O/U {number_text(total)}", "bold")
        if scored:
            points = a + h
            if done:
                verdict = "over" if points > total else "under" if points < total else "push"
                row.add(f"  {points}, ", "normal").add(verdict, "accent")
            else:
                pace = football_pace(event, points)
                row.add(f"  {points} so far", "normal")
                if pace is not None:
                    row.add(f", pace {pace}", "dim")
        out.append(row)
    if line.get("away_ml") is not None and line.get("home_ml") is not None:
        out.append(Line().add(f"ML {away.get('abbr', '')} {money_text(line['away_ml'])}"
                              f" · {home.get('abbr', '')} {money_text(line['home_ml'])}",
                              "dim"))
    if not out:
        return None, []
    title = [("THE LINE", "title")] + ([(f"  {line['provider']}", "muted")]
                                       if line.get("provider") else [])
    return title, out[:3]


def football_swings(summary):
    """[(change in the home side's chance, play)] for every play that moved
    ESPN's win probability five points or more, the biggest first (timeouts
    and the ends of quarters skipped)."""
    probs = [p for p in dig(summary, "winprobability", default=[]) or []
             if isinstance(p.get("homeWinPercentage"), (int, float))]
    if len(probs) < 10:
        return []
    plays = {str(p.get("id")): p for p in game_plays(summary)}
    swings, base = [], probs[0]["homeWinPercentage"]
    for entry in probs[1:]:
        play = plays.get(str(entry.get("playId")))
        change = entry["homeWinPercentage"] - base
        base = entry["homeWinPercentage"]
        if play is None or BBALL_QUIET.search(clean(play.get("text") or "")):
            continue
        if abs(change) >= 0.05:
            swings.append((change, play))
    swings.sort(key=lambda item: -abs(item[0]))
    return swings


def football_play_box(summary, event, league):
    """BIGGEST PLAY: (title, render(width) -> lines) - the play that swung
    ESPN's win probability most: the team it helped on a chip in its colours,
    by how much, when, and the play; (None, None) without one."""
    swings = football_swings(summary)
    if not swings:
        return None, None
    change, play = swings[0]
    team = event["home"] if change > 0 else event["away"]

    def render(width):
        color = team_hex(league, team)
        head = Line().add(f" {team.get('abbr', '')} ", f"@{_ink_on(color)}:{color}~b")
        head.add(f" +{abs(change) * 100:.0f}%", "bold")
        number = _int(dig(play, "period", "number", default=0))
        if number:
            head.add(f"  {period_tag(league, number)} {bball_play_clock(play)}", "muted")
        return [fit_line(head, width)] + \
            wrap_spans(football_play_text(play.get("text")), width, "normal")[:2]
    return [("BIGGEST PLAY", "title"), ("  win probability", "muted")], render


def football_game_box(summary, event, league):
    """THE GAME: where it is played, the crowd and the weather, for the row's
    room when there is no line and no swing to show. (None, None) without
    any."""
    info = dig(summary, "gameInfo", default={}) or {}
    venue = clean(dig(info, "venue", "fullName", default="") or "")
    city = ", ".join(clean(dig(info, "venue", "address", key, default="") or "")
                     for key in ("city", "state")
                     if clean(dig(info, "venue", "address", key, default="") or ""))
    facts = []
    if venue:
        facts.append(venue + (f", {city}" if city else ""))
    crowd = info.get("attendance")
    weather = clean(dig(info, "weather", "displayValue", default="") or "")
    degrees = dig(info, "weather", "temperature")
    second = []
    if crowd:
        second.append(f"attendance {crowd:,}" if isinstance(crowd, int) else
                      f"attendance {crowd}")
    if weather or degrees is not None:
        second.append(", ".join(str(part) for part in (weather, f"{degrees}°" if degrees
                                                       is not None else "") if part))
    if second:
        facts.append(" · ".join(second))
    if event.get("broadcast"):
        facts.append(f"on {event['broadcast']}")
    if not facts:
        return None, None

    def render(width):
        out = []
        for fact in facts:
            out.extend(wrap_spans(fact, width, "normal" if not out else "dim"))
        return out[:3]
    return "THE GAME", render


FOOTBALL_ROW_FLEX = 30     # the narrowest BIGGEST PLAY or THE GAME goes


def football_top_row(summary, event, league, width, quarters, corners=None):
    """The row of cards over football's drive chart, side by side across
    `width`: BY QUARTER; while the game is on, DOWN & DISTANCE; THE LINE; and
    in the room left the BIGGEST PLAY (THE GAME without one). Whole cards
    only, the spare columns shared out. (rows, whether DOWN & DISTANCE is
    among them); ([], False) when nothing is there."""
    inner = max(3, len(quarters))
    fixed = []
    if quarters:
        fixed.append(("BY QUARTER", quarters))
    down = football_down_lines(event, league, summary) if event["state"] == "in" else []
    if down:
        fixed.append(("DOWN & DISTANCE", down))
    title, lines = football_line_box(summary, event, league)
    if lines:
        fixed.append((title, lines))
    if not fixed:
        return [], False

    def natural(card):
        head = card[0] if isinstance(card[0], str) else "".join(t for t, _ in card[0])
        return max([len(line.text) for line in card[1]] + [len(head) + 2]) + 4
    sizes = [natural(card) for card in fixed]
    while len(fixed) > 1 and sum(sizes) > width:
        fixed.pop()
        sizes.pop()
    spare = width - sum(sizes)
    flex = None
    for maker in (football_play_box, football_game_box):
        flex_title, render = maker(summary, event, league)
        if render and spare >= FOOTBALL_ROW_FLEX:
            flex = (flex_title, render)
            break
    cards = [(card[0], card[1], size) for card, size in zip(fixed, sizes)]
    if flex:
        cards.append((flex[0], flex[1](spare - 4), spare))
    elif spare > 0:
        share, rest = divmod(spare, len(cards))
        cards = [(t, body, size + share + (1 if index < rest else 0))
                 for index, (t, body, size) in enumerate(cards)]
    canvas = Canvas(width, inner + 2)
    x = 0
    for card_title, body, size in cards:
        canvas.card(0, x, inner + 2, size, card_title, [fit_line(line, size - 4)
                                                       for line in body[:inner]], corners)
        x += size
    return canvas.rows(), bool(down) and any(t == "DOWN & DISTANCE" for t, _, _ in cards)


def football_drive_lines(summary, league, width, by_id):
    drives = dig(summary, "drives", "previous", default=[]) or []
    if not drives:
        return []
    lines = []
    head = Line().add(f"{'Q':<3}{'team':<5}{'result':<15}{'plays':>5}{'yds':>5}"
                      f"{'time':>6}  start", "header")
    lines.append(head)
    for drive in drives:
        abbr = clean(dig(drive, "team", "abbreviation", default="")) or clean(
            dig(drive, "team", "shortDisplayName", default=""))
        side = next((c for c in by_id.values() if c["abbr"] == abbr), None)
        result = clean(drive.get("displayResult") or drive.get("result") or "")
        plays = drive.get("offensivePlays")
        yards = drive.get("yards")
        clock = clean(dig(drive, "timeElapsed", "displayValue", default=""))
        if plays is None or yards is None:
            found = re.match(r"(\d+) plays?, (-?\d+) yards?, ([\d:]+)",
                             clean(drive.get("description") or ""))
            if found:
                plays, yards, clock = found.group(1), found.group(2), found.group(3)
        quarter = period_tag(league, dig(drive, "start", "period", "number", default=""))
        start = clean(dig(drive, "start", "text", default=""))
        style = THEME.style(league, side) if side else "normal"
        scored = result.lower() in ("touchdown", "field goal", "td", "fg")
        row = Line().add(f"{quarter:<3}", "muted").add(f"{abbr:<5}", style)
        row.add(f"{result[:14]:<15}", "good" if scored else (
            "bad" if result.lower() in ("interception", "fumble", "downs", "safety",
                                        "blocked punt", "blocked fg", "missed fg")
            else "normal"))
        row.add(f"{plays if plays is not None else '':>5}{yards if yards is not None else '':>5}"
                f"{clock:>6}  ", "dim").add(start, "muted")
        lines.append(row)
    lines.append(blank())
    return lines


def plays_sections(lines, width, corners=None):
    """A Plays section's lines as titled subsections, boxes `width` wide (the
    lines made four narrower for them), in the style of the Game Stats
    boxes: a heading line (style "title", or one marking `section` - the
    game's strip) starts each box, its words the title upper case with any
    note after it kept, and the rule under a heading goes. Every line keeps
    what it carries (play_ref, play_first, click), so picking, the clips and
    the highlights work as before. Returns (lines, where): where[i] is the
    row the old line i is on now (none for the blank lines, headings and
    rules the boxes replace)."""
    tl, tr, bl, br = corners or ("╭", "╮", "╰", "╯")
    inner = max(1, width - 4)
    sections, current, after_head = [], None, False
    for index, line in enumerate(lines):
        mark = getattr(line, "section", None)
        if line and line[0][1] == "title" and line.text.strip():
            spans = [(text, style) for text, style in line if text.strip()]
            spans[0] = (spans[0][0].strip().upper(), spans[0][1])
            spans[1:] = [("  " + text.strip(), style) for text, style in spans[1:]]
            current = [spans, [], index]
            sections.append(current)
            after_head = True
            continue
        if after_head and line.text.strip() and set(line.text.strip()) == {"─"}:
            after_head = False
            continue
        after_head = False
        if mark:
            current = [[(str(mark).upper(), "title")], [], index]
            sections.append(current)
        elif current is None:
            current = [[], [], index]
            sections.append(current)
        current[1].append((index, line))
    out, where = [], {}

    def blank_row(line):
        # a row with a picture under it (the court, 7.0.0) is not blank
        return not line.text.strip() and getattr(line, "play_ref", None) is None and \
            not any(str(style).startswith("!u:") for _, style in line)
    for title, body, head in sections:
        while body and blank_row(body[0][1]):
            body.pop(0)
        while body and blank_row(body[-1][1]):
            body.pop()
        if not body:
            continue
        where[head] = len(out)
        top = Line().add(f"{tl}─", "subborder")
        used = 2
        if title:
            top.add(" ", "subborder")
            used += 1
            for text, style in title:
                piece = text[: max(0, width - used - 3)]
                if not piece:
                    break
                top.add(piece, style)
                used += len(piece)
            top.add(" ", "subborder")
            used += 1
        top.add("─" * max(0, width - used - 1) + tr, "subborder")
        out.append(top)
        for index, line in body:
            where[index] = len(out)
            boxed = Line().add("│ ", "subborder").extend_spans(fit_line(line, inner)) \
                .add(" │", "subborder")
            for name in ("play_ref", "play_first", "click"):
                if hasattr(line, name):
                    setattr(boxed, name, getattr(line, name))
            out.append(boxed)
        out.append(Line().add(bl + "─" * max(0, width - 2) + br, "subborder"))
    return out, where


def football_plays_panes(summary, league, width, event=None):
    """(left, right): the game's flow, scoring and win probability; drives,
    the biggest swings and officials."""
    away, home = summary_teams(summary)
    by_id = {t["id"]: t for t in (away, home) if t}
    left = game_strip(summary, league, width)
    if event:
        left.extend(bball_flow_lines(summary, event, league, width))
    left.extend(football_scoring_lines(summary, league, width, by_id))
    if away and home and event:
        chart = bball_win_prob_lines(summary, event, league, width, rows=5)
        left.extend(chart + [blank()] if chart else
                    winprob_chart(summary, away, home, league, width, height=7))
    elif away and home:
        left.extend(winprob_chart(summary, away, home, league, width, height=7))
    right = football_drive_lines(summary, league, width, by_id)
    if event:
        swings = football_swing_lines(summary, event, league, width)
        if swings:
            right.extend(swings + [blank()])
    officials = officials_text(summary)
    if officials:
        right.append(heading("Officials"))
        right.extend(wrap_spans(officials, width, "muted"))
    if len(left) <= 3 and not right:
        left.append(Line().add("Nothing published for this game yet.", "dim"))
    return left, right


def hockey_plays_panes(summary, league, width):
    """(left, right): goals and three stars; shots, penalties, officials."""
    away, home = summary_teams(summary)
    by_id = {t["id"]: t for t in (away, home) if t}
    lines = hockey_play_lines(summary, league, width, by_id, compact=True)
    left, right, target = game_strip(summary, league, width), [], None
    for line in lines:
        text = "".join(t for t, _ in line)
        if text in ("Shots on goal", "Penalties"):
            target = right
        elif text == "Three stars":
            target = left
        (target if target is not None else left).append(line)
    officials = officials_text(summary)
    if officials:
        right.append(heading("Officials"))
        right.extend(wrap_spans(officials, width, "muted"))
    if len(left) <= 3 and not right:
        left.append(Line().add("Nothing published for this game yet.", "dim"))
    return left, right


def render_plays(summary, league, width, favorites=None):
    lines = game_strip(summary, league, width)
    away, home = summary_teams(summary)
    by_id = {}
    if away:
        by_id[away["id"]] = away
    if home:
        by_id[home["id"]] = home

    info = dig(summary, "gameInfo", default={}) or {}
    facts = []
    venue = clean(dig(info, "venue", "fullName", default=""))
    city = clean(dig(info, "venue", "address", "city", default=""))
    state = clean(dig(info, "venue", "address", "state", default=""))
    if venue:
        place = ", ".join(part for part in (city, state) if part)
        facts.append(f"{venue}{' — ' + place if place else ''}")
    if info.get("attendance"):
        facts.append(f"attendance {info['attendance']:,}" if isinstance(
            info["attendance"], int) else f"attendance {info['attendance']}")
    weather = clean(dig(info, "weather", "displayValue", default=""))
    temperature = dig(info, "weather", "temperature")
    if weather:
        facts.append(f"{weather}{f', {temperature}°' if temperature else ''}")
    officials = [clean(dig(o, "displayName", default="")) for o in info.get("officials") or []]
    sport = sport_of(league)
