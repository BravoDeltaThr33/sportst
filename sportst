ESPN_ATHLETE = "https://site.web.api.espn.com/apis/common/v3/sports/{}/{}/athletes/{}"


def espn_basketball_profile(player_id, league, timeout=15):
    """An NBA or college player's card from ESPN: who he is, his season per
    game and his games, newest first."""
    base = ESPN_ATHLETE.format("basketball", LEAGUES[league]["path"],
                               urllib.parse.quote(str(player_id)))
    athlete = http_json(base, timeout).get("athlete") or {}
    try:
        log = http_json(base + "/gamelog", timeout)
    except Exception:  # noqa: BLE001 - the card shows what it has
        log = {}
    position = athlete.get("position") or {}
    profile = {
        "id": str(player_id), "sport": "basketball", "goalie": False,
        "name": clean(athlete.get("displayName") or ""),
        "jersey": clean(athlete.get("jersey") or ""),
        "position": clean(position.get("displayName") or ""),
        "age": athlete.get("age") if isinstance(athlete.get("age"), int) else None,
        "height": clean(athlete.get("displayHeight") or ""),
        "weight": clean(athlete.get("displayWeight") or ""), "hand": "",
        "born": birth_day(athlete.get("displayDOB")),
        "birthplace": clean(athlete.get("displayBirthPlace") or ""),
        "draft": clean(athlete.get("displayDraft") or ""),
        "experience": clean(athlete.get("displayExperience") or ""),
        "photo": clean(dig(athlete, "headshot", "href", default="") or ""),
        "url": next((clean(link.get("href") or "") for link in athlete.get("links") or []
                     if "playercard" in (link.get("rel") or [])), ""),
        "season_label": clean(dig(athlete, "statsSummary", "displayName", default="") or ""),
        "ranks": [], "totals": {}, "games": [],
    }
    for stat in dig(athlete, "statsSummary", "statistics", default=[]) or []:
        rank = stat.get("rank")
        if isinstance(rank, int) and 0 < rank <= 25:
            text = clean(stat.get("rankDisplayValue") or "").replace("Tied-", "T-")
            profile["ranks"].append((clean(stat.get("abbreviation") or ""), text))
    labels = [clean(label).upper() for label in log.get("labels") or []]
    seasons = log.get("seasonTypes") or []
    if labels and seasons:
        current, events = seasons[0], log.get("events") or {}
        for month in current.get("categories") or []:
            for entry in month.get("events") or []:
                game = events.get(str(entry.get("eventId"))) or {}
                stats = dict(zip(labels, [clean(s) for s in entry.get("stats") or []]))
                where = clean(game.get("atVs") or "")
                opponent = clean(dig(game, "opponent", "abbreviation", default="") or "")
                result = " ".join(part for part in (clean(game.get("gameResult") or ""),
                                                    clean(game.get("score") or "")) if part)
                profile["games"].append({"date": card_day(game.get("gameDate")),
                                         "opp": f"{where} {opponent}".strip(),
                                         "result": result, "stats": stats})
        if not profile["season_label"]:
            profile["season_label"] = clean(current.get("displayName") or "")
    games = profile["games"]
    if games:
        def per_game(key):
            values = [_number(g["stats"].get(key)) for g in games]
            values = [v for v in values if v is not None]
            return f"{sum(values) / len(values):.1f}" if values else ""

        def pct(key):
            made = attempted = 0
            for g in games:
                m, a = made_attempted(g["stats"].get(key))
                if m is not None:
                    made, attempted = made + m, attempted + a
            return f"{made / attempted * 100:.1f}" if attempted else ""
        profile["totals"] = {"GP": str(len(games)), "PPG": per_game("PTS"),
                             "RPG": per_game("REB"), "APG": per_game("AST"),
                             "FG%": pct("FG"), "3P%": pct("3PT"), "FT%": pct("FT"),
                             "SPG": per_game("STL"), "BPG": per_game("BLK"),
                             "MPG": per_game("MIN")}
    return profile

