def stat_number(key, text):
    """The number a bar is drawn from. '7-11' on 3rd down is a rate, '4-41'
    penalties is a count, '35:40' possession is seconds."""
    text = (text or "").strip()
    if not text or text in ("-", "--"):
        return None
    match = re.fullmatch(r"(\d+):(\d{2})", text)
    if match:
        return int(match.group(1)) * 60 + int(match.group(2))
    match = re.fullmatch(r"(-?\d+(?:\.\d+)?)\s*[-/]\s*(\d+(?:\.\d+)?)", text)
    if match:
        made, total = float(match.group(1)), float(match.group(2))
        if key.endswith("Eff") or key.endswith("Attempts") and "redZone" in key:
            return made / total if total else 0.0
        return made
    try:
        return float(text.rstrip("%"))
    except ValueError:
        return None


def team_stat_index(block):
    """{key: (label, value)} plus the order ESPN sent them in.

    Baseball nests its team stats under batting / pitching / fielding, so
    those keys are namespaced: 'batting.hits'."""
    out, order = {}, []
    for stat in block.get("statistics") or []:
        group = stat.get("stats")
        if isinstance(group, list) and group:
            section = stat.get("name") or ""
            for sub in group:
                name = sub.get("name")
                key = f"{section}.{name}"
                if not name or key in out:
                    continue
                label = clean(sub.get("shortDisplayName") or sub.get("displayName")
                              or name)
                order.append(key)
                out[key] = (label, clean(sub.get("displayValue") or ""))
            continue
        key = stat.get("name") or stat.get("label")
        if not key or key in out:
            continue
        order.append(key)
        out[key] = (clean(stat.get("label") or key), clean(stat.get("displayValue") or ""))
    return out, order


def stat_bar(share, width, left_style, right_style, left_char="▄", right_char="▄"):
    """One two-colour bar, left team's share first, split by a one-cell gap."""
    width = max(6, width)
    fill = width - 1
    left = int(round(share * fill)) if share is not None else fill // 2
    left = clamp(left, 0, fill)
    bar = Line()
    if left:
        pattern = (left_char * left)[:left]
        bar.add(pattern, left_style)
    bar.add(" ", "normal")
    if fill - left:
        bar.add(right_char * (fill - left), right_style)
    return bar


def team_stat_sections(summary, league, width):
    """(graphic lines, remaining-stats table lines), away team on the left as
    on ESPN's own page."""
    teams = dig(summary, "boxscore", "teams", default=[]) or []
    home_block, away_block = split_by_side(teams, summary)
    if home_block is None or away_block is None:
        return [Line().add("No team statistics published for this game yet.", "dim")], []
    away, home = block_team(away_block), block_team(home_block)
    left, left_order = team_stat_index(away_block)
    right, right_order = team_stat_index(home_block)
    keys = left_order + [k for k in right_order if k not in left]
    sport = LEAGUES[league]["sport"]
    wanted = [k for k in GRAPH_STATS.get(sport, []) if k in left or k in right]

    away_style = THEME.style(league, away, fallback="away")
    home_style = THEME.style(league, home, fallback="home")
    # two teams in near-identical colours (Georgia and Arkansas) get the
    # away side hatched, the way ESPN does it
    away_rgb = hex_to_rgb(THEME.color(league, away) or "") or (0, 0, 0)
    home_rgb = hex_to_rgb(THEME.color(league, home) or "") or (255, 255, 255)
    clash = color_distance(away_rgb, home_rgb) < 9000
    left_char = "▖▗" if clash else "▄"

    # one line a stat: label, away number, the two-colour bar, home number
    labels = {key: GRAPH_LABELS.get(key) or (left.get(key) or right.get(key))[0]
              for key in wanted}
    values = {key: (left.get(key, ("", "-"))[1] or "-", right.get(key, ("", "-"))[1] or "-")
              for key in wanted}
    label_w = min(18, max([len(v) for v in labels.values()] + [6]))
    value_w = max([max(len(a), len(h)) for a, h in values.values()] + [3])
    bar_width = clamp(width - label_w - 2 * value_w - 4, 12, 60)
    graph = []
    head = Line().add(f"{'':<{label_w}} ", "normal")
    head.add(f"{away['abbr'] or 'AWAY':>{value_w}} ",
             THEME.style(league, away, bold=True, fallback="away"))
    head.add(" " * bar_width, "normal")
    head.add(f" {home['abbr'] or 'HOME'}", THEME.style(league, home, bold=True, fallback="home"))
    graph.append(head)

    for key in wanted:
        a_text, h_text = values[key]
        a_num, h_num = stat_number(key, a_text), stat_number(key, h_text)
        share = None
        if a_num is not None and h_num is not None and (a_num + h_num) > 0:
            share = a_num / (a_num + h_num)
        row = Line().add(f"{labels[key][:label_w]:<{label_w}} ", "dim")
        row.add(f"{a_text:>{value_w}} ", "bold")
        if share is None and a_num == 0 and h_num == 0:
            bar = stat_bar(0.5, bar_width, "muted", "muted", "▄", "▄")
        else:
            bar = stat_bar(share, bar_width, away_style, home_style, left_char)
        row.extend_spans(bar)
        row.add(f" {h_text}", "bold")
        graph.append(row)
    if graph and not graph[-1]:
        graph.pop()

    allowed = MORE_STATS.get(sport)
    rest_keys = [k for k in keys if k not in wanted]
    if allowed:
        rest_keys = [k for k in allowed if (k in left or k in right) and k not in wanted]
    rest = []
    if rest_keys:
        rows = []
        for key in rest_keys:
            label = (left.get(key) or right.get(key))[0]
            rows.append([left.get(key, ("", "-"))[1] or "-", label,
                         right.get(key, ("", "-"))[1] or "-"])
        rest.append(Line().add("More team stats", "title"))
        table = build_table([away["abbr"] or "A", "", home["abbr"] or "B"], rows,
                            aligns=[">", "^", "<"], sep="   ")
        if table:
            head = table[0]
            rebuilt = Line()
            rebuilt.add(head[0][0], THEME.style(league, away, bold=True, fallback="header"))
            for text, _ in head[1:-1]:
                rebuilt.add(text, "header")
            rebuilt.add(head[-1][0], THEME.style(league, home, bold=True, fallback="header"))
            table[0] = rebuilt
        rest.extend(table)
    return graph, rest


BASEBALL_LEADERS = [
    ("batting", "Hitting", ["H", "AB", "R", "RBI", "HR", "BB", "K"], "H",
     ["H", "RBI", "HR"]),
    ("pitching", "Pitching", ["IP", "H", "R", "ER", "BB", "K", "ERA"], "K",
     ["IP", "K", "ERA"]),
]


def _stat_cell(labels, stats, want):
    for label, value in zip(labels, stats):
        if label == want:
            return value
    return ""


def render_baseball_leaders(summary, league, width, heading=True):
    """ESPN publishes no leaders block for baseball, so the best hitter and
    pitcher on each side come out of the box score."""
    blocks = dig(summary, "boxscore", "players", default=[]) or []
    if not blocks:
        return []
    home_block, away_block = split_by_side(blocks, summary)
    ordered = [b for b in (away_block, home_block) if b is not None]
    known = {t["id"]: t for t in summary_teams(summary) if t}
    lines = [Line().add("Game leaders", "title"), rule(clamp(width, 20, 72))] \
        if heading else []
    for kind, title, _cols, sort_by, show in BASEBALL_LEADERS:
        rows = []
        for block in ordered:
            team = known.get(block_team(block)["id"]) or block_team(block)
            section = next((x for x in block.get("statistics") or []
                            if (x.get("type") or x.get("name")) == kind), None)
            if not section:
                continue
            labels = [clean(l) for l in (section.get("labels") or [])]
            best, best_value = None, None
            for entry in section.get("athletes") or []:
                stats = [clean(v) for v in (entry.get("stats") or [])]
                if not stats:
                    continue
                raw = _stat_cell(labels, stats, sort_by)
                try:
                    value = float(str(raw).split("-")[0] or 0)
                except ValueError:
                    value = 0.0
                if kind == "pitching" and not entry.get("starter"):
                    value -= 0.001  # a starter wins ties over a reliever
                if best_value is None or value > best_value:
                    best, best_value = (entry, labels, stats), value
            if best:
                rows.append((team, best))
        if not rows:
            continue
        lines.append(Line().add(title, "accent"))
        for team, (entry, labels, stats) in rows:
            name = clean(dig(entry, "athlete", "shortName", default="")
                         or dig(entry, "athlete", "displayName", default="?"))
            position = clean(dig(entry, "athlete", "position", "abbreviation",
                                 default=""))
            row = Line().add("  ")
            row.add(f"{team['abbr']:<5}", THEME.style(league, team, bold=True,
                                                      fallback="accent"))
            row.add(f"{(name + ' ' + position).strip()[:22]:<23}", "normal")
            for want in show:
                value = _stat_cell(labels, stats, want)
                row.add(f"{value:>6} ", "bold").add(f"{want:<4}", "muted")
            lines.append(row)
        lines.append(blank())
    if lines and not lines[-1]:
        lines.pop()
    return lines


def leader_data(summary, league):
    """The game's leaders as (away team, home team, [(category, {"away":
    (name, number, the rest of his line), "home": ...})]): ESPN's leaders, or
    for baseball the best hitter and pitcher on each side from the box score."""
    away, home = summary_teams(summary)
    rows = []
    if is_baseball(league):
        blocks = dig(summary, "boxscore", "players", default=[]) or []
        home_block, away_block = split_by_side(blocks, summary)
        for kind, title, _cols, sort_by, show in BASEBALL_LEADERS:
            cells = {}
            for side, block in (("away", away_block), ("home", home_block)):
                section = next((x for x in (block or {}).get("statistics") or []
                                if (x.get("type") or x.get("name")) == kind), None)
                if not section:
                    continue
                labels = [clean(label) for label in section.get("labels") or []]
                best, best_value = None, None
                for entry in section.get("athletes") or []:
                    stats = [clean(value) for value in entry.get("stats") or []]
                    if not stats:
                        continue
                    try:
                        value = float(str(_stat_cell(labels, stats, sort_by)).split("-")[0]
                                      or 0)
                    except ValueError:
                        value = 0.0
                    if kind == "pitching" and not entry.get("starter"):
                        value -= 0.001          # a starter wins ties over a reliever
                    if best_value is None or value > best_value:
                        best, best_value = (entry, labels, stats), value
                if best:
                    entry, labels, stats = best
                    name = clean(dig(entry, "athlete", "shortName", default="")
                                 or dig(entry, "athlete", "displayName", default="?"))
                    pairs = [f"{_stat_cell(labels, stats, want)} {want}" for want in show]
                    cells[side] = (name, pairs[0] if pairs else "", ", ".join(pairs[1:]))
            if cells:
                rows.append((title, cells))
        return away, home, rows
    blocks = dig(summary, "leaders", default=[]) or []
    home_block, away_block = split_by_side(blocks, summary)
    ordered = [(side, block) for side, block in (("away", away_block), ("home", home_block))
               if block is not None]
    categories = []
    for _, block in ordered:
        for category in block.get("leaders") or []:
            name = category.get("name") or category.get("displayName")
            if name and name not in categories:
                categories.append(name)
    for name in categories:
        cells, title = {}, ""
        for side, block in ordered:
            entry = next((c for c in block.get("leaders") or []
                          if (c.get("name") or c.get("displayName")) == name), None)
            if not entry:
                continue
            title = title or clean(entry.get("displayName") or name)
            top = (entry.get("leaders") or [None])[0]
            if not top:
                continue
            athlete = clean(dig(top, "athlete", "shortName", default="")
                            or dig(top, "athlete", "displayName", default="?"))
            main = top.get("mainStat") or {}
            value = clean(str(main.get("value") or "")) or clean(top.get("displayValue") or "")
            unit = clean(main.get("label") or "") if main else ""
            detail = clean(top.get("summary") or "")
            if not main and "," in value:       # the older shape: '20/27, 212 YDS, 1 TD'
                detail, value = value, ""
            cells[side] = (athlete, f"{value} {unit}".strip(), detail)
        if cells:
            rows.append((title, cells))
    return away, home, rows


def leader_cell(cell, width):
    """One leader in `width` columns: his name, his number, then what else he
    did, cut where the room ends."""
    line = Line()
    used = 0
    for text, style in zip(cell or (), ("normal", "bold", "dim")):
        if not text:
            continue
        piece = (" " if used else "") + text
        if used + len(piece) > width:
            if width - used > 3:
                piece = cut_text(piece, width - used)
                line.add(piece, style)
                used += len(piece)
            break
        line.add(piece, style)
        used += len(piece)
    return line.pad(width)


def leader_table(summary, league, width):
    """GAME LEADERS as one table: a category a row, the away team's leader
    beside the home team's; a category over its two leaders when the width
    cannot hold both side by side."""
    away, home, rows = leader_data(summary, league)
    if not rows:
        return []
    teams = {"away": away or {}, "home": home or {}}
    # "Passing Yards" says no more than "Passing" beside 247 YDS
    rows = [(re.sub(r"\s+Yards$", "", title), cells) for title, cells in rows]
    label_w = min(17, max(len(title) for title, _ in rows) + 2)
    lines = []
    if width - label_w >= 2 * 24 + 2:
        cell_w = (width - label_w - 2) // 2
        head = Line().add(" " * label_w, "normal")
        for side in ("away", "home"):
            team = teams[side]
            if side == "home":
                head.add("  ", "normal")
            head.add(f"{team.get('abbr', '')[:cell_w]:<{cell_w}}",
                     THEME.style(league, team, bold=True, fallback="accent"))
        lines.append(head)
        for title, cells in rows:
            line = Line().add(f"{title[:label_w - 1]:<{label_w}}", "accent")
            line.extend_spans(leader_cell(cells.get("away"), cell_w))
            line.add("  ", "normal").extend_spans(leader_cell(cells.get("home"), cell_w))
            lines.append(line)
        return lines
    for title, cells in rows:
        lines.append(Line().add(title, "accent"))
        for side in ("away", "home"):
            if side in cells:
                team = teams[side]
                line = Line().add(f"{team.get('abbr', ''):<5}",
                                  THEME.style(league, team, bold=True, fallback="accent"))
                lines.append(line.extend_spans(leader_cell(cells[side], max(1, width - 5))))
    return lines


def team_stat_extras(summary, league):
    """The team numbers the bars leave out: (away, home, [(label, away value,
    home value)]), as team_stat_sections picks them."""
    teams = dig(summary, "boxscore", "teams", default=[]) or []
    home_block, away_block = split_by_side(teams, summary)
    if home_block is None or away_block is None:
        return None, None, []
    left, left_order = team_stat_index(away_block)
    right, right_order = team_stat_index(home_block)
    keys = left_order + [key for key in right_order if key not in left]
    sport = LEAGUES[league]["sport"]
    wanted = [key for key in GRAPH_STATS.get(sport, []) if key in left or key in right]
    rest = [key for key in keys if key not in wanted]
    if MORE_STATS.get(sport):
        rest = [key for key in MORE_STATS[sport] if (key in left or key in right)
                and key not in wanted]
    rows = [((left.get(key) or right.get(key))[0], left.get(key, ("", "-"))[1] or "-",
             right.get(key, ("", "-"))[1] or "-") for key in rest]
    return block_team(away_block), block_team(home_block), rows


def more_stats_lines(summary, league, width):
    """MORE TEAM STATS: the away team's number, what it is, the home team's -
    in as many columns side by side as the width holds (up to four, three
    rows a column at least; a long name shortened to fit), else one."""
    away, home, rows = team_stat_extras(summary, league)
    if not rows:
        return []
    away, home = away or {}, home or {}
    value_w = max([3] + [max(len(a), len(h)) for _, a, h in rows])
    longest = max(len(label) for label, _, _ in rows)
    gap = 3
    columns, label_w = 1, min(longest, max(8, width - 2 * value_w - 4))
    for count in (4, 3, 2):
        room = min(longest, (width - gap * (count - 1)) // count - 2 * value_w - 4)
        if len(rows) >= 3 * count and room >= min(longest, 20):
            columns, label_w = count, room
            break
    per = -(-len(rows) // columns)
    away_style = THEME.style(league, away, bold=True, fallback="header")
    home_style = THEME.style(league, home, bold=True, fallback="header")
    lines = []
    for row in range(per + 1):
        line = Line()
        for column in range(columns):
            if column:
                line.add(" " * gap, "normal")
            if row == 0:
                line.add(f"{away.get('abbr') or 'A':>{value_w}}", away_style)
                line.add(" " * (label_w + 4), "normal")
                line.add(f"{home.get('abbr') or 'B':<{value_w}}", home_style)
                continue
            index = column * per + row - 1
            if index >= len(rows):
                line.add(" " * (2 * value_w + label_w + 4), "normal")
                continue
            label, a, h = rows[index]
            line.add(f"{a:>{value_w}}", "bold")
            line.add(f"  {cut_text(label, label_w):^{label_w}}  ", "dim")
            line.add(f"{h:<{value_w}}", "bold")
        lines.append(line)
    return lines


def block_parts(lines):
    """(title spans, body) from a block whose first line is its heading (the
    title upper case, any note after it kept, the padding after it dropped);
    (None, lines) without one."""
    lines = list(lines or [])
    if lines and lines[0] and lines[0][0][1] == "title":
        head = list(lines[0])
        head[0] = (head[0][0].upper(), "title")
        while head and not head[-1][0].strip():
            head.pop()
        if head:
            head[-1] = (head[-1][0].rstrip(), head[-1][1])
        return head, lines[1:]
    return None, lines


def stat_block(render, title=None, wide=False, flex=False, move=True, optional=False):
    """A part of the Game Stats tab: render(width) gives its lines (its
    heading first, unless `title` names it); `wide` keeps it on a row of its
    own, `flex` lets it narrow to sit beside another (text that wraps), `move`
    lets it cross to the other section to even them out, `optional` leaves it
    out when the screen would scroll with it and not without (6.22.0) - a
    number says which goes first, the highest (7.0.0)."""
    return {"render": render, "title": title, "wide": wide, "flex": flex, "move": move,
            "optional": optional}


def block_body(block, width):
    """(title spans, body lines) of a block at `width`."""
    lines = block["render"](max(8, width))
    if block["title"] is not None:
        return block["title"], list(lines or [])
    return block_parts(lines)


PACK_FLEX = 26            # the narrowest a flexible part goes beside another


def pack_blocks(blocks, width, corners=None):
    """A section's parts as titled boxes packed in rows across `width`: a row
    starts with the next part and takes any later one that fits beside it (a
    flexible one narrowing to the room left), the spare columns are shared
    out, each row is as tall as its tallest box and every box stretches to
    it. Lines `width` wide."""
    width = max(12, width)
    sized = []
    for block in blocks:
        title, body = block_body(block, width - 4)
        if not body:
            continue
        natural = max([len(line.text.rstrip()) for line in body] +
                      [len("".join(text for text, _ in title or [])) + 2]) + 4
        sized.append((block, width if block["wide"] else min(width, natural)))
    rows = []
    while sized:
        block, natural = sized.pop(0)
        row, used = [(block, natural)], natural
        if not block["wide"]:
            for item in list(sized):
                other, other_w = item
                room = width - used - 1
                if other["wide"]:
                    continue
                if other_w <= room or (other["flex"] and room >= PACK_FLEX + 4):
                    row.append((other, min(other_w, room)))
                    used += 1 + min(other_w, room)
                    sized.remove(item)
        rows.append(row)
    placed = []
    for row in rows:
        widths = [natural for _, natural in row]
        spare = width - sum(widths) - (len(row) - 1)
        for index in range(len(widths)):
            widths[index] += spare // len(widths) + (1 if index < spare % len(widths) else 0)
        boxes = [block_body(block, box_w - 4) for (block, _), box_w in zip(row, widths)]
        placed.append((widths, boxes, max(len(body) for _, body in boxes) + 2))
    if not placed:
        return []
    canvas = Canvas(width, sum(height for _, _, height in placed))
    y = 0
    for widths, boxes, height in placed:
        x = 0
        for box_w, (title, body) in zip(widths, boxes):
            canvas.card(y, x, height, box_w, title or "", body, corners, border="subborder")
            x += box_w + 1
        y += height
    return canvas.rows()


def balance_blocks(left, right, width, corners=None):
    """The left and right sections packed, the movable parts at the end of the
    taller one handed to the shorter while that makes the taller shorter."""
    # 7.0.0: a part with nothing to show for this game is no part - left at the
    # end of a side it stopped the evening out
    left = [b for b in left if b["render"](max(8, width - 4))]
    right = [b for b in right if b["render"](max(8, width - 4))]
    packed = [pack_blocks(left, width, corners), pack_blocks(right, width, corners)]
    # where the parts crossing to each side go in: after its own, in the order
    # they had, so two that cross keep reading top to bottom (7.0.0)
    landing = [len(left), len(right)]
    for _ in range(6):
        tall = 0 if len(packed[0]) > len(packed[1]) else 1
        sides = [left, right]
        if len(sides[tall]) < 2:
            break
        best = None
        # 7.0.0: the last movable part first, then the ones before it (never the
        # first two, nor past one that stays), so a narrow part sitting beside
        # another does not stop the evening out
        for index in range(len(sides[tall]) - 1, 1, -1):
            if not sides[tall][index]["move"]:
                break
            trial = [list(sides[0]), list(sides[1])]
            trial[1 - tall].insert(landing[1 - tall], trial[tall].pop(index))
            repacked = [pack_blocks(trial[0], width, corners),
                        pack_blocks(trial[1], width, corners)]
            if max(len(repacked[0]), len(repacked[1])) < max(len(packed[0]), len(packed[1])):
                best = (trial, repacked, index)
                break
        if best is None:
            break
        (left, right), packed, index = best
        if index < landing[tall]:
            landing[tall] -= 1
    return packed[0], packed[1]


def football_box_totals(summary):
    """Each side's team totals in the box score, by category and column:
    {'away': {'defensive': {'SACKS': '3', ...}, ...}, 'home': {...}}
    (6.22.0)."""
    out = {"away": {}, "home": {}}
    players = dig(summary, "boxscore", "players", default=[]) or []
    if not players:
        return out
    home_block, away_block = split_by_side(players, summary)
    for side, block in (("away", away_block), ("home", home_block)):
        for category in (block or {}).get("statistics") or []:
            labels = category.get("labels") or []
            totals = category.get("totals") or []
            if category.get("name") and labels and totals:
                out[side][category["name"]] = {
                    str(label): clean(str(value)) for label, value in zip(labels, totals)}
    return out


def _box_value(totals, side, category, label):
    """A side's total in a box score column as a number; None when the
    category or the column is missing or not a number."""
    return _num((totals.get(side, {}).get(category) or {}).get(label))


def _box_text(number, digits=0):
    """A box score number as the screen shows it: '—' for none."""
    if number is None:
        return "—"
    return f"{number:.{digits}f}" if digits else f"{number:.0f}"


def _box_row(label, a, h, higher=True, digits=0, shown=None):
    """A compare row from two numbers (either may be None); no row at all
    when neither side has one. shown: the texts, when they are not the
    numbers themselves."""
    if a is None and h is None:
        return None
    a_text, h_text = shown if shown else (_box_text(a, digits), _box_text(h, digits))
    return (label, a_text, h_text, _better(a, h, higher) if higher is not None else None)


def football_defense(summary, event, league, width, totals=None):
    """The defenses side by side (6.22.0): sacks, tackles for loss, QB hurries
    or hits, passes defended and defensive touchdowns - whichever the team
    stats above (ESPN's) do not already show."""
    totals = totals if totals is not None else football_box_totals(summary)
    shown = set()
    for stats in football_team_stats(summary).values():
        shown |= set(stats)
    rows = []

    def add(label, column, higher=True):
        rows.append(_box_row(label, _box_value(totals, "away", "defensive", column),
                             _box_value(totals, "home", "defensive", column), higher))
    if "sacksYardsLost" not in shown:
        add("Sacks", "SACKS")
    add("Tackles for loss", "TFL")
    labels = set((totals["away"].get("defensive") or {})) | \
        set((totals["home"].get("defensive") or {}))
    if "QB HUR" in labels:
        add("QB hurries", "QB HUR")
    if "QB HTS" in labels:
        add("QB hits", "QB HTS")
    add("Passes defended", "PD")
    if "defensiveTouchdowns" not in shown:
        add("Defensive TDs", "TD")
    rows = [row for row in rows if row]
    if not rows:
        return []
    return football_compare("Defense", "", rows, event, league, width)


def football_special_teams(summary, event, league, width, totals=None):
    """The kicking game side by side (6.22.0): extra points (when one was
    missed), the punts' average and how many ended inside the 20, and the
    returns (how many and the yards)."""
    totals = totals if totals is not None else football_box_totals(summary)
    rows = []
    kicks = [(totals[side].get("kicking") or {}).get("XP") for side in ("away", "home")]
    made = [made_attempted((text or "").replace("/", "-")) for text in kicks]
    if any(a and m is not None and m < a for m, a in made):
        # only when one was missed: a perfect day adds nothing to the touchdowns
        rows.append(("Extra points", *[f"{m}/{a}" if a else "—" for m, a in made], None))
    punts = [_box_value(totals, side, "punting", "NO") for side in ("away", "home")]
    average = [_box_value(totals, side, "punting", "AVG") if punts[i] else None
               for i, side in enumerate(("away", "home"))]
    rows.append(_box_row("Punt average", *average, digits=1))
    inside = [_box_value(totals, side, "punting", "In 20") if punts[i] is not None else None
              for i, side in enumerate(("away", "home"))]
    rows.append(_box_row("Punts inside 20", *inside))
    for label, category in (("Kick returns", "kickReturns"), ("Punt returns", "puntReturns")):
        counts = [_box_value(totals, side, category, "NO") for side in ("away", "home")]
        yards = [_box_value(totals, side, category, "YDS") for side in ("away", "home")]
        texts = [f"{c:.0f}-{y:.0f}" if c and y is not None else ("0" if c == 0 else "—")
                 for c, y in zip(counts, yards)]
        if any(c for c in counts):
            # the arrow: the better average, as the count is the other side's kicks
            avg = [y / c if c and y is not None else None for c, y in zip(counts, yards)]
            rows.append((label, texts[0], texts[1], _better(avg[0], avg[1])))
    rows = [row for row in rows if row]
    if not rows:
        return []
    return football_compare("Special teams", "", rows, event, league, width)


def football_longest(summary, event, league, width, totals=None):
    """Each side's longest pass, run, return, field goal and punt (6.22.0),
    in as many column groups as fit across `width`."""
    totals = totals if totals is not None else football_box_totals(summary)

    def count(side, category, column):
        text = (totals.get(side, {}).get(category) or {}).get(column)
        if text and "/" in text:              # a kicker's 2/3: the made ones
            return made_attempted(text.replace("/", "-"))[0]
        return _num(text)

    def longest(side, *places):
        found = [_box_value(totals, side, category, "LONG") for category, column in places
                 if count(side, category, column)]
        found = [value for value in found if value is not None]
        return max(found) if found else None
    rows = []
    for label, places in (("Pass", [("receiving", "REC")]), ("Run", [("rushing", "CAR")]),
                          ("Return", [("kickReturns", "NO"), ("puntReturns", "NO")]),
                          ("Field goal", [("kicking", "FG")]),
                          ("Punt", [("punting", "NO")])):
        rows.append(_box_row(label, longest("away", *places), longest("home", *places)))
    rows = [row for row in rows if row]
    if not rows:
        return []
    single = football_compare("Longest", "", rows, event, league, width)
    natural = max(len(line.text.rstrip()) for line in single[1:])
    groups = max(1, min(len(rows), (width + 6) // (natural + 6)))
    if groups < 2:
        return single
    per = -(-len(rows) // groups)
    chunks = [rows[at:at + per] for at in range(0, len(rows), per)]
    blocks = [[trim_line(line) for line in
               football_compare("Longest", "", chunk, event, league, natural)[1:]]
              for chunk in chunks]
    return single[:1] + side_by_side(blocks, width, gap=6)


def bball_box_players(summary):
    """Each side's players who played, from the box score (6.22.0):
    {'away': [...], 'home': [...]}, a player {'name', 'short', 'starter',
    'stats': {column: text}}."""
    out = {"away": [], "home": []}
    players = dig(summary, "boxscore", "players", default=[]) or []
    if not players:
        return out
    home_block, away_block = split_by_side(players, summary)
    for side, block in (("away", away_block), ("home", home_block)):
        categories = (block or {}).get("statistics") or []
        if not categories:
            continue
        category = categories[0]
        labels = category.get("labels") or category.get("names") or []
        for athlete in category.get("athletes") or []:
            stats = athlete.get("stats") or []
            if athlete.get("didNotPlay") or not stats:
                continue
            name = clean(dig(athlete, "athlete", "displayName", default="") or "")
            short = clean(dig(athlete, "athlete", "shortName", default="") or "") or \
                short_name(name)
            out[side].append({"name": name, "short": short,
                              "starter": bool(athlete.get("starter")),
                              "stats": dict(zip(labels, (clean(str(v)) for v in stats)))})
    return out


def _made(text):
    """The made half of '7-12' (or a plain number); None when there is none."""
    made, _ = made_attempted(text)
    return made if made is not None else _num(text)


def team_columns_table(title, columns, event, league, width, align=">", note=None):
    """A small table a team a row, as By quarter is (6.22.0): `columns`
    [(header, away text, home text, the side whose number is better or
    None)], the better one bold; as many columns as fit across `width`, the
    later ones going first. `note` follows the title, muted (7.0.0)."""
    away, home = event["away"], event["home"]
    label_w = max(len(away["abbr"]), len(home["abbr"])) + 2
    sized = []
    for header, a, h, better in columns:
        sized.append((header, a, h, better, max(len(header), len(a), len(h))))
    while sized and label_w + sum(w + 3 for *_, w in sized) - 3 > width:
        sized.pop()
    if not sized:
        return []
    head = Line().add(" " * label_w, "normal")
    for index, (header, *_rest, w) in enumerate(sized):
        head.add(("   " if index else "") + f"{header:{align}{w}}", "header")
    lines = [heading(title), head]
    if note:
        lines[0].add(f"  {note}", "muted")
    for side, team in (("away", away), ("home", home)):
        line = Line().add(f"{team['abbr']:<{label_w}}",
                          THEME.style(league, team, bold=True, fallback=side))
        for index, (header, a, h, better, w) in enumerate(sized):
            text = a if side == "away" else h
            line.add(("   " if index else "") + f"{text:{align}{w}}",
                     "bold" if better == side else "normal")
        lines.append(line)
    return lines


def bball_depth_lines(summary, event, league, width, players=None):
    """BENCH AND DEPTH (6.22.0), a team a row: the bench's points and
    rebounds, how many scored, how many reached double figures and a
    double-double, and how many fouled out - none of it shown elsewhere on
    the Game Stats tab."""
    players = players if players is not None else bball_box_players(summary)
    if not players["away"] or not players["home"]:
        return []

    def total(side, column):
        values = [_num(p["stats"].get(column)) for p in players[side] if not p["starter"]]
        return sum(v for v in values if v is not None)

    def count(side, test):
        return sum(1 for p in players[side] if test(p["stats"]))

    def double(stats):
        return sum(1 for column in ("PTS", "REB", "AST", "STL", "BLK")
                   if (_num(stats.get(column)) or 0) >= 10) >= 2
    limit = 5 if league in COLLEGE_LEAGUES or league == "wcbb" else 6
    # the bench's points only where How the points came has not shown them
    shown = set()
    for stats in football_team_stats(summary).values():
        shown |= set(stats)
    columns = []
    for header, values, higher in (
            ("Bench pts", [total(side, "PTS") for side in ("away", "home")], True),
            ("Bench reb", [total(side, "REB") for side in ("away", "home")], True),
            ("Scored", [count(side, lambda st: (_num(st.get("PTS")) or 0) > 0)
                        for side in ("away", "home")], True),
            ("10+ pts", [count(side, lambda st: (_num(st.get("PTS")) or 0) >= 10)
                         for side in ("away", "home")], True),
            ("Dbl-dbl", [count(side, double) for side in ("away", "home")], True),
            ("Fouled out", [count(side, lambda st: (_num(st.get("PF")) or 0) >= limit)
                            for side in ("away", "home")], False)):
        if (header == "Fouled out" and not any(values)) or \
                (header == "Bench pts" and "benchPoints" in shown):
            continue
        columns.append((header, f"{values[0]:.0f}", f"{values[1]:.0f}",
                        _better(values[0], values[1], higher)))
    return team_columns_table("Bench and depth", columns, event, league, width)


def bball_more_leaders(summary, event, league, width, players=None):
    """MORE LEADERS (6.22.0), a team a row: each side's best at what GAME
    LEADERS leaves out - steals, blocks, threes, free throws, plus-minus (the
    NBA) and minutes - as many as fit."""
    players = players if players is not None else bball_box_players(summary)
    if not players["away"] and not players["home"]:
        return []
    columns = []
    for header, column in (("Steals", "STL"), ("Blocks", "BLK"), ("Threes", "3PT"),
                           ("Free throws", "FT"), ("Plus-minus", "+/-"),
                           ("Minutes", "MIN")):
        cells, numbers = [], []
        for side in ("away", "home"):
            best, value = None, None
            for player in players[side]:
                number = _made(player["stats"].get(column))
                if number is not None and number > 0 and (value is None or number > value):
                    best, value = player, number
            shown = (best["stats"].get(column) or "") if best else ""
            if best and column == "+/-" and not shown.startswith(("+", "-")):
                shown = "+" + shown
            name = best["short"] if best else ""
            cells.append(f"{cut_text(name, 16)} {shown}".strip() if best else "—")
            numbers.append(value)
        if any(n is not None for n in numbers):
            columns.append((header, cells[0], cells[1], None))
    return team_columns_table("More leaders", columns, event, league, width, align="<")


def hockey_box_players(summary):
    """Each side's skaters who played, from the box score's forwards, defence
    and skaters (7.0.0): {'away': [...], 'home': [...]}, a skater {'name',
    'short', 'stats': {column: text}}."""
