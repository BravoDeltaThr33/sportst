# college softball's (7.0.0): the four NCAA.com keeps for it
NCAA_SOFTBALL = [("avg", 281, "BA"), ("era", 282, "ERA"), ("fld", 283, "PCT"),
                 ("rpg", 284, "PG")]
NCAA_BASEBALL = [("avg", 210, "BA"), ("era", 211, "ERA"), ("fld", 212, "PCT"),
                 ("rpg", 213, "PG"), ("hrpg", 323, "PG"), ("slg", 327, "SLG PCT"),
                 ("obp", 589, "PCT"), ("whip", 597, "WHIP")]


def disk_cached(name, max_age, build):
    """build() once per max_age seconds, kept as JSON in the cache folder so a
    slow source is not re-read every time the app starts."""
    path = os.path.join(CACHE_DIR, name)
    try:
        if time.time() - os.path.getmtime(path) < max_age:
            with open(path, encoding="utf-8") as handle:
                return json.load(handle)
    except (OSError, ValueError):
        pass
    data = build()
    if data:
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(path + ".tmp", "w", encoding="utf-8") as handle:
                json.dump(data, handle)
            os.replace(path + ".tmp", path)
        except OSError:
            pass
    return data


def ncaa_extras(timeout=15, sport="baseball"):
    """College baseball (or softball, 7.0.0) team stats from the NCAA API,
    keyed by school name. NCAA.com is read a page at a time, so the result
    is kept on disk for 12h."""
    return disk_cached(f"ncaa-{sport}-stats.json", 12 * 3600,
                       lambda: _ncaa_extras(timeout, sport))


def _ncaa_extras(timeout=15, sport="baseball"):
    out = {}
    for key, stat_id, column in (NCAA_SOFTBALL if sport == "softball" else NCAA_BASEBALL):
        page, pages = 1, 1
        while page <= pages and page <= 8:
            try:
                data = http_json(f"{NCAA_API}/stats/{sport}/d1/current/team/{stat_id}"
                                 f"?page={page}", timeout)
            except Exception:  # noqa: BLE001 - a missing page leaves a gap
                break
            pages = _int(data.get("pages"), 1)
            for row in data.get("data") or []:
                name = norm_name(re.sub(r"\s*\(.*?\)", "", row.get("Team") or ""))
                out.setdefault(name, {})[key] = _num(row.get(column))
            page += 1
            time.sleep(0.25)       # the API asks for a few requests a second at most
    return out


def ncaa_baseball_poll(timeout=15):
    """The D1Baseball.com Top 25, from NCAA.com (ESPN publishes no college
    baseball poll): {normalised school name: rank}."""
    data = http_json(f"{NCAA_API}/rankings/baseball/d1/d1baseballcom-top-25", timeout)
    out = {}
    for row in data.get("data") or []:
        rank = _int(row.get("RANK"), 0)
        if 0 < rank <= 25:
            out[norm_name(re.sub(r"\s*\(.*?\)", "", row.get("TEAM") or ""))] = rank
    return {"ranks": out, "title": data.get("title"), "updated": data.get("updated")}


