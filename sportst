def make_parser():
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Terminal scoreboard for the NFL, college football, the NBA, "
                    "men's college basketball, the NHL, the AHL, MLB, college baseball, "
                    "and the Winter and Summer Olympics.",
        epilog="Run with no arguments for the full-screen interface.",
    )
    parser.add_argument("-L", "--league", choices=LEAGUE_ORDER,
                        help="league to open: " + ", ".join(LEAGUE_ORDER) +
                             " (owg / osg are the Winter / Summer Olympics)")
    parser.add_argument("-E", "--event", metavar="SPORT",
                        help="Olympic sport to open, e.g. hockey-m, alpine-skiing, "
                             "athletics, basketball-w (see --list-events)")
    parser.add_argument("--games", type=int, metavar="YEAR",
                        help="which Olympic Games, e.g. 2024 or 2026")
    parser.add_argument("--list-events", action="store_true",
                        help="list the Olympic sports of -L owg or -L osg and exit")
    parser.add_argument("--medals", action="store_true",
                        help="print the Olympic medal table (with -L owg or osg) and exit")
    parser.add_argument("-d", "--date", help="date as YYYY-MM-DD (one-shot modes and NHL)")
    parser.add_argument("-w", "--week", type=int, help="football week number")
    parser.add_argument("--seasontype", type=int, choices=[1, 2, 3],
                        help="1 preseason, 2 regular, 3 postseason")
    parser.add_argument("--season", type=int, help="season year, for week lookups")
    parser.add_argument("--scores", action="store_true", help="print the scoreboard and exit")
    parser.add_argument("--box", metavar="EVENT_ID", help="print a box score and exit")
    parser.add_argument("--team-stats", metavar="EVENT_ID",
                        help="print one game's team stats and exit")
    parser.add_argument("--bets", action="store_true",
                        help="print the Betting tab: every upcoming game's line, "
                             "sportst's projection and value picks, and exit")
    parser.add_argument("--book", metavar="NAME",
                        help="with --bets: avg, best, or one sportsbook (FanDuel, "
                             "DraftKings, BetMGM, Caesars, bet365, BetRivers, Bovada)")
    parser.add_argument("--stats", action="store_true",
                        help="print every team's season stats for the league and exit")
    parser.add_argument("--conference", metavar="NAME",
                        help="with --stats: only teams in this conference or division "
                             "(SEC, 'Big Ten', AFC North ...)")
    parser.add_argument("--plays", metavar="EVENT_ID", help="print scoring plays and exit")
    parser.add_argument("--standings", action="store_true", help="print standings and exit")
    parser.add_argument("--playoffs", action="store_true",
                        help="print the playoff bracket (or the current playoff "
                             "picture) and exit")
    parser.add_argument("--logo-test", action="store_true",
                        help="print a logo in each style, to see which ones your "
                             "terminal font can draw")
    parser.add_argument("--odds", metavar="EVENT_ID",
                        help="print the betting line, its movement, and the result "
                             "against it, then exit")
    parser.add_argument("--json", action="store_true", help="print raw ESPN JSON instead")
    parser.add_argument("--favorites", action="store_true",
                        help="print your saved teams and exit")
    parser.add_argument("--no-color", action="store_true", help="disable colour")
    parser.add_argument("--no-true-color", action="store_true",
                        help="map team colours onto the 256-colour cube instead of "
                             "redefining exact shades")
    parser.add_argument("--config", default=CONFIG_PATH, help="path to config.json")
    parser.add_argument("--write-config", action="store_true",
                        help="write a default config file and exit")
    parser.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    return parser


def parse_args(argv):
    parser = make_parser()
    args = parser.parse_args(argv)

    if args.date:
        try:
            args.date = datetime.strptime(args.date.replace("/", "-"), "%Y-%m-%d").date()
        except ValueError:
            parser.error("--date wants YYYY-MM-DD")
    return args


def main(argv=None):
    locale.setlocale(locale.LC_ALL, "")
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.write_config:
        path = write_default_config(args.config)
        print(f"wrote {path}")
        return 0

    config = load_config(args.config)
    config["favorites"] = normalize_favorites(config.get("favorites"))
    THEME.configure(config)
    oneshot = any([args.scores, args.box, args.standings, args.json, args.stats, args.bets,
                   args.team_stats, args.plays, args.favorites, args.odds,
                   args.playoffs, args.logo_test, args.medals, args.list_events])
    if oneshot:
        try:
            return run_oneshot(config, args)
        except BrokenPipeError:
            # `sportst --scores | head` closed the pipe early; that is fine
            try:
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, sys.stdout.fileno())
            except OSError:
                pass
            return 0

    if not sys.stdout.isatty():
        sys.stderr.write(
            f"{APP}: not a terminal. Use --scores, --box ID, or --standings for plain output.\n")
        return 1

    os.environ.setdefault("ESCDELAY", "25")

    def bootstrap(stdscr):
        App(stdscr, config, args).run()

    try:
        curses.wrapper(bootstrap)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
