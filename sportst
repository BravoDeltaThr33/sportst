STATS_API = "https://statsapi.mlb.com/api/v1"
STATCAST_FIELDS = ",".join([
    "dates", "games", "gamePk", "teams", "away", "home", "team", "name", "gameDate",
    "allPlays", "about", "inning", "halfInning", "atBatIndex", "matchup", "batter",
    "fullName", "pitcher", "playEvents", "details", "call", "description", "type",
    "isPitch", "pitchData", "startSpeed", "strikeZoneTop", "strikeZoneBottom",
    "breaks", "spinRate", "hitData", "launchSpeed", "launchAngle", "totalDistance",
    "result", "event", "eventType", "pitchNumber",
])


def statcast_schedule_url(day):
    return f"{STATS_API}/schedule?sportId=1&date={day.strftime('%m/%d/%Y')}"


def statcast_game_url(game_pk):
    return f"{STATS_API}/game/{game_pk}/playByPlay?fields={STATCAST_FIELDS}"


def find_game_pk(schedule, event):
    """MLB's game id for an ESPN event, matched on the two team names."""
    want = {clean(event["away"]["name"]).lower(), clean(event["home"]["name"]).lower()}
    for day in dig(schedule, "dates", default=[]) or []:
        for game in day.get("games") or []:
            names = {clean(dig(game, "teams", side, "team", "name", default="")).lower()
                     for side in ("away", "home")}
            if names == want:
                return game.get("gamePk")
    return None


def statcast_for_at_bat(feed, at_bat, index):
    """Pitch speeds, spin, the batter's own strike zone and how hard the ball
    was hit, matched to one ESPN at-bat."""
    plays = dig(feed, "allPlays", default=[]) or []
    if not plays:
        return None
    match = None
    if 0 <= index < len(plays):
        candidate = plays[index]
        half = "top" if at_bat["half"].lower().startswith("top") else "bottom"
        if (dig(candidate, "about", "inning") == at_bat["inning"]
                and dig(candidate, "about", "halfInning") == half):
            match = candidate
    if match is None:
        surname = (at_bat.get("batter") or "").split(" ")[-1].lower()
        for candidate in plays:
            if dig(candidate, "about", "inning") != at_bat["inning"]:
                continue
            name = clean(dig(candidate, "matchup", "batter", "fullName", default="")).lower()
            if surname and surname in name:
                match = candidate
                break
    out = {"pitches": [], "zone": None}
    if match:
        for event in match.get("playEvents") or []:
            if not event.get("isPitch"):
                continue
            data = event.get("pitchData") or {}
            hit = event.get("hitData") or {}
            out["pitches"].append({
                "speed": data.get("startSpeed"),
                "spin": dig(data, "breaks", "spinRate"),
                "type": clean(dig(event, "details", "type", "description", default="")),
                "hit": {"launchSpeed": hit.get("launchSpeed"),
                        "launchAngle": hit.get("launchAngle"),
                        "totalDistance": hit.get("totalDistance")} if hit else None,
            })
            if data.get("strikeZoneTop"):
                out["zone"] = (data["strikeZoneTop"], data.get("strikeZoneBottom",
                                                               ZONE_BOTTOM_FT))
    hardest = None
    for play in plays:
        for event in play.get("playEvents") or []:
            hit = event.get("hitData") or {}
            speed = hit.get("launchSpeed")
            if speed and (hardest is None or speed > hardest["speed"]):
                hardest = {"speed": speed, "distance": hit.get("totalDistance") or 0,
                           "text": clean(dig(play, "result", "event", default=""))}
    out["hardest"] = hardest
    return out


