def parse_teams(data):
    out = []
    for sport in dig(data, "sports", default=[]) or []:
        for league_node in sport.get("leagues") or []:
            for node in league_node.get("teams") or []:
                team = node.get("team") or {}
                if not team:
                    continue
                out.append({
                    "id": str(team.get("id", "")),
                    "abbr": clean(team.get("abbreviation") or ""),
                    "name": clean(team.get("displayName") or ""),
                    "short": clean(team.get("shortDisplayName") or ""),
                    "location": clean(team.get("location") or ""),
                    "color": clean(team.get("color") or ""),
                    "logo": str(dig(team, "logos", 0, "href", default="") or ""),
                })
    out.sort(key=lambda t: t["name"].lower())
    return out


def favorites_rows(teams, favorites, league, needle):
    """Favourites first in saved order, then everyone else alphabetically."""
    chosen, rest = [], []
    for team in teams:
        rank = fav_rank(favorites, league, team)
        (chosen if rank >= 0 else rest).append((rank, team))
    chosen.sort(key=lambda row: row[0])
    rows = [team for _, team in chosen] + [team for _, team in rest]
    if needle:
        low = needle.lower()
        rows = [t for t in rows
                if low in t["name"].lower() or low in t["abbr"].lower()
                or low in t["location"].lower()]
    return rows


def favorites_tree(teams, favorites, league, needle, groups, opened):
    """The Favorites list by conference (6.21.0): your teams first, always
    open, then each conference (a pro league's conference, a college's own,
    the AHL's division) as a heading - collapsed unless opened, or a search
    finds teams in it - with its teams under it A to Z when open; teams in
    none last, under Other teams. A heading is a dict with kind "group"."""
    low = (needle or "").lower()

    def match(team):
        return not low or low in team["name"].lower() or low in team["abbr"].lower() \
            or low in team["location"].lower()

    starred = sorted((fav_rank(favorites, league, t), t) for t in teams
                     if fav_rank(favorites, league, t) >= 0 and match(t))
    rows = []
    if starred:
        rows.append({"kind": "group", "key": STAR, "name": "Your teams",
                     "count": len(starred), "stars": len(starred), "open": True})
        rows += [team for _, team in starred]
    college = league in COLLEGE_LEAGUES
    members = {}
    for team in teams:
        names = groups.get(str(team.get("id"))) or []
        name = (names[-1] if college else names[0]) if names else "Other teams"
        members.setdefault(name, []).append(team)
    for name in sorted(members, key=lambda n: (n == "Other teams", short_group(n).lower())):
        found = sorted((t for t in members[name] if match(t)),
                       key=lambda t: t["name"].lower())
        if not found:
            continue
        stars = sum(1 for t in found if fav_rank(favorites, league, t) >= 0)
        is_open = bool(low) or name in opened
        rows.append({"kind": "group", "key": name, "name": short_group(name),
                     "count": len(found), "stars": stars, "open": is_open})
        if is_open:
            rows += found
    return rows


def render_favorites(state, width):
    """state carries league, teams, favorites, cursor, filter and load status."""
    league = state["league"]
    favorites = state["favorites"]
    lines = []

    lines.append(heading("Your teams", "title"))
    rows = []
    for key in LEAGUE_ORDER:
        line = Line().add(f"  {LEAGUE_SHORT[key]:<16}", "header")
        picked = favorites.get(key) or []
        if not picked:
            line.add("none yet", "muted")
        else:
            for index, entry in enumerate(picked):
                if index:
                    line.add("   ", "normal")
                team = {"abbr": entry["abbr"], "name": entry["name"],
                        "id": entry["id"], "location": entry["name"],
                        "short": entry["name"]}
                line.add(STAR + " ", "star")
                line.add(entry["name"] or entry["abbr"],
                         THEME.style(key, team, bold=True))
        rows.append(line)
    # two columns of leagues when they fit, half the height
    half = (len(rows) + 1) // 2
    widest = max(sum(len(t) for t, _ in r) for r in rows) if rows else 0
    if widest * 2 + 3 <= width:
        lines.extend(side_by_side([rows[:half], rows[half:]], width))
    else:
        lines.extend(rows)
    lines.append(blank())

    bar = Line()
    bar.add("  Editing ", "muted")
    bar.add(LEAGUE_SHORT[family(league)], "accent")
    if is_olympic(league):
        bar.add("   nations follow you through every sport of every Games", "muted")
    bar.add("   L switches league · enter opens a conference or stars a team · h / l "
            "close / open · / searches · X clears the search", "muted")
    lines.append(bar)
    lines.append(blank())

    if state.get("error"):
        lines.extend(wrap_spans(f"Could not load the team list: {state['error']}",
                                width, "err"))
        return lines
    if state.get("loading") and not state.get("rows"):
        lines.append(Line().add("  Loading teams…", "dim"))
        return lines

    rows = state.get("rows") or []
    if state.get("filter"):
        lines.append(Line().add(f"  search: {state['filter']}", "accent"))
    if not rows:
        lines.append(Line().add("  Nothing matches that search.", "dim"))
        return lines

    cursor = state.get("cursor", 0)
    grouped = any(row.get("kind") == "group" for row in rows)
    for index, team in enumerate(rows):
        chosen = index == cursor
        if team.get("kind") == "group":
            # a conference: ▸ shut, ▾ open, how many teams, how many starred
            line = Line()
            line.add("▌ " if chosen else "  ", "selbar" if chosen else "normal")
            line.add(("▾ " if team["open"] else "▸ ") + team["name"],
                     "sel" if chosen else ("star" if team["key"] == STAR else "accent"))
            line.add(f"  {team['count']} team" + ("" if team["count"] == 1 else "s"),
                     "seldim" if chosen else "muted")
            if team["stars"] and team["key"] != STAR:
                line.add(f"  {STAR} {team['stars']}", "star")
            lines.append(line.pad(width, "sel" if chosen else "normal"))
            continue
        starred = fav_rank(favorites, league, team) >= 0
        line = Line()
        line.add("▌ " if chosen else "  ", "selbar" if chosen else "normal")
        if grouped:
            line.add("    ", "sel" if chosen else "normal")
        line.add(f"{STAR if starred else ' '} ", "star" if starred else "muted")
        line.add(f"{team['name']:<34}", THEME.style(league, team, selected=chosen,
                                                    bold=starred))
        line.add(f"{team['abbr']:<6}", "seldim" if chosen else "muted")
        hexcode = THEME.color(league, team)
        line.add(hexcode or "", "seldim" if chosen else "muted")
        lines.append(line.pad(width, "sel" if chosen else "normal"))
    return lines


