def ansi_for(style, floor=0.62):
    """Truecolor escape for a style token. Terminals that predate 24-bit colour
    ignore the sequence and print plain text, which is the right failure."""
    if not style:
        return ""
    prefix = ""
    if style[0] == "@":
        fg_hex, _, bg_hex = style[1:].partition(":")
        out = "\033[38;2;%d;%d;%dm" % (hex_to_rgb("#" + fg_hex) or (230, 227, 220))
        if bg_hex and hex_to_rgb("#" + bg_hex):
            out += "\033[48;2;%d;%d;%dm" % hex_to_rgb("#" + bg_hex)
        return out
    if style[0] == "#":
        hex_part, _, mods = style.partition("~")
        rgb = hex_to_rgb(hex_part)
        if rgb is None:
            return ""
        rgb = lift(rgb, floor)
        if "b" in mods:
            prefix += "\033[1m"
        if "d" in mods:
            prefix += "\033[2m"
        if "u" in mods:
            prefix += "\033[48;2;%d;%d;%dm" % hex_to_rgb(upset_background())
        return prefix + "\033[38;2;%d;%d;%dm" % rgb
    entry = base_styles().get(style)
    if not entry:
        return ""
    fg, bg, extra = entry
    out = ""
    if extra & curses.A_BOLD:
        out += "\033[1m"
    if extra & curses.A_UNDERLINE:
        out += "\033[4m"
    rgb = hex_to_rgb(fg)
    if rgb:
        out += "\033[38;2;%d;%d;%dm" % rgb
    brgb = hex_to_rgb(bg) if bg else None
    if brgb:
        out += "\033[48;2;%d;%d;%dm" % brgb
    return out


def emit(lines, color=True, floor=0.62):
    for line in lines:
        if color:
            parts = []
            for text, style in line:
                parts.append(f"{ansi_for(style, floor)}{text}\033[0m")
            print("".join(parts).rstrip())
        else:
            print(line.text.rstrip())


def fetch_first(pair, timeout):
    """Try the primary URL, then each fallback. Raise the last error."""
    primary, fallbacks = pair
    last = None
    for url in [primary] + list(fallbacks or []):
        try:
            return load_source(url, timeout)
        except Exception as exc:  # noqa: BLE001
            last = exc
    raise last


def oneshot_core_lines(api, league, events, timeout, wait=None):
    """Fetch core odds for live games in parallel, for a one-shot print."""
    fetcher = Fetcher(workers=6, timeout=timeout)
    for event in events:
        url, fallbacks = api.odds(league, event["id"])
        fetcher.get(("odds", event["id"]), url, ttl=3600, fallbacks=fallbacks)
    deadline = time.time() + (wait if wait is not None else timeout + 2)
    while fetcher.busy() and time.time() < deadline:
        time.sleep(0.05)

    def lookup(event):
        url, fallbacks = api.odds(league, event["id"])
        result = fetcher.get(("odds", event["id"]), url, ttl=3600, fallbacks=fallbacks)
        if not result.data:
            return None
        return parse_core_odds(result.data, event["away"], event["home"])
    return lookup


def render_upset_notes(events):
    lines = []
    for event in events:
        upset = event.get("upset")
        if not upset:
            continue
        style = "upset" if upset["level"] == "live" else "upsetsoft"
        row = Line().add(f"▲ {upset['tag']:<6}", style)
        row.add(f"{event['short_name']:<14}", "normal")
        row.add(upset["note"], style if upset["level"] == "live" else "dim")
        row.add(f"   {status_text(event)}", "muted")
        lines.append(row)
    return lines


def event_from_summary(data):
    """Build a scoreboard-style event from a summary's header."""
    header = dig(data, "header", default={}) or {}
    if not header.get("competitions"):
        return None
    event = parse_event({**header, "date": dig(header, "competitions", 0, "date")})
    if event and not event["short_name"]:
        event["short_name"] = f"{event['away']['abbr']} @ {event['home']['abbr']}"
    return event


def oneshot_playoffs(api, league, timeout, config):
    """The bracket, fetched the plain way for the command line."""
    year = Date.today().year
    try:
        if league in ("nba", "cbb"):
            for season in (year, year - 1):
                events = []
                for _, urls in basketball_postseason_urls(api, league, season):
                    try:
                        events.extend(parse_scoreboard(fetch_first((urls[0], urls[1:]),
                                                                   timeout)))
                    except Exception:  # noqa: BLE001 - an empty month is fine
                        continue
                rounds = bracket_nba(events) if league == "nba" else bracket_cbb(events)
                if count_real_teams(rounds) >= 2:
                    return rounds, None
            return [], "No postseason games on file yet."
        if league == "ahl":
            rounds = bracket_ahl(fetch_first(api.hockeytech.bracket(league), timeout))
            return (rounds if count_real_teams(rounds) >= 2 else []), \
                (None if rounds else "No AHL bracket yet.")
        if is_olympic(league):
            events = parse_scoreboard(fetch_first(api.scoreboard(league), timeout))
            rounds = bracket_from_events(events, league, OLYMPIC_ROUNDS,
                                         keep=lambda h: bool(olympic_round(h)),
                                         namer=olympic_round, notes=False)
            return rounds, None if rounds else "The medal round has not started."
        if league == "nhl":
            for season in (year, year + 1, year - 1):
                rounds = bracket_nhl(http_json(f"{NHL_API}/playoff-bracket/{season}",
                                               timeout))
                if count_real_teams(rounds) >= 2:
                    return rounds, None
            return [], "No NHL bracket published yet."
        if league == "mlb":
            data = http_json(
                f"{STATS_API}/schedule/postseason?season={year}&sportId=1", timeout)
            teams = fetch_first(api.teams(league), timeout)
            by_name = {t["name"].lower(): t for t in parse_teams(teams)}
            rounds = bracket_mlb(data, by_name)
            return (rounds if count_real_teams(rounds) >= 2 else []), None
        events = []
        if league in ("nfl", "cfb"):
            for week in ([1, 2, 3, 5] if league == "nfl" else [1]):
                events.extend(parse_scoreboard(fetch_first(api.scoreboard(
                    league, week=week, seasontype=3, year=year,
                    groups=config.get("cfb_group") if league == "cfb" else None),
                    timeout)))
            keep = None
            if league == "cfb":
                keep = lambda headline: "playoff" in headline.lower() or \
                    "national championship" in headline.lower()
            rounds = bracket_from_events(events, league,
                                         NFL_ROUNDS if league == "nfl" else CFB_ROUNDS,
                                         keep=keep)
            return (rounds if count_real_teams(rounds) >= 2 else []), None
        meta = LEAGUES[league]
        for season_type in (5, 6):
            window = http_json(
                f"https://sports.core.api.espn.com/v2/sports/{meta['sport']}/leagues/"
                f"{meta['path']}/seasons/{year}/types/{season_type}", timeout)
            start, end = parse_iso(window.get("startDate") or ""), \
                parse_iso(window.get("endDate") or "")
            if not start or not end:
                continue
            day = start.date()
            while day <= end.date():
                events.extend(parse_scoreboard(
                    fetch_first(api.scoreboard(league, day=day), timeout)))
                day += timedelta(days=1)
        rounds = bracket_from_events(events, league, CBASE_ROUNDS, namer=cbase_round)
        return (rounds if count_real_teams(rounds) >= 2 else []), None
    except Exception as exc:  # noqa: BLE001 - the command line should not traceback
        return [], f"Could not fetch the bracket: {exc}"


def run_oneshot(config, args):
    api = Api(config.get("api_host", "site.api.espn.com"))
    timeout = int(config.get("timeout_seconds", 15))
    league = args.league or config.get("league", "nfl")
    if league in ("owg", "osg"):
        saved = (config.get("olympic_events") or {}).get(league)
        league = olympic_default(league, args.event or saved, args.games)
    else:
        league = resolve_league(league) or "nfl"
    use_color = sys.stdout.isatty() and not args.no_color
    import shutil
    term_width = shutil.get_terminal_size((100, 24)).columns
    width = min(100, term_width)
    floor = float(config.get("color_floor", 0.62))
    favorites = normalize_favorites(config.get("favorites"))
    THEME.configure(config)

    def show(lines):
        emit(lines, use_color, floor)

    if args.favorites:
        lines = [heading("Your teams", "title"), rule(40)]
        for key in LEAGUE_ORDER:
            line = Line().add(f"{LEAGUE_SHORT[key]:<16}", "header")
            picked = favorites.get(key) or []
            if not picked:
                line.add("none yet", "muted")
            for index, entry in enumerate(picked):
                if index:
                    line.add("   ", "normal")
                team = {"abbr": entry["abbr"], "name": entry["name"], "id": entry["id"],
                        "location": entry["name"], "short": entry["name"]}
                line.add(STAR + " ", "star")
                line.add(entry["name"] or entry["abbr"], THEME.style(key, team, bold=True))
            lines.append(line)
        show(lines)
        return 0

    try:
        if args.list_events:
            if not is_olympic(league):
                sys.stderr.write(f"{APP}: --list-events wants -L owg or -L osg\n")
                return 1
            fam = family(league)
            catalog = {x[0]: x for x in (WINTER_SPORTS if fam == "owg" else SUMMER_SPORTS)}
            for games in OLYMPIC_GAMES[fam]:
                show([Line().add(f"{games['name']}  (--games {games['year']})", "title")])
                for slug in games["sports"]:
                    kind = "tournament" if catalog[slug][2] else "events"
                    show([Line().add(f"  {slug:<22}", "accent")
                          .add(f"{catalog[slug][4]:<40}", "normal").add(kind, "muted")])
                show([blank()])
            return 0

        if args.medals or (is_wiki_sport(league) and (args.scores or args.standings)):
            fam = family(league)
            if args.medals:
                if not is_olympic(league):
                    sys.stderr.write(f"{APP}: --medals wants -L owg or -L osg\n")
                    return 1
                page = wiki_page(medal_table_title(league), timeout, wiki_max_age(league))
                show(render_medal_table(page, league, max(40, term_width - 1), favorites))
                return 0
            page = wiki_page(sport_page_title(league), timeout, wiki_max_age(league))
            events = sport_events(league, page)
            meta = LEAGUES[league]
            show([Line().add(f"{meta['label']} — {meta['games']}", "title"), blank()])
            header, rows = render_event_list(events, min(90, term_width - 1), -1, favorites,
                                             league)
            show([header] + rows)
            return 0

        if is_wiki_sport(league) and (args.box or args.plays or args.team_stats or args.playoffs):
            sys.stderr.write(f"{APP}: {LEAGUES[league]['label']} has events, not games; "
                             "try --scores or --medals, or open the app\n")
            return 1

        if args.odds:
            book = LineBook()
            data = fetch_first(api.summary(league, args.odds), timeout)
            event = event_from_summary(data)
            if not event:
                sys.stderr.write(f"{APP}: no game with id {args.odds}\n")
                return 1
            if event["state"] == "pre":
                raw = pick_line(data.get("pickcenter") or [], event["away"],
                                event["home"], BETTING.provider)
                if raw is None and not (book.get(league, event["id"]) or {}).get("line"):
                    raw = oneshot_core_lines(api, league, [event], timeout)(event)
                event["line_raw"] = raw
            fetch = None
            if event["state"] != "pre":
                fetch = oneshot_core_lines(api, league, [event], timeout)
            attach_lines([event], league, book, fetch, event["id"])
            book.save()
            if args.json:
                json.dump({"line": event.get("line"),
                           "history": event.get("line_history"),
                           "upset": {k: v for k, v in (event.get("upset") or {}).items()
                                     if k not in ("favorite", "underdog")}},
                          sys.stdout, indent=2)
                print()
                return 0
            title = Line()
            title.add(event["away"]["name"], THEME.style(league, event["away"], bold=True))
            title.add("  at  ", "muted")
            title.add(event["home"]["name"], THEME.style(league, event["home"], bold=True))
            lines = [title, Line().add(status_text(event), status_style(event))]
            if event["away"]["score"] is not None and event["state"] != "pre":
                lines.append(Line().add(
                    f"{event['away']['abbr']} {event['away']['score']}  —  "
                    f"{event['home']['abbr']} {event['home']['score']}", "bold"))
            lines.extend(render_upset_banner(event, width))
            lines.append(blank())
            lines.extend(render_betting(event, league, width))
            show(lines)
            return 0

        if args.box or args.plays or args.team_stats:
            event_id = args.box or args.plays or args.team_stats
            data = prepare_summary(fetch_first(api.summary(league, event_id), timeout),
                                   league)
            if args.json:
                json.dump(data, sys.stdout, indent=2)
                return 0
            if args.box:
                show(render_boxscore(data, league, width, favorites))
            elif args.team_stats:
                show(render_team_stats(data, league, width, favorites))
            elif sport_of(league) == "basketball":
                show(render_plays(data, league, width, favorites))
                show([blank()] + render_shot_chart(
                    data, league, min(width, 80),
                    lines_style=str(config.get("court_lines", "braille"))))
            elif is_baseball(league) and event_from_summary(data):
                left, right, _ = render_baseball_plays(
                    data, event_from_summary(data), league, width)
                show(left + [blank()] + right)
            else:
                show(render_plays(data, league, width, favorites))
            return 0

        if args.logo_test:
            show([Line().add("The same logo in each style. Use the sharpest one your "
                             "terminal font can draw.", "dim"), blank()])
            event = None
            for candidate in parse_scoreboard(fetch_first(api.scoreboard(league),
                                                          timeout)):
                if game_winner(candidate):
                    event = candidate
                    break
            store = LogoStore(timeout=timeout)
            image = None
            if event:
                for _ in range(40):
                    image = store.get(league, game_winner(event))
                    if image:
                        break
                    time.sleep(0.25)
            if not image:
                show([Line().add("No finished game to draw a logo from right now.",
                                 "warn")])
                return 0
            for style in ("sextants", "octants", "quadrants", "halfblocks", "ascii"):
                show([Line().add(f'"logo_art": "{style}"', "title")])
                show(render_logo(image, 40, 10, style))
                show([blank()])
            return 0

        if args.playoffs:
            rounds, error = oneshot_playoffs(api, league, timeout, config)
            if not rounds:
                show(wrap_spans(error or "No postseason games yet.", width, "dim"))
                return 0
            champion = champion_line(rounds, league)
            if champion:
                show([champion, blank()])
            show(bracket_layout(rounds, max(60, term_width - 2), league, favorites,
                                connect=league != "cbase"))
            return 0

        if args.stats:
            table = team_stats_table(league, timeout,
                                     extras=bool(config.get("extra_stat_sources", True)))
            if args.json:
                json.dump(table, sys.stdout, indent=2)
                return 0
            wanted = ""
            if args.conference:
                needle = norm_name(args.conference)
                names = sorted({g for t in table["teams"] for g in t.get("groups", [])})
                wanted = next((n for n in names if norm_name(short_group(n)) == needle
                               or norm_name(n) == needle), "") or next(
                    (n for n in names if needle in norm_name(n)), "")
                if not wanted:
                    print(f"No conference or division matches {args.conference!r}. "
                          f"Try one of: {', '.join(short_group(n) for n in names)}",
                          file=sys.stderr)
                    return 1
            width = max(60, term_width - 1)
            groups = stat_groups(table)
            ranks = stat_ranks(table)
            index = 0
            while index < len(groups):
                shown = stats_view_groups(table, groups[index], width)
                show(render_stats_table(table, league, width, favorites, groups[index],
                                        group_filter=wanted, ranks=ranks))
                print()
                index = groups.index(shown[-1]) + 1
            print("Sources: " + ", ".join(table.get("sources") or []))
            return 0

        if args.standings:
            data = fetch_first(api.standings(league), timeout)
            year = standings_unplayed(data) if league in BETTING_LEAGUES else None
            if year:
                try:
                    data = fetch_first(api.standings(league, season=year - 1), timeout)
                except Exception:  # noqa: BLE001 - keep the empty table then
                    pass
            if args.json:
                json.dump(data, sys.stdout, indent=2)
                return 0
            show(render_standings(data, league, max(40, term_width - 1), favorites))
            return 0

        groups = config.get("cfb_group") if league == "cfb" else LEAGUES[league].get("groups")
        if args.week:
            pair = api.scoreboard(league, week=args.week, seasontype=args.seasontype or 2,
                                  year=args.season, groups=groups)
        elif args.date:
            pair = api.scoreboard(league, day=args.date, groups=groups)
        elif LEAGUES[league]["week_based"]:
            # football: the current week, same as the app opens on, so a cron
            # job records every game's line and not just today's
            pair = api.scoreboard(league, groups=groups)
        else:
            pair = api.scoreboard(league, day=Date.today(), groups=groups)
        data = fetch_first(pair, timeout)
        if args.json:
            json.dump(data, sys.stdout, indent=2)
            return 0
        events = parse_scoreboard(data)
        if BETTING.enabled and league in BETTING_LEAGUES:
            book = LineBook()
            live = [e for e in events if e["state"] == "in"
                    and not (book.get(league, e["id"]) or {}).get("line")]
            fetch = oneshot_core_lines(api, league, live, timeout) if live else None
            attach_lines(events, league, book, fetch)
            book.save()
        events = sort_by_favorites(favorites, league, events)
        if args.bets:
            show(cli_bets(league, events, data, args, config, max(60, term_width - 1),
                          timeout, favorites))
            return 0
        week = dig(data, "week", "number")
        when = (f"Week {week}" if (week and not args.date and LEAGUES[league]["week_based"])
                else dig(data, "day", "date", default="") or
                (args.date or Date.today()).isoformat())
        if is_olympic(league):
            when = LEAGUES[league]["games"]
            title = LEAGUES[league]["label"]
            for event in events:
                start = parse_iso(event["date"])
                day = start.astimezone().strftime("%b %-d") if start else ""
                event["label"] = f"{day} {status_text(event)}".strip()
        else:
            title = LEAGUES[league]["name"]
        lines = [Line().add(f"{title} — {when}", "title"), blank()]
        column_header, rows = render_game_list(events, width, -1, favorites, league)
        lines.append(column_header)
        lines.extend(rows)
        notes = render_upset_notes(events)
        if notes:
            lines.append(blank())
            lines.extend(notes)
        lines.append(blank())
        for event in events:
            lines.append(Line().add(f"{event['id']}  {event['short_name']}", "muted"))
        show(lines)
        return 0
    except urllib.error.HTTPError as exc:
        sys.stderr.write(f"{APP}: HTTP {exc.code}\n")
        return 1
    except urllib.error.URLError as exc:
        sys.stderr.write(f"{APP}: network error: {exc.reason}\n")
        return 1
    except (ValueError, KeyError, TypeError) as exc:
        sys.stderr.write(f"{APP}: could not read that data: {exc}\n")
        return 1


