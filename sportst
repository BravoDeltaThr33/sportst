    # -- data ------------------------------------------------------------

    def scoreboard_key(self):
        if is_olympic(self.league):
            return ("sb", self.league)
        if self.week_mode and LEAGUES[self.league]["week_based"]:
            week = self.week if self.week_pinned else "current"
            return ("sb", self.league, "w", week, self.seasontype, self.season_year,
                    self.cfb_group if self.league == "cfb" else "")
        return ("sb", self.league, "d", self.day.isoformat(),
                self.cfb_group if self.league == "cfb" else "")

    def scoreboard_url(self):
        groups = self.cfb_group if self.league == "cfb" else LEAGUES[self.league].get("groups")
        if self.week_mode and LEAGUES[self.league]["week_based"]:
            if self.week_pinned and self.week:
                return self.api.scoreboard(
                    self.league, week=self.week, seasontype=self.seasontype,
                    year=self.season_year, groups=groups)
            return self.api.scoreboard(self.league, groups=groups)
        return self.api.scoreboard(self.league, day=self.day, groups=groups)

    def scoreboard_ttl(self):
        if any(e["state"] == "in" for e in self.events):
            return max(10, min(self.interval, 20))
        if is_olympic(self.league) and not games_live(self.league):
            return 6 * 3600
        return max(30, self.interval)

    def load_scoreboard(self):
        url, fallbacks = self.scoreboard_url()
        result = self.fetcher.get(self.scoreboard_key(), url,
                                  ttl=self.scoreboard_ttl(), fallbacks=fallbacks)
        if result.data:
            self.sync_season(result.data)
        return result

    def sync_season(self, data):
        year = dig(data, "leagues", 0, "season", "year") or dig(data, "season", "year")
        if isinstance(year, int):
            self.season_year = year
        week = dig(data, "week", "number")
        seasontype = (dig(data, "leagues", 0, "season", "type", "type")
                      or dig(data, "season", "type"))
        if not self.week_pinned:
            if isinstance(week, int):
                self.week = week
            if isinstance(seasontype, int):
                self.seasontype = seasontype

    def load_summary(self, event_id):
        if not event_id:
            return Result(None, None, False, 0.0)
        selected = self.current_event()
        ttl = 15 if (selected and selected["state"] == "in") else 300
        url, fallbacks = self.api.summary(self.league, event_id)
        result = self.fetcher.get(("sum", self.league, event_id), url, ttl=ttl,
                                  fallbacks=fallbacks)
        if result.data:
            prepare_summary(result.data, self.league)
        return result

    def load_standings(self):
        primary, fallbacks = self.api.standings(self.league)
        ttl = 6 * 3600 if is_olympic(self.league) and not games_live(self.league) else 900
        result = self.fetcher.get(("st", self.league), primary, ttl=ttl, fallbacks=fallbacks)
        # before a new season's first game ESPN's table is all zeros; last
        # season's final one is the useful thing to show until then
        year = standings_unplayed(result.data) if LEAGUES[self.league].get("source",
                                                                           "espn") == "espn" \
            and not is_olympic(self.league) else None
        if year:
            primary, fallbacks = self.api.standings(self.league, season=year - 1)
            previous = self.fetcher.get(("st", self.league, year - 1), primary, ttl=86400,
                                        fallbacks=fallbacks)
            if previous.data and not standings_unplayed(previous.data):
                return previous
        return result

    # -- season numbers, scouting --------------------------------------------

    def team_groups(self):
        """{team id: [conference, division]} from the standings, for filters."""
        result = self.load_standings()
        extra = catalog = None
        if self.league == "cbase":
            primary, spare = self.api.standings("cbb")
            extra = self.fetcher.get(("st", "cbb"), primary, ttl=86400, fallbacks=spare)
            primary, spare = self.api.teams("cbase")
            catalog = self.fetcher.get(("teams", "cbase"), primary, ttl=86400,
                                       fallbacks=spare)
        stamp = (self.league, result.stamp, extra.stamp if extra else None,
                 catalog.stamp if catalog else None)
        if self._groups_cache[0] == stamp:
            return self._groups_cache[2]
        out = {}
        for ident, (_, _, path) in standings_rows(result.data).items():
            out.setdefault(ident, group_names(path, self.league))
        if extra and extra.data and catalog and catalog.data:
            schools = groups_by_school(extra.data, self.league)
            for node in dig(catalog.data, "sports", 0, "leagues", 0, "teams",
                            default=[]) or []:
                team = team_record(node.get("team") or {})
                if out.get(team["id"]):
                    continue
                for key in (team.get("location"), team.get("short")):
                    if key and norm_name(key) in schools:
                        out[team["id"]] = schools[norm_name(key)]
                        break
        self._groups_cache = (stamp, None, out)
        return out

    def load_team_table(self):
        extras = bool(self.config.get("extra_stat_sources", True))
        ttl = 12 * 3600 if self.league == "cbase" else 3600
        return self.fetcher.get(("tstats", self.league, extras),
                                Loader("team stats", team_stats_table, self.league,
                                       extras=extras), ttl=ttl)

