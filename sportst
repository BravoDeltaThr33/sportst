    def open_overview_game(self, which):
        entries = overview_entries(self.favorites)
        if not entries:
            self.status_message = "Star some teams on the Favorites tab first (0)."
            return
        league, team = entries[clamp(self.overview_cursor, 0, len(entries) - 1)]
        glance = self.load_glance(league, team).data
        if not glance:
            self.status_message = "Still loading that team's schedule."
            return
        game = (glance.get("live") or glance.get("next")) if which == "next" \
            else glance.get("last")
        live = which == "next" and game is glance.get("live") and game is not None
        if not game:
            self.status_message = ("No game scheduled." if which == "next"
                                   else "No completed game yet.")
            return
        moment = _local(game["date"])
        if game.get("time_tba"):
            try:
                moment = datetime.strptime(str(game["date"])[:10], "%Y-%m-%d")
            except ValueError:
                pass
        self.switch_league(league)
        if moment:
            self.day = moment.date()
        self.week_mode = False
        self.week_pinned = False
        self.selected_id = game["id"]
        self.selected_index = 0
        # a result opens its Game Stats; the next game its Scouting report,
        # or its Game Stats once it has started
        target = "Scouting" if which == "next" and not live else "Game Stats"
        tabs = self.tabs
        self.tab = tabs.index(target) if target in tabs else tabs.index("Scoreboard")
        self.scroll[target] = 0
        self.detail_scroll = 0

    def handle_overview_key(self, key):
        count = len(overview_entries(self.favorites))
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1,
                 curses.KEY_NPAGE: 10, curses.KEY_PPAGE: -10,
                 curses.KEY_HOME: -10 ** 6, curses.KEY_END: 10 ** 6, ord("G"): 10 ** 6}
        if key in moves:
            self.overview_cursor = clamp(self.overview_cursor + moves[key], 0,
                                         max(0, count - 1))
        elif key in (ord("h"), curses.KEY_LEFT):
            self.overview_side = "last"
        elif key in (ord("l"), curses.KEY_RIGHT):
            self.overview_side = "next"
        elif key == 9 and count:
            # tab moves between the two sides before leaving the screen
            if self.overview_side == "last":
                self.overview_side = "next"
            else:
                return False
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.open_overview_game(self.overview_side)
        elif key == ord("b"):
            self.open_overview_game("last")
        else:
            return False
        return True

    # -- the Settings tab ------------------------------------------------

    def setting_value(self, spec):
        """What the app is using right now, which for the keys that change it
        for one run (a, + and -, b) can differ from what is saved."""
        key = spec["key"]
        if key == "auto_refresh":
            return self.auto_refresh
        if key == "refresh_seconds":
            return self.interval
        if key == "betting_book":
            return self.bet_book
        value = self.config.get(key, DEFAULT_CONFIG.get(key))
        if key == "betting_top_books":
            return self.top_books()
        return value

    def setting_unsaved(self, spec):
        key = spec["key"]
        if key == "auto_refresh":
            return bool(self.config.get("auto_refresh", True)) != self.auto_refresh
        if key == "refresh_seconds":
            return int(self.config.get("refresh_seconds", 30)) != self.interval
        return False

    def cache_usage(self):
        """Walking the cache folder every frame would be wasteful."""
        stamp, usage = getattr(self, "_cache_usage", (0.0, {}))
        if time.time() - stamp > 10:
            usage = cache_usage()
            self._cache_usage = (time.time(), usage)
        return usage

    def save_settings(self, quiet=False):
        try:
            save_config(self.config, self.args.config)
        except OSError as exc:
            self.status_message = f"⚠ Could not save settings: {exc}"
            return False
        if not quiet:
            self.status_message = f"Saved to {home_path(self.args.config)}."
        return True

    def rebuild_palette(self):
        self.palette = Palette(enabled=not self.args.no_color,
                               floor=float(self.config.get("color_floor", 0.62)),
                               true_color=not self.args.no_true_color,
                               background=self.config.get("background", APP_BG))
        try:
            self.stdscr.bkgd(" ", 0)
        except curses.error:
            pass
        self.apply_background()
        self.stdscr.clearok(True)

    def apply_setting(self, key):
        """Make a changed value take effect without a restart."""
        config = self.config
        if key == "auto_refresh":
            self.auto_refresh = bool(config["auto_refresh"])
        elif key == "refresh_seconds":
            self.interval = int(config["refresh_seconds"])
        elif key == "timeout_seconds":
            self.fetcher.timeout = int(config["timeout_seconds"])
            self.logos.timeout = int(config["timeout_seconds"])
        elif key == "api_host":
            self.api = Api(config["api_host"])
            self.fetcher.expire()
        elif key in ("team_colors", "team_color_overrides") or key.startswith("upset_") \
                or key in ("betting_lines", "odds_provider", "line_history_days"):
            THEME.configure(config)
            if key == "upset_color":
                self.rebuild_palette()
        elif key in ("color_floor", "background"):
            self.rebuild_palette()
        elif key == "color_scheme":
            apply_scheme(config["color_scheme"])
            self.rebuild_palette()
        elif key == "logo_art":
            self.logo_style = str(config["logo_art"] or "off").lower()
        elif key == "mlb_statcast":
            self.statcast = bool(config["mlb_statcast"])
        elif key == "cfb_group":
            self.cfb_group = str(config["cfb_group"])
            self.selected_id = None
            self.selected_index = 0
        elif key == "betting_book":
            self.bet_book = str(config["betting_book"] or "avg")
            self.bet_index = 0
        elif key in ("extra_stat_sources", "betting_sources"):
            self.fetcher.expire()

    def set_setting(self, spec, value):
        key = spec["key"]
        if key == "color_scheme":
            # a background left at the old scheme's own follows the new one
            before = scheme_background(self.config.get("color_scheme", "espn"))
            if str(self.config.get("background", APP_BG)).upper() == before.upper():
                self.config["background"] = scheme_background(value)
        self.config[key] = value
        self.apply_setting(key)
        if self.save_settings(quiet=True):
            note = " (next start)" if spec.get("apply") == "start" else ""
            self.status_message = f"{spec['label']}: {setting_text(spec, value)}{note}."

    def settings_spec(self):
        self.settings_cursor = clamp(self.settings_cursor, 0, len(SETTING_ROWS) - 1)
        return SETTING_ROWS[self.settings_cursor]

    def edit_setting(self):
        spec = self.settings_spec()
        kind = spec["kind"]
        value = self.setting_value(spec)
        if kind == "action":
            self.run_setting_action(spec["key"])
        elif kind == "bool":
            self.set_setting(spec, not value)
        elif kind == "choice":
            choices = spec_choices(spec)
            items = [{"label": label, "detail": "current" if str(option) == str(value)
                      else ("default" if option == setting_default(spec) else ""),
                      "action": ("choice", option)} for option, label in choices]
            cursor = next((i for i, (option, _) in enumerate(choices)
                           if str(option) == str(value)), 0)
            self.popup = Popup(spec["label"], items,
                               lambda picked, spec=spec: self.set_setting(spec, picked[1]),
                               cursor, "enter picks · esc closes")
        else:
            if kind == "books":
                initial = ", ".join(value)
            elif kind == "float":
                initial = f"{float(value):g}"
            else:
                initial = str(value)
            if kind == "int":
                hint = f"{spec['min']}-{spec['max']}"
            elif kind == "float":
                hint = f"{spec['min']:g}-{spec['max']:g}"
            elif kind == "color":
                hint = "#RRGGBB" + (" or terminal" if spec.get("allow") else "")
            else:
                hint = "up to three, comma separated"
            text = self.prompt(f"{spec['label']} ({hint}): ", initial)
            if text is None or not text.strip():
                return
            try:
                self.set_setting(spec, coerce_setting(spec, text))
            except ValueError as exc:
                self.status_message = f"⚠ {exc}."

    def confirm(self, question):
        answer = self.prompt(f"{question} type yes: ")
        return bool(answer) and answer.strip().lower() in ("y", "yes")

    def run_setting_action(self, action):
        if action == "_save":
            self.config["auto_refresh"] = self.auto_refresh
            self.config["refresh_seconds"] = self.interval
            self.config["betting_book"] = self.bet_book
            self.save_settings()
        elif action == "_reload":
            try:
                fresh = load_config(self.args.config)
            except Exception as exc:  # noqa: BLE001 - a bad file must not end the app
                self.status_message = f"⚠ Could not read the config: {exc}"
                return
            self.config.clear()
            self.config.update(fresh)
            self.favorites = normalize_favorites(self.config.get("favorites"))
            for spec in SETTING_ROWS:
                if spec["kind"] != "action":
                    self.apply_setting(spec["key"])
            self.status_message = f"Reloaded {home_path(self.args.config)}."
        elif action == "_refresh":
            self.fetcher.expire()
            self.status_message = "Refreshing everything."
        elif action == "_clear_cache":
            if not self.confirm("Delete the saved logos, pages and college stats?"):
                self.status_message = "Nothing deleted."
                return
            removed = 0
            for name, size in cache_usage().items():
                if name == os.path.basename(LINES_PATH):
                    continue
                path = os.path.join(CACHE_DIR, name)
                try:
                    if os.path.isdir(path):
                        shutil.rmtree(path)
                    else:
                        os.remove(path)
                    removed += size
                except OSError:
                    pass
            self._cache_usage = (0.0, {})
            self.status_message = f"Cleared {human_bytes(removed)} of cached files."
        elif action == "_clear_lines":
            if not self.confirm("Delete the saved line history?"):
                self.status_message = "Nothing deleted."
                return
            try:
                os.remove(LINES_PATH)
            except OSError:
                pass
            self.book = LineBook()
            self._cache_usage = (0.0, {})
            self.status_message = "Line history cleared."
        elif action == "_reset":
            if not self.confirm("Put every setting back to its default?"):
                self.status_message = "Nothing changed."
                return
            for spec in SETTING_ROWS:
                if spec["kind"] == "action":
                    continue
                default = DEFAULT_CONFIG.get(spec["key"])
                self.config[spec["key"]] = list(default) if isinstance(default, list) \
                    else default
                self.apply_setting(spec["key"])
            self.save_settings(quiet=True)
            self.status_message = "Settings are back to their defaults."

    def draw_settings(self, top, height, width):
        wide = width >= self.SPLIT_MIN_WIDTH
        left_width = clamp(width * 46 // 100, 58, 76) if wide else width
        inner = left_width - 4
        rows, cursor_line = render_setting_rows(self, inner)
        detail = render_setting_detail(self, inner)
        caption = Line().add(" Settings ", "accent").add(
